''' 根据本库接口及 HTTP服务库的 /ws 回显路由编写。
''' 先运行自己的回显服务；本机默认地址可配合同一设备上的 HTTP服务库示例。
''' 发送返回只表示入队，收到数据事件才代表真正收到服务端文本。
变量 已连接 为 逻辑型
变量 错误清理中 为 逻辑型
变量 连接次数 为 整数型
变量 收到次数 为 整数型
变量 断开次数 为 整数型
变量 错误次数 为 整数型
变量 最近发送 为 文本型
变量 有发送 为 逻辑型
变量 示例种类 为 整数型

事件 主窗口.初始化()
	更新统计()
结束 事件

事件 打开.被单击()
	变量 地址 为 文本型
	地址 = 网址.文本
	删首尾空(地址)
	如果 寻找文本(地址, "ws://", 0) <> 0 且 寻找文本(地址, "wss://", 0) <> 0 则
		状态.文本 = "请输入 ws:// 或 wss:// 地址；当前连接未改变。"
		退出 事件
	结束 如果
	已连接 = 假
	错误清理中 = 假
	有发送 = 假
	状态.文本 = "连接中；重复打开会替换原连接，请等待连接成功事件。"
	会话.打开连接(地址)
结束 事件

事件 发送.被单击()
	如果 已连接 = 假 则
		状态.文本 = "尚未收到连接成功事件，先连接服务器再发送。"
		退出 事件
	结束 如果
	最近发送 = 消息.文本
	有发送 = 真
	状态.文本 = "已调用发送；等待收到数据事件，发送返回不能证明服务端已收到。"
	会话.发送数据(最近发送)
结束 事件

事件 换文本.被单击()
	示例种类 = 示例种类 + 1
	判断 示例种类
		分支 1
			消息.文本 = ""
		分支 2
			消息.文本 = "第二条消息，中文与表情 😀"
		分支 否则
			消息.文本 = "你好，WebSocket 😀"
			示例种类 = 0
	结束 判断
	状态.文本 = "已切换待发文本；空文本也是合法文本消息，可点击发送观察回显。"
结束 事件

事件 关闭.被单击()
	已连接 = 假
	状态.文本 = "已请求关闭；握手完成后才会收到连接断开事件。"
	会话.关闭连接()
结束 事件

''' 请求头只用于下一次握手；同名删除后再添加，避免反复点击累积重复头。
事件 加头.被单击()
	会话.删除协议头("X-Example")
	会话.添加协议头("X-Example", 头值.文本)
	头说明.文本 = "下次握手将发送 X-Example；现有连接不受影响。"
	位于 错误
		分支 否则
			头说明.文本 = "请求头设置失败，请使用不含换行的 ASCII 值；当前连接未改变。"
	结束 错误
结束 事件

事件 删头.被单击()
	会话.删除协议头("X-Example")
	头说明.文本 = "已移除 X-Example；下次握手生效，现有连接不受影响。"
结束 事件

事件 会话.连接成功()
	已连接 = 真
	连接次数 = 连接次数 + 1
	状态.文本 = "连接成功，可以发送；也可以重新打开以替换当前连接。"
	更新统计()
结束 事件

事件 会话.收到数据(数据 为 文本型)
	收到次数 = 收到次数 + 1
	收到文本.文本 = "最近收到（" & 取字符数(数据) & " 个 UTF-16 代码单元）：[" & 数据 & "]"
	如果 有发送 则
		如果 数据 = 最近发送 则
			状态.文本 = "已收到消息，与最近一次发送的文本逐字一致。"
		否则
			状态.文本 = "收到的文本与最近发送不同，也可能是服务器主动推送，请核对服务端协议。"
		结束 如果
	否则
		状态.文本 = "收到服务器主动发送的文本。"
	结束 如果
	更新统计()
结束 事件

事件 会话.连接断开()
	已连接 = 假
	有发送 = 假
	断开次数 = 断开次数 + 1
	如果 错误清理中 则
		状态.文本 = "错误后的连接清理已完成，可重新打开；请查看最近错误。"
	否则
		状态.文本 = "已收到正常关闭事件，可以重新连接。"
	结束 如果
	更新统计()
结束 事件

事件 会话.出现错误(说明 为 文本型)
	' 此事件也可能来自发送被拒绝；主动结束当前连接，避免把未知状态继续当成已连接。
	已连接 = 假
	有发送 = 假
	错误清理中 = 真
	' 保留原错误，避免清理旧连接产生的正常关闭事件覆盖失败原因。
	最近错误.文本 = "最近错误（保留至下次错误）：" & 说明
	会话.关闭连接()
	错误次数 = 错误次数 + 1
	状态.文本 = "出现错误：" & 说明 & "；已请求结束当前连接，可重新打开。"
	更新统计()
结束 事件

过程 更新统计()
	统计.文本 = "本次界面：连接 " & 连接次数 & "；收到 " & 收到次数 & "；正常关闭 " & 断开次数 & "；错误 " & 错误次数
结束 过程

事件 退出按钮.被单击()
	会话.销毁()
	终止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		会话.销毁()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "WebSocket 客户端示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "连接与文本回显"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "需独立回显服务；可先启动同一设备上 HTTP服务库示例的 5000 端口 /ws。跨设备改填服务设备地址；wss 使用系统信任证书。"
		$结束 $定义
		$定义 会话 $为 simple.library.wsd.wsclient.WS客户端
		$结束 $定义
		$定义 网址 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "ws://127.0.0.1:5000/ws"
			提示文本 = "ws:// 或 wss:// 服务地址"
		$结束 $定义
		$定义 连接操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 打开 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "打开 / 替换连接"
			$结束 $定义
			$定义 关闭 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "关闭连接"
			$结束 $定义
		$结束 $定义
		$定义 消息 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，WebSocket 😀"
			提示文本 = "允许发送空文本"
		$结束 $定义
		$定义 发送操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 发送 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "发送文本"
			$结束 $定义
			$定义 换文本 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换空文本 / 中文"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚未连接；先启动回显服务，再打开连接。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = ""
		$结束 $定义
		$定义 收到文本 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚未收到文本。"
		$结束 $定义
		$定义 最近错误 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "最近错误：无。"
		$结束 $定义
		$定义 头标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "可选请求头 X-Example（ASCII 值）"
		$结束 $定义
		$定义 头值 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "Simple-WS"
		$结束 $定义
		$定义 头操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 加头 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "设置请求头"
			$结束 $定义
			$定义 删头 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "删除请求头"
			$结束 $定义
		$结束 $定义
		$定义 头说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "默认不添加额外请求头；设置或删除仅影响下一次连接。"
		$结束 $定义
		$定义 边界 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "只接收文本消息；二进制消息不触发收到数据事件。网络故障走错误事件，不能当作正常关闭。示例不自动重连、不持久保存消息。"
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出并释放连接"
		$结束 $定义
	$结束 $定义
$结束 $属性
