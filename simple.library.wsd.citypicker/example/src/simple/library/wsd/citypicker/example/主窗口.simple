''' 参考 CityPicker 上游的搜索、热门城市、主题和定位接口场景。
''' https://github.com/zaaach/CityPicker
''' 实际调用以当前扩展库 API 为准；定位由演示计时器回填，不读取设备位置。
变量 定位模式 为 整数型
变量 定位次数 为 整数型
变量 请求标记 为 长整数型

''' 每次打开前恢复配置，避免自定义数据或主题影响其它场景。
过程 准备选择()
	回填计时器.启用 = 假
	定位模式 = 0
	定位次数 = 0
	选择器.置主题("")
	选择器.置动画("@style/CityPickerAnimation")
	选择器.使用内置城市()
	选择器.使用默认热门城市()
	' 这是应用已保存的城市示例，不是设备定位结果。
	选择器.置定位城市("深圳", "广东", "101280601")
	状态.文本 = "选择器已打开，可输入城市中文名或拼音，或触摸右侧字母索引。"
结束 过程

事件 内置列表.被单击()
	准备选择()
	说明.文本 = "内置列表：搜索、热门和字母索引可直接使用。定位栏预设为应用已保存的深圳。"
	选择器.显示()
结束 事件

''' 平行数组长度须一致；自定义代码由应用定义，不冒充行政区划代码。
事件 自定列表.被单击()
	准备选择()
	选择器.置城市数据(分割文本("北京|杭州|深圳|成都|上海", "|"), 分割文本("北京|浙江|广东|四川|上海", "|"), 分割文本("beijing|hangzhou|shenzhen|chengdu|shanghai", "|"), 分割文本("APP-BJ|APP-HZ|APP-SZ|APP-CD|APP-SH", "|"))
	选择器.置热门城市(分割文本("杭州|深圳", "|"), 分割文本("浙江|广东", "|"), 分割文本("APP-HZ|APP-SZ", "|"))
	选择器.置定位城市("上海", "上海", "APP-SH")
	说明.文本 = "自定义列表包含五城，热门为杭州、深圳；返回 APP- 开头的应用代码。"
	选择器.显示()
结束 事件

''' 主题由示例的 res/values/styles.xml 定义，不需要改变宿主 Activity。
事件 主题列表.被单击()
	准备选择()
	选择器.置主题("@style/CityPickerExampleTheme")
	说明.文本 = "主题示例：绿色取消按钮、分组标题和字母提示；搜索框提示也由主题指定。"
	选择器.显示()
结束 事件

事件 定位成功.被单击()
	准备选择()
	定位模式 = 1
	选择器.清除定位城市()
	说明.文本 = "演示回填：约两秒后提供杭州。这里没有接入定位 SDK，不代表设备真实位置。"
	选择器.显示()
结束 事件

事件 定位重试.被单击()
	准备选择()
	定位模式 = 2
	选择器.清除定位城市()
	说明.文本 = "演示失败与重试：首次回填失败；点击定位失败区域，约两秒后回填杭州。"
	选择器.显示()
结束 事件

''' 真实应用应在此发起定位，并在界面线程用同一请求标记回填结果。
事件 选择器.定位已请求(标记 为 长整数型)
	请求标记 = 标记
	定位次数 = 定位次数 + 1
	状态.文本 = "收到演示定位请求 " & 定位次数 & "，等待计时器回填。"
	回填计时器.启用 = 真
结束 事件

事件 回填计时器.计时()
	回填计时器.启用 = 假
	变量 已接受 为 逻辑型
	如果 定位模式 = 2 且 定位次数 = 1 则
		已接受 = 选择器.定位失败(请求标记)
		状态.文本 = "演示失败已回填；点击定位失败区域可以重试。"
	否则
		已接受 = 选择器.回填定位(请求标记, "杭州", "浙江", "101210101")
		状态.文本 = "演示杭州已回填，可点击定位城市完成选择。"
	结束 如果
	如果 已接受 = 假 则
		状态.文本 = "此次定位请求已失效，未修改当前选择界面。"
	结束 如果
结束 事件

事件 选择器.城市已选择(名称 为 文本型, 省份 为 文本型, 拼音 为 文本型, 代码 为 文本型)
	结果.文本 = "已选城市：" & 名称 & " / " & 省份
	明细.文本 = "拼音：" & 拼音 & "；数据源代码：" & 代码
结束 事件

事件 选择器.选择已取消()
	结果.文本 = "本次选择已取消。"
	明细.文本 = "未提交新的城市。"
结束 事件

''' 选择、取消和离开都会关闭；关闭时停止演示回填，避免过期操作。
事件 选择器.已关闭()
	回填计时器.启用 = 假
	状态.文本 = "选择器已关闭。"
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "城市选择使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "选择一个城市"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "选择下方场景，再使用搜索、热门城市或右侧字母索引。定位栏中的预设城市来自示例配置。"
		$结束 $定义
		$定义 内置列表 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "打开内置城市列表"
		$结束 $定义
		$定义 自定列表 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "使用自定义城市与热门"
		$结束 $定义
		$定义 主题列表 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "使用绿色主题"
		$结束 $定义
		$定义 定位成功 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "演示定位回填（非真实定位）"
		$结束 $定义
		$定义 定位重试 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "演示定位失败与重试"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 20
			文本 = "尚未选择城市。"
		$结束 $定义
		$定义 明细 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "选择成功后显示省份、拼音和数据源代码。"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "选择器尚未打开。"
		$结束 $定义
		$定义 数据说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "内置数据来自 CityPicker 1.0.2，可能不反映最新区划；城市代码保留数据源含义。"
		$结束 $定义
		$定义 选择器 $为 simple.library.wsd.citypicker.城市选择器
		$结束 $定义
		$定义 回填计时器 $为 计时器
			间隔 = 2000
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
