''' 参考 CityPicker 1.0.2 的数据源、主题和定位接口场景。
''' https://github.com/xuexiangjys/CityPicker

变量 列表页 为 列表窗口
变量 列表已创建 为 逻辑型
变量 定位页 为 定位窗口
变量 定位已创建 为 逻辑型
变量 搜索页 为 搜索窗口
变量 搜索已创建 为 逻辑型

事件 列表入口.被单击()
	如果 取反 列表已创建 则
		列表页 = 创建 列表窗口
		列表页.来源 = 主窗口
		列表已创建 = 真
	结束 如果
	切换窗口(列表页)
结束 事件

事件 定位入口.被单击()
	如果 取反 定位已创建 则
		定位页 = 创建 定位窗口
		定位页.来源 = 主窗口
		定位已创建 = 真
	结束 如果
	切换窗口(定位页)
结束 事件

事件 搜索入口.被单击()
	如果 取反 搜索已创建 则
		搜索页 = 创建 搜索窗口
		搜索页.来源 = 主窗口
		搜索已创建 = 真
	结束 如果
	切换窗口(搜索页)
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "CP城市选择示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "8dp"
		右填充 = "8dp"
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "CP城市选择示例"
			字体大小 = 23
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "86dp"
			文本 = "城市列表、定位回填与自定义搜索分开演示。选择一个主题进入；本库不自带定位服务。"
			字体大小 = 15
		$结束 $定义
		$定义 列表入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "50dp"
			文本 = "城市列表与主题"
		$结束 $定义
		$定义 定位入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "50dp"
			文本 = "定位回填（非真实定位）"
		$结束 $定义
		$定义 搜索入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "50dp"
			文本 = "自定义异步搜索"
		$结束 $定义
	$结束 $定义
$结束 $属性
