''' 依据当前 CH34x 封装及沁恒驱动入口编写：打开、授权后重试、8N1 参数、原始字节发送与接收。
''' 无实体串口时可独立运行十六进制转换；接收事件是字节片段，不保证完整协议帧。
变量 最近打开成功 为 逻辑型
变量 参数已设置 为 逻辑型
变量 波特率 为 整数型
变量 样本 为 整数型
变量 接收片段 为 整数型
变量 接收字节 为 长整数型

事件 主窗口.初始化()
	波特率 = 9600
	状态.文本 = "系统声明 USB Host=" & 串口.是否支持OTG() & "；尚未打开串口。"
结束 事件

过程 记录(内容 为 文本型)
	如果 取字符数(日志.文本) > 2400 则 日志.文本 = ""
	日志.文本 = 日志.文本 & "\n" & 内容
结束 过程

事件 打开按钮.被单击()
	如果 最近打开成功 则
		记录("本次已打开；拔出后请先关闭再重新打开。")
		退出 事件
	结束 如果
	最近打开成功 = 串口.打开设备()
	参数已设置 = 假
	状态.文本 = "本次打开返回=" & 最近打开成功 & "；不是持续在线检测。"
	如果 最近打开成功 则
		记录("打开成功；下一步设置与对端一致的 8N1 波特率。")
	否则
		记录("未打开：需 USB Host、CH34x 1a86:7523/5523 和 USB 授权；授权弹框允许后再次点打开。")
	结束 如果
结束 事件

事件 波特率按钮.被单击()
	如果 波特率 = 9600 则
		波特率 = 115200
	否则
		波特率 = 9600
	结束 如果
	波特率按钮.文本 = "波特率：" & 波特率 & "（点击切换）"
	参数已设置 = 假
结束 事件

事件 配置按钮.被单击()
	如果 最近打开成功 = 假 则
		记录("尚未打开，未调用参数设置。")
		退出 事件
	结束 如果
	串口.设置参数(波特率, 8, 1, 0)
	参数已设置 = 真
	记录("已调用参数设置：" & 波特率 & "，8 数据位、1 停止位、无校验、无流控；以对端响应核对。")
	位于 错误
		分支 否则
			参数已设置 = 假
			记录("参数设置未完成，请关闭后检查连接和设备支持。")
	结束 错误
结束 事件

事件 样本按钮.被单击()
	样本 = 样本 + 1
	判断 样本
		分支 1
			发送框.文本 = "A B C"
		分支 2
			发送框.文本 = ""
		分支 3
			发送框.文本 = "GG"
		分支 否则
			发送框.文本 = "00 7f 80 ff"
			样本 = 0
	结束 判断
结束 事件

事件 转换按钮.被单击()
	变量 数据 为 字节型()
	如果 取字符数(发送框.文本) > 256 则
		记录("演示输入最多256个字符。")
		退出 事件
	结束 如果
	数据 = 串口.到字节集(发送框.文本)
	记录("解析字节=" & 取数组成员数(数据) & "；完整十六进制=[" & 串口.到十六进制(数据) & "]；长度为0的前缀=[" & 串口.到十六进制(数据, 0) & "]")
	位于 错误
		分支 否则
			记录("转换失败：仅允许0-9、A-F和空白；奇数位末尾自动补零。")
	结束 错误
结束 事件

事件 发送按钮.被单击()
	如果 最近打开成功 = 假 或 参数已设置 = 假 则
		记录("请先打开并设置串口参数，未发送数据。")
		退出 事件
	结束 如果
	变量 数据 为 字节型()
	变量 写入 为 整数型
	如果 取字符数(发送框.文本) > 256 则 退出 事件
	数据 = 串口.到字节集(发送框.文本)
	如果 取数组成员数(数据) = 0 则
		记录("输入为空，不发送；0字节不能视作有效通讯成功。")
		退出 事件
	结束 如果
	写入 = 串口.发送数据(数据)
	记录("驱动写入=" & 写入 & "/" & 取数组成员数(数据) & " 字节；不代表对端收到。")
	位于 错误
		分支 否则
			记录("发送未完成，请检查十六进制内容及设备连接。")
	结束 错误
结束 事件

事件 试发按钮.被单击()
	' 演示未打开的返回值；已打开时不发额外数据，避免干扰真实协议。
	如果 最近打开成功 则
		记录("仅在关闭状态演示未打开返回值。")
		退出 事件
	结束 如果
	变量 数据 为 字节型(1)
	数据(0) = 85
	记录("未打开时驱动报告写入=" & 串口.发送数据(数据) & "；不能当作发送成功。")
结束 事件

事件 串口.收到数据(数据 为 字节型())
	接收片段 = 接收片段 + 1
	接收字节 = 接收字节 + 取数组成员数(数据)
	记录("RX片段=" & 接收片段 & "；累计=" & 接收字节 & "字节；本次=[" & 串口.到十六进制(数据) & "]")
结束 事件

事件 关闭按钮.被单击()
	串口.关闭设备()
	最近打开成功 = 假
	参数已设置 = 假
	状态.文本 = "已调用关闭；可重复关闭或重新打开。"
结束 事件

事件 清日志.被单击()
	接收片段 = 0
	接收字节 = 0
	日志.文本 = "计数已归零；没有伪造接收数据。"
结束 事件

事件 退出按钮.被单击()
	串口.关闭设备()
	终止()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "CH34x 串口与字节转换"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 串口 $为 simple.library.wsd.otg.OTG通讯
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "需 USB Host/OTG 真机、CH34x 设备及匹配电平。授权后再次打开。安全的 TX/RX 回环可核对收发；接收可能拆成多段。没有硬件也能操作字节转换。"
		$结束 $定义
		$定义 打开按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "打开设备 / 授权后重试"
		$结束 $定义
		$定义 波特率按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "波特率：9600（点击切换）"
		$结束 $定义
		$定义 配置按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "设置串口参数 8N1"
		$结束 $定义
		$定义 发送框 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "00 7f 80 ff"
		$结束 $定义
		$定义 样本按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "切换：奇数位 / 空 / 无效 / 原样"
		$结束 $定义
		$定义 转换按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "只转换字节，不发送"
		$结束 $定义
		$定义 发送按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "发送到串口"
		$结束 $定义
		$定义 试发按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "核对未打开时写入返回值"
		$结束 $定义
		$定义 关闭按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "关闭设备"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "等待检查 USB Host。"
		$结束 $定义
		$定义 日志 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "实际结果显示在这里。"
		$结束 $定义
		$定义 清日志 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "清空接收计数和日志"
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出示例"
		$结束 $定义
	$结束 $定义
$结束 $属性
