''' 参考 Android ExpandableListView 的分组/子项交互，调用本库当前封装接口。
''' https://developer.android.com/reference/android/widget/ExpandableListView
''' 这里只修改内存中的演示数据，不保存文件；索引从 0 开始，删除后须重新选择。
变量 当前组 为 整数型
变量 当前项 为 整数型
变量 新项编号 为 整数型
变量 大字样式 为 逻辑型
变量 标题点击数 为 整数型
变量 展开次数 为 整数型
变量 收起次数 为 整数型

事件 主窗口.初始化()
	恢复数据()
结束 事件

''' 使用返回索引组织数据，用标记保存稳定编号，不将位置作为业务 ID。
过程 恢复数据()
	列表.清空所有数据()
	列表.显示子项按钮 = 真
	变量 组 为 整数型
	组 = 列表.添加分组("水果", "2 项")
	列表.置分组标记(组, "fruit")
	列表.添加子项(组, "icon.png", "苹果", "单击选中，长按查看标记", "", "选择")
	列表.置子项标记(组, 0, "fruit.apple")
	列表.添加子项(组, "", "香蕉", "右侧按钮演示独立事件", "", "选择")
	列表.置子项标记(组, 1, "fruit.banana")
	组 = 列表.添加分组("饮品")
	列表.置分组标记(组, "drink")
	列表.置分组信息(组, "2 项")
	列表.添加子项(组, "茶", "标题和信息的简写重载")
	列表.置子项标记(组, 0, "drink.tea")
	列表.置子项按钮标题(组, 0, "选择")
	列表.添加子项(组, "咖啡")
	列表.置子项标记(组, 1, "drink.coffee")
	列表.置子项按钮标题(组, 1, "选择")
	列表.收起分组(1)
	列表.展开分组(0)
	列表.选中分组(0)
	当前组 = -1
	当前项 = -1
	新项编号 = 0
	标题点击数 = 0
	展开次数 = 0
	收起次数 = 0
	更新选择()
	更新事件()
	操作结果.文本 = "已恢复 2 组、各 2 项；点击子项或分组后再修改。"
结束 过程

函数 有当前组() 为 逻辑型
	有当前组 = 当前组 >= 0 且 当前组 < 列表.取分组总数()
结束 函数

函数 有当前项() 为 逻辑型
	有当前项 = 假
	如果 有当前组() 则 有当前项 = 当前项 >= 0 且 当前项 < 列表.取子项总数(当前组)
结束 函数

过程 更新选择()
	如果 有当前组() 则
		选择状态.文本 = "分组=" & 当前组 & "（" & 列表.取分组标记(当前组) & "），子项数=" & 列表.取子项总数(当前组)
		如果 有当前项() 则 选择状态.文本 = 选择状态.文本 & "；子项=" & 当前项 & "，标记=" & 列表.取子项标记(当前组, 当前项)
	否则
		选择状态.文本 = "共 " & 列表.取分组总数() & " 组；尚未选择。"
	结束 如果
结束 过程

过程 更新事件()
	事件状态.文本 = "标题单击=" & 标题点击数 & "；展开=" & 展开次数 & "；收起=" & 收起次数
结束 过程

事件 列表.分组被单击(组 为 整数型)
	当前组 = 组
	当前项 = -1
	标题点击数 = 标题点击数 + 1
	更新选择()
	更新事件()
结束 事件

事件 列表.分组被展开(组 为 整数型)
	展开次数 = 展开次数 + 1
	更新事件()
	操作结果.文本 = "展开分组 " & 组 & "；实际状态=" & 列表.取分组状态(组)
结束 事件

事件 列表.分组被收起(组 为 整数型)
	收起次数 = 收起次数 + 1
	更新事件()
	操作结果.文本 = "收起分组 " & 组 & "；实际状态=" & 列表.取分组状态(组)
结束 事件

事件 列表.子项被单击(组 为 整数型, 项 为 整数型)
	当前组 = 组
	当前项 = 项
	更新选择()
	操作结果.文本 = "子项单击：" & 列表.取子项标题(组, 项) & "；" & 列表.取子项信息(组, 项)
结束 事件

事件 列表.子项被长按(组 为 整数型, 项 为 整数型)
	当前组 = 组
	当前项 = 项
	更新选择()
	操作结果.文本 = "子项长按：" & 列表.取分组标记(组) & " / " & 列表.取子项标记(组, 项)
结束 事件

事件 列表.子项按钮被单击(组 为 整数型, 项 为 整数型)
	当前组 = 组
	当前项 = 项
	列表.置子项信息(组, 项, "已选择：" & 列表.取子项标记(组, 项))
	列表.置子项按钮标题(组, 项, "已选")
	更新选择()
	操作结果.文本 = "子项按钮单击：" & 列表.取子项标题(组, 项) & "；按钮=" & 列表.取子项按钮标题(组, 项)
结束 事件

事件 新增.被单击()
	如果 有当前组() 则
		新项编号 = 新项编号 + 1
		变量 项 为 整数型
		项 = 列表.取子项总数(当前组)
		列表.添加子项(当前组, "", "新增条目 " & 新项编号, "本次运行的临时数据", "", "选择")
		列表.置子项标记(当前组, 项, "local." & 新项编号)
		列表.置分组信息(当前组, 列表.取子项总数(当前组) & " 项")
		列表.展开分组(当前组)
		列表.选中子项(当前组, 项)
		当前项 = 项
		更新选择()
		操作结果.文本 = "已新增并请求定位；新标记=" & 列表.取子项标记(当前组, 当前项)
	否则
		操作结果.文本 = "请先点击一个分组；没有分组时可恢复示例。"
	结束 如果
结束 事件

事件 更新.被单击()
	如果 有当前项() 则
		列表.置子项标题(当前组, 当前项, 列表.取子项标题(当前组, 当前项) & "（已更新）")
		列表.置子项信息(当前组, 当前项, "业务标记保持：" & 列表.取子项标记(当前组, 当前项))
		操作结果.文本 = "已更新子项标题和信息，业务标记保持不变。"
	否则如果 有当前组() 则
		列表.置分组标题(当前组, 列表.取分组标题(当前组) & "（已更新）")
		操作结果.文本 = "已更新分组标题：" & 列表.取分组标题(当前组)
	否则
		操作结果.文本 = "请先点击要修改的分组或子项。"
	结束 如果
结束 事件

''' 删除后索引会移动，清除旧选择，避免把后续子项误当成原业务对象。
事件 删除.被单击()
	如果 有当前项() 则
		变量 标记 为 文本型
		标记 = 列表.取子项标记(当前组, 当前项)
		列表.删除子项(当前组, 当前项)
		当前项 = -1
		列表.置分组信息(当前组, 列表.取子项总数(当前组) & " 项")
		更新选择()
		操作结果.文本 = "已删除 " & 标记 & "；索引已改变，请重新选择子项。"
	否则
		操作结果.文本 = "请先点击要删除的子项。"
	结束 如果
结束 事件

事件 全部展开.被单击()
	变量 组 为 整数型
	循环 组 = 0 至 列表.取分组总数() - 1
		列表.展开分组(组)
	下个
结束 事件

事件 全部收起.被单击()
	变量 组 为 整数型
	循环 组 = 0 至 列表.取分组总数() - 1
		列表.收起分组(组)
	下个
结束 事件

事件 按钮开关.被单击()
	列表.显示子项按钮 = (列表.显示子项按钮 = 假)
	操作结果.文本 = "显示子项按钮=" & 列表.显示子项按钮
结束 事件

事件 定位.被单击()
	如果 有当前组() 则
		如果 列表.取子项总数(当前组) > 0 则
			当前项 = 列表.取子项总数(当前组) - 1
			' 当前模拟器实测：仅传 真 未自动展开；示例先显式展开，不将定位请求当成成功回执。
			列表.展开分组(当前组)
			列表.选中子项(当前组, 当前项, 真)
			更新选择()
			操作结果.文本 = "已请求定位末项；分组展开=" & 列表.取分组状态(当前组) & "；不触发子项单击。"
		否则
			操作结果.文本 = "当前组没有子项，请先新增。"
		结束 如果
	否则
		操作结果.文本 = "请先点击一个分组。"
	结束 如果
结束 事件

事件 清空组.被单击()
	如果 有当前组() 则
		列表.清空子项(当前组)
		列表.置分组信息(当前组, "0 项")
		当前项 = -1
		更新选择()
		操作结果.文本 = "已清空当前组子项，保留分组及业务标记。"
	否则
		操作结果.文本 = "请先点击一个分组。"
	结束 如果
结束 事件

事件 删除组.被单击()
	如果 有当前组() 则
		列表.删除分组(当前组)
		当前组 = -1
		当前项 = -1
		更新选择()
		操作结果.文本 = "已删除分组及子项；后续分组索引改变，请重新选择。"
	否则
		操作结果.文本 = "请先点击一个分组。"
	结束 如果
结束 事件

事件 清空全部.被单击()
	列表.清空所有数据()
	当前组 = -1
	当前项 = -1
	更新选择()
	操作结果.文本 = "已清空所有分组和子项，点击恢复示例可重新体验。"
结束 事件

事件 恢复.被单击()
	恢复数据()
结束 事件

事件 样式.被单击()
	大字样式 = (大字样式 = 假)
	如果 大字样式 则
		列表.分组标题字体大小 = 18
		列表.子项标题字体大小 = 18
		列表.子项标题字体颜色 = 颜色_蓝
	否则
		列表.分组标题字体大小 = 14
		列表.子项标题字体大小 = 14
		列表.子项标题字体颜色 = 颜色_黑
	结束 如果
	操作结果.文本 = "大字蓝色样式=" & 大字样式 & "；标题字体=" & 列表.子项标题字体大小
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "分组列表框使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "分组列表与业务标记"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "点击标题展开/收起；点击子项选中，长按看标记，右侧按钮独立响应。删除后重新选择。"
		$结束 $定义
		$定义 列表 $为 simple.library.wsd.grouplist.分组列表框
			宽度 = 长度_匹配父级
			高度 = "300dp"
		$结束 $定义
		$定义 选择状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "尚未选择。"
		$结束 $定义
		$定义 事件状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "等待交互。"
		$结束 $定义
		$定义 编辑操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 新增 $为 按钮
				宽度 = "140dp"
				文本 = "新增子项"
			$结束 $定义
			$定义 更新 $为 按钮
				宽度 = "140dp"
				文本 = "更新选中"
			$结束 $定义
			$定义 删除 $为 按钮
				宽度 = "140dp"
				文本 = "删除选中"
			$结束 $定义
		$结束 $定义
		$定义 显示操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 全部展开 $为 按钮
				宽度 = "140dp"
				文本 = "展开全部"
			$结束 $定义
			$定义 全部收起 $为 按钮
				宽度 = "140dp"
				文本 = "收起全部"
			$结束 $定义
			$定义 按钮开关 $为 按钮
				宽度 = "140dp"
				文本 = "按钮开关"
			$结束 $定义
		$结束 $定义
		$定义 分组操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 定位 $为 按钮
				宽度 = "140dp"
				文本 = "定位末项"
			$结束 $定义
			$定义 清空组 $为 按钮
				宽度 = "140dp"
				文本 = "清空当前组"
			$结束 $定义
			$定义 删除组 $为 按钮
				宽度 = "140dp"
				文本 = "删除当前组"
			$结束 $定义
		$结束 $定义
		$定义 恢复操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 恢复 $为 按钮
				宽度 = "140dp"
				文本 = "恢复示例"
			$结束 $定义
			$定义 清空全部 $为 按钮
				宽度 = "140dp"
				文本 = "清空全部"
			$结束 $定义
			$定义 样式 $为 按钮
				宽度 = "140dp"
				文本 = "切换样式"
			$结束 $定义
		$结束 $定义
		$定义 操作结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "点击分组或子项开始。"
		$结束 $定义
	$结束 $定义
$结束 $属性
