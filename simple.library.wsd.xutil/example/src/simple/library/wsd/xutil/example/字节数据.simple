''' 十六进制和 BCD 都用偶数位；大小端决定整数的字节顺序。
别名 XUBCD = simple.library.wsd.xutil.XUBCD
别名 XU字节集 = simple.library.wsd.xutil.XU字节集

变量 来源 为 主窗口

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 十六.被单击()
	变量 数据 为 字节型()
	数据 = XU字节集.从十六进制(输入.文本)
	输出.文本 = "十六进制：" & XU字节集.到十六进制(数据) & "\n大端整数：" & XU字节集.读整数(数据, 0, 假) & "\n小端整数：" & XU字节集.读整数(数据, 0, 真)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 编码.被单击()
	输出.文本 = "大端：" & XU字节集.到十六进制(XU字节集.整数到字节集(16909060, 假)) & "\n小端：" & XU字节集.到十六进制(XU字节集.整数到字节集(16909060, 真))
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 十进.被单击()
	变量 数据 为 字节型()
	数据 = XUBCD.编码(输入.文本)
	输出.文本 = "BCD：" & XU字节集.到十六进制(数据) & "\n还原：" & XUBCD.解码(数据)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 字节数据.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 字节数据 $为 窗口
		标题 = "字节集与 BCD"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "字节集与 BCD"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "十六进制和 BCD 都用偶数位；大小端决定整数的字节顺序。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "01020304"
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 十六 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "十六进制与大小端"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 十六间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 编码 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "编码整数 16909060"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 编码间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 十进 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "BCD 编码并还原"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 十进间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
