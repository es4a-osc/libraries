''' 复制会替换当前剪贴板；拨号只打开系统界面，不直接拨出电话。
别名 XU剪贴板 = simple.library.wsd.xutil.XU剪贴板
别名 XU电话 = simple.library.wsd.xutil.XU电话
别名 XU通话 = simple.library.wsd.xutil.XU通话
别名 XU键盘 = simple.library.wsd.xutil.XU键盘

变量 来源 为 主窗口

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 复制.被单击()
	XU剪贴板.写文本(输入.文本)
	输出.文本 = "已复制输入内容。"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 粘贴.被单击()
	输入.文本 = XU剪贴板.读文本()
	输出.文本 = "已读取当前可访问的剪贴板文本。"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 显示.被单击()
	XU键盘.显示()
	输出.文本 = "已请求显示软键盘，需输入框持有焦点。"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 隐藏.被单击()
	XU键盘.隐藏()
	输出.文本 = "已请求隐藏软键盘。"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 电话.被单击()
	输出.文本 = "电话设备：" & XU电话.是否电话设备() & "\nSIM就绪：" & XU电话.SIM是否就绪() & "\n直接通话已授权：" & XU通话.是否已授权()
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 拨号.被单击()
	输出.文本 = "已打开拨号界面：" & XU电话.打开拨号("10086")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 界面工具.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 界面工具 $为 窗口
		标题 = "剪贴板、键盘与电话"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "剪贴板、键盘与电话"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "复制会替换当前剪贴板；拨号只打开系统界面，不直接拨出电话。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "Simple 示例文本"
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 复制 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "复制输入内容"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 复制间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 粘贴 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "读取剪贴板"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 粘贴间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 显示 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "显示软键盘"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 显示间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 隐藏 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "隐藏软键盘"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 隐藏间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 电话 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看电话能力"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 电话间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 拨号 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "打开拨号界面（10086）"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 拨号间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
