''' 固定密钥和 IV 仅便于入门观察。实际应用自行管理密钥；GCM nonce 不可重复。
别名 XU加密 = simple.library.wsd.xutil.XU加密
别名 XU编码 = simple.library.wsd.xutil.XU编码

变量 来源 为 主窗口
变量 密文 为 字节型()

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 加密.被单击()
	密文 = XU加密.加密(XU编码.文本到字节集(输入.文本), XU编码.文本到字节集("0123456789abcdef"), "AES/CBC/PKCS5Padding", XU编码.文本到字节集("abcdef0123456789"))
	输出.文本 = "Base64 密文：" & XU编码.Base64编码(密文)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 解密.被单击()
	输出.文本 = XU编码.字节集到文本(XU加密.解密(密文, XU编码.文本到字节集("0123456789abcdef"), "AES/CBC/PKCS5Padding", XU编码.文本到字节集("abcdef0123456789")))
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 对称加密.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 对称加密 $为 窗口
		标题 = "对称加解密"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "对称加解密"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "固定密钥和 IV 仅便于入门观察。实际应用自行管理密钥；GCM nonce 不可重复。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "我的演示内容 😀"
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 加密 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "AES-CBC 加密"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 加密间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 解密 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "还原上次密文"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 解密间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
