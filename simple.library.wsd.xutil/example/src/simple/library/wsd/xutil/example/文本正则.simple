''' 输入一段文字，直接观察文本整理、正则提取和分隔。
别名 XU文本 = simple.library.wsd.xutil.XU文本
别名 XU正则 = simple.library.wsd.xutil.XU正则

变量 来源 为 主窗口

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 整理.被单击()
	输出.文本 = "首尾整理：[" & XU文本.去首尾空白(输入.文本) & "]\n全部去空白：[" & XU文本.去全部空白(输入.文本) & "]\n反转：" & XU文本.反转(输入.文本)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 正则.被单击()
	变量 结果 为 文本型()
	结果 = XU正则.提取("[一-龥]+", 输入.文本)
	输出.文本 = "中文片段：" & XU文本.连接(结果, " / ")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 校验.被单击()
	输出.文本 = "是否邮箱：" & XU正则.是否邮箱(输入.文本) & "\n是否整数：" & XU文本.是否整数(输入.文本) & "\n是否数值：" & XU文本.是否数值(输入.文本)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 替换.被单击()
	输出.文本 = XU正则.替换全部(输入.文本, "\\s+", "-")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 版本.被单击()
	输出.文本 = "版本比较：" & XU文本.比较版本("1.2", "1.10") & "（负数表示前者较小）"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 文本正则.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 文本正则 $为 窗口
		标题 = "文本与正则"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "文本与正则"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "输入一段文字，直接观察文本整理、正则提取和分隔。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "  Hello 中文  "
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 整理 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "去空白与反转"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 整理间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 正则 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "提取中文"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 正则间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 校验 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "邮箱与数值判断"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 校验间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 替换 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "替换空白为短横线"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 替换间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 版本 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "比较 1.2 与 1.10"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 版本间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
