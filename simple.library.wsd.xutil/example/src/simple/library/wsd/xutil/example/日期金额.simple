''' 日期使用 Asia/Shanghai；金额用文本传入，避免二进制小数误差。
别名 XU大数 = simple.library.wsd.xutil.XU大数
别名 XU日期 = simple.library.wsd.xutil.XU日期

变量 来源 为 主窗口

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 解析.被单击()
	变量 时间 为 长整数型
	时间 = XU日期.解析(输入.文本, "yyyy-MM-dd HH:mm:ss", "Asia/Shanghai")
	输出.文本 = "毫秒：" & 时间 & "\n一个月后：" & XU日期.格式化(XU日期.偏移(时间, 2, 1, "Asia/Shanghai"), "yyyy-MM-dd HH:mm:ss", "Asia/Shanghai")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 现在.被单击()
	变量 时间 为 长整数型
	时间 = XU日期.取当前时间()
	输出.文本 = XU日期.格式化(时间, "yyyy-MM-dd HH:mm:ss", "Asia/Shanghai") & "\n设备时区星期：" & XU日期.取星期(时间)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 金额.被单击()
	输出.文本 = "0.1 + 0.2 = " & XU大数.加("0.1", "0.2") & "\n10 ÷ 3 = " & XU大数.除("10", "3", 2)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 舍入.被单击()
	输出.文本 = "四舍五入：" & XU大数.舍入("12345.675", 2) & "\n分组：" & XU大数.金额格式化("12345.67", ",")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 日期金额.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 日期金额 $为 窗口
		标题 = "日期与十进制"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "日期与十进制"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "日期使用 Asia/Shanghai；金额用文本传入，避免二进制小数误差。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "2026-01-31 08:30:00"
			提示文本 = "请输入日期时间"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 解析 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "解析并偏移一个月"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 解析间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 现在 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看当前时间"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 现在间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 金额 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "精确计算 0.1 + 0.2"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 金额间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 舍入 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "金额舍入与分组"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 舍入间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
