''' 所有读写仅限本示例私有 xutil-example/current 目录；文件任务在工作线程执行。
别名 XU压缩 = simple.library.wsd.xutil.XU压缩
别名 XU摘要 = simple.library.wsd.xutil.XU摘要
别名 XU文件 = simple.library.wsd.xutil.XU文件
别名 XU文本 = simple.library.wsd.xutil.XU文本

变量 忙 为 逻辑型
变量 来源 为 主窗口
变量 工作文本 为 文本型
变量 目录 为 文本型

事件 文件归档.初始化()
	目录 = XU文件.取私有目录() & "/xutil-example/current"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 写入.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	工作文本 = 输入.文本
	启动线程(本对象, "保存文件")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 读出.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "读取文件")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 二进.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "读取字节")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 压缩.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "生成归档")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 解压.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "还原归档")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 清理.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "清理文件")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

过程 保存文件()
	XU文件.写文本(目录 & "/source/note.txt", 工作文本, 假)
	投递消息("结果", "已保存：" & 目录 & "/source/note.txt")
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 读取文件()
	投递消息("结果", XU文件.读文本(目录 & "/source/note.txt"))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 读取字节()
	变量 数据 为 字节型()
	数据 = XU文件.读字节集(目录 & "/source/note.txt")
	投递消息("结果", "字节数：" & 取数组成员数(数据) & "\nSHA-256：" & XU摘要.字节集摘要(数据, "SHA-256"))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 生成归档()
	变量 成功 为 逻辑型
	成功 = XU压缩.压缩(目录 & "/source", 目录 & "/note.zip")
	投递消息("结果", "ZIP生成：" & 成功 & "\n" & XU文本.连接(XU压缩.列出(目录 & "/note.zip"), "\n"))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 还原归档()
	变量 文件列表 为 文本型()
	文件列表 = XU压缩.解压(目录 & "/note.zip", 目录 & "/restored", 65536)
	投递消息("结果", "已解压：" & XU文本.连接(文件列表, "\n") & "\n" & XU文件.读文本(文件列表(0)))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 清理文件()
	投递消息("结果", "清理本示例私有文件：" & XU文件.删除(目录))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

事件 文件归档.反馈消息(标记 为 变体型, 数据 为 变体型)
	忙 = 假
	输入.启用 = 真
	输出.文本 = 数据
结束 事件

事件 文件归档.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 文件归档 $为 窗口
		标题 = "私有文件与 ZIP"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "私有文件与 ZIP"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "所有读写仅限本示例私有 xutil-example/current 目录；文件任务在工作线程执行。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "我的本地笔记\n中文与表情 😀"
			提示文本 = "请输入内容"
			单行模式 = 假
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 写入 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "保存私有文本"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 写入间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 读出 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "读取私有文本"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 读出间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 二进 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看二进制与摘要"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 二进间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 压缩 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "生成 ZIP"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 压缩间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 解压 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "解压 ZIP"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 解压间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 清理 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "清理本示例文件"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 清理间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
