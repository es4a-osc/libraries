''' 输入 Android 颜色文本，观察颜色变换；尺寸结果使用当前设备密度。
别名 XU几何 = simple.library.wsd.xutil.XU几何
别名 XU尺寸 = simple.library.wsd.xutil.XU尺寸
别名 XU随机 = simple.library.wsd.xutil.XU随机
别名 XU颜色 = simple.library.wsd.xutil.XU颜色

变量 来源 为 主窗口

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 颜色.被单击()
	变量 色 为 整数型
	色 = XU颜色.从文本(输入.文本)
	预览.背景颜色 = 色
	输出.文本 = "原色：" & XU颜色.到文本(色) & "\n加深：" & XU颜色.到文本(XU颜色.加深(色, 0.8)) & "\n变浅：" & XU颜色.到文本(XU颜色.变浅(色, 0.3))
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 尺寸.被单击()
	输出.文本 = "屏幕像素：" & XU尺寸.取屏幕宽度() & " × " & XU尺寸.取屏幕高度() & "\n密度：" & XU尺寸.取密度() & "\n24dp = " & XU尺寸.DP到像素(24.0) & "px"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 几何.被单击()
	输出.文本 = "(0,0) 到 (3,4) 的距离：" & XU几何.距离(0.0, 0.0, 3.0, 4.0)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 随机.被单击()
	输出.文本 = XU随机.取数字字母(12) & "\n仅用于演示，不作为安全令牌。"
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 颜色尺寸.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 颜色尺寸 $为 窗口
		标题 = "颜色、尺寸与几何"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "颜色、尺寸与几何"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "输入 Android 颜色文本，观察颜色变换；尺寸结果使用当前设备密度。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "#165DFF"
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "30dp"
			文本 = "颜色预览"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 颜色 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "颜色加深与变浅"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 颜色间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 尺寸 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看尺寸与密度"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 尺寸间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 几何 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "计算两点距离"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 几何间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 随机 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "生成一般用途随机文本"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 随机间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
