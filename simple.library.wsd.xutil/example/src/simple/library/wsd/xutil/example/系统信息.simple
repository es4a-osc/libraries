''' 网络查询仅反映当前默认网络；域名解析在工作线程执行，结果取决于实际环境。
别名 XU域名 = simple.library.wsd.xutil.XU域名
别名 XU应用 = simple.library.wsd.xutil.XU应用
别名 XU文本 = simple.library.wsd.xutil.XU文本
别名 XU网络 = simple.library.wsd.xutil.XU网络
别名 XU设备 = simple.library.wsd.xutil.XU设备
别名 XU资源 = simple.library.wsd.xutil.XU资源

变量 忙 为 逻辑型
变量 来源 为 主窗口
变量 主机 为 文本型

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 应用.被单击()
	输出.文本 = XU应用.取名称() & "\n" & XU应用.取包名() & "\n版本：" & XU应用.取版本名() & " / " & XU应用.取版本号()
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 设备.被单击()
	输出.文本 = XU设备.取品牌() & " " & XU设备.取型号() & "\nAndroid " & XU设备.取系统版本() & " / API " & XU设备.取系统API()
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 网络.被单击()
	输出.文本 = "连接：" & XU网络.是否已连接() & "\n互联网已验证：" & XU网络.是否可访问互联网() & "\nWi-Fi：" & XU网络.是否无线网络() & "；移动：" & XU网络.是否移动网络() & "；VPN：" & XU网络.是否VPN()
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 域名.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	主机 = 输入.文本
	启动线程(本对象, "解析域名")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 资源.被单击()
	输出.文本 = XU资源.读资产文本("xutil-note.txt")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

过程 解析域名()
	投递消息("结果", XU文本.连接(XU域名.解析(主机), "\n"))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

事件 系统信息.反馈消息(标记 为 变体型, 数据 为 变体型)
	忙 = 假
	输入.启用 = 真
	输出.文本 = 数据
结束 事件

事件 系统信息.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 系统信息 $为 窗口
		标题 = "应用、设备与网络"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "应用、设备与网络"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "网络查询仅反映当前默认网络；域名解析在工作线程执行，结果取决于实际环境。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "localhost"
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 应用 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看当前应用"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 应用间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 设备 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看设备系统"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 设备间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 网络 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "查看默认网络"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 网络间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 域名 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "解析输入的域名"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 域名间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 资源 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "读取随应用携带的资产"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 资源间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
