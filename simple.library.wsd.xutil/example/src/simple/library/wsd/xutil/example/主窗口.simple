''' 按主题进入，具体 API 调用位于对应窗口的按钮事件中。
变量 文本正则页 为 文本正则
变量 编码摘要页 为 编码摘要
变量 对称加密页 为 对称加密
变量 日期金额页 为 日期金额
变量 字节数据页 为 字节数据
变量 配置缓存页 为 配置缓存
变量 文件归档页 为 文件归档
变量 系统信息页 为 系统信息
变量 颜色尺寸页 为 颜色尺寸
变量 界面工具页 为 界面工具

事件 入口1.被单击()
	如果 文本正则页 = 空 则
		文本正则页 = 创建 文本正则
		文本正则页.来源 = 主窗口
	结束 如果
	切换窗口(文本正则页)
结束 事件

事件 入口2.被单击()
	如果 编码摘要页 = 空 则
		编码摘要页 = 创建 编码摘要
		编码摘要页.来源 = 主窗口
	结束 如果
	切换窗口(编码摘要页)
结束 事件

事件 入口3.被单击()
	如果 对称加密页 = 空 则
		对称加密页 = 创建 对称加密
		对称加密页.来源 = 主窗口
	结束 如果
	切换窗口(对称加密页)
结束 事件

事件 入口4.被单击()
	如果 日期金额页 = 空 则
		日期金额页 = 创建 日期金额
		日期金额页.来源 = 主窗口
	结束 如果
	切换窗口(日期金额页)
结束 事件

事件 入口5.被单击()
	如果 字节数据页 = 空 则
		字节数据页 = 创建 字节数据
		字节数据页.来源 = 主窗口
	结束 如果
	切换窗口(字节数据页)
结束 事件

事件 入口6.被单击()
	如果 配置缓存页 = 空 则
		配置缓存页 = 创建 配置缓存
		配置缓存页.来源 = 主窗口
	结束 如果
	切换窗口(配置缓存页)
结束 事件

事件 入口7.被单击()
	如果 文件归档页 = 空 则
		文件归档页 = 创建 文件归档
		文件归档页.来源 = 主窗口
	结束 如果
	切换窗口(文件归档页)
结束 事件

事件 入口8.被单击()
	如果 系统信息页 = 空 则
		系统信息页 = 创建 系统信息
		系统信息页.来源 = 主窗口
	结束 如果
	切换窗口(系统信息页)
结束 事件

事件 入口9.被单击()
	如果 颜色尺寸页 = 空 则
		颜色尺寸页 = 创建 颜色尺寸
		颜色尺寸页.来源 = 主窗口
	结束 如果
	切换窗口(颜色尺寸页)
结束 事件

事件 入口10.被单击()
	如果 界面工具页 = 空 则
		界面工具页 = 创建 界面工具
		界面工具页.来源 = 主窗口
	结束 如果
	切换窗口(界面工具页)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XU工具示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "XU工具示例"
			字体大小 = 14
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "按主题查看静态函数用法；输入、操作和反馈分别固定在各主题页。"
			字体大小 = 14
		$结束 $定义
		$定义 入口 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
