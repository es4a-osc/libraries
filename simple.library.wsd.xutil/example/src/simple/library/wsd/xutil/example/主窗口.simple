''' XUtil 静态函数的本地笔记与 ZIP 归档用法；不创建工具实例，不申请存储权限。
''' 小文本编码在界面线程演示；配置、缓存和文件操作放入工作线程。
别名 文本工具 = simple.library.wsd.xutil.XUtil文本
别名 编码工具 = simple.library.wsd.xutil.XUtil编码
别名 摘要工具 = simple.library.wsd.xutil.XUtil摘要
别名 配置工具 = simple.library.wsd.xutil.XUtil配置
别名 缓存工具 = simple.library.wsd.xutil.XUtil缓存
别名 文件工具 = simple.library.wsd.xutil.XUtil文件
别名 压缩工具 = simple.library.wsd.xutil.XUtil压缩

变量 忙 为 逻辑型
变量 本轮路径 为 文本型
变量 文件路径 为 文本型
变量 ZIP路径 为 文本型
变量 解压路径 为 文本型
变量 工作文本 为 文本型
变量 文本种类 为 整数型

事件 主窗口.初始化()
	本轮路径 = 文件工具.取私有目录() & "/xutil-example/current"
	文件路径 = 本轮路径 & "/source/note.txt"
	ZIP路径 = 本轮路径 & "/note.zip"
	解压路径 = 本轮路径 & "/restored"
	路径说明.文本 = "本轮固定私有路径：" & 本轮路径
	如果 文件工具.是否文件(ZIP路径) 则 状态.文本 = "检测到上次归档，可继续解压核对；重复解压不会覆盖已有文件。"
结束 事件

事件 换文本.被单击()
	如果 忙 则 退出 事件
	文本种类 = 文本种类 + 1
	判断 文本种类
		分支 1
			输入.文本 = ""
		分支 2
			输入.文本 = "  XUtil 中文 😀 + & <tag>  "
		分支 否则
			输入.文本 = "我的本地笔记\n中文与表情 😀"
			文本种类 = 0
	结束 判断
结束 事件

事件 编码按钮.被单击()
	如果 忙 或 取文本字节数(输入.文本) > 4096 则 退出 事件
	变量 数据 为 字节型()
	变量 编码 为 文本型
	变量 回读 为 文本型
	数据 = 编码工具.文本到字节集(输入.文本)
	编码 = 编码工具.Base64编码(数据)
	回读 = 编码工具.字节集到文本(编码工具.Base64解码(编码))
	输出.文本 = "是否空=" & 文本工具.是否空(输入.文本) & "；是否空白=" & 文本工具.是否空白(输入.文本) & "；UTF-8 字节=" & 取数组成员数(数据) & "\nBase64=[" & 编码 & "]；回读一致=" & (回读 = 输入.文本) & "\nURL=[" & 编码工具.URL编码(输入.文本) & "]；回读一致=" & (编码工具.URL解码(编码工具.URL编码(输入.文本)) = 输入.文本) & "\nSHA256=" & 摘要工具.SHA256(输入.文本)
	' demo-key 是固定演示输入，不用于保存或读取用户凭据。
	输出.文本 = 输出.文本 & "\nMD5=" & 摘要工具.MD5(输入.文本) & "\nSHA1=" & 摘要工具.SHA1(输入.文本) & "\nSHA512=" & 摘要工具.SHA512(输入.文本) & "\nHMAC-SHA256（demo-key）=" & 摘要工具.HMACSHA256(输入.文本, "demo-key") & "\nHMAC-SHA512（demo-key）=" & 摘要工具.HMACSHA512(输入.文本, "demo-key") & "\n空密钥 HMAC-SHA256=" & 摘要工具.HMACSHA256(输入.文本, "")
	状态.文本 = "编码用于数据表示；摘要用于核对，不作为文本加密。"
结束 事件

事件 保存按钮.被单击()
	提交(1)
结束 事件

事件 读取按钮.被单击()
	提交(2)
结束 事件

事件 缓存写.被单击()
	提交(3)
结束 事件

事件 缓存读.被单击()
	提交(4)
结束 事件

事件 清笔记.被单击()
	提交(5)
结束 事件

事件 归档按钮.被单击()
	提交(6)
结束 事件

事件 解压按钮.被单击()
	提交(7)
结束 事件

事件 清归档.被单击()
	提交(8)
结束 事件

过程 提交(操作 为 整数型)
	如果 忙 则 退出 过程
	如果 取文本字节数(输入.文本) > 4096 则
		状态.文本 = "本示例处理不超过4096字节的小笔记，避免一次读写大文本。"
		退出 过程
	结束 如果
	工作文本 = 输入.文本
	忙 = 真
	输入.启用 = 假
	状态.文本 = "本地操作进行中，等待后台反馈。"
	变量 参数 为 变体型(1)
	参数(0) = 操作
	启动线程(本对象, "后台处理", 参数)
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			状态.文本 = "未能启动本地操作。"
	结束 错误
结束 过程

过程 后台处理(操作 为 变体型)
	变量 说明 为 文本型
	变量 路径列表 为 文本型()
	变量 索引 为 整数型
	判断 操作
		分支 1
			变量 成功 为 逻辑型
			成功 = 配置工具.写文本("xutil-example", "note", 工作文本)
			说明 = "私有笔记保存=" & 成功 & "；立即读回一致=" & (配置工具.读文本("xutil-example", "note", "<未保存>") = 工作文本)
		分支 2
			如果 配置工具.是否存在("xutil-example", "note") 则
				投递消息("载入", 配置工具.读文本("xutil-example", "note", ""))
				退出 过程
			结束 如果
			说明 = "尚未保存笔记；未把默认值当作已保存内容。"
		分支 3
			缓存工具.写文本("xutil-example", "note", 工作文本, 2)
			说明 = "写入2秒缓存；立即读回=[" & 缓存工具.读文本("xutil-example", "note", "<未命中或过期>") & "]。稍候再读取可观察过期。"
		分支 4
			说明 = "实际缓存读取=[" & 缓存工具.读文本("xutil-example", "note", "<未命中或过期>") & "]；现存条目=" & 缓存工具.取数量("xutil-example") & "；字节=" & 缓存工具.取字节数("xutil-example")
		分支 5
			说明 = "删除笔记键=" & 配置工具.删除("xutil-example", "note") & "；清空本示例缓存=" & 缓存工具.清空("xutil-example") & "。归档文件保留。"
		分支 6
			如果 文件工具.是否存在(ZIP路径) 则
				投递消息("完成", "本轮 ZIP 已存在，请先解压核对或清理本轮，再生成新归档。")
				退出 过程
			结束 如果
			如果 文件工具.创建目录(本轮路径 & "/source") = 假 则
				投递消息("完成", "无法创建本轮私有目录。")
				退出 过程
			结束 如果
			文件工具.写文本(文件路径, 工作文本, 假)
			如果 压缩工具.压缩(本轮路径 & "/source", ZIP路径) = 假 则
				投递消息("完成", "压缩返回失败，请检查本轮文件。")
				退出 过程
			结束 如果
			路径列表 = 压缩工具.列出(ZIP路径)
			说明 = "已生成本轮 ZIP；源文件=" & 文件工具.取文件长度(文件路径) & "字节；写后读回一致=" & (文件工具.读文本(文件路径) = 工作文本) & "；MD5=" & 摘要工具.文件MD5(文件路径) & "\nZIP 条目："
			循环 索引 = 0 至 取数组成员数(路径列表) - 1
				说明 = 说明 & "[" & 路径列表(索引) & "]"
			下个 索引
		分支 7
			如果 文件工具.是否文件(ZIP路径) = 假 则
				投递消息("完成", "请先生成本轮 ZIP，再解压。")
				退出 过程
			结束 如果
			' 上限为累计解压字节；库拒绝覆盖已有文件，失败时由错误处理报告。
			路径列表 = 压缩工具.解压(ZIP路径, 解压路径, 65536)
			说明 = "解压返回 " & 取数组成员数(路径列表) & " 个文件；累计上限65536字节。"
			如果 取数组成员数(路径列表) = 1 则
				说明 = 说明 & "\n实际解压文件=" & 文件工具.取文件长度(路径列表(0)) & "字节；MD5=" & 摘要工具.文件MD5(路径列表(0)) & "；与源文件一致=" & (摘要工具.文件MD5(路径列表(0)) = 摘要工具.文件MD5(文件路径)) & "；文本一致=" & (文件工具.读文本(路径列表(0)) = 文件工具.读文本(文件路径))
			结束 如果
		分支 8
			' 递归清理严格限定固定的本示例私有 current 子目录，不使用用户输入拼接路径。
			如果 本轮路径 <> (文件工具.取私有目录() & "/xutil-example/current") 则
				投递消息("完成", "归档路径校验未通过，不执行清理。")
				退出 过程
			结束 如果
			说明 = "清理本轮归档=" & 文件工具.删除(本轮路径) & "；清理后目录存在=" & 文件工具.是否存在(本轮路径)
	结束 判断
	投递消息("完成", 说明)
	位于 错误
		分支 否则
			投递消息("完成", "操作未完成，请检查文件是否存在、解压目标是否已有文件及累计解压上限。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙 = 假
	输入.启用 = 真
	如果 消息标记 = "载入" 则
		输入.文本 = 附加参数
		状态.文本 = "已从应用私有配置载入笔记；空文本也是有效值。"
	否则
		状态.文本 = 附加参数
	结束 如果
结束 事件

事件 退出按钮.被单击()
	如果 忙 则
		状态.文本 = "请等待本地任务反馈后再退出。"
		退出 事件
	结束 如果
	终止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 忙 = 假 则 终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XUtil 本地笔记与归档"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "本地笔记、缓存与 ZIP"
			字体加粗 = 真
		$结束 $定义
		$定义 用途 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "直接通过 XUtil 类型调用静态函数。笔记、缓存和归档都在应用私有目录；不需要额外存储权限。清理归档仅删除本轮固定目录。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "100dp"
			单行模式 = 假
			文本 = "我的本地笔记\n中文与表情 😀"
			提示文本 = "小笔记，UTF-8 不超过4096字节"
		$结束 $定义
		$定义 编码行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 编码按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "文本编码与摘要"
			$结束 $定义
			$定义 换文本 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换空文本 / 特殊字符"
			$结束 $定义
		$结束 $定义
		$定义 配置行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 保存按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "保存私有笔记"
			$结束 $定义
			$定义 读取按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "读取私有笔记"
			$结束 $定义
		$结束 $定义
		$定义 缓存行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 缓存写 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "写入2秒缓存"
			$结束 $定义
			$定义 缓存读 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "读取缓存"
			$结束 $定义
		$结束 $定义
		$定义 归档行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 归档按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "生成本轮 ZIP"
			$结束 $定义
			$定义 解压按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "解压并核对文件"
			$结束 $定义
		$结束 $定义
		$定义 清理行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清笔记 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "删除笔记和缓存"
			$结束 $定义
			$定义 清归档 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "清理本轮归档"
			$结束 $定义
		$结束 $定义
		$定义 路径说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "可先演示编码、保存和载入，再生成 ZIP、解压核对。重复解压不覆盖已有文件。"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "编码与摘要结果显示在这里。"
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出示例"
		$结束 $定义
	$结束 $定义
$结束 $属性
