''' 命名空间固定为 xutil-example；配置持久保存，缓存可过期或被系统清理。
别名 XU缓存 = simple.library.wsd.xutil.XU缓存
别名 XU配置 = simple.library.wsd.xutil.XU配置

变量 忙 为 逻辑型
变量 来源 为 主窗口
变量 工作文本 为 文本型

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 保存.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	工作文本 = 输入.文本
	启动线程(本对象, "保存笔记")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 读取.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "读取笔记")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 写缓存.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	工作文本 = 输入.文本
	启动线程(本对象, "保存缓存")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 读缓存.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "读取缓存")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 清理.被单击()
	如果 忙 则 退出 事件
	忙 = 真
	输入.启用 = 假
	启动线程(本对象, "清理笔记")
	位于 错误
		分支 否则
			忙 = 假
			输入.启用 = 真
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

过程 保存笔记()
	变量 成功 为 逻辑型
	成功 = XU配置.写文本("xutil-example", "note", 工作文本)
	投递消息("结果", "保存配置：" & 成功)
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 读取笔记()
	投递消息("结果", "配置笔记：" & XU配置.读文本("xutil-example", "note", "<未保存>"))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 保存缓存()
	XU缓存.写文本("xutil-example", "note", 工作文本, 2)
	投递消息("结果", "已缓存2秒，请稍候再次读取观察过期。")
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 读取缓存()
	投递消息("结果", "缓存笔记：" & XU缓存.读文本("xutil-example", "note", "<未命中或过期>"))
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

过程 清理笔记()
	变量 配置成功 为 逻辑型
	变量 缓存成功 为 逻辑型
	配置成功 = XU配置.清空("xutil-example")
	缓存成功 = XU缓存.清空("xutil-example")
	投递消息("结果", "配置清理：" & 配置成功 & "；缓存清理：" & 缓存成功)
	位于 错误
		分支 否则
			投递消息("结果", "操作未完成，请检查输入、文件和解压目标是否已有内容。")
	结束 错误
结束 过程

事件 配置缓存.反馈消息(标记 为 变体型, 数据 为 变体型)
	忙 = 假
	输入.启用 = 真
	输出.文本 = 数据
结束 事件

事件 配置缓存.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 配置缓存 $为 窗口
		标题 = "配置与缓存"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "配置与缓存"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "命名空间固定为 xutil-example；配置持久保存，缓存可过期或被系统清理。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "我的本地笔记 😀"
			提示文本 = "请输入内容"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 保存 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "保存配置笔记"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 保存间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 读取 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "读取配置笔记"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 读取间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 写缓存 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "缓存笔记（2秒）"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 写缓存间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 读缓存 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "读取缓存笔记"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 读缓存间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 清理 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "清理本示例配置与缓存"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 清理间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
