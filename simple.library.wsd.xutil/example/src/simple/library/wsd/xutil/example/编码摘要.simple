''' 文本按 UTF-8 编码；摘要用于核对数据，不能还原原文。
别名 XU摘要 = simple.library.wsd.xutil.XU摘要
别名 XU编码 = simple.library.wsd.xutil.XU编码

变量 来源 为 主窗口

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 编码.被单击()
	变量 数据 为 字节型()
	变量 编码 为 文本型
	数据 = XU编码.文本到字节集(输入.文本)
	编码 = XU编码.Base64编码(数据)
	输出.文本 = "Base64：" & 编码 & "\n原文：" & XU编码.字节集到文本(XU编码.Base64解码(编码))
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 网址.被单击()
	变量 编码 为 文本型
	编码 = XU编码.URL编码(输入.文本)
	输出.文本 = "URL：" & 编码 & "\n还原：" & XU编码.URL解码(编码)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 实体.被单击()
	输出.文本 = XU编码.HTML编码(输入.文本)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 摘要.被单击()
	输出.文本 = "SHA-256：\n" & XU摘要.SHA256(输入.文本) & "\nSHA-384：\n" & XU摘要.SHA384(输入.文本)
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 认证.被单击()
	输出.文本 = XU摘要.字节集HMAC(XU编码.文本到字节集(输入.文本), XU编码.文本到字节集("demo-key"), "HmacSHA256")
	位于 错误
		分支 否则
			输出.文本 = "操作未完成，请检查输入及本页说明。"
	结束 错误
结束 事件

事件 编码摘要.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 编码摘要 $为 窗口
		标题 = "编码与摘要"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				宽度 = "72dp"
				高度 = "46dp"
				文本 = "返回"
				背景颜色 = -15311361
				文本颜色 = -1
				字体大小 = 15
			$结束 $定义
			$定义 标题 $为 标签
				宽度 = 0
				高度 = "48dp"
				文本 = "编码与摘要"
				字体大小 = 14
				权重 = 1
				内容对齐 = 对齐_居中
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "文本按 UTF-8 编码；摘要用于核对数据，不能还原原文。"
			字体大小 = 14
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "中文 😀 + & <tag>"
			提示文本 = "请输入内容"
			单行模式 = 假
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作区内容 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 编码 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "Base64 编码并还原"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 编码间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 网址 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "URL 编码并还原"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 网址间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 实体 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "HTML 实体编码"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 实体间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 摘要 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "计算 SHA-256 与 SHA-384"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 摘要间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
				$定义 认证 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "46dp"
					文本 = "HMAC-SHA256（demo-key）"
					背景颜色 = -15311361
					文本颜色 = -1
					字体大小 = 15
				$结束 $定义
				$定义 认证间隔 $为 标签
					宽度 = 长度_匹配父级
					高度 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "142dp"
			$定义 输出 $为 标签
				宽度 = 长度_匹配父级
				文本 = "点击上方按钮，查看对应结果。"
				字体大小 = 14
				背景颜色 = -854022
				文本颜色 = -15311361
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
