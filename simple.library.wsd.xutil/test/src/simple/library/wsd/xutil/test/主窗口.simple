别名 验证 = simple.library.wsd.xutil.test.XUtilChecks
别名 网络 = simple.library.wsd.xutil.XUtil网络
别名 域名 = simple.library.wsd.xutil.XUtil域名
别名 通话 = simple.library.wsd.xutil.XUtil通话
别名 电话 = simple.library.wsd.xutil.XUtil电话
别名 键盘 = simple.library.wsd.xutil.XUtil键盘

变量 已启动 为 逻辑型
变量 正在运行 为 逻辑型

''' 延后到窗口进入前台再读剪贴板，避免在尚未获得前台权限时自检。
事件 主窗口.初始化()
	轮询.启用 = 真
	授权状态.文本 = "通话授权：" & 通话.是否已授权()
	网络状态.文本 = "默认网络连接：" & 网络.是否已连接()
结束 事件

事件 全部检查.被单击()
	开始检查()
结束 事件

''' 串行运行一组本地检查，再由工作线程验证域名和有效期。
过程 开始检查()
	如果 正在运行 则 退出 过程
	正在运行 = 真
	全部检查.启用 = 假
	结果.文本 = 验证.run()
	启动线程(本对象, "后台检查")
	轮询.启用 = 真
结束 过程

过程 后台检查()
	变量 地址 为 文本型()
	地址 = 域名.解析("localhost")
	验证.background(地址)
	位于 错误
		分支 否则
			验证.failBackground("后台域名或有效期检查失败，请查看 logcat。")
	结束 错误
结束 过程

事件 轮询.计时()
	如果 已启动 = 假 则
		已启动 = 真
		开始检查()
	否则
		如果 验证.isComplete() 则
			轮询.启用 = 假
			正在运行 = 假
			全部检查.启用 = 真
			结果.文本 = 验证.report()
		结束 如果
	结束 如果
结束 事件

''' 静态函数集只声明权限；由现有权限请求组件完成系统授权。
事件 申请通话.被单击()
	变量 权限列表 为 文本型(1)
	权限列表(0) = "android.permission.CALL_PHONE"
	授权.请求权限(权限列表, "通话授权")
	授权状态.文本 = "通话授权：" & 通话.是否已授权()
结束 事件

事件 授权.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 请求标记 为 文本型)
	断言真(请求标记 = "通话授权")
	授权状态.文本 = "通话授权：" & 通话.是否已授权()
结束 事件

事件 打开拨号.被单击()
	如果 电话.打开拨号(号码.文本) 则
		操作反馈.文本 = "已打开系统拨号界面，请自行确认。"
	否则
		操作反馈.文本 = "当前设备没有可处理拨号的应用，未拨出电话。"
	结束 如果
结束 事件

事件 显示键盘.被单击()
	键盘.显示()
结束 事件

事件 隐藏键盘.被单击()
	键盘.隐藏()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XUtil 工具集验证"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 授权 $为 权限请求
		$结束 $定义
		$定义 轮询 $为 计时器
			间隔 = 600
			启用 = 假
		$结束 $定义
		$定义 滚动区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				左填充 = "16dp"
				右填充 = "16dp"
				$定义 说明 $为 标签
					宽度 = 长度_匹配父级
					文本 = "检查静态函数集、私有数据、资源、权限及异常边界。不会自动拨出电话。"
				$结束 $定义
				$定义 全部检查 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "重新运行自动检查"
				$结束 $定义
				$定义 网络状态 $为 标签
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 授权状态 $为 标签
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 申请通话 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "验证系统通话授权"
				$结束 $定义
				$定义 号码 $为 编辑框
					宽度 = 长度_匹配父级
					文本 = "5551234"
				$结束 $定义
				$定义 打开拨号 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "打开拨号界面（不拨出）"
				$结束 $定义
				$定义 操作反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "拨号操作结果显示在这里。"
				$结束 $定义
				$定义 显示键盘 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "显示键盘（先点号码框）"
				$结束 $定义
				$定义 隐藏键盘 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "隐藏键盘"
				$结束 $定义
				$定义 结果 $为 标签
					宽度 = 长度_匹配父级
					文本 = "等待自动检查。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
