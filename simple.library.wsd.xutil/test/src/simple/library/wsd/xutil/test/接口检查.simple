''' 仅用于正式编译器逐项核对所有导出接口，不执行有副作用的调用。
过程 编译全部接口()
	变量 字节数据 为 字节型(1)

	' 文本判空、整理、转换及版本名称比较。
	simple.library.wsd.xutil.XUtil文本.是否空("验证")
	simple.library.wsd.xutil.XUtil文本.是否空白("验证")
	simple.library.wsd.xutil.XUtil文本.去首尾空白("验证")
	simple.library.wsd.xutil.XUtil文本.去全部空白("验证")
	simple.library.wsd.xutil.XUtil文本.反转("验证")
	simple.library.wsd.xutil.XUtil文本.首字母大写("验证")
	simple.library.wsd.xutil.XUtil文本.首字母小写("验证")
	simple.library.wsd.xutil.XUtil文本.忽略大小写比较("验证", "验证")
	simple.library.wsd.xutil.XUtil文本.比较版本("验证", "验证")
	simple.library.wsd.xutil.XUtil文本.到整数("验证", 1)
	simple.library.wsd.xutil.XUtil文本.到长整数("验证", 1)
	simple.library.wsd.xutil.XUtil文本.到小数("验证", 0.5)

	' 正则匹配、提取、分割与替换。
	simple.library.wsd.xutil.XUtil正则.匹配("验证", "验证")
	simple.library.wsd.xutil.XUtil正则.提取("验证", "验证")
	simple.library.wsd.xutil.XUtil正则.分割("验证", "验证")
	simple.library.wsd.xutil.XUtil正则.替换首次("验证", "验证", "验证")
	simple.library.wsd.xutil.XUtil正则.替换全部("验证", "验证", "验证")
	simple.library.wsd.xutil.XUtil正则.是否邮箱("验证")
	simple.library.wsd.xutil.XUtil正则.是否网址("验证")
	simple.library.wsd.xutil.XUtil正则.是否IP地址("验证")
	simple.library.wsd.xutil.XUtil正则.是否手机号码("验证")
	simple.library.wsd.xutil.XUtil正则.是否中文("验证")

	' UTF-8 文本、Base64、URL 与 HTML 编解码。
	simple.library.wsd.xutil.XUtil编码.文本到字节集("验证")
	simple.library.wsd.xutil.XUtil编码.字节集到文本(字节数据)
	simple.library.wsd.xutil.XUtil编码.Base64编码(字节数据)
	simple.library.wsd.xutil.XUtil编码.Base64解码("验证")
	simple.library.wsd.xutil.XUtil编码.URL编码("验证")
	simple.library.wsd.xutil.XUtil编码.URL解码("验证")
	simple.library.wsd.xutil.XUtil编码.HTML编码("验证")
	simple.library.wsd.xutil.XUtil编码.HTML解码("验证")

	' 文本及文件摘要和 HMAC；MD5、SHA1 仅用于既有协议或内容校验。
	simple.library.wsd.xutil.XUtil摘要.MD5("验证")
	simple.library.wsd.xutil.XUtil摘要.SHA1("验证")
	simple.library.wsd.xutil.XUtil摘要.SHA256("验证")
	simple.library.wsd.xutil.XUtil摘要.SHA512("验证")
	simple.library.wsd.xutil.XUtil摘要.HMACSHA256("验证", "验证")
	simple.library.wsd.xutil.XUtil摘要.HMACSHA512("验证", "验证")
	simple.library.wsd.xutil.XUtil摘要.文件MD5("验证")

	' 毫秒时间戳、格式转换、日期判断与星期查询。
	simple.library.wsd.xutil.XUtil日期.取当前时间()
	simple.library.wsd.xutil.XUtil日期.格式化(1, "验证", "验证")
	simple.library.wsd.xutil.XUtil日期.解析("验证", "验证", "验证")
	simple.library.wsd.xutil.XUtil日期.是否今天(1)
	simple.library.wsd.xutil.XUtil日期.取星期(1)
	simple.library.wsd.xutil.XUtil日期.取友好间隔(1)

	' 颜色明暗、透明比例与文本转换。
	simple.library.wsd.xutil.XUtil颜色.到文本(1)
	simple.library.wsd.xutil.XUtil颜色.从文本("验证")
	simple.library.wsd.xutil.XUtil颜色.是否深色(1)
	simple.library.wsd.xutil.XUtil颜色.置透明比例(1, 0.5)
	simple.library.wsd.xutil.XUtil颜色.加深(1, 0.5)
	simple.library.wsd.xutil.XUtil颜色.变浅(1, 0.5)

	' 设备显示密度、屏幕尺寸及 DIP、SP、像素转换。
	simple.library.wsd.xutil.XUtil尺寸.DP到像素(0.5)
	simple.library.wsd.xutil.XUtil尺寸.像素到DP(0.5)
	simple.library.wsd.xutil.XUtil尺寸.SP到像素(0.5)
	simple.library.wsd.xutil.XUtil尺寸.像素到SP(0.5)
	simple.library.wsd.xutil.XUtil尺寸.取屏幕宽度()
	simple.library.wsd.xutil.XUtil尺寸.取屏幕高度()
	simple.library.wsd.xutil.XUtil尺寸.取密度()

	' 按配置名读写应用私有 SharedPreferences，不需要存储权限。
	simple.library.wsd.xutil.XUtil配置.写文本("验证", "验证", "验证")
	simple.library.wsd.xutil.XUtil配置.读文本("验证", "验证", "验证")
	simple.library.wsd.xutil.XUtil配置.写整数("验证", "验证", 1)
	simple.library.wsd.xutil.XUtil配置.读整数("验证", "验证", 1)
	simple.library.wsd.xutil.XUtil配置.写长整数("验证", "验证", 1)
	simple.library.wsd.xutil.XUtil配置.读长整数("验证", "验证", 1)
	simple.library.wsd.xutil.XUtil配置.写逻辑("验证", "验证", 假)
	simple.library.wsd.xutil.XUtil配置.读逻辑("验证", "验证", 假)
	simple.library.wsd.xutil.XUtil配置.写单精度("验证", "验证", 0.5)
	simple.library.wsd.xutil.XUtil配置.读单精度("验证", "验证", 0.5)
	simple.library.wsd.xutil.XUtil配置.是否存在("验证", "验证")
	simple.library.wsd.xutil.XUtil配置.删除("验证", "验证")
	simple.library.wsd.xutil.XUtil配置.清空("验证")

	' 应用私有磁盘缓存，支持文本、字节集和秒级有效期。
	simple.library.wsd.xutil.XUtil缓存.写文本("验证", "验证", "验证", 1)
	simple.library.wsd.xutil.XUtil缓存.读文本("验证", "验证", "验证")
	simple.library.wsd.xutil.XUtil缓存.写字节集("验证", "验证", 字节数据, 1)
	simple.library.wsd.xutil.XUtil缓存.读字节集("验证", "验证", 字节数据)
	simple.library.wsd.xutil.XUtil缓存.删除("验证", "验证")
	simple.library.wsd.xutil.XUtil缓存.清空("验证")
	simple.library.wsd.xutil.XUtil缓存.取字节数("验证")
	simple.library.wsd.xutil.XUtil缓存.取数量("验证")

	' 文件路径、文本读写和目录操作；仅能访问应用实际有权访问的路径。
	simple.library.wsd.xutil.XUtil文件.取私有目录()
	simple.library.wsd.xutil.XUtil文件.取缓存目录()
	simple.library.wsd.xutil.XUtil文件.是否存在("验证")
	simple.library.wsd.xutil.XUtil文件.是否文件("验证")
	simple.library.wsd.xutil.XUtil文件.是否目录("验证")
	simple.library.wsd.xutil.XUtil文件.创建目录("验证")
	simple.library.wsd.xutil.XUtil文件.创建文件("验证")
	simple.library.wsd.xutil.XUtil文件.删除("验证")
	simple.library.wsd.xutil.XUtil文件.取文件长度("验证")
	simple.library.wsd.xutil.XUtil文件.读文本("验证")
	simple.library.wsd.xutil.XUtil文件.写文本("验证", "验证", 假)
	simple.library.wsd.xutil.XUtil文件.列出("验证")

	' ZIP 压缩、目录索引与受路径边界约束的解压。
	simple.library.wsd.xutil.XUtil压缩.压缩("验证", "验证")
	simple.library.wsd.xutil.XUtil压缩.列出("验证")
	simple.library.wsd.xutil.XUtil压缩.解压("验证", "验证", 1)

	' Android 公开设备信息与应用范围标识，不读取受限 IMEI、IMSI 或硬件 MAC。
	simple.library.wsd.xutil.XUtil设备.取品牌()
	simple.library.wsd.xutil.XUtil设备.取制造商()
	simple.library.wsd.xutil.XUtil设备.取型号()
	simple.library.wsd.xutil.XUtil设备.取硬件()
	simple.library.wsd.xutil.XUtil设备.取系统版本()
	simple.library.wsd.xutil.XUtil设备.取系统API()
	simple.library.wsd.xutil.XUtil设备.取AndroidID()

	' 当前应用版本、包名及可见应用信息；Android 11 起查询受包可见性限制。
	simple.library.wsd.xutil.XUtil应用.取包名()
	simple.library.wsd.xutil.XUtil应用.取名称()
	simple.library.wsd.xutil.XUtil应用.取版本名()
	simple.library.wsd.xutil.XUtil应用.取版本号()
	simple.library.wsd.xutil.XUtil应用.是否调试版()
	simple.library.wsd.xutil.XUtil应用.取安装路径()
	simple.library.wsd.xutil.XUtil应用.是否已安装("验证")

	' 查询默认网络的连接、互联网验证和传输类型。
	simple.library.wsd.xutil.XUtil网络.是否已连接()
	simple.library.wsd.xutil.XUtil网络.是否可访问互联网()
	simple.library.wsd.xutil.XUtil网络.是否无线网络()
	simple.library.wsd.xutil.XUtil网络.是否移动网络()
	simple.library.wsd.xutil.XUtil网络.是否以太网()
	simple.library.wsd.xutil.XUtil网络.是否VPN()
	simple.library.wsd.xutil.XUtil网络.是否按流量计费()

	' 域名与本机 IP 查询；可能阻塞，必须在工作线程调用。
	simple.library.wsd.xutil.XUtil域名.解析("验证")
	simple.library.wsd.xutil.XUtil域名.取本机IP(假)

	' 读取当前应用资源和资产文本。
	simple.library.wsd.xutil.XUtil资源.取标识("验证", "验证")
	simple.library.wsd.xutil.XUtil资源.取文本(1)
	simple.library.wsd.xutil.XUtil资源.取文本数组(1)
	simple.library.wsd.xutil.XUtil资源.取整数数组(1)
	simple.library.wsd.xutil.XUtil资源.取尺寸像素(1)
	simple.library.wsd.xutil.XUtil资源.读资产文本("验证")

	' 前台窗口的系统文本剪贴板；界面线程调用。
	simple.library.wsd.xutil.XUtil剪贴板.写文本("验证")
	simple.library.wsd.xutil.XUtil剪贴板.读文本()

	' 操作当前 Simple 窗口的软键盘；界面线程调用。
	simple.library.wsd.xutil.XUtil键盘.显示()
	simple.library.wsd.xutil.XUtil键盘.隐藏()
	simple.library.wsd.xutil.XUtil键盘.是否显示()

	' 一般用途随机数和随机文本，不用于密码或安全令牌。
	simple.library.wsd.xutil.XUtil随机.取整数(1, 1)
	simple.library.wsd.xutil.XUtil随机.取数字文本(1)
	simple.library.wsd.xutil.XUtil随机.取字母文本(1)
	simple.library.wsd.xutil.XUtil随机.取大写字母(1)
	simple.library.wsd.xutil.XUtil随机.取小写字母(1)
	simple.library.wsd.xutil.XUtil随机.取数字字母(1)

	' 十进制文本运算及金额格式化，避免小数通过二进制浮点输入丢失精度。
	simple.library.wsd.xutil.XUtil大数.加("验证", "验证")
	simple.library.wsd.xutil.XUtil大数.减("验证", "验证")
	simple.library.wsd.xutil.XUtil大数.乘("验证", "验证")
	simple.library.wsd.xutil.XUtil大数.除("验证", "验证", 1)
	simple.library.wsd.xutil.XUtil大数.舍入("验证", 1)
	simple.library.wsd.xutil.XUtil大数.比较("验证", "验证")
	simple.library.wsd.xutil.XUtil大数.金额格式化("验证", "验证")

	' 中国居民身份证本地格式与校验位检查、生日及脱敏，不代替联网实名核验。
	simple.library.wsd.xutil.XUtil身份证.校验("验证")
	simple.library.wsd.xutil.XUtil身份证.取生日("验证")
	simple.library.wsd.xutil.XUtil身份证.取性别("验证")
	simple.library.wsd.xutil.XUtil身份证.取省份("验证")
	simple.library.wsd.xutil.XUtil身份证.脱敏("验证")

	' 字节数组拼接、查找与切片。
	simple.library.wsd.xutil.XUtil字节集.拼接(字节数据, 字节数据)
	simple.library.wsd.xutil.XUtil字节集.查找(字节数据, 字节数据)
	simple.library.wsd.xutil.XUtil字节集.反向查找(字节数据, 字节数据)
	simple.library.wsd.xutil.XUtil字节集.切片(字节数据, 1, 1)

	' 十进制数字文本与压缩 BCD 字节集转换。
	simple.library.wsd.xutil.XUtilBCD.编码("验证")
	simple.library.wsd.xutil.XUtilBCD.解码(字节数据)

	' 二维点的距离、中点和插值。
	simple.library.wsd.xutil.XUtil几何.距离(0.5, 0.5, 0.5, 0.5)
	simple.library.wsd.xutil.XUtil几何.中点(0.5, 0.5, 0.5, 0.5)
	simple.library.wsd.xutil.XUtil几何.插值(0.5, 0.5, 0.5, 0.5, 0.5)

	' 查询电话及 SIM 类型或打开拨号界面；不读取设备受限标识。
	simple.library.wsd.xutil.XUtil电话.是否电话设备()
	simple.library.wsd.xutil.XUtil电话.取电话类型()
	simple.library.wsd.xutil.XUtil电话.SIM是否就绪()
	simple.library.wsd.xutil.XUtil电话.取运营商()
	simple.library.wsd.xutil.XUtil电话.打开拨号("验证")

	' 直接拨号，必须先取得 CALL_PHONE 运行时授权；界面线程调用。
	simple.library.wsd.xutil.XUtil通话.是否已授权()
	simple.library.wsd.xutil.XUtil通话.拨打("验证")
结束 过程

$属性
	$资源 $对象
$结束 $属性
