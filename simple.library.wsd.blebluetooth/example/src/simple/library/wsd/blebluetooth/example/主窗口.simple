''' 参考 Android BluetoothLeGatt 的扫描、连接、选择特征与读写通知流程。
''' https://github.com/android/connectivity-samples/tree/main/BluetoothLeGatt
''' 设备须支持 BLE，并准备已知协议的 GATT 外设；模拟器可能只能验证权限、失败分支和本地字节转换。
''' 填入演示字节与检查格式只在本地处理，不会连接设备或发送数据。
变量 设备地址表 为 集合
变量 设备名称表 为 集合
变量 特征服务表 为 集合
变量 特征UUID表 为 集合
变量 搜索中 为 逻辑型
变量 连接中 为 逻辑型
变量 已连接 为 逻辑型
变量 等待授权 为 逻辑型
变量 当前地址 为 文本型
变量 选中服务UUID 为 文本型
变量 选中特征UUID 为 文本型

事件 主窗口.初始化()
	设备地址表 = 创建 集合
	设备名称表 = 创建 集合
	特征服务表 = 创建 集合
	特征UUID表 = 创建 集合
	清除特征选择()
	记录日志("准备 BLE 真机和已知外设；先查看权限，再开始搜索。可先体验本地字节格式转换。")
结束 事件

' 所需权限由组件按当前设备系统返回，测试不维护版本分支。
事件 搜索按钮.被单击()
	如果 搜索中 则
		停止扫描()
	否则
		如果 连接中 或 已连接 则
			记录日志("请先断开当前设备，再开始搜索。")
		否则
			如果 等待授权 = 假 则
				变量 局_权限 为 文本型()
				变量 局_索引 为 整数型
				变量 局_已授权 为 逻辑型
				局_权限 = 蓝牙.取扫描权限()
				局_已授权 = 真
				循环 局_索引 = 0 至 取数组成员数(局_权限) - 1
					如果 授权.是否授权(局_权限(局_索引)) = 假 则 局_已授权 = 假
				下个
				如果 局_已授权 则
					开始扫描()
				否则
					等待授权 = 真
					如果 授权.请求权限(局_权限, "BLE扫描") = 假 则
						等待授权 = 假
						记录日志("无法发起权限申请，请检查应用权限设置。")
					结束 如果
				结束 如果
			结束 如果
		结束 如果
	结束 如果
结束 事件

事件 授权.请求结果(权限 为 文本型(), 结果 为 整数型(), 标记 为 文本型)
	如果 标记 = "BLE扫描" 则
		等待授权 = 假
		变量 局_已授权 为 逻辑型
		变量 局_索引 为 整数型
		局_已授权 = 取数组成员数(结果) > 0
		循环 局_索引 = 0 至 取数组成员数(结果) - 1
			如果 结果(局_索引) <> 0 则 局_已授权 = 假
		下个
		如果 局_已授权 则
			开始扫描()
		否则
			记录日志("扫描所需权限未全部授予，请检查定位及附近设备权限。")
		结束 如果
	结束 如果
结束 事件

事件 权限按钮.被单击()
	授权.打开设置()
结束 事件

过程 开始扫描()
	如果 蓝牙.初始化BLE() = 假 则
		记录日志("初始化失败：请确认设备支持 BLE、蓝牙已开启且权限可用。")
		退出 过程
	结束 如果

	设备地址表.清空()
	设备名称表.清空()
	设备列表.清空项目()
	服务列表.清空项目()
	特征服务表.清空()
	特征UUID表.清空()
	清除特征选择()
	蓝牙.开始搜索()
	搜索中 = 真
	搜索按钮.文本 = "停止搜索"
	扫描计时器.启用 = 真
	记录日志("已提交搜索请求，10 秒后停止；没有结果时请检查系统定位开关。")
结束 过程

过程 停止扫描()
	扫描计时器.启用 = 假
	蓝牙.停止搜索()
	如果 搜索中 则
		记录日志("搜索结束，共发现 " & 设备地址表.计数 & " 个设备。")
	结束 如果
	搜索中 = 假
	搜索按钮.文本 = "开始搜索"
结束 过程

事件 扫描计时器.计时()
	停止扫描()
结束 事件

' 地址与列表索引一一对应，不从显示文本反向拆分地址。
事件 蓝牙.发现设备(名称 为 文本型, 地址 为 文本型, 主标识 为 整数型, 次标识 为 整数型, 配对状态 为 整数型)
	如果 搜索中 = 假 则 退出 事件
	如果 名称 = "" 则 名称 = "未命名设备"
	设备地址表.加入(地址)
	设备名称表.加入(名称)
	设备列表.添加项目(名称 & "\n" & 地址 & "，配对状态：" & 配对状态)
	如果 主标识 <> 0 或 次标识 <> 0 则
		记录日志("iBeacon：" & 地址 & "，主标识 " & 主标识 & "，次标识 " & 次标识)
	结束 如果
结束 事件

事件 蓝牙.信号强度改变(名称 为 文本型, 地址 为 文本型, 信号强度 为 整数型)
	如果 搜索中 = 假 则 退出 事件
	变量 局_索引 为 整数型
	循环 局_索引 = 0 至 设备地址表.计数 - 1
		如果 设备地址表.项目(局_索引) = 地址 则
			设备列表.置项目文本(局_索引, 设备名称表.项目(局_索引) & "\n" & 地址 & "，信号 " & 信号强度 & " dBm")
			退出 循环
		结束 如果
	下个
结束 事件

事件 设备列表.项目被单击(索引 为 整数型)
	如果 连接中 或 已连接 则
		记录日志("请先断开当前连接。")
		退出 事件
	结束 如果
	如果 索引 < 0 或 索引 >= 设备地址表.计数 则 退出 事件
	停止扫描()
	服务列表.清空项目()
	特征服务表.清空()
	特征UUID表.清空()
	清除特征选择()
	当前地址 = 设备地址表.项目(索引)
	连接中 = 真
	断开按钮.启用 = 真
	记录日志("正在连接：" & 当前地址)
	蓝牙.连接设备(当前地址)
结束 事件

事件 断开按钮.被单击()
	' 服务绑定尚未完成时也能取消连接，不依赖一定收到断开回调。
	蓝牙.断开连接()
	蓝牙.释放资源()
	连接中 = 假
	已连接 = 假
	断开按钮.启用 = 假
	服务列表.清空项目()
	特征服务表.清空()
	特征UUID表.清空()
	清除特征选择()
	记录日志("已释放本地连接资源。")
结束 事件

事件 蓝牙.连接状态改变(状态 为 整数型)
	连接中 = 假
	已连接 = 状态 = 1
	断开按钮.启用 = 已连接
	如果 已连接 则
		记录日志("已连接：" & 当前地址 & "，等待发现服务。")
	否则
		服务列表.清空项目()
		特征服务表.清空()
		特征UUID表.清空()
		清除特征选择()
		记录日志("连接已断开或连接失败：" & 当前地址)
	结束 如果
结束 事件

' 每组数组首项为服务 UUID，其余为特征 UUID；业务标记保留真实 UUID。
事件 蓝牙.发现服务(服务信息 为 集合)
	如果 已连接 = 假 则 退出 事件
	服务列表.清空项目()
	特征服务表.清空()
	特征UUID表.清空()
	清除特征选择()
	变量 局_服务 为 整数型
	变量 局_特征 为 整数型
	变量 局_信息 为 文本型()
	循环 局_服务 = 0 至 服务信息.计数 - 1
		局_信息 = 服务信息.项目(局_服务)
		循环 局_特征 = 1 至 取数组成员数(局_信息) - 1
			特征服务表.加入(局_信息(0))
			特征UUID表.加入(局_信息(局_特征))
			服务列表.添加项目(局_信息(0) & " / " & 局_信息(局_特征) & "：" & 取特征能力(局_信息(0), 局_信息(局_特征)))
		下个
	下个
	记录日志("发现服务数：" & 服务信息.计数 & "，特征数：" & 特征UUID表.计数 & "；点击特征后读写。")
结束 事件

函数 取特征能力(服务UUID 为 文本型, 特征UUID 为 文本型) 为 文本型
	变量 局_能力 为 文本型
	如果 蓝牙.是否可读(服务UUID, 特征UUID) 则 局_能力 = 局_能力 & "可读 "
	如果 蓝牙.是否可写(服务UUID, 特征UUID) 则 局_能力 = 局_能力 & "可写 "
	如果 蓝牙.是否可通知(服务UUID, 特征UUID) 则 局_能力 = 局_能力 & "可通知/指示"
	如果 局_能力 = "" 则 局_能力 = "不支持读写或通知"
	取特征能力 = 局_能力
结束 函数

事件 服务列表.项目被单击(索引 为 整数型)
	如果 已连接 = 假 则 退出 事件
	如果 索引 < 0 或 索引 >= 特征UUID表.计数 则 退出 事件
	选中服务UUID = 特征服务表.项目(索引)
	选中特征UUID = 特征UUID表.项目(索引)
	选中标签.文本 = "服务：" & 选中服务UUID & "\n特征：" & 选中特征UUID
	读取按钮.启用 = 蓝牙.是否可读(选中服务UUID, 选中特征UUID)
	写入按钮.启用 = 蓝牙.是否可写(选中服务UUID, 选中特征UUID)
	记录日志("已选择：" & 选中特征UUID & "，" & 取特征能力(选中服务UUID, 选中特征UUID))
结束 事件

事件 读取按钮.被单击()
	如果 已连接 = 假 或 选中特征UUID = "" 则 退出 事件
	记录日志("请求读取：" & 选中特征UUID)
	蓝牙.读取数据(选中服务UUID, 选中特征UUID)
结束 事件

事件 写入按钮.被单击()
	如果 已连接 = 假 或 选中特征UUID = "" 则 退出 事件
	变量 局_有效 为 逻辑型
	变量 局_数据 为 字节型()
	局_数据 = 解析十六进制(数据输入.文本, 局_有效)
	如果 局_有效 = 假 则
		记录日志("请输入完整的十六进制字节，如 2C 5B；每字节两位，可用空白分隔。")
		退出 事件
	结束 如果
	记录日志("请求写入：" & 选中特征UUID & "，数据 " & 数据到十六进制(局_数据))
	蓝牙.写入数据(选中服务UUID, 选中特征UUID, 局_数据)
结束 事件

事件 蓝牙.读取数据完毕(结果 为 整数型, 服务UUID 为 文本型, 特征UUID 为 文本型, 数据 为 字节型())
	如果 结果 = 1 则
		记录日志("读取成功：" & 服务UUID & "/" & 特征UUID & "\n数据：" & 数据到十六进制(数据))
	否则
		记录日志("读取失败：" & 服务UUID & "/" & 特征UUID)
	结束 如果
结束 事件

事件 蓝牙.写入数据完毕(结果 为 整数型)
	如果 结果 = 1 则
		记录日志("写入成功。")
	否则
		记录日志("写入失败，请检查连接、特征能力及设备允许的数据。")
	结束 如果
结束 事件

事件 蓝牙.通道数据改变(服务UUID 为 文本型, 特征UUID 为 文本型, 数据 为 字节型())
	记录日志("收到通知：" & 服务UUID & "/" & 特征UUID & "\n数据：" & 数据到十六进制(数据))
结束 事件

' 输入按字节校验，拒绝奇数位、空输入及非十六进制字符，不默认发送设备命令。
函数 解析十六进制(正文 为 文本型, 传址 有效 为 逻辑型) 为 字节型()
	有效 = 假
	变量 局_正文 为 文本型
	变量 局_字符 为 文本型
	变量 局_索引 为 整数型
	循环 局_索引 = 0 至 取字符数(正文) - 1
		局_字符 = 取文本中间(正文, 局_索引, 1)
		如果 局_字符 <> " " 且 局_字符 <> "\t" 且 局_字符 <> "\r" 且 局_字符 <> "\n" 则
			局_正文 = 局_正文 & 局_字符
		结束 如果
	下个
	到大写(局_正文)
	如果 取字符数(局_正文) = 0 或 取字符数(局_正文) % 2 <> 0 则 退出 函数
	变量 局_数据 为 字节型(取字符数(局_正文) \ 2)
	变量 局_高位 为 整数型
	变量 局_低位 为 整数型
	循环 局_索引 = 0 至 取数组成员数(局_数据) - 1
		局_高位 = 寻找文本("0123456789ABCDEF", 取文本中间(局_正文, 局_索引 * 2, 1), 0)
		局_低位 = 寻找文本("0123456789ABCDEF", 取文本中间(局_正文, 局_索引 * 2 + 1, 1), 0)
		如果 局_高位 < 0 或 局_低位 < 0 则 退出 函数
		局_数据(局_索引) = 到字节(局_高位 * 16 + 局_低位)
	下个
	有效 = 真
	解析十六进制 = 局_数据
结束 函数

' 字节为有符号值，先与 255 按位与，保证 80 至 FF 不被扩展为负数。
函数 数据到十六进制(数据 为 字节型()) 为 文本型
	变量 局_文本 为 文本型
	变量 局_索引 为 整数型
	如果 数据 = 空 则
		数据到十六进制 = "（空）"
		退出 函数
	结束 如果
	循环 局_索引 = 0 至 取数组成员数(数据) - 1
		如果 局_索引 > 0 则 局_文本 = 局_文本 & " "
		局_文本 = 局_文本 & 取文本右边("0" & 十六进制(数据(局_索引) 且 255), 2)
	下个
	如果 局_文本 = "" 则 局_文本 = "（空）"
	数据到十六进制 = 局_文本
结束 函数

过程 清除特征选择()
	选中服务UUID = ""
	选中特征UUID = ""
	选中标签.文本 = "尚未选择特征"
	读取按钮.启用 = 假
	写入按钮.启用 = 假
结束 过程

' 限制显示长度，长时间接收通知时不会无限累积日志。
过程 记录日志(正文 为 文本型)
	如果 取字符数(日志框.文本) > 6000 则 日志框.文本 = 取文本右边(日志框.文本, 4000)
	日志框.加入文本(正文 & "\n")
结束 过程

事件 清空按钮.被单击()
	日志框.文本 = ""
结束 事件

''' 取权限清单由组件按设备系统决定，示例不复制系统版本分支。
事件 说明权限.被单击()
	变量 局_权限 为 文本型()
	变量 局_索引 为 整数型
	局_权限 = 蓝牙.取扫描权限()
	记录日志("当前系统需要 " & 取数组成员数(局_权限) & " 项运行时权限：")
	循环 局_索引 = 0 至 取数组成员数(局_权限) - 1
		记录日志(局_权限(局_索引))
	下个
结束 事件

事件 演示字节.被单击()
	数据输入.文本 = "00 7F 80 FF"
	检查本地字节()
结束 事件

事件 检查字节.被单击()
	检查本地字节()
结束 事件

''' 先核对本地字节数组，实际写入仍需用户选择外设特征并按设备协议操作。
过程 检查本地字节()
	变量 局_有效 为 逻辑型
	变量 局_数据 为 字节型()
	局_数据 = 解析十六进制(数据输入.文本, 局_有效)
	如果 局_有效 则
		记录日志("本地转换：" & 数据到十六进制(局_数据) & "，共 " & 取数组成员数(局_数据) & " 字节；未发送。")
	否则
		记录日志("格式无效：请输入成对的十六进制字节，可用空白分隔；未发送。")
	结束 如果
结束 过程

事件 主窗口.程序被销毁()
	扫描计时器.启用 = 假
	蓝牙.释放资源()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		扫描计时器.启用 = 假
		蓝牙.释放资源()
		取消事件 = 真
		终止()
	结束 如果
结束 事件


事件 蓝牙.搜索失败(错误码 为 整数型)
	停止扫描()
	记录日志("搜索失败，错误码：" & 错误码 & "；请检查蓝牙、定位和权限。")
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "BLE蓝牙使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "BLE 扫描与 GATT"
			字体加粗 = 真
		$结束 $定义
		$定义 使用条件 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "需支持 BLE 的真机和已知协议的外设。先开启蓝牙；扫描还可能需要系统定位。模拟器无 BLE 硬件时不能验证连接与收发。"
		$结束 $定义
		$定义 扫描操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 搜索按钮 $为 按钮
				文本 = "开始搜索"
				宽度 = "130dp"
