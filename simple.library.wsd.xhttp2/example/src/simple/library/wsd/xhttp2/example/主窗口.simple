''' 默认回显服务：https://httpbin.org/；只填写演示数据，不发送个人信息、密码或真实令牌。
''' 根据本库 XHttp请求、XHttp响应与客户端事件编写；服务可能限流或不可达，可换成自己的同路径服务。
别名 XHttp请求 = simple.library.wsd.xhttp2.XHttp请求
别名 XHttp响应 = simple.library.wsd.xhttp2.XHttp响应
别名 XHttp解析结果 = simple.library.wsd.xhttp2.XHttp解析结果
别名 XHttp批结果 = simple.library.wsd.xhttp2.XHttp批结果
别名 XHttp工具 = simple.library.wsd.xhttp2.XHttp工具

变量 用法 为 整数型
变量 序号 为 整数型
变量 当前标识 为 文本型
变量 忙 为 逻辑型
变量 批次中 为 逻辑型
变量 收到次数 为 整数型
变量 成功次数 为 整数型
变量 失败次数 为 整数型
变量 取消次数 为 整数型
变量 结束次数 为 整数型

事件 主窗口.初始化()
	更新用法()
	更新统计()
结束 事件

事件 下一种.被单击()
	如果 忙 则 退出 事件
	用法 = 用法 + 1
	如果 用法 > 13 则 用法 = 0
	更新用法()
结束 事件

事件 上一种.被单击()
	如果 忙 则 退出 事件
	用法 = 用法 - 1
	如果 用法 < 0 则 用法 = 13
	更新用法()
结束 事件

过程 更新用法()
	判断 用法
		分支 0
			用法说明.文本 = "1/14 GET：查询参数自动编码，回显 city=输入文本。"
		分支 1
			用法说明.文本 = "2/14 POST：UTF-8 纯文本，支持中文、表情和空文本。"
		分支 2
			用法说明.文本 = "3/14 表单 POST：name=输入文本，empty=空文本。"
		分支 3
			用法说明.文本 = "4/14 标准解析：POST 演示 JSON；从回显的 json.code/msg/data 读取业务结果。"
		分支 4
			用法说明.文本 = "5/14 缓存写入：仅网络 GET，成功后保存响应。缓存键包含地址、输入、请求头和 Cookie。"
		分支 5
			用法说明.文本 = "6/14 仅缓存 GET：先运行上一项；输入和服务地址相同才命中。未命中会报告缓存错误。"
		分支 6
			用法说明.文本 = "7/14 缓存及网络 GET：先缓存后网络，可能两次响应，但请求结束一次。"
		分支 7
			用法说明.文本 = "8/14 延时 GET：请求 delay/5；可在结束前点击取消，离开窗口也会取消请求。"
		分支 8
			用法说明.文本 = "9/14 HTTP 404：保留状态和响应体，失败不能当作成功。"
		分支 9
			用法说明.文本 = "10/14 下载 bytes/8192：填写可写绝对路径，会替换该目标；空路径不发送，无需授予整个存储访问权。"
		分支 10
			用法说明.文本 = "11/14 上传资产：将 assets/upload.txt 作为 multipart 文件上传到 post。"
		分支 11
			用法说明.文本 = "12/14 Cookie：为当前服务设置非持久演示 Cookie，再请求 cookies；可点击清空 Cookie。"
		分支 12
			用法说明.文本 = "13/14 并行批量：两个独立 GET，按输入顺序显示批次结果；失败不会跳过另一项。"
		分支 13
			用法说明.文本 = "14/14 自定义解析：在解析响应事件中从回显 JSON 提取 data 并填写业务结果。"
	结束 判断
结束 过程

事件 执行按钮.被单击()
	如果 忙 则
		阶段.文本 = "当前任务尚未结束，可等待或取消。"
		退出 事件
	结束 如果
	如果 用法 = 9 且 下载位置.文本 = "" 则
		阶段.文本 = "请先填写下载文件的可写绝对路径；不会猜测或申请额外存储权限。"
		退出 事件
	结束 如果
	网络.基础地址 = 基址.文本
	网络.默认超时 = 15000
	网络.置默认请求头("X-Example", "Simple-XHttp2")
	变量 请求 为 XHttp请求
	请求 = 创建 XHttp请求
	请求.地址 = "get"
	判断 用法
		分支 0, 4, 5, 6
			请求.添加查询参数("city", 输入.文本)
			判断 用法
				分支 4
					请求.缓存策略 = 请求.缓存_仅网络
				分支 5
					请求.缓存策略 = 请求.缓存_仅缓存
				分支 6
					请求.缓存策略 = 请求.缓存_缓存及网络
			结束 判断
		分支 1
			请求.地址 = "post"
			请求.方法 = "POST"
			请求.置文本请求体(输入.文本, "text/plain; charset=utf-8")
		分支 2
			请求.地址 = "post"
			请求.方法 = "POST"
			请求.添加表单参数("name", 输入.文本)
			请求.添加表单参数("empty", "")
		分支 3, 13
			请求.地址 = "post"
			请求.方法 = "POST"
			请求.置文本请求体("{\"code\":0,\"msg\":\"演示业务\",\"data\":\"中文 😀\"}", "application/json; charset=utf-8")
			如果 用法 = 3 则
				请求.解析方式 = 请求.解析_标准
				请求.状态路径 = "json.code"
				请求.消息路径 = "json.msg"
				请求.数据路径 = "json.data"
			否则
				请求.解析方式 = 请求.解析_自定义
			结束 如果
		分支 7
			请求.地址 = "delay/5"
		分支 8
			请求.地址 = "status/404"
		分支 9
			请求.地址 = "bytes/8192"
			请求.下载路径 = 下载位置.文本
		分支 10
			请求.地址 = "post"
			请求.方法 = "POST"
			请求.添加文件("file", "asset://upload.txt", "upload.txt", "text/plain; charset=utf-8")
		分支 11
			网络.设置Cookie(基址.文本, "simple_demo=Simple; Path=/")
			请求.地址 = "cookies"
	结束 判断
	序号 = 序号 + 1
	当前标识 = "example-" & 序号
	收到次数 = 0
	成功次数 = 0
	失败次数 = 0
	取消次数 = 0
	结束次数 = 0
	忙 = 真
	批次中 = 用法 = 12
	响应信息.文本 = "等待本次实际响应。"
	正文.文本 = ""
	进度.文本 = "等待传输进度。"
	阶段.文本 = "正在提交本次配置快照。"
	更新统计()
	如果 批次中 则
		变量 第二项 为 XHttp请求
		变量 列表 为 XHttp请求(2)
		第二项 = 请求.复制()
		请求.添加查询参数("item", "first")
		第二项.添加查询参数("item", "second")
		列表(0) = 请求
		列表(1) = 第二项
		当前标识 = 网络.批量发送(列表, 假, 假)
	否则
		请求.标识 = 当前标识
		当前标识 = 网络.发送(请求)
	结束 如果
	位于 错误
		分支 否则
			忙 = 假
			阶段.文本 = "提交失败，请检查服务地址、请求配置与窗口状态。"
	结束 错误
结束 事件

事件 取消按钮.被单击()
	变量 接受 为 逻辑型
	接受 = 网络.取消(当前标识)
	如果 接受 则
		' 取消可能在返回前同步派发结束事件，不覆盖已经到达的终态。
		如果 忙 则 阶段.文本 = "取消请求已接受，等待取消和结束事件。"
	否则
		阶段.文本 = "没有可取消任务，或下载文件已经完成提交。"
	结束 如果
结束 事件

事件 清缓存.被单击()
	如果 忙 则 退出 事件
	网络.清空缓存()
结束 事件

事件 清Cookie.被单击()
	如果 忙 则 退出 事件
	网络.清空Cookie()
	阶段.文本 = "当前客户端会话的 Cookie 已清空；不影响其它独立会话。"
结束 事件

事件 网络.请求开始(标识 为 文本型)
	阶段.文本 = "请求已开始：" & 标识
结束 事件

事件 网络.收到响应(标识 为 文本型, 响应 为 XHttp响应)
	收到次数 = 收到次数 + 1
	响应信息.文本 = "HTTP " & 响应.状态码 & "；成功=" & 响应.成功 & "；缓存=" & 响应.来自缓存 & "；字节=" & 响应.长度 & "；业务码=" & 响应.业务码 & "；消息=" & 响应.消息
	正文.文本 = 取文本左边(响应.数据, 1600)
	如果 取字符数(响应.数据) > 1600 则 正文.文本 = 正文.文本 & "…（仅展示前1600个代码单元）"
	如果 响应.错误 <> "" 则 正文.文本 = 响应.错误类型 & "：" & 响应.错误 & "\n" & 正文.文本
	如果 响应.文件 <> "" 则
		正文.文本 = "已提交下载文件：" & 响应.文件 & "；实际尺寸=" & 取文件尺寸(响应.文件)
		' 只对小文件就地读取；较大文件不一次读入内存。
		如果 取文件尺寸(响应.文件) <= 65536 则 正文.文本 = 正文.文本 & "\nSHA256=" & XHttp工具.SHA256(读入字节文件(响应.文件))
	结束 如果
	更新统计()
结束 事件

事件 网络.请求成功(标识 为 文本型, 响应 为 XHttp响应)
	成功次数 = 成功次数 + 1
	更新统计()
结束 事件

事件 网络.请求失败(标识 为 文本型, 响应 为 XHttp响应)
	失败次数 = 失败次数 + 1
	更新统计()
结束 事件

事件 网络.请求取消(标识 为 文本型)
	取消次数 = 取消次数 + 1
	阶段.文本 = "已收到取消事件：" & 标识
	更新统计()
结束 事件

事件 网络.请求结束(标识 为 文本型)
	结束次数 = 结束次数 + 1
	如果 批次中 = 假 则 忙 = 假
	阶段.文本 = "请求已结束：" & 标识 & "；响应与错误保留如下。"
	更新统计()
结束 事件

事件 网络.传输进度(标识 为 文本型, 上传 为 逻辑型, 已传输 为 长整数型, 总量 为 长整数型)
	进度.文本 = "最近进度：上传=" & 上传 & "；" & 已传输 & " / " & 总量 & " 字节（-1 表示总量未知）。"
结束 事件

事件 网络.解析响应(标识 为 文本型, 响应 为 XHttp响应, 结果 为 XHttp解析结果)
	结果.成功 = 响应.状态码 = 200
	结果.状态码 = 响应.状态码
	结果.数据 = XHttp工具.取JSON值(响应.文本, "json.data")
	结果.消息 = "Simple 自定义解析"
结束 事件

事件 网络.批次完成(结果 为 XHttp批结果)
	忙 = 假
	阶段.文本 = "批次完成：成功 " & 结果.成功数量 & "；失败 " & 结果.失败数量 & "；取消=" & 结果.已取消
	变量 列表 为 XHttp响应()
	变量 项 为 XHttp响应
	变量 索引 为 整数型
	列表 = 结果.响应列表
	正文.文本 = "按输入顺序的批次响应（每项最多显示800个代码单元）："
	循环 索引 = 0 至 取数组成员数(列表) - 1
		项 = 列表(索引)
		正文.文本 = 正文.文本 & "\n" & 索引 & "：HTTP " & 项.状态码 & "；" & 取文本左边(项.数据, 800)
	下个 索引
结束 事件

事件 网络.缓存操作完成(缓存键 为 文本型, 成功 为 逻辑型, 失败说明 为 文本型)
	阶段.文本 = "清空缓存完成：" & 成功 & "；" & 失败说明
结束 事件

过程 更新统计()
	统计.文本 = "本次操作：响应 " & 收到次数 & "；成功 " & 成功次数 & "；失败 " & 失败次数 & "；取消 " & 取消次数 & "；结束 " & 结束次数
结束 过程

事件 退出按钮.被单击()
	网络.销毁()
	终止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		网络.销毁()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XHttp2 网络示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "请求、响应与传输"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "默认使用公开 httpbin 回显服务，仅填写演示数据。服务可能限流或不可达；可改为自己的同路径服务。下载会替换填写的目标文件。"
		$结束 $定义
		$定义 网络 $为 simple.library.wsd.xhttp2.XHttp客户端
		$结束 $定义
		$定义 基址 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "https://httpbin.org/"
			提示文本 = "服务基础地址，以 / 结尾"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "杭州 + 上海 😀"
			提示文本 = "演示用文本，可空"
		$结束 $定义
		$定义 下载位置 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "下载绝对路径（仅下载用法需要）"
		$结束 $定义
		$定义 用法说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = ""
		$结束 $定义
		$定义 用法切换 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 上一种 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "上一种用法"
			$结束 $定义
			$定义 下一种 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "下一种用法"
			$结束 $定义
		$结束 $定义
		$定义 执行行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 执行按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "执行当前用法"
			$结束 $定义
			$定义 取消按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "取消当前任务"
			$结束 $定义
		$结束 $定义
		$定义 清理行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清缓存 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "清空缓存"
			$结束 $定义
			$定义 清Cookie $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "清空 Cookie"
			$结束 $定义
		$结束 $定义
		$定义 阶段 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "选择用法，再执行；请求结束前可以取消。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = ""
		$结束 $定义
		$定义 响应信息 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚无响应。"
		$结束 $定义
		$定义 进度 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "等待传输进度。"
		$结束 $定义
		$定义 正文 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = ""
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出并取消请求"
		$结束 $定义
	$结束 $定义
$结束 $属性
