$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XH2网络示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = 颜色_白
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "XH2 网络入门"
			字体大小 = 20
			文本颜色 = -14540254
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "按主题选择示例，每个按钮对应一段直接调用。默认公共回显服务可能限流，可改成同路径服务；仅使用演示数据。"
			字体大小 = 15
			文本颜色 = -14540254
		$结束 $定义
		$定义 基址 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "https://httpbin.org/"
			字体大小 = 15
			文本颜色 = -14540254
			单行模式 = 真
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "GET、JSON 与表单"
