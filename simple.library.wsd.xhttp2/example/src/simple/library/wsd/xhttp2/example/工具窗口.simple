' 每个按钮直接演示对应 API；全部输出位于操作区之后。
别名 XH2请求 = simple.library.wsd.xhttp2.XH2请求
别名 XH2工具 = simple.library.wsd.xhttp2.XH2工具

变量 来源 为 主窗口
变量 服务地址 为 文本型

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 工具窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 工具窗口.即将切换()
	网络.销毁()
	结果.销毁()
	JSON.销毁()
	摘要.销毁()
	Base64.销毁()
	网址.销毁()
	表单管理.销毁()
	参数管理.销毁()
	输入.销毁()
	输入说明.销毁()
	说明.销毁()
	标题.销毁()
	返回.销毁()
	销毁()
结束 事件

事件 参数管理.被单击()
	变量 请求 为 XH2请求
	请求 = 创建 XH2请求
	请求.添加查询参数("tag", "a")
	请求.添加查询参数("tag", "b")
	结果.文本 = "同名值数量：" & 取数组成员数(请求.取全部查询参数("tag"))
	请求.置查询参数("tag", "Simple")
	网络.添加默认参数("lang", "zh")
	网络.置默认参数("lang", "中文")
	结果.文本 = 结果.文本 & "\n替换后：" & 请求.取查询参数("tag") & "；默认参数：" & 网络.取默认参数("lang")
	请求.删除查询参数("tag")
	网络.删除默认参数("lang")
结束 事件

事件 表单管理.被单击()
	变量 请求 为 XH2请求
	请求 = 创建 XH2请求
	请求.添加表单参数("name", "first")
	请求.置表单参数("name", "Simple")
	请求.添加请求头("X-Demo", "a")
	请求.添加请求头("x-demo", "b")
	结果.文本 = "表单：" & 请求.取表单参数("name") & "；头数量：" & 取数组成员数(请求.取全部请求头("X-DEMO"))
	请求.清空表单参数()
	请求.清空请求头()
结束 事件

事件 网址.被单击()
	结果.文本 = XH2工具.网址编码(输入.文本) & "\n" & XH2工具.网址解码(XH2工具.网址编码(输入.文本)) & "\n" & XH2工具.追加查询参数("https://example.com/", "q", 输入.文本)
结束 事件

事件 Base64.被单击()
	结果.文本 = XH2工具.Base64编码(文本到字节(输入.文本)) & "\n" & 字节到文本(XH2工具.Base64解码(XH2工具.Base64编码(文本到字节(输入.文本))))
结束 事件

事件 摘要.被单击()
	结果.文本 = "SHA256：" & XH2工具.SHA256(文本到字节(输入.文本)) & "\nMD5：" & XH2工具.MD5(文本到字节(输入.文本)) & "\nHMAC：" & XH2工具.HMAC_SHA256(输入.文本, "demo-key")
结束 事件

事件 JSON.被单击()
	结果.文本 = XH2工具.取JSON值("{\"items\":[{\"name\":\"Simple\"}]}", "items[0].name")
结束 事件

$属性
	$资源 $窗口
	$定义 工具窗口 $为 窗口
		标题 = "字段管理与编码工具"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = 颜色_白
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 网络 $为 simple.library.wsd.xhttp2.XH2客户端
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "返回目录"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "字段管理与编码工具"
			字体大小 = 20
			文本颜色 = -14540254
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "这些操作不发网络请求。查询参数和表单区分大小写，请求头不区分大小写；同名值按添加顺序保留。"
			字体大小 = 15
			文本颜色 = -14540254
		$结束 $定义
		$定义 输入说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "工具输入"
			字体大小 = 15
			文本颜色 = -14540254
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "中文 + 😀"
			字体大小 = 15
			文本颜色 = -14540254
			单行模式 = 真
			提示文本 = "工具输入"
		$结束 $定义
		$定义 参数管理 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "查询参数与默认参数"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 表单管理 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "表单与请求头"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 网址 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "URL 编解码"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 Base64 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "Base64 往返"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 摘要 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "摘要与签名"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 JSON $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "读取 JSON 路径"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
