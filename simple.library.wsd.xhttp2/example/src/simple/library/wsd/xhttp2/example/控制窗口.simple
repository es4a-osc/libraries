			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "查看 HTTP 404"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 响应上限 $为 按钮
			宽度 = 长度_匹配父级
