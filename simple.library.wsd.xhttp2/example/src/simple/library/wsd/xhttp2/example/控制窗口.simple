			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
		$定义 上传进度 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
		$定义 接收进度 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
