' 每个按钮直接演示对应 API；全部输出位于操作区之后。
别名 XH2请求 = simple.library.wsd.xhttp2.XH2请求
别名 XH2响应 = simple.library.wsd.xhttp2.XH2响应
别名 XH2解析结果 = simple.library.wsd.xhttp2.XH2解析结果
别名 XH2工具 = simple.library.wsd.xhttp2.XH2工具

变量 来源 为 主窗口
变量 服务地址 为 文本型
变量 当前标识 为 文本型

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 解析窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 解析窗口.即将切换()
	网络.销毁()
	结果.销毁()
	接收进度.销毁()
	上传进度.销毁()
	信息.销毁()
	状态.销毁()
	原始.销毁()
	自定义.销毁()
	标准.销毁()
	说明.销毁()
	标题.销毁()
	返回.销毁()
	销毁()
结束 事件

事件 标准.被单击()
	如果 网络.取运行数量() > 0 则 退出 事件
	网络.基础地址 = 服务地址
	变量 请求 为 XH2请求
	请求 = 创建 XH2请求
	请求.地址 = "post"
	请求.方法 = 请求.方法_POST
	请求.置文本请求体("{\"code\":0,\"msg\":\"成功\",\"data\":\"中文 😀\"}", "application/json")
	请求.解析方式 = 请求.解析_标准
	请求.状态路径 = "json.code"
	请求.消息路径 = "json.msg"
	请求.数据路径 = "json.data"
	准备显示()
	当前标识 = 网络.发送(请求)
	位于 错误
		分支 否则
			状态.文本 = "请检查服务地址和请求配置。"
	结束 错误
结束 事件

事件 自定义.被单击()
	如果 网络.取运行数量() > 0 则 退出 事件
	网络.基础地址 = 服务地址
	变量 请求 为 XH2请求
	请求 = 创建 XH2请求
	请求.地址 = "post"
	请求.方法 = 请求.方法_POST
	请求.置文本请求体("{\"data\":\"Simple 自定义解析\"}", "application/json")
	请求.解析方式 = 请求.解析_自定义
	准备显示()
	当前标识 = 网络.发送(请求)
	位于 错误
		分支 否则
			状态.文本 = "请检查服务地址和请求配置。"
	结束 错误
结束 事件

事件 原始.被单击()
	如果 网络.取运行数量() > 0 则 退出 事件
	网络.基础地址 = 服务地址
	变量 请求 为 XH2请求
	请求 = 创建 XH2请求
	请求.地址 = "headers"
	准备显示()
	当前标识 = 网络.发送(请求)
	位于 错误
		分支 否则
			状态.文本 = "请检查服务地址和请求配置。"
	结束 错误
结束 事件

事件 网络.请求前处理(请求 为 XH2请求)
	请求.置请求头("X-Dynamic", "Simple-demo")
结束 事件

事件 网络.解析响应(标识 为 文本型, 响应 为 XH2响应, 结果 为 XH2解析结果)
	结果.成功 = 响应.状态码 = 200
	结果.状态码 = 响应.状态码
	结果.消息 = "自定义解析完成"
	结果.数据 = XH2工具.取JSON值(响应.文本, "json.data")
结束 事件

过程 准备显示()
	状态.文本 = "正在请求…"
	信息.文本 = ""
	上传进度.文本 = ""
	接收进度.文本 = ""
	结果.文本 = ""
结束 过程

事件 网络.收到响应(标识 为 文本型, 响应 为 XH2响应)
	信息.文本 = "HTTP " & 响应.状态码 & "；" & 响应.用时 & "ms；缓存=" & 响应.来自缓存
	结果.文本 = 取文本左边(响应.数据, 1200)
	如果 响应.错误 <> "" 则 结果.文本 = 响应.错误类型 & "：" & 响应.错误 & "\n" & 结果.文本
结束 事件

事件 网络.请求结束(标识 为 文本型)
	状态.文本 = "请求已结束。"
结束 事件

事件 网络.请求取消(标识 为 文本型)
	状态.文本 = "请求已取消。"
结束 事件

事件 网络.传输进度(标识 为 文本型, 上传 为 逻辑型, 已传输 为 长整数型, 总量 为 长整数型)
	如果 上传 则
		上传进度.文本 = "上传：" & 已传输 & " / " & 总量 & " 字节"
	否则
		接收进度.文本 = "接收：" & 已传输 & " / " & 总量 & " 字节"
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 解析窗口 $为 窗口
		标题 = "标准与自定义解析"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = 颜色_白
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 网络 $为 simple.library.wsd.xhttp2.XH2客户端
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "返回目录"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "标准与自定义解析"
			字体大小 = 20
			文本颜色 = -14540254
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "标准方式用路径读取业务码、消息、数据；自定义方式在解析响应事件中填写结果。"
			字体大小 = 15
			文本颜色 = -14540254
		$结束 $定义
		$定义 标准 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "标准解析"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 自定义 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "自定义解析"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 原始 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "原始响应与动态请求头"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点击按钮开始。"
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
		$定义 信息 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
		$定义 上传进度 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
		$定义 接收进度 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
			字体大小 = 15
			文本颜色 = -14540254
			顶边距 = "10dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
