' 每个按钮直接演示对应 API；全部输出位于操作区之后。
别名 XH2请求 = simple.library.wsd.xhttp2.XH2请求
别名 XH2响应 = simple.library.wsd.xhttp2.XH2响应

变量 来源 为 主窗口
变量 服务地址 为 文本型
变量 当前标识 为 文本型

事件 Cookie窗口.初始化()
	网络.置会话("xh2-example", 真)
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 Cookie窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 Cookie窗口.即将切换()
	网络.销毁()
	结果.销毁()
	接收进度.销毁()
	上传进度.销毁()
	信息.销毁()
	状态.销毁()
	清空.销毁()
	删除.销毁()
	发送.销毁()
	读取.销毁()
	保存.销毁()
	域名.销毁()
	域名说明.销毁()
	说明.销毁()
	标题.销毁()
	返回.销毁()
	销毁()
结束 事件

事件 保存.被单击()
	网络.设置Cookie(服务地址, "simple_demo=Simple; Path=/; Max-Age=3600")
	结果.文本 = "已保存演示 Cookie。"
结束 事件

事件 读取.被单击()
	变量 项 为 文本型
	结果.文本 = ""
	循环 每个 项 从 网络.取Cookie(服务地址)
		结果.文本 = 结果.文本 & 项 & "\n"
	下个
	如果 结果.文本 = "" 则 结果.文本 = "当前地址没有可用 Cookie。"
结束 事件

事件 发送.被单击()
	如果 网络.取运行数量() > 0 则 退出 事件
	网络.基础地址 = 服务地址
	变量 请求 为 XH2请求
	请求 = 创建 XH2请求
	请求.地址 = "cookies"
	准备显示()
	当前标识 = 网络.发送(请求)
	位于 错误
		分支 否则
			状态.文本 = "请检查服务地址和请求配置。"
	结束 错误
结束 事件

事件 删除.被单击()
	结果.文本 = "删除成功=" & 网络.删除Cookie("simple_demo", 域名.文本, "/")
结束 事件

事件 清空.被单击()
	网络.清空Cookie()
	结果.文本 = "当前会话 Cookie 已清空。"
结束 事件

过程 准备显示()
	状态.文本 = "正在请求…"
	信息.文本 = ""
	上传进度.文本 = ""
	接收进度.文本 = ""
	结果.文本 = ""
结束 过程

事件 网络.收到响应(标识 为 文本型, 响应 为 XH2响应)
	信息.文本 = "HTTP " & 响应.状态码 & "；" & 响应.用时 & "ms；缓存=" & 响应.来自缓存
	结果.文本 = 取文本左边(响应.数据, 1200)
	如果 响应.错误 <> "" 则 结果.文本 = 响应.错误类型 & "：" & 响应.错误 & "\n" & 结果.文本
结束 事件

事件 网络.请求结束(标识 为 文本型)
	状态.文本 = "请求已结束。"
结束 事件

事件 网络.请求取消(标识 为 文本型)
	状态.文本 = "请求已取消。"
结束 事件

事件 网络.传输进度(标识 为 文本型, 上传 为 逻辑型, 已传输 为 长整数型, 总量 为 长整数型)
	如果 上传 则
		上传进度.文本 = "上传：" & 已传输 & " / " & 总量 & " 字节"
	否则
		接收进度.文本 = "接收：" & 已传输 & " / " & 总量 & " 字节"
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 Cookie窗口 $为 窗口
		标题 = "Cookie 与命名会话"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = 颜色_白
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 网络 $为 simple.library.wsd.xhttp2.XH2客户端
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "返回目录"
			字体大小 = 15
			文本颜色 = 颜色_白
			顶边距 = "6dp"
			背景颜色 = -15181370
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "Cookie 与命名会话"
			字体大小 = 20
			文本颜色 = -14540254
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "同名会话在客户端之间共享，持久化只保存有有效期的 Cookie。此页使用固定演示会话。"
			字体大小 = 15
			文本颜色 = -14540254
		$结束 $定义
		$定义 域名说明 $为 标签
