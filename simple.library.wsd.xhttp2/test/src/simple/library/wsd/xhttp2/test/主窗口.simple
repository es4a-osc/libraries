别名 XHttp请求 = simple.library.wsd.xhttp2.XHttp请求
别名 XHttp响应 = simple.library.wsd.xhttp2.XHttp响应
别名 XHttp解析结果 = simple.library.wsd.xhttp2.XHttp解析结果
别名 XHttp批结果 = simple.library.wsd.xhttp2.XHttp批结果

变量 当前标识 为 文本型

事件 主窗口.初始化()
	网络.基础地址 = "http://127.0.0.1:18780/"
	结果.文本 = "启动 test/serve.py 并映射端口后进行网络测试。"
结束 事件

事件 请求按钮.被单击()
	变量 请求 为 XHttp请求
	请求 = 创建 XHttp请求
	请求.地址 = "echo"
	请求.添加查询参数("city", "杭州 + 上海")
	当前标识 = 网络.发送(请求)
结束 事件

事件 解析按钮.被单击()
	变量 请求 为 XHttp请求
	请求 = 创建 XHttp请求
	请求.地址 = "business"
	请求.解析方式 = 请求.解析_标准
	当前标识 = 网络.发送(请求)
结束 事件

事件 取消按钮.被单击()
	网络.取消全部()
结束 事件

事件 自定义按钮.被单击()
	变量 请求 为 XHttp请求
	请求 = 创建 XHttp请求
	请求.地址 = "business"
	请求.解析方式 = 请求.解析_自定义
	当前标识 = 网络.发送(请求)
结束 事件

事件 批次按钮.被单击()
	变量 第一项 为 XHttp请求
	变量 第二项 为 XHttp请求
	变量 请求列表 为 XHttp请求(2)
	第一项 = 创建 XHttp请求
	第二项 = 创建 XHttp请求
	第一项.地址 = "echo?index=0"
	第二项.地址 = "echo?index=1"
	请求列表(0) = 第一项
	请求列表(1) = 第二项
	当前标识 = 网络.批量发送(请求列表, 假, 假)
结束 事件

事件 延时按钮.被单击()
	变量 请求 为 XHttp请求
	请求 = 创建 XHttp请求
	请求.地址 = "delay?seconds=3"
	当前标识 = 网络.发送(请求)
结束 事件

事件 网络.请求开始(标识 为 文本型)
	结果.文本 = "正在发送：" & 标识
结束 事件

事件 网络.收到响应(标识 为 文本型, 响应 为 XHttp响应)
	结果.文本 = "状态：" & 响应.状态码 & "；缓存：" & 响应.来自缓存 & "；数据：" & 响应.数据
结束 事件

事件 网络.请求失败(标识 为 文本型, 响应 为 XHttp响应)
	结果.文本 = 响应.错误类型 & "：" & 响应.错误
结束 事件

事件 网络.解析响应(标识 为 文本型, 响应 为 XHttp响应, 解析结果 为 XHttp解析结果)
	解析结果.成功 = 真
	解析结果.数据 = "Simple 回填结果；HTTP " & 响应.状态码
	解析结果.消息 = ""
结束 事件

事件 网络.批次完成(批次 为 XHttp批结果)
	结果.文本 = "批次完成：成功 " & 批次.成功数量 & " 项，失败 " & 批次.失败数量 & " 项；取消：" & 批次.已取消
结束 事件

事件 网络.请求取消(标识 为 文本型)
	结果.文本 = "已取消：" & 标识
结束 事件

事件 主窗口.即将切换()
	网络.取消全部()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XHttp2网络测试"
		背景颜色 = -1
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 网络 $为 simple.library.wsd.xhttp2.XHttp客户端
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "可控 HTTP、TLS 与双向认证服务：test/serve.py；设备回归覆盖请求、缓存、Cookie、传输和取消。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 请求按钮 $为 按钮
			文本 = "发送中文查询"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 解析按钮 $为 按钮
			文本 = "标准业务解析"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 自定义按钮 $为 按钮
			文本 = "Simple 自定义解析"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 批次按钮 $为 按钮
			文本 = "并行批量请求"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 延时按钮 $为 按钮
			文本 = "开始延时请求"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 取消按钮 $为 按钮
			文本 = "取消全部请求"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 标签
			文本 = "等待测试。"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
