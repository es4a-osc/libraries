''' 参考 ZXing 的编码示例，改用本库的 PNG 字节集 API；不需要调用 Java 编码器。
''' https://github.com/zxing/zxing/blob/master/javase/src/main/java/com/google/zxing/client/j2se/CommandLineEncoder.java
''' 图片保存到私有 files 目录；图片框使用绝对路径，识别接口也接受私有相对路径和资产名。
变量 忙碌 为 逻辑型
变量 等待授权 为 逻辑型
变量 正在扫描 为 逻辑型
变量 操作 为 整数型
变量 工作内容 为 文本型
变量 工作路径 为 文本型
变量 返回路径 为 文本型
变量 当前路径 为 文本型
变量 当前内容 为 文本型
变量 比较生成内容 为 逻辑型
变量 生成次数 为 整数型
变量 扫描次数 为 整数型
变量 失败次数 为 整数型

事件 主窗口.初始化()
	当前路径 = "test.png"
	预览.图片 = 当前路径
	更新计数()
结束 事件

事件 图片页.被单击()
	图片操作.可视 = 真
	扫描操作.可视 = 假
结束 事件

事件 相机页.被单击()
	图片操作.可视 = 假
	扫描操作.可视 = 真
结束 事件

事件 普通码.被单击()
	工作内容 = 内容.文本
	开始任务(1)
结束 事件

事件 图标码.被单击()
	工作内容 = 内容.文本
	开始任务(2)
结束 事件

事件 长方码.被单击()
	工作内容 = 内容.文本
	开始任务(3)
结束 事件

事件 条形码.被单击()
	工作内容 = 条码内容.文本
	开始任务(4)
结束 事件

事件 识别当前.被单击()
	工作路径 = 当前路径
	开始任务(5)
结束 事件

事件 识别路径.被单击()
	工作路径 = 路径.文本
	开始任务(5)
结束 事件

事件 资产图片.被单击()
	如果 忙碌 则 退出 事件
	当前路径 = "test.png"
	当前内容 = ""
	路径.文本 = 当前路径
	预览.图片 = 当前路径
	输出.文本 = "已显示资产 test.png；点击识别查看实际内容。"
结束 事件

事件 无条码图.被单击()
	如果 忙碌 则 退出 事件
	当前路径 = "logo.png"
	当前内容 = ""
	路径.文本 = 当前路径
	预览.图片 = 当前路径
	输出.文本 = "这张图只有图标，没有条码；识别不到时返回空文本。"
结束 事件

''' 后台串行处理，完成后由反馈消息更新界面；不在工作线程读取控件。
过程 开始任务(编号 为 整数型)
	如果 忙碌 或 等待授权 或 正在扫描 则 退出 过程
	如果 编号 < 5 且 工作内容 = "" 则
		输出.文本 = "请先输入内容；空内容不生成图片，当前预览保留。"
		退出 过程
	结束 如果
	如果 编号 = 5 且 工作路径 = "" 则
		输出.文本 = "请输入资产名或图片文件路径。"
		退出 过程
	结束 如果
	操作 = 编号
	比较生成内容 = 当前内容 <> "" 且 (工作路径 = 当前路径 或 工作路径 = "barcode-example/code-" & 生成次数 & ".png")
	忙碌 = 真
	置操作状态(假)
	输出.文本 = "正在处理图片..."
	启动线程(本对象, "处理图片")
	位于 错误
		分支 否则
			忙碌 = 假
			置操作状态(真)
			输出.文本 = "无法启动图片任务；当前预览保留。"
	结束 错误
结束 过程

过程 置操作状态(可用 为 逻辑型)
	普通码.启用 = 可用
	图标码.启用 = 可用
	长方码.启用 = 可用
	条形码.启用 = 可用
	识别当前.启用 = 可用
	识别路径.启用 = 可用
	资产图片.启用 = 可用
	无条码图.启用 = 可用
	内容.启用 = 可用
	条码内容.启用 = 可用
	路径.启用 = 可用
	开始扫码.启用 = 可用
结束 过程

过程 处理图片()
	如果 操作 = 5 则
		变量 解码 为 文本型
		解码 = 码.识别二维码(工作路径)
		如果 解码 = "" 则
			投递消息("识别", "未识别到条码内容（返回空文本）。")
		否则
			变量 说明 为 文本型
			说明 = "识别结果：" & 解码
			如果 比较生成内容 则
				如果 解码 = 当前内容 则
					说明 = 说明 & "\n与生成时的内容一致。"
				否则
					说明 = 说明 & "\n与生成内容不同，请检查图片路径或清晰度。"
				结束 如果
			结束 如果
			投递消息("识别", 说明)
		结束 如果
		退出 过程
	结束 如果
	变量 数据 为 字节型()
	判断 操作
		分支 1
			数据 = 码.生成二维码(工作内容, 480)
		分支 2
			' 固定中心图标会遮挡码点；不是所有内容、尺寸都能可靠识别，须实际扫描确认。
			数据 = 码.生成二维码2(工作内容, "logo.png", 960)
		分支 3
			数据 = 码.生成二维码(工作内容, 480, 320)
		分支 4
			数据 = 码.生成条形码(工作内容, 640, 200)
	结束 判断
	如果 数据 = 空 则
		投递消息("失败", "没有生成 PNG；CODE_128 请使用支持的英文或数字，当前图片保留。")
		退出 过程
	结束 如果
	如果 取字节集长度(数据) = 0 则
		投递消息("失败", "未生成图片数据，当前图片保留。")
		退出 过程
	结束 如果
	变量 相对路径 为 文本型
	相对路径 = "barcode-example/code-" & (生成次数 + 1) & ".png"
	如果 创建目录("barcode-example") 且 写出字节文件(相对路径, 数据) 则
		变量 文件列表 为 文本型()
		变量 索引 为 整数型
		文件列表 = 取文件列表("barcode-example")
		返回路径 = ""
		循环 索引 = 0 至 取数组成员数(文件列表) - 1
			如果 取文本右边(文件列表(索引), 取字符数(相对路径)) = 相对路径 则 返回路径 = 文件列表(索引)
		下个 索引
		如果 返回路径 <> "" 则
			投递消息("生成", "已保存 PNG：" & 取字节集长度(数据) & " 字节。\n生成内容：" & 工作内容)
			退出 过程
		结束 如果
	结束 如果
	投递消息("失败", "保存私有文件失败，当前图片保留。")
	位于 错误
		分支 否则
			投递消息("失败", "处理失败；请检查图片路径、内容及 ARM 32 位原生库支持。当前预览保留。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	如果 消息标记 = "生成" 则
		生成次数 = 生成次数 + 1
		当前路径 = 返回路径
		当前内容 = 工作内容
		路径.文本 = "barcode-example/code-" & 生成次数 & ".png"
		预览.图片 = 当前路径
	结束 如果
	输出.文本 = 附加参数
	忙碌 = 假
	置操作状态(真)
	更新计数()
结束 事件

事件 开始扫码.被单击()
	如果 忙碌 或 等待授权 则 退出 事件
	如果 授权.是否授权("android.permission.CAMERA") 则
		打开相机()
	否则
		变量 所需 为 文本型(1)
		所需(0) = "android.permission.CAMERA"
		等待授权 = 真
		如果 授权.请求权限(所需, "扫码") = 假 则
			等待授权 = 假
			输出.文本 = "无法请求相机权限，可到系统设置授权后重试。"
		结束 如果
	结束 如果
结束 事件

事件 授权.请求结果(权限 为 文本型(), 结果 为 整数型(), 标记 为 文本型)
	如果 标记 <> "扫码" 则 退出 事件
	等待授权 = 假
	如果 授权.是否授权("android.permission.CAMERA") 则
		打开相机()
	否则
		输出.文本 = "相机权限未授予；生成和图片识别仍可使用。"
	结束 如果
结束 事件

过程 打开相机()
	停止计时.启用 = 假
	如果 使用ZXing.选中 则
		码.置扫描框样式(2)
	否则
		码.置扫描框样式(1)
	结束 如果
	码.置连续扫描(连续.选中)
	码.置闪光灯开启(闪光.选中)
	码.置播放音效(声音.选中)
	正在扫描 = 真
	输出.文本 = "已请求打开扫描界面；取消或返回不产生识别结果。"
	码.开始扫描()
	如果 正在扫描 且 自动停止.选中 则 停止计时.启用 = 真
	位于 错误
		分支 否则
			正在扫描 = 假
			停止计时.启用 = 假
			输出.文本 = "无法打开相机，请检查权限和设备支持。"
	结束 错误
结束 过程

事件 停止计时.计时()
	停止计时.启用 = 假
	码.停止扫描()
	正在扫描 = 假
	输出.文本 = "已调用停止扫描；未把停止当作识别成功。"
结束 事件

事件 码.扫描完毕(结果 为 文本型)
	扫描次数 = 扫描次数 + 1
	输出.文本 = "相机识别结果：" & 结果
	更新计数()
结束 事件

事件 码.扫描失败(说明 为 文本型)
	失败次数 = 失败次数 + 1
	正在扫描 = 假
	停止计时.启用 = 假
	输出.文本 = "扫描失败：" & 说明
	更新计数()
结束 事件

''' 取消没有回调；回到主窗口时清理计时，避免旧计时关闭下一次扫描。
事件 主窗口.程序被恢复()
	正在扫描 = 假
	停止计时.启用 = 假
结束 事件

过程 更新计数()
	计数.文本 = "生成 " & 生成次数 & "；相机结果 " & 扫描次数 & "；扫描失败 " & 失败次数
结束 过程

事件 主窗口.程序被销毁()
	停止计时.启用 = 假
	码.停止扫描()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 取反 忙碌 则
			停止计时.启用 = 假
			码.停止扫描()
			终止()
		结束 如果
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "条码使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 23
			文本 = "二维码与条形码"
			字体加粗 = 真
		$结束 $定义
		$定义 计数 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "生成 0；相机结果 0；扫描失败 0"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "先生成图片或识别内置资产；图片操作不需要相机权限。"
		$结束 $定义
		$定义 预览 $为 图片框
			宽度 = 长度_匹配父级
			高度 = "200dp"
			背景颜色 = &HFFFFFFFF
			显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
		$结束 $定义
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 图片页 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "生成 / 识别"
			$结束 $定义
			$定义 相机页 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "相机扫描"
			$结束 $定义
		$结束 $定义
		$定义 图片操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			$定义 二维码提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 16
				文本 = "二维码内容（UTF-8，支持中文和表情）"
			$结束 $定义
			$定义 内容 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = "你好，Simple 😀"
			$结束 $定义
			$定义 普通码 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "生成正方形二维码（480×480）"
			$结束 $定义
			$定义 长方码 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "生成长方形二维码（480×320）"
			$结束 $定义
			$定义 图标码 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "生成带图标二维码（960×960）"
			$结束 $定义
			$定义 条码提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 16
				文本 = "CODE_128：使用支持的英文、数字"
			$结束 $定义
			$定义 条码内容 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = "ES4A-2026-001"
			$结束 $定义
			$定义 条形码 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "生成 CODE_128（640×200）"
			$结束 $定义
			$定义 识别当前 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "识别当前预览图片"
			$结束 $定义
			$定义 路径 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = "test.png"
			$结束 $定义
			$定义 识别路径 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "识别指定路径（资产 / 私有 / 绝对）"
			$结束 $定义
			$定义 资产图片 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "显示内置二维码资产"
			$结束 $定义
			$定义 无条码图 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "显示没有条码的图标"
			$结束 $定义
			$定义 识别提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本 = "图片识别使用 ZBar，需要 ARM 32 位原生库。图标会遮挡二维码，生成成功不代表所有码都能识别。"
			$结束 $定义
		$结束 $定义
		$定义 扫描操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			可视 = 假
			$定义 相机提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 14
				文本 = "扫描需相机权限和清晰的实物条码。模拟器可检查权限与界面，不能代替实物扫码。取消扫描不派发识别或失败事件。"
			$结束 $定义
			$定义 使用ZXing $为 复选框
				宽度 = 长度_匹配父级
				文本 = "使用样式 2（ZXing；取消选中为 ZBar）"
				选中 = 真
			$结束 $定义
			$定义 连续 $为 复选框
				宽度 = 长度_匹配父级
				文本 = "连续扫描：成功后继续取景"
				选中 = 假
			$结束 $定义
			$定义 闪光 $为 复选框
				宽度 = 长度_匹配父级
				文本 = "打开时启用闪光灯（需设备支持）"
				选中 = 假
			$结束 $定义
			$定义 声音 $为 复选框
				宽度 = 长度_匹配父级
				文本 = "成功后播放提示音"
				选中 = 假
			$结束 $定义
			$定义 自动停止 $为 复选框
				宽度 = 长度_匹配父级
				文本 = "5 秒后调用停止扫描"
				选中 = 假
			$结束 $定义
			$定义 开始扫码 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "请求权限并开始扫描"
			$结束 $定义
		$结束 $定义
		$定义 码 $为 simple.library.wsd.barcode.条码
		$结束 $定义
		$定义 授权 $为 权限请求
		$结束 $定义
		$定义 停止计时 $为 计时器
			间隔 = 5000
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
