别名 LuaJ实例 = simple.library.wsd.luaj.LuaJ实例
别名 LuaJ值 = simple.library.wsd.luaj.LuaJ值
别名 LuaJ表 = simple.library.wsd.luaj.LuaJ表
别名 LuaJ函数 = simple.library.wsd.luaj.LuaJ函数
别名 LuaJ参数 = simple.library.wsd.luaj.LuaJ参数
别名 LuaJ协程 = simple.library.wsd.luaj.LuaJ协程
别名 LuaJ缓冲区 = simple.library.wsd.luaj.LuaJ缓冲区
别名 LuaJ错误 = simple.library.wsd.luaj.LuaJ错误
别名 LuaJ常量 = simple.library.wsd.luaj.LuaJ常量
变量 来源 为 主窗口
变量 引擎 为 LuaJ实例
变量 忙碌 为 逻辑型
变量 操作编号 为 整数型
变量 工作代码 为 文本型
变量 参数一 为 文本型
变量 参数二 为 文本型
变量 已加载 为 LuaJ函数
变量 当前协程 为 LuaJ协程
变量 协程已启动 为 逻辑型
变量 另一实例 为 LuaJ实例
变量 当前缓冲 为 LuaJ缓冲区

过程 准备()
	引擎 = 创建 LuaJ实例
	另一实例 = 创建 LuaJ实例
	当前缓冲 = 引擎.创建缓冲区()
结束 过程

过程 返回目录()
	如果 忙碌 则 退出 过程
	切换窗口(来源)
结束 过程

事件 返回按钮.被单击()
	返回目录()
结束 事件

事件 类型窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		返回目录()
	结束 如果
结束 事件

过程 提交(编号 为 整数型)
	如果 忙碌 则 退出 过程
	操作编号 = 编号
	工作代码 = 代码.文本
	忙碌 = 真
	状态.文本 = "后台执行中……"
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			状态.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

事件 类型窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙碌 = 假
	状态.文本 = 内容
结束 事件

事件 类型按钮.被单击()
	提交(1)
结束 事件

事件 判断按钮.被单击()
	提交(2)
结束 事件

事件 转换按钮.被单击()
	提交(3)
结束 事件

事件 真值按钮.被单击()
	提交(4)
结束 事件

事件 字节按钮.被单击()
	提交(5)
结束 事件

事件 对象按钮.被单击()
	提交(6)
结束 事件

事件 无效按钮.被单击()
	提交(7)
结束 事件

过程 后台处理()
	变量 结果 为 LuaJ参数
	变量 当前值 为 LuaJ值
	变量 另一值 为 LuaJ值
	变量 第三值 为 LuaJ值
	变量 原环境 为 LuaJ表
	变量 值数组 为 LuaJ值()
	变量 协程引用 为 LuaJ协程
	变量 数据对象 为 宿主数据
	变量 对象引用 为 对象
	变量 大整数 为 长整数型
	变量 表对象 为 LuaJ表
	变量 元表 为 LuaJ表
	变量 缓冲 为 LuaJ缓冲区
	变量 函数引用 为 LuaJ函数
	变量 参数 为 变体型(3)
	变量 字节 为 字节型(4)
	变量 键数组 为 LuaJ值()
	变量 当前键 为 LuaJ值
	变量 位置 为 整数型
	变量 内容 为 文本型
	判断 操作编号
		分支 1
			结果 = 引擎.执行代码("return nil,true,12,'文本',{},function()end,coroutine.create(function()end),luajava.newInstance('java.lang.StringBuilder')")
			值数组 = 结果.取全部()
			内容 = "类型编号 / 常量说明 / 类型名"
			循环 位置 = 0 至 取数组成员数(值数组) - 1
				当前值 = 值数组(位置)
				内容 = 内容 & "\n" & 当前值.取类型() & " / " & 类型说明(当前值.取类型()) & " / " & 当前值.取类型名()
			下个 位置
		分支 2
			结果 = 引擎.执行代码(工作代码)
			当前值 = 结果.取值(1)
			内容 = "类型=" & 当前值.取类型() & " / " & 当前值.取类型名()
			内容 = 内容 & "\nnil=" & 当前值.是否为空() & "；逻辑=" & 当前值.是否逻辑() & "；数值=" & 当前值.是否数值()
			内容 = 内容 & "\n整数=" & 当前值.是否整数() & "；文本=" & 当前值.是否文本() & "；表=" & 当前值.是否为表()
			内容 = 内容 & "\n函数=" & 当前值.是否函数() & "；协程=" & 当前值.是否协程() & "；用户数据=" & 当前值.是否用户数据()
		分支 3
			当前值 = 引擎.创建值(123.75)
			内容 = "123.75 到整数=" & 当前值.到整数() & "；到长整数=" & 当前值.到长整数()
			内容 = 内容 & "\n到小数=" & 当前值.到小数() & "；到文本=" & 当前值.到文本() & "；到逻辑=" & 当前值.到逻辑()
			大整数 = 9007199254740993
			当前值 = 引擎.创建值(大整数)
			内容 = 内容 & "\n原长整数=" & 大整数 & "\n经过 Lua 双精度后=" & 当前值.到长整数()
		分支 4
			当前值 = 引擎.创建值(空)
			内容 = "nil：是否为空=" & 当前值.是否为空() & "；真值=" & 当前值.到逻辑()
			当前值 = 引擎.创建值(假)
			内容 = 内容 & "\nfalse 的真值=" & 当前值.到逻辑()
			当前值 = 引擎.创建值(0)
			内容 = 内容 & "\n0 的真值=" & 当前值.到逻辑()
		分支 5
			当前值 = 引擎.创建值("中文 😀")
			内容 = "文本=" & 当前值.到文本() & "；Lua 字节长度=" & 当前值.取长度()
			字节(0) = 0
			字节(1) = 1
			字节(2) = -1
			字节(3) = 65
			当前值 = 引擎.创建值(字节)
			引擎.置全局("binary", 当前值)
			结果 = 引擎.执行代码("return #binary, string.byte(binary,1,4)")
			内容 = 内容 & "\n" & 描述结果(结果) & "\n原始字节 MD5 一致=" & (取MD5值(字节) = 取MD5值(当前值.到字节集()))
		分支 6
			数据对象 = 创建 宿主数据
			数据对象.名称 = "Simple"
			当前值 = 引擎.创建值(数据对象)
			对象引用 = 当前值.到对象()
			引擎.置全局("host", 当前值)
			结果 = 引擎.执行代码("return host['问候'](host)")
			内容 = "是否用户数据=" & 当前值.是否用户数据() & "；回读对象非空=" & (对象引用 <> 空) & "\n" & 描述结果(结果)
		分支 7
			当前值 = 引擎.创建值("不是数值")
			内容 = 当前值.到整数()
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

''' Lua 返回位置从 1 开始；不跳过 nil，也不把零返回值当成一个 nil。
函数 描述结果(结果 为 LuaJ参数) 为 文本型
	变量 位置 为 整数型
	变量 当前值 为 LuaJ值
	变量 文本 为 文本型
	文本 = "共 " & 结果.取数量() & " 项"
	循环 位置 = 1 至 结果.取数量()
		当前值 = 结果.取值(位置)
		文本 = 文本 & "\n" & 位置 & ": " & 当前值.取类型名() & " = " & 当前值.到文本()
	下个 位置
	描述结果 = 文本
结束 函数

''' 对应全部八个导出类型常量；Lua 整数仍属于数值类型。
函数 类型说明(编号 为 整数型) 为 文本型
	判断 编号
		分支 LuaJ常量.类型_空值
			类型说明 = "nil"
		分支 LuaJ常量.类型_逻辑
			类型说明 = "boolean"
		分支 LuaJ常量.类型_数值
			类型说明 = "number"
		分支 LuaJ常量.类型_文本
			类型说明 = "string"
		分支 LuaJ常量.类型_表
			类型说明 = "table"
		分支 LuaJ常量.类型_函数
			类型说明 = "function"
		分支 LuaJ常量.类型_用户数据
			类型说明 = "userdata"
		分支 LuaJ常量.类型_协程
			类型说明 = "thread"
		分支 否则
			类型说明 = "未知"
	结束 判断
结束 函数
$属性
	$资源 $窗口
	$定义 类型窗口 $为 窗口
		标题 = "类型窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 说明 $为 标签
			文本 = "类型判断遵循 LuaJ 规则，数值文本可能同时满足数值和文本判断。只有 nil 和 false 为假；Lua 字符串长度按字节计算。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 代码 $为 编辑框
			文本 = "return '123'"
			宽度 = 长度_匹配父级
			高度 = "90dp"
			单行模式 = 假
		$结束 $定义
		$定义 类型按钮 $为 按钮
			文本 = "八种类型与全部类型常量"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 判断按钮 $为 按钮
			文本 = "判断输入值的各项类型"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 转换按钮 $为 按钮
			文本 = "数值转换与大整数精度"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 真值按钮 $为 按钮
			文本 = "nil、false、零的真值"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 字节按钮 $为 按钮
			文本 = "UTF-8 长度与二进制往返"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 对象按钮 $为 按钮
			文本 = "Simple 对象与 Lua 用户数据"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 无效按钮 $为 按钮
			文本 = "演示不能转换的数值"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "选择一项操作；结果显示在这里。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 返回按钮 $为 按钮
			文本 = "返回主题目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
