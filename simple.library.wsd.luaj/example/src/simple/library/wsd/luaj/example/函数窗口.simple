' 每个按钮启动一个具名后台过程，过程内直接调用对应 API。
变量 来源 为 主窗口
变量 引擎 为 LuaJ实例
变量 忙碌 为 逻辑型
变量 参数一 为 文本型
变量 参数二 为 文本型

过程 准备()
	引擎 = 创建 LuaJ实例
结束 过程

过程 返回目录()
	如果 忙碌 则 退出 过程
	切换窗口(来源)
结束 过程

事件 返回按钮.被单击()
	返回目录()
结束 事件

事件 函数窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		返回目录()
	结束 如果
结束 事件

' 共用启动过程只管理线程和界面状态，API 调用留在各个具名后台过程中。
过程 开始任务(过程名 为 文本型)
	如果 忙碌 则 退出 过程
	参数一 = 输入一.文本
	参数二 = 输入二.文本
	忙碌 = 真
	状态.文本 = "后台执行中……"
	启动线程(本对象, 过程名)
	位于 错误
		分支 否则
			忙碌 = 假
			状态.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

事件 函数窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙碌 = 假
	状态.文本 = 内容
结束 事件

事件 函数按钮.被单击()
	开始任务("演示函数")
结束 事件

事件 参数调用按钮.被单击()
	开始任务("演示参数调用")
结束 事件

事件 参数按钮.被单击()
	开始任务("演示参数")
结束 事件

事件 全部按钮.被单击()
	开始任务("演示全部")
结束 事件

事件 回调按钮.被单击()
	开始任务("演示回调")
结束 事件

过程 演示函数()
	变量 结果 为 LuaJ参数
	变量 函数引用 为 LuaJ函数
	变量 参数 为 变体型(3)
	变量 内容 为 文本型
	结果 = 引擎.执行代码("function calculate(a,b) return a+b,a*b,nil end")
	参数(0) = 到双精度小数(参数一)
	参数(1) = 到双精度小数(参数二)
	函数引用 = 引擎.取函数("calculate")
	内容 = 来源.描述结果(函数引用.带参调用(参数))
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示参数调用()
	变量 结果 为 LuaJ参数
	变量 当前值 为 LuaJ值
	变量 函数引用 为 LuaJ函数
	变量 参数 为 变体型(3)
	变量 内容 为 文本型
	结果 = 引擎.执行代码("return function(a,b) return a+b,a*b,nil end")
	当前值 = 结果.取值(1)
	函数引用 = 当前值.作为函数()
	参数(0) = 到双精度小数(参数一)
	参数(1) = 到双精度小数(参数二)
	结果 = 引擎.创建参数(参数)
	内容 = 来源.描述结果(函数引用.使用参数调用(结果))
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示参数()
	变量 结果 为 LuaJ参数
	变量 参数 为 变体型(3)
	变量 内容 为 文本型
	参数(0) = "第一项"
	参数(2) = "末项"
	结果 = 引擎.创建参数(参数)
	内容 = 来源.描述结果(结果) & "\n从第 2 项开始：\n" & 来源.描述结果(结果.从位置取(2))
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示全部()
	变量 结果 为 LuaJ参数
	变量 当前值 为 LuaJ值
	变量 值数组 为 LuaJ值()
	变量 参数 为 变体型(3)
	变量 位置 为 整数型
	变量 内容 为 文本型
	结果 = 引擎.执行代码("return 7,nil,'末项'")
	值数组 = 结果.取全部()
	内容 = "取全部数组长度=" & 取数组成员数(值数组)
	循环 位置 = 0 至 取数组成员数(值数组) - 1
		当前值 = 值数组(位置)
		内容 = 内容 & "\n数组(" & 位置 & ")=" & 当前值.到文本()
	下个 位置
	参数(0) = "生成的新值"
	参数(2) = 9
	结果 = 结果.生成(参数)
	内容 = 内容 & "\n生成后：\n" & 来源.描述结果(结果)
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示回调()
	变量 结果 为 LuaJ参数
	变量 内容 为 文本型
	引擎.注册函数("host_add", 创建 宿主加法)
	引擎.置全局("a", 到双精度小数(参数一))
	引擎.置全局("b", 到双精度小数(参数二))
	结果 = 引擎.执行代码("return host_add(a,b)")
	内容 = "Lua 已调用宿主加法.处理调用：\n" & 来源.描述结果(结果)
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

事件 直接回调.被单击()
	开始任务("演示直接回调")
结束 事件

过程 演示直接回调()
	变量 宿主 为 LuaJ函数
	变量 函数引用 为 LuaJ函数
	变量 当前值 为 LuaJ值
	变量 结果 为 LuaJ参数
	变量 参数 为 变体型(3)
	变量 内容 为 文本型
	宿主 = 引擎.创建回调函数(创建 宿主加法)
	结果 = 引擎.执行代码("return function(callback,a,b) return callback(a,b) end")
	当前值 = 结果.取值(1)
	函数引用 = 当前值.作为函数()
	参数(0) = 宿主
	参数(1) = 到双精度小数(参数一)
	参数(2) = 到双精度小数(参数二)
	结果 = 函数引用.带参调用(参数)
	内容 = "未注册全局宿主函数：\n" & 来源.描述结果(结果)
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "LuaJ 操作失败：" & 引擎.取错误信息())
	结束 错误
结束 过程

事件 可调用表.被单击()
	开始任务("演示可调用表")
结束 事件

过程 演示可调用表()
	变量 当前值 为 LuaJ值
	变量 结果 为 LuaJ参数
	变量 参数 为 变体型(1)
	变量 内容 为 文本型
	结果 = 引擎.执行代码("return setmetatable({base=10,add=function(self,x)return self.base+x end},{__call=function(self,x)return self.base*x end})")
	当前值 = 结果.取值(1)
	参数(0) = 3
	内容 = "表调用：\n" & 来源.描述结果(当前值.带参调用(参数))
	内容 = 内容 & "\n冒号方法调用：\n" & 来源.描述结果(当前值.调用方法("add", 参数))
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "LuaJ 操作失败：" & 引擎.取错误信息())
	结束 错误
结束 过程

$属性
	$资源 $窗口
	$定义 函数窗口 $为 窗口
		标题 = "5. 函数与回调"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 返回按钮 $为 按钮
			文本 = "返回主题目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 主题标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "36dp"
			文本 = "5. 函数与回调"
			字体大小 = 20
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "同一个函数分别使用 Simple 数组和 LuaJ参数调用。参数及结果保留 nil；宿主回调通过覆写处理调用接收 Lua 请求。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 输入一 $为 编辑框
			文本 = "3"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			单行模式 = 真
		$结束 $定义
		$定义 输入二 $为 编辑框
			文本 = "5"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			单行模式 = 真
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 函数按钮 $为 按钮
					文本 = "取函数并使用数组参数调用"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 参数调用按钮 $为 按钮
					文本 = "使用 LuaJ参数调用函数"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 参数按钮 $为 按钮
					文本 = "参数数量、逐项读取和子列表"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 全部按钮 $为 按钮
					文本 = "取全部结果并生成新参数"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 回调按钮 $为 按钮
					文本 = "Lua 调用 Simple 处理调用"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 直接回调 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "48dp"
					文本 = "把宿主函数直接作为参数传入"
				$结束 $定义
				$定义 可调用表 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "48dp"
					文本 = "调用带 __call 的表和冒号方法"
				$结束 $定义
				$定义 状态 $为 标签
					文本 = "选择一项操作；结果显示在这里。"
					宽度 = 长度_匹配父级
					字体大小 = 14
					顶边距 = "8dp"
					底边距 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
