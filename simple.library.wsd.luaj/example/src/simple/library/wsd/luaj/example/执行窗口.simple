别名 LuaJ实例 = simple.library.wsd.luaj.LuaJ实例
别名 LuaJ值 = simple.library.wsd.luaj.LuaJ值
别名 LuaJ表 = simple.library.wsd.luaj.LuaJ表
别名 LuaJ函数 = simple.library.wsd.luaj.LuaJ函数
别名 LuaJ参数 = simple.library.wsd.luaj.LuaJ参数
别名 LuaJ协程 = simple.library.wsd.luaj.LuaJ协程
别名 LuaJ缓冲区 = simple.library.wsd.luaj.LuaJ缓冲区
别名 LuaJ错误 = simple.library.wsd.luaj.LuaJ错误
别名 LuaJ常量 = simple.library.wsd.luaj.LuaJ常量
变量 来源 为 主窗口
变量 引擎 为 LuaJ实例
变量 忙碌 为 逻辑型
变量 操作编号 为 整数型
变量 工作代码 为 文本型
变量 参数一 为 文本型
变量 参数二 为 文本型
变量 已加载 为 LuaJ函数
变量 当前协程 为 LuaJ协程
变量 协程已启动 为 逻辑型
变量 另一实例 为 LuaJ实例
变量 当前缓冲 为 LuaJ缓冲区

过程 准备()
	引擎 = 创建 LuaJ实例
	另一实例 = 创建 LuaJ实例
	当前缓冲 = 引擎.创建缓冲区()
结束 过程

过程 返回目录()
	如果 忙碌 则 退出 过程
	切换窗口(来源)
结束 过程

事件 返回按钮.被单击()
	返回目录()
结束 事件

事件 执行窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		返回目录()
	结束 如果
结束 事件

过程 提交(编号 为 整数型)
	如果 忙碌 则 退出 过程
	操作编号 = 编号
	工作代码 = 代码.文本
	忙碌 = 真
	状态.文本 = "后台执行中……"
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			状态.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

事件 执行窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙碌 = 假
	状态.文本 = 内容
结束 事件

事件 执行按钮.被单击()
	提交(1)
结束 事件

事件 加载按钮.被单击()
	提交(2)
结束 事件

事件 已加载按钮.被单击()
	提交(3)
结束 事件

事件 文件按钮.被单击()
	提交(4)
结束 事件

事件 全局按钮.被单击()
	提交(5)
结束 事件

事件 语法按钮.被单击()
	提交(6)
结束 事件

事件 错误按钮.被单击()
	提交(7)
结束 事件

事件 清错按钮.被单击()
	提交(8)
结束 事件

过程 后台处理()
	变量 结果 为 LuaJ参数
	变量 当前值 为 LuaJ值
	变量 另一值 为 LuaJ值
	变量 第三值 为 LuaJ值
	变量 原环境 为 LuaJ表
	变量 值数组 为 LuaJ值()
	变量 协程引用 为 LuaJ协程
	变量 数据对象 为 宿主数据
	变量 对象引用 为 对象
	变量 大整数 为 长整数型
	变量 表对象 为 LuaJ表
	变量 元表 为 LuaJ表
	变量 缓冲 为 LuaJ缓冲区
	变量 函数引用 为 LuaJ函数
	变量 参数 为 变体型(3)
	变量 字节 为 字节型(4)
	变量 键数组 为 LuaJ值()
	变量 当前键 为 LuaJ值
	变量 位置 为 整数型
	变量 内容 为 文本型
	判断 操作编号
		分支 1
			结果 = 引擎.执行代码(工作代码)
			内容 = 描述结果(结果)
		分支 2
			已加载 = 引擎.加载代码(工作代码, "输入代码")
			内容 = "加载成功，代码尚未运行。请点击执行已加载代码。"
		分支 3
			如果 已加载 = 空 则
				内容 = "请先加载代码。"
			否则
				内容 = 描述结果(已加载.调用())
			结束 如果
		分支 4
			如果 路径是否存在("luaj-example") = 假 则 创建目录("luaj-example")
			如果 写出文本文件("luaj-example/demo.lua", 工作代码) = 假 则
				内容 = "写入文件失败。"
			否则
				函数引用 = 引擎.加载文件("luaj-example/demo.lua", "UTF-8")
				结果 = 函数引用.调用()
				内容 = "先加载文件，再调用：\n" & 描述结果(结果)
				结果 = 引擎.执行文件("luaj-example/demo.lua", "UTF-8")
				内容 = 内容 & "\n直接执行文件：\n" & 描述结果(结果)
			结束 如果
		分支 5
			引擎.置全局("greeting", "你好，LuaJ")
			当前值 = 引擎.取全局("greeting")
			内容 = "读回 greeting=" & 当前值.到文本()
			引擎.置全局("greeting", "已修改")
			当前值 = 引擎.取全局("greeting")
			内容 = 内容 & "\n修改后=" & 当前值.到文本()
			引擎.置全局("greeting", 空)
			当前值 = 引擎.取全局("greeting")
			内容 = 内容 & "\n删除后是否 nil=" & 当前值.是否为空()
		分支 6
			结果 = 引擎.执行代码("return (")
		分支 7
			结果 = 引擎.执行代码("error('主动演示的运行错误')")
		分支 8
			内容 = "清除前：" & 引擎.取错误信息()
			引擎.清除错误()
			内容 = 内容 & "\n清除后：[" & 引擎.取错误信息() & "]"
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

''' Lua 返回位置从 1 开始；不跳过 nil，也不把零返回值当成一个 nil。
函数 描述结果(结果 为 LuaJ参数) 为 文本型
	变量 位置 为 整数型
	变量 当前值 为 LuaJ值
	变量 文本 为 文本型
	文本 = "共 " & 结果.取数量() & " 项"
	循环 位置 = 1 至 结果.取数量()
		当前值 = 结果.取值(位置)
		文本 = 文本 & "\n" & 位置 & ": " & 当前值.取类型名() & " = " & 当前值.到文本()
	下个 位置
	描述结果 = 文本
结束 函数
$属性
	$资源 $窗口
	$定义 执行窗口 $为 窗口
		标题 = "执行窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 说明 $为 标签
			文本 = "加载只编译，调用才执行；文件写在应用私有目录。错误说明会保留到下一次失败或主动清除。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 代码 $为 编辑框
			文本 = "return 8, '你好，LuaJ 😀', nil, true"
			宽度 = 长度_匹配父级
			高度 = "90dp"
			单行模式 = 假
		$结束 $定义
		$定义 执行按钮 $为 按钮
			文本 = "执行输入代码"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 加载按钮 $为 按钮
			文本 = "只加载输入代码"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 已加载按钮 $为 按钮
			文本 = "执行已加载代码"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 文件按钮 $为 按钮
			文本 = "文件加载、调用与直接执行"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 全局按钮 $为 按钮
			文本 = "全局值读取、修改与删除"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 语法按钮 $为 按钮
			文本 = "演示语法错误"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 错误按钮 $为 按钮
			文本 = "演示运行错误"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 清错按钮 $为 按钮
			文本 = "读取并清除最近错误"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "选择一项操作；结果显示在这里。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 返回按钮 $为 按钮
			文本 = "返回主题目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
