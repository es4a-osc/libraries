' 每个按钮启动一个具名后台过程，过程内直接调用对应 API。
变量 来源 为 主窗口
变量 引擎 为 LuaJ实例
变量 忙碌 为 逻辑型
变量 工作代码 为 文本型
变量 已加载 为 LuaJ函数

过程 准备()
	引擎 = 创建 LuaJ实例
结束 过程

过程 返回目录()
	如果 忙碌 则 退出 过程
	切换窗口(来源)
结束 过程

事件 返回按钮.被单击()
	返回目录()
结束 事件

事件 执行窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		返回目录()
	结束 如果
结束 事件

' 共用启动过程只管理线程和界面状态，API 调用留在各个具名后台过程中。
过程 开始任务(过程名 为 文本型)
	如果 忙碌 则 退出 过程
	工作代码 = 代码.文本
	忙碌 = 真
	状态.文本 = "后台执行中……"
	启动线程(本对象, 过程名)
	位于 错误
		分支 否则
			忙碌 = 假
			状态.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

事件 执行窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙碌 = 假
	状态.文本 = 内容
结束 事件

事件 执行按钮.被单击()
	开始任务("演示执行")
结束 事件

事件 加载按钮.被单击()
	开始任务("演示加载")
结束 事件

事件 已加载按钮.被单击()
	开始任务("演示已加载")
结束 事件

事件 文件按钮.被单击()
	开始任务("演示文件")
结束 事件

事件 全局按钮.被单击()
	开始任务("演示全局")
结束 事件

事件 清错按钮.被单击()
	开始任务("演示清错")
结束 事件

过程 演示执行()
	变量 结果 为 LuaJ参数
	变量 内容 为 文本型
	结果 = 引擎.执行代码(工作代码)
	内容 = 来源.描述结果(结果)
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示加载()
	变量 内容 为 文本型
	已加载 = 引擎.加载代码(工作代码, "输入代码")
	内容 = "加载成功，代码尚未运行。请点击执行已加载代码。"
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示已加载()
	变量 内容 为 文本型
	如果 已加载 = 空 则
		内容 = "请先加载代码。"
	否则
		内容 = 来源.描述结果(已加载.调用())
	结束 如果
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示文件()
	变量 结果 为 LuaJ参数
	变量 函数引用 为 LuaJ函数
	变量 内容 为 文本型
	如果 路径是否存在("luaj-example") = 假 则 创建目录("luaj-example")
	如果 写出文本文件("luaj-example/demo.lua", 工作代码) = 假 则
		内容 = "写入文件失败。"
	否则
		函数引用 = 引擎.加载文件("luaj-example/demo.lua", "UTF-8")
		结果 = 函数引用.调用()
		内容 = "先加载文件，再调用：\n" & 来源.描述结果(结果)
		结果 = 引擎.执行文件("luaj-example/demo.lua", "UTF-8")
		内容 = 内容 & "\n直接执行文件：\n" & 来源.描述结果(结果)
	结束 如果
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示全局()
	变量 当前值 为 LuaJ值
	变量 内容 为 文本型
	引擎.置全局("greeting", "你好，LuaJ")
	当前值 = 引擎.取全局("greeting")
	内容 = "读回 greeting=" & 当前值.到文本()
	引擎.置全局("greeting", "已修改")
	当前值 = 引擎.取全局("greeting")
	内容 = 内容 & "\n修改后=" & 当前值.到文本()
	引擎.置全局("greeting", 空)
	当前值 = 引擎.取全局("greeting")
	内容 = 内容 & "\n删除后是否 nil=" & 当前值.是否为空()
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

过程 演示清错()
	变量 内容 为 文本型
	内容 = "清除前：" & 引擎.取错误信息()
	引擎.清除错误()
	内容 = 内容 & "\n清除后：[" & 引擎.取错误信息() & "]"
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

$属性
	$资源 $窗口
	$定义 执行窗口 $为 窗口
		标题 = "1. 代码与文件"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 返回按钮 $为 按钮
			文本 = "返回主题目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 主题标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "36dp"
			文本 = "1. 代码与文件"
			字体大小 = 20
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "加载只编译，调用才执行；文件写在应用私有目录。错误说明会保留到下一次失败或主动清除。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 代码 $为 编辑框
			文本 = "return 8, '你好，LuaJ 😀', nil, true"
			宽度 = 长度_匹配父级
			高度 = "90dp"
			单行模式 = 假
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 执行按钮 $为 按钮
					文本 = "执行输入代码"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 加载按钮 $为 按钮
					文本 = "只加载输入代码"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 已加载按钮 $为 按钮
					文本 = "执行已加载代码"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 文件按钮 $为 按钮
					文本 = "文件加载、调用与直接执行"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 全局按钮 $为 按钮
					文本 = "全局值读取、修改与删除"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 清错按钮 $为 按钮
					文本 = "读取并清除最近错误"
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 状态 $为 标签
					文本 = "选择一项操作；结果显示在这里。"
					宽度 = 长度_匹配父级
					字体大小 = 14
					顶边距 = "8dp"
					底边距 = "8dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
