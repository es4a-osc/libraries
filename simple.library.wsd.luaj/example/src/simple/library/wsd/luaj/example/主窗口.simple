''' LuaJ 2.0.1 / Lua 5.1：每个主题使用独立环境，网络与存储权限不会自动授予脚本。

事件 执行入口.被单击()
	变量 页面 为 执行窗口
	页面 = 创建 执行窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 类型入口.被单击()
	变量 页面 为 类型窗口
	页面 = 创建 类型窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 表入口.被单击()
	变量 页面 为 表窗口
	页面 = 创建 表窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 运算入口.被单击()
	变量 页面 为 运算窗口
	页面 = 创建 运算窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 函数入口.被单击()
	变量 页面 为 函数窗口
	页面 = 创建 函数窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 协程入口.被单击()
	变量 页面 为 协程窗口
	页面 = 创建 协程窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 缓冲入口.被单击()
	变量 页面 为 缓冲窗口
	页面 = 创建 缓冲窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件

事件 实例入口.被单击()
	变量 页面 为 实例窗口
	页面 = 创建 实例窗口
	页面.来源 = 本对象
	页面.准备()
	切换窗口(页面)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "LuaJ脚本示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 说明 $为 标签
			文本 = "纯 Java LuaJ 2.0.1，支持 Lua 5.1。脚本在后台执行；各主题演示独立环境、完整返回值和可捕获错误。只运行可信短脚本；协程让出后请继续恢复至结束。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 执行入口 $为 按钮
			文本 = "01 代码、文件与错误"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 类型入口 $为 按钮
			文本 = "02 类型判断与值转换"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 表入口 $为 按钮
			文本 = "03 表、元表与函数环境"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 运算入口 $为 按钮
			文本 = "04 运算、比较与元方法"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 函数入口 $为 按钮
			文本 = "05 函数、参数与宿主回调"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 协程入口 $为 按钮
			文本 = "06 协程让出与恢复"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 缓冲入口 $为 按钮
			文本 = "07 文本与二进制缓冲区"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 实例入口 $为 按钮
			文本 = "08 实例隔离与 Java 互操作"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
