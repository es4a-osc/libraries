别名 LuaJ实例 = simple.library.wsd.luaj.LuaJ实例
别名 LuaJ值 = simple.library.wsd.luaj.LuaJ值
别名 LuaJ表 = simple.library.wsd.luaj.LuaJ表
别名 LuaJ函数 = simple.library.wsd.luaj.LuaJ函数
别名 LuaJ参数 = simple.library.wsd.luaj.LuaJ参数
别名 LuaJ协程 = simple.library.wsd.luaj.LuaJ协程
别名 LuaJ缓冲区 = simple.library.wsd.luaj.LuaJ缓冲区
别名 LuaJ错误 = simple.library.wsd.luaj.LuaJ错误
别名 LuaJ常量 = simple.library.wsd.luaj.LuaJ常量
变量 来源 为 主窗口
变量 引擎 为 LuaJ实例
变量 忙碌 为 逻辑型
变量 操作编号 为 整数型
变量 工作代码 为 文本型
变量 参数一 为 文本型
变量 参数二 为 文本型
变量 已加载 为 LuaJ函数
变量 当前协程 为 LuaJ协程
变量 协程已启动 为 逻辑型
变量 另一实例 为 LuaJ实例
变量 当前缓冲 为 LuaJ缓冲区

过程 准备()
	引擎 = 创建 LuaJ实例
	另一实例 = 创建 LuaJ实例
	当前缓冲 = 引擎.创建缓冲区()
结束 过程

过程 返回目录()
	如果 忙碌 则 退出 过程
	切换窗口(来源)
结束 过程

事件 返回按钮.被单击()
	返回目录()
结束 事件

事件 表窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		返回目录()
	结束 如果
结束 事件

过程 提交(编号 为 整数型)
	如果 忙碌 则 退出 过程
	操作编号 = 编号
	忙碌 = 真
	状态.文本 = "后台执行中……"
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			状态.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

事件 表窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙碌 = 假
	状态.文本 = 内容
结束 事件

事件 表按钮.被单击()
	提交(1)
结束 事件

事件 元表按钮.被单击()
	提交(2)
结束 事件

事件 遍历按钮.被单击()
	提交(3)
结束 事件

事件 删除按钮.被单击()
	提交(4)
结束 事件

事件 排序按钮.被单击()
	提交(5)
结束 事件

事件 弱表按钮.被单击()
	提交(6)
结束 事件

事件 环境按钮.被单击()
	提交(7)
结束 事件

过程 后台处理()
	变量 结果 为 LuaJ参数
	变量 当前值 为 LuaJ值
	变量 另一值 为 LuaJ值
	变量 第三值 为 LuaJ值
	变量 原环境 为 LuaJ表
	变量 值数组 为 LuaJ值()
	变量 协程引用 为 LuaJ协程
	变量 数据对象 为 宿主数据
	变量 对象引用 为 对象
	变量 大整数 为 长整数型
	变量 表对象 为 LuaJ表
	变量 元表 为 LuaJ表
	变量 缓冲 为 LuaJ缓冲区
	变量 函数引用 为 LuaJ函数
	变量 参数 为 变体型(3)
	变量 字节 为 字节型(4)
	变量 键数组 为 LuaJ值()
	变量 当前键 为 LuaJ值
	变量 位置 为 整数型
	变量 内容 为 文本型
	判断 操作编号
		分支 1
			表对象 = 引擎.创建表()
			表对象.置字段("name", "小明")
			表对象.插入(1, 3)
			表对象.插入(2, 1)
			表对象.插入(3, 2)
			表对象.排序()
			内容 = "字段数=" & 表对象.取字段数() & "；顺序长度=" & 表对象.取长度() & "；顺序项=" & 表对象.连接文本(",", 1, 3)
			键数组 = 表对象.取全部键()
			循环 位置 = 0 至 取数组成员数(键数组) - 1
				当前键 = 键数组(位置)
				当前值 = 表对象.取字段(当前键)
				内容 = 内容 & "\n快照键 " & 当前键.到文本() & " = " & 当前值.到文本()
			下个 位置
		分支 2
			表对象 = 引擎.创建表()
			结果 = 引擎.执行代码("return {__index=function(t,k) return '默认:'..k end,__newindex=function(t,k,v) rawset(t,'stored_'..k,v) end}")
			当前值 = 结果.取值(1)
			元表 = 当前值.作为表()
			当前值 = 表对象.置元表(元表)
			表对象 = 当前值.作为表()
			表对象.置字段("name", "由元方法保存")
			当前值 = 表对象.原样取字段("stored_name")
			内容 = "__newindex 写入 stored_name=" & 当前值.到文本()
			当前值 = 表对象.取字段("name")
			内容 = 内容 & "\n普通读取 name=" & 当前值.到文本()
			表对象.原样置字段("name", "原样写入")
			当前值 = 表对象.取字段("name")
			内容 = 内容 & "\n原样写入后 name=" & 当前值.到文本()
			当前值 = 表对象.置元表(空)
			表对象 = 当前值.作为表()
			当前值 = 表对象.取元表()
			内容 = 内容 & "\n移除后元表是否 nil=" & 当前值.是否为空()
		分支 3
			表对象 = 引擎.创建表()
			表对象.置字段("name", "甲")
			表对象.置字段("score", 7)
			当前键 = 引擎.创建值(空)
			内容 = "nil 键开始；返回零项表示结束"
			循环 位置 = 0 至 表对象.取字段数()
				结果 = 表对象.取下一项(当前键)
				如果 结果.取数量() = 0 则
					内容 = 内容 & "\n遍历结束：0 项"
					退出 循环
				结束 如果
				当前键 = 结果.取值(1)
				当前值 = 结果.取值(2)
				内容 = 内容 & "\n" & 当前键.到文本() & " = " & 当前值.到文本()
			下个 位置
		分支 4
			表对象 = 引擎.创建表()
			表对象.插入(1, 1)
			表对象.插入(2, 2)
			表对象.插入(3, 3)
			当前值 = 表对象.删除(2)
			内容 = "删除第 2 项=" & 当前值.到文本() & "；剩余=" & 表对象.连接文本(",", 1, 2)
			表对象.置字段("name", "临时字段")
			表对象.原样置字段("name", 空)
			当前值 = 表对象.原样取字段("name")
			内容 = 内容 & "\n命名字段删除后是否 nil=" & 当前值.是否为空()
		分支 5
			表对象 = 引擎.创建表()
			表对象.插入(1, 1)
			表对象.插入(2, 3)
			表对象.插入(3, 2)
			结果 = 引擎.执行代码("return function(a,b) return a>b end")
			当前值 = 结果.取值(1)
			函数引用 = 当前值.作为函数()
			表对象.自定义排序(函数引用)
			内容 = "自定义降序=" & 表对象.连接文本(",", 1, 3)
		分支 6
			表对象 = 引擎.创建弱表(真, 真)
			当前值 = 表对象.取元表()
			当前值 = 当前值.取字段("__mode")
			内容 = "弱键弱值 __mode=" & 当前值.到文本() & "；字段数=" & 表对象.取字段数()
		分支 7
			引擎.置全局("label", "默认环境")
			引擎.置全局("number", 1)
			结果 = 引擎.执行代码("return function() return label,number end")
			当前值 = 结果.取值(1)
			函数引用 = 当前值.作为函数()
			当前值 = 函数引用.取环境()
			原环境 = 当前值.作为表()
			表对象 = 引擎.创建表()
			表对象.置字段("label", "自定义环境")
			表对象.置字段("number", 9)
			函数引用.置环境(表对象)
			内容 = "替换环境：\n" & 描述结果(函数引用.调用())
			函数引用.置环境(原环境)
			内容 = 内容 & "\n恢复环境：\n" & 描述结果(函数引用.调用())
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 LuaJ错误
			投递消息("失败", "已捕获 LuaJ错误：" & 引擎.取错误信息())
		分支 否则
			投递消息("失败", "操作失败，请检查输入及运行日志。")
	结束 错误
结束 过程

''' Lua 返回位置从 1 开始；不跳过 nil，也不把零返回值当成一个 nil。
函数 描述结果(结果 为 LuaJ参数) 为 文本型
	变量 位置 为 整数型
	变量 当前值 为 LuaJ值
	变量 文本 为 文本型
	文本 = "共 " & 结果.取数量() & " 项"
	循环 位置 = 1 至 结果.取数量()
		当前值 = 结果.取值(位置)
		文本 = 文本 & "\n" & 位置 & ": " & 当前值.取类型名() & " = " & 当前值.到文本()
	下个 位置
	描述结果 = 文本
结束 函数
$属性
	$资源 $窗口
	$定义 表窗口 $为 窗口
		标题 = "表窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 说明 $为 标签
			文本 = "表的字段数与顺序长度不同。原样读写绕过元方法；next 从 nil 键开始。设置元表后使用返回对象，环境操作结束后恢复原环境。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 表按钮 $为 按钮
			文本 = "表字段、数组与键快照"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 元表按钮 $为 按钮
			文本 = "元方法、原样读写与移除元表"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 遍历按钮 $为 按钮
			文本 = "使用 next 逐项遍历"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 删除按钮 $为 按钮
			文本 = "删除顺序项和命名字段"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 排序按钮 $为 按钮
			文本 = "使用比较函数降序排序"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 弱表按钮 $为 按钮
			文本 = "创建并读取弱表模式"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 环境按钮 $为 按钮
			文本 = "取得、替换和恢复函数环境"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "选择一项操作；结果显示在这里。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 返回按钮 $为 按钮
			文本 = "返回主题目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
