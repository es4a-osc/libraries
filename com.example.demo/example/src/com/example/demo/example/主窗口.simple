''' 从当前类库开发文档和 Java API 改写：演示普通对象、组件属性及事件的实际用法。
别名 演示对象 = com.example.demo.演示对象

变量 点击次数 为 整数型
变量 文本种类 为 整数型

''' 创建普通对象，再通过实例调用函数；点击事件也同步修改组件标题。
事件 实例按钮.被单击()
	变量 工具 为 演示对象
	工具 = 创建 演示对象
	输出.文本 = "输出：" & 工具.加前缀(输入.文本)
	点击次数 = 点击次数 + 1
	实例按钮.标题 = "再次添加前缀（已点击 " & 点击次数 & " 次）"
	说明.文本 = "实例函数加前缀已执行，按钮标题也由事件代码更新。"
结束 事件

''' 静态函数通过类型直接调用，返回 UTF-16 代码单元数量。
事件 长度按钮.被单击()
	输出.文本 = "UTF-16 长度：" & 演示对象.取长度(输入.文本)
	说明.文本 = "中文通常占 1 个代码单元，😀 占 2 个；空文本长度为 0。"
结束 事件

''' 用三种输入观察同一函数对普通文本、emoji 和空文本的返回结果。
事件 切换文本.被单击()
	文本种类 = 文本种类 + 1
	判断 文本种类
		分支 1
			输入.文本 = "你好😀"
		分支 2
			输入.文本 = ""
		分支 否则
			输入.文本 = "你好，Simple"
			文本种类 = 0
	结束 判断
	输出.文本 = "已切换输入，请选择下面的演示按钮。"
结束 事件

''' 恢复输入和组件状态，便于重新体验完整操作。
事件 还原.被单击()
	点击次数 = 0
	文本种类 = 0
	输入.文本 = "你好，Simple"
	实例按钮.标题 = "创建对象并添加前缀"
	输出.文本 = "在上方输入文本，再选择一种调用方式。"
	说明.文本 = "实例函数需要先创建对象；静态函数通过类型直接调用。"
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "演示扩展库示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "组件与普通对象"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "实例函数需要先创建对象；静态函数通过类型直接调用。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，Simple"
			提示文本 = "请输入一段文本"
		$结束 $定义
		$定义 切换文本 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "切换示例文本：中文 / emoji / 空文本"
		$结束 $定义
		$定义 实例按钮 $为 com.example.demo.演示按钮
			宽度 = 长度_匹配父级
			标题 = "创建对象并添加前缀"
		$结束 $定义
		$定义 长度按钮 $为 com.example.demo.演示按钮
			宽度 = 长度_匹配父级
			标题 = "直接调用静态函数取长度"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 18
			文本 = "在上方输入文本，再选择一种调用方式。"
		$结束 $定义
		$定义 还原 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "恢复初始状态"
		$结束 $定义
	$结束 $定义
$结束 $属性
