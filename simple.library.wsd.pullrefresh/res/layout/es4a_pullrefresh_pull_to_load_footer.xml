<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="60dp"
	android:orientation="horizontal"
	android:gravity="center"
	android:paddingLeft="16dp"
	android:paddingRight="16dp">

	<FrameLayout
		android:layout_width="28dp"
		android:layout_height="28dp"
		android:layout_marginRight="10dp">

		<ImageView
			android:id="@+id/es4a_pullrefresh_pull_to_load_footer_arrow"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scaleType="centerInside"
			android:importantForAccessibility="no"
			android:src="@drawable/es4a_pullrefresh_xsearch_msg_pull_arrow_down" />

		<ProgressBar
			android:id="@+id/es4a_pullrefresh_pull_to_load_footer_progressbar"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:indeterminateDrawable="@anim/es4a_pullrefresh_update_loading_progressbar_anim"
			android:visibility="invisible" />
	</FrameLayout>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:gravity="center_vertical">

		<TextView
			android:id="@+id/es4a_pullrefresh_pull_to_load_footer_hint_textview"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxWidth="260dp"
			android:maxLines="1"
			android:ellipsize="end"
			android:textColor="?android:attr/textColorPrimary"
			android:textSize="14sp" />

		<TextView
			android:id="@+id/es4a_pullrefresh_pull_to_load_footer_auxiliary_textview"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="3dp"
			android:maxWidth="260dp"
			android:maxLines="1"
			android:ellipsize="end"
			android:textColor="?android:attr/textColorSecondary"
			android:textSize="12sp"
			android:visibility="gone" />
	</LinearLayout>
</LinearLayout>
