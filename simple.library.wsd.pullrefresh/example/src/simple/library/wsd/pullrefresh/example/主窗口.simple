''' 按当前拉动刷新框源码和已有手势窗口组织：容器只发出开始事件，应用负责业务及停止。
''' 普通子组件直接放入刷新容器，不再嵌套第二个滚动容器。
变量 已就绪 为 逻辑型
变量 行数 为 整数型
变量 处理方向 为 整数型
变量 下拉开始次数 为 整数型
变量 上拉开始次数 为 整数型
变量 下拉完成次数 为 整数型
变量 上拉完成次数 为 整数型
变量 自定义文案 为 逻辑型

事件 主窗口.初始化()
	行数 = 30
	更新内容()
	应用文案()
	已就绪 = 真
	更新状态()
结束 事件

过程 更新内容()
	变量 索引 为 整数型
	变量 文本 为 文本型
	文本 = "消息列表 · 更新版本 " & 下拉完成次数
	循环 索引 = 1 至 行数
		文本 = 文本 & "\n消息 " & 索引 & "：本地演示内容"
	下个 索引
	内容.文本 = 文本
	刷新框.上拉辅助文本 = "当前 " & 行数 & " 条；本地演示，无网络请求"
结束 过程

过程 更新状态()
	状态.文本 = "下拉中=" & 刷新框.正在下拉刷新 & "；上拉中=" & 刷新框.正在上拉刷新 & "；记录=" & 行数
	次数.文本 = "开始 下/上=" & 下拉开始次数 & "/" & 上拉开始次数 & "；完成 下/上=" & 下拉完成次数 & "/" & 上拉完成次数
结束 过程

事件 刷新框.下拉刷新开始()
	下拉开始次数 = 下拉开始次数 + 1
	处理方向 = 1
	延时完成.启用 = 真
	输出.文本 = "下拉开始：约 2 秒后更新消息版本；不是实际网络请求。"
	更新状态()
结束 事件

事件 刷新框.上拉刷新开始()
	上拉开始次数 = 上拉开始次数 + 1
	处理方向 = 2
	延时完成.启用 = 真
	输出.文本 = "上拉开始：约 2 秒后追加 5 条消息。"
	更新状态()
结束 事件

''' 这里只用一次计时演示业务完成；真实网络请求应在后台执行，再回到界面线程更新。
事件 延时完成.计时()
	延时完成.启用 = 假
	如果 处理方向 = 1 则
		下拉完成次数 = 下拉完成次数 + 1
		更新内容()
		刷新框.下拉辅助文本 = "上次演示更新：第 " & 下拉完成次数 & " 次"
		输出.文本 = "更新完成；消息版本=" & 下拉完成次数 & "，记录数保持 " & 行数 & "。"
	否则如果 处理方向 = 2 则
		上拉完成次数 = 上拉完成次数 + 1
		行数 = 行数 + 5
		更新内容()
		刷新框.滚动到底部()
		输出.文本 = "追加完成：新增 5 条，共 " & 行数 & " 条。"
	结束 如果
	处理方向 = 0
	刷新框.停止刷新()
	更新状态()
结束 事件

''' 停止刷新只收回组件提示；示例还显式停掉自己的业务计时，防止稍后继续修改内容。
过程 取消演示()
	延时完成.启用 = 假
	处理方向 = 0
	刷新框.停止刷新()
	更新状态()
结束 过程

事件 手动停止.被单击()
	取消演示()
	输出.文本 = "已停止提示，也取消了示例自己的待执行计时；空闲时可重复操作。"
结束 事件

事件 下拉开关.状态改变()
	如果 已就绪 则
		刷新框.允许下拉 = 下拉开关.选中
		如果 取反 下拉开关.选中 且 处理方向 = 1 则 取消演示()
		更新状态()
	结束 如果
结束 事件

事件 上拉开关.状态改变()
	如果 已就绪 则
		刷新框.允许上拉 = 上拉开关.选中
		如果 取反 上拉开关.选中 且 处理方向 = 2 则 取消演示()
		更新状态()
	结束 如果
结束 事件

事件 回到顶部.被单击()
	刷新框.滚动到顶部()
结束 事件

事件 回到底部.被单击()
	刷新框.滚动到底部()
结束 事件

事件 刷新框.被滚动(距离 为 整数型, 到边缘 为 逻辑型)
	滚动状态.文本 = "滚动位置=" & 距离 & "px；位于边缘=" & 到边缘
结束 事件

事件 切换文案.被单击()
	自定义文案 = 取反 自定义文案
	应用文案()
	输出.文本 = "自定义文案=" & 自定义文案 & "；再次拉动查看提示、释放和处理文本。"
结束 事件

过程 应用文案()
	如果 自定义文案 则
		刷新框.下拉提示文本 = "下拉更新消息"
		刷新框.下拉释放文本 = "松开更新消息"
		刷新框.下拉处理文本 = "正在整理消息..."
		刷新框.上拉提示文本 = "上拉追加消息"
		刷新框.上拉释放文本 = "松开追加消息"
		刷新框.上拉处理文本 = "正在追加消息..."
	否则
		刷新框.下拉提示文本 = "下拉刷新"
		刷新框.下拉释放文本 = "松开刷新"
		刷新框.下拉处理文本 = "正在刷新"
		刷新框.上拉提示文本 = "上拉加载更多"
		刷新框.上拉释放文本 = "松开加载"
		刷新框.上拉处理文本 = "正在加载"
	结束 如果
	刷新框.下拉辅助文本 = "本地演示，无网络请求"
	刷新框.上拉辅助文本 = "当前 " & 行数 & " 条；本地演示，无网络请求"
结束 过程

事件 恢复初始.被单击()
	取消演示()
	行数 = 30
	下拉开始次数 = 0
	上拉开始次数 = 0
	下拉完成次数 = 0
	上拉完成次数 = 0
	自定义文案 = 假
	下拉开关.选中 = 真
	上拉开关.选中 = 真
	刷新框.允许下拉 = 真
	刷新框.允许上拉 = 真
	更新内容()
	应用文案()
	刷新框.滚动到顶部()
	更新状态()
	输出.文本 = "已恢复 30 条消息与默认提示；顶部下拉，底部上拉。"
结束 事件

事件 主窗口.程序被销毁()
	延时完成.启用 = 假
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		取消演示()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "拉动刷新使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "下拉更新，上拉追加"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "拉动达到阈值并松手才开始。计时器仅演示 2 秒处理，消息保存在内存中，不联网。"
		$结束 $定义
		$定义 方向开关 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 下拉开关 $为 复选框
				文本 = "允许下拉"
				选中 = 真
				宽度 = 0
				权重 = 1
				高度 = "44dp"
			$结束 $定义
			$定义 上拉开关 $为 复选框
				文本 = "允许上拉"
				选中 = 真
				宽度 = 0
				权重 = 1
				高度 = "44dp"
			$结束 $定义
		$结束 $定义
		$定义 定位区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 回到顶部 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "滚动到顶部"
			$结束 $定义
			$定义 回到底部 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "滚动到底部"
			$结束 $定义
			$定义 切换文案 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "切换提示文案"
			$结束 $定义
		$结束 $定义
		$定义 控制区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 手动停止 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "手动停止处理"
			$结束 $定义
			$定义 恢复初始 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "恢复初始数据"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 次数 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = ""
		$结束 $定义
		$定义 滚动状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "滚动位置=0px；位于边缘=真"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "顶部向下拉动更新消息版本；底部向上拉动追加 5 条。"
		$结束 $定义
		$定义 刷新框 $为 simple.library.wsd.pullrefresh.拉动刷新框
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			左填充 = "12dp"
			右填充 = "12dp"
			$定义 内容 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 16
				文本 = ""
				顶填充 = "8dp"
				底填充 = "12dp"
			$结束 $定义
		$结束 $定义
		$定义 延时完成 $为 计时器
			间隔 = 2000
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
