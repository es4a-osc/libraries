''' Lua 5.1 的函数、多返回值和表：https://www.lua.org/manual/5.1/
''' 每次演示在一个后台任务中创建独立实例，逐项释放结果后关闭；不共享 Lua 引用。
别名 Lua实例 = simple.library.wsd.lua.Lua实例
别名 Lua值 = simple.library.wsd.lua.Lua值
别名 Lua函数 = simple.library.wsd.lua.Lua函数
别名 Lua表 = simple.library.wsd.lua.Lua表

变量 忙碌 为 逻辑型
变量 操作编号 为 整数型
变量 工作代码 为 文本型
变量 参数一 为 文本型
变量 参数二 为 文本型
变量 预设编号 为 整数型

事件 运行代码.被单击()
	开始处理(1)
结束 事件
事件 文件运行.被单击()
	开始处理(2)
结束 事件
事件 直接函数.被单击()
	开始处理(3)
结束 事件
事件 引用函数.被单击()
	开始处理(4)
结束 事件
事件 表操作.被单击()
	开始处理(5)
结束 事件
事件 宿主回调.被单击()
	开始处理(6)
结束 事件

事件 切换代码.被单击()
	预设编号 = 预设编号 + 1
	判断 预设编号
		分支 1
			代码.文本 = "return nil, '中间值', nil"
		分支 2
			代码.文本 = "error('主动演示运行错误')"
		分支 3
			代码.文本 = "return ("
		分支 否则
			代码.文本 = "return 3 + 5, '你好，Lua', nil, true"
			预设编号 = 0
	结束 判断
	输出.文本 = "已切换代码，点运行查看结果或错误。"
结束 事件

过程 开始处理(编号 为 整数型)
	如果 忙碌 则 退出 过程
	忙碌 = 真
	操作编号 = 编号
	工作代码 = 代码.文本
	参数一 = 输入一.文本
	参数二 = 输入二.文本
	置操作状态(假)
	输出.文本 = "正在后台执行 Lua 演示..."
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			置操作状态(真)
			输出.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

过程 置操作状态(可用 为 逻辑型)
	代码.启用 = 可用
	输入一.启用 = 可用
	输入二.启用 = 可用
	运行代码.启用 = 可用
	文件运行.启用 = 可用
	直接函数.启用 = 可用
	引用函数.启用 = 可用
	表操作.启用 = 可用
	宿主回调.启用 = 可用
	切换代码.启用 = 可用
结束 过程

过程 后台处理()
	变量 引擎 为 Lua实例
	变量 返回值 为 Lua值()
	变量 准备结果 为 Lua值()
	变量 函数引用 为 Lua函数
	变量 表 为 Lua表
	变量 值 为 Lua值
	变量 参数 为 变体型(2)
	变量 文件列表 为 文本型()
	变量 路径 为 文本型
	变量 索引 为 整数型
	变量 内容 为 文本型
	引擎 = 创建 Lua实例
	判断 操作编号
		分支 1
			返回值 = 引擎.执行代码(工作代码)
			内容 = "代码执行：\n" & 描述结果(返回值)
		分支 2
			''' 执行文件要求真实文件路径；先把输入代码写到应用私有目录。
			创建目录("lua-example")
			如果 写出文本文件("lua-example/demo.lua", 工作代码) 则
				文件列表 = 取文件列表("lua-example")
				循环 索引 = 0 至 取数组成员数(文件列表) - 1
					如果 取文本右边(文件列表(索引), 8) = "demo.lua" 则 路径 = 文件列表(索引)
				下个 索引
				返回值 = 引擎.执行文件(路径)
				内容 = "文件：" & 路径 & "\n" & 描述结果(返回值)
			结束 如果
		分支 3, 4
			准备结果 = 引擎.执行代码("function calculate(a,b) return a+b, a*b, nil end")
			释放结果(准备结果)
			参数(0) = 到双精度小数(参数一)
			参数(1) = 到双精度小数(参数二)
			如果 操作编号 = 3 则
				返回值 = 引擎.调用函数("calculate", 参数)
				内容 = "直接调用 calculate(a,b)：\n"
			否则
				函数引用 = 引擎.取函数("calculate")
				返回值 = 函数引用.调用(参数)
				函数引用.释放()
				内容 = "函数引用调用 calculate(a,b)：\n"
			结束 如果
			内容 = 内容 & 描述结果(返回值)
		分支 5
			表 = 引擎.创建表()
			表.置成员("name", "小明")
			表.置成员(1, "第一项")
			表.置成员(2, "第二项")
			引擎.置全局("profile", 表)
			值 = 表.取成员("name")
			内容 = "表 name=" & 值.到文本() & "；数组长度=" & 表.取长度()
			值.释放()
			返回值 = 引擎.执行代码("return profile.name, profile[1], profile[2]")
			内容 = 内容 & "\nLua 读取宿主创建的全局表：\n" & 描述结果(返回值)
			表.移除成员("name")
			值 = 表.取成员("name")
			内容 = 内容 & "\n移除 name 后是否 nil=" & 值.是否空值()
			值.释放()
			表.释放()
		分支 6
			引擎.注册函数("host_add", 创建 宿主加法)
			参数(0) = 到双精度小数(参数一)
			参数(1) = 到双精度小数(参数二)
			返回值 = 引擎.调用函数("host_add", 参数)
			内容 = "Lua 同步调用 Simple 宿主回调：\n" & 描述结果(返回值)
			引擎.注销函数("host_add")
			值 = 引擎.取全局("host_add")
			内容 = 内容 & "\n注销后是否 nil=" & 值.是否空值()
			值.释放()
	结束 判断
	内容 = 内容 & "\n高层调用结束后的栈数量=" & 引擎.取数量()
	引擎.关闭()
	投递消息("完成", 内容 & "\n实例已关闭=" & 引擎.是否关闭())
	位于 错误
		分支 否则
			如果 引擎 <> 空 则 引擎.关闭()
			投递消息("失败", "执行失败并清理实例。请检查 Lua 语法、数值输入及设备的 ARM 32 位支持；错误原因见运行日志。")
	结束 错误
结束 过程

''' Simple 数组从 0 开始；显示位置从 1 开始，并保留中间和末尾 nil。
函数 描述结果(结果 为 Lua值()) 为 文本型
	变量 索引 为 整数型
	变量 值 为 Lua值
	变量 内容 为 文本型
	内容 = "返回 " & 取数组成员数(结果) & " 项"
	循环 索引 = 0 至 取数组成员数(结果) - 1
		值 = 结果(索引)
		内容 = 内容 & "\n" & (索引 + 1) & ": "
		判断 值.取类型()
			分支 Lua值.类型_空值
				内容 = 内容 & "nil"
			分支 Lua值.类型_数值
				内容 = 内容 & "number=" & 值.到小数()
			分支 Lua值.类型_文本
				内容 = 内容 & "string=" & 值.到文本()
			分支 Lua值.类型_逻辑
				内容 = 内容 & "boolean=" & 值.到逻辑()
			分支 否则
				内容 = 内容 & "Lua 类型代码=" & 值.取类型()
		结束 判断
	下个 索引
	释放结果(结果)
	描述结果 = 内容
结束 函数

过程 释放结果(结果 为 Lua值())
	变量 索引 为 整数型
	变量 值 为 Lua值
	循环 索引 = 0 至 取数组成员数(结果) - 1
		值 = 结果(索引)
		值.释放()
	下个 索引
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	输出.文本 = 附加参数
	忙碌 = 假
	置操作状态(真)
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 取反 忙碌 则 终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "Lua 使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "Lua 与 Simple 互相调用"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "需支持 ARM 32 位原生库。只运行可信的短脚本；每次操作使用新实例，不保留上次全局变量。"
		$结束 $定义
		$定义 代码 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "85dp"
			单行模式 = 假
			文本 = "return 3 + 5, '你好，Lua', nil, true"
		$结束 $定义
		$定义 代码区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 运行代码 $为 按钮
				宽度 = "210dp"
				文本 = "运行输入代码"
			$结束 $定义
			$定义 切换代码 $为 按钮
				宽度 = "210dp"
				文本 = "切换预设代码"
			$结束 $定义
		$结束 $定义
		$定义 参数区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 输入一 $为 编辑框
				宽度 = "210dp"
				单行模式 = 真
				提示文本 = "参数 a"
				文本 = "3"
			$结束 $定义
			$定义 输入二 $为 编辑框
				宽度 = "210dp"
				单行模式 = 真
				提示文本 = "参数 b"
				文本 = "5"
			$结束 $定义
		$结束 $定义
		$定义 函数区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 直接函数 $为 按钮
				宽度 = "210dp"
				文本 = "直接调用函数"
			$结束 $定义
			$定义 引用函数 $为 按钮
				宽度 = "210dp"
				文本 = "通过函数引用调用"
			$结束 $定义
		$结束 $定义
		$定义 交互区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 表操作 $为 按钮
				宽度 = "210dp"
				文本 = "表与全局变量"
			$结束 $定义
			$定义 宿主回调 $为 按钮
				宽度 = "210dp"
				文本 = "Lua 调用 Simple"
			$结束 $定义
		$结束 $定义
		$定义 文件区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 文件运行 $为 按钮
				宽度 = "210dp"
				文本 = "写入文件并执行"
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "默认代码返回：8、你好，Lua、nil、true；函数默认参数为 3 和 5。"
		$结束 $定义
		$定义 边界 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "脚本在后台串行执行；不提供超时中断，不是安全沙箱。Lua 数值为双精度，大整数可能丢失精度。"
		$结束 $定义
	$结束 $定义
$结束 $属性
