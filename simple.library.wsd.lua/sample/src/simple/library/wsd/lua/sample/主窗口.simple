''' 按用途进入独立页面，自检仅作为辅助验证入口。
静态 变量 窗口实例 为 窗口

事件 主窗口.初始化()
	窗口实例 = 本对象
结束 事件

事件 打开页面0.被单击()
	切换窗口(创建 代码文件窗口)
结束 事件

事件 打开页面1.被单击()
	切换窗口(创建 函数调用窗口)
结束 事件

事件 打开页面2.被单击()
	切换窗口(创建 表操作窗口)
结束 事件

事件 打开页面3.被单击()
	切换窗口(创建 宿主回调窗口)
结束 事件

事件 打开页面4.被单击()
	切换窗口(创建 堆栈生命周期窗口)
结束 事件

事件 打开页面5.被单击()
	切换窗口(创建 自检窗口)
结束 事件


$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "Lua脚本示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "Lua 5.1.5：选择一个主题，查看代码、修改输入并观察结果。原生依赖需要 32 位 ARM 支持。"
			字体大小 = 14
		$结束 $定义
		$定义 打开页面0 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "代码与文件"
		$结束 $定义
		$定义 打开页面1 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "函数调用"
		$结束 $定义
		$定义 打开页面2 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "表读写"
		$结束 $定义
		$定义 打开页面3 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "Lua 调用 Simple"
		$结束 $定义
		$定义 打开页面4 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "堆栈与生命周期"
		$结束 $定义
		$定义 打开页面5 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "辅助：接口自检"
		$结束 $定义
	$结束 $定义
$结束 $属性
