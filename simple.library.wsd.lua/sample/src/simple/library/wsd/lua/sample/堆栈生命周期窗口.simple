别名 Lua实例 = simple.library.wsd.lua.Lua实例
别名 Lua堆栈 = simple.library.wsd.lua.Lua堆栈
别名 Lua值 = simple.library.wsd.lua.Lua值
别名 Lua表 = simple.library.wsd.lua.Lua表
别名 Lua函数 = simple.library.wsd.lua.Lua函数

变量 引擎 为 Lua实例
变量 保留引用 为 Lua值

''' 明确创建或重建状态，不在关闭后的操作中偷偷创建新实例。
事件 重建实例.被单击()
	清理实例()
	引擎 = 创建 Lua实例
	保留引用 = 空
	显示堆栈()

	位于 错误
		分支 否则
			结果.文本 = "创建失败，请检查 32 位 ARM 原生库支持。"
	结束 错误
结束 事件

事件 压入数值.被单击()
	如果 实例可用() 则
		引擎.压入小数(到双精度小数(输入数值.文本))
		显示堆栈()
	结束 如果

	位于 错误
		分支 否则
			结果.文本 = "压栈失败，请输入有效数值。"
	结束 错误
结束 事件

事件 弹出数值.被单击()
	如果 实例可用() 则
		如果 引擎.取数量() > 0 则
			引擎.弹出()
		结束 如果
		显示堆栈()
	结束 如果
结束 事件

''' 高层执行代码不改变原栈，返回项中的 nil 仍占一个位置。
事件 验证栈平衡.被单击()
	变量 返回值 为 Lua值()
	变量 原数量 为 整数型
	如果 实例可用() 则
		原数量 = 引擎.取数量()
		返回值 = 引擎.执行代码("return 10, nil")
		结果.文本 = "执行前栈数量：" & 到文本(原数量) & "；执行后：" & 到文本(引擎.取数量()) & "\n" & 示例工具.结果说明(返回值)
		示例工具.释放结果(返回值)
	结束 如果
结束 事件

''' Lua值 是独立引用，弹出栈值不会使引用失效，关闭实例则会失效。
事件 保留栈顶.被单击()
	如果 实例可用() 则
		如果 引擎.取数量() = 0 则
			结果.文本 = "栈为空，请先压入一个数值。"
		否则
			如果 取反 (保留引用 是 空) 则
				保留引用.释放()
			结束 如果
			保留引用 = 引擎.取值(-1)
			结果.文本 = "已保留栈顶引用，可弹出栈顶后再检查引用。"
		结束 如果
	结束 如果
结束 事件

事件 检查引用.被单击()
	如果 保留引用 是 空 则
		结果.文本 = "尚未保留引用。"
	否则如果 保留引用.是否有效() 则
		结果.文本 = "引用仍有效：" & 示例工具.值说明(保留引用)
	否则
		结果.文本 = "引用已失效，不能再取值；可安全释放。"
	结束 如果
结束 事件

事件 关闭解释器.被单击()
	清理实例()
	结果.文本 = "实例已关闭，所有引用失效。可检查引用，再重建实例。"
结束 事件

函数 实例可用() 为 逻辑型
	实例可用 = 取反 (引擎 是 空)
	如果 取反 实例可用 则
		结果.文本 = "请先创建／重建实例。"
	结束 如果
结束 函数

过程 显示堆栈()
	变量 索引 为 整数型
	变量 内容 为 文本型
	内容 = "栈数量：" & 到文本(引擎.取数量())
	循环 索引 = 1 至 引擎.取数量()
		内容 = 内容 & "\n[" & 到文本(索引) & "] " & 到文本(引擎.取小数(索引))
	下个
	结果.文本 = 内容
结束 过程

事件 返回目录.被单击()
	返回示例目录()
结束 事件

事件 堆栈生命周期窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回示例目录()
	结束 如果
结束 事件

过程 返回示例目录()
	清理实例()
	切换窗口(主窗口.窗口实例)
结束 过程

事件 堆栈生命周期窗口.程序被销毁()
	清理实例()
结束 事件

''' 离开页面或应用退出时释放解释器，随后所有 Lua 引用均失效。
过程 清理实例()
	如果 取反 (引擎 是 空) 则
		引擎.关闭()
		引擎 = 空
	结束 如果
结束 过程

''' 普通演示按需创建解释器，错误后仍可重新操作。
过程 确保实例()
	如果 引擎 是 空 则
		引擎 = 创建 Lua实例
	结束 如果
结束 过程


$属性
	$资源 $窗口
	$定义 堆栈生命周期窗口 $为 窗口
		标题 = "Lua · 堆栈与生命周期"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 返回目录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "先创建实例。正索引从 1 开始，-1 表示栈顶。保留引用后弹栈不会失效，关闭实例才会失效。"
			字体大小 = 14
		$结束 $定义
		$定义 重建实例 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "创建／重建实例"
		$结束 $定义
		$定义 输入数值 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "42"
			单行模式 = 真
		$结束 $定义
		$定义 压入数值 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "压入数值"
		$结束 $定义
		$定义 弹出数值 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "弹出栈顶"
		$结束 $定义
		$定义 验证栈平衡 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "高层调用与栈平衡"
		$结束 $定义
		$定义 保留栈顶 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "保留栈顶引用"
		$结束 $定义
		$定义 检查引用 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "检查保留引用"
		$结束 $定义
		$定义 关闭解释器 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "关闭实例"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "等待创建实例。"
		$结束 $定义
	$结束 $定义
$结束 $属性
