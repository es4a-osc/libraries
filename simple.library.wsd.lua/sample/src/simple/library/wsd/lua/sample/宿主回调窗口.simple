别名 Lua实例 = simple.library.wsd.lua.Lua实例
别名 Lua堆栈 = simple.library.wsd.lua.Lua堆栈
别名 Lua值 = simple.library.wsd.lua.Lua值
别名 Lua表 = simple.library.wsd.lua.Lua表
别名 Lua函数 = simple.library.wsd.lua.Lua函数

变量 引擎 为 Lua实例

''' Simple 注册业务回调，Lua 脚本再像调用普通函数一样调用它。
事件 执行回调.被单击()
	变量 回调 为 宿主加法
	变量 返回值 为 Lua值()
	确保实例()

	' 用全局变量传入页面数据，避免把输入拼接为 Lua 源码。
	引擎.置全局("first", 到双精度小数(输入一.文本))
	引擎.置全局("second", 到双精度小数(输入二.文本))
	回调 = 创建 宿主加法
	引擎.注册函数("hostAdd", 回调)
	返回值 = 引擎.执行代码(回调代码.文本)
	结果.文本 = 示例工具.结果说明(返回值)
	示例工具.释放结果(返回值)

	位于 错误
		分支 否则
			清理实例()
			结果.文本 = "回调失败，请检查数值输入与 hostAdd 的调用参数；修改后可重试。"
	结束 错误
结束 事件

事件 注销回调.被单击()
	变量 读值 为 Lua值
	确保实例()
	引擎.注销函数("hostAdd")
	读值 = 引擎.取全局("hostAdd")
	结果.文本 = "注销后 hostAdd = " & 示例工具.值说明(读值)
	读值.释放()

	位于 错误
		分支 否则
			清理实例()
			结果.文本 = "注销失败，可重新注册后重试。"
	结束 错误
结束 事件

事件 返回目录.被单击()
	返回示例目录()
结束 事件

事件 宿主回调窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回示例目录()
	结束 如果
结束 事件

过程 返回示例目录()
	清理实例()
	切换窗口(主窗口.窗口实例)
结束 过程

事件 宿主回调窗口.程序被销毁()
	清理实例()
结束 事件

''' 离开页面或应用退出时释放解释器，随后所有 Lua 引用均失效。
过程 清理实例()
	如果 取反 (引擎 是 空) 则
		引擎.关闭()
		引擎 = 空
	结束 如果
结束 过程

''' 普通演示按需创建解释器，错误后仍可重新操作。
过程 确保实例()
	如果 引擎 是 空 则
		引擎 = 创建 Lua实例
	结束 如果
结束 过程


$属性
	$资源 $窗口
	$定义 宿主回调窗口 $为 窗口
		标题 = "Lua · 调用 Simple"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 返回目录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "宿主加法继承 Lua回调，在处理调用中读取参数、压入结果并返回结果数量。回调不要保存堆栈或关闭实例。"
			字体大小 = 14
		$结束 $定义
		$定义 输入一 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "3"
			单行模式 = 真
		$结束 $定义
		$定义 输入二 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "5"
			单行模式 = 真
		$结束 $定义
		$定义 回调代码 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "local sum, message = hostAdd(first, second)\nreturn sum, message"
			单行模式 = 假
			高度 = 110
		$结束 $定义
		$定义 执行回调 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "注册并执行回调"
		$结束 $定义
		$定义 注销回调 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "注销 hostAdd"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "默认返回 8 和“来自 Simple 的加法”。"
		$结束 $定义
	$结束 $定义
$结束 $属性
