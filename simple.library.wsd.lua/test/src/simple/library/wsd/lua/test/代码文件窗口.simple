别名 Lua实例 = simple.library.wsd.lua.Lua实例
别名 Lua堆栈 = simple.library.wsd.lua.Lua堆栈
别名 Lua值 = simple.library.wsd.lua.Lua值
别名 Lua表 = simple.library.wsd.lua.Lua表
别名 Lua函数 = simple.library.wsd.lua.Lua函数

变量 引擎 为 Lua实例

''' 执行编辑框中的顶层代码，完整显示多返回值及 nil。
事件 执行代码.被单击()
	变量 返回值 为 Lua值()
	确保实例()
	返回值 = 引擎.执行代码(脚本代码.文本)
	结果.文本 = 测试工具.结果说明(返回值)
	测试工具.释放结果(返回值)

	位于 错误
		分支 否则
			清理实例()
			结果.文本 = "代码执行失败，请检查 Lua 5.1 语法；修改后可重试。"
	结束 错误
结束 事件

''' 先写入应用私有文件，再取得其绝对路径交给 Lua 执行。
事件 执行文件.被单击()
	变量 返回值 为 Lua值()
	变量 文件列表 为 文本型()
	变量 文件路径 为 文本型
	变量 索引 为 整数型
	确保实例()

	' 文件操作的相对路径基于应用 files 目录，不需要存储权限。
	断言真(写出文本文件("lua-test.lua", 脚本代码.文本, "UTF-8"))
	文件列表 = 取文件列表(".")
	循环 索引 = 0 至 取数组成员数(文件列表) - 1
		如果 取文本右边(文件列表(索引), 14) = "lua-test.lua" 则
			文件路径 = 文件列表(索引)
		结束 如果
	下个
	断言真(文件路径 <> "")

	' Lua 执行文件接收真实文件路径，不能直接填写 APK 内的资产名称。
	返回值 = 引擎.执行文件(文件路径)
	结果.文本 = 文件路径 & "\n" & 测试工具.结果说明(返回值)
	测试工具.释放结果(返回值)

	位于 错误
		分支 否则
			清理实例()
			结果.文本 = "文件执行失败，请检查代码或应用私有文件的读写结果。"
	结束 错误
结束 事件

事件 返回目录.被单击()
	返回测试目录()
结束 事件

事件 代码文件窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回测试目录()
	结束 如果
结束 事件

过程 返回测试目录()
	清理实例()
	切换窗口(主窗口.窗口实例)
结束 过程

事件 代码文件窗口.程序被销毁()
	清理实例()
结束 事件

''' 离开页面或应用退出时释放解释器，随后所有 Lua 引用均失效。
过程 清理实例()
	如果 取反 (引擎 是 空) 则
		引擎.关闭()
		引擎 = 空
	结束 如果
结束 过程

''' 交互测试按需创建解释器，错误后仍可重新操作。
过程 确保实例()
	如果 引擎 是 空 则
		引擎 = 创建 Lua实例
	结束 如果
结束 过程


$属性
	$资源 $窗口
	$定义 代码文件窗口 $为 窗口
		标题 = "Lua · 代码与文件"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 返回目录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "修改下面的 Lua 代码。文件执行会把当前代码写入应用私有的 lua-test.lua，再执行该文件。"
			字体大小 = 14
		$结束 $定义
		$定义 脚本代码 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "return '你好，Lua', 42, true, nil"
			单行模式 = 假
			高度 = 120
		$结束 $定义
		$定义 执行代码 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "执行代码"
		$结束 $定义
		$定义 执行文件 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "写入并执行文件"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "默认返回 4 项，最后一项为 nil。"
		$结束 $定义
	$结束 $定义
$结束 $属性
