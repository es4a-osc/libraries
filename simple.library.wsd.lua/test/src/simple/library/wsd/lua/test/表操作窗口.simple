别名 Lua实例 = simple.library.wsd.lua.Lua实例
别名 Lua堆栈 = simple.library.wsd.lua.Lua堆栈
别名 Lua值 = simple.library.wsd.lua.Lua值
别名 Lua表 = simple.library.wsd.lua.Lua表
别名 Lua函数 = simple.library.wsd.lua.Lua函数

变量 引擎 为 Lua实例
变量 数据表 为 Lua表

事件 创建测试表.被单击()
	建立测试表()

	位于 错误
		分支 否则
			处理表错误()
	结束 错误
结束 事件

''' 在同一个解释器中创建表，数值键与文本键彼此独立。
过程 建立测试表()
	变量 内表 为 Lua表
	清理实例()
	确保实例()
	数据表 = 引擎.创建表()
	数据表.置成员("name", "小明")
	数据表.置成员(1, "第一项")
	数据表.置成员(2, "第二项")

	' 置成员保存 Lua 值，不复制成文本；释放内表引用不会删除表内容。
	内表 = 引擎.创建表()
	内表.置成员("city", "广州")
	数据表.置成员("address", 内表)
	内表.释放()
	显示表内容()
结束 过程

事件 读取成员.被单击()
	变量 读值 为 Lua值
	如果 数据表 是 空 则
		建立测试表()
	结束 如果
	读值 = 数据表.取成员(成员名.文本)
	结果.文本 = 测试工具.值说明(读值)
	读值.释放()

	位于 错误
		分支 否则
			处理表错误()
	结束 错误
结束 事件

事件 写入成员.被单击()
	如果 数据表 是 空 则
		建立测试表()
	结束 如果
	数据表.置成员(成员名.文本, 成员内容.文本)
	显示表内容()

	位于 错误
		分支 否则
			处理表错误()
	结束 错误
结束 事件

事件 删除成员.被单击()
	如果 数据表 是 空 则
		建立测试表()
	结束 如果
	数据表.移除成员(成员名.文本)
	显示表内容()

	位于 错误
		分支 否则
			处理表错误()
	结束 错误
结束 事件

事件 浏览表.被单击()
	如果 数据表 是 空 则
		建立测试表()
	结束 如果
	显示表内容()

	位于 错误
		分支 否则
			处理表错误()
	结束 错误
结束 事件

''' 取键返回无序快照；逐项读取后释放键引用和成员引用。
过程 显示表内容()
	变量 键列表 为 Lua值()
	变量 键 为 Lua值
	变量 读值 为 Lua值
	变量 内表 为 Lua表
	变量 索引 为 整数型
	变量 内容 为 文本型
	键列表 = 数据表.取键()
	内容 = "键数量：" & 到文本(取数组成员数(键列表)) & "；连续数组长度：" & 到文本(数据表.取长度())
	循环 索引 = 0 至 取数组成员数(键列表) - 1
		键 = 键列表(索引)
		读值 = 数据表.取成员(键)
		内容 = 内容 & "\n" & 键.到文本() & " = " & 测试工具.值说明(读值)
		如果 读值.取类型() = Lua值.类型_表 则
			内表 = 读值.到表()
			读值.释放()
			读值 = 内表.取成员("city")
			内容 = 内容 & "；city = " & 测试工具.值说明(读值)
			内表.释放()
		结束 如果
		读值.释放()
	下个
	测试工具.释放结果(键列表)
	结果.文本 = 内容
结束 过程

过程 处理表错误()
	清理实例()
	数据表 = 空
	结果.文本 = "表操作失败；请重建测试表后重试。"
结束 过程

事件 返回目录.被单击()
	返回测试目录()
结束 事件

事件 表操作窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回测试目录()
	结束 如果
结束 事件

过程 返回测试目录()
	清理实例()
	数据表 = 空
	切换窗口(主窗口.窗口实例)
结束 过程

事件 表操作窗口.程序被销毁()
	清理实例()
结束 事件

''' 离开页面或应用退出时释放解释器，随后所有 Lua 引用均失效。
过程 清理实例()
	如果 取反 (引擎 是 空) 则
		引擎.关闭()
		引擎 = 空
	结束 如果
结束 过程

''' 交互测试按需创建解释器，错误后仍可重新操作。
过程 确保实例()
	如果 引擎 是 空 则
		引擎 = 创建 Lua实例
	结束 如果
结束 过程


$属性
	$资源 $窗口
	$定义 表操作窗口 $为 窗口
		标题 = "Lua · 表读写"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 返回目录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "先创建测试表，再按文本键读写。数值键 1、2 和嵌套 address.city 在“遍历与嵌套表”中展示；键顺序不固定。"
			字体大小 = 14
		$结束 $定义
		$定义 创建测试表 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "创建／重置测试表"
		$结束 $定义
		$定义 成员名 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "name"
			单行模式 = 真
		$结束 $定义
		$定义 成员内容 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "小红"
			单行模式 = 真
		$结束 $定义
		$定义 读取成员 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "读取文本键"
		$结束 $定义
		$定义 写入成员 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "写入文本键"
		$结束 $定义
		$定义 删除成员 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "删除文本键"
		$结束 $定义
		$定义 浏览表 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "遍历与嵌套表"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "创建后可见 4 个键，数组长度为 2。"
		$结束 $定义
	$结束 $定义
$结束 $属性
