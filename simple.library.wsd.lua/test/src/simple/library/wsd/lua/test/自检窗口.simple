别名 Lua实例 = simple.library.wsd.lua.Lua实例
别名 Lua堆栈 = simple.library.wsd.lua.Lua堆栈
别名 Lua值 = simple.library.wsd.lua.Lua值
别名 Lua表 = simple.library.wsd.lua.Lua表
别名 Lua函数 = simple.library.wsd.lua.Lua函数

变量 自检阶段 为 文本型

''' 自检与交互用例分离，故意失败的回调仅用于此页。
事件 运行自检.被单击()
	验证对象封装()
	结果.文本 = "自检通过：多返回值及 nil、栈平衡、中文和二进制、Java 对象、嵌套表、宿主回调、错误恢复及引用释放。"

	位于 错误
		分支 否则
			显示自检失败()
	结束 错误
结束 事件

事件 返回目录.被单击()
	切换窗口(主窗口.窗口实例)
结束 事件

事件 自检窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

''' 验证普通对象封装：高层操作不遗留临时栈，引用由调用者显式释放。
过程 验证对象封装()
	变量 引擎 为 Lua实例
	变量 另一个 为 Lua实例
	变量 返回值 为 Lua值()
	变量 参数 为 变体型(2)
	变量 读值 为 Lua值
	变量 表 为 Lua表
	变量 内表 为 Lua表
	变量 函数引用 为 Lua函数
	变量 键 为 Lua值()
	变量 回调 为 自检回调
	变量 数据 为 字节型(3)
	变量 读回数据 为 字节型()
	变量 次数 为 整数型

	自检阶段 = "创建 Lua 实例"
	引擎 = 创建 Lua实例
	另一个 = 创建 Lua实例
	引擎.压入文本("保留栈底")
	返回值 = 引擎.执行代码("function add(a,b) return a+b end\n" & _
		"function echo(v) return v end\n" & _
		"function fail() error('expected failure') end\n" & _
		"function noargs() return nil, 42, nil end\n" & _
		"return _VERSION, nil, 3, nil")
	断言真(取数组成员数(返回值) = 4)
	读值 = 返回值(0)
	断言真(读值.到文本() = "Lua 5.1")
	读值 = 返回值(1)
	断言真(读值.是否空值())
	读值 = 返回值(2)
	断言真(读值.到整数() = 3)
	读值 = 返回值(3)
	断言真(读值.是否空值())
	释放结果(返回值)
	断言真(引擎.取数量() = 1)

	' 无参数重载同样保留 nil、多返回值和原堆栈。
	自检阶段 = "无参数函数调用重载"
	返回值 = 引擎.调用函数("noargs")
	断言真(取数组成员数(返回值) = 3)
	读值 = 返回值(0)
	断言真(读值.是否空值())
	读值 = 返回值(1)
	断言真(读值.到整数() = 42)
	读值 = 返回值(2)
	断言真(读值.是否空值())
	释放结果(返回值)
	函数引用 = 引擎.取函数("noargs")
	返回值 = 函数引用.调用()
	断言真(取数组成员数(返回值) = 3)
	读值 = 返回值(1)
	断言真(读值.到整数() = 42)
	释放结果(返回值)
	函数引用.释放()
	断言真(引擎.取数量() = 1)

	' 高层函数直接接收参数并返回数组，不再借助全局变量。
	自检阶段 = "高层函数直接接收参数并返回数组，不再借助全局变量。"
	参数(0) = 1.25
	参数(1) = 2.5
	函数引用 = 引擎.取函数("add")
	返回值 = 函数引用.调用(参数)
	读值 = 返回值(0)
	断言真(读值.到小数() = 3.75)
	释放结果(返回值)
	函数引用.释放()
	函数引用.释放()
	断言真(取反 函数引用.是否有效())
	断言真(拒绝失效引用(函数引用))
	断言真(拒绝执行错误(引擎))
	断言真(拒绝语法错误(引擎))
	断言真(引擎.取数量() = 1)

	' 基本类型与全局变量反复读取后，原栈顶仍保持不变。
	自检阶段 = "基本类型与全局变量反复读取后，原栈顶仍保持不变。"
	自检阶段 = "设置中文全局值"
	引擎.置全局("text", "中文脚本")
	自检阶段 = "设置及读取逻辑假"
	引擎.置全局("flag", 假)
	读值 = 引擎.取全局("flag")
	断言真(取反 读值.到逻辑())
	读值.释放()
	自检阶段 = "数值零的 Lua 真值规则"
	引擎.置全局("zero", 0)
	读值 = 引擎.取全局("zero")
	断言真(读值.到逻辑())
	读值.释放()
	自检阶段 = "Java 对象桥接及读取"
	引擎.置全局("object", 到对象("Java对象"))
	读值 = 引擎.取全局("object")
	断言真(读值.到对象() 是 到对象("Java对象"))
	读值.释放()

	自检阶段 = "反复读取全局变量的栈平衡"
	循环 次数 = 1 至 50
		读值 = 引擎.取全局("text")
		断言真(读值.到文本() = "中文脚本")
		读值.释放()
	下个
	断言真(引擎.取数量() = 1)

	' 二进制字符串不经过文本编码，零字节和 255 都必须往返一致。
	自检阶段 = "二进制字符串不经过文本编码，零字节和 255 都必须往返一致。"
	数据(0) = 0
	数据(1) = 127
	数据(2) = -1
	引擎.置全局("binary", 数据)
	读值 = 引擎.取全局("binary")
	读回数据 = 读值.到字节集()
	断言真(取数组成员数(读回数据) = 3)
	断言真(读回数据(0) = 0)
	断言真(读回数据(1) = 127)
	断言真(读回数据(2) = -1)
	读值.释放()

	' 表引用在清理栈后仍有效，支持文本键、数值键、嵌套表及键快照。
	自检阶段 = "表引用在清理栈后仍有效，支持文本键、数值键、嵌套表及键快照。"
	表 = 引擎.创建表()
	内表 = 引擎.创建表()
	内表.置成员("value", 42)
	表.置成员("child", 内表)
	内表.释放()
	表.置成员("title", "嵌套表")
	表.置成员(1, 11)
	表.置成员(2, 22)
	断言真(表.取长度() = 2)
	读值 = 表.取成员("child")
	内表 = 读值.到表()
	读值.释放()
	读值 = 内表.取成员("value")
	断言真(读值.到整数() = 42)
	读值.释放()
	内表.释放()
	键 = 表.取键()
	断言真(取数组成员数(键) = 4)
	释放结果(键)
	表.移除成员("title")
	读值 = 表.取成员("title")
	断言真(读值.是否空值())
	读值.释放()
	断言真(拒绝空表键(表))
	断言真(拒绝跨实例值(另一个, 表))
	表.释放()
	断言真(引擎.取数量() = 1)

	' 注册真正的 Lua 函数，回调只看到业务参数，回调结束后视图失效。
	自检阶段 = "注册真正的 Lua 函数，回调只看到业务参数，回调结束后视图失效。"
	回调 = 创建 自检回调
	回调.宿主实例 = 引擎
	引擎.注册函数("hostAdd", 回调)
	参数(0) = 3
	参数(1) = 5
	返回值 = 引擎.调用函数("hostAdd", 参数)
	断言真(取数组成员数(返回值) = 2)
	读值 = 返回值(0)
	断言真(读值.到整数() = 8)
	读值 = 返回值(1)
	断言真(读值.到文本() = "宿主回调")
	释放结果(返回值)
	断言真(拒绝过期堆栈(回调.保留堆栈))

	回调.模式 = 1
	断言真(拒绝回调错误(引擎, 参数))
	回调.模式 = 2
	断言真(拒绝回调错误(引擎, 参数))
	回调.模式 = 3
	断言真(拒绝回调错误(引擎, 参数))
	断言真(取反 引擎.是否关闭())
	回调.模式 = 0
	返回值 = 引擎.调用函数("hostAdd", 参数)
	读值 = 返回值(0)
	断言真(读值.到整数() = 8)
	释放结果(返回值)
	引擎.注销函数("hostAdd")
	读值 = 引擎.取全局("hostAdd")
	断言真(读值.是否空值())
	读值.释放()

	' 底层栈操作仍可独立使用，非法索引不能进入 JNI。
	自检阶段 = "底层栈操作仍可独立使用，非法索引不能进入 JNI。"
	引擎.置数量(0)
	引擎.压入整数(1)
	引擎.压入整数(2)
	引擎.复制(1)
	断言真(引擎.取整数(-1) = 1)
	引擎.移除(2)
	引擎.压入整数(3)
	引擎.插入(1)
	断言真(引擎.取整数(1) = 3)
	引擎.压入整数(4)
	引擎.替换(1)
	断言真(引擎.取整数(1) = 4)
	断言真(拒绝非法索引(引擎))
	引擎.置数量(0)
	读值 = 引擎.取全局("add")
	引擎.压入值(读值)
	读值.释放()
	引擎.压入整数(3)
	引擎.压入整数(5)
	引擎.调用(2, 1)
	断言真(引擎.取整数(-1) = 8)
	引擎.弹出(1)
	断言真(引擎.取数量() = 0)

	' 低层调用省略结果数量时保留全部结果，弹出重载一次移除一个值。
	引擎.置数量(0)
	函数引用 = 引擎.取函数("noargs")
	引擎.压入值(函数引用)
	引擎.调用(0)
	断言真(引擎.取数量() = 3)
	断言真(引擎.取整数(-2) = 42)
	引擎.弹出()
	断言真(引擎.取数量() = 2)
	引擎.弹出(2)
	函数引用.释放()

	' 实例关闭使所有引用失效；重复关闭和随后释放都安全。
	自检阶段 = "实例关闭使所有引用失效；重复关闭和随后释放都安全。"
	读值 = 引擎.取全局("text")
	引擎.关闭()
	引擎.关闭()
	断言真(引擎.是否关闭())
	断言真(取反 读值.是否有效())
	断言真(拒绝失效引用(读值))
	读值.释放()
	另一个.关闭()

	位于 错误
		分支 否则
			引擎.关闭()
			另一个.关闭()
			断言真(假)
	结束 错误
结束 过程

''' 结果中的每个 Lua值 都持有引用，包括 nil，需要逐项释放。
过程 释放结果(值列表 为 Lua值())
	变量 索引 为 整数型
	变量 当前值 为 Lua值
	循环 索引 = 0 至 取数组成员数(值列表) - 1
		当前值 = 值列表(索引)
		当前值.释放()
	下个
结束 过程

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝失效引用(值 为 Lua值) 为 逻辑型
	变量 忽略 为 文本型
	忽略 = 值.到文本()
	拒绝失效引用 = 假

	位于 错误
		分支 否则
			拒绝失效引用 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝执行错误(引擎 为 Lua实例) 为 逻辑型
	变量 忽略 为 Lua值()
	忽略 = 引擎.调用函数("fail", 空)
	拒绝执行错误 = 假

	位于 错误
		分支 否则
			拒绝执行错误 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝语法错误(引擎 为 Lua实例) 为 逻辑型
	变量 忽略 为 Lua值()
	忽略 = 引擎.执行代码("function broken(")
	拒绝语法错误 = 假

	位于 错误
		分支 否则
			拒绝语法错误 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝空表键(表 为 Lua表) 为 逻辑型
	表.置成员(空, 1)
	拒绝空表键 = 假

	位于 错误
		分支 否则
			拒绝空表键 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝跨实例值(引擎 为 Lua实例, 值 为 Lua值) 为 逻辑型
	引擎.置全局("foreign", 值)
	拒绝跨实例值 = 假

	位于 错误
		分支 否则
			拒绝跨实例值 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝过期堆栈(堆栈 为 Lua堆栈) 为 逻辑型
	变量 忽略 为 整数型
	忽略 = 堆栈.取数量()
	拒绝过期堆栈 = 假

	位于 错误
		分支 否则
			拒绝过期堆栈 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝回调错误(引擎 为 Lua实例, 参数 为 变体型()) 为 逻辑型
	变量 忽略 为 Lua值()
	忽略 = 引擎.调用函数("hostAdd", 参数)
	拒绝回调错误 = 假

	位于 错误
		分支 否则
			拒绝回调错误 = 真
	结束 错误
结束 函数

''' 无效操作应进入 Simple 错误分支，不能导致原生进程退出。
函数 拒绝非法索引(堆栈 为 Lua堆栈) 为 逻辑型
	变量 忽略 为 整数型
	忽略 = 堆栈.取整数(0)
	拒绝非法索引 = 假

	位于 错误
		分支 否则
			拒绝非法索引 = 真
	结束 错误
结束 函数

' 自检失败说明单独输出，错误分支只负责转交处理。
过程 显示自检失败()
	结果.文本 = "自检失败：" & 自检阶段
结束 过程


$属性
	$资源 $窗口
	$定义 自检窗口 $为 窗口
		标题 = "Lua · 接口自检"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 返回目录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "辅助验证接口边界，包含故意触发的错误。回调交互验证见“Lua 调用 Simple”。"
			字体大小 = 14
		$结束 $定义
		$定义 运行自检 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "运行全部接口自检"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "等待运行自检。"
		$结束 $定义
	$结束 $定义
$结束 $属性
