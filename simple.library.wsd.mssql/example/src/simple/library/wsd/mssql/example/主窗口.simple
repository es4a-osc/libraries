''' 本库异步 JDBC 接口示例；仅使用专用数据库中的 es4a_library_example 表。
''' 先在服务器执行 example/setup.sql 初始化独立库表，再校验演示标记；增改删只按本次 ID。
''' 本库写入以影响行数大于0返回真；DDL和影响0行返回假，不能据此推断发生SQL错误。
''' 不保存账号密码。同步查询放在后台线程；不修改服务器配置；脚本使用 SQL Server 2005+ 的 nvarchar(max)。
变量 忙 为 逻辑型
变量 已连接 为 逻辑型
变量 表可用 为 逻辑型
变量 当前操作 为 文本型
变量 本次ID 为 文本型
变量 回调次数 为 整数型

事件 主窗口.初始化()
	本次ID = 读取设置("mssql.example.id")
	如果 本次ID = "" 则 本次ID = 生成GUID()
	身份.文本 = "本次演示记录 ID：" & 本次ID
	更新操作()
结束 事件

事件 新记录.被单击()
	如果 忙 则 退出 事件
	本次ID = 生成GUID()
	保存设置("mssql.example.id", 本次ID)
	身份.文本 = "本次演示记录 ID：" & 本次ID
	状态.文本 = "已换新记录 ID；旧记录保留，不会自动删除。"
结束 事件

事件 连接按钮.被单击()
	如果 忙 则 退出 事件
	如果 地址.文本 = "" 或 库名.文本 = "" 或 用户名.文本 = "" 则
		状态.文本 = "请填写专用 SQL Server 的主机:端口、库名和账号。手机或模拟器的 localhost 指向自身。"
		退出 事件
	结束 如果
	变量 检查库名 为 文本型
	检查库名 = 库名.文本
	删首尾空(检查库名)
	到小写(检查库名)
	如果 检查库名 = "master" 或 检查库名 = "tempdb" 或 检查库名 = "model" 或 检查库名 = "msdb" 则
		状态.文本 = "请连接独立演示数据库，不使用 SQL Server 系统库。"
		退出 事件
	结束 如果
	已连接 = 假
	表可用 = 假
	开始操作("连接")
	数据库.连接数据库(地址.文本, 用户名.文本, 口令.文本, 库名.文本)
结束 事件

事件 断开按钮.被单击()
	如果 忙 则 退出 事件
	开始操作("断开")
	变量 参数 为 变体型(1)
	参数(0) = 1
	启动线程(本对象, "后台断开", 参数)
	位于 错误
		分支 否则
			完成操作("无法启动后台断开。")
	结束 错误
结束 事件

过程 后台断开(占位 为 变体型)
	如果 数据库.断开连接() 则
		投递消息("断开真", "")
	否则
		投递消息("断开假", "")
	结束 如果
结束 过程

事件 只读按钮.被单击()
	如果 忙 或 已连接 = 假 则 退出 事件
	开始操作("只读")
	数据库.查询语句("SELECT 1 AS value, DB_NAME() AS db, N'中文 😀' AS text")
结束 事件

事件 同步按钮.被单击()
	如果 忙 或 已连接 = 假 则 退出 事件
	开始操作("同步只读")
	变量 参数 为 变体型(1)
	参数(0) = 1
	启动线程(本对象, "后台读取", 参数)
	位于 错误
		分支 否则
			完成操作("无法启动后台只读查询。")
	结束 错误
结束 事件

过程 后台读取(占位 为 变体型)
	变量 结果 为 集合
	结果 = 数据库.查询语句_同步("SELECT 1 AS value, DB_NAME() AS db")
	投递消息("同步只读", 格式化结果(结果))
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	如果 消息标记 = "断开真" 则
		已连接 = 假
		表可用 = 假
		完成操作("后台断开返回：真")
	否则如果 消息标记 = "断开假" 则
		完成操作("后台断开返回：假")
	否则
		预览.文本 = 附加参数
		完成操作("同步只读已在后台返回，结果见下方。")
	结束 如果
结束 事件

事件 校验按钮.被单击()
	如果 忙 或 已连接 = 假 则 退出 事件
	表可用 = 假
	开始操作("校验表")
	数据库.查询语句("SELECT CAST(value AS nvarchar(128)) AS marker FROM sys.extended_properties WHERE major_id=OBJECT_ID(N'dbo.es4a_library_example') AND minor_id=0 AND name=N'ES4A_Example'")
结束 事件

''' 本库接受 SQL 片段，不提供参数绑定。将用户文本变为 UTF-16LE 十六进制字面量，
''' 避免引号、反斜杠及 SQL 模式改变文本含义；SQL NULL 用单独开关表达。
函数 SQL文本(内容 为 文本型) 为 文本型
	如果 内容 = "" 则
		SQL文本 = "N''"
	否则
		SQL文本 = "CONVERT(nvarchar(max),0x" & 字节集到十六进制(文本到字节(内容, "UTF-16LE")) & ")"
	结束 如果
结束 函数

函数 备注值() 为 文本型
	如果 空值.选中 则
		备注值 = "NULL"
	否则
		备注值 = SQL文本(备注.文本)
	结束 如果
结束 函数

函数 可写入() 为 逻辑型
	可写入 = 忙 = 假 且 已连接 且 表可用
	如果 可写入 则
		如果 取字符数(姓名.文本) > 64 或 取字符数(电话.文本) > 32 或 取文本字节数(备注.文本) > 4096 则
			可写入 = 假
			状态.文本 = "示例输入限制：姓名64个代码单元、电话32个代码单元、备注4096字节以内。"
		结束 如果
	结束 如果
结束 函数

事件 添加按钮.被单击()
	如果 可写入() = 假 则 退出 事件
	保存设置("mssql.example.id", 本次ID)
	开始操作("添加")
	数据库.添加记录("dbo.es4a_library_example", "id,name,phone,note", SQL文本(本次ID) & "," & SQL文本(姓名.文本) & "," & SQL文本(电话.文本) & "," & 备注值())
结束 事件

事件 修改按钮.被单击()
	如果 可写入() = 假 则 退出 事件
	开始操作("修改")
	数据库.修改记录("dbo.es4a_library_example", "name=" & SQL文本(姓名.文本) & ",phone=" & SQL文本(电话.文本) & ",note=" & 备注值(), "id=" & SQL文本(本次ID))
结束 事件

事件 删除按钮.被单击()
	如果 忙 或 已连接 = 假 或 表可用 = 假 则 退出 事件
	开始操作("删除")
	数据库.删除记录("dbo.es4a_library_example", "id=" & SQL文本(本次ID))
结束 事件

事件 查询按钮.被单击()
	如果 忙 或 已连接 = 假 或 表可用 = 假 则 退出 事件
	开始操作("查询记录")
	数据库.查询记录("dbo.es4a_library_example", "id,name,phone,note", "id=" & SQL文本(本次ID))
结束 事件

事件 核对按钮.被单击()
	如果 忙 或 已连接 = 假 或 表可用 = 假 则 退出 事件
	开始操作("核对NULL")
	' 返回数组会把 NULL 与空文本都表示为空文本，因此另查服务器表达式来区分。
	数据库.查询语句("SELECT name,phone,note,CASE WHEN note IS NULL THEN 'SQL NULL' ELSE 'TEXT' END AS note_kind,CONVERT(varchar(max),CONVERT(varbinary(max),name),2) AS name_utf16le FROM dbo.es4a_library_example WHERE id=" & SQL文本(本次ID))
结束 事件

过程 开始操作(名称 为 文本型)
	忙 = 真
	当前操作 = 名称
	状态.文本 = "异步操作中：" & 名称 & "；等待实际完成事件。"
	更新操作()
结束 过程

过程 完成操作(说明 为 文本型)
	忙 = 假
	回调次数 = 回调次数 + 1
	状态.文本 = 说明
	统计.文本 = "完成通知 " & 回调次数 & "；示例表已确认=" & 表可用
	更新操作()
结束 过程

过程 更新操作()
	地址.启用 = 忙 = 假 且 已连接 = 假
	库名.启用 = 地址.启用
	用户名.启用 = 地址.启用
	口令.启用 = 地址.启用
	连接按钮.启用 = 忙 = 假 且 已连接 = 假
	断开按钮.启用 = 忙 = 假 且 已连接
	只读按钮.启用 = 断开按钮.启用
	同步按钮.启用 = 断开按钮.启用
	校验按钮.启用 = 断开按钮.启用
	添加按钮.启用 = 断开按钮.启用 且 表可用
	修改按钮.启用 = 添加按钮.启用
	删除按钮.启用 = 添加按钮.启用
	查询按钮.启用 = 添加按钮.启用
	核对按钮.启用 = 添加按钮.启用
	新记录.启用 = 忙 = 假
结束 过程

事件 数据库.连接数据库完毕(成功 为 逻辑型)
	已连接 = 成功
	表可用 = 假
	完成操作("连接结果：" & 成功 & "；成功后先执行只读查询，再校验由 setup.sql 初始化的演示表。")
结束 事件

事件 数据库.添加记录完毕(成功 为 逻辑型)
	完成操作("添加执行结果：" & 成功 & "；重复主键应失败，点击查询核对实际记录。")
结束 事件

事件 数据库.修改记录完毕(成功 为 逻辑型)
	完成操作("修改返回：" & 成功 & "；影响行数大于0为真，0行或失败为假，需查询核对。")
结束 事件

事件 数据库.删除记录完毕(成功 为 逻辑型)
	完成操作("删除返回：" & 成功 & "；只按本次 ID 删除，0行或失败为假，请查询核对。")
结束 事件

事件 数据库.查询记录完毕(结果 为 集合)
	预览.文本 = 格式化结果(结果)
	完成操作("记录查询已返回；字段顺序为 id、name、phone、note。NULL 在数组内表现为空文本。")
结束 事件

事件 数据库.查询语句完毕(结果 为 集合)
	预览.文本 = 格式化结果(结果)
	如果 当前操作 = "校验表" 则
		表可用 = 假
		如果 结果.计数 = 1 则
			变量 字段 为 文本型()
			字段 = 结果.项目(0)
			如果 取数组成员数(字段) = 1 则 表可用 = 字段(0) = "ES4A MSSQL example v1"
		结束 如果
		完成操作("已有演示表校验结果：" & 表可用 & "；标记不符时不启用增改删。")
	否则
		完成操作("只读 SQL 已返回；0行也可能表示查询失败，不能据此判断执行成功。")
	结束 如果
结束 事件

函数 格式化结果(结果 为 集合) 为 文本型
	变量 内容 为 文本型
	变量 行 为 整数型
	变量 列 为 整数型
	变量 字段 为 文本型()
	内容 = "返回 " & 结果.计数 & " 行（无记录与失败都可能是0行）。"
	循环 行 = 0 至 结果.计数 - 1
		如果 行 >= 20 则 退出 循环
		字段 = 结果.项目(行)
		内容 = 内容 & "\n第" & (行 + 1) & "行："
		循环 列 = 0 至 取数组成员数(字段) - 1
			内容 = 内容 & "[" & 取文本左边(字段(列), 400) & "] "
		下个 列
	下个 行
	格式化结果 = 内容
结束 函数

事件 退出按钮.被单击()
	数据库.销毁()
	终止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		数据库.销毁()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "SQL Server 数据库示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "SQL Server 记录与 Unicode"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "先在专用 SQL Server 执行 example/setup.sql 初始化独立库表，再连接并校验标记。只增改删本次 ID；0行写入返回假。账号密码不写入示例。"
		$结束 $定义
		$定义 数据库 $为 simple.library.wsd.mssql.MsSQL数据库
		$结束 $定义
		$定义 地址 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "主机:端口；模拟器的 localhost 指向自身"
			文本 = ""
		$结束 $定义
		$定义 库与用户 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 库名 $为 编辑框
				宽度 = 0
				权重 = 1
				单行模式 = 真
				文本 = "es4a"
				提示文本 = "专用数据库名"
			$结束 $定义
			$定义 用户名 $为 编辑框
				宽度 = 0
				权重 = 1
				单行模式 = 真
				提示文本 = "用户名"
			$结束 $定义
		$结束 $定义
		$定义 口令 $为 密码编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示 = "密码（不保存）"
		$结束 $定义
		$定义 连接行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 连接按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "连接专用数据库"
			$结束 $定义
			$定义 断开按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "断开数据库"
			$结束 $定义
		$结束 $定义
		$定义 只读行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 只读按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "异步只读查询"
			$结束 $定义
			$定义 同步按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "后台同步只读查询"
			$结束 $定义
		$结束 $定义
		$定义 准备行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 校验按钮 $为 按钮
				宽度 = 长度_匹配父级
				文本 = "校验已有演示表"
			$结束 $定义
		$结束 $定义
		$定义 身份 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 姓名 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "姓名（64个代码单元以内）"
			文本 = "张三😀"
		$结束 $定义
		$定义 电话 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "电话按文本保存前导零"
			文本 = "0013800138000"
		$结束 $定义
		$定义 备注 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "备注可空；SQL NULL 由开关决定"
			文本 = ""
		$结束 $定义
		$定义 空值 $为 复选框
			文本 = "将备注写为 SQL NULL（否则按文本保存）"
		$结束 $定义
		$定义 写入行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 添加按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "添加本次记录"
			$结束 $定义
			$定义 修改按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "修改本次记录"
			$结束 $定义
		$结束 $定义
		$定义 查询行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 查询按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "查询本次记录"
			$结束 $定义
			$定义 核对按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "核对 NULL 与姓名字节"
			$结束 $定义
		$结束 $定义
		$定义 记录行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "删除本次记录"
			$结束 $定义
			$定义 新记录 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "生成新记录 ID"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "先连接专用数据库并做只读查询。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "完成通知 0；示例表已确认=假"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚无查询结果。"
		$结束 $定义
