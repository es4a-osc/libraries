变量 成_按下时间 为 长整数型
变量 成_HTTP服务器 为 HTTP服务器

事件 主窗口.初始化()
	成_HTTP服务器 = 创建 HTTP服务器
	按钮2.启用 = 假
结束 事件

事件 主窗口.程序被销毁()
	成_HTTP服务器.停止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 取现行时间戳() - 成_按下时间 > 2000 则
			成_按下时间 = 取现行时间戳()
			显示提示框("再按一次退出...")
		否则
			成_HTTP服务器.停止()
			终止()
		结束 如果
	结束 如果
结束 事件

事件 按钮1.被单击()
	成_HTTP服务器.启动(5000)
	按钮1.启用 = 假
	按钮2.启用 = 真
	投递消息("服务", "已请求监听5000端口；WS路径为 /ws")
结束 事件

事件 按钮2.被单击()
	成_HTTP服务器.停止()
	按钮1.启用 = 真
	按钮2.启用 = 假
	投递消息("服务", "已停止监听；已有WS连接请由客户端关闭")
结束 事件

事件 按钮3.被单击()
	编辑框1.文本 = ""
结束 事件

事件 成_HTTP服务器.响应请求(操作名称 为 文本型, 响应内容 为 文本型)
	' HTTP和WS回调来自网络线程，先投递到窗口主线程。
	投递消息(操作名称, 响应内容)
结束 事件

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	编辑框1.加入文本("[" & 格式化时间(取现行时间(), "HH:mm:ss") & "] " & 消息标记 & "：" & 附加参数 & "\n")
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "HTTP服务测试"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 按钮1 $为 按钮
			文本 = "启动监听（5000）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 按钮2 $为 按钮
			文本 = "停止监听"
			宽度 = 长度_匹配父级
			启用 = 假
		$结束 $定义
		$定义 按钮3 $为 按钮
			文本 = "清空日志"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 标签1 $为 标签
			文本 = "需独立 HTTP/WS 测试客户端；启动5000端口后 GET /yy 应返回“让编程更简单。”，POST应返回方法/路径，WS应原文回显。停止后新连接应失败。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑框1 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
