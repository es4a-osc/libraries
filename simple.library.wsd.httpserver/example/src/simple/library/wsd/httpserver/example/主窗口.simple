''' 同一应用内运行服务与浏览器客户端；网络回调先投递消息，再由窗口主线程更新日志。
变量 演示服务 为 服务端
变量 日志行数 为 整数型

事件 主窗口.初始化()
	演示服务 = 创建 服务端
结束 事件

事件 启动.被单击()
	演示服务.启动()
	启动.启用 = 假
	停止.启用 = 真
	状态.文本 = "已请求监听 5000；点击打开面板，以实际 HTTP 响应确认可用。"
结束 事件

事件 停止.被单击()
	演示服务.停止()
	启动.启用 = 真
	停止.启用 = 假
	状态.文本 = "已停止接受新连接；已有 WebSocket 须在面板中主动断开。"
结束 事件

事件 打开页面.被单击()
	浏览.加载("file:///android_asset/client.html")
结束 事件

事件 路由开关.被单击()
	演示服务.切换临时路由()
结束 事件

事件 清空日志.被单击()
	日志.文本 = ""
	日志行数 = 0
结束 事件

事件 演示服务.收到操作(消息 为 文本型)
	投递消息("服务日志", 消息)
结束 事件

事件 主窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	如果 标记 = "服务日志" 则
		如果 日志行数 >= 4 则
			日志.文本 = ""
			日志行数 = 0
		结束 如果
		日志.文本 = 日志.文本 & 内容 & "\n"
		日志行数 = 日志行数 + 1
	结束 如果
结束 事件

事件 浏览.载入失败(错误码 为 整数型, 地址 为 文本型)
	状态.文本 = "本地面板载入失败，错误码=" & 错误码 & "；请检查示例是否完整构建。"
结束 事件

事件 主窗口.程序被销毁()
	演示服务.停止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		演示服务.停止()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "HTTP服务使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "HTTP 与 WebSocket 服务"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "可信网络演示，无鉴权、不存储请求。手机内用 127.0.0.1:5000；跨设备改用服务设备地址。停止只拒绝新连接，请先断开 WS。"
		$结束 $定义
		$定义 启停操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 启动 $为 按钮
				宽度 = "140dp"
				文本 = "启动服务"
			$结束 $定义
			$定义 停止 $为 按钮
				宽度 = "140dp"
				文本 = "停止服务"
				启用 = 假
			$结束 $定义
			$定义 打开页面 $为 按钮
				宽度 = "140dp"
				文本 = "打开面板"
			$结束 $定义
		$结束 $定义
		$定义 路由操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 路由开关 $为 按钮
				宽度 = "140dp"
				文本 = "临时路由开关"
			$结束 $定义
			$定义 清空日志 $为 按钮
				宽度 = "140dp"
				文本 = "清空日志"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "尚未启动；先启动，再打开面板。"
		$结束 $定义
		$定义 浏览 $为 网页浏览框
			宽度 = 长度_匹配父级
			高度 = "380dp"
			启用JS = 真
		$结束 $定义
		$定义 日志 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "操作日志（最多保留最近一组 4 行）："
		$结束 $定义
	$结束 $定义
$结束 $属性
