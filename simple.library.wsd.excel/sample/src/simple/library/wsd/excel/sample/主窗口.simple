' 在应用私有目录写入并重读 contacts.xls；再次写入会覆盖本例文件。
事件 写入按钮.被单击()
	如果 EXCEL操作1.添加工作表("联系人", "contacts.xls") 则
		EXCEL操作1.添加单元格(0, 0, "序号")
		EXCEL操作1.添加单元格(0, 1, "姓名")
		EXCEL操作1.添加单元格(0, 2, "电话")
		EXCEL操作1.添加单元格(1, 0, "1")
		EXCEL操作1.添加单元格(1, 1, "张三")
		EXCEL操作1.添加单元格(1, 2, "1234567")
		EXCEL操作1.添加单元格(2, 0, "合并示例")
		EXCEL操作1.合并单元格(2, 0, 2, 2)
		如果 EXCEL操作1.写出工作表() 则
			日志框.文本 = "已写入应用私有目录 contacts.xls。"
		否则
			日志框.文本 = "写出失败。"
		结束 如果
	否则
		日志框.文本 = "创建失败或上一次写入尚未结束。"
	结束 如果
结束 事件

事件 读取按钮.被单击()
	如果 EXCEL操作1.读取工作表("contacts.xls") 则
		变量 行 为 整数型
		变量 列 为 整数型
		日志框.文本 = "行数：" & EXCEL操作1.读取总行数() & " 列数：" & EXCEL操作1.读取总列数()
		判断循环 行 < EXCEL操作1.读取总行数()
			列 = 0
			日志框.加入文本("\n")
			判断循环 列 < EXCEL操作1.读取总列数()
				日志框.加入文本(EXCEL操作1.读取单元格(行, 列) & "  ")
				列 = 列 + 1
			结束 判断循环
			行 = 行 + 1
		结束 判断循环
	否则
		日志框.文本 = "读取失败，请先写入测试文件。"
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "EXCEL操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 EXCEL操作1 $为 simple.library.wsd.excel.EXCEL操作
		$结束 $定义
		$定义 写入按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "写入联系人 XLS（覆盖同名示例）"
		$结束 $定义
		$定义 读取按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "重新读取并显示"
		$结束 $定义
		$定义 日志框 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "仅支持 .xls，不支持 .xlsx；行列索引从 0 开始。"
			单行模式 = 假
			高度 = 450
		$结束 $定义
	$结束 $定义
$结束 $属性
