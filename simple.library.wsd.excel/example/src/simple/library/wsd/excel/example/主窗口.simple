''' 参考 JExcelAPI 的创建、写出和关闭流程，改用当前 Simple 封装。
''' https://jexcelapi.sourceforge.net/resources/faq/
''' 仅写入本示例的私有 contacts.xls，不申请共享存储权限；所有单元格均写为文本。
别名 索引格式 = simple.runtime.collections.正则表达式

变量 忙碌 为 逻辑型
变量 正在写入 为 逻辑型
变量 下一行 为 整数型
变量 工作编号 为 整数型
变量 工作姓名 为 文本型
变量 工作电话 为 文本型
变量 工作备注 为 文本型
变量 工作路径 为 文本型
变量 返回状态 为 文本型
变量 返回预览 为 文本型
变量 另一条 为 逻辑型

事件 主窗口.初始化()
	更新状态()
	预览.文本 = "尚未读取文件。"
结束 事件

事件 编辑页.被单击()
	显示页面(真)
结束 事件

事件 读取页.被单击()
	显示页面(假)
结束 事件

过程 显示页面(编辑 为 逻辑型)
	编辑区.可视 = 编辑
	读取区.可视 = 取反 编辑
结束 过程

事件 新建.被单击()
	启动任务(1)
结束 事件

事件 追加.被单击()
	如果 姓名.文本 = "" 则
		输出.文本 = "请填写姓名；电话和备注可以为空文本。"
		退出 事件
	结束 如果
	工作姓名 = 姓名.文本
	工作电话 = 电话.文本
	工作备注 = 备注.文本
	启动任务(2)
结束 事件

事件 保存.被单击()
	启动任务(3)
结束 事件

事件 读文件.被单击()
	工作路径 = 文件路径.文本
	启动任务(4)
结束 事件

事件 缺失文件.被单击()
	工作路径 = "excel-example/missing-example.xls"
	启动任务(4)
结束 事件

事件 无效文件.被单击()
	启动任务(5)
结束 事件

事件 切换记录.被单击()
	另一条 = 取反 另一条
	如果 另一条 则
		姓名.文本 = "李四"
		电话.文本 = "001000"
		备注.文本 = "=1+1"
	否则
		姓名.文本 = "张三😀"
		电话.文本 = "0013800138000"
		备注.文本 = ""
	结束 如果
	输出.文本 = "已切换输入，点击添加才会写入当前会话；=1+1 也按文本保存。"
结束 事件

''' 后台串行处理文件；控件值先复制，完成后用反馈消息回到界面线程。
过程 启动任务(编号 为 整数型)
	如果 忙碌 则 退出 过程
	如果 正在写入 且 编号 >= 4 则
		输出.文本 = "请先保存当前写入会话，再打开文件；下方仍是上次读取的快照。"
		退出 过程
	结束 如果
	工作编号 = 编号
	忙碌 = 真
	置操作状态(假)
	输出.文本 = "正在处理 XLS 文件..."
	启动线程(本对象, "处理工作簿")
	位于 错误
		分支 否则
			忙碌 = 假
			置操作状态(真)
			输出.文本 = "无法启动文件任务。"
	结束 错误
结束 过程

过程 置操作状态(可用 为 逻辑型)
	新建.启用 = 可用
	追加.启用 = 可用
	保存.启用 = 可用
	读文件.启用 = 可用
	缺失文件.启用 = 可用
	无效文件.启用 = 可用
	绝对路径.启用 = 可用
	切换记录.启用 = 可用
	查单元格.启用 = 可用
	姓名.启用 = 可用
	电话.启用 = 可用
	备注.启用 = 可用
	文件路径.启用 = 可用
结束 过程

过程 处理工作簿()
	返回预览 = ""
	判断 工作编号
		分支 1
			创建目录("excel-example")
			如果 表格.添加工作表("联系人", "excel-example/contacts.xls") 则
				正在写入 = 真
				下一行 = 2
				如果 表格.添加单元格(0, 0, "联系人") 且 表格.合并单元格(0, 0, 0, 2) 且 表格.添加单元格(1, 0, "姓名") 且 表格.添加单元格(1, 1, "电话") 且 表格.添加单元格(1, 2, "备注") 则
					返回状态 = "已新建联系人表并合并首行三列；添加记录后再保存。"
				否则
					返回状态 = "表已创建，但表头或合并操作未全部成功；请保存结束会话后重新新建。"
				结束 如果
			否则
				返回状态 = "新建返回假：可能还有未保存会话；原写入会话保留，可继续添加或保存。"
			结束 如果
		分支 2
			如果 取反 正在写入 则
				返回状态 = "请先新建工作表，再添加记录。"
			否则
				如果 下一行 >= 8 则
					返回状态 = "此示例最多添加六条联系人，便于完整预览；并非 XLS 的行数上限。"
				否则
					如果 表格.添加单元格(下一行, 0, 工作姓名) 且 表格.添加单元格(下一行, 1, 工作电话) 且 表格.添加单元格(下一行, 2, 工作备注) 则
						返回状态 = "已添加第 " & (下一行 - 1) & " 条联系人，尚未保存到文件。"
						下一行 = 下一行 + 1
					否则
						返回状态 = "单元格写入未全部成功，当前记录未登记；可重试同一行后保存。"
					结束 如果
				结束 如果
			结束 如果
		分支 3
			变量 成功 为 逻辑型
			成功 = 表格.写出工作表()
			正在写入 = 假
			如果 成功 则
				工作路径 = "excel-example/contacts.xls"
				读取预览()
				返回状态 = "写出成功并关闭写入会话。" & 返回状态
			否则
				返回状态 = "写出返回假：没有可写会话，或文件保存失败；可重新新建。"
			结束 如果
		分支 4
			读取预览()
		分支 5
			创建目录("excel-example")
			如果 写出文本文件("excel-example/not-a-workbook.xls", "这是一份文本，不是真正的 XLS。") 则
				工作路径 = "excel-example/not-a-workbook.xls"
				读取预览()
			否则
				返回状态 = "未能准备无效格式示例文件。"
			结束 如果
	结束 判断
	投递消息("完成", 返回状态)
	位于 错误
		分支 否则
			投递消息("失败", "文件处理失败；请检查路径和可用空间，不把调用完成当作保存成功。")
	结束 错误
结束 过程

过程 读取预览()
	如果 表格.读取工作表(工作路径) 则
		变量 行 为 整数型
		变量 列 为 整数型
		变量 内容 为 文本型
		返回预览 = ""
		循环 行 = 0 至 表格.读取总行数() - 1
			如果 行 >= 8 则 退出 循环
			返回预览 = 返回预览 & "行 " & 行 & "："
			循环 列 = 0 至 表格.读取总列数() - 1
				如果 列 >= 3 则 退出 循环
				内容 = 表格.读取单元格(行, 列)
				如果 内容 = "" 则 内容 = "〈空〉"
				返回预览 = 返回预览 & "[" & 内容 & "] "
			下个 列
			返回预览 = 返回预览 & "\n"
		下个 行
		如果 返回预览 = "" 则 返回预览 = "工作表为空，没有单元格。"
		返回状态 = "已从文件读取第一张工作表：" & 工作路径
	否则
		返回预览 = "读取失败，之前的读取状态已清除。"
		返回状态 = "读取返回假；文件可能不存在、无权访问或不是有效 XLS：" & 工作路径
	结束 如果
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙碌 = 假
	置操作状态(真)
	输出.文本 = 附加参数
	如果 返回预览 <> "" 则
		预览.文本 = 返回预览
		显示页面(假)
		文件路径.文本 = 工作路径
	结束 如果
	更新状态()
结束 事件

过程 更新状态()
	如果 正在写入 则
		会话.文本 = "写入中；已添加 " & (下一行 - 2) & " 条联系人；下方读取区是上次快照。"
	否则
		会话.文本 = "无写入会话；新建会覆盖本示例 contacts.xls。"
	结束 如果
	读取状态.文本 = "当前读取：" & 表格.读取总行数() & " 行 × " & 表格.读取总列数() & " 列；预览最多前8行、3列。"
结束 过程

事件 绝对路径.被单击()
	变量 文件列表 为 文本型()
	变量 索引 为 整数型
	文件路径.文本 = "excel-example/contacts.xls"
	文件列表 = 取文件列表("excel-example")
	循环 索引 = 0 至 取数组成员数(文件列表) - 1
		如果 取文本右边(文件列表(索引), 12) = "contacts.xls" 则 文件路径.文本 = 文件列表(索引)
	下个 索引
	输出.文本 = "已选择示例文件路径，点击读取查看实际内容。"
	位于 错误
		分支 否则
			输出.文本 = "还没有示例文件，请先新建并保存。"
	结束 错误
结束 事件

事件 查单元格.被单击()
	变量 行 为 整数型
	变量 列 为 整数型
	变量 内容 为 文本型
	' 到整数对无效文本会返回0，因此先校验，避免把非法输入误当作第0行或第0列。
	变量 格式 为 索引格式
	格式 = 创建 索引格式
	格式.编译("^-?[0-9]{1,6}:-?[0-9]{1,6}$")
	格式.匹配(行号.文本 & ":" & 列号.文本)
	如果 取反 格式.匹配下一个() 则
		输出.文本 = "行、列请输入至多6位整数，索引从0开始。"
		退出 事件
	结束 如果
	行 = 到整数(行号.文本)
	列 = 到整数(列号.文本)
	内容 = 表格.读取单元格(行, 列)
	如果 内容 = "" 则 内容 = "〈空文本：单元格为空、越界或未打开〉"
	输出.文本 = "读取（行 " & 行 & "，列 " & 列 & "）：" & 内容
	位于 错误
		分支 否则
			输出.文本 = "行、列请输入整数，索引从0开始。"
	结束 错误
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 忙碌 则 退出 事件
		如果 正在写入 则
			输出.文本 = "还有未保存的写入会话，请先保存，再退出。"
		否则
			终止()
		结束 如果
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XLS 联系人示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 23
			文本 = "XLS 联系人读写"
			字体加粗 = 真
		$结束 $定义
		$定义 会话 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "无写入会话；新建会覆盖本示例 contacts.xls。"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "依次新建、添加记录、保存并读取。仅支持 .xls 第一张工作表，不支持 .xlsx。"
		$结束 $定义
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 编辑页 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "1. 编辑联系人"
			$结束 $定义
			$定义 读取页 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "2. 读取文件"
			$结束 $定义
		$结束 $定义
		$定义 编辑区 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			$定义 新建行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 新建 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "新建表（覆盖示例 XLS）"
				$结束 $定义
			$结束 $定义
			$定义 填写提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 14
				文本 = "姓名、电话、备注均写为文本；电话的前导零会保留。"
			$结束 $定义
			$定义 姓名 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = "张三😀"
				提示文本 = "姓名"
			$结束 $定义
			$定义 电话 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = "0013800138000"
				提示文本 = "电话（文本）"
			$结束 $定义
			$定义 备注 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = ""
				提示文本 = "备注（可空）"
			$结束 $定义
			$定义 记录行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 切换记录 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "切换另一条演示记录"
				$结束 $定义
				$定义 追加 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "添加这条联系人"
				$结束 $定义
			$结束 $定义
			$定义 保存行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 保存 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "保存并重新读取 XLS"
				$结束 $定义
			$结束 $定义
			$定义 覆盖提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本 = "固定保存到应用私有 excel-example/contacts.xls；新建不是向旧文件追加工作表。首行为三列合并标题，第二行为表头，联系人从行2开始。"
			$结束 $定义
		$结束 $定义
		$定义 读取区 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			可视 = 假
			$定义 读取状态 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 14
				文本 = "当前读取：0 行 × 0 列；预览最多前8行、3列。"
			$结束 $定义
			$定义 预览 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 16
				文本 = "尚未读取文件。"
			$结束 $定义
			$定义 文件路径 $为 编辑框
				宽度 = 长度_匹配父级
				单行模式 = 真
				文本 = "excel-example/contacts.xls"
				提示文本 = "文件路径（不支持资产名）"
			$结束 $定义
			$定义 读文件行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 读文件 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "读取路径"
				$结束 $定义
				$定义 绝对路径 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "选择示例绝对路径"
				$结束 $定义
			$结束 $定义
			$定义 坐标行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 行号 $为 编辑框
					宽度 = 0
					权重 = 1
					单行模式 = 真
					文本 = "2"
					提示文本 = "行（0起）"
				$结束 $定义
				$定义 列号 $为 编辑框
					宽度 = 0
					权重 = 1
					单行模式 = 真
					文本 = "1"
					提示文本 = "列（0起）"
				$结束 $定义
			$结束 $定义
			$定义 查询行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 查单元格 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "读取指定单元格"
				$结束 $定义
			$结束 $定义
			$定义 失败行 $为 面板
				宽度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				$定义 缺失文件 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "打开不存在文件"
				$结束 $定义
				$定义 无效文件 $为 按钮
					宽度 = 0
					权重 = 1
					文本 = "打开无效格式"
				$结束 $定义
			$结束 $定义
			$定义 读取提示 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本 = "相对路径以应用私有目录为基准，绝对路径还需具备访问条件。读取失败会清除上次读取状态；越界和空单元格均返回空文本。"
			$结束 $定义
		$结束 $定义
		$定义 表格 $为 simple.library.wsd.excel.EXCEL操作
		$结束 $定义
	$结束 $定义
$结束 $属性
