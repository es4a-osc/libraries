''' 基础演示：登记请求、提交结果和更新数据分开处理；离页停止计时并取消操作。
变量 来源 为 主窗口
变量 短内容 为 逻辑型
''' 普通控件放入垂直滚动框；列表和网页示例直接作为刷新内容，不再套滚动层。
变量 当前序号 为 整数型
变量 当前刷新 为 逻辑型
变量 下次失败 为 逻辑型
变量 标记末页 为 逻辑型
变量 消息数 为 整数型
变量 刷新次数 为 整数型
变量 加载次数 为 整数型
变量 上次序号 为 整数型
变量 上次刷新 为 逻辑型

事件 基础窗口.初始化()
	消息数 = 30
	更新消息()
	更新状态()
结束 事件

过程 更新消息()
	变量 索引 为 整数型
	变量 文本 为 文本型
	文本 = "本地消息 · 刷新次数 " & 刷新次数
	循环 索引 = 1 至 消息数
		文本 = 文本 & "\n消息 " & 索引 & "：下拉更新，上拉追加"
	下个 索引
	消息.文本 = 文本
结束 过程

过程 更新状态()
	状态.文本 = "状态=" & 刷新框.当前状态 & "；请求=" & 刷新框.当前请求序号 & "；末页=" & 刷新框.没有更多数据
	次数.文本 = "刷新=" & 刷新次数 & "；加载=" & 加载次数 & "；消息=" & 消息数
结束 过程

''' 两个开始事件共享请求登记，完成时只接收对应方向的当前序号。

过程 登记请求(序号 为 整数型, 刷新 为 逻辑型)
	当前序号 = 序号
	当前刷新 = 刷新
	如果 刷新 则
		刷新次数 = 刷新次数 + 1
		反馈.文本 = "正在更新消息，当前请求 #" & 序号
	否则
		加载次数 = 加载次数 + 1
		反馈.文本 = "正在追加消息，当前请求 #" & 序号
	结束 如果
	业务计时.启用 = 自动完成.选中
	更新状态()
结束 过程

事件 刷新框.开始刷新(请求序号 为 整数型)
	登记请求(请求序号, 真)
结束 事件

事件 刷新框.开始加载(请求序号 为 整数型)
	登记请求(请求序号, 假)
结束 事件

事件 业务计时.计时()
	完成业务()
结束 事件

过程 完成业务()
	业务计时.启用 = 假
	如果 当前序号 = 0 则
		反馈.文本 = "当前没有等待业务结果的请求。"
		退出 过程
	结束 如果

	变量 成功 为 逻辑型
	变量 受理 为 逻辑型
	成功 = 取反 下次失败
	上次序号 = 当前序号
	上次刷新 = 当前刷新
	如果 当前刷新 则
		受理 = 刷新框.完成刷新(当前序号, 成功)
	否则
		受理 = 刷新框.完成加载(当前序号, 成功, 标记末页)
	结束 如果

	如果 成功 且 受理 则
		如果 当前刷新 则
			消息数 = 30
			如果 短内容 则 消息数 = 2
		否则
			消息数 = 消息数 + 5
			标记末页 = 假
		结束 如果
		更新消息()
	结束 如果
	反馈.文本 = "提交 #" & 当前序号 & "；成功=" & 成功 & "；受理=" & 受理
	当前序号 = 0
	下次失败 = 假
	更新状态()
结束 过程

事件 刷新框.状态改变(旧状态 为 文本型, 新状态 为 文本型)
	更新状态()
结束 事件

事件 刷新框.操作取消(请求序号 为 整数型)
	业务计时.启用 = 假
	上次序号 = 请求序号
	上次刷新 = 当前刷新
	当前序号 = 0
	反馈.文本 = "请求 #" & 请求序号 & " 已取消；示例同时停止自己的计时任务。"
	更新状态()
结束 事件

事件 自动刷新.被单击()
	反馈.文本 = "自动刷新受理=" & 刷新框.触发刷新()
结束 事件

事件 自动加载.被单击()
	反馈.文本 = "自动加载受理=" & 刷新框.触发加载()
结束 事件

事件 完成当前.被单击()
	完成业务()
结束 事件

事件 取消操作.被单击()
	变量 结果 为 逻辑型
	结果 = 刷新框.取消当前操作()
	反馈.文本 = "取消受理=" & 结果
结束 事件

事件 失败一次.被单击()
	下次失败 = 真
	反馈.文本 = "下一次提交返回失败；不会追加消息或标记末页。"
结束 事件

事件 加载末页.被单击()
	标记末页 = 真
	反馈.文本 = "下一次成功加载后标记没有更多数据。"
结束 事件

事件 重置数据.被单击()
	刷新框.重置加载状态()
	标记末页 = 假
	反馈.文本 = "已重置分页结束标记。"
	更新状态()
结束 事件

事件 切换长度.被单击()
	短内容 = 取反 短内容
	如果 短内容 则
		消息数 = 2
	否则
		消息数 = 30
	结束 如果
	更新消息()
	更新状态()
结束 事件

事件 下拉开关.状态改变()
	刷新框.允许下拉 = 下拉开关.选中
结束 事件

事件 上拉开关.状态改变()
	刷新框.允许上拉 = 上拉开关.选中
结束 事件

事件 自动完成.状态改变()
	业务计时.启用 = 自动完成.选中 且 当前序号 > 0
结束 事件

事件 自动加载开关.状态改变()
	刷新框.自动加载更多 = 自动加载开关.选中
结束 事件

事件 短内容开关.状态改变()
	刷新框.内容不足时允许加载 = 短内容开关.选中
结束 事件

事件 回到顶部.被单击()
	滚动区.滚动到顶()
结束 事件

事件 回到底部.被单击()
	滚动区.滚动到底()
结束 事件

事件 旧结果.被单击()
	变量 结果 为 逻辑型
	如果 上次刷新 则
		结果 = 刷新框.完成刷新(上次序号, 真)
	否则
		结果 = 刷新框.完成加载(上次序号, 真, 假)
	结束 如果
	反馈.文本 = "再次提交旧请求 #" & 上次序号 & "；受理=" & 结果
	更新状态()
结束 事件

事件 基础窗口.切换完毕()
	更新状态()
结束 事件

事件 基础窗口.应用被销毁()
	业务计时.启用 = 假
结束 事件

事件 基础窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 更多选项.被单击()
	可选操作.可视 = 取反 可选操作.可视
	如果 可选操作.可视 则
		更多选项.文本 = "收起选项"
	否则
		更多选项.文本 = "更多选项"
	结束 如果
结束 事件

事件 基础窗口.即将切换()
	业务计时.启用 = 假
	刷新框.关闭头尾()
	当前序号 = 0
结束 事件

$属性
	$资源 $窗口
	$定义 基础窗口 $为 窗口
		标题 = "SRL下拉刷新框 · 基础刷新"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 页头 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = "96dp"
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 标题 $为 标签
				文本 = "基础刷新与分页"
				宽度 = 0
				权重 = 1
				字体大小 = 20
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "下拉更新，上拉追加；更多选项中可切换手动完成、失败和末页。"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
			底填充 = "8dp"
		$结束 $定义
		$定义 主要操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 自动刷新 $为 按钮
				文本 = "自动刷新"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 自动加载 $为 按钮
				文本 = "自动加载"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 取消操作 $为 按钮
				文本 = "取消操作"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 浏览操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 回到顶部 $为 按钮
				文本 = "到顶部"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 回到底部 $为 按钮
				文本 = "到底部"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 更多选项 $为 按钮
				文本 = "更多选项"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 可选操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			可视 = 假
			$定义 完成操作 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 完成当前 $为 按钮
					文本 = "完成当前"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
				$定义 失败一次 $为 按钮
					文本 = "下次失败"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
				$定义 加载末页 $为 按钮
					文本 = "加载至末页"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
			$结束 $定义
			$定义 基础开关 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 下拉开关 $为 复选框
					文本 = "允许下拉"
					选中 = 真
					宽度 = 0
					权重 = 1
					高度 = "40dp"
					字体大小 = 12
				$结束 $定义
				$定义 上拉开关 $为 复选框
					文本 = "允许上拉"
					选中 = 真
					宽度 = 0
					权重 = 1
					高度 = "40dp"
					字体大小 = 12
				$结束 $定义
				$定义 自动完成 $为 复选框
					文本 = "自动完成"
					选中 = 真
					宽度 = 0
					权重 = 1
					高度 = "40dp"
					字体大小 = 12
				$结束 $定义
			$结束 $定义
			$定义 加载开关 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 自动加载开关 $为 复选框
					文本 = "自动加载"
					选中 = 假
					宽度 = 0
					权重 = 1
					高度 = "40dp"
					字体大小 = 12
				$结束 $定义
				$定义 短内容开关 $为 复选框
					文本 = "短内容可加载"
					选中 = 假
					宽度 = 0
					权重 = 1
					高度 = "40dp"
					字体大小 = 12
				$结束 $定义
			$结束 $定义
			$定义 辅助操作 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 旧结果 $为 按钮
					文本 = "提交旧结果"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
				$定义 切换长度 $为 按钮
					文本 = "切换长短"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
				$定义 重置数据 $为 按钮
					文本 = "重置分页"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "状态=空闲"
			宽度 = 长度_匹配父级
			字体大小 = 13
		$结束 $定义
		$定义 次数 $为 标签
			文本 = "刷新=0；加载=0；消息=30"
			宽度 = 长度_匹配父级
			字体大小 = 13
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "顶部下拉或底部上拉，也可点击自动触发。"
			宽度 = 长度_匹配父级
			字体大小 = 13
			底填充 = "8dp"
		$结束 $定义
		$定义 刷新框 $为 simple.library.wsd.smartrefresh.SRL下拉刷新框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 滚动区 $为 垂直滚动框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				$定义 内容面板 $为 面板
					布局 = 布局_线性
					布局.方向 = 布局_方向_垂直
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					$定义 消息 $为 标签
						宽度 = 长度_匹配父级
						字体大小 = 17
						文本 = ""
						顶填充 = "8dp"
						左填充 = "12dp"
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 业务计时 $为 计时器
			间隔 = 1800
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
