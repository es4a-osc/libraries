''' 从组件实际类型更新样式说明；自定义视图只借用一次，离页取消业务。
变量 来源 为 主窗口
变量 头编号 为 整数型
变量 尾编号 为 整数型
变量 头名称 为 文本型()
变量 尾名称 为 文本型()
变量 请求 为 整数型
变量 刷新方向 为 逻辑型
变量 二楼已借用 为 逻辑型
变量 使用替代内容 为 逻辑型
变量 刷新次数 为 整数型
变量 加载次数 为 整数型
变量 内部点击次数 为 整数型
变量 增高 为 逻辑型

事件 样式窗口.初始化()
	头名称 = 分割文本("经典|雷达|Material|虚拟|二楼|贝塞尔圆|快递|Dropbox|飞行|坦克游戏|打砖块|凤凰|仓库|金牛|水滴|波浪", "|")
	尾名称 = 分割文本("经典|球脉冲|虚拟", "|")
	刷新框.绑定飞行场景(场景, 飞机)
	变量 索引 为 整数型
	变量 文本 为 文本型
	循环 索引 = 1 至 40
		文本 = 文本 & "消息 " & 索引 & "：切换头尾、拖动查看真实效果。\n"
	下个 索引
	正文.文本 = 文本
	更新说明()
结束 事件

过程 更新说明()
	头编号 = 刷新框.刷新头样式
	尾编号 = 刷新框.加载尾样式
	变量 头文字 为 文本型
	变量 尾文字 为 文本型
	如果 头编号 = 16 则
		头文字 = "自定义"
	否则
		头文字 = 头名称(头编号)
	结束 如果
	如果 尾编号 = 3 则
		尾文字 = "自定义"
	否则
		尾文字 = 尾名称(尾编号)
	结束 如果
	样式.文本 = "刷新头：" & 头文字 & "  /  加载尾：" & 尾文字
	飞行区.可视 = 头编号 = 8
	如果 头编号 <> 4 则 二楼已借用 = 假
	次数.文本 = "刷新=" & 刷新次数 & "；加载=" & 加载次数 & "；" & 刷新框.当前状态
结束 过程

过程 选择头()
	如果 刷新框.当前状态 <> "空闲" 则
		反馈.文本 = "先完成当前操作，再切换样式。"
		退出 过程
	结束 如果
	刷新框.刷新头样式 = 头编号
	飞行区.可视 = 头编号 = 8
	更新说明()
结束 过程

事件 前一头.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	头编号 = 头编号 - 1
	如果 头编号 < 0 或 头编号 > 15 则 头编号 = 15
	选择头()
结束 事件

事件 后一头.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	头编号 = 头编号 + 1
	如果 头编号 > 15 则 头编号 = 0
	选择头()
结束 事件

事件 后一尾.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	尾编号 = 尾编号 + 1
	如果 尾编号 > 2 则 尾编号 = 0
	刷新框.加载尾样式 = 尾编号
	更新说明()
结束 事件

事件 自动刷新.被单击()
	反馈.文本 = "触发刷新=" & 刷新框.触发刷新()
结束 事件

事件 自动加载.被单击()
	反馈.文本 = "触发加载=" & 刷新框.触发加载()
结束 事件

事件 收回.被单击()
	刷新框.关闭头尾()
结束 事件

事件 刷新框.开始刷新(序号 为 整数型)
	请求 = 序号
	刷新方向 = 真
	刷新次数 = 刷新次数 + 1
	业务计时.启用 = 真
	反馈.文本 = "刷新请求 #" & 序号
	更新说明()
结束 事件

事件 刷新框.开始加载(序号 为 整数型)
	请求 = 序号
	刷新方向 = 假
	加载次数 = 加载次数 + 1
	业务计时.启用 = 真
	反馈.文本 = "加载请求 #" & 序号
	更新说明()
结束 事件

事件 业务计时.计时()
	业务计时.启用 = 假
	变量 受理 为 逻辑型
	如果 刷新方向 则
		受理 = 刷新框.完成刷新(请求, 真)
	否则
		受理 = 刷新框.完成加载(请求, 真, 假)
	结束 如果
	反馈.文本 = "完成 #" & 请求 & "；受理=" & 受理
	请求 = 0
结束 事件

事件 刷新框.操作取消(序号 为 整数型)
	业务计时.启用 = 假
	请求 = 0
	反馈.文本 = "已取消 #" & 序号
结束 事件

事件 刷新框.状态改变(旧状态 为 文本型, 新状态 为 文本型)
	更新说明()
结束 事件

事件 刷新框.头部移动(手指拖动 为 逻辑型, 比例 为 单精度小数型, 偏移 为 整数型, 高度 为 整数型, 最大高度 为 整数型)
	进度.文本 = "头部偏移=" & 偏移 & "px；高度=" & 高度 & "px"
	自定义头文案.文本 = "自定义头：偏移 " & 偏移 & "px"
结束 事件

事件 刷新框.尾部移动(手指拖动 为 逻辑型, 比例 为 单精度小数型, 偏移 为 整数型, 高度 为 整数型, 最大高度 为 整数型)
	进度.文本 = "尾部偏移=" & 偏移 & "px；高度=" & 高度 & "px"
	自定义尾文案.文本 = "自定义尾：偏移 " & 偏移 & "px"
结束 事件

事件 自定义文案.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	头编号 = 0
	选择头()
	变量 外观 为 simple.library.wsd.smartrefresh.刷新外观
	外观 = 刷新框.取刷新头外观()
	外观.拉动提示 = "下拉更新本地消息"
	外观.释放提示 = "松开提交更新"
	外观.处理中提示 = "正在整理消息…"
	外观.完成提示 = "消息已更新"
	外观.失败提示 = "更新失败，请重试"
	外观.显示更新时间 = 真
	外观.时间格式 = "上次更新 HH:mm:ss"
	外观.标题字号 = 18
	外观.箭头尺寸 = 24
	外观.主颜色 = -14069085
	外观.强调颜色 = -1
	刷新框.应用刷新头外观(外观)
	反馈.文本 = "已应用经典文案、时间、颜色和图形尺寸。"
结束 事件

事件 自定义头尾.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	如果 刷新框.刷新头样式 <> 16 则 刷新框.设置自定义刷新头(自定义头)
	如果 刷新框.加载尾样式 <> 3 则 刷新框.设置自定义加载尾(自定义尾)
	更新说明()
	反馈.文本 = "已借用自定义头尾；恢复内置样式时归还原位置。"
结束 事件

事件 配置二楼.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	如果 取反 二楼已借用 则
		刷新框.设置二楼内容(二楼内容)
		二楼已借用 = 真
	结束 如果
	刷新框.配置二楼(1, 1.9, 2.5, 350, 0.25, 真, 真, 真, 0)
	头编号 = 4
	更新说明()
	反馈.文本 = "可深拉进入二楼，也可点击打开二楼。"
结束 事件

事件 打开二楼.被单击()
	变量 受理 为 逻辑型
	受理 = 刷新框.打开二楼(真)
	如果 取反 受理 则
		反馈.文本 = "先配置二楼，并等待刷新框空闲。"
	否则
		如果 允许二楼.选中 则
			反馈.文本 = "正在打开二楼。"
		否则
			反馈.文本 = "已在准备打开事件中拒绝进入二楼。"
		结束 如果
	结束 如果
结束 事件

事件 关闭二楼.被单击()
	如果 刷新框.关闭二楼() 则
		反馈.文本 = "正在收起二楼。"
	否则
		反馈.文本 = "当前没有打开的二楼。"
	结束 如果
结束 事件

事件 二楼内关闭.被单击()
	变量 受理 为 逻辑型
	受理 = 刷新框.关闭二楼()
结束 事件

事件 刷新框.准备打开二楼(传址 允许 为 逻辑型)
	允许 = 允许二楼.选中
	如果 取反 允许 则 反馈.文本 = "已在准备打开事件中拒绝进入二楼。"
结束 事件

事件 刷新框.二楼已打开()
	反馈.文本 = "二楼已实际打开。"
结束 事件

事件 刷新框.二楼已关闭()
	反馈.文本 = "二楼已实际关闭。"
结束 事件

事件 替换内容.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	如果 使用替代内容 则
		反馈.文本 = "当前已经是替代内容。"
		退出 事件
	结束 如果
	刷新框.替换刷新内容(替代内容)
	使用替代内容 = 真
	反馈.文本 = "已借用替代内容；恢复时归还原容器。"
结束 事件

事件 恢复内容.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	刷新框.恢复原内容()
	使用替代内容 = 假
	反馈.文本 = "已恢复初始内容。"
结束 事件

事件 刷新框.飞行动画结束()
	反馈.文本 = "飞行图标已实际返回。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 样式窗口.即将切换()
	业务计时.启用 = 假
	刷新框.关闭头尾()
	请求 = 0
结束 事件

事件 样式窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 定制选项.被单击()
	定制面板.可视 = 取反 定制面板.可视
	如果 定制面板.可视 则
		定制选项.文本 = "收起定制选项"
	否则
		定制选项.文本 = "展开定制选项"
	结束 如果
结束 事件

事件 样式窗口.程序被销毁()
	业务计时.启用 = 假
结束 事件

事件 样式窗口.切换完毕()
	更新说明()
结束 事件

事件 头部交互.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	如果 刷新框.刷新头样式 <> 16 则 刷新框.设置自定义刷新头(自定义头)
	变量 外观 为 simple.library.wsd.smartrefresh.刷新外观
	外观 = 刷新框.取刷新头外观()
	外观 = 外观.复制()
	外观.自定义接收触摸 = 真
	外观.自定义背景颜色 = -1055233
	刷新框.应用刷新头外观(外观)
	刷新框.设置头尾像素尺寸(真, -1, -2)
	反馈.文本 = "头部交互动画=" & 刷新框.动画刷新(0, 300, 1, 真)
	更新说明()
结束 事件

事件 尾部交互.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	如果 刷新框.加载尾样式 <> 3 则 刷新框.设置自定义加载尾(自定义尾)
	变量 外观 为 simple.library.wsd.smartrefresh.刷新外观
	外观 = 刷新框.取加载尾外观()
	外观 = 外观.复制()
	外观.自定义接收触摸 = 真
	外观.自定义背景颜色 = -2097153
	刷新框.应用加载尾外观(外观)
	刷新框.设置头尾像素尺寸(假, -1, -2)
	反馈.文本 = "尾部交互动画=" & 刷新框.动画加载(0, 300, 1, 真)
	更新说明()
结束 事件

事件 重测高度.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	如果 刷新框.刷新头样式 <> 16 则 刷新框.设置自定义刷新头(自定义头)
	刷新框.设置头尾像素尺寸(真, -1, -2)
	增高 = 取反 增高
	如果 增高 则
		头内按钮.高度 = "100dp"
	否则
		头内按钮.高度 = "40dp"
	结束 如果
	反馈.文本 = "高度重测受理=" & 刷新框.重新测量头尾(真) & "；按钮增高=" & 增高
	更新说明()
	尺寸计时.启用 = 真
结束 事件

事件 尺寸计时.计时()
	尺寸计时.启用 = 假
	反馈.文本 = "实际头高=" & 刷新框.取头尾像素高度(真) & "px；按钮增高=" & 增高
结束 事件

事件 头内按钮.被单击()
	内部点击次数 = 内部点击次数 + 1
	反馈.文本 = "头内按钮实际点击=" & 内部点击次数
结束 事件

事件 尾内按钮.被单击()
	内部点击次数 = 内部点击次数 + 1
	反馈.文本 = "尾内按钮实际点击=" & 内部点击次数
结束 事件

事件 配置配色.被单击()
	如果 刷新框.当前状态 <> "空闲" 则 退出 事件
	变量 外观 为 simple.library.wsd.smartrefresh.刷新外观
	外观 = 刷新框.取刷新头外观()
	外观 = 外观.复制()
	变量 颜色 为 整数型(3)
	颜色(0) = -65536
	颜色(1) = -16711936
	颜色(2) = -16776961
	外观.置动画颜色(颜色)
	外观.Material圆背景颜色 = -1
	外观.波浪阴影半径 = 4
	外观.波浪阴影颜色 = -16777216
	刷新框.应用刷新头外观(外观)
	刷新框.刷新头样式 = 15
	场景.场景视口高度 = 120
	反馈.文本 = "波浪三色及阴影已应用；独立外观颜色数=" & 取数组成员数(外观.取动画颜色())
	更新说明()
结束 事件

$属性
	$资源 $窗口
	$定义 样式窗口 $为 窗口
		标题 = "智能刷新框 · 样式定制"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 页头 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = "96dp"
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 标题 $为 标签
				文本 = "样式与内容定制"
				宽度 = 0
				权重 = 1
				字体大小 = 20
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "先选择头尾体验刷新；展开定制选项查看二楼与内容替换。"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
			底填充 = "8dp"
		$结束 $定义
		$定义 切换 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 前一头 $为 按钮
				文本 = "上一头型"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 后一头 $为 按钮
				文本 = "下一头型"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 后一尾 $为 按钮
				文本 = "切换尾型"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 样式 $为 标签
			文本 = "刷新头：经典  /  加载尾：经典"
			宽度 = 长度_匹配父级
			字体大小 = 13
		$结束 $定义
		$定义 触发 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 自动刷新 $为 按钮
				文本 = "自动刷新"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 自动加载 $为 按钮
				文本 = "自动加载"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 收回 $为 按钮
				文本 = "收回头尾"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 定制开关 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 定制选项 $为 按钮
				文本 = "展开定制选项"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 定制面板 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			可视 = 假
			$定义 定制 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 自定义文案 $为 按钮
					文本 = "经典定制"
