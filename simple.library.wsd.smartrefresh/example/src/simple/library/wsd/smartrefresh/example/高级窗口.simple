别名 SRL刷新错误 = simple.library.wsd.smartrefresh.SRL刷新错误

''' 分别展示延时触发、仅动画和业务完成；等待触发期间不修改结构选项。
变量 来源 为 主窗口
变量 请求 为 整数型
变量 刷新方向 为 逻辑型
变量 曲线编号 为 整数型
变量 曲线名称 为 文本型()
变量 等待触发 为 逻辑型
变量 开始次数 为 整数型
变量 结束次数 为 整数型
变量 拒绝边界 为 逻辑型
变量 头部释放次数 为 整数型
变量 尾部释放次数 为 整数型

事件 高级窗口.初始化()
	曲线名称 = 分割文本("原生|线性|加速|减速|加减速|弹跳|越界|回缩|回缩越界|自定义|贝塞尔", "|")
	刷新框.设置固定头部(固定头)
	刷新框.设置固定尾部(固定尾)
	刷新框.设置头部跟随视图(正文)
	刷新框.设置尾部跟随视图(正文)
	刷新框.启用自定义边界 = 真
	变量 索引 为 整数型
	变量 文本 为 文本型
	循环 索引 = 1 至 30
		文本 = 文本 & "高级内容 " & 索引 & "：固定头尾与滚动边界。\n"
	下个 索引
	正文.文本 = 文本
	更新状态()
结束 事件

事件 延时刷新.被单击()
	如果 取反 可以调整() 则 退出 事件
	等待触发 = 刷新框.动画刷新(1500, 400, 1.2, 假)
	如果 等待触发 则
		反馈.文本 = "已安排 1.5 秒后的刷新，可点击收回取消。"
	否则
		反馈.文本 = "当前未能触发，请检查刷新开关或分页状态。"
	结束 如果
	更新状态()
结束 事件

事件 仅动画.被单击()
	如果 取反 可以调整() 则 退出 事件
	等待触发 = 刷新框.动画刷新(0, 400, 1, 真)
	如果 等待触发 则
		反馈.文本 = "只播放动画，不开始业务；点击收回结束。"
	否则
		反馈.文本 = "当前未能触发，请检查刷新开关或分页状态。"
	结束 如果
	更新状态()
结束 事件

事件 延时加载.被单击()
	如果 取反 可以调整() 则 退出 事件
	等待触发 = 刷新框.动画加载(1200, 400, 1.2, 假)
	如果 等待触发 则
		反馈.文本 = "已安排 1.2 秒后的加载，可点击收回取消。"
	否则
		反馈.文本 = "当前未能触发，请检查刷新开关或分页状态。"
	结束 如果
	更新状态()
结束 事件

事件 关闭.被单击()
	刷新框.关闭头尾()
	等待触发 = 假
	请求 = 0
	更新状态()
	反馈.文本 = "已请求收回；延时触发和旧结果均失效。"
结束 事件

事件 结束业务.被单击()
	如果 请求 = 0 则
		反馈.文本 = "先开始一次刷新或加载，再提交完成。"
		退出 事件
	结束 如果
	变量 受理 为 逻辑型
	如果 刷新方向 则
		受理 = 刷新框.延时完成刷新(请求, 800, 真, -1)
	否则
		受理 = 刷新框.延时完成加载(请求, 800, 真, 假)
	结束 如果
	反馈.文本 = "延时提交 #" & 请求 & "；受理=" & 受理
	如果 受理 则 请求 = 0
	更新状态()
结束 事件

事件 曲线.被单击()
	如果 取反 可以调整() 则 退出 事件
	曲线编号 = 曲线编号 + 1
	如果 曲线编号 > 10 则 曲线编号 = 0
	刷新框.回弹插值模式 = 曲线编号
	如果 曲线编号 = 10 则 刷新框.设置回弹贝塞尔(0.2, 0, 0.2, 1)
	反馈.文本 = "已切换为" & 曲线名称(曲线编号) & "回弹曲线。"
	更新状态()
结束 事件

事件 刷新框.计算回弹位置(输入 为 单精度小数型, 传址 输出 为 单精度小数型)
	输出 = 输入 * 输入 * (3 - 2 * 输入)
结束 事件

事件 边界.被单击()
	拒绝边界 = 取反 拒绝边界
	反馈.文本 = "自定义边界阻止手势触发=" & 拒绝边界
	更新状态()
结束 事件

事件 刷新框.判断下拉边界(传址 允许 为 逻辑型)
	如果 拒绝边界 则 允许 = 假
结束 事件

事件 刷新框.判断上拉边界(传址 允许 为 逻辑型)
	如果 拒绝边界 则 允许 = 假
结束 事件

事件 像素设置.被单击()
	如果 取反 可以调整() 则 退出 事件
	刷新框.设置头尾像素高度(真, 150)
	刷新框.设置头尾像素偏移(真, 10)
	刷新框.设置头尾像素尺寸(假, -1, 100)
	反馈.文本 = "头高=" & 刷新框.取头尾像素高度(真) & "px；起始偏移=10px"
结束 事件

事件 切换纯滚动.被单击()
	如果 取反 可以调整() 则 退出 事件
	刷新框.纯滚动模式 = 取反 刷新框.纯滚动模式
	反馈.文本 = "纯滚动模式=" & 刷新框.纯滚动模式
	更新状态()
结束 事件

事件 刷新框.开始刷新(序号 为 整数型)
	等待触发 = 假
	请求 = 序号
	刷新方向 = 真
	开始次数 = 开始次数 + 1
	更新状态()
结束 事件

事件 刷新框.开始加载(序号 为 整数型)
	等待触发 = 假
	请求 = 序号
	刷新方向 = 假
	开始次数 = 开始次数 + 1
	更新状态()
结束 事件

事件 刷新框.头部结束(成功 为 逻辑型)
	结束次数 = 结束次数 + 1
	更新状态()
结束 事件

事件 刷新框.尾部结束(成功 为 逻辑型)
	结束次数 = 结束次数 + 1
	更新状态()
结束 事件

事件 刷新框.头部释放(高度 为 整数型, 最大高度 为 整数型)
	头部释放次数 = 头部释放次数 + 1
	更新状态()
结束 事件

事件 刷新框.尾部释放(高度 为 整数型, 最大高度 为 整数型)
	尾部释放次数 = 尾部释放次数 + 1
	更新状态()
结束 事件

事件 刷新框.操作取消(序号 为 整数型)
	请求 = 0
	反馈.文本 = "取消请求 #" & 序号
结束 事件

事件 刷新框.状态改变(旧状态 为 文本型, 新状态 为 文本型)
	如果 新状态 <> "空闲" 则 等待触发 = 假
	更新状态()
结束 事件

过程 更新状态()
	变量 状态文字 为 文本型
	状态文字 = 刷新框.当前状态
	如果 等待触发 则 状态文字 = "等待延时触发"
	选项状态.文本 = "曲线：" & 曲线名称(曲线编号) & "；阻止手势=" & 拒绝边界 & "；纯滚动=" & 刷新框.纯滚动模式
	状态.文本 = "开始=" & 开始次数 & "；结束=" & 结束次数 & "；请求=" & 刷新框.当前请求序号
	阶段.文本 = "头释放=" & 头部释放次数 & "；尾释放=" & 尾部释放次数 & "；" & 状态文字
结束 过程

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 高级窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

函数 可以调整() 为 逻辑型
	可以调整 = 刷新框.当前状态 = "空闲" 且 取反 等待触发
	如果 取反 可以调整 则 反馈.文本 = "请先收回当前操作，再调整或重新触发。"
结束 函数

事件 高级设置.被单击()
	设置面板.可视 = 取反 设置面板.可视
	如果 设置面板.可视 则
		高级设置.文本 = "收起高级设置"
	否则
		高级设置.文本 = "展开高级设置"
	结束 如果
结束 事件

事件 高级窗口.即将切换()
	刷新框.关闭头尾()
	等待触发 = 假
	请求 = 0
结束 事件

事件 高级窗口.切换完毕()
	更新状态()
结束 事件

事件 安全外观.被单击()
	变量 外观 为 simple.library.wsd.smartrefresh.SRL刷新外观
	外观 = 刷新框.取刷新头外观()
	外观.主颜色 = -16738680
	刷新框.应用刷新头外观(外观)
	反馈.文本 = "空闲时已应用外观；刷新期间会由错误分支安全拒绝。"
	位于 错误
		分支 SRL刷新错误
			反馈.文本 = "已捕获刷新错误：当前状态不允许修改外观。"
		分支 否则
			反馈.文本 = "遇到其它错误，请检查外观参数。"
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 高级窗口 $为 窗口
		标题 = "SRL下拉刷新框 · 高级选项"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 页头 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = "96dp"
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 标题 $为 标签
				文本 = "动画与高级选项"
				宽度 = 0
				权重 = 1
				字体大小 = 20
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "延时触发可取消；仅动画没有业务请求，使用收回结束。"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
			底填充 = "8dp"
		$结束 $定义
		$定义 触发操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 延时刷新 $为 按钮
				文本 = "延时刷新"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 延时加载 $为 按钮
				文本 = "延时加载"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 仅动画 $为 按钮
				文本 = "仅动画"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 完成操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 结束业务 $为 按钮
				文本 = "延时完成"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 关闭 $为 按钮
				文本 = "收回头尾"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 高级设置 $为 按钮
				文本 = "高级设置"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 设置面板 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			可视 = 假
			$定义 曲线操作 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 曲线 $为 按钮
					文本 = "切换曲线"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
				$定义 边界 $为 按钮
					文本 = "边界开关"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
				$定义 像素设置 $为 按钮
					文本 = "像素设置"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
			$结束 $定义
			$定义 滚动操作 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				$定义 切换纯滚动 $为 按钮
					文本 = "纯滚动开关"
					宽度 = 0
					权重 = 1
					高度 = "44dp"
					字体大小 = 13
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 选项状态 $为 标签
			文本 = "曲线：原生；阻止手势=假；纯滚动=假"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "开始=0；结束=0；请求=0"
			宽度 = 长度_匹配父级
			字体大小 = 13
		$结束 $定义
		$定义 阶段 $为 标签
			文本 = "头释放=0；尾释放=0；空闲"
			宽度 = 长度_匹配父级
			字体大小 = 12
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "触发后手动提交完成；固定栏保留在内容边缘。"
			宽度 = 长度_匹配父级
			字体大小 = 13
			底填充 = "8dp"
		$结束 $定义
		$定义 安全外观 $为 按钮
			文本 = "安全修改外观"
			宽度 = 长度_匹配父级
			高度 = "40dp"
			字体大小 = 13
		$结束 $定义
		$定义 刷新框 $为 simple.library.wsd.smartrefresh.SRL下拉刷新框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 内容 $为 面板
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				$定义 固定头 $为 标签
					文本 = "固定头：上拉时保持位置"
					宽度 = 长度_匹配父级
					字体大小 = 16
				$结束 $定义
				$定义 滚动区 $为 垂直滚动框
					宽度 = 长度_匹配父级
					高度 = 0
					权重 = 1
					$定义 正文 $为 标签
						宽度 = 长度_匹配父级
						文本 = ""
						字体大小 = 16
					$结束 $定义
				$结束 $定义
				$定义 固定尾 $为 标签
					文本 = "固定尾：下拉时保持位置"
					宽度 = 长度_匹配父级
					字体大小 = 16
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
