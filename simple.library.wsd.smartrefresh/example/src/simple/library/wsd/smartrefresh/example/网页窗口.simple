''' 以请求序号构成载入网址，只接收当前请求的网页完成或失败回调。
变量 来源 为 主窗口
变量 当前序号 为 整数型
变量 请求网址 为 文本型
变量 刷新次数 为 整数型

事件 网页窗口.初始化()
	网页.加载("file:///android_asset/index.html")
结束 事件

事件 刷新框.开始刷新(请求序号 为 整数型)
	当前序号 = 请求序号
	刷新次数 = 刷新次数 + 1
	状态.文本 = "网页刷新次数=" & 刷新次数
	请求网址 = "file:///android_asset/index.html?request=" & 请求序号
	反馈.文本 = "正在重新载入本地页面。"
	网页.加载(请求网址)
结束 事件

事件 网页.载入完毕(网址 为 文本型)
	如果 当前序号 > 0 且 网址 = 请求网址 则
		变量 结果 为 逻辑型
		结果 = 刷新框.完成刷新(当前序号, 真)
		反馈.文本 = "网页载入完成；请求=" & 当前序号 & "；受理=" & 结果
		当前序号 = 0
	结束 如果
结束 事件

事件 网页.载入失败(错误码 为 整数型, 网址 为 文本型)
	如果 当前序号 > 0 且 网址 = 请求网址 则
		变量 结果 为 逻辑型
		结果 = 刷新框.完成刷新(当前序号, 假)
		反馈.文本 = "网页载入失败；错误=" & 错误码 & "；受理=" & 结果
		当前序号 = 0
	结束 如果
结束 事件

事件 刷新框.操作取消(请求序号 为 整数型)
	当前序号 = 0
	请求网址 = ""
	反馈.文本 = "当前刷新已取消。"
结束 事件

事件 自动刷新.被单击()
	反馈.文本 = "刷新受理=" & 刷新框.触发刷新()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 网页窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 网页窗口.即将切换()
	刷新框.关闭头尾()
	当前序号 = 0
	请求网址 = ""
	网页.停止()
结束 事件

$属性
	$资源 $窗口
	$定义 网页窗口 $为 窗口
		标题 = "SRL下拉刷新框 · 本地网页"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 页头 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = "96dp"
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 标题 $为 标签
				文本 = "本地网页"
				宽度 = 0
				权重 = 1
				字体大小 = 20
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "页面随示例提供，无需联网；滚到网页顶部后可下拉刷新。"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
			底填充 = "8dp"
		$结束 $定义
		$定义 操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 自动刷新 $为 按钮
				文本 = "重新载入"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "网页刷新次数=0"
			宽度 = 长度_匹配父级
			字体大小 = 13
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "网页载入成功或失败后，提交对应刷新结果。"
			宽度 = 长度_匹配父级
			字体大小 = 13
			底填充 = "8dp"
		$结束 $定义
		$定义 刷新框 $为 simple.library.wsd.smartrefresh.SRL下拉刷新框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			允许上拉 = 假
			$定义 网页 $为 网页浏览框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
