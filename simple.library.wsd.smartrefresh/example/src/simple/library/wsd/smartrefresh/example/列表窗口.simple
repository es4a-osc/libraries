''' 列表直接作为内容；先确认完成结果被受理，再更新可见数据。
变量 来源 为 主窗口
变量 当前序号 为 整数型
变量 当前刷新 为 逻辑型
变量 刷新次数 为 整数型
变量 加载次数 为 整数型

事件 列表窗口.初始化()
	变量 索引 为 整数型
	循环 索引 = 1 至 30
		内容列表.添加项目("列表项目 " & 索引)
	下个 索引
结束 事件

事件 刷新框.开始刷新(请求序号 为 整数型)
	当前序号 = 请求序号
	当前刷新 = 真
	刷新次数 = 刷新次数 + 1
	业务计时.启用 = 真
	更新状态()
结束 事件

事件 刷新框.开始加载(请求序号 为 整数型)
	当前序号 = 请求序号
	当前刷新 = 假
	加载次数 = 加载次数 + 1
	业务计时.启用 = 真
	更新状态()
结束 事件

事件 业务计时.计时()
	业务计时.启用 = 假
	如果 当前序号 = 0 则 退出 事件
	变量 结果 为 逻辑型
	如果 当前刷新 则
		结果 = 刷新框.完成刷新(当前序号, 真)
		如果 结果 则 内容列表.置项目文本(0, "已刷新 " & 刷新次数 & " 次")
	否则
		结果 = 刷新框.完成加载(当前序号, 真, 假)
		如果 结果 则
			变量 索引 为 整数型
			循环 索引 = 1 至 5
				内容列表.添加项目("追加项目 " & (内容列表.取项目数() + 1))
			下个 索引
		结束 如果
	结束 如果
	反馈.文本 = "完成请求 #" & 当前序号 & "；受理=" & 结果
	当前序号 = 0
	更新状态()
结束 事件

过程 更新状态()
	状态.文本 = "刷新=" & 刷新次数 & "；加载=" & 加载次数 & "；项目=" & 内容列表.取项目数()
结束 过程

事件 刷新框.操作取消(请求序号 为 整数型)
	业务计时.启用 = 假
	当前序号 = 0
结束 事件

事件 内容列表.项目被单击(索引 为 整数型)
	反馈.文本 = "点击 #" & 索引 & "：" & 内容列表.取项目文本(索引)
结束 事件

事件 自动刷新.被单击()
	反馈.文本 = "刷新受理=" & 刷新框.触发刷新()
结束 事件

事件 自动加载.被单击()
	反馈.文本 = "加载受理=" & 刷新框.触发加载()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 列表窗口.即将切换()
	业务计时.启用 = 假
	刷新框.关闭头尾()
	当前序号 = 0
结束 事件

事件 列表窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 列表窗口.应用被销毁()
	业务计时.启用 = 假
结束 事件

事件 列表窗口.切换完毕()
	更新状态()
结束 事件

$属性
	$资源 $窗口
	$定义 列表窗口 $为 窗口
		标题 = "SRL下拉刷新框 · 原生列表"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 页头 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = "96dp"
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 标题 $为 标签
				文本 = "原生列表"
				宽度 = 0
				权重 = 1
				字体大小 = 20
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "列表直接作为刷新内容；在列表中间滑动时不会触发刷新。"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
			底填充 = "8dp"
		$结束 $定义
		$定义 操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 自动刷新 $为 按钮
				文本 = "自动刷新"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 自动加载 $为 按钮
				文本 = "自动加载"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "刷新=0；加载=0；项目=30"
			宽度 = 长度_匹配父级
			字体大小 = 13
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "约两秒后更新首项或追加五条。"
			宽度 = 长度_匹配父级
			字体大小 = 13
			底填充 = "8dp"
		$结束 $定义
		$定义 刷新框 $为 simple.library.wsd.smartrefresh.SRL下拉刷新框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 内容列表 $为 列表框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
			$结束 $定义
		$结束 $定义
		$定义 业务计时 $为 计时器
			间隔 = 1800
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
