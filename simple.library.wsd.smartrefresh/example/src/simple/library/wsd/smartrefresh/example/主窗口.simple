''' 首页只负责示例导航，每个演示窗口各自维护请求与生命周期。

变量 基础页面 为 基础窗口
变量 列表页面 为 列表窗口
变量 网页页面 为 网页窗口
变量 样式页面 为 样式窗口
变量 高级页面 为 高级窗口
变量 基础已创建 为 逻辑型
变量 列表已创建 为 逻辑型
变量 网页已创建 为 逻辑型
变量 样式已创建 为 逻辑型
变量 高级已创建 为 逻辑型

事件 基础演示.被单击()
	如果 取反 基础已创建 则
		基础页面 = 创建 基础窗口
		基础页面.来源 = 主窗口
		基础已创建 = 真
	结束 如果
	切换窗口(基础页面)
结束 事件

事件 列表演示.被单击()
	如果 取反 列表已创建 则
		列表页面 = 创建 列表窗口
		列表页面.来源 = 主窗口
		列表已创建 = 真
	结束 如果
	切换窗口(列表页面)
结束 事件

事件 网页演示.被单击()
	如果 取反 网页已创建 则
		网页页面 = 创建 网页窗口
		网页页面.来源 = 主窗口
		网页已创建 = 真
	结束 如果
	切换窗口(网页页面)
结束 事件

事件 样式演示.被单击()
	如果 取反 样式已创建 则
		样式页面 = 创建 样式窗口
		样式页面.来源 = 主窗口
		样式已创建 = 真
	结束 如果
	切换窗口(样式页面)
结束 事件

事件 高级演示.被单击()
	如果 取反 高级已创建 则
		高级页面 = 创建 高级窗口
		高级页面.来源 = 主窗口
		高级已创建 = 真
	结束 如果
	切换窗口(高级页面)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "智能刷新框 · 示例目录"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 标题 $为 标签
			文本 = "智能刷新框"
			宽度 = 长度_匹配父级
			字体大小 = 26
			文本颜色 = -15261645
			顶填充 = "12dp"
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "从基础刷新开始，按场景查看滚动内容与交互定制。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本颜色 = -10061944
			底填充 = "16dp"
		$结束 $定义
		$定义 基础演示分组 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 基础演示 $为 按钮
				文本 = "01  基础刷新与分页"
				宽度 = 长度_匹配父级
				高度 = "52dp"
				字体大小 = 16
			$结束 $定义
			$定义 基础演示说明 $为 标签
				文本 = "刷新、追加、失败、取消，以及自动完成和手动完成。"
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本颜色 = -10061944
				左填充 = "10dp"
				右填充 = "10dp"
				底填充 = "14dp"
			$结束 $定义
		$结束 $定义
		$定义 列表演示分组 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 列表演示 $为 按钮
				文本 = "02  原生列表"
				宽度 = 长度_匹配父级
				高度 = "52dp"
				字体大小 = 16
			$结束 $定义
			$定义 列表演示说明 $为 标签
				文本 = "列表直接作为刷新内容，更新首项或追加五条数据。"
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本颜色 = -10061944
				左填充 = "10dp"
				右填充 = "10dp"
				底填充 = "14dp"
			$结束 $定义
		$结束 $定义
		$定义 网页演示分组 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 网页演示 $为 按钮
				文本 = "03  本地网页"
				宽度 = 长度_匹配父级
				高度 = "52dp"
				字体大小 = 16
			$结束 $定义
			$定义 网页演示说明 $为 标签
				文本 = "由网页载入结果结束刷新；使用本地页面，无需联网。"
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本颜色 = -10061944
				左填充 = "10dp"
				右填充 = "10dp"
				底填充 = "14dp"
			$结束 $定义
		$结束 $定义
		$定义 样式演示分组 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 样式演示 $为 按钮
				文本 = "04  样式与内容定制"
				宽度 = 长度_匹配父级
				高度 = "52dp"
				字体大小 = 16
			$结束 $定义
			$定义 样式演示说明 $为 标签
				文本 = "浏览全部头尾样式，体验自定义组件、二楼和内容替换。"
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本颜色 = -10061944
				左填充 = "10dp"
				右填充 = "10dp"
				底填充 = "14dp"
			$结束 $定义
		$结束 $定义
		$定义 高级演示分组 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 高级演示 $为 按钮
				文本 = "05  动画与高级选项"
				宽度 = 长度_匹配父级
				高度 = "52dp"
				字体大小 = 16
			$结束 $定义
			$定义 高级演示说明 $为 标签
				文本 = "延时触发、仅动画、自定义边界、固定栏和回弹曲线。"
				宽度 = 长度_匹配父级
				字体大小 = 13
				文本颜色 = -10061944
				左填充 = "10dp"
				右填充 = "10dp"
				底填充 = "14dp"
			$结束 $定义
		$结束 $定义
		$定义 提示 $为 标签
			文本 = "演示数据保存在内存中；离开页面会取消当前操作。"
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本颜色 = -10061944
			顶填充 = "12dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
