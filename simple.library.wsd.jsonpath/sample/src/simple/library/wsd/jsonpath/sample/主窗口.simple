''' JSONPath 真实读写及错误自检；不联网，文档只在后台线程中使用。
别名 路径操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 文档类型 = simple.library.wsd.jsonpath.JSONPath文档
别名 结果类型 = simple.library.wsd.jsonpath.JSONPath结果

变量 忙碌 为 逻辑型
变量 操作 为 整数型
变量 路径文本 为 文本型
变量 检查数 为 整数型

''' 初始化结果提示；每次操作由后台任务创建独立文档。
事件 主窗口.初始化()
	结果.文本 = "已就绪。可查询、演示完整读写或运行全部自检。"
结束 事件

事件 查询示例.被单击()
	开始任务(1)
结束 事件

事件 读写示例.被单击()
	开始任务(2)
结束 事件

事件 全部自检.被单击()
	开始任务(3)
结束 事件

事件 执行查询.被单击()
	开始任务(4)
结束 事件

''' 读取界面参数后启动单个后台任务，任务期间拒绝重复进入。
过程 开始任务(种类 为 整数型)
	如果 忙碌 则 退出 过程
	操作 = 种类
	路径文本 = 路径输入.文本
	检查数 = 0
	忙碌 = 真
	置按钮状态(假)
	结果.文本 = "正在后台处理本地 JSON..."
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			置按钮状态(真)
			结果.文本 = "无法启动任务。"
	结束 错误
结束 过程

''' 统一切换操作按钮状态，避免任务尚未结束就再次执行。
过程 置按钮状态(启用 为 逻辑型)
	查询示例.启用 = 启用
	读写示例.启用 = 启用
	全部自检.启用 = 启用
	执行查询.启用 = 启用
结束 过程

''' 在后台完成查询、修改或自检，通过窗口消息回到界面线程。
过程 后台处理()
	变量 内容 为 文本型
	判断 操作
		分支 1
			内容 = 执行路径("$.books[?(@.price < 20)].name")
		分支 2
			内容 = 完整读写()
		分支 3
			内容 = 执行自检()
		分支 否则
			内容 = 执行路径(路径文本)
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 非法参数错误
			投递消息("失败", "JSON、表达式或目标类型无效；自检已通过 " & 检查数 & " 项。")
		分支 否则
			投递消息("失败", "处理失败，自检已通过 " & 检查数 & " 项；请查看运行日志。")
	结束 错误
结束 过程

''' 接收后台结果并恢复按钮；后台不直接修改界面组件。
事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙碌 = 假
	置按钮状态(真)
	结果.文本 = 附加参数
结束 事件

''' 提供包含对象、数组、标量、空数组和 null 的本地测试输入。
函数 初始数据() 为 文本型
	初始数据 = "{\"books\":[{\"name\":\"甲\",\"price\":10},{\"name\":\"乙\",\"price\":25},{\"name\":\"丙\",\"price\":15}],\"numbers\":[10,25,15],\"enabled\":true,\"empty\":[],\"nothing\":null}"
结束 函数

''' 先检查是否匹配，再序列化结果；缺失路径不显示为 null。
函数 执行路径(路径 为 文本型) 为 文本型
	变量 文档 为 文档类型
	变量 值 为 结果类型
	文档 = 路径操作.解析文本(初始数据())
	值 = 文档.查询(路径)
	如果 值.是否存在() 则
		执行路径 = "路径：" & 路径 & "\n结果：" & 值.到JSON文本()
	否则
		执行路径 = "路径：" & 路径 & "\n没有匹配。"
	结束 如果
结束 函数

''' 每一步都显示实际返回的处理数量，最后输出当前文档。
函数 完整读写() 为 文本型
	变量 文档 为 文档类型
	变量 内容 为 文本型
	变量 新值 为 结果类型
	文档 = 路径操作.解析文本(初始数据())
	内容 = "批量修改价格：" & 文档.修改整数("$.books[*].price", 20) & " 项\n"
	新值 = 路径操作.解析值("\"演示\"")
	内容 = 内容 & "新增属性：" & 文档.新增属性("$", "label", 新值) & " 项\n"
	新值 = 路径操作.解析值("{\"name\":\"丁\",\"price\":30}")
	内容 = 内容 & "添加书籍：" & 文档.添加成员("$.books", 新值) & " 项\n"
	内容 = 内容 & "重命名属性：" & 文档.重命名属性("$.books[*]", "name", "title") & " 项\n"
	内容 = 内容 & "删除价格大于20的书：" & 文档.删除("$.books[?(@.price > 20)]") & " 项\n\n"
	完整读写 = 内容 & 文档.到JSON文本()
结束 函数

''' 断言通过后才累计数量，失败时保留已通过的检查数。
过程 检查(条件 为 逻辑型)
	断言真(条件)
	检查数 = 检查数 + 1
结束 过程

''' 覆盖 JSON 类型、表达式、增删改、快照、互通与事务失败后的恢复。
函数 执行自检() 为 文本型
	变量 文档 为 文档类型
	变量 副本 为 文档类型
	变量 值 为 结果类型
	变量 成员 为 结果类型
	变量 新值 为 结果类型
	变量 原生 为 JSON值
	变量 路径们 为 文本型()
	变量 前文 为 文本型
	变量 编号 为 整数型
	文档 = 路径操作.解析文本(初始数据())
	''' 查询与类型：覆盖选择器组合、数值聚合和 null/缺失的区别。
	值 = 文档.查询("$.books[0].name")
	检查(值.取文本() = "甲")
	检查(值.取类型() = 结果类型.类型_文本)
	值 = 文档.查询("$.books[-1].name")
	检查(值.取文本() = "丙")
	值 = 文档.查询("$.books[0,2].name")
	检查(值.取成员数() = 2)
	值 = 文档.查询("$.books[:2]")
	检查(值.取成员数() = 2)
	值 = 文档.查询("$..price")
	检查(值.取成员数() = 3)
	值 = 文档.查询("$.books[?(@.price < 20)].name")
	检查(值.取成员数() = 2)
	成员 = 值.取成员(1)
	检查(成员.取文本() = "丙")
	值 = 文档.查询("$.books.length()")
	检查(值.取长整数() = 3)
	值 = 文档.查询("$.numbers.sum()")
	检查(值.取小数() = 50)
	值 = 文档.查询("$.enabled")
	检查(值.取逻辑())
	检查(值.取类型() = 结果类型.类型_逻辑)
	值 = 文档.查询("$.nothing")
	检查(值.是否存在())
	检查(值.取类型() = 结果类型.类型_空)
	检查(值.到JSON文本() = "null")
	值 = 文档.查询("$.missing")
	检查(取反 值.是否存在())
	检查(值.取类型() = 结果类型.类型_未匹配)
	值 = 文档.查询("$.empty")
	检查(值.是否存在())
	检查(值.取成员数() = 0)
	值 = 文档.查询("$.books[?(@.price > 100)]")
	检查(取反 值.是否存在())
	路径们 = 文档.查询路径("$.books[*].price")
	检查(取数组成员数(路径们) = 3)
	检查(文档.是否存在("$.nothing"))
	检查(取反 文档.是否存在("$.absent"))

	''' 查询结果和复制文档均不随后续修改变化。
	值 = 文档.查询("$.books[0]")
	副本 = 文档.复制()
	检查(文档.修改整数("$.books[*].price", 20) = 3)
	原生 = 值.到JSON值()
	检查(原生.取整数("price") = 10)
	成员 = 副本.查询("$.books[0].price")
	检查(成员.取长整数() = 10)
	检查(文档.修改文本("$.books[0].name", "新书") = 1)
	检查(文档.修改小数("$.books[0].price", 12.5) = 1)
	检查(文档.修改逻辑("$.enabled", 假) = 1)
	检查(文档.修改空("$.books[1].price") = 1)
	成员 = 文档.查询("$.books[1].price")
	检查(成员.取类型() = 结果类型.类型_空)
	新值 = 路径操作.解析值("{\"x\":1}")
	检查(文档.新增属性("$", "extra", 新值) = 1)
	新值 = 路径操作.解析值("{\"name\":\"丁\",\"price\":30}")
	检查(文档.添加成员("$.books", 新值) = 1)
	检查(文档.重命名属性("$.books[*]", "name", "title") = 4)
	检查(文档.删除("$.books[?(@.price > 25)]") = 1)
	检查(文档.删除("$.missing") = 0)
	检查(文档.修改整数("$.missing", 1) = 0)
	值 = 文档.查询("$.books")
	检查(值.取成员数() = 3)
	值 = 文档.查询("$.books[0].title")
	检查(值.取文本() = "新书")
	检查(取反 文档.是否存在("$.books[0].name"))
	原生 = 文档.到JSON值()
	副本 = 路径操作.载入JSON值(原生)
	检查(副本.修改逻辑("$.enabled", 真) = 1)
	检查(取反 原生.取逻辑("enabled"))
	检查(文档.修改JSON值("$.extra", 原生) = 1)

	''' 标量根、引号转义、精确整数、整体替换及数组删除索引。
	文档 = 路径操作.解析文本("null")
	值 = 文档.查询("$")
	检查(值.是否存在())
	检查(值.取类型() = 结果类型.类型_空)
	检查(文档.修改整数("$", 7) = 1)
	值 = 文档.查询("$")
	检查(值.取长整数() = 7)
	新值 = 路径操作.解析值("[1,2,3,4]")
	检查(文档.修改("$", 新值) = 1)
	检查(文档.删除("$[0,2]") = 2)
	检查(文档.到JSON文本() = "[2,4]")
	值 = 路径操作.解析值("9223372036854775807")
	检查(值.取长整数() = 9223372036854775807)
	新值 = 路径操作.解析值("\"a\\\"b\"")
	检查(新值.取文本() = "a\"b")
	文档 = 路径操作.解析文本("{\"odd.key\":1}")
	值 = 文档.查询("$['odd.key']")
	检查(值.取长整数() = 1)
	检查(期望错误(10))

	循环 编号 = 1 至 9
		检查(期望错误(编号))
	下个 编号
	执行自检 = "全部自检通过：" & 检查数 & " 项。\n覆盖查询、批量修改、新增、删除、重命名、JSON互通和失败回滚。"
结束 函数

''' 只接受预期的非法参数错误，并核对失败后的文档与操作前完全一致。
函数 期望错误(编号 为 整数型) 为 逻辑型
	变量 文档 为 文档类型
	变量 值 为 结果类型
	变量 新值 为 结果类型
	变量 前文 为 文本型
	文档 = 路径操作.解析文本("{\"items\":[{},1],\"a\":1,\"b\":2}")
	前文 = 文档.到JSON文本()
	新值 = 路径操作.解析值("3")
	判断 编号
		分支 1
			文档.查询("$[")
		分支 2
			路径操作.解析文本("{broken}")
		分支 3
			文档.新增属性("$.items[*]", "x", 新值)
		分支 4
			文档.添加成员("$.a", 新值)
		分支 5
			文档.重命名属性("$", "a", "b")
		分支 6
			文档.删除("$")
		分支 7
			值 = 路径操作.解析值("1.5")
			值.取长整数()
		分支 8
			值 = 文档.查询("$.missing")
			文档.修改("$.a", 值)
		分支 9
			文档.查询(" ")
		分支 10
			文档.新增属性("$", "", 新值)
	结束 判断
	位于 错误
		分支 非法参数错误
			期望错误 = 文档.到JSON文本() = 前文
	结束 错误
结束 函数

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "JSONPath操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "JSONPath 查询与完整读写；所有操作在后台执行。"
		$结束 $定义
		$定义 查询示例 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "查询示例"
		$结束 $定义
		$定义 读写示例 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "完整读写演示"
		$结束 $定义
		$定义 全部自检 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "执行全部自检"
		$结束 $定义
		$定义 路径输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "$.books[*].name"
		$结束 $定义
		$定义 执行查询 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "执行路径查询"
		$结束 $定义
		$定义 结果滚动框 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 结果 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 14
				文本 = "等待操作。"
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
