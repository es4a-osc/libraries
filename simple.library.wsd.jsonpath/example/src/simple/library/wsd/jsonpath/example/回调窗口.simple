别名 JSONPath操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 JSONPath文档 = simple.library.wsd.jsonpath.JSONPath文档
别名 JSONPath结果 = simple.library.wsd.jsonpath.JSONPath结果

变量 来源 为 主窗口
变量 文档 为 JSONPath文档
变量 初始文本 为 文本型

过程 载入(文本 为 文本型)
	初始文本 = 文本
	文档 = JSONPath操作.解析文本(文本)
	预览.文本 = 文档.到JSON文本()
结束 过程

事件 加价.被单击()
	变量 转换器 为 加价映射
	转换器 = 创建 加价映射
	变量 数量 为 整数型
	数量 = 文档.映射("$.books[*].price", 转换器)
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "按每本当前价格加 5，共处理 " & 数量 & " 个节点。"
结束 事件

事件 摘要.被单击()
	变量 访问器 为 书名摘要
	访问器 = 创建 书名摘要
	访问器.上限 = 100
	变量 次数 为 整数型
	次数 = 文档.访问("$.books[*].title", 访问器)
	输出.文本 = 访问器.内容 & "\n共访问 " & 次数 & " 项。"
结束 事件

事件 提前.被单击()
	变量 访问器 为 书名摘要
	访问器 = 创建 书名摘要
	访问器.上限 = 2
	变量 次数 为 整数型
	次数 = 文档.访问("$.books[*].title", 访问器)
	输出.文本 = 访问器.内容 & "\n访问器返回假，停在第 " & 次数 & " 项。"
结束 事件

事件 重置.被单击()
	载入(初始文本)
	输出.文本 = "书单已重置。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 回调窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 回调窗口 $为 窗口
		标题 = "4. 映射与访问"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "34dp"
			文本 = "4. 映射与访问"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "62dp"
			文本 = "加价映射和书名摘要是两个实现接口的对象。回调拿到独立快照；可查询，但不能重入修改或访问当前文档。"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "110dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 加价 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "按当前值给每本书加价 5"
				$结束 $定义
				$定义 摘要 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "逐项汇总书名"
				$结束 $定义
				$定义 提前 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "只访问前两本书"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "重置书单"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
