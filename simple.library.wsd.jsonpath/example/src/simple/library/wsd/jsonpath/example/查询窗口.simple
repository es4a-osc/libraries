别名 JSONPath操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 JSONPath文档 = simple.library.wsd.jsonpath.JSONPath文档
别名 JSONPath结果 = simple.library.wsd.jsonpath.JSONPath结果

变量 来源 为 主窗口
变量 文档 为 JSONPath文档
变量 初始文本 为 文本型

过程 载入(文本 为 文本型)
	初始文本 = 文本
	文档 = JSONPath操作.解析文本(文本)
	预览.文本 = 文档.到JSON文本()
结束 过程

事件 查询.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.查询(输入.文本)
	如果 结果.是否存在() 则
		输出.文本 = 结果.到JSON文本()
	否则
		输出.文本 = "没有匹配，请调整路径。"
	结束 如果
	位于 错误
		分支 非法参数错误
			输出.文本 = "路径或查询无效，请检查表达式。"
	结束 错误
结束 事件

事件 首本.被单击()
	变量 书单 为 JSONPath结果
	变量 书 为 JSONPath结果
	变量 标题 为 JSONPath结果
	书单 = 文档.查询("$.books[*]")
	书 = 书单.取成员(0)
	标题 = 文档.查询("$.books[0].title")
	输出.文本 = "书名：" & 标题.取文本() & "；共 " & 书单.取成员数() & " 本\n首本：" & 书.到JSON文本()
结束 事件

事件 合计.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.查询("$.sum($.books[*].price)")
	输出.文本 = "总价：" & 结果.取小数()
结束 事件

事件 属性名按钮.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.查询("$.books[0].keys()")
	输出.文本 = "首本书的属性：" & 结果.到JSON文本()
结束 事件

事件 计算.被单击()
	变量 价格集 为 JSONPath结果
	价格集 = 文档.查询("$.books[*].price")
	变量 价格文档 为 JSONPath文档
	价格文档 = JSONPath操作.解析文本(价格集.到JSON文本())
	变量 结果 为 JSONPath结果
	结果 = 价格文档.查询("$.append(99)")
	输出.文本 = "计算结果：" & 结果.到JSON文本() & "\n原价格数组：" & 价格文档.到JSON文本()
结束 事件

事件 重置.被单击()
	载入(初始文本)
	输出.文本 = "书单已重置。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 查询窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 查询窗口 $为 窗口
		标题 = "1. 查询书单"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "34dp"
			文本 = "1. 查询书单"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "62dp"
			文本 = "路径从 $ 开始，索引从 0 开始。可改输入尝试 $.books[0].title 或价格过滤。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "$.books[?(@.price < 30)].title"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "110dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 查询 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "运行输入路径"
				$结束 $定义
				$定义 首本 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "读取首本与成员数"
				$结束 $定义
				$定义 合计 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "计算书单总价"
				$结束 $定义
				$定义 属性名按钮 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "读取首本属性名"
				$结束 $定义
				$定义 计算 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "计算追加，不修改书单"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "重置书单"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
