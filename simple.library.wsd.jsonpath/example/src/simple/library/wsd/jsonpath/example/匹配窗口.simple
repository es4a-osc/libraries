别名 JSONPath操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 JSONPath文档 = simple.library.wsd.jsonpath.JSONPath文档
别名 JSONPath结果 = simple.library.wsd.jsonpath.JSONPath结果

变量 来源 为 主窗口
变量 文档 为 JSONPath文档
变量 初始文本 为 文本型

过程 载入(文本 为 文本型)
	初始文本 = 文本
	文档 = JSONPath操作.解析文本(文本)
	预览.文本 = 文档.到JSON文本()
结束 过程

事件 状态.被单击()
	输出.文本 = "note 存在：" & 文档.是否存在("$.note") & "\nmissing 存在：" & 文档.是否存在("$.missing")
结束 事件

事件 路径.被单击()
	变量 路径集 为 文本型()
	路径集 = 文档.查询路径("$.books[?(@.stock == true)].title")
	输出.文本 = 路径集(0) & "\n" & 路径集(1)
结束 事件

事件 限量.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.查询前几项("$.books[*].title", 2)
	输出.文本 = "前两项：" & 结果.到JSON文本()
结束 事件

事件 数组.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.按选项查询("$.books[0].title", JSONPath操作.选项_总是数组)
	输出.文本 = 结果.到JSON文本()
结束 事件

事件 默认值.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.按选项查询("$.missing", JSONPath操作.选项_缺失叶子为空)
	输出.文本 = "默认结果可读取：" & 结果.是否存在() & "；值：" & 结果.到JSON文本() & "\n原节点存在：" & 文档.是否存在("$.missing")
结束 事件

事件 组合.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.按选项查询("$.missing.child", JSONPath操作.选项_总是数组 或 JSONPath操作.选项_抑制求值错误)
	输出.文本 = "缺失时默认空数组：" & 结果.到JSON文本()
结束 事件

事件 要求.被单击()
	变量 结果 为 JSONPath结果
	结果 = 文档.按选项查询("$.books[*].author", JSONPath操作.选项_要求属性)
	输出.文本 = 结果.到JSON文本()
	位于 错误
		分支 非法参数错误
			输出.文本 = "书单没有 author 属性，要求属性选项报告错误。"
	结束 错误
结束 事件

事件 重置.被单击()
	载入(初始文本)
	输出.文本 = "书单已重置。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 匹配窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 匹配窗口 $为 窗口
		标题 = "2. 匹配与选项"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "34dp"
			文本 = "2. 匹配与选项"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "62dp"
			文本 = "默认查询区分缺失与 null；按选项查询的默认值也可读取。选项常量可以按位组合。"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "110dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 状态 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "区分 null 与缺失"
				$结束 $定义
				$定义 路径 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "取得有货书名的具体路径"
				$结束 $定义
				$定义 限量 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "只查询前两项"
				$结束 $定义
				$定义 数组 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "确定路径也返回数组"
				$结束 $定义
				$定义 默认值 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "缺失叶子返回 null"
				$结束 $定义
				$定义 组合 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "组合数组与抑制错误选项"
				$结束 $定义
				$定义 要求 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "要求每本书具有 author 属性"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "重置书单"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
