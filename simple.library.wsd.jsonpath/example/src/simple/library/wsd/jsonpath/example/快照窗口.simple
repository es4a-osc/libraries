别名 JSONPath操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 JSONPath文档 = simple.library.wsd.jsonpath.JSONPath文档
别名 JSONPath结果 = simple.library.wsd.jsonpath.JSONPath结果

变量 来源 为 主窗口
变量 文档 为 JSONPath文档
变量 初始文本 为 文本型

过程 载入(文本 为 文本型)
	初始文本 = 文本
	文档 = JSONPath操作.解析文本(文本)
	预览.文本 = 文档.到JSON文本()
结束 过程

事件 结果快照.被单击()
	变量 之前 为 JSONPath结果
	之前 = 文档.查询("$.books[0].price")
	文档.修改整数("$.books[0].price", 99)
	变量 当前 为 JSONPath结果
	当前 = 文档.查询("$.books[0].price")
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "旧快照：" & 之前.取小数() & "；当前：" & 当前.取小数()
结束 事件

事件 文档副本.被单击()
	变量 副本 为 JSONPath文档
	副本 = 文档.复制()
	副本.修改文本("$.books[0].title", "副本改名")
	输出.文本 = "副本：" & 副本.到JSON文本() & "\n原书单未改：" & 文档.到JSON文本()
结束 事件

事件 互转.被单击()
	变量 原值 为 JSON值
	原值 = 创建 JSON值
	原值.创建对象()
	原值.置文本("name", "小明")
	变量 新文档 为 JSONPath文档
	新文档 = JSONPath操作.载入JSON值(原值)
	原值.置文本("name", "原值已修改")
	变量 导出 为 JSON值
	导出 = 新文档.到JSON值()
	导出.置文本("name", "导出值已修改")
	输出.文本 = "独立文档：" & 新文档.到JSON文本() & "\n原值：" & 原值.到文本() & "\n导出：" & 导出.到文本()
结束 事件

事件 重置.被单击()
	载入(初始文本)
	输出.文本 = "书单已重置。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 快照窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 快照窗口 $为 窗口
		标题 = "5. 快照与互转"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "34dp"
			文本 = "5. 快照与互转"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "62dp"
			文本 = "查询结果、文档副本及 JSON值 互不共享修改。运行库互转仅支持对象和数组根。"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "110dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 结果快照 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "修改文档，保留旧查询结果"
				$结束 $定义
				$定义 文档副本 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "只修改复制出的书单"
				$结束 $定义
				$定义 互转 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "运行库 JSON值 双向复制"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "重置书单"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
