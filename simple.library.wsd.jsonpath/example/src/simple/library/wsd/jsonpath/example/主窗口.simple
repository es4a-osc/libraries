别名 JSONPath操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 JSONPath文档 = simple.library.wsd.jsonpath.JSONPath文档
别名 JSONPath结果 = simple.library.wsd.jsonpath.JSONPath结果

' 主窗口只作入口，各主题窗口首次打开时创建，保留演示状态。
变量 页面0 为 查询窗口
变量 已创建0 为 逻辑型
事件 入口0.被单击()
	如果 取反 已创建0 则
		页面0 = 创建 查询窗口
		页面0.来源 = 主窗口
		页面0.载入("{\"books\":[{\"title\":\"入门\",\"price\":18,\"stock\":true},{\"title\":\"进阶\",\"price\":32,\"stock\":false},{\"title\":\"图解\",\"price\":25,\"stock\":true}],\"note\":null}")
		已创建0 = 真
	结束 如果
	切换窗口(页面0)
结束 事件

变量 页面1 为 匹配窗口
变量 已创建1 为 逻辑型
事件 入口1.被单击()
	如果 取反 已创建1 则
		页面1 = 创建 匹配窗口
		页面1.来源 = 主窗口
		页面1.载入("{\"books\":[{\"title\":\"入门\",\"price\":18,\"stock\":true},{\"title\":\"进阶\",\"price\":32,\"stock\":false},{\"title\":\"图解\",\"price\":25,\"stock\":true}],\"note\":null}")
		已创建1 = 真
	结束 如果
	切换窗口(页面1)
结束 事件

变量 页面2 为 修改窗口
变量 已创建2 为 逻辑型
事件 入口2.被单击()
	如果 取反 已创建2 则
		页面2 = 创建 修改窗口
		页面2.来源 = 主窗口
		页面2.载入("{\"books\":[{\"title\":\"入门\",\"price\":18,\"stock\":true},{\"title\":\"进阶\",\"price\":32,\"stock\":false},{\"title\":\"图解\",\"price\":25,\"stock\":true}],\"note\":null}")
		已创建2 = 真
	结束 如果
	切换窗口(页面2)
结束 事件

变量 页面3 为 回调窗口
变量 已创建3 为 逻辑型
事件 入口3.被单击()
	如果 取反 已创建3 则
		页面3 = 创建 回调窗口
		页面3.来源 = 主窗口
		页面3.载入("{\"books\":[{\"title\":\"入门\",\"price\":18,\"stock\":true},{\"title\":\"进阶\",\"price\":32,\"stock\":false},{\"title\":\"图解\",\"price\":25,\"stock\":true}],\"note\":null}")
		已创建3 = 真
	结束 如果
	切换窗口(页面3)
结束 事件

变量 页面4 为 快照窗口
变量 已创建4 为 逻辑型
事件 入口4.被单击()
	如果 取反 已创建4 则
		页面4 = 创建 快照窗口
		页面4.来源 = 主窗口
		页面4.载入("{\"books\":[{\"title\":\"入门\",\"price\":18,\"stock\":true},{\"title\":\"进阶\",\"price\":32,\"stock\":false},{\"title\":\"图解\",\"price\":25,\"stock\":true}],\"note\":null}")
		已创建4 = 真
	结束 如果
	切换窗口(页面4)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "JSONPath 示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = -1
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "JSONPath 示例"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "从书单开始学习。每页按钮直接调用一个 API；小数据同步演示，大文档或复杂过滤请在后台串行处理。"
		$结束 $定义
		$定义 入口0 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "1. 查询书单"
		$结束 $定义
		$定义 简介0 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "价格过滤、取成员、求和与函数计算"
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "2. 匹配与选项"
		$结束 $定义
		$定义 简介1 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "区分 null 和缺失、路径、限量与选项组合"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "3. 修改书单"
		$结束 $定义
		$定义 简介2 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "替换、追加、属性、重命名与删除"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "4. 映射与访问"
		$结束 $定义
		$定义 简介3 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "按当前值加价，逐项收集摘要或提前停止"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "5. 快照与互转"
		$结束 $定义
		$定义 简介4 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "文档复制、结果快照及运行库 JSON值"
		$结束 $定义
	$结束 $定义
$结束 $属性
