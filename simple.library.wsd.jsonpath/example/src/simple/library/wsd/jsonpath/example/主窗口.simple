''' 查询写法参考 Jayway JsonPath 官方书店示例：https://github.com/json-path/JsonPath
''' 使用当前封装 API；JSON 对象仅在本次后台任务内使用，不跨线程共享。
别名 路径操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 文档类型 = simple.library.wsd.jsonpath.JSONPath文档
别名 结果类型 = simple.library.wsd.jsonpath.JSONPath结果

变量 当前JSON 为 文本型
变量 工作JSON 为 文本型
变量 返回JSON 为 文本型
变量 工作路径 为 文本型
变量 忙碌 为 逻辑型
变量 操作编号 为 整数型
变量 预设编号 为 整数型

事件 主窗口.初始化()
	当前JSON = 初始JSON()
	文档显示.文本 = 当前JSON
结束 事件

函数 初始JSON() 为 文本型
	初始JSON = "{\"books\":[{\"name\":\"甲\",\"price\":10},{\"name\":\"乙\",\"price\":25},{\"name\":\"丙😀\",\"price\":15}],\"numbers\":[10,25,15],\"enabled\":true,\"nothing\":null,\"empty\":[],\"mixed\":[{},1]}"
结束 函数

事件 执行查询.被单击()
	开始处理(1)
结束 事件

''' 轮换确定路径、过滤、null、缺失、空数组、聚合和错误表达式。
事件 切换路径.被单击()
	预设编号 = 预设编号 + 1
	判断 预设编号
		分支 1
			路径输入.文本 = "$.books[?(@.price < 20)].name"
		分支 2
			路径输入.文本 = "$.nothing"
		分支 3
			路径输入.文本 = "$.missing"
		分支 4
			路径输入.文本 = "$.empty"
		分支 5
			路径输入.文本 = "$.numbers.sum()"
		分支 6
			路径输入.文本 = "$["
		分支 否则
			路径输入.文本 = "$.books[*].name"
			预设编号 = 0
	结束 判断
	输出.文本 = "已切换路径，点“查询”查看实际结果；也可直接编辑路径。"
结束 事件

事件 批量价格.被单击()
	开始处理(2)
结束 事件
事件 添加书籍.被单击()
	开始处理(3)
结束 事件
事件 新增标记.被单击()
	开始处理(4)
结束 事件
事件 重命名.被单击()
	开始处理(5)
结束 事件
事件 删除高价.被单击()
	开始处理(6)
结束 事件
事件 快照演示.被单击()
	开始处理(7)
结束 事件
事件 失败演示.被单击()
	开始处理(8)
结束 事件
事件 恢复数据.被单击()
	开始处理(0)
结束 事件

''' 界面只保存 JSON 文本；每次任务新建文档，返回序列化结果后再接收下一操作。
过程 开始处理(编号 为 整数型)
	如果 忙碌 则 退出 过程
	忙碌 = 真
	操作编号 = 编号
	工作JSON = 当前JSON
	返回JSON = 当前JSON
	工作路径 = 路径输入.文本
	置操作状态(假)
	输出.文本 = "正在后台处理本地 JSON..."
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			置操作状态(真)
			输出.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

过程 置操作状态(可用 为 逻辑型)
	执行查询.启用 = 可用
	切换路径.启用 = 可用
	路径输入.启用 = 可用
	批量价格.启用 = 可用
	添加书籍.启用 = 可用
	新增标记.启用 = 可用
	重命名.启用 = 可用
	删除高价.启用 = 可用
	快照演示.启用 = 可用
	失败演示.启用 = 可用
	恢复数据.启用 = 可用
结束 过程

过程 后台处理()
	变量 文档 为 文档类型
	变量 值 为 结果类型
	变量 原生 为 JSON值
	变量 复制文档 为 文档类型
	变量 内容 为 文本型
	文档 = 路径操作.解析文本(工作JSON)
	判断 操作编号
		分支 0
			文档 = 路径操作.解析文本(初始JSON())
			内容 = "已恢复初始数据。"
		分支 1
			值 = 文档.查询(工作路径)
			内容 = "路径：" & 工作路径 & "\n存在=" & 值.是否存在() & "；类型=" & 类型名称(值.取类型())
			如果 值.是否存在() 则 内容 = 内容 & "\nJSON：" & 值.到JSON文本()
			如果 值.取类型() = 结果类型.类型_数组 则
				内容 = 内容 & "\n成员数=" & 值.取成员数()
				如果 值.取成员数() > 0 则
					值 = 值.取成员(0)
					内容 = 内容 & "；首项=" & 值.到JSON文本()
				结束 如果
			结束 如果
		分支 2
			内容 = "批量设价格为 20：处理 " & 文档.修改整数("$.books[*].price", 20) & " 项。"
		分支 3
			值 = 路径操作.解析值("{\"name\":\"新书😀\",\"price\":30}")
			内容 = "追加新书：处理 " & 文档.添加成员("$.books", 值) & " 个数组。"
		分支 4
			值 = 路径操作.解析值("\"我的书单\"")
			内容 = "新增或覆盖 label 属性：处理 " & 文档.新增属性("$", "label", 值) & " 个对象。"
		分支 5
			内容 = "将 name 改名为 title：处理 " & 文档.重命名属性("$.books[*]", "name", "title") & " 个对象。"
		分支 6
			内容 = "删除价格 >20 的书：实际删除 " & 文档.删除("$.books[?(@.price > 20)]") & " 项。"
		分支 7
			''' 在副本中修改 enabled；原文档和之前取得的快照保持独立。
			原生 = 文档.到JSON值()
			复制文档 = 路径操作.载入JSON值(原生)
			值 = 复制文档.查询("$.enabled")
			复制文档.修改逻辑("$.enabled", 假)
			内容 = "修改前的结果快照 enabled=" & 值.取逻辑() & "；运行库 JSON值=" & 原生.取逻辑("enabled")
			值 = 复制文档.查询("$.enabled")
			内容 = 内容 & "\n副本文档 enabled=" & 值.取逻辑() & "；原文档保持不变。"
		分支 8
			内容 = 演示失败保护(文档)
	结束 判断
	返回JSON = 文档.到JSON文本()
	投递消息("完成", 内容)
	位于 错误
		分支 非法参数错误
			投递消息("失败", "表达式或目标类型无效；当前文档保留。请检查路径和数据结构。")
		分支 否则
			投递消息("失败", "操作失败；当前文档保留。可查看运行日志。")
	结束 错误
结束 过程

''' mixed 同时含对象和数字，给所有成员加属性会失败；显示实际前后比较。
函数 演示失败保护(文档 为 文档类型) 为 文本型
	变量 前文 为 文本型
	变量 值 为 结果类型
	前文 = 文档.到JSON文本()
	值 = 路径操作.解析值("1")
	文档.新增属性("$.mixed[*]", "note", 值)
	演示失败保护 = "操作已完成；请核对 mixed 当前结构。"
	位于 错误
		分支 非法参数错误
			演示失败保护 = "mixed 含数字，不能批量添加属性。\n失败后文档与操作前一致=" & (文档.到JSON文本() = 前文)
	结束 错误
结束 函数

函数 类型名称(种类 为 整数型) 为 文本型
	判断 种类
		分支 结果类型.类型_空
			类型名称 = "null"
		分支 结果类型.类型_对象
			类型名称 = "对象"
		分支 结果类型.类型_数组
			类型名称 = "数组"
		分支 结果类型.类型_文本
			类型名称 = "文本"
		分支 结果类型.类型_数值
			类型名称 = "数值"
		分支 结果类型.类型_逻辑
			类型名称 = "逻辑"
		分支 否则
			类型名称 = "未匹配"
	结束 判断
结束 函数

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	如果 消息标记 = "完成" 则 当前JSON = 返回JSON
	文档显示.文本 = 当前JSON
	输出.文本 = 附加参数
	忙碌 = 假
	置操作状态(真)
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 取反 忙碌 则 终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "JSONPath 使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "查询并编辑书单"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "索引从 0 开始；先查是否存在，再按类型读取。修改作用于当前书单，点恢复可重新开始。"
		$结束 $定义
		$定义 路径输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "$.books[*].name"
			提示文本 = "输入 JSONPath 路径"
		$结束 $定义
		$定义 查询区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 执行查询 $为 按钮
				宽度 = "210dp"
				文本 = "查询"
			$结束 $定义
			$定义 切换路径 $为 按钮
				宽度 = "210dp"
				文本 = "切换预设路径"
			$结束 $定义
		$结束 $定义
		$定义 操作区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 批量价格 $为 按钮
				宽度 = "210dp"
				文本 = "批量价格设为20"
			$结束 $定义
			$定义 添加书籍 $为 按钮
				宽度 = "210dp"
				文本 = "追加一本书"
			$结束 $定义
		$结束 $定义
		$定义 结构操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 新增标记 $为 按钮
				宽度 = "210dp"
				文本 = "新增书单标记"
			$结束 $定义
			$定义 重命名 $为 按钮
				宽度 = "210dp"
				文本 = "name 改为 title"
			$结束 $定义
		$结束 $定义
		$定义 维护操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除高价 $为 按钮
				宽度 = "210dp"
				文本 = "删除价格大于20"
			$结束 $定义
			$定义 恢复数据 $为 按钮
				宽度 = "210dp"
				文本 = "恢复初始书单"
			$结束 $定义
		$结束 $定义
		$定义 边界演示 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 快照演示 $为 按钮
				宽度 = "210dp"
				文本 = "副本与 JSON 互通"
			$结束 $定义
			$定义 失败演示 $为 按钮
				宽度 = "210dp"
				文本 = "失败保护演示"
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "输入路径后点查询；下方显示当前完整文档。"
		$结束 $定义
		$定义 文档标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "当前文档（仅在内存中修改）"
			字体加粗 = 真
		$结束 $定义
		$定义 文档显示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = ""
		$结束 $定义
		$定义 线程说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "所有操作在后台串行执行，文档对象只属于当前任务；无网络或文件权限要求。"
		$结束 $定义
	$结束 $定义
$结束 $属性
