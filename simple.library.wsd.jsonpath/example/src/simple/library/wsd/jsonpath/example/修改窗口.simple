别名 JSONPath操作 = simple.library.wsd.jsonpath.JSONPath操作
别名 JSONPath文档 = simple.library.wsd.jsonpath.JSONPath文档
别名 JSONPath结果 = simple.library.wsd.jsonpath.JSONPath结果

变量 来源 为 主窗口
变量 文档 为 JSONPath文档
变量 初始文本 为 文本型

过程 载入(文本 为 文本型)
	初始文本 = 文本
	文档 = JSONPath操作.解析文本(文本)
	预览.文本 = 文档.到JSON文本()
结束 过程

事件 改价.被单击()
	变量 数量 为 整数型
	数量 = 文档.修改小数("$.books[0].price", 20.0)
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "处理节点数：" & 数量
	位于 错误
		分支 非法参数错误
			输出.文本 = "当前书单不满足此操作条件，可重置后重试。"
	结束 错误
结束 事件

事件 追加.被单击()
	变量 数量 为 整数型
	数量 = 文档.添加成员("$.books", JSONPath操作.解析值("{\"title\":\"实战\",\"price\":40,\"stock\":true}"))
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "处理节点数：" & 数量
	位于 错误
		分支 非法参数错误
			输出.文本 = "当前书单不满足此操作条件，可重置后重试。"
	结束 错误
结束 事件

事件 新增.被单击()
	变量 数量 为 整数型
	数量 = 文档.新增属性("$.books[*]", "featured", JSONPath操作.解析值("true"))
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "处理节点数：" & 数量
	位于 错误
		分支 非法参数错误
			输出.文本 = "当前书单不满足此操作条件，可重置后重试。"
	结束 错误
结束 事件

事件 改名.被单击()
	变量 数量 为 整数型
	数量 = 文档.重命名属性("$.books[0]", "title", "name")
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "处理节点数：" & 数量
	位于 错误
		分支 非法参数错误
			输出.文本 = "当前书单不满足此操作条件，可重置后重试。"
	结束 错误
结束 事件

事件 删除.被单击()
	变量 数量 为 整数型
	数量 = 文档.删除("$.books[?(@.price > 30)]")
	预览.文本 = 文档.到JSON文本()
	输出.文本 = "处理节点数：" & 数量
	位于 错误
		分支 非法参数错误
			输出.文本 = "当前书单不满足此操作条件，可重置后重试。"
	结束 错误
结束 事件

事件 重置.被单击()
	载入(初始文本)
	输出.文本 = "书单已重置。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 修改窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 修改窗口 $为 窗口
		标题 = "3. 修改书单"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "34dp"
			文本 = "3. 修改书单"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "62dp"
			文本 = "修改成功后更新上方书单。失败不提交部分结果；改名后可重置恢复原字段。"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "110dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 改价 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "首本改价为 20"
				$结束 $定义
				$定义 追加 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "追加一本新书"
				$结束 $定义
				$定义 新增 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "给每本书添加推荐属性"
				$结束 $定义
				$定义 改名 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "首本 title 改为 name"
				$结束 $定义
				$定义 删除 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "删除价格超过 30 的书"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "重置书单"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
