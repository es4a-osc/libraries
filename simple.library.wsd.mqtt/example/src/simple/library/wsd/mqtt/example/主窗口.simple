''' 本库 Paho 接口的单主题发布/订阅示例；不读取设备 IMEI，不开启自动重连，不发送保留消息。
''' 可使用自己的 Broker；公开学习服务资料：https://www.hivemq.com/mqtt/public-mqtt-broker/
''' 公开服务的消息是公开的，仅用演示文本；可用性和限流由服务端决定。
变量 客户端标识 为 文本型
变量 连接中 为 逻辑型
变量 本会话曾连接 为 逻辑型
变量 关闭中 为 逻辑型
变量 订阅中 为 逻辑型
变量 已订阅 为 逻辑型
变量 订阅快照 为 文本型
变量 服务快照 为 文本型
变量 QoS 为 整数型
变量 连接次数 为 整数型
变量 订阅次数 为 整数型
变量 交付次数 为 整数型
变量 收到次数 为 整数型
变量 失败次数 为 整数型
变量 文本种类 为 整数型
变量 最近主题 为 文本型
变量 最近摘要 为 文本型
变量 最近长度 为 整数型
变量 有发送 为 逻辑型

事件 主窗口.初始化()
	QoS = 1
	创建会话标识()
	更新操作()
	更新统计()
结束 事件

过程 创建会话标识()
	客户端标识 = "es4a-" & 生成GUID()
	主题.文本 = "es4a/example/" & 生成GUID()
	身份说明.文本 = "本次客户端 ID：" & 客户端标识
结束 过程

事件 新主题.被单击()
	如果 连接中 或 关闭中 或 通讯.是否已连接() 则
		状态.文本 = "先断开连接，再生成新客户端 ID 和主题。"
		退出 事件
	结束 如果
	创建会话标识()
	状态.文本 = "已生成独立会话与主题；未读取设备标识。"
结束 事件

事件 公开服务.被单击()
	如果 连接中 或 关闭中 或 通讯.是否已连接() 则 退出 事件
	服务器.文本 = "ssl://broker.hivemq.com:8883"
	用户名.文本 = ""
	口令.文本 = ""
	状态.文本 = "已填写公开 TLS 学习服务；只发送演示数据，不用于私密或业务通信。"
结束 事件

事件 连接按钮.被单击()
	如果 连接中 或 关闭中 或 通讯.是否已连接() 则 退出 事件
	变量 地址 为 文本型
	地址 = 服务器.文本
	删首尾空(地址)
	如果 寻找文本(地址, "tcp://", 0) <> 0 且 寻找文本(地址, "ssl://", 0) <> 0 则
		状态.文本 = "请填写 tcp:// 或 ssl:// 的 Broker 地址。"
		退出 事件
	结束 如果
	服务快照 = 地址
	本会话曾连接 = 假
	连接中 = 真
	已订阅 = 假
	订阅中 = 假
	有发送 = 假
	状态.文本 = "连接中，等待连接成功事件。"
	更新操作()
	通讯.连接服务器(地址, 用户名.文本, 口令.文本, 客户端标识, 假, 真, 30)
结束 事件

事件 订阅按钮.被单击()
	如果 通讯.是否已连接() = 假 或 订阅中 或 已订阅 则 退出 事件
	如果 检查主题() = 假 则 退出 事件
	订阅快照 = 主题.文本
	订阅中 = 真
	状态.文本 = "订阅请求已发出，等待 Broker 确认。"
	更新操作()
	通讯.订阅消息(订阅快照, QoS)
结束 事件

函数 检查主题() 为 逻辑型
	检查主题 = 主题.文本 <> "" 且 寻找文本(主题.文本, "+", 0) < 0 且 寻找文本(主题.文本, "#", 0) < 0
	如果 检查主题 = 假 则 状态.文本 = "本示例用同一具体主题发布和订阅，请填非空且不含 +、# 的主题。"
结束 函数

事件 发送按钮.被单击()
	如果 通讯.是否已连接() = 假 或 关闭中 则
		状态.文本 = "尚未连接，先连接并订阅主题，再发送观察回环。"
		退出 事件
	结束 如果
	如果 检查主题() = 假 则 退出 事件
	变量 数据 为 字节型()
	数据 = 文本到字节(消息.文本, "UTF-8")
	最近主题 = 主题.文本
	最近长度 = 取数组成员数(数据)
	最近摘要 = 取MD5值(数据)
	有发送 = 真
	交付说明.文本 = "已调用发送（" & 最近长度 & " 字节）；等待交付事件，实际回环另看收到消息。"
	通讯.发送消息(最近主题, 数据, QoS, 假)
	位于 错误
		分支 否则
			交付说明.文本 = "发送未成功，请检查连接、主题和 Broker 限制。"
	结束 错误
结束 事件

事件 取消订阅按钮.被单击()
	如果 通讯.是否已连接() = 假 或 已订阅 = 假 则 退出 事件
	通讯.取消订阅(订阅快照)
	已订阅 = 假
	更新操作()
	状态.文本 = "已提交取消订阅；本库没有取消成功事件，请通过之后发布不再回环来核对。"
	位于 错误
		分支 否则
			状态.文本 = "取消订阅未成功，请断开后重新连接。"
	结束 错误
结束 事件

事件 断开按钮.被单击()
	如果 关闭中 则 退出 事件
	如果 通讯.是否已连接() = 假 且 连接中 = 假 则
		状态.文本 = "当前未连接；连接失败后可稍候重试。"
		退出 事件
	结束 如果
	关闭中 = 真
	连接中 = 假
	状态.文本 = "正在断开和释放旧连接，收到断开事件后再连接。"
	更新操作()
	通讯.断开连接()
结束 事件

事件 切QoS.被单击()
	如果 订阅中 则 退出 事件
	QoS = QoS + 1
	如果 QoS > 2 则 QoS = 0
	切QoS.文本 = "QoS " & QoS & "（点击切换）"
	状态.文本 = "下次订阅和发布使用 QoS " & QoS & "；已有订阅等级不变。实际收取等级由 Broker 决定。"
结束 事件

事件 换文本.被单击()
	文本种类 = 文本种类 + 1
	判断 文本种类
		分支 1
			消息.文本 = ""
		分支 2
			消息.文本 = "Simple"
		分支 否则
			消息.文本 = "你好，MQTT 😀"
			文本种类 = 0
	结束 判断
结束 事件

事件 通讯.连接成功()
	本会话曾连接 = 真
	连接中 = 假
	关闭中 = 假
	连接次数 = 连接次数 + 1
	状态.文本 = "连接成功；先订阅主题，收到订阅成功事件后再发送。"
	更新操作()
	更新统计()
结束 事件

事件 通讯.连接失败()
	本会话曾连接 = 假
	连接中 = 假
	关闭中 = 假
	失败次数 = 失败次数 + 1
	状态.文本 = "连接失败；请检查网络、服务器、账号和 ID，并稍候重试。库没有提供失败原因参数。"
	更新操作()
	更新统计()
结束 事件

事件 通讯.连接断开()
	连接中 = 假
	订阅中 = 假
	已订阅 = 假
	如果 关闭中 则
		关闭中 = 假
		本会话曾连接 = 假
		状态.文本 = "连接已断开并释放，可以重新连接；干净会话需要重新订阅。"
	否则如果 本会话曾连接 则
		' 只有已经建立的会话丢失时才等待显式清理；连接失败后的客户端可能已被库释放。
		本会话曾连接 = 假
		关闭中 = 真
		状态.文本 = "连接已丢失，正在清理旧连接；本示例不自动重连。"
		通讯.断开连接()
	否则
		' 失败后可能再收到断开通知；没有已建立的会话时，不等待不存在的第二次断开。
		关闭中 = 假
		状态.文本 = "连接尝试已结束，请检查服务地址、账号和网络后重试。"
	结束 如果
	更新操作()
结束 事件

事件 通讯.订阅成功()
	订阅中 = 假
	已订阅 = 真
	订阅次数 = 订阅次数 + 1
	状态.文本 = "订阅已确认：" & 订阅快照 & "；现在发送可观察同主题回环。"
	更新操作()
	更新统计()
结束 事件

事件 通讯.订阅失败()
	订阅中 = 假
	已订阅 = 假
	失败次数 = 失败次数 + 1
	状态.文本 = "订阅失败，请检查连接、主题和 Broker 授权。"
	更新操作()
	更新统计()
结束 事件

事件 通讯.发送完毕()
	交付次数 = 交付次数 + 1
	交付说明.文本 = "已收到 Paho 交付完成事件；这不表示业务接收方已经处理。"
	更新统计()
结束 事件

事件 通讯.收到消息(消息主题 为 文本型, 内容 为 字节型(), 实际QoS 为 整数型)
	收到次数 = 收到次数 + 1
	收到说明.文本 = "最近实际收到：主题=" & 消息主题 & "；QoS=" & 实际QoS & "；字节=" & 取数组成员数(内容) & "；文本=[" & 取文本左边(字节到文本(内容, "UTF-8"), 600) & "]"
	如果 有发送 则
		如果 消息主题 = 最近主题 且 取数组成员数(内容) = 最近长度 且 取MD5值(内容) = 最近摘要 则
			状态.文本 = "收到的主题、字节长度和 MD5 与最近一次发送一致。"
		否则
			状态.文本 = "收到的内容与最近发送不同，也可能是其它发布者推送或之前的消息。"
		结束 如果
	结束 如果
	更新统计()
结束 事件

过程 更新操作()
	变量 已连接 为 逻辑型
	已连接 = 通讯.是否已连接()
	服务器.启用 = 已连接 = 假 且 连接中 = 假 且 关闭中 = 假
	用户名.启用 = 服务器.启用
	口令.启用 = 服务器.启用
	主题.启用 = 订阅中 = 假 且 已订阅 = 假 且 关闭中 = 假
	连接按钮.启用 = 服务器.启用
	订阅按钮.启用 = 已连接 且 订阅中 = 假 且 已订阅 = 假 且 关闭中 = 假
	取消订阅按钮.启用 = 已连接 且 已订阅 且 关闭中 = 假
	断开按钮.启用 = (已连接 或 连接中) 且 关闭中 = 假
结束 过程

过程 更新统计()
	统计.文本 = "本次界面：连接 " & 连接次数 & "；订阅 " & 订阅次数 & "；交付 " & 交付次数 & "；收到 " & 收到次数 & "；失败 " & 失败次数
结束 过程

事件 退出按钮.被单击()
	通讯.关闭服务()
	终止()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		通讯.关闭服务()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "MQTT 发布订阅示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "发布、订阅与真实回环"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "填写自己的 Broker，或选择公开学习服务。公开消息任何人都可读取，仅发送演示文本；本示例使用干净会话、不自动重连、不发布保留消息。"
		$结束 $定义
		$定义 通讯 $为 simple.library.wsd.mqtt.MQTT通讯
		$结束 $定义
		$定义 服务器 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "ssl://主机:端口 或 tcp://主机:端口"
		$结束 $定义
		$定义 服务选择 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 公开服务 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "填写公开 TLS 学习服务"
			$结束 $定义
			$定义 新主题 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "生成新 ID 与主题"
			$结束 $定义
		$结束 $定义
		$定义 凭据 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 用户名 $为 编辑框
				宽度 = 0
				权重 = 1
				单行模式 = 真
				提示文本 = "用户名（可空）"
			$结束 $定义
			$定义 口令 $为 密码编辑框
				宽度 = 0
				权重 = 1
				单行模式 = 真
				提示 = "密码（不保存）"
			$结束 $定义
		$结束 $定义
		$定义 身份说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 主题 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "同一具体主题用于发布和订阅"
		$结束 $定义
		$定义 连接操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 连接按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "连接 Broker"
			$结束 $定义
			$定义 断开按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "断开并释放连接"
			$结束 $定义
		$结束 $定义
		$定义 订阅操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 订阅按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "订阅当前主题"
			$结束 $定义
			$定义 取消订阅按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "取消当前订阅"
			$结束 $定义
		$结束 $定义
		$定义 消息 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，MQTT 😀"
			提示文本 = "允许空文本（0 字节）"
		$结束 $定义
		$定义 消息配置 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 换文本 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换空文本 / ASCII"
			$结束 $定义
			$定义 切QoS $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "QoS 1（点击切换）"
			$结束 $定义
		$结束 $定义
		$定义 发送按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "发布文本（不保留）"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "连接成功后先订阅，再发布观察真实回环。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = ""
		$结束 $定义
		$定义 交付说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚未发送；交付完成与实际收到消息分别显示。"
		$结束 $定义
		$定义 收到说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚未收到消息。"
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出并永久关闭组件"
		$结束 $定义
	$结束 $定义
$结束 $属性
