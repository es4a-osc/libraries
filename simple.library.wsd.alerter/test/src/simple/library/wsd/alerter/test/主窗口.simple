''' 提示条资源、会话替换、按钮标记、事件重入及销毁检查。
别名 提示条类型 = simple.library.wsd.alerter.提示条

变量 显示次数 为 整数型
变量 隐藏次数 为 整数型
变量 单击次数 为 整数型
变量 最后按钮标记 为 整数型
变量 隐藏后重开 为 逻辑型
变量 定时操作 为 整数型

''' 默认值及初始状态应与清单一致。
事件 主窗口.初始化()
	断言真(提示.显示时间 = 3000)
	断言真(提示.正在显示 = 假)
	最后按钮标记 = -1
结束 事件

''' 每项操作清理此前安排的定时动作，配置在下次显示时生效。
过程 准备(标题 为 文本型, 内容 为 文本型)
	操作计时器.启用 = 假
	定时操作 = 0
	隐藏后重开 = 假
	提示.清空按钮()
	提示.标题 = 标题
	提示.内容 = 内容
	提示.显示时间 = 2000
	提示.始终显示 = 假
	提示.显示进度 = 假
	提示.显示图标 = 真
	提示.图标 = ""
	提示.滑动关闭 = 真
	提示.单击关闭 = 真
结束 过程

''' 内置图标、布局及动画均来自第三方资源包。
事件 显示普通.被单击()
	准备("普通提示", "两秒后自动关闭；也可点击或滑动关闭。")
	提示.显示()
	断言真(提示.正在显示)
结束 事件

''' 持续进度不应自动关闭，点击主体仍按单击关闭配置处理。
事件 显示进度.被单击()
	准备("正在处理", "检查进度颜色和持续显示。")
	提示.始终显示 = 真
	提示.显示进度 = 真
	提示.进度颜色 = &HFFFFC107
	提示.显示()
结束 事件

''' 默认按钮样式来自第三方资源；事件应返回添加时的标记。
事件 显示按钮.被单击()
	准备("确认操作", "点击任一按钮，核对返回标记。")
	提示.始终显示 = 真
	提示.添加按钮(41, "确定", -1)
	提示.添加按钮(42, "取消", -1)
	提示.显示()
结束 事件

''' 同一消息循环内替换排队中的显示，只保留最后一次。
事件 重复显示.被单击()
	准备("第一次", "此提示应被下一次显示替换。")
	提示.显示()
	提示.标题 = "第二次"
	提示.内容 = "最终只保留第二次提示。"
	提示.显示()
结束 事件

''' 覆盖第三方 show 尚未实际加入视图时立即关闭的路径。
事件 立即关闭.被单击()
	准备("立即关闭", "不应遗留提示条或重复隐藏事件。")
	提示.显示()
	提示.关闭()
	提示.关闭()
结束 事件

''' 程序关闭应保留退出动画，且不重复通知。
事件 延迟关闭.被单击()
	准备("延迟关闭", "一秒后程序关闭。")
	提示.始终显示 = 真
	提示.显示()
	定时操作 = 1
	操作计时器.启用 = 真
结束 事件

''' 图片标识引用项目自己的资源，更新方法同时修改当前界面。
事件 更新内容.被单击()
	准备("更新前", "一秒后修改标题和正文。")
	提示.图标 = "@drawable/icon"
	提示.始终显示 = 真
	提示.显示()
	定时操作 = 2
	操作计时器.启用 = 真
结束 事件

''' 隐藏回调创建的新会话不能被旧会话的清理任务移除。
事件 关闭后重开.被单击()
	准备("关闭后重开", "点击此提示后，应从隐藏回调重新显示。")
	隐藏后重开 = 真
	提示.始终显示 = 真
	提示.显示()
结束 事件

''' 两个组件共享窗口中的显示位置，但旧组件关闭不能误关新组件。
事件 跨实例替换.被单击()
	准备("旧实例", "将被备用实例替换。")
	提示.显示()
	备用提示.标题 = "备用实例"
	备用提示.内容 = "旧实例的关闭调用不应移除这条提示。"
	备用提示.显示()
	提示.关闭()
	断言真(提示.正在显示 = 假)
	断言真(备用提示.正在显示)
结束 事件

''' 销毁前替换字段引用，事件绑定随字段指向新组件。
事件 销毁重建.被单击()
	准备("销毁旧实例", "旧视图应移除且不派发交互结果。")
	提示.显示()
	变量 旧提示 为 提示条类型
	旧提示 = 提示
	提示 = 创建 提示条类型 位于 主窗口
	旧提示.销毁()
	断言真(提示.正在显示 = 假)
	提示.标题 = "新实例"
	提示.内容 = "重建后仍应能接收事件。"
	提示.显示()
结束 事件

''' 定时动作各执行一次，不用阻塞等待影响动画和事件。
事件 操作计时器.计时()
	操作计时器.启用 = 假
	如果 定时操作 = 1 则
		提示.关闭()
	否则
		提示.更新标题("更新完成")
		提示.更新内容("标题和正文已修改，检查图标仍然显示。")
		断言真(提示.标题 = "更新完成")
	结束 如果
	定时操作 = 0
结束 事件

''' 完成进入动画时，本实例仍应处于有效显示状态。
事件 提示.被显示()
	断言真(提示.正在显示)
	显示次数 = 显示次数 + 1
	结果.文本 = "已显示：" & 显示次数
结束 事件

''' 隐藏先更新状态，再通知；可在此回调中安全地重新显示。
事件 提示.被隐藏()
	断言真(提示.正在显示 = 假)
	隐藏次数 = 隐藏次数 + 1
	结果.文本 = "已隐藏：" & 隐藏次数
	如果 隐藏后重开 则
		隐藏后重开 = 假
		提示.标题 = "隐藏回调重开"
		提示.内容 = "这条提示不应被旧会话清理。"
		提示.显示()
	结束 如果
结束 事件

''' 主体单击与按钮单击应分开统计。
事件 提示.被单击()
	单击次数 = 单击次数 + 1
	结果.文本 = "主体单击：" & 单击次数
结束 事件

''' 标记必须原样返回，关闭后只派发一次隐藏事件。
事件 提示.按钮被单击(标记 为 整数型)
	断言真(标记 = 41 或 标记 = 42)
	最后按钮标记 = 标记
	结果.文本 = "按钮标记：" & 最后按钮标记
	提示.关闭()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "提示条测试"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 提示 $为 simple.library.wsd.alerter.提示条
		$结束 $定义
		$定义 备用提示 $为 simple.library.wsd.alerter.提示条
		$结束 $定义
		$定义 操作计时器 $为 计时器
			间隔 = 1000
			启用 = 假
		$结束 $定义
		$定义 页面滚动框 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 内容面板 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 说明 $为 标签
					宽度 = 长度_匹配父级
					文本 = "检查提示条、资源、按钮标记和事件重入；需使用提供 selectableItemBackground 属性的主题。"
				$结束 $定义
				$定义 显示普通 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "普通提示与自动关闭"
				$结束 $定义
				$定义 显示进度 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "进度及持续显示"
				$结束 $定义
				$定义 显示按钮 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "操作按钮与标记"
				$结束 $定义
				$定义 重复显示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "同实例连续显示两次"
				$结束 $定义
				$定义 立即关闭 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "显示后立即关闭"
				$结束 $定义
				$定义 延迟关闭 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "延迟关闭与退出动画"
				$结束 $定义
				$定义 更新内容 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "更新当前标题和正文"
				$结束 $定义
				$定义 关闭后重开 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "隐藏回调中重新显示"
				$结束 $定义
				$定义 跨实例替换 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "另一个实例替换显示"
				$结束 $定义
				$定义 销毁重建 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "销毁当前实例并重建"
				$结束 $定义
				$定义 结果 $为 标签
					宽度 = 长度_匹配父级
					文本 = "等待操作。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
