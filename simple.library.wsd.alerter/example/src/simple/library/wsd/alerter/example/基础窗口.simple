变量 来源 为 主窗口

''' 每次显示前恢复基础配置，按钮和进度不会影响下次提示。
过程 准备提示(标题文本 为 文本型, 内容文本 为 文本型)
	提示.清空按钮()
	提示.标题 = 标题文本
	提示.内容 = 内容文本
	提示.显示时间 = 3000
	提示.始终显示 = 假
	提示.显示进度 = 假
	提示.图标 = ""
	提示.单击关闭 = 真
	提示.滑动关闭 = 真
	提示.背景颜色 = &HFF1976D2
结束 过程

事件 普通提示.被单击()
	准备提示("消息已送达", 内容输入.文本)
	提示.显示()
结束 事件

事件 图标提示.被单击()
	准备提示("带图标的提示", 内容输入.文本)
	提示.图标 = "@drawable/alerter_ic_face"
	提示.背景颜色 = &HFF2E7D32
	提示.显示()
结束 事件

事件 操作提示.被单击()
	准备提示("保存这次选择？", "这是交互演示，请选择保存或取消。")
	提示.始终显示 = 真
	提示.添加按钮(1, "保存", -1)
	提示.添加按钮(2, "取消", -1)
	提示.显示()
结束 事件

事件 进度提示.被单击()
	准备提示("进度样式演示", "这里不执行实际任务，可更新内容或手动关闭。")
	提示.始终显示 = 真
	提示.显示进度 = 真
	提示.进度颜色 = &HFFFFC107
	提示.显示()
结束 事件

''' 普通属性用于下次显示；更新方法立即修改当前提示。
事件 更新提示.被单击()
	如果 提示.正在显示 则
		提示.更新标题("内容已经更新")
		提示.更新内容(内容输入.文本)
		操作结果.文本 = "已更新当前提示条。"
	否则
		操作结果.文本 = "请先显示一条提示，再更新内容。"
	结束 如果
结束 事件

事件 关闭提示.被单击()
	提示.关闭()
结束 事件

事件 提示.被隐藏()
	状态.文本 = "提示条已关闭。"
结束 事件

事件 提示.被单击()
	操作结果.文本 = "你点击了提示条正文。"
结束 事件

事件 提示.按钮被单击(标记 为 整数型)
	如果 标记 = 1 则
		操作结果.文本 = "你选择了保存，返回标记为 1。"
	否则
		操作结果.文本 = "你选择了取消，返回标记为 2。"
	结束 如果
	提示.关闭()
结束 事件

事件 提示.被显示()
	状态.文本 = "提示条已显示。"
结束 事件

事件 返回按钮.被单击()
	提示.关闭()
	切换窗口(来源)
结束 事件

事件 基础窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		提示.关闭()
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 基础窗口 $为 窗口
		标题 = "基础提示"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		$定义 提示 $为 simple.library.wsd.alerter.提示条
		$结束 $定义
		$定义 返回按钮 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回示例目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "基础提示"
			字体大小 = 21
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "60dp"
			文本 = "输入内容后体验自动关闭、图标、按钮与持续进度。点击正文或滑动也能关闭提示。"
			字体大小 = 14
		$结束 $定义
		$定义 内容输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，Simple 提示条"
			提示文本 = "输入提示内容"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 普通提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "显示自动关闭提示"
					高度 = "44dp"
				$结束 $定义
				$定义 图标提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "显示本地图标提示"
					高度 = "44dp"
				$结束 $定义
				$定义 操作提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "显示保存 / 取消按钮"
					高度 = "44dp"
				$结束 $定义
				$定义 进度提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "显示持续进度样式"
					高度 = "44dp"
				$结束 $定义
				$定义 更新提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "更新正在显示的内容"
					高度 = "44dp"
				$结束 $定义
				$定义 关闭提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "关闭当前提示"
					高度 = "44dp"
				$结束 $定义
				$定义 状态 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 16
					文本 = "尚未显示提示条。"
				$结束 $定义
				$定义 操作结果 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 16
					文本 = "按钮选择和正文点击会在这里显示真实回调结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
