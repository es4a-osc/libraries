变量 来源 为 主窗口

''' 布局和控件编号来自 example/res/layout/alerter_example_content.xml。
事件 自定义内容.被单击()
	提示.内容布局资源 = 取资源标识("alerter_example_content", "layout")
	提示.始终显示 = 真
	提示.单击关闭 = 假
	提示.背景颜色 = &HFF37474F
	提示.显示()
结束 事件

''' 当前布局在显示完成后可读写；监听仅属于这一次显示。
事件 提示.被显示()
	提示.置布局文本(取资源标识("example_message", "id"), 内容输入.文本)
	提示.监听布局单击(取资源标识("example_action", "id"), 真)
	状态.文本 = "提示条已显示，请点击提示内的确认按钮。"
结束 事件

事件 读取内容.被单击()
	如果 提示.正在显示 则
		操作结果.文本 = 提示.取布局文本(取资源标识("example_message", "id"))
	否则
		操作结果.文本 = "请先显示自定义内容。"
	结束 如果
结束 事件

事件 提示.布局控件被单击(资源编号 为 整数型)
	操作结果.文本 = "点击了自定义布局中的按钮。"
	提示.置布局文本(取资源标识("example_message", "id"), "已收到你的选择")
结束 事件

事件 关闭提示.被单击()
	提示.关闭()
结束 事件

事件 提示.被隐藏()
	状态.文本 = "提示条已关闭。"
结束 事件

事件 返回按钮.被单击()
	提示.关闭()
	切换窗口(来源)
结束 事件

事件 自定义窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		提示.关闭()
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 自定义窗口 $为 窗口
		标题 = "自定义内容"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		$定义 提示 $为 simple.library.wsd.alerter.提示条
		$结束 $定义
		$定义 返回按钮 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回示例目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "自定义内容"
			字体大小 = 21
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "60dp"
			文本 = "输入内容后显示自定义布局，点击提示中的按钮，再读取修改后的文本。"
			字体大小 = 14
		$结束 $定义
		$定义 内容输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，Simple 提示条"
			提示文本 = "输入提示内容"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 自定义内容 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "显示自定义内容"
				$结束 $定义
				$定义 读取内容 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "读取自定义文本"
				$结束 $定义
				$定义 关闭提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "关闭当前提示"
					高度 = "44dp"
				$结束 $定义
				$定义 状态 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 16
					文本 = "尚未显示提示条。"
				$结束 $定义
				$定义 操作结果 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 16
					文本 = "按钮选择和正文点击会在这里显示真实回调结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
