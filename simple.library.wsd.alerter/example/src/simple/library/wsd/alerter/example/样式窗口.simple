别名 提示条 = simple.library.wsd.alerter.提示条

变量 来源 为 主窗口

''' 每次恢复原有着色与位置，便于独立观察一种样式。
过程 准备样式()
	提示.标题 = "样式预览"
	提示.内容 = 内容输入.文本
	提示.标题样式资源 = 0
	提示.内容样式资源 = 0
	提示.位置 = 48
	提示.图标 = "@drawable/alerter_ic_face"
	提示.右侧图标 = "@drawable/alerter_ic_notifications"
	提示.图标尺寸 = 32
	提示.右侧图标尺寸 = 32
	提示.显示右侧图标 = 假
	提示.图标混合模式 = 提示条.混合_SRC_IN
	提示.右侧图标混合模式 = 提示条.混合_SRC_IN
	提示.图标颜色 = &HFFFFFFFF
	提示.右侧图标颜色 = &HFFFFFFFF
	提示.背景颜色 = &HFF37474F
	提示.始终显示 = 真
	提示.单击关闭 = 假
	提示.滑动关闭 = 真
结束 过程

事件 文本样式.被单击()
	准备样式()
	提示.标题样式资源 = 取资源标识("ExampleAlertTitle", "style")
	提示.内容样式资源 = 取资源标识("ExampleAlertBody", "style")
	提示.显示()
结束 事件

事件 双侧图标.被单击()
	准备样式()
	提示.位置 = 80
	提示.显示右侧图标 = 真
	提示.图标颜色 = &HFFFFB74D
	提示.右侧图标颜色 = &HFF80DEEA
	提示.显示()
结束 事件

事件 原色图标.被单击()
	准备样式()
	提示.图标 = "@drawable/example_color_icon"
	提示.图标混合模式 = 提示条.混合_原色
	提示.显示()
结束 事件

''' 4×5 矩阵将图标变为橙色，并保留透明度。
事件 矩阵图标.被单击()
	准备样式()
	变量 矩阵 为 单精度小数型(20)
	矩阵(4) = 255
	矩阵(9) = 160
	矩阵(14) = 30
	矩阵(18) = 1
	提示.图标 = "@drawable/example_color_icon"
	提示.置图标颜色矩阵(矩阵)
	提示.显示右侧图标 = 真
	提示.右侧图标 = "@drawable/example_color_icon"
	提示.置右侧图标颜色矩阵(矩阵)
	提示.显示()
结束 事件

事件 清空正文.被单击()
	如果 提示.正在显示 则
		提示.更新标题("")
		提示.更新内容("")
		操作结果.文本 = "已清空当前标题和正文，重新显示可恢复。"
	否则
		操作结果.文本 = "请先显示一种样式。"
	结束 如果
结束 事件

事件 提示.被显示()
	状态.文本 = "提示条已显示，可切换其他样式。"
结束 事件

事件 关闭提示.被单击()
	提示.关闭()
结束 事件

事件 提示.被隐藏()
	状态.文本 = "提示条已关闭。"
结束 事件

事件 返回按钮.被单击()
	提示.关闭()
	切换窗口(来源)
结束 事件

事件 样式窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		提示.关闭()
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 样式窗口 $为 窗口
		标题 = "文字与图标"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		$定义 提示 $为 simple.library.wsd.alerter.提示条
		$结束 $定义
		$定义 返回按钮 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回示例目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "文字与图标"
			字体大小 = 21
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "60dp"
			文本 = "文字样式、左右图标、原色与颜色矩阵。提示保持显示，可切换样式或手动关闭。"
			字体大小 = 14
		$结束 $定义
		$定义 内容输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，Simple 提示条"
			提示文本 = "输入提示内容"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 文本样式 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "显示标题和正文样式"
				$结束 $定义
				$定义 双侧图标 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "底部提示：橙色与青色图标"
				$结束 $定义
				$定义 原色图标 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "显示彩色原图"
				$结束 $定义
				$定义 矩阵图标 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "颜色矩阵：图标变为橙色"
				$结束 $定义
				$定义 清空正文 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "清空内置标题和正文"
				$结束 $定义
				$定义 关闭提示 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "关闭当前提示"
					高度 = "44dp"
				$结束 $定义
				$定义 状态 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 16
					文本 = "尚未显示提示条。"
				$结束 $定义
				$定义 操作结果 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 16
					文本 = "按钮选择和正文点击会在这里显示真实回调结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
