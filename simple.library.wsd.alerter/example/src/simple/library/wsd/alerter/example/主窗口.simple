''' 参考 Alerter 官方示例，按 Simple 组件与事件模型改写。
''' https://github.com/Tapadoo/Alerter

变量 基础页 为 基础窗口
变量 基础已创建 为 逻辑型
变量 样式页 为 样式窗口
变量 样式已创建 为 逻辑型
变量 自定义页 为 自定义窗口
变量 自定义已创建 为 逻辑型

事件 基础入口.被单击()
	如果 取反 基础已创建 则
		基础页 = 创建 基础窗口
		基础页.来源 = 主窗口
		基础已创建 = 真
	结束 如果
	切换窗口(基础页)
结束 事件

事件 样式入口.被单击()
	如果 取反 样式已创建 则
		样式页 = 创建 样式窗口
		样式页.来源 = 主窗口
		样式已创建 = 真
	结束 如果
	切换窗口(样式页)
结束 事件

事件 自定义入口.被单击()
	如果 取反 自定义已创建 则
		自定义页 = 创建 自定义窗口
		自定义页.来源 = 主窗口
		自定义已创建 = 真
	结束 如果
	切换窗口(自定义页)
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "提示条使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "提示条使用示例"
			字体大小 = 24
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "60dp"
			文本 = "选择一个主题进入。每页独立演示，输入框固定在页面顶部。"
		$结束 $定义
		$定义 基础入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "基础提示"
		$结束 $定义
		$定义 基础说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "自动关闭、图标、保存/取消按钮与持续进度。"
		$结束 $定义
		$定义 样式入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "文字与图标"
		$结束 $定义
		$定义 样式说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "文字样式、左右图标、原色与颜色矩阵。"
		$结束 $定义
		$定义 自定义入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "自定义内容"
		$结束 $定义
		$定义 自定义说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "布局资源、控件读写与点击回调。"
		$结束 $定义
	$结束 $定义
$结束 $属性
