''' 参考 Alerter 官方普通提示、进度、操作按钮和可见性回调示例：
''' https://github.com/Tapadoo/Alerter
''' 按当前 Simple 封装 API 改写；所用 AndroidX 主题由 project.properties 指定。

''' 每次显示前设置本次配置，避免上一个场景的按钮或进度样式影响下一次提示。
过程 准备提示(标题文本 为 文本型, 内容文本 为 文本型)
	提示.清空按钮()
	提示.标题 = 标题文本
	提示.内容 = 内容文本
	提示.显示时间 = 3000
	提示.始终显示 = 假
	提示.显示进度 = 假
	提示.显示图标 = 真
	提示.图标 = ""
	提示.单击关闭 = 真
	提示.滑动关闭 = 真
	提示.背景颜色 = &HFF1976D2
	状态.文本 = "正在显示提示条..."
结束 过程

''' 自动关闭，也可以点击正文或滑动提示条关闭。
事件 普通提示.被单击()
	准备提示("消息已送达", 内容输入.文本)
	提示.显示()
结束 事件

''' 使用随 Alerter 原包交付的透明图标，适配默认白色着色，不依赖外部文件或读取权限。
事件 图标提示.被单击()
	准备提示("带图标的提示", 内容输入.文本)
	提示.图标 = "@drawable/alerter_ic_face"
	提示.背景颜色 = &HFF2E7D32
	提示.显示()
结束 事件

''' 添加按钮时的标记会随按钮被单击事件返回，由使用者决定后续操作。
事件 操作提示.被单击()
	准备提示("保存这次选择？", "这是交互演示，请选择保存或取消。")
	提示.始终显示 = 真
	提示.添加按钮(1, "保存", -1)
	提示.添加按钮(2, "取消", -1)
	提示.显示()
结束 事件

''' 只展示持续进度样式，不模拟真实下载或网络请求。
事件 进度提示.被单击()
	准备提示("进度样式演示", "这里不执行实际任务，可更新内容或手动关闭。")
	提示.始终显示 = 真
	提示.显示进度 = 真
	提示.进度颜色 = &HFFFFC107
	提示.显示()
结束 事件

''' 更新方法会立即修改正在显示的提示条，而普通属性用于下一次显示。
事件 更新提示.被单击()
	如果 提示.正在显示 则
		提示.更新标题("内容已经更新")
		提示.更新内容(内容输入.文本)
		操作结果.文本 = "已通过更新方法修改当前提示条。"
	否则
		操作结果.文本 = "请先显示一条提示，再更新内容。"
	结束 如果
结束 事件

事件 关闭提示.被单击()
	提示.关闭()
结束 事件

''' 分开显示生命周期与操作结果，关闭回调不会覆盖用户选择。
事件 提示.被显示()
	状态.文本 = "提示条已显示。"
结束 事件

事件 提示.被隐藏()
	状态.文本 = "提示条已关闭。"
结束 事件

事件 提示.被单击()
	操作结果.文本 = "你点击了提示条正文。"
结束 事件

事件 提示.按钮被单击(标记 为 整数型)
	如果 标记 = 1 则
		操作结果.文本 = "你选择了保存，返回标记为 1。"
	否则
		操作结果.文本 = "你选择了取消，返回标记为 2。"
	结束 如果
	提示.关闭()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "提示条使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 提示 $为 simple.library.wsd.alerter.提示条
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "窗口内提示条"
			字体加粗 = 真
		$结束 $定义
		$定义 使用说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "点击按钮体验自动关闭、图标、操作按钮和持续进度。点击正文或滑动也能关闭提示。"
		$结束 $定义
		$定义 内容输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "你好，Simple 提示条"
			提示文本 = "输入提示内容"
		$结束 $定义
		$定义 普通提示 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "显示自动关闭提示"
		$结束 $定义
		$定义 图标提示 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "显示本地图标提示"
		$结束 $定义
		$定义 操作提示 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "显示保存 / 取消按钮"
		$结束 $定义
		$定义 进度提示 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "显示持续进度样式"
		$结束 $定义
		$定义 更新提示 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "更新正在显示的内容"
		$结束 $定义
		$定义 关闭提示 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "关闭当前提示"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "尚未显示提示条。"
		$结束 $定义
		$定义 操作结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "按钮选择和正文点击会在这里显示真实回调结果。"
		$结束 $定义
	$结束 $定义
$结束 $属性
