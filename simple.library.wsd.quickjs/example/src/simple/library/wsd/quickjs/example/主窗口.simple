	变量 加载器 为 模块来源

	加载器 = 创建 模块来源
	引擎.置加载器(加载器)
	导出 = 引擎.创建对象()
	导出.置简单成员("answer", 42)
	导出.置简单成员("default", "宿主模块")
	引擎.注册模块对象("native", 导出)
	导出.释放()

	选项 = 创建 QuickJS执行选项
	选项.置严格模式(真)
	选项.置模块地址("asset:/entry-options.js")
	选项.置模块入口(真)
	临时引用1 = 引擎.执行模块("import label,{answer} from 'native';export const valid=answer===42 && label==='宿主模块' && import.meta.main===true && import.meta.url==='asset:/entry-options.js' && import.meta.custom==='ES4A'", "entry-options.js", 选项)
	临时引用1.释放()
	运行时.执行任务(100)
	命名空间 = 引擎.取模块命名空间("entry-options.js")
	临时引用2 = 命名空间.取成员("valid")
	核对(临时引用2.到逻辑(), "宿主模块及 import.meta")
	命名空间.释放()

	承诺 = 引擎.导入模块("native", "consumer.js")
	运行时.执行任务(100)
	临时引用3 = 承诺.取结果()
	命名空间 = 临时引用3.到对象()
	临时引用4 = 命名空间.取成员("answer")
	核对(临时引用4.到整数() = 42, "动态导入")
	命名空间.释放()
	承诺.释放()

	接收者 = 引擎.创建对象()
	接收者.置简单成员("answer", 42)
	结果 = 引擎.执行代码("this.answer", "this.js", 接收者, 选项)
	核对(结果.到整数() = 42, "脚本 this")
	结果.释放()
	结果 = 引擎.执行代码("(()=>{try{undeclaredSetting=1;return false}catch(e){return e instanceof ReferenceError}})()", "strict.js", 空, 选项)
	核对(结果.到逻辑(), "严格模式")
	结果.释放()
	接收者.释放()

	选项.置允许等待(真)
	临时引用5 = 引擎.执行代码("await Promise.resolve(42)", "await.js", 空, 选项)
	承诺 = 临时引用5.到承诺()
	运行时.执行任务(100)
	结果 = 承诺.取结果()
	引擎.置全局值("awaitResult", 结果)
	临时引用6 = 引擎.执行代码("awaitResult.value===42")
	核对(临时引用6.到逻辑(), "普通脚本顶层 await")
	结果.释放()
	承诺.释放()

	字节码 = 引擎.编译代码("await Promise.resolve(84)", "await-compiled.js", 选项)
	临时引用7 = 引擎.执行字节码(字节码)
	承诺 = 临时引用7.到承诺()
	运行时.执行任务(100)
	结果 = 承诺.取结果()
	引擎.置全局值("awaitCompiled", 结果)
	临时引用8 = 引擎.执行代码("awaitCompiled.value===84")
	核对(临时引用8.到逻辑(), "异步脚本字节码")
	结果.释放()
	承诺.释放()
	记录("10 宿主模块、动态导入、元信息、this、严格模式及顶层 await：完成")
结束 过程

