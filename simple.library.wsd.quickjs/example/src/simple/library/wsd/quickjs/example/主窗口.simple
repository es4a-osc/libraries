过程 回调回收(回调 为 宿主加法)

	变量 起始 为 QuickJS内存
	变量 结束时 为 QuickJS内存
	变量 全局 为 QuickJS对象
	变量 编号 为 整数型
	变量 已删除 为 逻辑型
	变量 变化 为 长整数型

	运行时.回收垃圾()
	起始 = 运行时.取内存统计()

	循环 编号 = 1 至 1000
		引擎.注册函数("temporaryHost", 回调)
	下个

	全局 = 引擎.取全局对象()
	已删除 = 全局.删除成员("temporaryHost")
	全局.释放()
	运行时.回收垃圾()
	结束时 = 运行时.取内存统计()

	变化 = 结束时.取分配字节() - 起始.取分配字节()
	核对(变化 < 16384, "宿主函数回收")
	记录("替换 1000 次宿主函数后，原生分配变化：" & 变化 & " 字节")
结束 过程

过程 宿主主题()

	变量 成员列表 为 文本型(4)
	变量 单成员 为 文本型(1)
	变量 文本宿主 为 QuickJS对象
	变量 宿主 为 示例宿主
	变量 构造回调 为 示例构造
	变量 构造函数 为 QuickJS函数
	变量 数据 为 哈希表
	变量 原值 为 QuickJS值
	变量 副本 为 QuickJS值
	变量 结果 为 QuickJS值

	宿主 = 创建 示例宿主
	宿主.名称 = "初始名称"
	成员列表(0) = "名称"
	成员列表(1) = "相加"
	成员列表(2) = "回声"
	成员列表(3) = "复制集合"
	文本宿主 = 引擎.创建宿主对象(宿主, 成员列表)
	引擎.置全局值("host", 文本宿主)
	文本宿主.释放()
	结果 = 引擎.执行资产("binding.js")
	核对(结果.到逻辑(), "宿主方法和实时字段")
	核对(宿主.名称 = "JS 修改", "字段写回宿主")
	结果.释放()

	单成员(0) = "相加"
	文本宿主 = 引擎.创建宿主对象(宿主, 单成员)
	引擎.置全局值("textHost", 文本宿主)
	结果 = 引擎.执行代码("textHost.相加(20,22)===42 && Object.keys(textHost).length===1")
	核对(结果.到逻辑(), "明确选择公开成员")
	结果.释放()
	文本宿主.释放()

	构造回调 = 创建 示例构造
	构造函数 = 引擎.创建构造函数("HostPoint", 1, 构造回调)
	引擎.置全局值("HostPoint", 构造函数)
	结果 = 引擎.执行代码("(()=>{class Point extends HostPoint{};const p=new Point(42);const q=Reflect.construct(HostPoint,[7],Point);return p.value===42 && p instanceof Point && p instanceof HostPoint && q.value===7 && q instanceof Point})()")
	核对(结果.到逻辑(), "宿主构造函数和继承")
	结果.释放()
	构造函数.释放()

	数据 = 创建 哈希表
	数据.加入("self", 数据)
	数据.加入("__proto__", 42)
	原值 = 引擎.生成值(数据)
	引擎.置全局值("graph", 原值)
	结果 = 引擎.执行代码("graph.self===graph && Object.getPrototypeOf(graph)===Object.prototype && graph.__proto__===42")
	核对(结果.到逻辑(), "循环哈希表及特殊键")
	结果.释放()

	数据 = 原值.到哈希表()
	副本 = 引擎.生成值(数据)
	引擎.置全局值("graphCopy", 副本)
	结果 = 引擎.执行代码("graphCopy.self===graphCopy && graphCopy.__proto__===42")
	核对(结果.到逻辑(), "循环数据深度往返")
	结果.释放()
	原值.释放()
	副本.释放()
	记录("09 宿主字段、成员选择、集合转换、循环数据及构造继承：完成")
结束 过程

