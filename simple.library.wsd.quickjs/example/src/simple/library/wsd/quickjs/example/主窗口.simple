$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "QuickJS脚本示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "QuickJS脚本示例"
			字体大小 = 21
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "90dp"
			文本 = "按主题进入，逐个按钮阅读对应 API。脚本在后台运行；返回目录销毁本页引擎，再次进入创建新引擎。仅运行可信脚本，不提供浏览器 DOM、Node.js 或 std/os。"
			字体大小 = 14
		$结束 $定义
		$定义 入口0 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "01 代码、类型与数值"
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "02 对象、数组与集合"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "03 函数与宿主对象"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "04 Promise 与计时器"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "05 模块与执行选项"
		$结束 $定义
		$定义 入口5 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "06 字节码与二进制"
		$结束 $定义
