过程 调度主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用3 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用4 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用5 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用6 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用7 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用8 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用9 为 simple.library.wsd.quickjs.QuickJS值
	变量 结果 为 QuickJS值
	变量 线程 为 QuickJS线程
	变量 回调 为 示例线程
	变量 缓冲 为 QuickJS对象
	变量 字节 为 字节型(2)
	变量 轮次 为 整数型

	引擎.启用计时器()
	临时引用1 = 引擎.执行资产("timers.js")
	临时引用1.释放()
	等待结果("timerDone")
	临时引用2 = 引擎.取全局值("timerAnswer")
	核对(临时引用2.到整数() = 42, "自动任务和定时器取消")
	核对(运行时.取任务错误() = 空, "调度无异常")

	引擎.启用工作线程()
	临时引用3 = 引擎.执行资产("workers.js")
	临时引用3.释放()
	等待结果("workersDone")
	临时引用4 = 引擎.取全局值("workerAnswer")
	核对(临时引用4.到整数() = 42, "JS 工作线程复制消息")
	临时引用5 = 引擎.取全局值("moduleAnswerNew")
	核对(临时引用5.到整数() = 84, "模块工作线程")
	临时引用6 = 引擎.取全局值("closeAnswer")
	核对(临时引用6.到整数() = 21, "关闭前消息仍送达")

	回调 = 创建 示例线程
	线程 = 引擎.创建工作线程("onmessage=e=>{postMessage(e.data*2);close()}", 回调)
	结果 = 引擎.创建小数(21)
	线程.发送(结果)
	结果.释放()
	循环 轮次 = 1 至 250
		如果 回调.已经结束了 则 退出 循环
		延时(20)
	下个
	核对(回调.结果 = 42, "Simple 工作线程回调")
	核对(回调.错误文本 = "", "工作线程无异常")

	回调.已经结束了 = 假
	线程 = 引擎.创建工作线程("for(;;){}", 回调)
	延时(20)
	线程.终止()
	循环 轮次 = 1 至 250
		如果 回调.已经结束了 则 退出 循环
		延时(20)
	下个
	核对(回调.已经结束了, "主动终止及结束通知")

	回调.已经结束了 = 假
	线程 = 引擎.创建工作线程("for(;;){}", 回调)
	临时引用7 = 引擎.执行代码("setInterval(()=>{},100)")
	临时引用7.释放()

	缓冲 = 引擎.创建缓冲区(字节)
	引擎.置全局值("detachedBuffer", 缓冲)
	引擎.分离缓冲区(缓冲)
	临时引用8 = 引擎.执行代码("detachedBuffer.byteLength===0")
	核对(临时引用8.到逻辑(), "ArrayBuffer 分离")
	缓冲.释放()

	运行时.停止自动调度()
	核对(运行时.是否自动调度() = 假, "停止调度")
	核对(线程.是否运行() = 假, "停止调度时停止工作线程")
	运行时.启动自动调度(100)
	临时引用9 = 引擎.执行代码("globalThis.restartDone=false;setTimeout(()=>{restartDone=true},0)")
	临时引用9.释放()
	等待结果("restartDone")
	记录("11 自动调度、计时器、双向工作线程、模块线程及停止重启：完成")
结束 过程

