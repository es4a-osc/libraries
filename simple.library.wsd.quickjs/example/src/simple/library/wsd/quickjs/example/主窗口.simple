别名 QuickJS实例 = simple.library.wsd.quickjs.QuickJS实例
别名 QuickJS值 = simple.library.wsd.quickjs.QuickJS值
别名 QuickJS对象 = simple.library.wsd.quickjs.QuickJS对象
别名 QuickJS数组 = simple.library.wsd.quickjs.QuickJS数组
别名 QuickJS函数 = simple.library.wsd.quickjs.QuickJS函数
别名 QuickJS运行时 = simple.library.wsd.quickjs.QuickJS运行时
别名 QuickJS控制器 = simple.library.wsd.quickjs.QuickJS控制器
别名 QuickJS承诺 = simple.library.wsd.quickjs.QuickJS承诺
别名 QuickJS内存 = simple.library.wsd.quickjs.QuickJS内存
别名 QuickJS错误 = simple.library.wsd.quickjs.QuickJS错误
别名 QuickJS模块 = simple.library.wsd.quickjs.QuickJS模块
别名 QuickJS加载器 = simple.library.wsd.quickjs.QuickJS加载器
别名 QuickJS日志 = simple.library.wsd.quickjs.QuickJS日志
别名 QuickJS监听 = simple.library.wsd.quickjs.QuickJS监听
别名 QuickJS参数 = simple.library.wsd.quickjs.QuickJS参数
别名 QuickJS回调 = simple.library.wsd.quickjs.QuickJS回调
别名 QuickJS常量 = simple.library.wsd.quickjs.QuickJS常量
别名 QuickJS执行选项 = simple.library.wsd.quickjs.QuickJS执行选项
别名 QuickJS构造回调 = simple.library.wsd.quickjs.QuickJS构造回调
别名 QuickJS线程 = simple.library.wsd.quickjs.QuickJS线程
别名 QuickJS线程回调 = simple.library.wsd.quickjs.QuickJS线程回调

变量 引擎 为 QuickJS实例
变量 运行时 为 QuickJS运行时
变量 忙碌 为 逻辑型
变量 操作 为 整数型
变量 输入代码 为 文本型
变量 报告 为 文本型

事件 主窗口.初始化()

	引擎 = 创建 QuickJS实例
	运行时 = 引擎.取运行时()
结束 事件

过程 提交(编号 为 整数型)

	如果 忙碌 则 退出 过程
	忙碌 = 真
	操作 = 编号
	输入代码 = 代码.文本
	报告 = ""
	状态.文本 = "后台运行中……"
	启动线程(本对象, "后台处理")
结束 过程

事件 主窗口.反馈消息(标记 为 变体型, 内容 为 变体型)

	忙碌 = 假
	状态.文本 = 内容
结束 事件

过程 记录(内容 为 文本型)

	报告 = 报告 & 内容 & "\n"
	输出信息("QuickJS示例", 内容)
结束 过程

过程 核对(条件 为 逻辑型, 说明 为 文本型)

	如果 条件 = 假 则
		引擎.置全局值("failure", 引擎.创建文本(说明))
		引擎.执行代码("throw new Error(failure)")
	结束 如果
结束 过程

过程 后台处理()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值

	引擎.销毁()
	引擎 = 创建 QuickJS实例
	运行时 = 引擎.取运行时()
	变量 异常 为 QuickJS错误

	如果 操作 = 0 则
		临时引用1 = 引擎.执行代码(输入代码)
		记录("输入结果：" & 临时引用1.到文本())
	否则如果 操作 = 9 则
		数值主题()
		对象主题()
		回调主题()
		承诺主题()
		模块主题()
		二进制主题()
		隔离主题()
		错误主题()
		宿主主题()
		扩展模块主题()
		调度主题()
	否则
		判断 操作
			分支 1
				数值主题()
			分支 2
				对象主题()
			分支 3
				回调主题()
			分支 4
				承诺主题()
			分支 5
				模块主题()
			分支 6
				二进制主题()
			分支 7
				隔离主题()
			分支 8
				错误主题()
			分支 10
				宿主主题()
			分支 11
				扩展模块主题()
			分支 12
				调度主题()
		结束 判断
	结束 如果
	引擎.销毁()
	投递消息("完成", 报告)
	位于 错误
		分支 QuickJS错误
			输出错误("QuickJS示例", 引擎.取最近错误())
			异常 = 引擎.取最近异常()
			如果 异常 <> 空 则
				输出错误("QuickJS示例", 异常.取堆栈())
				报告 = 报告 & "中断原因：" & 异常.取原因() & "，" & 异常.取说明()
			结束 如果
			引擎.销毁()
			投递消息("失败", 报告)
		分支 否则
			引擎.销毁()
			投递消息("失败", 报告 & "宿主调用失败，请查看运行日志。")
	结束 错误
结束 过程

过程 数值主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 简单数组 为 变体型(3)
	变量 转换数组 为 QuickJS数组
	变量 转换值 为 QuickJS值
	变量 大数 为 QuickJS值
	变量 文本 为 QuickJS值
	变量 符号 为 QuickJS值
	变量 副本 为 QuickJS值
	变量 和 为 QuickJS值

	简单数组(0) = 42
	简单数组(1) = "中文"
	转换值 = 引擎.生成值(简单数组)
	转换数组 = 转换值.到数组()
	核对(转换数组.取长度() = 3, "Simple 变体数组")

	转换值 = 引擎.创建小数(-2147483648.75)
	核对(转换值.到整数() = -2147483648, "小数向零截断边界")

	大数 = 引擎.创建大整数("123456789012345678901234567890")
	核对(大数.是否大整数(), "BigInt 类型")
	和 = 大数.计算("+", 大数)
	核对(和.到文本() = "246913578024691357802469135780", "BigInt 精度")

	文本 = 引擎.创建文本("中文😀" & 字符(0) & "末尾")
	核对(文本.到文本() = "中文😀" & 字符(0) & "末尾", "UTF-16 往返")
	临时引用1 = 引擎.创建未定义()
	核对(临时引用1.是否未定义(), "undefined")
	临时引用2 = 引擎.创建空值()
	核对(临时引用2.是否空值(), "null")

	符号 = 引擎.取全局符号("ES4A")
	核对(符号.是否符号(), "Symbol")
	副本 = 符号.保留()
	核对(符号.是否相同(副本), "保留引用")

	引擎.启用扩展数值()
	引擎.启用扩展数值()
	转换值 = 引擎.执行代码("1.25m+2.75m")
	核对(转换值.取类型() = 14, "BigDecimal")
	核对(转换值.到文本() = "4", "BigDecimal 精度")
	转换值 = 引擎.执行代码("1.25l+2.75l")
	核对(转换值.取类型() = 13, "BigFloat")

	记录("01 BigInt 相加：" & 和.到文本() & "；中文😀及零字符往返：完成")

	大数.释放()
	和.释放()
	文本.释放()
	符号.释放()
	副本.释放()
结束 过程

过程 对象主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用3 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用4 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用5 为 simple.library.wsd.quickjs.QuickJS数组
	变量 临时引用6 为 simple.library.wsd.quickjs.QuickJS值
	变量 对象值 为 QuickJS对象
	变量 数组值 为 QuickJS数组
	变量 符号 为 QuickJS值
	变量 数字 为 QuickJS值
	变量 移除值 为 QuickJS数组

	对象值 = 引擎.创建对象()
	对象值.置简单成员("name", "ES4A")
	临时引用1 = 对象值.取成员("name")
	核对(临时引用1.到文本() = "ES4A", "属性读写")

	对象值.置成员("missing", 空)
	临时引用2 = 对象值.取成员("missing")
	核对(临时引用2.是否未定义(), "值空引用表示 undefined")
	对象值.置简单成员("nil", 空)
	临时引用3 = 对象值.取成员("nil")
	核对(临时引用3.是否空值(), "Simple 空转换为 JS null")

	符号 = 引擎.创建符号("隐藏键")
	数字 = 引擎.创建小数(42)
	对象值.置键值(符号, 数字)
	临时引用4 = 对象值.取键值(符号)
	核对(临时引用4.到整数() = 42, "Symbol 键")
	临时引用5 = 对象值.取自有键()
	核对(临时引用5.取长度() = 4, "所有自有键")

	数组值 = 引擎.创建数组()
	数组值.置简单项目(0, "甲")
	数组值.追加(数字)
	数组值.插入(1, 数字)
	移除值 = 数组值.移除(1, 1)
	核对(数组值.连接文本("|") = "甲|42", "数组 splice")
	核对(移除值.取长度() = 1, "移除结果")

	引擎.置全局值("sample", 对象值)
	临时引用6 = 引擎.执行资产("objects.js")
	临时引用6.释放()
	集合与描述()

	记录("02 数组：" & 数组值.连接文本("|") & "；对象属性和集合：完成")

	对象值.释放()
	数组值.释放()
	符号.释放()
	数字.释放()
	移除值.释放()
结束 过程

过程 回调主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用3 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用4 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用5 为 simple.library.wsd.quickjs.QuickJS值
	变量 抛出回调 为 宿主抛出
	变量 日志 为 宿主日志
	变量 回调 为 宿主加法
	变量 函数值 为 QuickJS函数
	变量 结果 为 QuickJS值
	变量 参数 为 变体型(2)

	日志 = 创建 宿主日志
	引擎.置日志接收器(日志)

	回调 = 创建 宿主加法
	回调.引擎 = 引擎
	引擎.注册函数("hostAdd", 回调)

	抛出回调 = 创建 宿主抛出
	抛出回调.引擎 = 引擎
	引擎.注册函数("hostThrow", 抛出回调)
	临时引用1 = 引擎.执行代码("try{hostThrow({code:42})}catch(e){if(e.code!==42)throw Error('宿主异常类型');globalThis.thrownCode=e.code}")
	临时引用1.释放()
	临时引用2 = 引擎.取全局值("thrownCode")
	核对(临时引用2.到整数() = 42, "宿主抛出原始 JS 值")

	结果 = 引擎.执行代码("hostAdd(20,22)")
	核对(结果.到整数() = 42, "JS 调 Simple")

	临时引用3 = 引擎.执行代码("(a,b)=>a*b")
	函数值 = 临时引用3.到函数()
	参数(0) = 6
	参数(1) = 7
	临时引用4 = 函数值.调用(参数)
	核对(临时引用4.到整数() = 42, "Simple 调 JS")

	临时引用5 = 引擎.执行代码("console.log('Simple 与 JS 互调完成😀')")
	临时引用5.释放()
	核对(日志.次数 = 1, "console 回调")
	回调回收(回调)

	记录("03 JS 调 Simple：" & 结果.到文本() & "；Simple 调 JS：42")
	结果.释放()
	函数值.释放()
结束 过程

过程 承诺主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用3 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用4 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用5 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用6 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用7 为 simple.library.wsd.quickjs.QuickJS值
	变量 后续 为 QuickJS承诺
	变量 失败承诺 为 QuickJS承诺
	变量 恢复函数 为 QuickJS函数
	变量 函数引用 为 QuickJS值
	变量 拒绝监听 为 宿主拒绝
	变量 承诺值 为 QuickJS控制器
	变量 结果 为 QuickJS承诺
	变量 任务数 为 整数型

	拒绝监听 = 创建 宿主拒绝
	引擎.置监听(拒绝监听)

	承诺值 = 引擎.创建控制器()
	结果 = 承诺值.取承诺()

	引擎.置全局值("hostPromise", 结果)
	临时引用1 = 引擎.执行代码("globalThis.answer=0; hostPromise.then(v=>answer=v+1)")
	临时引用1.释放()
	承诺值.兑现(引擎.创建小数(41))
	任务数 = 运行时.执行任务(100)
	临时引用2 = 引擎.取全局值("answer")
	核对(临时引用2.到整数() = 42, "宿主兑现")
	核对(结果.取状态() = 1, "Promise 状态")

	后续 = 结果.接续(空, 空)
	后续 = 后续.最终处理(空)
	任务数 = 运行时.执行任务(100)
	临时引用3 = 后续.取结果()
	核对(临时引用3.到整数() = 41, "空处理器传递兑现值")

	临时引用4 = 引擎.执行资产("async.js")
	临时引用4.释放()
	任务数 = 运行时.执行任务(100)
	临时引用5 = 引擎.取全局值("asyncAnswer")
	核对(临时引用5.到整数() = 42, "async/await")
	核对(拒绝监听.拒绝次数 = 1, "未处理拒绝通知")
	核对(拒绝监听.处理次数 = 1, "拒绝已处理通知")

	函数引用 = 引擎.执行代码("reason=>reason*2")
	恢复函数 = 函数引用.到函数()
	临时引用6 = 引擎.执行代码("Promise.reject(21)")
	失败承诺 = 临时引用6.到承诺()
	后续 = 失败承诺.捕获拒绝(恢复函数)
	任务数 = 运行时.执行任务(100)
	临时引用7 = 后续.取结果()
	核对(临时引用7.到整数() = 42, "拒绝恢复")

	记录("04 承诺：41；异步结果与拒绝恢复：42")
	结果.释放()
	承诺值.释放()
结束 过程

过程 模块主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用3 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用4 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用5 为 simple.library.wsd.quickjs.QuickJS值
	变量 命名空间 为 QuickJS对象
	变量 字节码 为 字节型()
	变量 任务数 为 整数型
	变量 加载器 为 模块来源

	加载器 = 创建 模块来源
	引擎.置加载器(加载器)
	引擎.注册模块("math/add.js", "export const add=(a,b)=>a+b")
	临时引用1 = 引擎.执行模块("import {add} from './math/add.js'; import {factor} from 'settings'; export const result=add(20,22)*factor", "entry.js")
	临时引用1.释放()
	任务数 = 运行时.执行任务(100)
	命名空间 = 引擎.取模块命名空间("entry.js")
	临时引用2 = 命名空间.取成员("result")
	核对(临时引用2.到整数() = 84, "ESModule 与自定义加载")

	字节码 = 引擎.编译代码("21*2", "compiled.js")
	临时引用3 = 引擎.执行字节码(字节码)
	核对(临时引用3.到整数() = 42, "脚本字节码")

	字节码 = 引擎.编译模块("export const number=42", "binary-module.js")
	引擎.注册模块字节码("binary-module.js", 字节码)
	临时引用4 = 引擎.执行模块("import {number} from './binary-module.js';globalThis.moduleAnswer=number", "consumer.js")
	临时引用4.释放()
	任务数 = 运行时.执行任务(100)
	临时引用5 = 引擎.取全局值("moduleAnswer")
	核对(临时引用5.到整数() = 42, "模块字节码")

	记录("05 模块结果：84；脚本与模块字节码：42")

	命名空间.释放()
结束 过程

过程 二进制主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 字节 为 字节型(4)
	变量 输出字节 为 字节型()
	变量 缓冲 为 QuickJS对象
	变量 视图 为 QuickJS对象
	变量 原值 为 QuickJS值
	变量 副本 为 QuickJS值

	字节(0) = 1
	字节(1) = 42
	字节(2) = 3
	字节(3) = 4

	缓冲 = 引擎.创建缓冲区(字节)
	视图 = 引擎.从缓冲区创建类型数组(1, 缓冲, 1, 2)
	输出字节 = 视图.到字节集()
	核对(输出字节(0) = 42, "TypedArray 可见范围")

	引擎.置全局值("typedView", 视图)
	临时引用1 = 引擎.执行代码("Object.defineProperty(typedView,'buffer',{value:new ArrayBuffer(1)});Object.defineProperty(typedView,'byteLength',{value:0})")
	临时引用1.释放()
	输出字节 = 视图.到字节集()
	核对(输出字节(0) = 42, "视图内建数据不受自有属性覆盖影响")

	视图 = 引擎.创建数据视图(缓冲, 1, 2)
	输出字节 = 视图.到字节集()
	核对(输出字节(1) = 3, "DataView 可见范围")

	原值 = 引擎.执行代码("(()=>{const b=new SharedArrayBuffer(2);new Uint8Array(b)[0]=42;return b})()")
	输出字节 = 原值.到字节集()
	核对(输出字节(0) = 42, "SharedArrayBuffer")

	原值 = 引擎.执行代码("(()=>{const a={name:'中文😀',big:12345678901234567890n};a.self=a;return a})()")
	输出字节 = 引擎.序列化值(原值)
	副本 = 引擎.反序列化值(输出字节)
	引擎.置全局值("clone", 副本)
	临时引用2 = 引擎.执行代码("clone.self===clone && clone.big===12345678901234567890n")
	核对(临时引用2.到逻辑(), "循环数据序列化")

	记录("06 视图字节：42、3；循环引用和 BigInt 序列化：完成")

	缓冲.释放()
	视图.释放()
	原值.释放()
	副本.释放()
结束 过程

过程 隔离主题()
	变量 临时引用1 为 simple.library.wsd.quickjs.QuickJS值
	变量 临时引用2 为 simple.library.wsd.quickjs.QuickJS值
	变量 共享运行时 为 QuickJS运行时
	变量 实例一 为 QuickJS实例
	变量 实例二 为 QuickJS实例
	变量 原值 为 QuickJS值
	变量 副本 为 QuickJS值
	变量 统计 为 QuickJS内存

	共享运行时 = 创建 QuickJS运行时
	实例一 = 共享运行时.创建实例()
	实例二 = 共享运行时.创建实例()
	原值 = 实例一.执行代码("globalThis.privateValue=42;({a:42})")
	副本 = 原值.复制到(实例二)
	实例二.置全局值("shared", 副本)
	临时引用1 = 实例二.执行代码("typeof privateValue==='undefined' && shared.a===42")
