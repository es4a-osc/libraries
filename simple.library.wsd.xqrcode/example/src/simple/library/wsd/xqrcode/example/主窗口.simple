别名 二维码错误 = simple.library.wsd.xqrcode.二维码错误

''' 三个场景共用普通 Simple Activity；扫描窗口移出界面时会释放相机。
变量 演示扫码错误 为 逻辑型
变量 生成页 为 生成窗口
变量 图片页 为 识别窗口
变量 扫描页 为 扫描窗口
变量 生成已创建 为 逻辑型
变量 图片已创建 为 逻辑型
变量 扫描已创建 为 逻辑型

事件 生成演示.被单击()
	如果 取反 生成已创建 则
		生成页 = 创建 生成窗口
		生成页.来源 = 主窗口
		生成已创建 = 真
	结束 如果
	切换窗口(生成页)
结束 事件

事件 识别演示.被单击()
	如果 取反 图片已创建 则
		图片页 = 创建 识别窗口
		图片页.来源 = 主窗口
		图片已创建 = 真
	结束 如果
	切换窗口(图片页)
结束 事件

事件 扫描演示.被单击()
	如果 取反 扫描已创建 则
		扫描页 = 创建 扫描窗口
		扫描页.来源 = 主窗口
		扫描已创建 = 真
	结束 如果
	切换窗口(扫描页)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		终止()
	结束 如果
结束 事件

事件 错误处理.被单击()
	演示扫码错误 = 取反 演示扫码错误
	如果 演示扫码错误 则
		展示扫码框错误()
	否则
		展示二维码错误()
	结束 如果
结束 事件

过程 展示二维码错误()
	生命周期二维码.销毁()
	变量 数量 为 整数型
	数量 = 生命周期二维码.异步任务数
	错误说明.文本 = "当前数量=" & 数量
	位于 错误
		分支 二维码错误
			错误说明.文本 = "已捕获二维码错误：二维码组件销毁后拒绝访问。"
		分支 否则
			错误说明.文本 = "遇到其它错误。"
	结束 错误
结束 过程

过程 展示扫码框错误()
	生命周期扫码框.销毁()
	变量 受理 为 逻辑型
	受理 = 生命周期扫码框.暂停扫描()
	错误说明.文本 = "暂停受理=" & 受理
	位于 错误
		分支 二维码错误
			错误说明.文本 = "已捕获二维码错误：扫码框销毁后拒绝访问。"
		分支 否则
			错误说明.文本 = "遇到其它错误。"
	结束 错误
结束 过程

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "主窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 标题 $为 标签
			文本 = "XQRCode · 二维码"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "生成、图像识别和相机扫描。生成与图片识别无需相机权限。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 生成演示行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 生成演示 $为 按钮
				文本 = "01  生成二维码"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 生成说明 $为 标签
			文本 = "普通码、图标、艺术背景、矩形画布、同步及异步操作。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 识别演示行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 识别演示 $为 按钮
				文本 = "02  图片识别"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 识别说明 $为 标签
			文本 = "资产、字节、系统选图；格式筛选、旋转图片、失败与取消。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 扫描演示行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 扫描演示 $为 按钮
				文本 = "03  相机扫描"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 扫描说明 $为 标签
			文本 = "独立扫码页和内嵌扫码框；单次、连续、暂停、补光及样式。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 条件 $为 标签
			文本 = "相机演示需要可用相机及授权；同一时刻仅一个预览占用相机。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 错误处理 $为 按钮
			文本 = "04  错误处理"
			宽度 = 长度_匹配父级
			高度 = "44dp"
			字体大小 = 13
		$结束 $定义
		$定义 错误说明 $为 标签
			文本 = "点击演示销毁后访问的错误捕获；不启动相机。"
			宽度 = 长度_匹配父级
			字体大小 = 14
		$结束 $定义
		$定义 生命周期二维码 $为 simple.library.wsd.xqrcode.二维码
		$结束 $定义
		$定义 生命周期扫码框 $为 simple.library.wsd.xqrcode.扫码框
			宽度 = 0
			高度 = 0
			可视 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
