''' 生成成功的 PNG 存入私有目录；通过完整路径交给图片框，不要求存储权限。

变量 来源 为 主窗口
变量 配置 为 simple.library.wsd.xqrcode.XQRC二维码配置
变量 识别配置 为 simple.library.wsd.xqrcode.XQRC扫码配置
变量 当前请求 为 整数型
变量 图片数据 为 字节型()
变量 完成次数 为 整数型
变量 失败次数 为 整数型
变量 取消次数 为 整数型
变量 当前文件 为 文本型

事件 生成窗口.初始化()
	配置 = 创建 simple.library.wsd.xqrcode.XQRC二维码配置
	识别配置 = 创建 simple.library.wsd.xqrcode.XQRC扫码配置
	更新计数()
结束 事件

过程 更新计数()
	计数.文本 = "完成=" & 完成次数 & "；失败=" & 失败次数 & "；取消=" & 取消次数 & "；待处理=" & 编码器.异步任务数
结束 过程

过程 准备配置(样式 为 整数型)
	配置 = 创建 simple.library.wsd.xqrcode.XQRC二维码配置
	配置.尺寸 = 480
	如果 样式 = 1 则 配置.图标图片 = "logo.png"
	如果 样式 = 2 则
		配置.背景图片 = "background.png"
		配置.数据点比例 = 0.6
		配置.白色边缘 = 真
		配置.自动取色 = 假
		配置.二值化 = 灰度.选中
		配置.二值化阈值 = 140
		配置.深色 = -16777216
		配置.浅色 = -1
	结束 如果
	如果 样式 = 3 则
		配置.图像宽度 = 640
		配置.图像高度 = 400
		配置.边距 = 20
		配置.图标图片 = "logo.png"
		配置.图标比例 = 0.16
	结束 如果
结束 过程

过程 提交生成(样式 为 整数型)
	准备配置(样式)
	如果 同步.选中 则
		图片数据 = 编码器.生成二维码(内容.文本, 配置)
		完成次数 = 完成次数 + 1
		显示图片(图片数据)
		反馈.文本 = "同步生成完成；PNG=" & 取字节集长度(图片数据)
	否则
		当前请求 = 编码器.异步生成(内容.文本, 配置)
		反馈.文本 = "已提交生成 #" & 当前请求
	结束 如果
	更新计数()
	位于 错误
		分支 否则
			失败次数 = 失败次数 + 1
			反馈.文本 = "同步生成失败，请检查内容与配置。"
			更新计数()
	结束 错误
结束 过程

事件 普通码.被单击()
	提交生成(0)
结束 事件

事件 图标码.被单击()
	提交生成(1)
结束 事件

事件 艺术码.被单击()
	提交生成(2)
结束 事件

事件 矩形码.被单击()
	提交生成(3)
结束 事件

事件 取消任务.被单击()
	变量 已取消 为 逻辑型
	已取消 = 编码器.取消任务(当前请求)
	反馈.文本 = "取消 #" & 当前请求 & "：" & 已取消
	更新计数()
结束 事件

事件 往返识别.被单击()
	如果 取字节集长度(图片数据) = 0 则
		反馈.文本 = "请先生成图片。"
		退出 事件
	结束 如果
	当前请求 = 编码器.异步识别字节图片(图片数据, 识别配置)
	反馈.文本 = "正在识别刚生成的 PNG #" & 当前请求
	更新计数()
结束 事件

事件 批量生成.被单击()
	准备配置(0)
	配置.尺寸 = 1024
	变量 索引 为 整数型
	循环 索引 = 1 至 7
		当前请求 = 编码器.异步生成(内容.文本 & " #" & 索引, 配置)
	下个 索引
	反馈.文本 = "已连续提交七次；队列满时按请求返回失败。"
	更新计数()
结束 事件

事件 空内容.被单击()
	准备配置(0)
	当前请求 = 编码器.异步生成("", 配置)
结束 事件

事件 编码器.生成完成(请求序号 为 整数型, 数据 为 字节型())
	完成次数 = 完成次数 + 1
	图片数据 = 数据
	显示图片(数据)
	反馈.文本 = "生成完成 #" & 请求序号 & "；PNG=" & 取字节集长度(数据) & " 字节"
	更新计数()
结束 事件

过程 显示图片(数据 为 字节型())
	变量 文件列表 为 文本型()
	变量 索引 为 整数型
	如果 创建目录("xqrcode") 且 写出字节文件("xqrcode/generated.png", 数据) 则
		文件列表 = 取文件列表("xqrcode")
		循环 索引 = 0 至 取数组成员数(文件列表) - 1
			如果 取文本右边(文件列表(索引), 13) = "generated.png" 则
				当前文件 = 文件列表(索引)
				预览.图片 = 当前文件
			结束 如果
		下个 索引
	结束 如果
结束 过程

事件 编码器.识别完成(请求序号 为 整数型, 结果 为 simple.library.wsd.xqrcode.XQRC识别结果)
	反馈.文本 = "识别 #" & 请求序号 & "：" & 结果.格式 & "\n" & 结果.内容 & "\n有效位=" & 结果.有效位数 & "；坐标数=" & 取数组成员数(结果.识别点)
	更新计数()
结束 事件

事件 编码器.任务失败(请求序号 为 整数型, 操作 为 文本型, 原因 为 文本型)
	失败次数 = 失败次数 + 1
	反馈.文本 = 操作 & "失败 #" & 请求序号 & "：" & 原因
	更新计数()
结束 事件

事件 编码器.任务取消(请求序号 为 整数型, 操作 为 文本型)
	取消次数 = 取消次数 + 1
	反馈.文本 = 操作 & "已取消 #" & 请求序号
	更新计数()
结束 事件

事件 提交并取消.被单击()
	准备配置(0)
	配置.尺寸 = 1024
	当前请求 = 编码器.异步生成(内容.文本, 配置)
	变量 接受 为 逻辑型
	接受 = 编码器.取消任务(当前请求)
	反馈.文本 = "提交后立即取消 #" & 当前请求 & "：" & 接受
	更新计数()
结束 事件

过程 离开页面()
	变量 索引 为 整数型
	循环 索引 = 1 至 当前请求
		编码器.取消任务(索引)
	下个 索引
	切换窗口(来源)
结束 过程

事件 返回.被单击()
	离开页面()
结束 事件

事件 生成窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		离开页面()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 生成窗口 $为 窗口
		标题 = "生成窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 返回行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 内容 $为 编辑框
			文本 = "你好，ES4A！https://example.com/二维码"
			宽度 = 长度_匹配父级
			高度 = "56dp"
		$结束 $定义
		$定义 普通码行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 普通码 $为 按钮
				文本 = "普通码"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
			$定义 图标码 $为 按钮
				文本 = "中心图标"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 艺术码行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 艺术码 $为 按钮
				文本 = "艺术背景"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
			$定义 矩形码 $为 按钮
				文本 = "矩形画布"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 同步 $为 复选框
			文本 = "同步调用（小图使用）"
			选中 = 假
		$结束 $定义
		$定义 灰度 $为 复选框
			文本 = "艺术背景二值化"
			选中 = 假
		$结束 $定义
		$定义 往返识别行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 往返识别 $为 按钮
				文本 = "识别生成图"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
			$定义 取消任务 $为 按钮
				文本 = "取消最近请求"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 批量生成行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 批量生成 $为 按钮
				文本 = "连续提交七次"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
			$定义 空内容 $为 按钮
				文本 = "空内容失败"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
			$定义 提交并取消 $为 按钮
				文本 = "提交并取消"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 计数 $为 标签
			文本 = "完成=0；失败=0；取消=0"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "输入内容后选择生成样式；异步结果在主线程事件中返回。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "6dp"
			底填充 = "6dp"
		$结束 $定义
		$定义 预览 $为 图片框
			宽度 = 长度_匹配父级
			高度 = "280dp"
			显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
		$结束 $定义
		$定义 编码器 $为 simple.library.wsd.xqrcode.XQRC二维码
		$结束 $定义
	$结束 $定义
$结束 $属性
