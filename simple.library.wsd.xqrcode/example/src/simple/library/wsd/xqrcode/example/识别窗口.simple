''' 未授权的绝对路径可能不可读；系统选图使用临时内容 URI，无需广泛存储权限。

变量 来源 为 主窗口
变量 配置 为 XQRC扫码配置
变量 当前请求 为 整数型
变量 完成次数 为 整数型
变量 失败次数 为 整数型
变量 取消次数 为 整数型

事件 识别窗口.初始化()
	配置 = 创建 XQRC扫码配置
	更新计数()
结束 事件

过程 准备配置()
	配置 = 创建 XQRC扫码配置
	配置.返回识别图像 = 返回图片.选中
	如果 仅二维码.选中 则
		变量 格式 为 文本型(1)
		格式(0) = "QR_CODE"
		配置.置识别格式(格式)
	结束 如果
结束 过程

过程 更新计数()
	计数.文本 = "成功=" & 完成次数 & "；失败=" & 失败次数 & "；取消=" & 取消次数 & "；待处理=" & 识别器.异步任务数
结束 过程

过程 识别路径(图片路径 为 文本型)
	准备配置()
	路径.文本 = 图片路径
	当前请求 = 识别器.异步识别图片(图片路径, 配置)
	反馈.文本 = "正在识别 #" & 当前请求
	更新计数()
结束 过程

事件 资产二维码.被单击()
	识别路径("qr-unicode.png")
结束 事件

事件 旋转码.被单击()
	识别路径("qr-rotated.png")
结束 事件

事件 条形码.被单击()
	识别路径("code128.png")
结束 事件

事件 数据矩阵.被单击()
	识别路径("datamatrix.png")
结束 事件

事件 文件路径.被单击()
	识别路径(路径.文本)
结束 事件

事件 系统选图.被单击()
	准备配置()
	当前请求 = 识别器.选择图片识别(配置)
	反馈.文本 = "选图请求 #" & 当前请求 & "；0 表示上次选择器尚未返回。"
	更新计数()
结束 事件

事件 同步识别.被单击()
	准备配置()
	变量 结果 为 XQRC识别结果
	结果 = 识别器.识别图片(路径.文本, 配置)
	显示结果(0, 结果)
	位于 错误
		分支 否则
			失败次数 = 失败次数 + 1
			反馈.文本 = "同步识别失败，请检查路径、格式和图片。"
			更新计数()
	结束 错误
结束 事件

事件 取消请求.被单击()
	变量 接受 为 逻辑型
	接受 = 识别器.取消任务(当前请求)
	反馈.文本 = "取消请求 #" & 当前请求 & "：" & 接受
	更新计数()
结束 事件

过程 显示结果(序号 为 整数型, 结果 为 XQRC识别结果)
	完成次数 = 完成次数 + 1
	反馈.文本 = "成功 #" & 序号 & " · " & 结果.格式 & "\n" & 结果.内容 & "\n原始字节=" & 取字节集长度(结果.原始字节) & "；有效位=" & 结果.有效位数 & "\n坐标分量数=" & 取数组成员数(结果.识别点) & "；PNG=" & 取字节集长度(结果.识别图像) & "\n时间=" & 结果.时间戳 & "\n附加信息=" & 结果.附加信息
	更新计数()
结束 过程

事件 识别器.识别完成(请求序号 为 整数型, 结果 为 XQRC识别结果)
	显示结果(请求序号, 结果)
结束 事件

事件 识别器.任务失败(请求序号 为 整数型, 操作 为 文本型, 原因 为 文本型)
	失败次数 = 失败次数 + 1
	反馈.文本 = 操作 & "失败 #" & 请求序号 & "：" & 原因
	更新计数()
结束 事件

事件 识别器.任务取消(请求序号 为 整数型, 操作 为 文本型)
	取消次数 = 取消次数 + 1
	反馈.文本 = 操作 & "已取消 #" & 请求序号
	更新计数()
结束 事件

过程 离开页面()
	识别器.取消全部任务()
	切换窗口(来源)
结束 过程

事件 返回.被单击()
	离开页面()
结束 事件

事件 识别窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		离开页面()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 识别窗口 $为 窗口
		标题 = "识别窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		背景颜色 = -1
		$定义 返回行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 路径 $为 编辑框
			文本 = "qr-unicode.png"
			宽度 = 长度_匹配父级
			高度 = "52dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 资产二维码行 $为 面板
					布局 = 布局_线性
					布局.方向 = 布局_方向_水平
					宽度 = 长度_匹配父级
					$定义 资产二维码 $为 按钮
						文本 = "中文二维码"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
					$定义 旋转码 $为 按钮
						文本 = "旋转图片"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
				$结束 $定义
				$定义 条形码行 $为 面板
					布局 = 布局_线性
					布局.方向 = 布局_方向_水平
					宽度 = 长度_匹配父级
					$定义 条形码 $为 按钮
						文本 = "CODE_128"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
					$定义 数据矩阵 $为 按钮
						文本 = "DATA_MATRIX"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
				$结束 $定义
				$定义 文件路径行 $为 面板
					布局 = 布局_线性
					布局.方向 = 布局_方向_水平
					宽度 = 长度_匹配父级
					$定义 文件路径 $为 按钮
						文本 = "识别路径"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
					$定义 系统选图 $为 按钮
						文本 = "系统选图"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
				$结束 $定义
				$定义 同步识别行 $为 面板
					布局 = 布局_线性
					布局.方向 = 布局_方向_水平
					宽度 = 长度_匹配父级
					$定义 同步识别 $为 按钮
						文本 = "同步识别"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
					$定义 取消请求 $为 按钮
						文本 = "取消请求"
						宽度 = 0
						权重 = 1
						高度 = "46dp"
						字体大小 = 13
					$结束 $定义
				$结束 $定义
				$定义 仅二维码 $为 复选框
					文本 = "只允许 QR_CODE"
					选中 = 假
				$结束 $定义
				$定义 返回图片 $为 复选框
					文本 = "返回识别图像与坐标"
					选中 = 真
				$结束 $定义
				$定义 条件 $为 标签
					文本 = "路径支持资产名、asset://、绝对路径、file:// 和 content://；不自动打开识别出的链接。"
					宽度 = 长度_匹配父级
					字体大小 = 14
					顶填充 = "5dp"
					底填充 = "5dp"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 计数 $为 标签
			文本 = "成功=0；失败=0；取消=0"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "5dp"
			底填充 = "5dp"
			高度 = "30dp"
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "选择一张图片进行识别。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "5dp"
			底填充 = "5dp"
			高度 = "156dp"
		$结束 $定义
		$定义 识别器 $为 simple.library.wsd.xqrcode.XQRC二维码
		$结束 $定义
	$结束 $定义
$结束 $属性
