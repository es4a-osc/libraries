别名 FTP错误 = simple.library.wsd.ftpclient.FTP错误
别名 FTP远程文件 = simple.library.wsd.ftpclient.FTP远程文件
变量 来源 为 主窗口
变量 主机 为 文本型
变量 端口 为 整数型
变量 用户 为 文本型
变量 密码 为 文本型
变量 指纹 为 文本型
变量 忙 为 逻辑型

过程 配置连接(服务器 为 文本型, 服务器端口 为 整数型, 用户名 为 文本型, 口令 为 文本型, 公钥 为 文本型)
	主机 = 服务器
	端口 = 服务器端口
	用户 = 用户名
	密码 = 口令
	指纹 = 公钥
结束 过程

事件 返回按钮.被单击()
	客户端.销毁()
	切换窗口(来源)
结束 事件

事件 流分页窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		客户端.销毁()
		切换窗口(来源)
	结束 如果
结束 事件

过程 提交(操作 为 整数型)
	如果 忙 或 (客户端.忙 且 操作 <> 6) 则
		状态.文本 = "连接正忙；请等待任务结束，或先关闭数据流。"
		退出 过程
	结束 如果
	变量 参数 为 变体型(3)
	参数(0) = 操作
	参数(1) = 路径.文本
	参数(2) = 文件名.文本
	忙 = 真
	状态.文本 = "正在后台执行……"
	启动线程(本对象, "执行后台", 参数)
	位于 错误
		分支 否则
			忙 = 假
			状态.文本 = "未能启动后台操作。"
	结束 错误
结束 过程

事件 流分页窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙 = 假
	状态.文本 = 内容
结束 事件
变量 分页 为 simple.library.wsd.ftpclient.FTP分页列表
变量 输入流 为 simple.library.wsd.ftpclient.FTP输入流
变量 输出流 为 simple.library.wsd.ftpclient.FTP输出流
变量 ASCII结果 为 文本型

事件 连接按钮.被单击()
	提交(1)
结束 事件

事件 写字节按钮.被单击()
	提交(2)
结束 事件

事件 读字节按钮.被单击()
	提交(3)
结束 事件

事件 写流按钮.被单击()
	提交(4)
结束 事件

事件 读流按钮.被单击()
	提交(5)
结束 事件

事件 关流按钮.被单击()
	提交(6)
结束 事件

事件 分页按钮.被单击()
	提交(7)
结束 事件

事件 下页按钮.被单击()
	提交(8)
结束 事件

事件 上页按钮.被单击()
	提交(9)
结束 事件

事件 ASCII按钮.被单击()
	提交(10)
结束 事件

过程 执行后台(操作 为 变体型, 目录 为 变体型, 名称 为 变体型)
	变量 内容 为 文本型
	变量 清单 为 FTP远程文件()
	变量 条目 为 FTP远程文件
	变量 索引 为 整数型
	变量 数据 为 字节型()
	判断 操作
		分支 1
			客户端.连接(主机, 端口)
			客户端.登录(用户, 密码)
			内容 = "已登录。"
		分支 2
			客户端.上传字节(名称, 文本到字节("ES4A FTP 字节演示：中文 😀"))
			内容 = "字节上传已由服务器确认。"
		分支 3
			数据 = 客户端.下载字节(名称, 65536)
			内容 = "字节数=" & 取数组成员数(数据) & "；正文=" & 字节到文本(数据)
		分支 4
			输出流 = 客户端.取文件输出流(名称, 0)
			输出流.写出(文本到字节("ES4A FTP 流演示：中文 😀"))
			输出流.关闭()
			内容 = "输出流已完成=" & 输出流.已完成
		分支 5
			输入流 = 客户端.取文件输入流(名称, 0)
			数据 = 输入流.读入(65536)
			内容 = "读到=" & 字节到文本(数据) & "；此时连接仍被流占用，下一步请关闭。"
		分支 6
			输入流.关闭()
			内容 = "输入流已完成=" & 输入流.已完成
		分支 7
			分页 = 客户端.取分页文件(目录)
			内容 = "分页已创建；翻页在本地执行，不再次请求服务器。"
		分支 8
			清单 = 分页.取下一页(2)
			内容 = "下一页条目=" & 取数组成员数(清单) & "；还有下一页=" & 分页.有下一页
		分支 9
			清单 = 分页.取上一页(2)
			内容 = "上一页条目=" & 取数组成员数(清单)
		分支 10
			客户端.文件类型 = simple.library.wsd.ftpclient.FTP常量.文件类型_ASCII
			客户端.上传字节("ascii.txt", 文本到字节("第一行\n第二行\n"))
			数据 = 客户端.下载字节("ascii.txt", 65536)
			内容 = "ASCII 往返字节=" & 取数组成员数(数据) & "；正文=" & 字节到文本(数据)
			投递消息("进行中", 内容 & "；正在下载转换后的文本文件。")
			客户端.下载文件("ascii.txt", "ftp-example/ascii.txt", 0)
			退出 过程
		分支 11
			客户端.文件类型 = simple.library.wsd.ftpclient.FTP常量.文件类型_二进制
			内容 = ASCII结果 & "；已恢复二进制模式。"
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 FTP错误
			投递消息("错误", "库报告：" & 客户端.错误信息)
		分支 否则
			投递消息("错误", "操作未完成，请检查路径、连接、权限及服务能力。")
	结束 错误
结束 过程

事件 客户端.传输完成(编号 为 长整数型, 方向 为 整数型, 来自 为 文本型, 目标 为 文本型, 成功 为 逻辑型, 已取消 为 逻辑型, 说明 为 文本型)
	ASCII结果 = "ASCII 文件下载成功=" & 成功 & "；" & 说明
	如果 成功 则
		ASCII结果 = ASCII结果 & "；本地字节=" & 取文件尺寸("ftp-example/ascii.txt")
		ASCII结果 = ASCII结果 & "；内容摘要一致=" & (取MD5值(读入字节文件("ftp-example/ascii.txt")) = 取MD5值(文本到字节("第一行\n第二行\n")))
	结束 如果
	忙 = 假
	提交(11)
结束 事件
$属性
	$资源 $窗口
	$定义 流分页窗口 $为 窗口
		标题 = "流分页窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		$定义 客户端 $为 simple.library.wsd.ftpclient.FTP客户端
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "字节演示限于小文件；流独占连接，必须关闭。读流示例针对本页生成的小文件。分页只读本地游标。ASCII 会转换换行，偏移续传仅用于二进制模式。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 路径 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "分页目录，可为空文本"
			单行模式 = 真
		$结束 $定义
		$定义 文件名 $为 编辑框
			文本 = "stream.txt"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "字节及流演示文件"
			单行模式 = 真
		$结束 $定义
		$定义 按钮行1 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 连接按钮 $为 按钮
				文本 = "连接并登录"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 写字节按钮 $为 按钮
				文本 = "上传小文件字节"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行2 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 读字节按钮 $为 按钮
				文本 = "下载小文件字节"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 写流按钮 $为 按钮
				文本 = "打开、写出并关闭输出流"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行3 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 读流按钮 $为 按钮
				文本 = "打开输入流并读取一块"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 关流按钮 $为 按钮
				文本 = "关闭输入流并确认完成"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行4 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 分页按钮 $为 按钮
				文本 = "取得目录分页"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 下页按钮 $为 按钮
				文本 = "下一页两项"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行5 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 上页按钮 $为 按钮
				文本 = "上一页两项"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 ASCII按钮 $为 按钮
				文本 = "ASCII 文本换行往返"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "请先连接。同步网络操作由示例放在后台线程。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 按钮行6 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回按钮 $为 按钮
				文本 = "返回目录并释放连接"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
