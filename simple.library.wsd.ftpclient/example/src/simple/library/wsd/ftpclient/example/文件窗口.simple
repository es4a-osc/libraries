别名 FTP错误 = simple.library.wsd.ftpclient.FTP错误
别名 FTP远程文件 = simple.library.wsd.ftpclient.FTP远程文件
变量 来源 为 主窗口
变量 主机 为 文本型
变量 端口 为 整数型
变量 用户 为 文本型
变量 密码 为 文本型
变量 指纹 为 文本型
变量 忙 为 逻辑型

过程 配置连接(服务器 为 文本型, 服务器端口 为 整数型, 用户名 为 文本型, 口令 为 文本型, 公钥 为 文本型)
	主机 = 服务器
	端口 = 服务器端口
	用户 = 用户名
	密码 = 口令
	指纹 = 公钥
结束 过程

事件 返回按钮.被单击()
	客户端.销毁()
	切换窗口(来源)
结束 事件

事件 文件窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		客户端.销毁()
		切换窗口(来源)
	结束 如果
结束 事件

过程 提交(操作 为 整数型)
	如果 忙 或 客户端.忙 则
		状态.文本 = "连接正忙；请等待任务结束，或先关闭数据流。"
		退出 过程
	结束 如果
	变量 参数 为 变体型(3)
	参数(0) = 操作
	参数(1) = 路径.文本
	参数(2) = 文件名.文本
	忙 = 真
	状态.文本 = "正在后台执行……"
	启动线程(本对象, "执行后台", 参数)
	位于 错误
		分支 否则
			忙 = 假
			状态.文本 = "未能启动后台操作。"
	结束 错误
结束 过程

事件 文件窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙 = 假
	状态.文本 = 内容
结束 事件

事件 连接按钮.被单击()
	提交(1)
结束 事件

事件 列表按钮.被单击()
	提交(2)
结束 事件

事件 建目录按钮.被单击()
	提交(3)
结束 事件

事件 详情按钮.被单击()
	提交(4)
结束 事件

事件 改名按钮.被单击()
	提交(5)
结束 事件

事件 删文件按钮.被单击()
	提交(6)
结束 事件

事件 删目录按钮.被单击()
	提交(7)
结束 事件

事件 工作目录按钮.被单击()
	提交(8)
结束 事件

过程 执行后台(操作 为 变体型, 目录 为 变体型, 名称 为 变体型)
	变量 内容 为 文本型
	变量 清单 为 FTP远程文件()
	变量 条目 为 FTP远程文件
	变量 索引 为 整数型
	变量 数据 为 字节型()
	判断 操作
		分支 1
			客户端.连接(主机, 端口)
			客户端.登录(用户, 密码)
			内容 = "已登录，目录=" & 客户端.取工作目录()
		分支 2
			清单 = 客户端.取文件列表(目录)
			内容 = "共 " & 取数组成员数(清单) & " 项"
			循环 索引 = 0 至 取数组成员数(清单) - 1
				条目 = 清单(索引)
				内容 = 内容 & "\n" & 条目.名称 & " / " & 条目.尺寸 & " 字节 / 类型=" & 条目.类型
			下个 索引
		分支 3
			客户端.创建目录(目录)
			内容 = "已创建目录：" & 目录
		分支 4
			条目 = 客户端.取文件信息(目录 & "/" & 名称)
			内容 = 条目.名称 & "；字节=" & 条目.尺寸 & "；修改毫秒=" & 条目.修改时间 & "；目录=" & 条目.为目录 & "；链接=" & 条目.为链接
		分支 5
			客户端.重命名(目录 & "/" & 名称, 目录 & "/renamed.txt")
			内容 = "已重命名为 renamed.txt。"
		分支 6
			客户端.删除文件(目录 & "/" & 名称)
			内容 = "已删除指定文件。"
		分支 7
			客户端.删除目录(目录)
			内容 = "已删除空目录。"
		分支 8
			客户端.置工作目录(目录)
			内容 = "工作目录=" & 客户端.取工作目录()
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 FTP错误
			投递消息("错误", "库报告：" & 客户端.错误信息)
		分支 否则
			投递消息("错误", "操作未完成，请检查路径、连接、权限及服务能力。")
	结束 错误
结束 过程
$属性
	$资源 $窗口
	$定义 文件窗口 $为 窗口
		标题 = "文件窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		$定义 客户端 $为 simple.library.wsd.ftpclient.FTP客户端
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "路径由你填写；列表返回文件对象，而非拼接文本。变更只作用于指定路径。删除目录要求为空。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 路径 $为 编辑框
			文本 = "es4a-demo"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "目录路径，空文本为当前目录"
			单行模式 = 真
		$结束 $定义
		$定义 文件名 $为 编辑框
			文本 = "demo.txt"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "目录中的文件名"
			单行模式 = 真
		$结束 $定义
		$定义 连接按钮 $为 按钮
			文本 = "连接并登录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 列表按钮 $为 按钮
			文本 = "读取目录列表"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 建目录按钮 $为 按钮
			文本 = "创建指定目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 详情按钮 $为 按钮
			文本 = "查看指定文件信息"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 改名按钮 $为 按钮
			文本 = "将文件重命名为 renamed.txt"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 删文件按钮 $为 按钮
			文本 = "删除指定文件"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 删目录按钮 $为 按钮
			文本 = "删除指定空目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 工作目录按钮 $为 按钮
			文本 = "切换到指定目录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "请先连接。同步网络操作由示例放在后台线程。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 返回按钮 $为 按钮
			文本 = "返回目录并释放连接"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
