别名 FTP错误 = simple.library.wsd.ftpclient.FTP错误
别名 FTP远程文件 = simple.library.wsd.ftpclient.FTP远程文件
变量 来源 为 主窗口
变量 主机 为 文本型
变量 端口 为 整数型
变量 用户 为 文本型
变量 密码 为 文本型
变量 指纹 为 文本型
变量 忙 为 逻辑型

过程 配置连接(服务器 为 文本型, 服务器端口 为 整数型, 用户名 为 文本型, 口令 为 文本型, 公钥 为 文本型)
	主机 = 服务器
	端口 = 服务器端口
	用户 = 用户名
	密码 = 口令
	指纹 = 公钥
结束 过程

事件 返回按钮.被单击()
	客户端.销毁()
	切换窗口(来源)
结束 事件

事件 连接窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		客户端.销毁()
		切换窗口(来源)
	结束 如果
结束 事件

过程 提交(操作 为 整数型)
	如果 忙 或 客户端.忙 则
		状态.文本 = "连接正忙；请等待任务结束，或先关闭数据流。"
		退出 过程
	结束 如果
	变量 参数 为 变体型(3)
	参数(0) = 操作
	参数(1) = 路径.文本
	参数(2) = 文件名.文本
	忙 = 真
	状态.文本 = "正在后台执行……"
	启动线程(本对象, "执行后台", 参数)
	位于 错误
		分支 否则
			忙 = 假
			状态.文本 = "未能启动后台操作。"
	结束 错误
结束 过程

事件 连接窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙 = 假
	状态.文本 = 内容
结束 事件

事件 连接按钮.被单击()
	提交(1)
结束 事件

事件 状态按钮.被单击()
	提交(2)
结束 事件

事件 被动按钮.被单击()
	提交(3)
结束 事件

事件 主动按钮.被单击()
	提交(4)
结束 事件

事件 断开按钮.被单击()
	提交(5)
结束 事件

过程 执行后台(操作 为 变体型, 目录 为 变体型, 名称 为 变体型)
	变量 内容 为 文本型
	变量 清单 为 FTP远程文件()
	变量 条目 为 FTP远程文件
	变量 索引 为 整数型
	变量 数据 为 字节型()
	判断 操作
		分支 1
			客户端.启用命令事件 = 真
			客户端.连接(主机, 端口)
			客户端.登录(用户, 密码)
			内容 = "已连接并登录，目录=" & 客户端.取工作目录()
		分支 2
			客户端.保持连接()
			内容 = "NOOP 已确认；系统=" & 客户端.取系统类型() & "；答复=" & 客户端.取答复码()
		分支 3
			客户端.被动模式()
			清单 = 客户端.取文件列表("")
			内容 = "被动模式列表=" & 取数组成员数(清单) & "；数据地址=" & 客户端.取被动主机地址() & ":" & 客户端.取被动主机端口()
		分支 4
			客户端.置主动端口范围(39140, 39140)
			如果 目录 <> "" 则 客户端.置主动外部地址(目录)
			客户端.主动模式()
			清单 = 客户端.取文件列表("")
			内容 = "主动模式列表=" & 取数组成员数(清单) & "；之后可切回被动模式。"
		分支 5
			客户端.断开连接()
			内容 = "连接已断开。"
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 FTP错误
			投递消息("错误", "库报告：" & 客户端.错误信息)
		分支 否则
			投递消息("错误", "操作未完成，请检查路径、连接、权限及服务能力。")
	结束 错误
结束 过程

事件 客户端.传输命令(命令 为 文本型, 消息 为 文本型, 答复码 为 整数型, 是否接收 为 逻辑型)
	命令记录.文本 = 消息
结束 事件

事件 异步连接按钮.被单击()
	客户端.启用命令事件 = 真
	状态.文本 = "异步连接已受理=" & 客户端.开始连接(主机, 端口)
	位于 错误
		分支 否则
			状态.文本 = "未受理：" & 客户端.错误信息
	结束 错误
结束 事件

事件 客户端.连接完成(编号 为 长整数型, 成功 为 逻辑型, 说明 为 文本型)
	状态.文本 = "连接任务=" & 编号 & "；成功=" & 成功 & "；" & 说明
	如果 成功 则
		变量 参数 为 变体型(0)
		启动线程(本对象, "异步登录", 参数)
	结束 如果
结束 事件

过程 异步登录()
	客户端.登录(用户, 密码)
	投递消息("完成", "异步连接回调后，已在后台完成登录。")
	位于 错误
		分支 否则
			投递消息("错误", "登录失败：" & 客户端.错误信息)
	结束 错误
结束 过程
$属性
	$资源 $窗口
	$定义 连接窗口 $为 窗口
		标题 = "连接窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		$定义 客户端 $为 simple.library.wsd.ftpclient.FTP客户端
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "连接和登录是两个步骤；本页将同步调用放到后台，命令事件回到界面。默认 UTF-8、被动模式和二进制传输。主动模式要求服务器能回连指定端口，本页使用 39140。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 路径 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "主动模式可选对外地址，通常留空"
			单行模式 = 真
		$结束 $定义
		$定义 文件名 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "本页未使用此参数"
			单行模式 = 真
		$结束 $定义
		$定义 连接按钮 $为 按钮
			文本 = "连接并登录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 异步连接按钮 $为 按钮
			文本 = "异步连接并通过回调登录"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 状态按钮 $为 按钮
			文本 = "NOOP 与服务器系统信息"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 被动按钮 $为 按钮
			文本 = "切换被动模式并读取列表"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 主动按钮 $为 按钮
			文本 = "切换主动模式并读取列表"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 断开按钮 $为 按钮
			文本 = "断开连接"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 命令记录 $为 标签
			文本 = "启用后显示最近一条控制命令或答复；密码会隐藏。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "请先连接。同步网络操作由示例放在后台线程。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 返回按钮 $为 按钮
			文本 = "返回目录并释放连接"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
