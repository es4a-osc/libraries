''' FTP/SFTP 同一份演示；同步方法移到后台线程，异步传输只根据完成事件报告结果。
''' 仅在专用演示目录操作；本地文件位于应用私有 ftp-example，无需额外存储权限。
''' SFTP 首次连接必须核对服务端公布的 SHA256 公钥指纹，不要直接接受未知服务器。
变量 忙 为 逻辑型
变量 远程目录快照 为 文本型
变量 远程文件快照 为 文本型
变量 上传次数 为 整数型
变量 下载次数 为 整数型

事件 SFTP模式.状态改变()
	如果 SFTP模式.选中 则
		端口.文本 = "22"
	否则
		端口.文本 = "21"
	结束 如果
结束 事件

事件 登录按钮.被单击()
	提交操作(1)
结束 事件

事件 准备按钮.被单击()
	提交操作(2)
结束 事件

事件 建目录.被单击()
	提交操作(3)
结束 事件

事件 列目录.被单击()
	提交操作(4)
结束 事件

事件 改名按钮.被单击()
	提交操作(5)
结束 事件

事件 删除文件按钮.被单击()
	提交操作(6)
结束 事件

事件 删除目录按钮.被单击()
	提交操作(7)
结束 事件

事件 断开按钮.被单击()
	提交操作(8)
结束 事件

事件 核验按钮.被单击()
	提交操作(9)
结束 事件

过程 更新可用()
	服务器.启用 = 忙 = 假
	端口.启用 = 忙 = 假
	用户名.启用 = 忙 = 假
	口令.启用 = 忙 = 假
	SFTP模式.启用 = 忙 = 假
	演示目录.启用 = 忙 = 假
	远程文件.启用 = 忙 = 假
结束 过程

函数 检查格式(内容 为 文本型, 表达式 为 文本型) 为 逻辑型
	变量 格式 为 simple.runtime.collections.正则表达式
	格式 = 创建 simple.runtime.collections.正则表达式
	格式.编译(表达式)
	格式.匹配(内容)
	检查格式 = 格式.匹配下一个()
结束 函数

' 远程文件字段仅接受单个名称，核验时也不能借名称跳出私有下载目录。
函数 有效文件名(名称 为 文本型) 为 逻辑型
	有效文件名 = 名称 <> "" 且 名称 <> "." 且 名称 <> ".." 且 寻找文本(名称, "/", 0) < 0 且 寻找文本(名称, "\\", 0) < 0
结束 函数

过程 提交操作(操作 为 整数型)
	如果 忙 则
		状态.文本 = "操作进行中，请等待完成；断开连接不是取消传输。"
		退出 过程
	结束 如果
	如果 检查格式(演示目录.文本, "^[A-Za-z0-9_-]+$") = 假 则
		状态.文本 = "远程演示目录请用单层字母、数字、下划线或连字符名称。"
		退出 过程
	结束 如果
	如果 有效文件名(远程文件.文本) = 假 则
		状态.文本 = "远程文件请填写单个文件名，不含路径分隔符，也不能为 . 或 ..。"
		退出 过程
	结束 如果
	如果 操作 = 1 则
		如果 服务器.文本 = "" 或 用户名.文本 = "" 则
			状态.文本 = "请填写专用服务器地址和账号；地址不含 ftp:// 或 sftp://。"
			退出 过程
		结束 如果
		如果 检查格式(端口.文本, "^[0-9]{1,5}$") = 假 则
			状态.文本 = "端口须为 1 至 65535 的整数。"
			退出 过程
		结束 如果
		如果 到整数(端口.文本) < 1 或 到整数(端口.文本) > 65535 则
			状态.文本 = "端口须为 1 至 65535 的整数。"
			退出 过程
		结束 如果
		如果 SFTP模式.选中 则
			客户端.协议 = 客户端.协议_SFTP
		否则
			客户端.协议 = 客户端.协议_FTP
		结束 如果
	结束 如果
	远程目录快照 = 演示目录.文本
	远程文件快照 = 远程文件.文本
	变量 参数 为 变体型(7)
	参数(0) = 操作
	参数(1) = 服务器.文本
	参数(2) = 端口.文本
	参数(3) = 用户名.文本
	参数(4) = 口令.文本
	参数(5) = 远程目录快照
	参数(6) = 远程文件快照
	忙 = 真
	更新可用()
	状态.文本 = "后台操作进行中；SFTP 确认窗口出现时，请核实公钥。"
	启动线程(本对象, "执行后台", 参数)
	位于 错误
		分支 否则
			忙 = 假
			更新可用()
			状态.文本 = "无法启动操作，请检查输入。"
	结束 错误
结束 过程

过程 执行后台(操作 为 变体型, 主机 为 变体型, 端口值 为 变体型, 用户 为 变体型, 密码值 为 变体型, 目录 为 变体型, 文件名 为 变体型)
	变量 内容 为 文本型
	变量 标签 为 文本型
	变量 成功 为 逻辑型
	标签 = "完成"
	判断 操作
		分支 1
			成功 = 客户端.登录服务器(主机, 到整数(端口值), 用户, 密码值)
			内容 = "登录结果：" & 成功 & "；本地连接状态：" & 客户端.取连接状态()
			如果 成功 则 内容 = 内容 & "；工作目录：" & 客户端.取工作目录()
		分支 2
			如果 创建目录("ftp-example") = 假 且 路径是否存在("ftp-example") = 假 则
				投递消息("完成", "无法创建应用私有演示目录。")
				退出 过程
			结束 如果
			成功 = 写出文本文件("ftp-example/upload.txt", "ES4A FTP/SFTP 演示：中文与表情 😀\n", "UTF-8")
			内容 = "准备本地文件：" & 成功
			如果 成功 则 内容 = 内容 & "；实际字节=" & 取文件尺寸("ftp-example/upload.txt") & "；MD5=" & 取MD5值(读入字节文件("ftp-example/upload.txt"))
		分支 3
			内容 = "创建远程演示目录：" & 客户端.创建目录("", 目录) & "；若目录已存在，请点击列表核对。"
		分支 4
			内容 = "目录列表（每行 名称/字节数/是否目录；空目录和失败都可能为空）：\n" & 客户端.取文件列表(目录)
		分支 5
			成功 = 客户端.重命名(目录, 文件名, "renamed.txt")
			内容 = "重命名为 renamed.txt：" & 成功
			如果 成功 则 标签 = "改名成功"
		分支 6
			内容 = "删除远程演示文件：" & 客户端.删除文件(目录, 文件名)
		分支 7
			内容 = "删除远程空目录：" & 客户端.删除目录("", 目录)
		分支 8
			客户端.断开连接()
			内容 = "已断开，本地连接状态：" & 客户端.取连接状态()
		分支 9
			如果 路径是否存在("ftp-example/upload.txt") = 假 或 路径是否存在("ftp-example/download/" & 文件名) = 假 则
				投递消息("完成", "请先准备本地文件，并将对应远程文件下载回来。")
				退出 过程
			结束 如果
			如果 取文件尺寸("ftp-example/download/" & 文件名) > 1048576 则
				投递消息("完成", "核验仅用于不超过 1 MiB 的演示文件，不一次读入更大文件。")
				退出 过程
			结束 如果
			变量 原摘要 为 文本型
			变量 下载摘要 为 文本型
			原摘要 = 取MD5值(读入字节文件("ftp-example/upload.txt"))
			下载摘要 = 取MD5值(读入字节文件("ftp-example/download/" & 文件名))
			内容 = "下载实际字节=" & 取文件尺寸("ftp-example/download/" & 文件名) & "；原文件 MD5=" & 原摘要 & "；下载 MD5=" & 下载摘要 & "；摘要一致=" & (原摘要 = 下载摘要)
	结束 判断
	如果 操作 <> 2 且 操作 <> 9 且 客户端.错误信息 <> "" 则 内容 = 内容 & "\n库报告：" & 客户端.错误信息
	投递消息(标签, 内容)
	位于 错误
		分支 否则
			投递消息("完成", "操作异常，请检查服务器、路径、权限与本地文件。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙 = 假
	更新可用()
	如果 消息标记 = "改名成功" 则 远程文件.文本 = "renamed.txt"
	状态.文本 = 附加参数
结束 事件

事件 上传按钮.被单击()
	如果 忙 则 退出 事件
	如果 检查格式(演示目录.文本, "^[A-Za-z0-9_-]+$") = 假 或 有效文件名(远程文件.文本) = 假 则
		状态.文本 = "请填写单层演示目录和单个远程文件名，不使用路径分隔符。"
		退出 事件
	结束 如果
	忙 = 真
	更新可用()
	状态.文本 = "请求后台上传本地 upload.txt；接受任务不代表上传成功。"
	如果 客户端.开始上传("ftp-example", "upload.txt", 演示目录.文本) = 假 则
		忙 = 假
		更新可用()
		状态.文本 = "上传任务未接受，不会收到完成事件。"
	结束 如果
结束 事件

事件 下载按钮.被单击()
	如果 忙 则 退出 事件
	如果 检查格式(演示目录.文本, "^[A-Za-z0-9_-]+$") = 假 或 有效文件名(远程文件.文本) = 假 则
		状态.文本 = "请填写单层演示目录和单个远程文件名，不使用路径分隔符。"
		退出 事件
	结束 如果
	忙 = 真
	更新可用()
	状态.文本 = "请求后台下载；会覆盖私有 download 目录内的同名文件。"
	如果 客户端.开始下载(演示目录.文本, 远程文件.文本, "ftp-example/download") = 假 则
		忙 = 假
		更新可用()
		状态.文本 = "下载任务未接受，不会收到完成事件。"
	结束 如果
结束 事件

事件 客户端.上传完毕(成功 为 逻辑型)
	忙 = 假
	更新可用()
	上传次数 = 上传次数 + 1
	统计.文本 = "实际完成事件：上传 " & 上传次数 & "；下载 " & 下载次数
	状态.文本 = "后台上传完成：" & 成功 & "；" & 客户端.错误信息
结束 事件

事件 客户端.下载完毕(成功 为 逻辑型)
	忙 = 假
	更新可用()
	下载次数 = 下载次数 + 1
	统计.文本 = "实际完成事件：上传 " & 上传次数 & "；下载 " & 下载次数
	状态.文本 = "后台下载完成：" & 成功 & "；" & 客户端.错误信息
结束 事件

事件 退出按钮.被单击()
	尝试退出()
结束 事件

过程 尝试退出()
	如果 忙 则
		状态.文本 = "请等待当前操作结束；公钥确认可选择拒绝，断开不是取消传输。"
		退出 过程
	结束 如果
	客户端.销毁()
	终止()
结束 过程

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		尝试退出()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "FTP 与 SFTP 示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "登录、传输与核验"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "需专用演示服务器和账号。FTP 不加密；SFTP 需 Android 8.0+，首次连接必须核实公钥。仅在专用演示目录操作，传输失败可能留下部分文件。"
		$结束 $定义
		$定义 客户端 $为 simple.library.wsd.ftpclient.FTP客户端
		$结束 $定义
		$定义 SFTP模式 $为 复选框
			文本 = "使用 SFTP（否则使用 FTP）"
		$结束 $定义
		$定义 服务器 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "服务器主机名或 IP，不含协议前缀"
			文本 = ""
		$结束 $定义
		$定义 端口 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "端口"
			文本 = "21"
		$结束 $定义
		$定义 用户名 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "专用演示账号"
			文本 = ""
		$结束 $定义
		$定义 口令 $为 密码编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示 = "密码（不保存）"
		$结束 $定义
		$定义 演示目录 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "远程单层演示目录"
			文本 = "es4a-example"
		$结束 $定义
		$定义 远程文件 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "远程文件名"
			文本 = "upload.txt"
		$结束 $定义
		$定义 登录行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 登录按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "登录服务器"
			$结束 $定义
			$定义 断开按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "断开连接"
			$结束 $定义
		$结束 $定义
		$定义 准备行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 准备按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "准备本地演示文件"
			$结束 $定义
			$定义 建目录 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "创建远程演示目录"
			$结束 $定义
		$结束 $定义
		$定义 传输行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 上传按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "后台上传 upload.txt"
			$结束 $定义
			$定义 下载按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "后台下载当前文件"
			$结束 $定义
		$结束 $定义
		$定义 查询行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 列目录 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "列出远程演示目录"
			$结束 $定义
			$定义 核验按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "核验下载文件 MD5"
			$结束 $定义
		$结束 $定义
		$定义 修改行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 改名按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "重命名为 renamed.txt"
			$结束 $定义
			$定义 删除文件按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "删除远程当前文件"
			$结束 $定义
		$结束 $定义
		$定义 删除目录按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "删除远程演示空目录"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "实际完成事件：上传 0；下载 0"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "先填写服务器和账号；准备本地文件，再登录、创建目录、上传和下载。"
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出并释放连接"
		$结束 $定义
	$结束 $定义
$结束 $属性
