''' FTP 与 SFTP 使用独立组件；先填写自己的测试服务设置，再进入各主题。

事件 连接入口.被单击()
	变量 页面 为 连接窗口
	页面 = 创建 连接窗口
	页面.来源 = 本对象
	页面.配置连接(服务器.文本, 到整数(FTP端口.文本), 用户名.文本, 口令.文本, 公钥指纹.文本)
	切换窗口(页面)
	位于 错误
		分支 否则
			说明.文本 = "无法打开主题页，请检查连接参数及系统版本。"
	结束 错误
结束 事件

事件 文件入口.被单击()
	变量 页面 为 文件窗口
	页面 = 创建 文件窗口
	页面.来源 = 本对象
	页面.配置连接(服务器.文本, 到整数(FTP端口.文本), 用户名.文本, 口令.文本, 公钥指纹.文本)
	切换窗口(页面)
	位于 错误
		分支 否则
			说明.文本 = "无法打开主题页，请检查连接参数及系统版本。"
	结束 错误
结束 事件

事件 传输入口.被单击()
	变量 页面 为 传输窗口
	页面 = 创建 传输窗口
	页面.来源 = 本对象
	页面.配置连接(服务器.文本, 到整数(FTP端口.文本), 用户名.文本, 口令.文本, 公钥指纹.文本)
	切换窗口(页面)
	位于 错误
		分支 否则
			说明.文本 = "无法打开主题页，请检查连接参数及系统版本。"
	结束 错误
结束 事件

事件 流入口.被单击()
	变量 页面 为 流分页窗口
	页面 = 创建 流分页窗口
	页面.来源 = 本对象
	页面.配置连接(服务器.文本, 到整数(FTP端口.文本), 用户名.文本, 口令.文本, 公钥指纹.文本)
	切换窗口(页面)
	位于 错误
		分支 否则
			说明.文本 = "无法打开主题页，请检查连接参数及系统版本。"
	结束 错误
结束 事件

事件 SFTP入口.被单击()
	变量 页面 为 SFTP窗口
	页面 = 创建 SFTP窗口
	页面.来源 = 本对象
	页面.配置连接(服务器.文本, 到整数(SFTP端口.文本), 用户名.文本, 口令.文本, 公钥指纹.文本)
	切换窗口(页面)
	位于 错误
		分支 否则
			说明.文本 = "无法打开主题页，请检查连接参数及系统版本。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "FTP客户端示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		$定义 标题 $为 标签
			文本 = "FTP客户端示例"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "每个主题页使用独立连接。请填写专用测试服务；演示会在指定路径创建、上传、改名和删除文件。SFTP 需 Android 8.0+，必须核对服务器公钥。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 服务器 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "服务器地址，不含协议前缀"
			单行模式 = 真
		$结束 $定义
		$定义 FTP端口 $为 编辑框
			文本 = "21"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "FTP 端口"
			单行模式 = 真
		$结束 $定义
		$定义 SFTP端口 $为 编辑框
			文本 = "22"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "SFTP 端口"
			单行模式 = 真
		$结束 $定义
		$定义 用户名 $为 编辑框
			文本 = "anonymous"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "用户名"
			单行模式 = 真
		$结束 $定义
		$定义 口令 $为 密码编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示 = "密码"
		$结束 $定义
		$定义 公钥指纹 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "SFTP 可选 SHA256 固定指纹；空白时请求确认"
			单行模式 = 真
		$结束 $定义
		$定义 连接入口 $为 按钮
			文本 = "01 连接、参数与命令事件"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 文件入口 $为 按钮
			文本 = "02 文件管理与结构化列表"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 传输入口 $为 按钮
			文本 = "03 文件传输、取消与续传"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 流入口 $为 按钮
			文本 = "04 字节、数据流与分页"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 SFTP入口 $为 按钮
			文本 = "05 SFTP 与服务器公钥校验"
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
