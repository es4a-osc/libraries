			布局.方向 = 布局_方向_水平
			$定义 返回按钮 $为 按钮
				文本 = "返回目录并释放连接"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
