别名 FTP错误 = simple.library.wsd.ftpclient.FTP错误
别名 FTP远程文件 = simple.library.wsd.ftpclient.FTP远程文件
变量 来源 为 主窗口
变量 主机 为 文本型
变量 端口 为 整数型
变量 用户 为 文本型
变量 密码 为 文本型
变量 指纹 为 文本型
变量 忙 为 逻辑型

过程 配置连接(服务器 为 文本型, 服务器端口 为 整数型, 用户名 为 文本型, 口令 为 文本型, 公钥 为 文本型)
	主机 = 服务器
	端口 = 服务器端口
	用户 = 用户名
	密码 = 口令
	指纹 = 公钥
结束 过程

事件 返回按钮.被单击()
	客户端.销毁()
	切换窗口(来源)
结束 事件

事件 SFTP窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		客户端.销毁()
		切换窗口(来源)
	结束 如果
结束 事件

过程 提交(操作 为 整数型)
	如果 忙 或 客户端.忙 则
		状态.文本 = "连接正忙；请等待任务结束，或先关闭数据流。"
		退出 过程
	结束 如果
	变量 参数 为 变体型(3)
	参数(0) = 操作
	参数(1) = 路径.文本
	参数(2) = 文件名.文本
	忙 = 真
	状态.文本 = "正在后台执行……"
	启动线程(本对象, "执行后台", 参数)
	位于 错误
		分支 否则
			忙 = 假
			状态.文本 = "未能启动后台操作。"
	结束 错误
结束 过程

事件 SFTP窗口.反馈消息(标记 为 变体型, 内容 为 变体型)
	忙 = 假
	状态.文本 = 内容
结束 事件
变量 本次上传路径 为 文本型

事件 连接按钮.被单击()
	提交(1)
结束 事件

事件 准备按钮.被单击()
	提交(2)
结束 事件

过程 执行后台(操作 为 变体型, 目录 为 变体型, 名称 为 变体型)
	变量 内容 为 文本型
	变量 清单 为 FTP远程文件()
	变量 条目 为 FTP远程文件
	变量 索引 为 整数型
	变量 数据 为 字节型()
	判断 操作
		分支 1
			客户端.服务器公钥指纹 = 指纹
			客户端.连接(主机, 端口, 用户, 密码)
			内容 = "已连接，目录=" & 客户端.取工作目录()
		分支 2
			如果 路径是否存在("ftp-example") = 假 则 创建目录("ftp-example")
			写出文本文件("ftp-example/upload.txt", "ES4A FTP/SFTP 文件验证：中文 😀\n", "UTF-8")
			内容 = "准备文件字节=" & 取文件尺寸("ftp-example/upload.txt") & "；MD5=" & 取MD5值(读入字节文件("ftp-example/upload.txt"))
		分支 4
			如果 路径是否存在("ftp-example") = 假 则 创建目录("ftp-example")
			如果 路径是否存在("ftp-example/tree") = 假 则 创建目录("ftp-example/tree")
			如果 路径是否存在("ftp-example/tree/sub") = 假 则 创建目录("ftp-example/tree/sub")
			写出文本文件("ftp-example/tree/one.txt", "目录根文件：中文", "UTF-8")
			写出文本文件("ftp-example/tree/sub/two.txt", "嵌套目录文件：😀", "UTF-8")
			内容 = "私有目录 ftp-example/tree 已准备，请指定远程目录后上传。"
		分支 5
			条目 = 客户端.取文件信息(名称)
			内容 = "上传续传已受理=" & 客户端.上传文件(本次上传路径, 名称, 条目.尺寸) & "；偏移=" & 条目.尺寸
		分支 3
			清单 = 客户端.取文件列表(目录)
			内容 = "共 " & 取数组成员数(清单) & " 项"
			循环 索引 = 0 至 取数组成员数(清单) - 1
				条目 = 清单(索引)
				内容 = 内容 & "\n" & 条目.名称 & " / " & 条目.尺寸 & " 字节 / 类型=" & 条目.类型
			下个 索引
	结束 判断
	投递消息("完成", 内容)
	位于 错误
		分支 FTP错误
			投递消息("错误", "库报告：" & 客户端.错误信息)
		分支 否则
			投递消息("错误", "操作未完成，请检查路径、连接、权限及服务能力。")
	结束 错误
结束 过程

事件 上传按钮.被单击()
	变量 编号 为 长整数型
	本次上传路径 = 本地路径.文本
	编号 = 客户端.上传文件(本次上传路径, 文件名.文本, 0)
	状态.文本 = "已受理上传任务 " & 编号
	位于 错误
		分支 否则
			状态.文本 = "未受理：" & 客户端.错误信息
	结束 错误
结束 事件

事件 下载按钮.被单击()
	开始下载(0)
结束 事件

事件 续传按钮.被单击()
	开始下载(客户端.取下载偏移("ftp-example/download.bin"))
结束 事件

过程 开始下载(偏移 为 长整数型)
	变量 编号 为 长整数型
	编号 = 客户端.下载文件(文件名.文本, "ftp-example/download.bin", 偏移)
	状态.文本 = "已受理下载 " & 编号 & "；偏移=" & 偏移
	位于 错误
		分支 否则
			状态.文本 = "未受理：" & 客户端.错误信息
	结束 错误
结束 过程

事件 取消按钮.被单击()
	状态.文本 = "取消受理=" & 客户端.取消传输() & "；等待终态事件，之后须重新连接。"
结束 事件

事件 客户端.传输进度(编号 为 长整数型, 方向 为 整数型, 来自 为 文本型, 目标 为 文本型, 完成字节 为 长整数型, 总字节 为 长整数型)
	进度.文本 = "任务 " & 编号 & "：" & 完成字节 & "/" & 总字节 & " 字节"
结束 事件

事件 客户端.传输完成(编号 为 长整数型, 方向 为 整数型, 来自 为 文本型, 目标 为 文本型, 成功 为 逻辑型, 已取消 为 逻辑型, 说明 为 文本型)
	状态.文本 = "任务=" & 编号 & "；成功=" & 成功 & "；取消=" & 已取消 & "；" & 说明 & "；目标=" & 目标
	如果 方向 = 0 且 目标 = "ftp-example/download.bin" 则
		状态.文本 = 状态.文本 & "；本地断点=" & 客户端.取下载偏移(目标)
	结束 如果
结束 事件

事件 准备目录按钮.被单击()
	提交(4)
结束 事件

事件 续传上传按钮.被单击()
	本次上传路径 = 本地路径.文本
	提交(5)
结束 事件

事件 目录上传按钮.被单击()
	状态.文本 = "目录上传已受理=" & 客户端.上传目录("ftp-example/tree", 路径.文本)
	位于 错误
		分支 否则
			状态.文本 = "未受理：" & 客户端.错误信息
	结束 错误
结束 事件

事件 目录下载按钮.被单击()
	变量 本地目录 为 文本型
	本地目录 = "ftp-example/tree-download-" & 取现行时间戳()
	状态.文本 = "目录下载已受理=" & 客户端.下载目录(路径.文本, 本地目录) & "；保存到=" & 本地目录
	位于 错误
		分支 否则
			状态.文本 = "未受理：" & 客户端.错误信息
	结束 错误
结束 事件

事件 列表按钮.被单击()
	提交(3)
结束 事件
$属性
	$资源 $窗口
	$定义 SFTP窗口 $为 窗口
		标题 = "SFTP窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "8dp"
		$定义 客户端 $为 simple.library.wsd.ftpclient.SFTP客户端
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "SFTP 需要 Android 8.0+。固定指纹必须严格匹配；留空时首次或公钥变化请求确认。取消后重新连接再续传；上传续传偏移取远程已有尺寸。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶边距 = "8dp"
			底边距 = "8dp"
		$结束 $定义
		$定义 路径 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "列表目录或目录传输路径；上传须不存在"
			单行模式 = 真
		$结束 $定义
		$定义 文件名 $为 编辑框
			文本 = "demo.txt"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "远程文件完整路径"
			单行模式 = 真
		$结束 $定义
		$定义 本地路径 $为 编辑框
			文本 = "ftp-example/upload.txt"
			宽度 = 长度_匹配父级
			高度 = "48dp"
			提示文本 = "本地上传源，相对应用私有 files 目录"
			单行模式 = 真
		$结束 $定义
		$定义 按钮行1 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 连接按钮 $为 按钮
				文本 = "连接并验证服务器公钥"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 准备按钮 $为 按钮
				文本 = "准备私有上传文件"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行2 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 上传按钮 $为 按钮
				文本 = "上传指定文件"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 下载按钮 $为 按钮
				文本 = "从头下载"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行3 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 取消按钮 $为 按钮
				文本 = "取消当前传输"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 续传按钮 $为 按钮
				文本 = "从本地断点继续下载"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行4 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 续传上传按钮 $为 按钮
				文本 = "从远程偏移继续上传"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
			$定义 准备目录按钮 $为 按钮
				文本 = "准备私有目录"
				宽度 = 0
				高度 = "48dp"
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 按钮行5 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
