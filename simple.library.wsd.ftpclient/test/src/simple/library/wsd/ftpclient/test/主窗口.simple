' FTP/SFTP 测试：同步网络方法在线程中执行，传输完成事件回到主线程。
变量 忙碌 为 逻辑型

过程 提交(操作 为 整数型)
	如果 忙碌 则
		结果.文本 = "操作进行中，请等待完成。"
		退出 过程
	结束 如果
	如果 操作 = 1 则
		如果 地址框.文本 = "" 则
			结果.文本 = "请先填写测试服务器地址、端口、用户名和密码。"
			退出 过程
		结束 如果
		如果 使用SFTP.选中 则
			FTP客户端1.协议 = FTP客户端1.协议_SFTP
		否则
			FTP客户端1.协议 = FTP客户端1.协议_FTP
		结束 如果
		FTP客户端1.服务器公钥指纹 = ""
		如果 高级指纹.选中 则 FTP客户端1.服务器公钥指纹 = 公钥框.文本
	结束 如果
	忙碌 = 真
	结果.文本 = "正在执行，请稍候。"
	如果 操作 = 8 则
		如果 FTP客户端1.开始上传("", 名称框.文本, 目录框.文本) = 假 则
			忙碌 = 假
			结果.文本 = "上传任务未接受。"
		结束 如果
		退出 过程
	结束 如果
	如果 操作 = 9 则
		如果 FTP客户端1.开始下载(目录框.文本, 名称框.文本, "ftp-download") = 假 则
			忙碌 = 假
			结果.文本 = "下载任务未接受。"
		结束 如果
		退出 过程
	结束 如果
	变量 参数 为 变体型(8)
	参数(0) = 操作
	参数(1) = 地址框.文本
	参数(2) = 端口框.文本
	参数(3) = 用户框.文本
	参数(4) = 密码框.文本
	参数(5) = 目录框.文本
	参数(6) = 名称框.文本
	参数(7) = 新名称框.文本
	启动线程(本对象, "后台操作", 参数)
	位于 错误
		分支 否则
			忙碌 = 假
			结果.文本 = "未能启动操作，请检查输入。"
	结束 错误
结束 过程

过程 后台操作(操作 为 变体型, 主机 为 变体型, 端口 为 变体型, 用户 为 变体型, 密码 为 变体型, 目录 为 变体型, 名称 为 变体型, 新名称 为 变体型)
	变量 内容 为 文本型
	变量 句柄 为 整数型
	判断 操作
		分支 1
			内容 = "登录结果：" & FTP客户端1.登录服务器(主机, 取整数(端口), 用户, 密码)
		分支 2
			内容 = "文件列表（空目录和失败都返回空文本）：\n" & FTP客户端1.取文件列表(目录)
		分支 3
			内容 = "创建目录：" & FTP客户端1.创建目录(目录, 名称)
		分支 4
			内容 = "重命名：" & FTP客户端1.重命名(目录, 名称, 新名称)
		分支 5
			内容 = "删除空目录：" & FTP客户端1.删除目录(目录, 名称)
		分支 6
			内容 = "删除文件：" & FTP客户端1.删除文件(目录, 名称)
		分支 7
			内容 = "本地连接状态：" & FTP客户端1.取连接状态() & "\n工作目录：" & FTP客户端1.取工作目录()
		分支 10
			如果 路径是否存在("es4a-ftp.bin") 则 删除普通文件("es4a-ftp.bin")
			句柄 = 打开文件("es4a-ftp.bin")
			写入文本(句柄, "Simple FTP 测试文件")
			关闭文件(句柄)
			句柄 = 0
			内容 = "已生成应用内部文件 es4a-ftp.bin。上传前将名称填写为 es4a-ftp.bin。"
		分支 11
			FTP客户端1.断开连接()
			内容 = "已断开连接。"
		分支 12
			内容 = "同步上传结果：" & FTP客户端1.上传文件("", 名称, 目录)
		分支 13
			内容 = "同步下载结果：" & FTP客户端1.下载文件(目录, 名称, "ftp-download")
	结束 判断
	如果 FTP客户端1.错误信息 <> "" 则 内容 = 内容 & "\n" & FTP客户端1.错误信息
	投递消息(1, 内容)
	位于 错误
		分支 否则
			如果 句柄 > 0 则 关闭文件(句柄)
			投递消息(1, "操作失败，请检查端口格式、连接、远程目录及本地文件。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙碌 = 假
	结果.文本 = 附加参数
结束 事件

事件 FTP客户端1.上传完毕(成功 为 逻辑型)
	忙碌 = 假
	结果.文本 = "后台上传完成：" & 成功
	如果 成功 = 假 则 结果.文本 = 结果.文本 & "\n" & FTP客户端1.错误信息
结束 事件

事件 FTP客户端1.下载完毕(成功 为 逻辑型)
	忙碌 = 假
	结果.文本 = "后台下载完成：" & 成功
	如果 成功 = 假 则 结果.文本 = 结果.文本 & "\n" & FTP客户端1.错误信息
	如果 成功 则 结果.文本 = 结果.文本 & "\n保存于应用内部 ftp-download 目录。"
结束 事件

事件 登录按钮.被单击()
	提交(1)
结束 事件

事件 列表按钮.被单击()
	提交(2)
结束 事件

事件 建目录按钮.被单击()
	提交(3)
结束 事件

事件 重命名按钮.被单击()
	提交(4)
结束 事件

事件 删空目录按钮.被单击()
	提交(5)
结束 事件

事件 删文件按钮.被单击()
	提交(6)
结束 事件

事件 状态目录按钮.被单击()
	提交(7)
结束 事件

事件 后台上传按钮.被单击()
	提交(8)
结束 事件

事件 后台下载按钮.被单击()
	提交(9)
结束 事件

事件 准备文件按钮.被单击()
	提交(10)
结束 事件

事件 断开按钮.被单击()
	提交(11)
结束 事件

事件 同步上传按钮.被单击()
	提交(12)
结束 事件

事件 同步下载按钮.被单击()
	提交(13)
结束 事件



过程 更新指纹输入()
	高级指纹.可视 = 使用SFTP.选中
	公钥说明.可视 = 假
	公钥框.可视 = 假
	如果 使用SFTP.选中 则
		公钥说明.可视 = 高级指纹.选中
		公钥框.可视 = 高级指纹.选中
	结束 如果
结束 过程

事件 高级指纹.状态改变()
	更新指纹输入()
结束 事件

事件 使用SFTP.状态改变()
	如果 使用SFTP.选中 则
		端口框.文本 = "22"
	否则
		端口框.文本 = "21"
	结束 如果
	更新指纹输入()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "FTP客户端测试"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 FTP客户端1 $为 simple.library.wsd.ftpclient.FTP客户端
		$结束 $定义
		$定义 说明 $为 标签
			单行模式 = 假
			文本 = "需专用 FTP/SFTP 服务器和账号；仅操作测试目录。上传下载应字节一致；另测错误密码、断开重连。SFTP 需 Android 8.0+。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 使用SFTP $为 复选框
			文本 = "使用 SFTP（Android 8.0+）"
			宽度 = 长度_匹配父级
			选中 = 假
		$结束 $定义
		$定义 高级指纹 $为 复选框
			文本 = "手动指定服务器指纹（高级）"
			宽度 = 长度_匹配父级
			选中 = 假
			可视 = 假
		$结束 $定义
		$定义 公钥说明 $为 标签
			文本 = "高级选项：指定可信公钥指纹后严格匹配。"
			宽度 = 长度_匹配父级
			单行模式 = 假
			可视 = 假
		$结束 $定义
		$定义 公钥框 $为 编辑框
			提示文本 = "可留空，首次连接会提示确认服务器"
			宽度 = 长度_匹配父级
			单行模式 = 真
			可视 = 假
		$结束 $定义
		$定义 地址框 $为 编辑框
			提示文本 = "服务器地址"
			文本 = ""
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 端口框 $为 编辑框
			提示文本 = "端口"
			文本 = "21"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 用户框 $为 编辑框
			提示文本 = "用户名"
			文本 = ""
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 密码说明 $为 标签
			文本 = "密码："
		$结束 $定义
		$定义 密码框 $为 密码编辑框
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 目录框 $为 编辑框
			提示文本 = "远程目录"
			文本 = "/"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 名称框 $为 编辑框
			提示文本 = "文件或目录名称"
			文本 = "es4a-ftp.bin"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 新名称框 $为 编辑框
			提示文本 = "重命名的新名称"
			文本 = "es4a-ftp-renamed.bin"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作行0 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 登录按钮 $为 按钮
				文本 = "登录"
			$结束 $定义
			$定义 列表按钮 $为 按钮
				文本 = "列表"
			$结束 $定义
			$定义 建目录按钮 $为 按钮
				文本 = "建目录"
			$结束 $定义
		$结束 $定义
		$定义 操作行3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 重命名按钮 $为 按钮
				文本 = "重命名"
			$结束 $定义
			$定义 删空目录按钮 $为 按钮
				文本 = "删空目录"
			$结束 $定义
			$定义 删文件按钮 $为 按钮
				文本 = "删文件"
			$结束 $定义
		$结束 $定义
		$定义 操作行6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 状态目录按钮 $为 按钮
				文本 = "状态目录"
			$结束 $定义
			$定义 后台上传按钮 $为 按钮
				文本 = "后台上传"
			$结束 $定义
			$定义 后台下载按钮 $为 按钮
				文本 = "后台下载"
			$结束 $定义
		$结束 $定义
		$定义 操作行9 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 准备文件按钮 $为 按钮
				文本 = "准备文件"
			$结束 $定义
			$定义 断开按钮 $为 按钮
				文本 = "断开"
			$结束 $定义
			$定义 同步上传按钮 $为 按钮
				文本 = "同步上传"
			$结束 $定义
		$结束 $定义
		$定义 操作行12 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 同步下载按钮 $为 按钮
				文本 = "同步下载"
			$结束 $定义
		$结束 $定义
		$定义 结果 $为 标签
			单行模式 = 假
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
	$结束 $定义
$结束 $属性
