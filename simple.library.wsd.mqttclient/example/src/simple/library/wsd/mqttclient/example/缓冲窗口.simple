别名 MQTT消息 = simple.library.wsd.mqttclient.MQTT消息
别名 MQTT缓冲选项 = simple.library.wsd.mqttclient.MQTT缓冲选项

变量 来源 为 主窗口

变量 序号 为 整数型

事件 启用缓冲.被单击()
	变量 选项 为 MQTT缓冲选项
	选项 = 创建 MQTT缓冲选项
	选项.启用 = 真
	选项.容量 = 2
	选项.持久化 = 真
	来源.通讯.设置离线缓冲(选项)
	来源.最近结果 = "已启用容量 2 的持久缓冲，队列满时本次发布失败。"
	位于 错误
		分支 否则
			来源.最近结果 = "设置未生效；须清空队列，且客户端启用持久存储。"
	结束 错误
结束 事件

事件 断开按钮.被单击()
	来源.通讯.断开(1000, "缓冲演示断开")
	位于 错误
		分支 否则
			来源.最近结果 = "等待当前操作结束后再断开。"
	结束 错误
结束 事件

事件 排队按钮.被单击()
	序号 = 序号 + 1
	变量 消息 为 MQTT消息
	消息 = 创建 MQTT消息
	消息.置文本("离线补发 #" & 序号)
	来源.通讯.发布(来源.主题名称, 消息, "缓冲 #" & 序号)
	来源.最近结果 = "已提交离线消息；查看队列数量和令牌结果。"
	位于 错误
		分支 否则
			来源.最近结果 = "排队未提交；须先成功连接过一次、启用缓冲并完成断开。"
	结束 错误
结束 事件

事件 查看队首.被单击()
	如果 来源.通讯.缓冲数量 > 0 则
		变量 消息 为 MQTT消息
		消息 = 来源.通讯.取缓冲消息(0)
		来源.最近结果 = "队首内容：[" & 消息.取文本() & "]；QoS：" & 消息.QoS
	否则
		来源.最近结果 = "离线队列为空。"
	结束 如果
结束 事件

事件 删除队首.被单击()
	如果 来源.通讯.缓冲数量 > 0 则 来源.通讯.删除缓冲消息(0)
	位于 错误
		分支 否则
			来源.最近结果 = "删除未完成；请断开后再操作。"
	结束 错误
结束 事件

事件 重新连接.被单击()
	来源.通讯.连接(来源.服务地址, 来源.客户标识, 来源.参数, "缓冲页重新连接")
	位于 错误
		分支 否则
			来源.最近结果 = "重新连接未提交，请检查当前状态。"
	结束 错误
结束 事件

事件 关闭客户端.被单击()
	来源.通讯.关闭("关闭后恢复持久队列")
	位于 错误
		分支 否则
			来源.最近结果 = "正在清理，请等待关闭完成。"
	结束 错误
结束 事件

过程 刷新()
	状态.文本 = 来源.取连接说明()
	结果.文本 = 来源.最近结果
	统计.文本 = "交付：" & 来源.交付次数 & "；收到：" & 来源.接收次数 & "；缓冲：" & 来源.通讯.缓冲数量 & "；掉线：" & 来源.丢失次数 & "；重连：" & 来源.重连次数

结束 过程

事件 缓冲窗口.切换完毕()

	刷新()
	页面刷新.启用 = 真
结束 事件

事件 缓冲窗口.即将切换()
	页面刷新.启用 = 假

结束 事件

事件 页面刷新.计时()
	刷新()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 缓冲窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 缓冲窗口 $为 窗口
		标题 = "离线缓冲与重连"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "离线缓冲与重连"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "先成功连接并订阅，再启用缓冲、正常断开，连续排队消息。重新连接后观察队列减少和交付；也可关闭客户端后使用同一 ID 恢复持久队列。"
		$结束 $定义
		$定义 启用缓冲 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "启用持久缓冲（容量 2）"
		$结束 $定义
		$定义 缓冲连接 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 断开按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "正常断开"
			$结束 $定义
			$定义 重新连接 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "重新连接"
			$结束 $定义
		$结束 $定义
		$定义 队列操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 排队按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "排队一条消息"
			$结束 $定义
			$定义 查看队首 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "查看队首"
			$结束 $定义
		$结束 $定义
		$定义 队列管理 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除队首 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "删除队首"
			$结束 $定义
			$定义 关闭客户端 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "关闭客户端"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "连接状态显示在这里。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "交付与实际接收分别统计。"
		$结束 $定义
		$定义 限制 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "缓冲容量以条计。持久补发可能重复，业务应自行去重；交付不代表业务处理成功。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 页面刷新 $为 计时器
			间隔 = 500
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
