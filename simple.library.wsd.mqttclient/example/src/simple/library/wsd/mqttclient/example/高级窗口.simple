别名 MQTT消息 = simple.library.wsd.mqttclient.MQTT消息
别名 MQTT令牌 = simple.library.wsd.mqttclient.MQTT令牌
别名 MQTTTLS配置 = simple.library.wsd.mqttclient.MQTTTLS配置

变量 来源 为 主窗口

事件 设置遗嘱.被单击()
	变量 消息 为 MQTT消息
	消息 = 创建 MQTT消息
	消息.置文本("客户端异常离线")
	消息.QoS = 1
	来源.参数.设置遗嘱(来源.主题名称 & "/遗嘱", 消息)
	来源.最近结果 = "下次连接将携带遗嘱；先正常断开，再连接以应用参数。"
结束 事件

事件 开始观察.被单击()
	观察者.连接(来源.服务地址, "es4a-observer-" & 生成GUID(), 来源.参数, "遗嘱观察连接")
	位于 错误
		分支 否则
			观察结果.文本 = "观察者正在使用中；离开本页会关闭它，稍后返回可再次连接。"
	结束 错误
结束 事件

事件 观察者.连接完成(重连 为 逻辑型, 地址 为 文本型)
	观察者.订阅(来源.主题名称 & "/遗嘱", 1, "遗嘱观察订阅")
结束 事件

事件 观察者.操作成功(令牌 为 MQTT令牌)
	观察结果.文本 = "观察者成功：" & 令牌.操作 & "；订阅成功后再强制断开主客户端。"
结束 事件

事件 观察者.操作失败(令牌 为 MQTT令牌)
	观察结果.文本 = "观察者失败：" & 令牌.操作 & "；" & 令牌.错误.说明
结束 事件

事件 观察者.收到消息(主题 为 文本型, 消息 为 MQTT消息)
	观察结果.文本 = "实际收到遗嘱：" & 主题 & "；内容：[" & 消息.取文本() & "]"
结束 事件

事件 强制按钮.被单击()
	来源.通讯.强制断开(0, 1000, 假, "不发送断开报文")
	位于 错误
		分支 否则
			来源.最近结果 = "当前无法强制断开，请等待连接操作结束。"
	结束 错误
结束 事件

事件 应用TLS.被单击()
	变量 配置 为 MQTTTLS配置
	配置 = 创建 MQTTTLS配置
	配置.信任库路径 = 信任库.文本
	配置.信任库类型 = "PKCS12"
	配置.信任库密码 = 信任密码.文本
	来源.参数.设置TLS(配置)
	来源.最近结果 = "TLS 参数供下次 ssl:// 连接使用；空路径使用系统信任。服务器证书及主机名始终校验。"
结束 事件

过程 刷新()
	状态.文本 = 来源.取连接说明()
	结果.文本 = 来源.最近结果
	统计.文本 = "交付：" & 来源.交付次数 & "；收到：" & 来源.接收次数 & "；缓冲：" & 来源.通讯.缓冲数量 & "；掉线：" & 来源.丢失次数 & "；重连：" & 来源.重连次数

结束 过程

事件 高级窗口.切换完毕()

	刷新()
	页面刷新.启用 = 真
结束 事件

事件 高级窗口.即将切换()
	页面刷新.启用 = 假
	如果 观察者.已创建 则 观察者.关闭("离开遗嘱页")
结束 事件

事件 页面刷新.计时()
	刷新()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 高级窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 高级窗口 $为 窗口
		标题 = "遗嘱与 TLS"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "遗嘱与 TLS"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "遗嘱：先设置，再重新连接主客户端；观察者订阅成功后强制断开主客户端。TLS：填写应用可读的 PKCS12 信任库，连接页改用 ssl:// 后重新连接。"
		$结束 $定义
		$定义 遗嘱参数 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 设置遗嘱 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "设置下次连接遗嘱"
			$结束 $定义
			$定义 开始观察 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "启动独立观察者"
			$结束 $定义
		$结束 $定义
		$定义 强制按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "强制断开主客户端（触发遗嘱）"
		$结束 $定义
		$定义 观察结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "尚未开始观察。"
		$结束 $定义
		$定义 信任库 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "可选：PKCS12 信任库绝对路径"
			文本 = ""
		$结束 $定义
		$定义 信任密码 $为 密码编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示 = "信任库密码，可空"
		$结束 $定义
		$定义 应用TLS $为 按钮
			宽度 = 长度_匹配父级
			文本 = "应用下次连接的 TLS 配置"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "连接状态显示在这里。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "交付与实际接收分别统计。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 页面刷新 $为 计时器
			间隔 = 500
			启用 = 假
		$结束 $定义
		$定义 观察者 $为 simple.library.wsd.mqttclient.MQTT客户端
		$结束 $定义
	$结束 $定义
$结束 $属性
