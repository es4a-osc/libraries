别名 MQTT消息 = simple.library.wsd.mqttclient.MQTT消息
别名 MQTT发送令牌 = simple.library.wsd.mqttclient.MQTT发送令牌

变量 来源 为 主窗口

变量 QoS 为 整数型
变量 保留标志 为 逻辑型
变量 二进制模式 为 逻辑型

事件 订阅按钮.被单击()
	来源.主题名称 = 主题.文本
	来源.需要订阅 = 真
	来源.通讯.订阅(来源.主题名称, 2, "单主题订阅")
	位于 错误
		分支 否则
			来源.最近结果 = "订阅未提交，请先连接并检查主题。"
	结束 错误
结束 事件

事件 批量按钮.被单击()
	来源.主题名称 = 主题.文本
	来源.需要订阅 = 真
	变量 列表 为 文本型(2)
	变量 等级 为 整数型(2)
	列表(0) = 来源.主题名称
	列表(1) = 来源.主题名称 & "/子主题"
	等级(0) = 1
	等级(1) = 2
	来源.通讯.批量订阅(列表, 等级, "批量订阅")
	位于 错误
		分支 否则
			来源.最近结果 = "批量订阅未提交，请先连接并检查主题。"
	结束 错误
结束 事件

事件 取消按钮.被单击()
	来源.需要订阅 = 假
	来源.通讯.取消订阅(主题.文本, "取消当前主题")
	位于 错误
		分支 否则
			来源.最近结果 = "取消订阅未提交，请检查连接；异步结果另由操作事件确认。"
	结束 错误
结束 事件

事件 QoS按钮.被单击()
	QoS = QoS + 1
	如果 QoS > 2 则 QoS = 0
	QoS按钮.文本 = "发布 QoS：" & QoS
结束 事件

事件 保留按钮.被单击()
	保留标志 = 取反 保留标志
	保留按钮.文本 = "保留：" & 保留标志
结束 事件

事件 内容按钮.被单击()
	二进制模式 = 取反 二进制模式
	内容按钮.文本 = "二进制模式：" & 二进制模式
结束 事件

事件 发布按钮.被单击()
	变量 消息 为 MQTT消息
	消息 = 创建 MQTT消息
	消息.QoS = QoS
	消息.保留 = 保留标志
	如果 二进制模式 则
		变量 数据 为 字节型(4)
		数据(0) = 0
		数据(1) = 1
		数据(2) = 127
		数据(3) = -1
		消息.内容 = 数据
	否则
		消息.置文本(内容.文本)
	结束 如果
	来源.主题名称 = 主题.文本
	来源.发送摘要 = 取MD5值(消息.内容)
	变量 令牌 为 MQTT发送令牌
	令牌 = 来源.通讯.发布(主题.文本, 消息, "收发页发布")
	来源.最近结果 = "提交发布 #" & 令牌.操作编号 & "；完成与实际接收分别观察。"
	位于 错误
		分支 否则
			来源.最近结果 = "发布未提交，请检查连接、主题和缓冲配置。"
	结束 错误
结束 事件

事件 清除保留.被单击()
	变量 消息 为 MQTT消息
	消息 = 创建 MQTT消息
	消息.QoS = 1
	消息.保留 = 真
	消息.清空内容()
	来源.通讯.发布(主题.文本, 消息, "删除服务器保留消息")
	位于 错误
		分支 否则
			来源.最近结果 = "清除保留消息未提交，请先连接。"
	结束 错误
结束 事件

过程 刷新()
	状态.文本 = 来源.取连接说明()
	结果.文本 = 来源.最近结果
	统计.文本 = "交付：" & 来源.交付次数 & "；收到：" & 来源.接收次数 & "；缓冲：" & 来源.通讯.缓冲数量 & "；掉线：" & 来源.丢失次数 & "；重连：" & 来源.重连次数
	如果 来源.最近接收 <> 空 则
		接收说明.文本 = "最近实际收到：" & 来源.最近主题 & "；QoS：" & 来源.最近接收.QoS & "；保留：" & 来源.最近接收.保留 & "；重复：" & 来源.最近接收.重复 & "；字节：" & 取数组成员数(来源.最近接收.内容) & "；文本：[" & 取文本左边(来源.最近接收.取文本(), 160) & "]"
	结束 如果
结束 过程

事件 收发窗口.切换完毕()
	主题.文本 = 来源.主题名称
	刷新()
	页面刷新.启用 = 真
结束 事件

事件 收发窗口.即将切换()
	页面刷新.启用 = 假

结束 事件

事件 页面刷新.计时()
	刷新()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 收发窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 收发窗口 $为 窗口
		标题 = "发布、订阅与消息"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "发布、订阅与消息"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "先订阅并等待确认，再发布核对真实回环。可切换 QoS、保留消息或四字节二进制；空文本也是有效消息。"
		$结束 $定义
		$定义 主题 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "订阅或发布主题"
			文本 = ""
		$结束 $定义
		$定义 订阅操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 订阅按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "订阅"
			$结束 $定义
			$定义 批量按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "批量订阅"
			$结束 $定义
			$定义 取消按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "取消订阅"
			$结束 $定义
		$结束 $定义
		$定义 内容 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "发送文本，可空"
			文本 = "你好，MQTT 😀"
		$结束 $定义
		$定义 消息参数 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 QoS按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "发布 QoS：0"
			$结束 $定义
			$定义 保留按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "保留：假"
			$结束 $定义
		$结束 $定义
		$定义 内容按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "二进制模式：假"
		$结束 $定义
		$定义 发布操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 发布按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "发布消息"
			$结束 $定义
			$定义 清除保留 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "清除服务器保留消息"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "连接状态显示在这里。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "交付与实际接收分别统计。"
		$结束 $定义
		$定义 接收说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "尚未收到消息。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 页面刷新 $为 计时器
			间隔 = 500
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
