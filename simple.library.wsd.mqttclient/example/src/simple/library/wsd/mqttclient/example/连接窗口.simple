变量 来源 为 主窗口

事件 本地地址.被单击()
	服务器.文本 = "tcp://127.0.0.1:18884"
结束 事件

事件 连接按钮.被单击()
	来源.服务地址 = 服务器.文本
	来源.客户标识 = 标识.文本
	来源.参数.账号 = 账号.文本
	来源.参数.设置密码(密码.文本)
	来源.通讯.连接(来源.服务地址, 来源.客户标识, 来源.参数, "连接页")
	来源.最近结果 = "连接已提交；等待异步结果。"
	位于 错误
		分支 否则
			来源.最近结果 = "连接未提交：请检查地址、参数及当前状态；更换服务器前先关闭客户端。"
	结束 错误
结束 事件

事件 重连选项.被单击()
	来源.参数.自动重连 = 取反 来源.参数.自动重连
	来源.最近结果 = "下次连接的自动重连：" & 来源.参数.自动重连
结束 事件

事件 会话选项.被单击()
	来源.参数.清理会话 = 取反 来源.参数.清理会话
	来源.最近结果 = "下次连接的清理会话：" & 来源.参数.清理会话 & "；持久会话需要稳定 ID。"
结束 事件

事件 断开按钮.被单击()
	来源.通讯.断开(1000, "连接页断开")
	位于 错误
		分支 否则
			来源.最近结果 = "当前操作尚未结束，请稍候再断开。"
	结束 错误
结束 事件

事件 关闭按钮.被单击()
	来源.通讯.关闭("连接页释放")
	位于 错误
		分支 否则
			来源.最近结果 = "正在清理，请等待关闭结果。"
	结束 错误
结束 事件

过程 刷新()
	状态.文本 = 来源.取连接说明()
	结果.文本 = 来源.最近结果
	统计.文本 = "交付：" & 来源.交付次数 & "；收到：" & 来源.接收次数 & "；缓冲：" & 来源.通讯.缓冲数量 & "；掉线：" & 来源.丢失次数 & "；重连：" & 来源.重连次数
	参数说明.文本 = "心跳：" & 来源.参数.心跳间隔 & " 秒；超时：" & 来源.参数.连接超时 & " 秒；清理会话：" & 来源.参数.清理会话 & "；自动重连：" & 来源.参数.自动重连
结束 过程

事件 连接窗口.切换完毕()
	服务器.文本 = 来源.服务地址
	标识.文本 = 来源.客户标识
	刷新()
	页面刷新.启用 = 真
结束 事件

事件 连接窗口.即将切换()
	页面刷新.启用 = 假

结束 事件

事件 页面刷新.计时()
	刷新()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 连接窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 连接窗口 $为 窗口
		标题 = "连接与会话"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "连接与会话"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "填写 tcp:// 或 ssl:// 地址。账号可空；时间参数使用秒。需要更换服务器或 ID 时，先等待关闭操作完成。"
		$结束 $定义
		$定义 服务器 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "tcp://主机:端口 或 ssl://主机:端口"
			文本 = ""
		$结束 $定义
		$定义 本地地址 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "填写设备本机测试地址"
		$结束 $定义
		$定义 地址条件 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "本机地址只适用于设备本机或已转发的 Broker；普通服务请填写实际可达地址。"
		$结束 $定义
		$定义 标识 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "唯一客户端 ID"
			文本 = ""
		$结束 $定义
		$定义 账号 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "账号，可空"
			文本 = ""
		$结束 $定义
		$定义 密码 $为 密码编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示 = "密码，不保存"
		$结束 $定义
		$定义 连接操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 连接按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "连接"
			$结束 $定义
			$定义 断开按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "正常断开"
			$结束 $定义
			$定义 关闭按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "关闭客户端"
			$结束 $定义
		$结束 $定义
		$定义 参数操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 重连选项 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换自动重连"
			$结束 $定义
			$定义 会话选项 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换清理会话"
			$结束 $定义
		$结束 $定义
		$定义 参数说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "参数状态"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "连接状态显示在这里。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "交付与实际接收分别统计。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 页面刷新 $为 计时器
			间隔 = 500
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
