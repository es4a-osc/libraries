''' 主窗口持有一条 MQTT 连接；主题窗口通过来源引用共享它，不重复创建客户端。
别名 MQTT连接参数 = simple.library.wsd.mqttclient.MQTT连接参数
别名 MQTT消息 = simple.library.wsd.mqttclient.MQTT消息
别名 MQTT令牌 = simple.library.wsd.mqttclient.MQTT令牌
别名 MQTT发送令牌 = simple.library.wsd.mqttclient.MQTT发送令牌
别名 MQTT错误 = simple.library.wsd.mqttclient.MQTT错误
别名 MQTT常量 = simple.library.wsd.mqttclient.MQTT常量

变量 参数 为 MQTT连接参数
变量 服务地址 为 文本型
变量 客户标识 为 文本型
变量 主题名称 为 文本型
变量 最近结果 为 文本型
变量 最近主题 为 文本型
变量 最近接收 为 MQTT消息
变量 接收次数 为 整数型
变量 交付次数 为 整数型
变量 重连次数 为 整数型
变量 丢失次数 为 整数型
变量 需要订阅 为 逻辑型
变量 发送摘要 为 文本型
变量 连接页 为 连接窗口
变量 收发页 为 收发窗口
变量 缓冲页 为 缓冲窗口
变量 高级页 为 高级窗口

事件 主窗口.初始化()
	参数 = 创建 MQTT连接参数
	客户标识 = "es4a-" & 生成GUID()
	主题名称 = "es4a/example/" & 生成GUID()
	最近结果 = "先配置自己的 Broker 并连接，再进入发布订阅页。"
结束 事件

函数 取连接说明() 为 文本型
	取连接说明 = "已连接：" & 通讯.已连接 & "；状态：" & 通讯.状态 & "；缓冲：" & 通讯.缓冲数量
结束 函数

事件 主窗口.切换完毕()
	状态.文本 = 取连接说明()
	结果.文本 = 最近结果
结束 事件

事件 连接入口.被单击()
	如果 连接页 = 空 则
		连接页 = 创建 连接窗口
		连接页.来源 = 主窗口
	结束 如果
	切换窗口(连接页)
结束 事件

事件 收发入口.被单击()
	如果 收发页 = 空 则
		收发页 = 创建 收发窗口
		收发页.来源 = 主窗口
	结束 如果
	切换窗口(收发页)
结束 事件

事件 缓冲入口.被单击()
	如果 缓冲页 = 空 则
		缓冲页 = 创建 缓冲窗口
		缓冲页.来源 = 主窗口
	结束 如果
	切换窗口(缓冲页)
结束 事件

事件 高级入口.被单击()
	如果 高级页 = 空 则
		高级页 = 创建 高级窗口
		高级页.来源 = 主窗口
	结束 如果
	切换窗口(高级页)
结束 事件

事件 通讯.操作成功(令牌 为 MQTT令牌)
	最近结果 = "成功 #" & 令牌.操作编号 & "：" & 令牌.操作 & "；标记：" & 令牌.标记 & "；消息编号：" & 令牌.消息编号
	如果 令牌.操作 = "订阅" 则
		变量 等级 为 整数型
		变量 列表 为 整数型()
		列表 = 令牌.取授权QoS()
		循环 每个 等级 从 列表
			最近结果 = 最近结果 & "；授权 QoS：" & 等级
		下个 等级
	结束 如果
结束 事件

事件 通讯.操作失败(令牌 为 MQTT令牌)
	最近结果 = "失败 #" & 令牌.操作编号 & "：" & 令牌.操作 & "；标记：" & 令牌.标记
	如果 令牌.错误 <> 空 则
		最近结果 = 最近结果 & "；代码：" & 令牌.错误.代码 & "；说明：" & 令牌.错误.说明 & "；原因类型：" & 令牌.错误.原因类型
	结束 如果
结束 事件

事件 通讯.连接完成(重连 为 逻辑型, 地址 为 文本型)
	如果 重连 则 重连次数 = 重连次数 + 1
	最近结果 = "已连接：" & 地址 & "；是否重连：" & 重连
	如果 需要订阅 则
		通讯.订阅(主题名称, 2, "重新确认订阅")
	结束 如果
结束 事件

事件 通讯.连接丢失(原因 为 MQTT错误)
	丢失次数 = 丢失次数 + 1
	最近结果 = "连接丢失；代码：" & 原因.代码 & "；原因：" & 原因.说明 & "。自动重连开启时将继续尝试。"
结束 事件

事件 通讯.收到消息(主题 为 文本型, 消息 为 MQTT消息)
	接收次数 = 接收次数 + 1
	最近主题 = 主题
	最近接收 = 消息
	如果 主题 = 主题名称 且 取MD5值(消息.内容) = 发送摘要 则
		最近结果 = "实际回环的主题和原始字节与最近一次发布一致。"
	结束 如果
结束 事件

事件 通讯.发送完成(令牌 为 MQTT发送令牌)
	交付次数 = 交付次数 + 1
	' 交付与实际接收独立统计，不把交付事件作为订阅者已经处理的证据。
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		通讯.销毁()
		终止()
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "MQTT客户端示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "MQTT客户端示例"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "先准备自己可访问的 MQTT Broker。按主题查看参数、异步令牌和消息回调；连接在页面之间共享。"
		$结束 $定义
		$定义 连接入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "1. 连接、账号与会话参数"
		$结束 $定义
		$定义 收发入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "2. 发布、订阅与消息属性"
		$结束 $定义
		$定义 缓冲入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "3. 离线缓冲与重新连接"
		$结束 $定义
		$定义 高级入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "4. 遗嘱观察与 TLS 配置"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "尚未连接。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "先进入连接页填写 Broker。"
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "主题页返回目录，目录页返回退出。Android 系统休眠或应用退出后不保证维持连接。"
		$结束 $定义
		$定义 通讯 $为 simple.library.wsd.mqttclient.MQTT客户端
		$结束 $定义
	$结束 $定义
$结束 $属性
