						高度 = "48dp"
						顶边距 = "8dp"
						字体大小 = 14
						内容对齐 = 对齐_居中
						内容描述 = "迷你按钮"
					$结束 $定义
					$定义 图标列表按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						顶边距 = "10dp"
						文本 = "图标列表：点击选择，长按查看"
						字体大小 = 14
						内容对齐 = 对齐_居中
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "操作结果会显示在这里。"
			字体大小 = 13
			文本颜色 = -15181370
			背景颜色 = -919554
			宽度 = 长度_匹配父级
			高度 = "64dp"
			左填充 = "16dp"
			右填充 = "16dp"
			内容对齐 = 对齐_垂直居中
		$结束 $定义
		$定义 材质 $为 simple.library.wsd.xui.XUI对话框
		$结束 $定义
		$定义 加载 $为 simple.library.wsd.xui.XUI加载对话框
		$结束 $定义
		$定义 进度计时器 $为 计时器
			启用 = 假
			间隔 = 200
		$结束 $定义
	$结束 $定义
$结束 $属性
