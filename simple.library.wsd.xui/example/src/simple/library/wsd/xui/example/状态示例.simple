' 参考 XUI 1.2.1 官方示例的分组与交互，以现有 Simple 组件实现。
变量 来源 为 主窗口

事件 状态示例.初始化()
	导航.置标题("状态页")
	导航.置标题颜色(颜色_白)
	导航.置左侧文本("返回")
	导航.置左侧文本颜色(颜色_白)
	状态区.显示内容()
	加载按钮.置填充颜色(-15181370)
	加载按钮.置圆角(到绝对像素(6.0))
	加载按钮.文本颜色 = 颜色_白
	空白按钮.置填充颜色(-15181370)
	空白按钮.置圆角(到绝对像素(6.0))
	空白按钮.文本颜色 = 颜色_白
	错误按钮.置填充颜色(-15181370)
	错误按钮.置圆角(到绝对像素(6.0))
	错误按钮.文本颜色 = 颜色_白
	网络按钮.置填充颜色(-15181370)
	网络按钮.置圆角(到绝对像素(6.0))
	网络按钮.文本颜色 = 颜色_白
	恢复按钮.置填充颜色(-15181370)
	恢复按钮.置圆角(到绝对像素(6.0))
	恢复按钮.文本颜色 = 颜色_白
结束 事件

事件 导航.左侧被单击()
	返回目录()
结束 事件

事件 加载按钮.被单击()
	状态区.显示加载()
	反馈.文本 = "显示加载"
	输出信息("XUI-EXAMPLE", "状态页 StateLayout | " & 反馈.文本)
结束 事件

事件 空白按钮.被单击()
	状态区.显示空状态()
	反馈.文本 = "显示空内容"
	输出信息("XUI-EXAMPLE", "状态页 StateLayout | " & 反馈.文本)
结束 事件

事件 错误按钮.被单击()
	状态区.显示错误()
	反馈.文本 = "显示错误"
	输出信息("XUI-EXAMPLE", "状态页 StateLayout | " & 反馈.文本)
结束 事件

事件 网络按钮.被单击()
	状态区.显示无网络()
	反馈.文本 = "显示无网络"
	输出信息("XUI-EXAMPLE", "状态页 StateLayout | " & 反馈.文本)
结束 事件

事件 恢复按钮.被单击()
	状态区.显示内容()
	反馈.文本 = "恢复正文"
	输出信息("XUI-EXAMPLE", "状态页 StateLayout | " & 反馈.文本)
结束 事件

事件 状态区.请求重试()
	状态区.显示内容()
	反馈.文本 = "重试成功：已恢复正文。"
	输出信息("XUI-EXAMPLE", "状态页 StateLayout | " & 反馈.文本)
结束 事件

过程 返回目录()
	切换窗口(来源)
结束 过程

事件 状态示例.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回目录()
	结束 如果
结束 事件

' 页面不再复用；离开时释放本页组件及其持有的任务和资源。
事件 状态示例.即将切换()
	恢复按钮.销毁()
	网络按钮.销毁()
	错误按钮.销毁()
	空白按钮.销毁()
	加载按钮.销毁()
	状态区.销毁()
	滚动区.销毁()
	导航.销毁()
	' 本页不再复用，注销窗口自身的事件，避免重新创建时触发旧初始化处理器。
	销毁()
结束 事件
$属性
	$资源 $窗口
	$定义 状态示例 $为 窗口
		标题 = "状态页"
		背景颜色 = -1
		$定义 导航 $为 simple.library.wsd.xui.XUI标题栏
			宽度 = 长度_匹配父级
			高度 = "56dp"
			内容描述 = "导航"
			背景颜色 = -15181370
		$结束 $定义
		$定义 内容区域 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 滚动区 $为 simple.library.wsd.xui.XUI滚动框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				内容描述 = "滚动区"
				$定义 内容 $为 面板
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					左填充 = "16dp"
					右填充 = "16dp"
					顶填充 = "16dp"
					底填充 = "24dp"
					$定义 介绍 $为 标签
						文本 = "切换加载、空内容、错误、无网络及正文，体验不同状态下的提示。"
						字体大小 = 13
						文本颜色 = -9471604
						宽度 = 长度_匹配父级
					$结束 $定义
					$定义 状态区 $为 simple.library.wsd.xui.XUI多状态容器
						宽度 = 长度_匹配父级
						高度 = "260dp"
						内容描述 = "状态区"
						顶边距 = "12dp"
						$定义 正文 $为 面板
							宽度 = 长度_匹配父级
							高度 = 长度_匹配父级
							布局.内容对齐 = 对齐_居中
							$定义 正文标题 $为 标签
								文本 = "内容已就绪"
								字体大小 = 22
								文本颜色 = -15181370
								宽度 = 长度_匹配父级
								内容对齐 = 对齐_居中
							$结束 $定义
							$定义 正文说明 $为 标签
								文本 = "这是一张可切换状态的内容页面。"
								字体大小 = 14
								文本颜色 = -9471604
								宽度 = 长度_匹配父级
								顶边距 = "12dp"
								内容对齐 = 对齐_居中
							$结束 $定义
						$结束 $定义
					$结束 $定义
					$定义 加载按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "加载按钮"
						文本 = "显示加载"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 空白按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "空白按钮"
						文本 = "显示空内容"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 错误按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "错误按钮"
						文本 = "显示错误"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 网络按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "网络按钮"
						文本 = "显示无网络"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 恢复按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "恢复按钮"
						文本 = "恢复正文"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "操作结果会显示在这里。"
			字体大小 = 13
			文本颜色 = -15181370
			背景颜色 = -919554
			宽度 = 长度_匹配父级
			高度 = "48dp"
			左填充 = "16dp"
			右填充 = "16dp"
			内容对齐 = 对齐_垂直居中
		$结束 $定义
	$结束 $定义
$结束 $属性
