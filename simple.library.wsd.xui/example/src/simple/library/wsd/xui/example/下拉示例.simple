' 参考 XUI 官方演示，以现有封装接口展示数据、状态和交互。
变量 来源 为 主窗口
变量 当前地区 为 文本型
变量 当前状态 为 文本型

事件 下拉示例.初始化()
	导航.置标题("下拉框")
	导航.置标题颜色(颜色_白)
	导航.置左侧文本("返回")
	导航.置左侧文本颜色(颜色_白)
	普通下拉.置项目数组(分割文本("默认排序|按名称|按更新时间", "|"))
	普通下拉.置箭头颜色(-15181370)
	编辑下拉.置项目数组(分割文本("北京|上海|杭州|成都|深圳", "|"))
	编辑下拉.置提示文本("选择或输入城市")
	编辑下拉.置文本("杭州")
	编辑下拉.置是否筛选关键字(真)
	城市菜单.置项目数组(分割文本("全部地区|北京|上海|杭州", "|"))
	状态菜单.置项目数组(分割文本("全部状态|进行中|已完成", "|"))
	城市菜单.置选中项目(0)
	状态菜单.置选中项目(0)
	当前地区 = "全部地区"
	当前状态 = "全部状态"
	变量 菜单组件 为 可视组件(2)
	菜单组件(0) = 城市菜单
	菜单组件(1) = 状态菜单
	' 菜单接管备选容器中的子组件，保留上游标签和内容结构。
	筛选菜单.置菜单(分割文本("地区|状态", "|"), 菜单组件, 筛选正文)
	刷新筛选结果()
结束 事件

事件 导航.左侧被单击()
	返回目录()
结束 事件

过程 返回目录()
	切换窗口(来源)
结束 过程

事件 下拉示例.按下某键(键码 为 整数型, 传址 取消默认处理 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消默认处理 = 真
		返回目录()
	结束 如果
结束 事件

事件 下拉示例.即将切换()
	状态菜单.销毁()
	城市菜单.销毁()
	筛选菜单.销毁()
	编辑下拉.销毁()
	普通下拉.销毁()
	滚动区.销毁()
	导航.销毁()
	销毁()
结束 事件

事件 普通下拉.项目被选择(索引 为 整数型, 文本 为 文本型)
	反馈.文本 = "排序方式：" & 文本
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 编辑下拉.项目被选择(索引 为 整数型, 文本 为 文本型)
	反馈.文本 = "已选择城市：" & 文本
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 编辑下拉.文本改变(文本 为 文本型)
	反馈.文本 = "城市输入：" & 文本
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 城市菜单.项目被单击(索引 为 整数型, 文本 为 文本型)
	筛选菜单.置标签菜单文本(文本)
	当前地区 = 文本
	刷新筛选结果()
	筛选菜单.关闭菜单()
结束 事件

事件 状态菜单.项目被单击(索引 为 整数型, 文本 为 文本型)
	筛选菜单.置标签菜单文本(文本)
	当前状态 = 文本
	刷新筛选结果()
	筛选菜单.关闭菜单()
结束 事件

过程 刷新筛选结果()
	' 两项条件共同组成结果，切换其中一项时保留另一项。
	筛选正文.文本 = "地区：" & 当前地区 & "　状态：" & 当前状态
	反馈.文本 = 筛选正文.文本
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 过程
$属性
	$资源 $窗口
	$定义 下拉示例 $为 窗口
		标题 = "下拉框"
		背景颜色 = -1
		$定义 导航 $为 simple.library.wsd.xui.XUI标题栏
			宽度 = 长度_匹配父级
			高度 = "56dp"
			内容描述 = "导航"
			背景颜色 = -15181370
		$结束 $定义
		$定义 内容区域 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 滚动区 $为 simple.library.wsd.xui.XUI滚动框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				内容描述 = "滚动区"
				$定义 内容 $为 面板
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					左填充 = "16dp"
					右填充 = "16dp"
					顶填充 = "16dp"
					底填充 = "24dp"
					$定义 介绍 $为 标签
						文本 = "比较固定选项、可编辑下拉与带内容区域的筛选菜单。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
					$结束 $定义
					$定义 普通下拉标题 $为 标签
						文本 = "普通下拉"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 普通下拉 $为 simple.library.wsd.xui.XUI下拉框
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "普通下拉"
					$结束 $定义
					$定义 普通下拉说明 $为 标签
						文本 = "固定选项用于排序，选中后将标题替换为当前选项。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 编辑下拉标题 $为 标签
						文本 = "可编辑下拉"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 编辑下拉 $为 simple.library.wsd.xui.XUI编辑下拉框
						宽度 = 长度_匹配父级
						高度 = "56dp"
						内容描述 = "编辑下拉"
					$结束 $定义
					$定义 编辑下拉说明 $为 标签
						文本 = "既可选择城市，也可输入自定义内容；输入过程与选中结果分别反馈。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 筛选菜单标题 $为 标签
						文本 = "内容筛选"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 筛选说明 $为 标签
						文本 = "选择后自动收起并保留另一项条件；点击空白遮罩可收起菜单。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						底边距 = "10dp"
					$结束 $定义
					$定义 筛选菜单 $为 simple.library.wsd.xui.XUI下拉菜单
						宽度 = 长度_匹配父级
						高度 = "280dp"
						内容描述 = "筛选菜单"
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "操作结果会显示在这里。"
			字体大小 = 13
			文本颜色 = -15181370
			背景颜色 = -919554
			宽度 = 长度_匹配父级
			高度 = "48dp"
			左填充 = "16dp"
			右填充 = "16dp"
			内容对齐 = 对齐_垂直居中
		$结束 $定义
		$定义 菜单备选 $为 面板
			宽度 = 长度_匹配父级
			高度 = 0
			$定义 城市菜单 $为 simple.library.wsd.xui.XUI自适应列表
				宽度 = 长度_匹配父级
				高度 = "140dp"
				内容描述 = "城市菜单"
				背景颜色 = 颜色_白
			$结束 $定义
			$定义 状态菜单 $为 simple.library.wsd.xui.XUI自适应列表
				宽度 = 长度_匹配父级
				高度 = "140dp"
				内容描述 = "状态菜单"
				背景颜色 = 颜色_白
			$结束 $定义
			$定义 筛选正文 $为 标签
				文本 = "地区：全部地区　状态：全部状态"
				宽度 = 长度_匹配父级
				字体大小 = 14
				文本颜色 = -13815236
				高度 = "110dp"
				内容对齐 = 对齐_居中
				背景颜色 = -986638
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
