						布局.方向 = 布局_方向_水平
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						$定义 评分滑动按钮 $为 simple.library.wsd.xui.XUI圆角按钮
							文本 = "关闭滑动评分"
							内容描述 = "评分滑动按钮"
							宽度 = 0
							高度 = "44dp"
							字体大小 = 14
							内容对齐 = 对齐_居中
							顶边距 = "8dp"
