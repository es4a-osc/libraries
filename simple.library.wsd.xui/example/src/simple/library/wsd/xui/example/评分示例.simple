			背景颜色 = -919554
			宽度 = 长度_匹配父级
			高度 = "48dp"
			左填充 = "16dp"
			右填充 = "16dp"
			内容对齐 = 对齐_垂直居中
		$结束 $定义
	$结束 $定义
$结束 $属性
