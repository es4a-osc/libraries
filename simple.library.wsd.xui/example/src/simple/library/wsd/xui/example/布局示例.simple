						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 详情设置项 $为 simple.library.wsd.xui.XUI分组列表项
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						顶边距 = "10dp"
					$结束 $定义
					$定义 通知设置项 $为 simple.library.wsd.xui.XUI分组列表项
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						顶边距 = "10dp"
					$结束 $定义
					$定义 状态设置项 $为 simple.library.wsd.xui.XUI分组列表项
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						顶边距 = "10dp"
					$结束 $定义
					$定义 状态标记 $为 标签
						宽度 = "72dp"
						高度 = "32dp"
						顶边距 = "10dp"
						文本 = "已同步"
						文本颜色 = -15181370
						可视 = 假
						内容对齐 = 对齐_居中
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "操作结果会显示在这里。"
			字体大小 = 13
