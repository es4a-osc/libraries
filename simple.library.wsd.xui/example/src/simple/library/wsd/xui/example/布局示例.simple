								文本 = "容器可以嵌套其它组件。"
								字体大小 = 13
								文本颜色 = -9471604
								宽度 = 长度_匹配父级
								顶边距 = "8dp"
							$结束 $定义
						$结束 $定义
					$结束 $定义
					$定义 图文标题 $为 标签
						文本 = "图文列表"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 图文列表 $为 simple.library.wsd.xui.XUI自适应列表
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
					$结束 $定义
					$定义 容器造型标题 $为 标签
						文本 = "容器造型"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						顶边距 = "20dp"
						底边距 = "10dp"
						字体加粗 = 真
					$结束 $定义
					$定义 容器造型说明 $为 标签
