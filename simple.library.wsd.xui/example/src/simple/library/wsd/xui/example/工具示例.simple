						文本 = "颜色与系统栏"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 色块 $为 标签
						文本 = "点击生成颜色"
