' 参考 XUI 1.2.1 官方示例的分组与交互，以现有 Simple 组件实现。
变量 来源 为 主窗口
变量 输入错误提示 为 逻辑型
变量 显示剩余字数 为 逻辑型
变量 验证码密码模式 为 逻辑型

事件 编辑示例.初始化()
	导航.置标题("编辑框")
	导航.置标题颜色(颜色_白)
	导航.置左侧文本("返回")
	导航.置左侧文本颜色(颜色_白)
	用户名.置提示文本("请输入用户名")
	邮箱.置提示文本("邮箱地址")
	邮箱.置浮动标签文本("邮箱地址")
	邮箱.置浮动标签(2)
	密码.置提示文本("请输入密码")
	留言.置提示文本("写下你的想法…")
	留言.置最大字数(80)
	验证码.置输入格数量(4)
	' 辅助说明与字数限制是不同状态，示例分别提供切换入口。
	邮箱.置最小字符数量(5)
	邮箱.置最大字符数量(30)
	邮箱.置最小底部文本行数(1)
	邮箱.置辅助文本("请输入 5～30 个字符")
	邮箱.置辅助文本始终显示(真)
	邮箱.置主颜色(-15181370)
	邮箱.置错误颜色(-65536)
	密码.文本 = "Simple1234"
	字数示例按钮.置填充颜色(-15181370)
	字数示例按钮.置圆角(到绝对像素(6.0))
	字数示例按钮.文本颜色 = 颜色_白
	错误提示按钮.置填充颜色(-15181370)
	错误提示按钮.置圆角(到绝对像素(6.0))
	错误提示按钮.文本颜色 = 颜色_白
	字数显示按钮.置填充颜色(-15181370)
	字数显示按钮.置圆角(到绝对像素(6.0))
	字数显示按钮.文本颜色 = 颜色_白
	验证码填充按钮.置填充颜色(-15181370)
	验证码填充按钮.置圆角(到绝对像素(6.0))
	验证码填充按钮.文本颜色 = 颜色_白
	验证码清空按钮.置填充颜色(-15181370)
	验证码清空按钮.置圆角(到绝对像素(6.0))
	验证码清空按钮.文本颜色 = 颜色_白
	验证码模式按钮.置填充颜色(-15181370)
	验证码模式按钮.置圆角(到绝对像素(6.0))
	验证码模式按钮.文本颜色 = 颜色_白
	填充输入按钮.置填充颜色(-15181370)
	填充输入按钮.置圆角(到绝对像素(6.0))
	填充输入按钮.文本颜色 = 颜色_白
	清空输入按钮.置填充颜色(-15181370)
	清空输入按钮.置圆角(到绝对像素(6.0))
	清空输入按钮.文本颜色 = 颜色_白
	邮箱.添加必填规则("邮箱不能为空")
	邮箱.添加正则规则("[^ @]+@[^ @]+[.][^ @]+", "请输入完整邮箱地址")
	邮箱.置清除按钮(真)
	账号校验.置提示文本("4～12 位字母或数字")
	账号校验.添加必填规则("请填写账号")
	账号校验.添加正则规则("[A-Za-z0-9]{4,12}", "账号须为 4～12 位字母或数字")
	校验按钮.置填充颜色(-15181370)
	校验按钮.置圆角(到绝对像素(6.0))
	校验按钮.文本颜色 = 颜色_白
结束 事件

事件 导航.左侧被单击()
	返回目录()
结束 事件

事件 用户名.文本改变(文本 为 文本型)
	反馈.文本 = "用户名：" & 文本
	输出信息("XUI-EXAMPLE", "材质编辑框 EditText | " & 反馈.文本)
结束 事件

事件 验证码.输入完成(文本 为 文本型)
	如果 验证码密码模式 则
		反馈.文本 = "验证码输入完成（密码模式）。"
	否则
		反馈.文本 = "验证码输入完成：" & 文本
	结束 如果
	输出信息("XUI-EXAMPLE", "材质编辑框 EditText | " & 反馈.文本)
结束 事件

过程 返回目录()
	切换窗口(来源)
结束 过程

事件 编辑示例.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回目录()
	结束 如果
结束 事件

' 页面不再复用；离开时释放本页组件及其持有的任务和资源。
事件 编辑示例.即将切换()
	校验按钮.销毁()
	账号校验.销毁()
	清空输入按钮.销毁()
	填充输入按钮.销毁()
	验证码模式按钮.销毁()
	验证码清空按钮.销毁()
	验证码填充按钮.销毁()
	字数显示按钮.销毁()
	错误提示按钮.销毁()
	字数示例按钮.销毁()
	验证码.销毁()
	留言.销毁()
	密码.销毁()
	邮箱.销毁()
	用户名.销毁()
	滚动区.销毁()
	导航.销毁()
	' 本页不再复用，注销窗口自身的事件，避免重新创建时触发旧初始化处理器。
	销毁()
结束 事件

事件 字数示例按钮.被单击()
	如果 邮箱.是否字数有效() 则
		邮箱.文本 = "a"
	否则
		邮箱.文本 = "hello@example.com"
	结束 如果
	如果 邮箱.是否字数有效() 则
		反馈.文本 = "字数符合要求。"
	否则
		反馈.文本 = "字数不符合要求，请输入 5～30 个字符。"
	结束 如果
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 错误提示按钮.被单击()
	输入错误提示 = 取反 输入错误提示
	如果 输入错误提示 则
		邮箱.置错误("这是自定义错误提示")
		错误提示按钮.文本 = "清除错误提示"
	否则
		邮箱.置错误("")
		错误提示按钮.文本 = "显示错误提示"
	结束 如果
	如果 输入错误提示 则
		反馈.文本 = "已显示自定义错误提示。"
	否则
		反馈.文本 = "已清除自定义错误提示。"
	结束 如果
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 字数显示按钮.被单击()
	显示剩余字数 = 取反 显示剩余字数
	留言.置显示剩余字数(显示剩余字数)
	如果 显示剩余字数 则
		字数显示按钮.文本 = "显示已输入字数"
		反馈.文本 = "当前显示剩余字数。"
	否则
		字数显示按钮.文本 = "显示剩余字数"
		反馈.文本 = "当前显示已输入字数。"
	结束 如果
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 验证码填充按钮.被单击()
	验证码.置输入文本("2468")
结束 事件

事件 验证码清空按钮.被单击()
	验证码.清空输入()
结束 事件

事件 验证码.输入清空()
	反馈.文本 = "验证码已清空。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 验证码模式按钮.被单击()
	验证码密码模式 = 取反 验证码密码模式
	验证码.置密码模式(验证码密码模式)
	如果 验证码密码模式 则
		验证码模式按钮.文本 = "关闭验证码密码模式"
	否则
		验证码模式按钮.文本 = "开启验证码密码模式"
	结束 如果
	如果 验证码密码模式 则
		反馈.文本 = "验证码已切换为密码模式。"
	否则
		反馈.文本 = "验证码已切换为普通模式。"
	结束 如果
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 填充输入按钮.被单击()
	用户名.文本 = "Simple 用户"
	邮箱.文本 = "hello@example.com"
	留言.置内容文本("这里是一段可以继续编辑的示例内容，观察右下角的字数变化。")
	反馈.文本 = "示例内容已填入，可以继续编辑。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 清空输入按钮.被单击()
	用户名.文本 = ""
	邮箱.清空()
	邮箱.置错误("")
	输入错误提示 = 假
	错误提示按钮.文本 = "显示错误提示"
	密码.文本 = ""
	留言.置内容文本("")
	验证码.清空输入()
	反馈.文本 = "输入内容已清空。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 校验按钮.被单击()
	变量 邮箱正确 为 逻辑型
	变量 账号正确 为 逻辑型
	邮箱正确 = 邮箱.校验()
	账号正确 = 账号校验.校验()
	如果 邮箱正确 且 账号正确 则
		反馈.文本 = "两项校验均通过。"
	否则
		反馈.文本 = "邮箱：" & 邮箱.取错误() & "；账号：" & 账号校验.取错误消息()
	结束 如果
结束 事件

事件 账号校验.校验失败(输入文本 为 文本型, 提示文本 为 文本型)
	反馈.文本 = 提示文本
结束 事件
$属性
	$资源 $窗口
	$定义 编辑示例 $为 窗口
		标题 = "编辑框"
		背景颜色 = -1
		$定义 导航 $为 simple.library.wsd.xui.XUI标题栏
			宽度 = 长度_匹配父级
			高度 = "56dp"
			内容描述 = "导航"
			背景颜色 = -15181370
		$结束 $定义
		$定义 内容区域 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 滚动区 $为 simple.library.wsd.xui.XUI滚动框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				内容描述 = "滚动区"
				$定义 内容 $为 面板
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					左填充 = "16dp"
					右填充 = "16dp"
					顶填充 = "16dp"
					底填充 = "24dp"
					$定义 介绍 $为 标签
						文本 = "输入用户名、密码和验证码，直接查看输入反馈。"
						字体大小 = 13
						文本颜色 = -9471604
						宽度 = 长度_匹配父级
					$结束 $定义
					$定义 输入标题 $为 标签
						文本 = "清除与浮动标签"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 用户名 $为 simple.library.wsd.xui.XUI清除编辑框
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "用户名"
						字体大小 = 16
						内容对齐 = 对齐_左中
					$结束 $定义
					$定义 邮箱 $为 simple.library.wsd.xui.XUI材质编辑框
						底边距 = "8dp"
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						内容描述 = "邮箱"
						字体大小 = 16
						内容对齐 = 对齐_左中
						顶边距 = "8dp"
					$结束 $定义
					$定义 字数规则说明 $为 标签
						文本 = "字数范围为 5～30 个字符。比较正常文本和过短文本，观察辅助说明、计数与错误提示。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 字数操作行 $为 面板
						布局 = 布局_线性
						布局.方向 = 布局_方向_水平
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						$定义 字数示例按钮 $为 simple.library.wsd.xui.XUI圆角按钮
							文本 = "切换字数示例"
							内容描述 = "字数示例按钮"
							宽度 = 0
							高度 = "44dp"
							字体大小 = 14
							内容对齐 = 对齐_居中
							顶边距 = "8dp"
							权重 = 1
							右边距 = "6dp"
						$结束 $定义
						$定义 错误提示按钮 $为 simple.library.wsd.xui.XUI圆角按钮
							文本 = "显示错误提示"
							内容描述 = "错误提示按钮"
							宽度 = 0
							高度 = "44dp"
							字体大小 = 14
							内容对齐 = 对齐_居中
							顶边距 = "8dp"
							权重 = 1
							左边距 = "6dp"
						$结束 $定义
					$结束 $定义
					$定义 密码标题 $为 标签
						文本 = "密码输入"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 密码 $为 simple.library.wsd.xui.XUI密码编辑框
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "密码"
						字体大小 = 16
						内容对齐 = 对齐_左中
					$结束 $定义
					$定义 密码说明 $为 标签
						文本 = "输入后点击右侧眼睛，比较隐藏和显示密码的效果。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 计数标题 $为 标签
						文本 = "字数统计 · 80 字以内"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 留言 $为 simple.library.wsd.xui.XUI多行编辑框
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						内容描述 = "留言"
					$结束 $定义
					$定义 字数显示按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						文本 = "显示剩余字数"
						内容描述 = "字数显示按钮"
						宽度 = 长度_匹配父级
						高度 = "44dp"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 验证码标题 $为 标签
						文本 = "验证码"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 验证码 $为 simple.library.wsd.xui.XUI验证码编辑框
						宽度 = 长度_匹配父级
						高度 = "56dp"
						内容描述 = "验证码"
					$结束 $定义
					$定义 验证码操作行 $为 面板
						布局 = 布局_线性
						布局.方向 = 布局_方向_水平
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						$定义 验证码填充按钮 $为 simple.library.wsd.xui.XUI圆角按钮
							文本 = "填入验证码 2468"
							内容描述 = "验证码填充按钮"
							宽度 = 0
							高度 = "44dp"
							字体大小 = 14
							内容对齐 = 对齐_居中
							顶边距 = "8dp"
							权重 = 1
							右边距 = "6dp"
						$结束 $定义
						$定义 验证码清空按钮 $为 simple.library.wsd.xui.XUI圆角按钮
							文本 = "清空验证码"
							内容描述 = "验证码清空按钮"
							宽度 = 0
							高度 = "44dp"
							字体大小 = 14
							内容对齐 = 对齐_居中
							顶边距 = "8dp"
							权重 = 1
							左边距 = "6dp"
						$结束 $定义
					$结束 $定义
					$定义 验证码模式按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						文本 = "开启验证码密码模式"
						内容描述 = "验证码模式按钮"
						宽度 = 长度_匹配父级
						高度 = "44dp"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 验证码说明 $为 标签
						文本 = "普通模式显示输入内容；密码模式只反馈完成状态。填写和清空分别触发对应事件。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 整体输入操作行 $为 面板
						布局 = 布局_线性
						布局.方向 = 布局_方向_水平
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
