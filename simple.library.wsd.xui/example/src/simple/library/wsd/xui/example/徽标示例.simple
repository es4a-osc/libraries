' 参考 XUI 官方演示，以现有封装接口展示数据、状态和交互。
变量 来源 为 主窗口

事件 徽标示例.初始化()
	导航.置标题("徽标")
	导航.置标题颜色(颜色_白)
	导航.置左侧文本("返回")
	导航.置左侧文本颜色(颜色_白)
	消息目标.置填充颜色(-15181370)
	消息目标.置圆角(到绝对像素(6.0))
	消息目标.文本颜色 = 颜色_白
	增加按钮.置填充颜色(-15181370)
	增加按钮.置圆角(到绝对像素(6.0))
	增加按钮.文本颜色 = 颜色_白
	大数按钮.置填充颜色(-15181370)
	大数按钮.置圆角(到绝对像素(6.0))
	大数按钮.文本颜色 = 颜色_白
	精确按钮.置填充颜色(-15181370)
	精确按钮.置圆角(到绝对像素(6.0))
	精确按钮.文本颜色 = 颜色_白
	清除按钮.置填充颜色(-15181370)
	清除按钮.置圆角(到绝对像素(6.0))
	清除按钮.文本颜色 = 颜色_白
	更新目标.置填充颜色(-15181370)
	更新目标.置圆角(到绝对像素(6.0))
	更新目标.文本颜色 = 颜色_白
	资料目标.置填充颜色(-15181370)
	资料目标.置圆角(到绝对像素(6.0))
	资料目标.文本颜色 = 颜色_白
	恢复按钮.置填充颜色(-15181370)
	恢复按钮.置圆角(到绝对像素(6.0))
	恢复按钮.文本颜色 = 颜色_白
	数字徽标.绑定目标(消息目标)
	数字徽标.置徽标背景颜色(-65536)
	数字徽标.置徽标文本颜色(颜色_白)
	数字徽标.置对齐偏移(8.0, 真)
	数字徽标.置徽标数(8)
	文字徽标.绑定目标(更新目标)
	文字徽标.置徽标背景颜色(-14049565)
	文字徽标.置徽标文本("新")
	文本徽标.绑定目标(资料目标)
	文本徽标.宽度 = 长度_适应内容
	文本徽标.高度 = 长度_适应内容
	文本徽标.文本颜色 = 颜色_白
	文本徽标.字体大小 = 11
	文本徽标.置徽标对齐(53)
	文本徽标.置徽标外边距(8)
	文本徽标.置背景(10, -15181370)
	文本徽标.置徽标数量(3)
	数字徽标.置描边(颜色_白, 2.0)
	文字徽标.置描边(-15181370, 1.0)
结束 事件

事件 导航.左侧被单击()
	返回目录()
结束 事件

过程 返回目录()
	切换窗口(来源)
结束 过程

事件 徽标示例.按下某键(键码 为 整数型, 传址 取消默认处理 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消默认处理 = 真
		返回目录()
	结束 如果
结束 事件

事件 徽标示例.即将切换()
	文本徽标.销毁()
	文字徽标.销毁()
	数字徽标.销毁()
	恢复按钮.销毁()
	资料目标.销毁()
	更新目标.销毁()
	清除按钮.销毁()
	精确按钮.销毁()
	大数按钮.销毁()
	增加按钮.销毁()
	消息目标.销毁()
	滚动区.销毁()
	导航.销毁()
	销毁()
结束 事件

事件 增加按钮.被单击()
	数字徽标.置徽标数(数字徽标.取徽标数() + 1)
	反馈.文本 = "消息数量：" & 数字徽标.取徽标数()
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 大数按钮.被单击()
	数字徽标.置精确模式(假)
	数字徽标.置徽标数(120)
	反馈.文本 = "消息数量 120，默认显示 99+。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 精确按钮.被单击()
	数字徽标.置精确模式(取反 数字徽标.是否精确模式())
	如果 数字徽标.是否精确模式() 则
		反馈.文本 = "已开启精确数字显示。"
	否则
		反馈.文本 = "已关闭精确数字显示。"
	结束 如果
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 清除按钮.被单击()
	数字徽标.隐藏(真)
	反馈.文本 = "消息徽标已清除。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 恢复按钮.被单击()
	数字徽标.置徽标数(8)
	文字徽标.置徽标文本("新")
	文本徽标.显示()
	反馈.文本 = "徽标已恢复。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 数字徽标.拖动状态改变(状态 为 整数型)
	反馈.文本 = "数字徽标拖动状态：" & 状态
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 消息目标.被单击()
	反馈.文本 = "打开消息中心，拖动右上角徽标可体验消除效果。"
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件
$属性
	$资源 $窗口
	$定义 徽标示例 $为 窗口
		标题 = "徽标"
		背景颜色 = -1
		$定义 导航 $为 simple.library.wsd.xui.XUI标题栏
			宽度 = 长度_匹配父级
			高度 = "56dp"
			内容描述 = "导航"
			背景颜色 = -15181370
		$结束 $定义
		$定义 内容区域 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 滚动区 $为 simple.library.wsd.xui.XUI滚动框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				内容描述 = "滚动区"
				$定义 内容 $为 面板
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					左填充 = "16dp"
					右填充 = "16dp"
					顶填充 = "16dp"
					底填充 = "24dp"
					$定义 介绍 $为 标签
						文本 = "数字和文字徽标附着在组件上；数字徽标还支持拖动消除及精确显示。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
					$结束 $定义
					$定义 数字标题 $为 标签
						文本 = "数字徽标"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 消息目标 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "消息目标"
						文本 = "消息中心"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 增加按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "增加按钮"
						文本 = "增加一条消息"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 大数按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "大数按钮"
						文本 = "显示 120 条消息"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 精确按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "精确按钮"
						文本 = "切换精确数字"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 清除按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "清除按钮"
						文本 = "清除消息徽标"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 文字标题 $为 标签
						文本 = "文字提示与传统徽标"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 更新目标 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "更新目标"
						文本 = "版本更新"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 资料目标 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "资料目标"
						文本 = "我的资料"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 恢复按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "恢复按钮"
						文本 = "恢复全部徽标"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "操作结果会显示在这里。"
			字体大小 = 13
			文本颜色 = -15181370
			背景颜色 = -919554
			宽度 = 长度_匹配父级
			高度 = "48dp"
			左填充 = "16dp"
			右填充 = "16dp"
			内容对齐 = 对齐_垂直居中
		$结束 $定义
		$定义 数字徽标 $为 simple.library.wsd.xui.XUI徽标
		$结束 $定义
		$定义 文字徽标 $为 simple.library.wsd.xui.XUI徽标
		$结束 $定义
		$定义 文本徽标 $为 simple.library.wsd.xui.XUI文本徽标
		$结束 $定义
	$结束 $定义
$结束 $属性
