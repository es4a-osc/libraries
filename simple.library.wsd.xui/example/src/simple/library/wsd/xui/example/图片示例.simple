						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 图标标题 $为 标签
						文本 = "图标叠加"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
