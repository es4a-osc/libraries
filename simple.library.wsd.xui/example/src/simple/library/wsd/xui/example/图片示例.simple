						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 图片网格 $为 simple.library.wsd.xui.XUI九宫格图片
