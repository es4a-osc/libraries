						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
						顶边距 = "6dp"
						底边距 = "8dp"
					$结束 $定义
					$定义 着色图标题 $为 标签
						文本 = "形状与着色"
						宽度 = 长度_匹配父级
						字体大小 = 15
						文本颜色 = -13815236
						顶边距 = "20dp"
						底边距 = "10dp"
						字体加粗 = 真
					$结束 $定义
					$定义 着色图行 $为 面板
						布局 = 布局_线性
						布局.方向 = 布局_方向_水平
						宽度 = 长度_匹配父级
						高度 = "88dp"
						$定义 着色星 $为 simple.library.wsd.xui.XUI形状图片
							宽度 = "72dp"
							高度 = "72dp"
							内容描述 = "着色星"
							右边距 = "24dp"
						$结束 $定义
						$定义 着色心 $为 simple.library.wsd.xui.XUI形状图片
							宽度 = "72dp"
							高度 = "72dp"
							内容描述 = "着色心"
						$结束 $定义
					$结束 $定义
					$定义 图标着色按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						文本 = "切换蓝色与橙色"
						内容描述 = "图标着色按钮"
						宽度 = 长度_匹配父级
						高度 = "44dp"
						字体大小 = 14
						内容对齐 = 对齐_居中
						顶边距 = "8dp"
					$结束 $定义
					$定义 着色图说明 $为 标签
						文本 = "相同的图标轮廓可独立着色，比较实心星形与描边爱心。"
						宽度 = 长度_匹配父级
						字体大小 = 13
						文本颜色 = -9471604
