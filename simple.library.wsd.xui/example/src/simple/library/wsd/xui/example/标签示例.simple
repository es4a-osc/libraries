' 单选、多选和流式标签的独立演示。
变量 来源 为 主窗口
变量 流式项目 为 文本型()

事件 标签示例.初始化()
	导航.置标题("标签")
	导航.置标题颜色(颜色_白)
	导航.置左侧文本("返回")
	导航.置左侧文本颜色(颜色_白)
	单选.置项目数组(分割文本("小号|中号|大号", "|"), 分割文本("S|M|L", "|"))
	单选.置选择("M")
	多选.置项目数组(分割文本("阅读|摄影|旅行|运动|音乐", "|"), 分割文本("read|photo|travel|sport|music", "|"))
	多选.置选择("photo")
	流式项目 = 分割文本("界面设计|组件开发|交互反馈|按钮|标签|本地资源|依赖管理", "|")
	流式.置项目数组(流式项目)
	单选.置颜色(-15181370, 颜色_白, -986638, -13815236)
	多选.置颜色(-15181370, 颜色_白, -986638, -13815236)
结束 事件

事件 导航.左侧被单击()
	返回目录()
结束 事件

过程 返回目录()
	切换窗口(来源)
结束 过程

事件 单选.选择改变(标题 为 文本型, 值 为 文本型)
	反馈.文本 = "单选：" & 标题
	输出信息("XUI-EXAMPLE", "标签与流式布局 Tag | " & 反馈.文本)
结束 事件

事件 多选.选择改变(标题 为 文本型, 值 为 文本型, 已选中 为 逻辑型)
	如果 已选中 则
		反馈.文本 = "已选择兴趣：" & 标题
	否则
		反馈.文本 = "已取消兴趣：" & 标题
	结束 如果
	输出信息("XUI-EXAMPLE", "标签与流式布局 Tag | " & 反馈.文本)
结束 事件

' 单选模式使用选择集合事件，反馈当前选中的标签。
事件 流式.选择改变(索引数组 为 整数型())
	如果 取数组成员数(索引数组) > 0 则
		反馈.文本 = "流式标签：" & 流式项目(索引数组(0))
	否则
		反馈.文本 = "当前未选择流式标签。"
	结束 如果
	输出信息("XUI-EXAMPLE", 反馈.文本)
结束 事件

事件 标签示例.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		返回目录()
	结束 如果
结束 事件

' 离开页面时释放组件并注销窗口事件，确保再次进入时重新初始化。
事件 标签示例.即将切换()
	流式.销毁()
	多选.销毁()
	单选.销毁()
	滚动区.销毁()
	导航.销毁()
	销毁()
结束 事件
$属性
	$资源 $窗口
	$定义 标签示例 $为 窗口
		标题 = "标签"
		背景颜色 = -1
		$定义 导航 $为 simple.library.wsd.xui.XUI标题栏
			宽度 = 长度_匹配父级
			高度 = "56dp"
			内容描述 = "导航"
			背景颜色 = -15181370
		$结束 $定义
		$定义 内容区域 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 滚动区 $为 simple.library.wsd.xui.XUI滚动框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				内容描述 = "滚动区"
				$定义 内容 $为 面板
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					左填充 = "16dp"
					右填充 = "16dp"
					顶填充 = "16dp"
					底填充 = "24dp"
					$定义 介绍 $为 标签
						文本 = "选择服装尺码、勾选兴趣，体验单选、多选和自动换行标签。"
						字体大小 = 13
						文本颜色 = -9471604
						宽度 = 长度_匹配父级
					$结束 $定义
					$定义 单选标题 $为 标签
						文本 = "单选标签"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 单选 $为 simple.library.wsd.xui.XUI单选标签
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						内容描述 = "单选"
					$结束 $定义
					$定义 多选标题 $为 标签
						文本 = "多选标签"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 多选 $为 simple.library.wsd.xui.XUI多选标签
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						内容描述 = "多选"
					$结束 $定义
					$定义 流式标题 $为 标签
						文本 = "自动换行"
						字体大小 = 15
						文本颜色 = -13815236
						宽度 = 长度_匹配父级
						字体加粗 = 真
						顶边距 = "20dp"
						底边距 = "10dp"
					$结束 $定义
					$定义 流式 $为 simple.library.wsd.xui.XUI流式标签
						宽度 = 长度_匹配父级
						高度 = 长度_适应内容
						内容描述 = "流式"
					$结束 $定义
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "操作结果会显示在这里。"
			字体大小 = 13
			文本颜色 = -15181370
			背景颜色 = -919554
			宽度 = 长度_匹配父级
			高度 = "48dp"
			左填充 = "16dp"
			右填充 = "16dp"
			内容对齐 = 对齐_垂直居中
		$结束 $定义
	$结束 $定义
$结束 $属性
