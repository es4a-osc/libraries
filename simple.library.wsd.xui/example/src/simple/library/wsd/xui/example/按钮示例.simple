						底边距 = "8dp"
					$结束 $定义
					$定义 倒计时按钮 $为 simple.library.wsd.xui.XUI倒计时按钮
						字体大小 = 14
						内容对齐 = 对齐_居中
						宽度 = 长度_匹配父级
						高度 = "48dp"
						内容描述 = "倒计时按钮"
						文本 = "获取验证码"
						顶边距 = "8dp"
					$结束 $定义
					$定义 取消按钮 $为 simple.library.wsd.xui.XUI圆角按钮
						文本 = "取消倒计时并恢复"
						内容描述 = "取消按钮"
						宽度 = 长度_匹配父级
						高度 = "48dp"
						字体大小 = 14
