事件 完整能力测试.初始化()
	标签组.置项目数组(分割文本("甲|乙|丙", "|"))
	标签组.置选择模式(标签组.选择模式_多选)
	断言真(标签组.取选择模式() = 标签组.选择模式_多选)
	标签组.添加标签("丁")
	断言真(标签组.取标签文本(3) = "丁")
	标签组.移除标签(3)
	超级文本.置左侧文本("编辑与开关")
	超级文本.置中间编辑文本("初始输入")
	超级文本.置编辑提示("请输入内容")
	超级文本.置开关是否选中(真, 真)
	断言真(超级文本.取开关是否选中())
	列表项.置文本("自定义列表项")
	列表项.置详情文本("开关、图标和标记")
	列表项.置图标("icon.png")
	列表项.显示红点(真)
	列表项.置附属类型(列表项.附属类型_开关)
	列表项.置开关选中(真, 真)
	断言真(列表项.取开关选中())
	日志.追加日志("普通消息", 日志.日志级别_普通)
	日志.追加日志("成功消息", 日志.日志级别_成功)
	日志.追加日志("警告消息", 日志.日志级别_警告)
	日志.追加日志("错误消息", 日志.日志级别_错误)
	标题栏.置标题("可更新的操作项")
	标题栏.添加操作("先移除")
	标题栏.添加操作("原第二项")
	标题栏.移除操作(0)
	标题栏.置操作文本(0, "当前位置0")
	分段.置标签数组(分割文本("推荐|收藏", "|"))
	分段.置标签文本(1, "已更新")
	分段.置标签徽标(1, 3)
	断言真(分段.取标记数量(1) = 3)
	对话.置中立按钮("稍后")
	对话.置复选提示("记住选择", 真)
	日期.置列标签(分割文本("年|月|日|时|分|秒", "|"))
	日期.置循环(真)
	日期.置行距(1.8)
	日期.置分隔线类型(日期.分隔线_适应文字)
	选择.置独立项目(分割文本("甲|乙", "|"), 分割文本("一|二", "|"), 分割文本("A|B", "|"))
	选择.置列标签("项", "号", "级")
	选择.置循环(真, 假, 真)
	状态.文本 = "初始化断言通过；请操作各项，查看下方事件反馈。"
	输出信息("XUI-COMPLETE-ALL", "SIMPLE_INIT_PASS")
结束 事件

事件 返回按钮.被单击()
	切换窗口(创建 主窗口)
结束 事件

事件 对话按钮.被单击()
	对话.显示单选("当前选中可在确认前读取", 分割文本("甲|乙|丙", "|"), 1)
结束 事件

事件 对话.确认前校验(文本 为 文本型, 传址 取消 为 逻辑型)
	状态.文本 = "确认前选中：" & 对话.取单选位置() & "；复选提示：" & 对话.取复选提示选中()
结束 事件

事件 日期按钮.被单击()
	日期.显示()
结束 事件

事件 选择按钮.被单击()
	选择.显示()
结束 事件

事件 气泡按钮.被单击()
	气泡.置颜色(-14540254, -1)
	气泡.置文字大小(18)
	气泡.置内边距(20, 16, 20, 16)
	气泡.显示(气泡按钮, "可配置的气泡", 气泡.方向_上, 1500)
结束 事件

事件 超级文本.附属选中改变(类型 为 整数型, 选中 为 逻辑型)
	状态.文本 = "超级文本附属类型：" & 类型 & "；选中：" & 选中
结束 事件

事件 超级文本.编辑文本改变(文本 为 文本型)
	状态.文本 = "当前输入：" & 文本
结束 事件

事件 列表项.开关改变(选中 为 逻辑型)
	状态.文本 = "列表开关：" & 选中
结束 事件

事件 标题栏.操作被单击(位置 为 整数型)
	断言真(位置 = 0)
	状态.文本 = "删除前项后，操作索引正确：" & 位置
结束 事件

事件 气泡.已显示()
	状态.文本 = "气泡已显示"
结束 事件

事件 气泡.已关闭()
	状态.文本 = "气泡已关闭"
结束 事件

$属性
	$资源 $窗口
	$定义 完整能力测试 $为 窗口
		标题 = "XUI 完整能力验证"
		滚动 = 真
		$定义 返回按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			文本 = ""
		$结束 $定义
		$定义 标题栏 $为 simple.library.wsd.xui.XUI标题栏
			宽度 = 长度_匹配父级
			高度 = "56dp"
		$结束 $定义
		$定义 超级文本 $为 simple.library.wsd.xui.XUI超级文本
			宽度 = 长度_匹配父级
			高度 = "64dp"
		$结束 $定义
		$定义 列表项 $为 simple.library.wsd.xui.XUI分组列表项
			宽度 = 长度_匹配父级
			高度 = "64dp"
		$结束 $定义
		$定义 标签组 $为 simple.library.wsd.xui.XUI流式标签
			宽度 = 长度_匹配父级
			高度 = "90dp"
		$结束 $定义
		$定义 分段 $为 simple.library.wsd.xui.XUI分段标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 对话按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "单选与复选提示"
		$结束 $定义
		$定义 日期按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "日期单位、循环及行距"
		$结束 $定义
		$定义 选择按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "独立列单位与循环"
		$结束 $定义
		$定义 气泡按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "气泡样式与显示事件"
		$结束 $定义
		$定义 日志 $为 simple.library.wsd.xui.XUI日志文本
			宽度 = 长度_匹配父级
			高度 = "180dp"
		$结束 $定义
		$定义 对话 $为 simple.library.wsd.xui.XUI对话框
		$结束 $定义
		$定义 气泡 $为 simple.library.wsd.xui.XUI气泡
		$结束 $定义
		$定义 日期 $为 simple.library.wsd.xui.XUI日期时间选择器
		$结束 $定义
		$定义 选择 $为 simple.library.wsd.xui.XUI多级选择器
		$结束 $定义
	$结束 $定义
$结束 $属性
