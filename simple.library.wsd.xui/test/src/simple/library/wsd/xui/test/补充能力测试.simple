事件 补充能力测试.初始化()
	验证列表(文本列表)
	验证列表(图文列表)
	图文列表.置图文项目(分割文本("标题甲|标题乙", "|"), 分割文本("说明甲|说明乙", "|"), 分割文本("|", "|"))
	图文列表.置图文项目内容(0, "更新标题", "更新说明", "")
	断言真(图文列表.取项目文本(0) = "更新标题")
	分组列表.添加分组("第一组", 分割文本("甲|乙", "|"))
	分组列表.添加分组("第二组", 分割文本("丙|丁", "|"))
	分组列表.置选中项目(1, 1)
	分组列表.移除分组(0)
	断言真(分组列表.取选中分组() = 0)
	分组列表.移除项目(0, 0)
	断言真(分组列表.取选中项目() = 0)
	分组列表.更新分组(0, "更新组", 分割文本("一|二|三", "|"))
	断言真(分组列表.取选中项目() = -1)
	记录.文本 = "列表数据断言通过，请操作下列功能。"
	输出信息("XUI-COMPLETION", "LIST_DATA_PASS")
	对话.置取消方式(真, 假)
	对话.置输入长度(2, 8)
	日期.置标题("选择日期")
	日期.置按钮文本("采用", "放弃")
	日期.置文字颜色(-16777216, -8355712)
	日期.置字号(18, 20, 16)
	日期.置取消方式(真, 假)
	选择.置标题("选择项目")
	选择.置按钮文本("采用", "放弃")
	选择.置字号(18, 20, 16)
	选择.置独立项目(分割文本("甲|乙|丙", "|"), 分割文本("一|二|三", "|"), 分割文本("A|B|C", "|"))
结束 事件

过程 验证列表(列表 为 simple.library.wsd.xui.XUI列表)
	变量 文本 为 文本型()
	文本 = 分割文本("甲|乙|丙", "|")
	列表.置项目数组(文本)
	文本(0) = "外部修改"
	断言真(列表.取项目文本(0) = "甲")
	列表.置选中项目(2)
	列表.移除项目(0)
	断言真(列表.取选中项目() = 1)
	列表.置项目文本(1, "更新丙")
	断言真(列表.取选中项目() = 1)
	列表.添加项目("新增")
	断言真(列表.取项目数() = 3)
	列表.移除项目(1)
	断言真(列表.取选中项目() = -1)
	列表.清空项目()
	断言真(列表.取项目数() = 0)
	列表.置项目数组(分割文本("一|二|三|四|五|六|七|八|九|十", "|"))
结束 过程

事件 返回按钮.被单击()
	切换窗口(创建 主窗口)
结束 事件

事件 输入按钮.被单击()
	对话.显示输入("确认前校验", "输入“通过”才可确认", "", 假)
结束 事件

事件 自定义按钮.被单击()
	对话.显示自定义("自定义内容", 弹出内容, "采用", "取消")
结束 事件

事件 对话.确认前校验(文本 为 文本型, 传址 取消 为 逻辑型)
	如果 文本 <> "" 则
		如果 文本 <> "通过" 则
			取消 = 真
			对话.置输入错误("请输入“通过”")
			记录.文本 = "确认已阻止，对话框保持打开"
		结束 如果
	结束 如果
结束 事件

事件 对话.输入已确认(文本 为 文本型)
	记录.文本 = "输入已确认：" & 文本
	输出信息("XUI-COMPLETION", "DIALOG_INPUT_CONFIRMED")
结束 事件

事件 对话.已关闭()
	断言真(取反 弹出内容.可视)
	输出信息("XUI-COMPLETION", "DIALOG_CLOSED_CONTENT_RESTORED")
结束 事件

事件 日期按钮.被单击()
	日期.显示()
结束 事件

事件 选择按钮.被单击()
	选择.显示()
结束 事件

事件 日期.日期已改变(时间戳 为 长整数型)
	记录.文本 = "日期滚动中：" & 时间戳
结束 事件

事件 日期.日期已确认(时间戳 为 长整数型)
	记录.文本 = "日期已确认：" & 时间戳
结束 事件

事件 日期.已取消()
	记录.文本 = "日期已取消"
结束 事件

事件 日期.已关闭()
	输出信息("XUI-COMPLETION", "TIME_CLOSED")
结束 事件

事件 选择.选择已改变(第一列 为 整数型, 第二列 为 整数型, 第三列 为 整数型)
	记录.文本 = "正在选择：" & 第一列 & "，" & 第二列 & "，" & 第三列
结束 事件

事件 选择.已取消()
	记录.文本 = "选择已取消"
结束 事件

事件 选择.已关闭()
	输出信息("XUI-COMPLETION", "OPTIONS_CLOSED")
结束 事件

事件 定位按钮.被单击()
	文本列表.置选中项目(9)
	文本列表.滚动到项目(9, 假)
	分组列表.置选中项目(0, 2)
	分组列表.滚动到项目(0, 2, 真)
	记录.文本 = "已定位并选中指定项目"
结束 事件

事件 文本列表.项目被单击(索引 为 整数型, 文本 为 文本型)
	断言真(文本列表.取选中项目() = 索引)
	记录.文本 = "已选项目：" & 文本
	输出信息("XUI-COMPLETION", "LIST_CLICK_SELECTION_PASS")
结束 事件

事件 图文列表.项目被单击(索引 为 整数型, 文本 为 文本型)
	断言真(图文列表.取选中项目() = 索引)
	记录.文本 = "已选项目：" & 文本
	输出信息("XUI-COMPLETION", "LIST_CLICK_SELECTION_PASS")
结束 事件

事件 分组列表.项目被单击(分组索引 为 整数型, 项目索引 为 整数型, 文本 为 文本型)
	断言真(分组列表.取选中分组() = 分组索引)
	断言真(分组列表.取选中项目() = 项目索引)
	记录.文本 = "已选分组子项：" & 文本
	输出信息("XUI-COMPLETION", "GROUP_CLICK_SELECTION_PASS")
结束 事件

$属性
	$资源 $窗口
	$定义 补充能力测试 $为 窗口
		标题 = "XUI 补充能力验证"
		滚动 = 真
		$定义 记录 $为 标签
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 返回按钮 $为 按钮
			文本 = "返回目录"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 输入按钮 $为 按钮
			文本 = "输入校验对话框"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 自定义按钮 $为 按钮
			文本 = "自定义内容对话框"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 日期按钮 $为 按钮
			文本 = "日期选择器配置与事件"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 选择按钮 $为 按钮
			文本 = "多级选择器配置与事件"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 定位按钮 $为 按钮
			文本 = "列表选择与滚动定位"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 文本列表 $为 simple.library.wsd.xui.XUI联动列表
			宽度 = 长度_匹配父级
			高度 = "120dp"
		$结束 $定义
		$定义 图文列表 $为 simple.library.wsd.xui.XUI自适应列表
			宽度 = 长度_匹配父级
			高度 = "120dp"
		$结束 $定义
		$定义 分组列表 $为 simple.library.wsd.xui.XUI自适应分组列表
			宽度 = 长度_匹配父级
			高度 = "120dp"
		$结束 $定义
		$定义 弹出内容 $为 面板
			可视 = 假
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			$定义 自定义说明 $为 标签
				文本 = "此内容关闭后恢复原页面的隐藏状态。"
			$结束 $定义
			$定义 自定义输入 $为 编辑框
				提示文本 = "自定义表单内容"
				宽度 = 长度_匹配父级
			$结束 $定义
		$结束 $定义
		$定义 对话 $为 simple.library.wsd.xui.XUI对话框
		$结束 $定义
		$定义 日期 $为 simple.library.wsd.xui.XUI日期时间选择器
		$结束 $定义
		$定义 选择 $为 simple.library.wsd.xui.XUI多级选择器
		$结束 $定义
	$结束 $定义
$结束 $属性
