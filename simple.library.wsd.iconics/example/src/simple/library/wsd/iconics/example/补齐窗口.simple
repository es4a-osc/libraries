变量 控制步骤 为 整数型
别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标错误 = simple.library.wsd.iconics.图标错误

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 心形 为 图标图像
变量 普通 为 图标图像
变量 旋转号 为 整数型
变量 透明号 为 整数型
变量 资源字体 为 图标字体
变量 资源字体已创建 为 逻辑型

事件 补齐窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 28
	样式.高度 = 28
	样式.颜色 = -65536
	心形 = 图标工具.创建图标("xui_collect", 样式)
	样式.颜色 = -16776961
	普通 = 图标工具.创建图标("xui_add", 样式)
	预览.设置图标(心形)
	选择.设置文字("四侧独立状态图标")
	选择.设置字号(16.0)
	选择.设置图文间距(5)
结束 事件

事件 四侧.被单击()
	选择.设置四侧选中图标(心形, 普通)
	选择.设置选中(真)
	变量 图 为 图标图像
	图 = 选择.取位置选中图标(3)
	反馈.文本 = "四侧选中图标：" & 图.取图标名称() & "；图文间距：" & 选择.取图文间距()
结束 事件

事件 方向.被单击()
	选择.设置布局方向(1)
	选择.设置位置选中图标(4, 图标工具.创建图标("xui_back", 样式), 普通)
	选择.设置附图(普通, 1)
	选择.设置选中(真)
	变量 图 为 图标图像
	图 = 选择.取位置选中图标(4)
	反馈.文本 = "RTL=" & 选择.取布局方向() & "；起始侧选中图标=" & 图.取图标名称()
结束 事件

事件 清除.被单击()
	选择.清除附图(4)
	预览.清除图标()
	变量 图 为 图标图像
	图 = 预览.取图标()
	如果 图 = 空 则
		反馈.文本 = "图片已清除；起始侧常态附图已清除，选中态保留"
	结束 如果
结束 事件

事件 色彩.被单击()
	变量 颜色 为 图标状态颜色
	变量 状态集 为 整数型(1)
	状态集(0) = 16842912
	颜色 = 创建 图标状态颜色
	颜色.置默认颜色(-16776961)
	颜色.添加(状态集, -65536)
	心形.设置状态着色(颜色)
	心形.设置状态(状态集)
	心形.应用图片(预览)
	变量 快照 为 图标样式
	变量 读取颜色 为 图标状态颜色
	快照 = 心形.取得样式()
	读取颜色 = 快照.着色状态色
	反馈.文本 = "选中态着色=" & 读取颜色.取状态颜色(状态集) & "；默认=" & 读取颜色.取默认颜色()
结束 事件

事件 滤镜.被单击()
	变量 矩阵 为 单精度小数型(20)
	矩阵(0) = 0.33
	矩阵(1) = 0.33
	矩阵(2) = 0.33
	矩阵(5) = 0.33
	矩阵(6) = 0.33
	矩阵(7) = 0.33
	矩阵(10) = 0.33
	矩阵(11) = 0.33
	矩阵(12) = 0.33
	矩阵(18) = 1.0
	心形.设置颜色矩阵(矩阵)
	心形.应用图片(预览)
	反馈.文本 = "灰度滤镜=" & 心形.是否有滤镜() & "；尺寸=" & 心形.取像素宽度() & "px"
结束 事件

事件 重置.被单击()
	心形.清除着色()
	心形.清除滤镜()
	心形.应用图片(预览)
	反馈.文本 = "着色和滤镜已清除；滤镜=" & 心形.是否有滤镜()
结束 事件

事件 字体.被单击()
	如果 取反 资源字体已创建 则
		资源字体 = 图标工具.创建资源字体("rsc", 取资源标识("es4a_example_font", "font"))
		资源字体.添加映射("face", 58920)
		图标工具.注册字体(资源字体)
		资源字体已创建 = 真
	结束 如果
	变量 名称 为 文本型(3)
	名称(0) = "xui_chat"
	名称(1) = "xui_collect"
	名称(2) = "rsc_face"
	变量 图集 为 图标图像()
	图集 = 图标工具.批量创建图标(名称, 样式)
	变量 字形 为 文本型
	变量 单图 为 图标图像
	单图 = 图集(2)
	字形 = 单图.取图标文字()
	变量 图 为 图标图像
	图 = 图标工具.创建文字图标(资源字体, 字形 & 字形, 样式)
	预览.设置图标(图)
	反馈.文本 = "批量生成=" & 取数组成员数(图集) & "；资源字体已加载；双字符已绘制"
结束 事件

事件 组合.被单击()
	控制步骤 = 0
	动画.绑定(预览, 心形, -1)
	变量 配置 为 图标动画配置
	配置 = 创建 图标动画配置
	配置.时长 = 1800
	旋转号 = 动画.添加(配置)
	配置.类型 = 1
	配置.起值 = 80.0
	配置.止值 = 255.0
	配置.往返 = 真
	透明号 = 动画.添加(配置)
	配置.类型 = 2
	配置.起值 = 0.7
	配置.止值 = 1.0
	动画.添加(配置)
	动画.开始()
	反馈.文本 = "组合已启动；数量=" & 动画.取动画数量() & "；旋转编号=" & 旋转号
结束 事件

事件 单停.被单击()
	动画.暂停单项(旋转号)
	动画.设置单项进度(旋转号, 0.5)
	反馈.文本 = "旋转暂停=" & 动画.单项已暂停(旋转号) & "；角度=" & 动画.取单项当前值(旋转号) & "；透明运行=" & 动画.单项正在运行(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动组合；已移除或解除的动画需要重新添加。"
		分支 否则
			反馈.文本 = "操作未完成，请查看当前运行条件。"
	结束 错误
结束 事件

事件 移除.被单击()
	动画.移除(旋转号)
	反馈.文本 = "移除后数量=" & 动画.取动画数量() & "；透明编号=" & 透明号 & "；仍运行=" & 动画.单项正在运行(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动组合；已移除或解除的动画需要重新添加。"
		分支 否则
			反馈.文本 = "操作未完成，请查看当前运行条件。"
	结束 错误
结束 事件

事件 定位.被单击()
	动画.暂停单项(透明号)
	动画.设置单项播放时间(透明号, 900)
	反馈.文本 = "透明播放时间=" & 动画.取单项播放时间(透明号) & "；当前值=" & 动画.取单项当前值(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动组合；已移除或解除的动画需要重新添加。"
		分支 否则
			反馈.文本 = "操作未完成，请查看当前运行条件。"
	结束 错误
结束 事件

事件 查询.被单击()
	如果 动画.取动画数量() = 0 则
		反馈.文本 = "请先启动组合动画"
	否则
		反馈.文本 = "透明运行=" & 动画.单项正在运行(透明号) & "；透明暂停=" & 动画.单项已暂停(透明号) & "；组合运行=" & 动画.正在运行()
	结束 如果
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动组合；已移除或解除的动画需要重新添加。"
		分支 否则
			反馈.文本 = "操作未完成，请查看当前运行条件。"
	结束 错误
结束 事件

事件 失效.被单击()
	展示失效编号()
结束 事件

过程 展示失效编号()
	动画.开始单项(-1)
	位于 错误
		分支 图标错误
			反馈.文本 = "已捕获图标错误：失效动画编号"
		分支 否则
			反馈.文本 = "发生其他错误"
	结束 错误
结束 过程

事件 返回.被单击()
	切换窗口(来源)
	来源.报告离开状态(动画.正在运行())
结束 事件

事件 补齐窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 更多.被单击()
	如果 动画.取动画数量() = 0 则
		反馈.文本 = "请先启动独立组合"
		退出 事件
	结束 如果
	控制步骤 = 控制步骤 + 1
	如果 控制步骤 > 8 则
		控制步骤 = 1
	结束 如果
	如果 控制步骤 = 1 则
		动画.取消()
		动画.开始单项(透明号)
		反馈.文本 = "单项启动：已开始=" & 动画.单项已开始(透明号)
	否则如果 控制步骤 = 2 则
		动画.暂停单项(透明号)
		反馈.文本 = "单项暂停=" & 动画.单项已暂停(透明号)
	否则如果 控制步骤 = 3 则
		动画.继续单项(透明号)
		反馈.文本 = "单项继续：运行=" & 动画.单项正在运行(透明号)
	否则如果 控制步骤 = 4 则
		动画.反向单项(透明号)
		反馈.文本 = "单项反向：运行=" & 动画.单项正在运行(透明号)
	否则如果 控制步骤 = 5 则
		动画.结束单项(透明号)
		反馈.文本 = "单项结束：已开始=" & 动画.单项已开始(透明号)
	否则如果 控制步骤 = 6 则
		动画.开始单项(透明号)
		动画.取消单项(透明号)
		反馈.文本 = "单项取消：已开始=" & 动画.单项已开始(透明号)
	否则如果 控制步骤 = 7 则
		变量 配置 为 图标动画配置
		变量 编号 为 整数型()
		配置 = 动画.取得单项配置(透明号)
		配置.时长 = 123
		配置 = 动画.取得单项配置(透明号)
		编号 = 动画.取动画编号()
		反馈.文本 = "配置副本隔离：时长=" & 配置.时长 & "；编号数量=" & 取数组成员数(编号)
	否则
		变量 帧 为 字节型()
		帧 = 动画.取当前帧PNG()
		动画.解除绑定()
		反馈.文本 = "当前帧PNG=" & 取数组成员数(帧) & "；解除后绑定=" & 动画.是否已绑定() & "；数量=" & 动画.取动画数量()
	结束 如果
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动组合；已移除或解除的动画需要重新添加。"
		分支 否则
			反馈.文本 = "操作未完成，请查看当前运行条件。"
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 补齐窗口 $为 窗口
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = -1
		左填充 = "8dp"
		右填充 = "8dp"
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "36dp"
			文本 = "四侧图标 · 状态 · 单项动画"
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			高度 = "66dp"
			文本 = "先查看四侧图标，再体验独立动画控制。"
		$结束 $定义
		$定义 选择 $为 simple.library.wsd.iconics.字体图标可选文本框
			宽度 = 长度_匹配父级
			高度 = "100dp"
		$结束 $定义
		$定义 预览 $为 simple.library.wsd.iconics.字体图标图片框
			宽度 = 长度_匹配父级
			高度 = "88dp"
		$结束 $定义
		$定义 操作行0 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 四侧 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "四侧选中"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 方向 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "RTL相对位置"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 操作行2 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 清除 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "读取与清除"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 色彩 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "状态着色"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 操作行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 滤镜 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "灰度滤镜"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 重置 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "清除色彩"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 操作行6 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 字体 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "资源字体与批量"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 组合 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "启动独立组合"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 操作行8 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 单停 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "暂停旋转"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 移除 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "移除旋转"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 操作行10 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 定位 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "播放定位"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 查询 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "状态查询"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 操作行12 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 失效 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "失效编号"
				权重 = 1
				字体大小 = 12
			$结束 $定义
			$定义 返回 $为 按钮
				宽度 = 0
				高度 = "40dp"
				文本 = "暂离窗口"
				权重 = 1
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 动画 $为 simple.library.wsd.iconics.图标动画
		$结束 $定义
		$定义 更多 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "更多单项控制（连续点击）"
		$结束 $定义
	$结束 $定义
$结束 $属性
