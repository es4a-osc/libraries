别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 混排 为 图标文字

事件 默认.被单击()
	图标工具.应用文字图标(文字, 输入.文本)
	反馈.文本 = "已应用默认图标混排。"
	位于 错误
		分支 图标错误
			反馈.文本 = "图标名称无效。请使用 {xui_chat} 或 {xui_collect}。"
	结束 错误
结束 事件

事件 指定.被单击()
	混排 = 创建 图标文字
	变量 统一 为 图标文字样式
	变量 收藏 为 图标文字样式
	统一 = 创建 图标文字样式
	统一.颜色 = -15108398
	统一.字号 = 20
	混排.统一样式(统一)
	收藏 = 创建 图标文字样式
	收藏.颜色 = -65536
	收藏.粗体 = 真
	收藏.下划线 = 真
	混排.指定样式("xui_collect", 收藏)
	混排.应用(文字, 输入.文本)
	反馈.文本 = "全部图标蓝色；收藏图标红色、粗体并带下划线。"
	位于 错误
		分支 图标错误
			反馈.文本 = "图标名称无效。请使用 {xui_chat} 或 {xui_collect}。"
	结束 错误
结束 事件

事件 清空.被单击()
	混排 = 创建 图标文字
	混排.清空()
	文字.设置文字("")
	反馈.文本 = "混排样式和预览文字已清空。输入框仍保留内容。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 文字窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 文字窗口 $为 窗口
		标题 = "4. 文字混排"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "4. 文字混排"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "使用 {xui_chat} 这样的标记在文字中插入图标。支持统一样式和指定图标样式。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "聊天 {xui_chat}  收藏 {xui_collect}"
		$结束 $定义
		$定义 文字 $为 simple.library.wsd.iconics.字体图标文本框
			宽度 = 长度_匹配父级
			高度 = "65dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 默认 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "应用默认图标混排"
				$结束 $定义
				$定义 指定 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "统一样式与指定图标样式"
				$结束 $定义
				$定义 清空 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "清空预览文字"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
