别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 图像 为 图标图像

事件 动画窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 48
	样式.高度 = 48
	样式.颜色 = -15108398
	图像 = 图标工具.创建图标("xui_collect", 样式)
	预览.设置图标(图像)
结束 事件

变量 旋转号 为 整数型
变量 透明号 为 整数型

事件 启动.被单击()
	动画.绑定(预览, 图像, 图标常量.位置_图片)
	变量 配置 为 图标动画配置
	配置 = 创建 图标动画配置
	配置.时长 = 1800
	旋转号 = 动画.添加(配置)
	配置.类型 = 1
	配置.起值 = 80.0
	配置.止值 = 255.0
	配置.往返 = 真
	透明号 = 动画.添加(配置)
	配置.类型 = 2
	配置.起值 = 0.7
	配置.止值 = 1.0
	动画.添加(配置)
	动画.开始()
	反馈.文本 = "组合已启动；动画数量：" & 动画.取动画数量()
结束 事件

事件 暂停.被单击()
	动画.暂停()
	反馈.文本 = "暂停操作完成；正在运行：" & 动画.正在运行()
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动动画，并保持预览在当前窗口可见。"
	结束 错误
结束 事件

事件 继续.被单击()
	动画.继续()
	反馈.文本 = "继续操作完成；正在运行：" & 动画.正在运行()
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动动画，并保持预览在当前窗口可见。"
	结束 错误
结束 事件

事件 反向.被单击()
	动画.反向()
	反馈.文本 = "反向操作完成；正在运行：" & 动画.正在运行()
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动动画，并保持预览在当前窗口可见。"
	结束 错误
结束 事件

事件 结束按钮.被单击()
	动画.结束()
	反馈.文本 = "结束操作完成；正在运行：" & 动画.正在运行()
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动动画，并保持预览在当前窗口可见。"
	结束 错误
结束 事件

事件 取消.被单击()
	动画.取消()
	反馈.文本 = "取消操作完成；正在运行：" & 动画.正在运行()
	位于 错误
		分支 图标错误
			反馈.文本 = "请先启动动画，并保持预览在当前窗口可见。"
	结束 错误
结束 事件

事件 查询.被单击()
	反馈.文本 = "绑定有效：" & 动画.是否已绑定() & "；正在运行：" & 动画.正在运行() & "\n数量：" & 动画.取动画数量()
结束 事件

事件 动画.动画开始(序号 为 整数型)
	事件反馈.文本 = "动画开始，编号：" & 序号
结束 事件

事件 动画.动画暂停(序号 为 整数型)
	事件反馈.文本 = "动画暂停，编号：" & 序号
结束 事件

事件 动画.动画继续(序号 为 整数型)
	事件反馈.文本 = "动画继续，编号：" & 序号
结束 事件

事件 动画.动画取消(序号 为 整数型)
	事件反馈.文本 = "动画取消，编号：" & 序号
结束 事件

事件 动画.动画结束(序号 为 整数型)
	事件反馈.文本 = "动画结束，编号：" & 序号
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 动画窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 动画窗口 $为 窗口
		标题 = "7. 组合动画"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "7. 组合动画"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "旋转、透明和缩放可同时运行。切换窗口或进入后台会自动暂停，返回后自动恢复。"
		$结束 $定义
		$定义 预览 $为 simple.library.wsd.iconics.字体图标图片框
			宽度 = 长度_匹配父级
			高度 = "70dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 启动 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "创建并启动三种组合动画"
				$结束 $定义
				$定义 暂停 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "暂停组合"
				$结束 $定义
				$定义 继续 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "继续组合"
				$结束 $定义
				$定义 反向 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "反向播放组合"
				$结束 $定义
				$定义 结束按钮 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "结束组合"
				$结束 $定义
				$定义 取消 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "取消组合"
				$结束 $定义
				$定义 查询 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "查询运行与绑定状态"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
				$定义 事件反馈 $为 标签
					宽度 = 长度_匹配父级
					高度 = "55dp"
					文本 = "动画事件会显示在这里。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 动画 $为 simple.library.wsd.iconics.图标动画
		$结束 $定义
	$结束 $定义
$结束 $属性
