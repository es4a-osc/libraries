别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 图像 为 图标图像

事件 控件窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 28
	样式.高度 = 28
	样式.颜色 = -15108398
	图像 = 图标工具.创建图标("xui_collect", 样式)
	图片.设置图标(图像)
	图片按钮.设置图标(图像)
	文字.设置文字("文字 {xui_chat}")
	图标按钮.设置文字("{xui_add} 添加")
	复选.设置文字("复选框")
	复选.设置选中图标(图像, 图标工具.创建图标("xui_add", 样式))
	可选.设置文字("可选文本")
	可选.设置选中图标(图像, 图标工具.创建图标("xui_add", 样式))
	切换.设置文字("切换按钮")
	切换.设置选中图标(图像, 图标工具.创建图标("xui_add", 样式))
结束 事件

事件 复选.选中改变(选中 为 逻辑型)
	反馈.文本 = "复选选中：" & 选中
结束 事件

事件 可选.选中改变(选中 为 逻辑型)
	反馈.文本 = "可选选中：" & 选中
结束 事件

事件 切换.选中改变(选中 为 逻辑型)
	反馈.文本 = "切换选中：" & 选中
结束 事件

事件 图标按钮.被单击()
	反馈.文本 = "收到图标按钮的单击事件。"
结束 事件

事件 图片按钮.被单击()
	反馈.文本 = "收到图片按钮的单击事件。"
结束 事件

事件 图片.被长按()
	反馈.文本 = "收到图片的长按事件。"
结束 事件

事件 切换状态.被单击()
	复选.切换选中()
	可选.切换选中()
	切换.切换选中()
	反馈.文本 = "复选：" & 复选.是否选中() & "；可选：" & 可选.是否选中() & "；切换：" & 切换.是否选中()
结束 事件

事件 图片设置.被单击()
	图片.设置图片缩放方式(3)
	图片.设置保持宽高比(真)
	图片.设置内容描述("收藏图标")
	反馈.文本 = "缩放方式：" & 图片.取图片缩放方式() & "；保持比例：" & 图片.是否保持宽高比() & "\n描述：" & 图片.取内容描述()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 控件窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 控件窗口 $为 窗口
		标题 = "5. 图标控件"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "5. 图标控件"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "点击图标按钮、图片按钮和三种可选控件，查看下方真实事件反馈。"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				$定义 图片 $为 simple.library.wsd.iconics.字体图标图片框
					宽度 = 长度_匹配父级
					高度 = "42dp"
				$结束 $定义
				$定义 图片按钮 $为 simple.library.wsd.iconics.字体图标图片按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
				$结束 $定义
				$定义 文字 $为 simple.library.wsd.iconics.字体图标文本框
					宽度 = 长度_匹配父级
					高度 = "42dp"
				$结束 $定义
				$定义 图标按钮 $为 simple.library.wsd.iconics.字体图标按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
				$结束 $定义
				$定义 复选 $为 simple.library.wsd.iconics.字体图标复选框
					宽度 = 长度_匹配父级
					高度 = "42dp"
				$结束 $定义
				$定义 可选 $为 simple.library.wsd.iconics.字体图标可选文本框
					宽度 = 长度_匹配父级
					高度 = "48dp"
				$结束 $定义
				$定义 切换 $为 simple.library.wsd.iconics.字体图标切换按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
				$结束 $定义
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 切换状态 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "切换三种选中状态"
				$结束 $定义
				$定义 图片设置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "设置图片缩放与内容描述"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
