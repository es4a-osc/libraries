别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 图像 为 图标图像

事件 自定义字体窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 48
	样式.高度 = 48
	样式.颜色 = -15108398
	图像 = 图标工具.创建图标("xui_collect", 样式)
	预览.设置图标(图像)
结束 事件

变量 自定义 为 图标字体

事件 资产.被单击()
	如果 取反 图标工具.图标存在("dem_smile") 则
		自定义 = 图标工具.创建资产字体("dem", "demo.ttf")
		自定义.添加映射("smile", 58920)
		图标工具.注册字体(自定义)
	结束 如果
	图像 = 图标工具.创建图标("dem_smile", 样式)
	预览.设置图标(图像)
	反馈.文本 = "资产字体已注册；图标名：" & 图像.取图标名称()
结束 事件

事件 资源.被单击()
	自定义 = 图标工具.创建资源字体("rsc", 取资源标识("es4a_example_font", "font"))
	图像 = 图标工具.创建字符图标(自定义, 58920, 样式)
	预览.设置图标(图像)
	反馈.文本 = "直接使用资源字体和字符码 58920；无需注册名称。"
结束 事件

事件 文件.被单击()
	自定义 = 图标工具.创建文件字体("fil", 输入.文本)
	图像 = 图标工具.创建字符图标(自定义, 58920, 样式)
	预览.设置图标(图像)
	反馈.文本 = "已从指定文件读取字体。"
	位于 错误
		分支 图标错误
			反馈.文本 = "请输入本应用可读的 TTF/OTF 文件绝对路径。"
	结束 错误
结束 事件

事件 文字图.被单击()
	自定义 = 图标工具.创建资源字体("rsc", 取资源标识("es4a_example_font", "font"))
	变量 单字 为 图标图像
	单字 = 图标工具.创建字符图标(自定义, 58920, 样式)
	图像 = 图标工具.创建文字图标(自定义, 单字.取图标文字() & 单字.取图标文字(), 样式)
	预览.设置图标(图像)
	反馈.文本 = "同一字体绘制两个字符，不解析花括号标记。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 自定义字体窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 自定义字体窗口 $为 窗口
		标题 = "2. 自定义字体"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "2. 自定义字体"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "示例附带 demo.ttf 和字体资源。文件字体需提供本应用可读的绝对路径；字符码限 Unicode BMP。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = ""
		$结束 $定义
		$定义 预览 $为 simple.library.wsd.iconics.字体图标图片框
			宽度 = 长度_匹配父级
			高度 = "70dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 资产 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "注册并使用资产字体"
				$结束 $定义
				$定义 资源 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "使用资源字体与字符码"
				$结束 $定义
				$定义 文件 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "从上方路径加载文件字体"
				$结束 $定义
				$定义 文字图 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "绘制字体中的短文字"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
