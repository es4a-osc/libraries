别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 心形 为 图标图像
变量 普通 为 图标图像

事件 附图窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 28
	样式.高度 = 28
	样式.颜色 = -65536
	心形 = 图标工具.创建图标("xui_collect", 样式)
	样式.颜色 = -16776961
	普通 = 图标工具.创建图标("xui_add", 样式)
	选择.设置文字("四侧独立状态图标")
	选择.设置字号(16.0)
	选择.设置图文间距(5)
结束 事件

事件 四侧.被单击()
	选择.设置四侧选中图标(心形, 普通)
	选择.设置选中(真)
	变量 图 为 图标图像
	图 = 选择.取位置选中图标(图标常量.位置_下)
	反馈.文本 = "四侧选中图标：" & 图.取图标名称() & "；图文间距：" & 选择.取图文间距()
结束 事件

事件 方向.被单击()
	选择.设置布局方向(1)
	选择.设置位置选中图标(图标常量.位置_起始, 心形, 普通)
	选择.设置附图(普通, 图标常量.位置_上)
	选择.设置选中(真)
	变量 图 为 图标图像
	图 = 选择.取位置选中图标(图标常量.位置_起始)
	反馈.文本 = "布局方向：" & 选择.取布局方向() & "（1 为 RTL）\n起始侧选中图标：" & 图.取图标名称()
结束 事件

事件 切换状态.被单击()
	选择.切换选中()
	反馈.文本 = "当前选中：" & 选择.是否选中()
结束 事件

事件 清除.被单击()
	选择.清除附图(图标常量.位置_起始)
	反馈.文本 = "已清除起始侧的常态图标，选中态保留。"
结束 事件

事件 清除全部.被单击()
	选择.设置四侧选中图标(空, 空)
	选择.设置布局方向(0)
	反馈.文本 = "已清除四侧两种状态图标，并恢复从左到右。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 附图窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 附图窗口 $为 窗口
		标题 = "6. 四侧附图与 RTL"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "6. 四侧附图与 RTL"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "常态和选中图标分别设置；起始、结束位置跟随布局方向。"
		$结束 $定义
		$定义 选择 $为 simple.library.wsd.iconics.字体图标可选文本框
			宽度 = 长度_匹配父级
			高度 = "130dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 四侧 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "设置四侧两种状态图标"
				$结束 $定义
				$定义 方向 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "切换 RTL 并设置起始侧"
				$结束 $定义
				$定义 切换状态 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "切换选中状态"
				$结束 $定义
				$定义 清除 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "只清除起始侧常态图标"
				$结束 $定义
				$定义 清除全部 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "清除四侧图标与恢复方向"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
