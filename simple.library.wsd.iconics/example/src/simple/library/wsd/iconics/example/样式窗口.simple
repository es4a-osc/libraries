别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 图像 为 图标图像

事件 样式窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 48
	样式.高度 = 48
	样式.颜色 = -15108398
	图像 = 图标工具.创建图标("xui_collect", 样式)
	预览.设置图标(图像)
结束 事件

事件 描边.被单击()
	变量 外观 为 图标样式
	外观 = 样式.复制()
	外观.内边距 = 6
	外观.描边宽度 = 1
	外观.描边颜色 = -65536
	外观.背景颜色 = -1390653
	外观.圆角横半径 = 10.0
	外观.圆角纵半径 = 10.0
	图像 = 图标工具.创建图标("xui_collect", 外观)
	预览.设置图标(图像)
	反馈.文本 = "圆角背景、内边距和描边已应用。"
结束 事件

事件 状态色.被单击()
	变量 颜色 为 图标状态颜色
	变量 状态 为 整数型(1)
	状态(0) = 图标常量.状态_选中
	颜色 = 创建 图标状态颜色
	颜色.置默认颜色(-16776961)
	颜色.添加(状态, -65536)
	图像 = 图标工具.创建图标("xui_collect", 样式)
	图像.设置状态着色(颜色)
	图像.设置状态(状态)
	预览.设置图标(图像)
	反馈.文本 = "图像选中态颜色：" & 颜色.取状态颜色(状态) & "\n默认颜色：" & 颜色.取默认颜色()
结束 事件

事件 灰度.被单击()
	变量 矩阵 为 单精度小数型(20)
	矩阵(0) = 0.33
	矩阵(1) = 0.33
	矩阵(2) = 0.33
	矩阵(5) = 0.33
	矩阵(6) = 0.33
	矩阵(7) = 0.33
	矩阵(10) = 0.33
	矩阵(11) = 0.33
	矩阵(12) = 0.33
	矩阵(18) = 1.0
	图像.设置颜色矩阵(矩阵)
	预览.设置图标(图像)
	反馈.文本 = "灰度滤镜：" & 图像.是否有滤镜()
结束 事件

事件 重置.被单击()
	图像.清除着色()
	图像.清除滤镜()
	图像.应用样式(样式)
	预览.设置图标(图像)
	反馈.文本 = "恢复基础样式；滤镜：" & 图像.是否有滤镜()
结束 事件

事件 输出.被单击()
	图像.保存PNG("font-icon.png")
	变量 字节 为 字节型()
	变量 快照 为 图标样式
	字节 = 图像.取PNG()
	快照 = 图像.取得样式()
	反馈.文本 = "已保存应用内部 font-icon.png\nPNG 字节：" & 取数组成员数(字节) & "\n尺寸：" & 图像.取像素宽度() & " × " & 图像.取像素高度() & " px\n样式宽度：" & 快照.宽度 & " DIP"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 样式窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 样式窗口 $为 窗口
		标题 = "3. 样式与 PNG"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "3. 样式与 PNG"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "每次从基础样式创建新图标。样式和图像均为快照，修改后重新应用到视图。"
		$结束 $定义
		$定义 预览 $为 simple.library.wsd.iconics.字体图标图片框
			宽度 = 长度_匹配父级
			高度 = "70dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 描边 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "圆角背景与描边"
				$结束 $定义
				$定义 状态色 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "使用选中状态色"
				$结束 $定义
				$定义 灰度 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "应用灰度矩阵"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "清除着色并恢复基础样式"
				$结束 $定义
				$定义 输出 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "读取样式并保存 PNG"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
