变量 页面0 为 字体窗口
变量 页面1 为 自定义字体窗口
变量 页面2 为 样式窗口
变量 页面3 为 文字窗口
变量 页面4 为 控件窗口
变量 页面5 为 附图窗口
变量 页面6 为 动画窗口
变量 页面7 为 单项动画窗口

事件 入口0.被单击()
	如果 页面0 = 空 则
		页面0 = 创建 字体窗口
		页面0.来源 = 主窗口
	结束 如果
	切换窗口(页面0)
结束 事件

事件 入口1.被单击()
	如果 页面1 = 空 则
		页面1 = 创建 自定义字体窗口
		页面1.来源 = 主窗口
	结束 如果
	切换窗口(页面1)
结束 事件

事件 入口2.被单击()
	如果 页面2 = 空 则
		页面2 = 创建 样式窗口
		页面2.来源 = 主窗口
	结束 如果
	切换窗口(页面2)
结束 事件

事件 入口3.被单击()
	如果 页面3 = 空 则
		页面3 = 创建 文字窗口
		页面3.来源 = 主窗口
	结束 如果
	切换窗口(页面3)
结束 事件

事件 入口4.被单击()
	如果 页面4 = 空 则
		页面4 = 创建 控件窗口
		页面4.来源 = 主窗口
	结束 如果
	切换窗口(页面4)
结束 事件

事件 入口5.被单击()
	如果 页面5 = 空 则
		页面5 = 创建 附图窗口
		页面5.来源 = 主窗口
	结束 如果
	切换窗口(页面5)
结束 事件

事件 入口6.被单击()
	如果 页面6 = 空 则
		页面6 = 创建 动画窗口
		页面6.来源 = 主窗口
	结束 如果
	切换窗口(页面6)
结束 事件

事件 入口7.被单击()
	如果 页面7 = 空 则
		页面7 = 创建 单项动画窗口
		页面7.来源 = 主窗口
	结束 如果
	切换窗口(页面7)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "字体图标示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = -1
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "字体图标示例"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "先认识字体和图标，再体验样式、控件与动画。每页对应一份源码，每个按钮直接调用 API。"
		$结束 $定义
		$定义 入口0 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "1. 字体查询"
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "2. 自定义字体"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "3. 样式与 PNG"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "4. 文字混排"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "5. 图标控件"
		$结束 $定义
		$定义 入口5 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "6. 四侧附图与 RTL"
		$结束 $定义
		$定义 入口6 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "7. 组合动画"
		$结束 $定义
		$定义 入口7 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "8. 单项动画"
		$结束 $定义
		$定义 条件 $为 标签
			宽度 = 长度_匹配父级
			高度 = "65dp"
			文本 = "需要 Android 7.0 及以上。示例不申请网络或存储权限，PNG 保存在应用内部目录。"
		$结束 $定义
	$结束 $定义
$结束 $属性
