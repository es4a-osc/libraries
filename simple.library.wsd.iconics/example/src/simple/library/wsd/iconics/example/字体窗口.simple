别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 图像 为 图标图像

事件 字体窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 48
	样式.高度 = 48
	样式.颜色 = -15108398
	图像 = 图标工具.创建图标("xui_collect", 样式)
	预览.设置图标(图像)
结束 事件

变量 前缀 为 文本型()
变量 字体序号 为 整数型
变量 字体 为 图标字体

事件 查询.被单击()
	字体 = 图标工具.取字体("xui")
	变量 名称 为 文本型()
	名称 = 图标工具.搜索图标(字体.取前缀(), 输入.文本)
	如果 取数组成员数(名称) = 0 则
		反馈.文本 = "没有找到图标，请换个关键词。"
		退出 事件
	结束 如果
	图像 = 图标工具.创建图标(名称(0), 样式)
	预览.设置图标(图像)
	反馈.文本 = "匹配数量：" & 取数组成员数(名称) & "\n首个图标：" & 名称(0) & "\n字符码：" & 字体.取字符码(名称(0))
结束 事件

事件 下种字体.被单击()
	前缀 = 图标工具.取字体前缀()
	字体序号 = 字体序号 + 1
	如果 字体序号 >= 取数组成员数(前缀) 则
		字体序号 = 0
	结束 如果
	字体 = 图标工具.取字体(前缀(字体序号))
	变量 名称 为 文本型()
	名称 = 字体.取图标名称()
	图像 = 图标工具.创建图标(名称(0), 样式)
	预览.设置图标(图像)
	反馈.文本 = 字体.取名称() & " (" & 字体.取前缀() & ")\n版本：" & 字体.取版本() & "\n图标数：" & 字体.取图标数量() & "\n首个：" & 名称(0)
结束 事件

事件 信息.被单击()
	字体 = 图标工具.取字体("xui")
	反馈.文本 = "字体：" & 字体.取名称() & "\n作者：" & 字体.取作者() & "\n字体资源：" & 字体.取字体资源() & "\nchat 存在：" & 图标工具.图标存在("xui_chat") & "\n无此图标：" & 图标工具.图标存在("xui_not_exists")
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 字体窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 字体窗口 $为 窗口
		标题 = "1. 字体查询"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "1. 字体查询"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "按名称关键词搜索当前字体；切换字体后可读取它的名称、数量和图标。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "chat"
		$结束 $定义
		$定义 预览 $为 simple.library.wsd.iconics.字体图标图片框
			宽度 = 长度_匹配父级
			高度 = "70dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 查询 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "搜索 XUI 图标"
				$结束 $定义
				$定义 下种字体 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "查看下一种字体"
				$结束 $定义
				$定义 信息 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "读取字体信息与存在状态"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
