别名 图标工具 = simple.library.wsd.iconics.图标工具
别名 图标样式 = simple.library.wsd.iconics.图标样式
别名 图标图像 = simple.library.wsd.iconics.图标图像
别名 图标字体 = simple.library.wsd.iconics.图标字体
别名 图标动画配置 = simple.library.wsd.iconics.图标动画配置
别名 图标状态颜色 = simple.library.wsd.iconics.图标状态颜色
别名 图标文字 = simple.library.wsd.iconics.图标文字
别名 图标文字样式 = simple.library.wsd.iconics.图标文字样式
别名 图标错误 = simple.library.wsd.iconics.图标错误
别名 图标常量 = simple.library.wsd.iconics.图标常量

变量 来源 为 主窗口
变量 样式 为 图标样式
变量 图像 为 图标图像

事件 单项动画窗口.初始化()
	样式 = 创建 图标样式
	样式.宽度 = 48
	样式.高度 = 48
	样式.颜色 = -15108398
	图像 = 图标工具.创建图标("xui_collect", 样式)
	预览.设置图标(图像)
结束 事件

变量 旋转号 为 整数型
变量 透明号 为 整数型

事件 启动.被单击()
	动画.绑定(预览, 图像, 图标常量.位置_图片)
	变量 配置 为 图标动画配置
	配置 = 创建 图标动画配置
	配置.时长 = 1800
	旋转号 = 动画.添加(配置)
	配置.类型 = 1
	配置.起值 = 80.0
	配置.止值 = 255.0
	配置.往返 = 真
	透明号 = 动画.添加(配置)
	配置.类型 = 2
	配置.起值 = 0.7
	配置.止值 = 1.0
	动画.添加(配置)
	动画.开始()
	反馈.文本 = "组合已启动；动画数量：" & 动画.取动画数量()
结束 事件

事件 单停.被单击()
	动画.暂停单项(旋转号)
	动画.设置单项进度(旋转号, 0.5)
	反馈.文本 = "旋转已暂停：" & 动画.单项已暂停(旋转号) & "\n当前角度：" & 动画.取单项当前值(旋转号) & "\n透明仍运行：" & 动画.单项正在运行(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 单续.被单击()
	动画.继续单项(旋转号)
	反馈.文本 = "旋转正在运行：" & 动画.单项正在运行(旋转号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 单反.被单击()
	动画.反向单项(旋转号)
	反馈.文本 = "已反向播放旋转。"
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 定位.被单击()
	动画.暂停单项(透明号)
	动画.设置单项播放时间(透明号, 900)
	反馈.文本 = "透明播放时间：" & 动画.取单项播放时间(透明号) & "\n当前值：" & 动画.取单项当前值(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 单结束.被单击()
	动画.结束单项(透明号)
	反馈.文本 = "透明已开始：" & 动画.单项已开始(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 单开始.被单击()
	动画.开始单项(透明号)
	反馈.文本 = "透明已开始：" & 动画.单项已开始(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 单取消.被单击()
	动画.取消单项(透明号)
	反馈.文本 = "透明已开始：" & 动画.单项已开始(透明号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 移除.被单击()
	动画.移除(旋转号)
	反馈.文本 = "剩余动画：" & 动画.取动画数量() & "\n透明编号保留：" & 透明号
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 配置.被单击()
	变量 配置 为 图标动画配置
	变量 编号 为 整数型()
	配置 = 动画.取得单项配置(透明号)
	编号 = 动画.取动画编号()
	反馈.文本 = "透明时长：" & 配置.时长 & "\n现有动画编号数量：" & 取数组成员数(编号)
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 导出.被单击()
	变量 帧 为 字节型()
	帧 = 动画.取当前帧PNG()
	反馈.文本 = "当前帧 PNG：" & 取数组成员数(帧) & " 字节"
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 解绑.被单击()
	动画.解除绑定()
	反馈.文本 = "绑定有效：" & 动画.是否已绑定() & "\n剩余动画：" & 动画.取动画数量()
	位于 错误
		分支 图标错误
			反馈.文本 = "请先创建组合；已移除的编号需重新添加。"
	结束 错误
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 单项动画窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 单项动画窗口 $为 窗口
		标题 = "8. 单项动画"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "38dp"
			文本 = "8. 单项动画"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = "先创建组合，再分别控制旋转和透明动画。编号由添加返回，不以数组位置代替。"
		$结束 $定义
		$定义 预览 $为 simple.library.wsd.iconics.字体图标图片框
			宽度 = 长度_匹配父级
			高度 = "70dp"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 启动 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "创建并启动组合"
				$结束 $定义
				$定义 单停 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "暂停旋转并定位到一半"
				$结束 $定义
				$定义 单续 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "继续旋转"
				$结束 $定义
				$定义 单反 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "反向播放旋转"
				$结束 $定义
				$定义 定位 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "暂停透明并设置播放时间"
				$结束 $定义
				$定义 单结束 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "结束透明动画"
				$结束 $定义
				$定义 单开始 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "启动透明动画"
				$结束 $定义
				$定义 单取消 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "取消透明动画"
				$结束 $定义
				$定义 移除 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "移除旋转动画"
				$结束 $定义
				$定义 配置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "读取配置与编号快照"
				$结束 $定义
				$定义 导出 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "导出当前帧 PNG 字节"
				$结束 $定义
				$定义 解绑 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "42dp"
					文本 = "清空并解除绑定"
				$结束 $定义
				$定义 反馈 $为 标签
					宽度 = 长度_匹配父级
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 动画 $为 simple.library.wsd.iconics.图标动画
		$结束 $定义
	$结束 $定义
$结束 $属性
