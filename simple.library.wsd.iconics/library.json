				{
					"name": "图标动画",
					"kind": "component",
					"type": "simple.library.wsd.iconics.图标动画",
					"description": "绑定图标动画到图片、背景或文字附图；离开窗口和后台自动暂停。",
					"properties": [],
					"functions": [
						{
							"name": "绑定",
							"description": "绑定目标；-2背景，-1图片，0左1上2右3下4起始5结束；更换目标清空原动画。",
							"params": [
								{
									"name": "目标",
									"type": "simple.runtime.components.可视组件",
									"description": "目标。"
								},
								{
									"name": "图像",
									"type": "simple.library.wsd.iconics.图标图像",
									"description": "图像。"
								},
								{
									"name": "位置",
									"type": "整数型",
									"description": "位置。"
								}
							]
						},
						{
							"name": "添加",
							"description": "复制配置并返回稳定编号；移除其他项不改变编号，清空后不复用旧编号。",
							"params": [
								{
									"name": "配置",
									"type": "simple.library.wsd.iconics.图标动画配置",
									"description": "配置。"
								}
							],
							"return": "整数型"
						},
						{
							"name": "开始",
							"description": "开始全部动画。",
							"params": []
						},
						{
							"name": "暂停",
							"description": "暂停全部动画。",
							"params": []
						},
						{
							"name": "继续",
							"description": "继续已暂停动画。",
							"params": []
						},
						{
							"name": "取消",
							"description": "取消全部动画并保留当前位置。",
							"params": []
						},
						{
							"name": "结束",
							"description": "立即到达动画终点。",
							"params": []
						},
						{
							"name": "反向",
							"description": "反向播放全部动画。",
							"params": []
						},
						{
							"name": "清空",
							"description": "取消并移除全部配置。",
							"params": []
						},
						{
							"name": "正在运行",
							"description": "是否至少一个动画正在运行。",
							"params": [],
							"return": "逻辑型"
						},
						{
							"name": "开始单项",
							"description": "从头启动指定动画。",
							"params": [
								{
									"name": "编号",
									"type": "整数型",
									"description": "编号。"
								}
							]
						},
						{
							"name": "暂停单项",
							"description": "手动暂停指定动画，返回前台不会自动恢复。",
							"params": [
								{
									"name": "编号",
									"type": "整数型",
									"description": "编号。"
								}
