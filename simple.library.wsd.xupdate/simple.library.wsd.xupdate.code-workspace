{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/.gradle": true,
			"**/build": true
		},
		"files.associations": {
			"library.gradle": "groovy"
		},
		"java.server.launchMode": "Standard",
		"java.configuration.runtimes": [
			{
				"path": "${workspaceFolder}/../../sdk/tools/jdk-11.0.32.1",
				"name": "JavaSE-11",
				"default": true
			}
		],
		"java.import.gradle.enabled": false,
		"java.import.maven.enabled": false,
		"java.import.exclusions": [
			"**/build/**",
			"**/.gradle/**",
			"**/test/**"
		],
		"java.project.sourcePaths": [
			"src"
		],
		"java.project.outputPath": "build/ide/classes",
		"java.project.referencedLibraries": {
			"include": [
				"../../sdk/tools/android-sdk/platforms/android-30/android.jar",
				"../../sdk/tools/android-sdk/build-tools/36.1.0/core-lambda-stubs.jar",
				"../../sdk/simple/SimpleAndroidRuntime.jar",
				"libs/*.jar",
				"build/ide/libs/**/*.jar"
			],
			"exclude": [
				"libs/*-sources.jar",
				"build/ide/libs/**/*-sources.jar"
			],
			"sources": {
				"../../sdk/tools/android-sdk/platforms/android-30/android.jar": "../../sdk/tools/android-sdk/platforms/android-30/android-stubs-src.jar"
			}
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "ES4A扩展库: 刷新依赖",
				"type": "process",
				"command": "powershell.exe",
				"args": [
					"-NoLogo",
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"../../sdk/utils/library/library.ps1",
					"prepare",
					"${workspaceFolder}"
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"problemMatcher": []
			},
			{
				"label": "ES4A扩展库: 编译扩展库",
				"type": "process",
				"command": "powershell.exe",
				"args": [
					"-NoLogo",
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"../../sdk/utils/library/library.ps1",
					"compile",
					"${workspaceFolder}"
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"problemMatcher": []
			},
			{
				"label": "ES4A扩展库: 发布到SDK",
				"type": "process",
				"command": "powershell.exe",
				"args": [
					"-NoLogo",
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"../../sdk/utils/library/library.ps1",
					"publish",
					"${workspaceFolder}"
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"problemMatcher": []
			}
		]
	}
}
