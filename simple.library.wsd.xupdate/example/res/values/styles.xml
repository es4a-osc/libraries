<resources>
	<style name="XUpdateExampleTheme" parent="android:style/Theme.Material.Light.NoActionBar">
		<item name="android:fontFamily">sans</item>
		<item name="android:colorAccent">#165DFF</item>
		<item name="android:statusBarColor">#165DFF</item>
		<item name="android:navigationBarColor">#FFFFFF</item>
		<item name="android:windowLightNavigationBar">true</item>
		<item name="android:buttonStyle">@style/XUpdateExampleButton</item>
	</style>
	<style name="XUpdateExampleButton" parent="android:style/Widget.Material.Button">
		<item name="android:background">@drawable/example_button</item>
		<item name="android:textColor">#FFFFFF</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:paddingLeft">16dp</item>
		<item name="android:paddingRight">16dp</item>
		<item name="android:minHeight">48dp</item>
	</style>
</resources>
