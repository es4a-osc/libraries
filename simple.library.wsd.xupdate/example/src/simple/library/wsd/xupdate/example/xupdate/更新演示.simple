别名 更新信息 = simple.library.wsd.xupdate.更新信息

事件 返回.被单击()
	切换窗口(创建 simple.library.wsd.xupdate.example.主窗口)
结束 事件


过程 准备()
	更新.取消()
	更新.自动提示 = 真
	更新.自动下载 = 假
	更新.下载后安装 = 真
结束 过程

事件 普通.被单击()
	准备()
	更新.检查更新(地址.文本 & "/normal")
结束 事件

事件 强制.被单击()
	准备()
	更新.检查更新(地址.文本 & "/forced")
结束 事件

事件 忽略.被单击()
	准备()
	更新.检查更新(地址.文本 & "/ignore")
结束 事件

事件 重置忽略.被单击()
	更新.清除忽略版本()
	反馈.文本 = "已清除忽略记录，可以重新检查同一个版本。"
结束 事件

事件 自动.被单击()
	准备()
	更新.自动下载 = 真
	更新.下载后安装 = 假
	更新.检查更新(地址.文本 & "/normal")
结束 事件

事件 无更新.被单击()
	准备()
	更新.检查更新(地址.文本 & "/none")
结束 事件

事件 更新.检查开始()
	反馈.文本 = "正在查询版本信息……"
结束 事件

事件 更新.发现更新(信息 为 更新信息)
	反馈.文本 = "发现版本：" & 信息.版本名
结束 事件

事件 更新.无需更新()
	反馈.文本 = "当前无需更新，或此版本已经被忽略。"
结束 事件

事件 更新.下载进度(已下载 为 长整数型, 总大小 为 长整数型, 百分比 为 整数型)
	反馈.文本 = "正在下载：" & 百分比 & "%"
结束 事件

事件 更新.下载完成(文件 为 文本型)
	反馈.文本 = "下载已校验完成；本次自动下载没有请求安装。"
结束 事件

事件 更新.失败(阶段 为 整数型, 说明 为 文本型)
	反馈.文本 = "操作未完成：" & 说明
结束 事件

$属性
	$资源 $窗口
	$定义 更新演示 $为 窗口
		标题 = "版本更新"
		背景颜色 = -1
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 更新 $为 simple.library.wsd.xupdate.更新器
		$结束 $定义
