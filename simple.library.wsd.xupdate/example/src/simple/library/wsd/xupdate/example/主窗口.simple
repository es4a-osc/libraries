''' 先选择主题，再阅读对应按钮。网络操作请提供自己的版本接口和 APK。

变量 页面1 为 simple.library.wsd.xupdate.example.xupdate.更新演示
变量 已创建1 为 逻辑型
变量 页面2 为 simple.library.wsd.xupdate.example.xupdate.提示演示
变量 已创建2 为 逻辑型
变量 页面3 为 simple.library.wsd.xupdate.example.xupdate.流程定制
变量 已创建3 为 逻辑型
变量 页面4 为 simple.library.wsd.xupdate.example.xupdate.下载安装
变量 已创建4 为 逻辑型
变量 页面5 为 simple.library.wsd.xupdate.example.xupdateapi.快捷更新
变量 已创建5 为 逻辑型
变量 页面6 为 simple.library.wsd.xupdate.example.xupdateapi.断点续传
变量 已创建6 为 逻辑型

事件 版本检查.被单击()
	如果 取反 已创建1 则
		页面1 = 创建 simple.library.wsd.xupdate.example.xupdate.更新演示
		页面1.来源 = 主窗口
		已创建1 = 真
	结束 如果
	切换窗口(页面1)
结束 事件

事件 提示样式.被单击()
	如果 取反 已创建2 则
		页面2 = 创建 simple.library.wsd.xupdate.example.xupdate.提示演示
		页面2.来源 = 主窗口
		已创建2 = 真
	结束 如果
	切换窗口(页面2)
结束 事件

事件 流程定制.被单击()
	如果 取反 已创建3 则
		页面3 = 创建 simple.library.wsd.xupdate.example.xupdate.流程定制
		页面3.来源 = 主窗口
		已创建3 = 真
	结束 如果
	切换窗口(页面3)
结束 事件

事件 下载安装.被单击()
	如果 取反 已创建4 则
		页面4 = 创建 simple.library.wsd.xupdate.example.xupdate.下载安装
		页面4.来源 = 主窗口
		已创建4 = 真
	结束 如果
	切换窗口(页面4)
结束 事件

事件 快捷更新.被单击()
	如果 取反 已创建5 则
		页面5 = 创建 simple.library.wsd.xupdate.example.xupdateapi.快捷更新
		页面5.来源 = 主窗口
		已创建5 = 真
	结束 如果
	切换窗口(页面5)
结束 事件

事件 暂停续传.被单击()
	如果 取反 已创建6 则
		页面6 = 创建 simple.library.wsd.xupdate.example.xupdateapi.断点续传
		页面6.来源 = 主窗口
		已创建6 = 真
	结束 如果
	切换窗口(页面6)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XU更新示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = -1
		左填充 = "18dp"
		右填充 = "18dp"
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "XU更新示例"
			字体大小 = 20
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "64dp"
			文本 = "选择一个主题。网络演示需提供版本 JSON 和真实 APK；系统安装仍由用户确认。"
		$结束 $定义
		$定义 版本检查 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "01  版本检查与更新方式"
		$结束 $定义
		$定义 版本检查说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "普通、强制、忽略和自动下载；填写服务根地址后选择具体操作。"
		$结束 $定义
		$定义 提示样式 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "02  提示与主题"
		$结束 $定义
		$定义 提示样式说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "不发起网络请求，使用真实 APK 地址预览原生提示及主题。"
		$结束 $定义
		$定义 流程定制 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "03  检查、解析与提示策略"
		$结束 $定义
		$定义 流程定制说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "三个小对象分别实现接口；页面直接展示业务更新信息。"
		$结束 $定义
		$定义 下载安装 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "04  下载、校验与安装"
		$结束 $定义
		$定义 下载安装说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "下载文件、显示进度、转入后台、清理缓存并请求系统安装。"
		$结束 $定义
		$定义 快捷更新 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "05  快捷更新"
		$结束 $定义
		$定义 快捷更新说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "最简接入：填写完整版本 JSON 地址，调用检查更新。"
		$结束 $定义
		$定义 暂停续传 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "06  暂停与继续下载"
		$结束 $定义
		$定义 暂停续传说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "提供真实 APK 地址及 MD5，通过 Aria 暂停、继续和取消。"
		$结束 $定义
	$结束 $定义
$结束 $属性
