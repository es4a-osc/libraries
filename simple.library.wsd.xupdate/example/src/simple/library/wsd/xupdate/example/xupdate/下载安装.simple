别名 更新信息 = simple.library.wsd.xupdate.更新信息

事件 返回.被单击()
	切换窗口(创建 simple.library.wsd.xupdate.example.主窗口)
结束 事件

变量 信息 为 更新信息
变量 文件 为 文本型

事件 读取.被单击()
	更新.取消()
	更新.自动提示 = 假
	更新.下载后安装 = 假
	更新.检查更新(地址.文本 & "/normal")
结束 事件

事件 更新.发现更新(结果 为 更新信息)
	信息 = 结果
	下载地址.文本 = 信息.下载地址
	摘要.文本 = 信息.MD5
	反馈.文本 = "已取得地址和真实文件摘要，可以开始下载。"
结束 事件

事件 开始.被单击()
	更新.取消()
	信息 = 创建 更新信息
	信息.下载地址 = 下载地址.文本
	信息.MD5 = 摘要.文本
	更新.下载后安装 = 假
	更新.下载更新(信息)
结束 事件

事件 后台.被单击()
	如果 更新.状态 = 更新.状态_下载 则
		更新.转入后台()
		反馈.文本 = "已转入后台。可以返回首页，在通知栏查看任务；完成后点击通知安装。"
	结束 如果
结束 事件

事件 取消下载.被单击()
	更新.取消()
	反馈.文本 = "任务已取消，未完成文件已移除。"
结束 事件

事件 清理.被单击()
	更新.取消()
	更新.清理缓存()
	文件 = ""
	反馈.文本 = "本实例的下载缓存已清理。"
结束 事件

事件 安装.被单击()
	如果 文件 <> "" 则
		更新.安装更新(文件)
	否则
		反馈.文本 = "请先完成一次下载；也可以在源码中传入已有的本地 APK 路径。"
	结束 如果
结束 事件

事件 更新.下载进度(已下载 为 长整数型, 总大小 为 长整数型, 百分比 为 整数型)
	进度.文本 = "下载进度：" & 百分比 & "%"
	反馈.文本 = "已接收 " & 已下载 & " 字节，共 " & 总大小 & " 字节。"
结束 事件

事件 更新.下载完成(路径 为 文本型)
	文件 = 路径
	进度.文本 = "下载与校验完成"
	反馈.文本 = "文件可用于后续处理，点击安装才会请求系统安装。"
结束 事件

事件 更新.安装授权(路径 为 文本型)
	反馈.文本 = "请在系统设置中允许此来源安装；返回后继续请求。"
结束 事件

事件 更新.已请求安装(路径 为 文本型)
	反馈.文本 = "系统安装请求已经发出，请在系统界面确认。"
结束 事件

事件 更新.失败(阶段 为 整数型, 说明 为 文本型)
	反馈.文本 = "操作未完成：" & 说明
结束 事件

$属性
	$资源 $窗口
	$定义 下载安装 $为 窗口
		标题 = "下载与安装"
		背景颜色 = -1
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 更新 $为 simple.library.wsd.xupdate.更新器
		$结束 $定义
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "56dp"
			背景颜色 = -15311361
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				文本颜色 = -1
				文本 = "返回"
				宽度 = "72dp"
				高度 = "52dp"
