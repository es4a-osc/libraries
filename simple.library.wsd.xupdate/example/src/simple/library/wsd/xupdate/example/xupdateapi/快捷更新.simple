事件 检查按钮.被单击()
	更新.检查更新(版本地址.文本)
结束 事件

事件 更新.检查开始()
	反馈.文本 = "正在检查新版本……"
结束 事件

事件 更新.无需更新()
	反馈.文本 = "当前无需更新。"
结束 事件

事件 更新.失败(阶段 为 整数型, 说明 为 文本型)
	反馈.文本 = "更新未完成：" & 说明
结束 事件

事件 返回.被单击()
	切换窗口(创建 simple.library.wsd.xupdate.example.主窗口)
结束 事件

$属性
	$资源 $窗口
	$定义 快捷更新 $为 窗口
		标题 = "快捷更新"
		背景颜色 = -1
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 更新 $为 simple.library.wsd.xupdateapi.快捷更新器
		$结束 $定义
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = "56dp"
			背景颜色 = -15311361
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 返回 $为 按钮
				文本颜色 = -1
				文本 = "返回"
				宽度 = "72dp"
				高度 = "52dp"
				字体大小 = 14
			$结束 $定义
			$定义 标题 $为 标签
				文本 = "快捷更新"
				宽度 = 0
				权重 = 1
				高度 = "52dp"
				文本颜色 = -1
				字体大小 = 20
				内容对齐 = 对齐_居中
			$结束 $定义
			$定义 标题留白 $为 面板
				背景颜色 = 0
				宽度 = "72dp"
				高度 = "52dp"
			$结束 $定义
		$结束 $定义
		$定义 滚动区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				左填充 = "18dp"
				右填充 = "18dp"
				底填充 = "24dp"
				$定义 介绍 $为 标签
					文本 = "本页仅使用快捷更新器：填写地址并检查。无需配置全局初始化，也无需手动实现检查或下载接口。"
					宽度 = 长度_匹配父级
					字体大小 = 14
					字体加粗 = 假
					文本颜色 = -9471604
					顶边距 = "8dp"
					底边距 = "8dp"
				$结束 $定义
				$定义 基础标题 $为 标签
					文本 = "简单接入"
					宽度 = 长度_匹配父级
					字体大小 = 17
					字体加粗 = 真
					文本颜色 = -13815236
					顶边距 = "22dp"
					底边距 = "8dp"
				$结束 $定义
				$定义 版本地址 $为 编辑框
					文本 = "http://127.0.0.1:18767/normal"
					宽度 = 长度_匹配父级
					高度 = "52dp"
					字体大小 = 14
				$结束 $定义
				$定义 检查按钮 $为 按钮
					文本颜色 = -1
