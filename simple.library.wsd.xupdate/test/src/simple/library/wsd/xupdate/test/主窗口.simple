别名 更新信息 = simple.library.wsd.xupdate.更新信息

变量 模式 为 整数型
变量 进度次数 为 整数型
变量 发现次数 为 整数型
变量 文件 为 文本型

事件 主窗口.初始化()
	更新.自动提示 = 真
	反馈("选择用例；需启动本地测试服务并映射端口 18765。安装必须由用户确认。")
结束 事件

过程 准备(新模式 为 整数型)
	更新.取消()
	另一个.取消()
	延迟操作.启用 = 假
	模式 = 新模式
	进度次数 = 0
	发现次数 = 0
	更新.清空请求配置()
	更新.自动提示 = 真
	更新.自定义解析 = 假
	更新.下载后安装 = 假
	更新.使用POST = 假
	更新.POST使用JSON = 假
	更新.断点续传 = 假
	更新.仅WiFi = 假
	更新.请求超时 = 15000
	更新.置提示样式(-1, 0, "", 0, 0)
结束 过程

事件 普通检查.被单击()
	准备(0)
	更新.清除忽略版本()
	更新.检查更新(服务地址.文本 & "/normal")
结束 事件

事件 无需升级.被单击()
	准备(1)
	更新.检查更新(服务地址.文本 & "/none")
结束 事件

事件 强制升级.被单击()
	准备(2)
	更新.检查更新(服务地址.文本 & "/forced")
结束 事件

事件 忽略版本.被单击()
	准备(3)
	更新.检查更新(服务地址.文本 & "/ignore")
结束 事件

事件 自定义协议.被单击()
	准备(4)
	更新.自定义解析 = 真
	更新.检查更新(服务地址.文本 & "/custom")
结束 事件

事件 POST请求.被单击()
	准备(5)
	更新.使用POST = 真
	更新.置请求参数("城市", "杭州 + 上海")
	更新.置请求头("X-Update-Test", "isolated")
	更新.检查更新(服务地址.文本 & "/post")
结束 事件

事件 JSON请求.被单击()
	准备(22)
	更新.使用POST = 真
	更新.POST使用JSON = 真
	更新.置请求参数("城市", "杭州 + 上海")
	更新.检查更新(服务地址.文本 & "/json")
结束 事件

事件 续传下载.被单击()
	准备(23)
	更新.清理缓存()
	更新.断点续传 = 真
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/resume")
结束 事件

事件 暂停下载.被单击()
	更新.暂停下载()
结束 事件

事件 继续下载.被单击()
	更新.继续下载()
结束 事件

事件 清理下载.被单击()
	更新.清理缓存()
	文件 = ""
	反馈("本更新器缓存已清理。")
结束 事件

事件 更新.已暂停()
	断言真(更新.状态 = 更新.状态_暂停)
	反馈("已暂停：下载记录保留，点击继续下载恢复。")
结束 事件

事件 仅下载.被单击()
	准备(6)
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/normal")
结束 事件

事件 校验失败.被单击()
	准备(7)
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/badmd5")
结束 事件

事件 中途取消.被单击()
	准备(8)
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/slowdownload")
	延迟操作.间隔 = 600
	延迟操作.启用 = 真
结束 事件

事件 响应取消.被单击()
	准备(9)
	更新.检查更新(服务地址.文本 & "/slowcheck")
	延迟操作.间隔 = 600
	延迟操作.启用 = 真
结束 事件

事件 失败恢复.被单击()
	准备(10)
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/error")
结束 事件

事件 安装验证.被单击()
	准备(11)
	更新.自动提示 = 假
	更新.下载后安装 = 真
	更新.检查更新(服务地址.文本 & "/normal")
结束 事件

事件 并发隔离.被单击()
	准备(12)
	更新.自动提示 = 假
	另一个.自动提示 = 假
	另一个.检查更新(服务地址.文本 & "/none")
	更新.检查更新(服务地址.文本 & "/normal")
结束 事件

事件 离开窗口.被单击()
	准备(13)
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/slowcheck")
	延迟操作.间隔 = 600
	延迟操作.启用 = 真
结束 事件

事件 损坏响应.被单击()
	准备(14)
	更新.检查更新(服务地址.文本 & "/malformed")
结束 事件

事件 大小失败.被单击()
	准备(15)
	更新.自动提示 = 假
	更新.检查更新(服务地址.文本 & "/badsize")
结束 事件

事件 只限无线.被单击()
	准备(16)
	更新.仅WiFi = 真
	更新.检查更新(服务地址.文本 & "/none")
结束 事件


事件 定制提示.被单击()
	准备(20)
	更新.置提示样式(-16738680, -1, "@drawable/xupdate_test_top", 0.9, 0.75)
	更新.检查更新(服务地址.文本 & "/normal")
结束 事件

事件 手工提示.被单击()
	准备(21)
	变量 信息 为 更新信息
	信息 = 创建 更新信息
	断言真(信息.有更新 = 假)
	断言真(信息.文件大小 = 0)
	信息.有更新 = 真
	信息.版本号 = 99
	信息.版本名 = "手工版本"
	信息.更新内容 = "手工创建并传入的独立快照。"
	信息.下载地址 = 服务地址.文本 & "/apk"
	更新.显示更新(信息)
	信息.版本名 = "不应改变提示"
	反馈("应显示手工版本，提交后修改原对象不得改变已显示的提示。")
结束 事件

事件 直接解析.被单击()
	准备(17)
	更新.自动提示 = 假
	更新.自定义解析 = 真
	更新.解析更新("本地协议")
结束 事件

事件 重新安装.被单击()
	如果 文件 = "" 则
		反馈("请先完成下载。")
	否则
		更新.安装更新(文件)
	结束 如果
结束 事件

事件 主动取消.被单击()
	更新.取消()
结束 事件

事件 参数校验.被单击()
	准备(18)
	更新.请求超时 = 1
	反馈("失败：非法超时未拒绝。")
	位于 错误
		分支 否则
			反馈("通过：非法超时已拒绝。")
	结束 错误
结束 事件

事件 重复检查.被单击()
	准备(19)
	更新.检查更新(服务地址.文本 & "/slowcheck")
	更新.检查更新(服务地址.文本 & "/normal")
	反馈("失败：重复任务未拒绝。")
	位于 错误
		分支 否则
			更新.取消()
			反馈("通过：重复任务拒绝且可取消。")
	结束 错误
结束 事件

事件 延迟操作.计时()
	延迟操作.启用 = 假
	如果 模式 = 13 则
		切换窗口(创建 离开验证)
	否则
		更新.取消()
		断言真(更新.状态 = 更新.状态_空闲)
		反馈("通过：已取消；等待 4 秒不应出现旧的发现更新或下载完成事件。")
	结束 如果
结束 事件

事件 更新.检查开始()
	反馈("检查开始：用例 " & 模式)
结束 事件

事件 更新.解析响应(响应 为 文本型, 信息 为 更新信息)
	断言真(响应 = "custom" 或 响应 = "本地协议")
	信息.有更新 = 真
	信息.版本号 = 99
	信息.版本名 = "自定义版本"
	信息.更新内容 = "由 Simple 解析事件提供的信息。"
	信息.下载地址 = 服务地址.文本 & "/apk"
结束 事件

事件 更新.发现更新(信息 为 更新信息)
	发现次数 = 发现次数 + 1
	断言真(信息.有更新)
	断言真(信息.版本号 > 1)
	如果 模式 = 5 则
		断言真(信息.版本名 = "POST已验证")
	结束 如果
	如果 模式 = 22 则
		断言真(信息.版本名 = "JSON已验证")
	结束 如果
	反馈("发现更新：" & 信息.版本名 & "；大小=" & 信息.文件大小)
	如果 模式 = 6 或 模式 = 7 或 模式 = 8 或 模式 = 11 或 模式 = 15 或 模式 = 23 则
		更新.下载更新(信息)
	结束 如果
结束 事件

事件 更新.无需更新()
	断言真(模式 = 1 或 模式 = 3 或 模式 = 16)
	反馈("通过：无需更新或此版本已被忽略。")
结束 事件

事件 更新.下载开始()
	反馈("下载开始。")
结束 事件

事件 更新.下载进度(已下载 为 长整数型, 总大小 为 长整数型, 百分比 为 整数型)
	进度次数 = 进度次数 + 1
	断言真(已下载 >= 0)
	断言真(百分比 >= -1 且 百分比 <= 100)
	反馈("下载进度：" & 百分比 & "%  " & 已下载 & "/" & 总大小)
结束 事件

事件 更新.下载完成(路径 为 文本型)
	断言真(模式 <> 7 且 模式 <> 8 且 模式 <> 15)
	断言真(进度次数 > 0)
	断言真(路径 = 更新.已下载文件)
	文件 = 路径
	反馈("通过：下载与校验完成；进度事件=" & 进度次数)
结束 事件

事件 更新.安装授权(路径 为 文本型)
	断言真(路径 = 更新.已下载文件)
	反馈("等待安装来源授权；拒绝应报告失败，允许后应打开系统安装器。")
结束 事件

事件 更新.已请求安装(路径 为 文本型)
	断言真(路径 = 更新.已下载文件)
	反馈("已打开系统安装器，尚未确认安装；完成后核对实际版本。")
结束 事件

事件 更新.已取消()
	输出信息("XUPDATE-TEST", "已取消；模式=" & 模式)
结束 事件

事件 更新.失败(阶段 为 整数型, 说明 为 文本型)
	反馈("失败反馈：阶段=" & 阶段 & "；" & 说明)
	如果 模式 = 7 或 模式 = 15 则
		断言真(阶段 = 更新.阶段_下载)
	结束 如果
	如果 模式 = 10 或 模式 = 14 则
		断言真(阶段 = 更新.阶段_检查)
	结束 如果
结束 事件

事件 另一个.无需更新()
	反馈("另一个实例：通过无更新；第一个实例应独立完成。")
结束 事件

事件 另一个.失败(阶段 为 整数型, 说明 为 文本型)
	反馈("另一个实例失败：" & 说明)
结束 事件

过程 反馈(文本 为 文本型)
	结果.文本 = 文本
	输出信息("XUPDATE-TEST", 文本)
结束 过程

事件 策略适配.被单击()
	核心更新.取消()
	核心更新.自动提示 = 假
	核心更新.下载后安装 = 假
	核心更新.置下载器(创建 simple.library.wsd.xupdateapi.Aria下载器)
	核心更新.检查更新(服务地址.文本 & "/resume")
结束 事件

事件 核心更新.发现更新(信息 为 simple.library.wsd.xupdate.更新信息)
	核心更新.下载更新(信息)
结束 事件

事件 核心更新.下载完成(路径 为 文本型)
	反馈("核心更新器通过 Aria 策略下载并校验完成：" & 路径)
结束 事件

事件 核心更新.失败(阶段 为 整数型, 说明 为 文本型)
	反馈("核心策略操作失败：" & 说明)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XUpdate功能测试"
		背景颜色 = -1
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 核心更新 $为 simple.library.wsd.xupdate.更新器
		$结束 $定义
		$定义 更新 $为 simple.library.wsd.xupdateapi.快捷更新器
		$结束 $定义
		$定义 另一个 $为 simple.library.wsd.xupdateapi.快捷更新器
		$结束 $定义
		$定义 延迟操作 $为 计时器
			启用 = 假
		$结束 $定义
		$定义 服务地址 $为 编辑框
			文本 = "http://127.0.0.1:18765"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 滚动区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "590dp"
			$定义 内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 策略适配 $为 按钮
					文本 = "核心更新器接入 Aria 策略"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 定制提示 $为 按钮
					文本 = "定制提示样式"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 手工提示 $为 按钮
					文本 = "手工版本与快照"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 JSON请求 $为 按钮
					文本 = "检查 JSON 请求"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 续传下载 $为 按钮
					文本 = "启动断点续传下载"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 暂停下载 $为 按钮
					文本 = "暂停下载"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 继续下载 $为 按钮
					文本 = "继续下载"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 清理下载 $为 按钮
					文本 = "清理本实例缓存"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 普通检查 $为 按钮
					文本 = "检查与默认提示"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 无需升级 $为 按钮
					文本 = "无新版本"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 强制升级 $为 按钮
					文本 = "强制更新提示"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 忽略版本 $为 按钮
					文本 = "忽略与再次检查"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 自定义协议 $为 按钮
					文本 = "自定义协议解析"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 POST请求 $为 按钮
					文本 = "POST 参数与请求头"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 仅下载 $为 按钮
					文本 = "下载、进度和校验"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 校验失败 $为 按钮
					文本 = "MD5 错误拒绝"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 中途取消 $为 按钮
					文本 = "取消慢速下载"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 响应取消 $为 按钮
					文本 = "取消检查与旧回调"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 失败恢复 $为 按钮
					文本 = "HTTP 失败与重试"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 安装验证 $为 按钮
					文本 = "下载后安装授权"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 并发隔离 $为 按钮
					文本 = "两实例并发检查"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 离开窗口 $为 按钮
					文本 = "离开窗口取消"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 损坏响应 $为 按钮
					文本 = "损坏 JSON"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 大小失败 $为 按钮
					文本 = "大小错误拒绝"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 只限无线 $为 按钮
					文本 = "仅 Wi-Fi 条件"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 直接解析 $为 按钮
					文本 = "直接解析响应"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 重新安装 $为 按钮
					文本 = "安装已校验文件"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 主动取消 $为 按钮
					文本 = "取消当前任务"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 参数校验 $为 按钮
					文本 = "非法参数拒绝"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 重复检查 $为 按钮
					文本 = "重复任务拒绝"
					宽度 = 长度_匹配父级
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "等待测试。"
			文本颜色 = -16752755
		$结束 $定义
	$结束 $定义
$结束 $属性
