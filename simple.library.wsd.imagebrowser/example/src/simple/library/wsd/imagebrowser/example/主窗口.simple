''' 参考 ImageBrowse / PhotoView 的浏览交互，使用当前封装的异步载入和事件接口。
''' https://github.com/brucetoo/ImageBrowse
''' 图片名可直接指向 assets；文档 URI 由系统选择器授予权限，不推测物理路径。
变量 本地图片 为 文本型()
变量 私有路径 为 文本型
变量 待执行 为 整数型
变量 成功次数 为 整数型
变量 失败次数 为 整数型
变量 翻页次数 为 整数型
变量 关闭次数 为 整数型
变量 日志行数 为 整数型

事件 主窗口.初始化()
	本地图片 = 分割文本("landscape.png,portrait.png,large.png", ",")
	更新状态()
结束 事件

事件 封面.被单击()
	浏览器.浏览图片("landscape.png")
结束 事件

事件 本地浏览.被单击()
	浏览器.浏览图片(本地图片, 0)
结束 事件

事件 第二张.被单击()
	浏览器.浏览图片(本地图片, 1)
结束 事件

事件 资源浏览.被单击()
	浏览器.浏览图片("@drawable/browser_sample")
结束 事件

''' 写入小型 PNG，再从文件操作返回值中取得真实绝对路径。
事件 私有浏览.被单击()
	创建目录("imagebrowser-example")
	如果 写出字节文件("imagebrowser-example/private.png", Base64解码("")) 则
		变量 文件列表 为 文本型()
		变量 索引 为 整数型
		文件列表 = 取文件列表("imagebrowser-example")
		私有路径 = ""
		循环 索引 = 0 至 取数组成员数(文件列表) - 1
			如果 取文本右边(文件列表(索引), 11) = "private.png" 则 私有路径 = 文件列表(索引)
		下个
		如果 私有路径 <> "" 则
			记录("私有文件：" & 私有路径)
			浏览器.浏览图片("file://" & 私有路径)
		结束 如果
	结束 如果
	位于 错误
		分支 否则
			记录("私有图片准备失败，请检查应用文件空间。")
	结束 错误
结束 事件

事件 系统选图.被单击()
	选图器.选择文件("image/*", 真)
结束 事件

事件 选图器.文件选择完毕(地址 为 文本型())
	如果 取数组成员数(地址) > 0 则
		记录("系统选图返回 " & 取数组成员数(地址) & " 项；首项=" & 地址(0))
		浏览器.浏览图片(地址, 0)
	结束 如果
结束 事件

事件 选图器.取消选择()
	记录("已取消系统选图，保留当前窗口。")
结束 事件

事件 选图器.选择失败(原因 为 文本型)
	记录("系统选图失败：" & 原因)
结束 事件

事件 网络浏览.被单击()
	如果 图片地址.文本 = "" 则
		记录("请先输入可访问的 HTTP/HTTPS 图片地址；手机上的 127.0.0.1 指向手机自身。")
	否则
		记录("请求图片：" & 图片地址.文本)
		浏览器.浏览图片(图片地址.文本)
	结束 如果
结束 事件

事件 坏图恢复.被单击()
	变量 列表 为 文本型()
	列表 = 分割文本("broken.png,landscape.png", ",")
	浏览器.浏览图片(列表, 0)
结束 事件

''' 用一次性计时展示浏览界面打开后调用控制方法；关闭浏览即取消待执行操作。
过程 定时演示(操作 为 整数型)
	待执行 = 操作
	浏览器.浏览图片(本地图片, 0)
	延时操作.启用 = 真
	记录("约 3 秒后执行所选操作；提前关闭浏览会取消。")
结束 过程

事件 定时翻页.被单击()
	定时演示(1)
结束 事件

事件 定时重读.被单击()
	定时演示(2)
结束 事件

事件 定时关闭.被单击()
	定时演示(3)
结束 事件

事件 延时操作.计时()
	延时操作.启用 = 假
	如果 浏览器.正在浏览 则
		判断 待执行
			分支 1
				浏览器.切换图片(1)
				记录("已请求切换到索引 1，以载入事件为准。")
			分支 2
				浏览器.重新载入()
				记录("已请求重新读取当前页，以载入事件为准。")
			分支 3
				浏览器.关闭()
		结束 判断
	结束 如果
结束 事件

事件 起始越界.被单击()
	浏览器.浏览图片(本地图片, 3)
结束 事件

事件 未开切换.被单击()
	浏览器.切换图片(0)
结束 事件

事件 清空日志.被单击()
	日志.文本 = ""
	日志行数 = 0
结束 事件

事件 浏览器.图片改变(索引 为 整数型)
	翻页次数 = 翻页次数 + 1
	记录("图片改变：索引=" & 索引 & "；图片可能仍在载入。")
结束 事件

事件 浏览器.载入成功(索引 为 整数型)
	成功次数 = 成功次数 + 1
	记录("载入成功：索引=" & 索引)
结束 事件

事件 浏览器.载入失败(索引 为 整数型, 原因 为 文本型)
	失败次数 = 失败次数 + 1
	记录("载入失败：索引=" & 索引 & "；" & 原因)
结束 事件

事件 浏览器.浏览关闭(索引 为 整数型)
	延时操作.启用 = 假
	关闭次数 = 关闭次数 + 1
	记录("浏览关闭：末页索引=" & 索引)
结束 事件

过程 记录(内容 为 文本型)
	如果 日志行数 >= 4 则
		日志.文本 = ""
		日志行数 = 0
	结束 如果
	日志.文本 = 日志.文本 & 内容 & "\n"
	日志行数 = 日志行数 + 1
	更新状态()
结束 过程

过程 更新状态()
	状态.文本 = "浏览=" & 浏览器.正在浏览 & "；索引=" & 浏览器.当前索引 & "；成功=" & 成功次数 & "，失败=" & 失败次数 & "，页变=" & 翻页次数 & "，关闭=" & 关闭次数
	错误状态.文本 = "最近错误：" & 浏览器.错误信息
结束 过程

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		延时操作.启用 = 假
		浏览器.关闭()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "图片浏览器使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "静态图片浏览"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "点击封面看单张；列表可左右翻页、双击和双指缩放。索引从 0 开始；大图按预览尺寸采样，GIF 不播放动画。"
		$结束 $定义
		$定义 封面 $为 图片框
			宽度 = 长度_匹配父级
			高度 = "110dp"
			图片 = "landscape.png"
			显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
		$结束 $定义
		$定义 本地操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 本地浏览 $为 按钮
				宽度 = "140dp"
				文本 = "三张本地图片"
			$结束 $定义
			$定义 第二张 $为 按钮
				宽度 = "140dp"
				文本 = "从第二张开始"
			$结束 $定义
			$定义 资源浏览 $为 按钮
				宽度 = "140dp"
				文本 = "浏览资源图"
			$结束 $定义
		$结束 $定义
		$定义 来源操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 私有浏览 $为 按钮
				宽度 = "140dp"
				文本 = "浏览私有文件"
			$结束 $定义
			$定义 系统选图 $为 按钮
				宽度 = "140dp"
				文本 = "系统选择图片"
			$结束 $定义
			$定义 坏图恢复 $为 按钮
				宽度 = "140dp"
				文本 = "坏图后翻页"
			$结束 $定义
		$结束 $定义
		$定义 控制操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 定时翻页 $为 按钮
				宽度 = "140dp"
				文本 = "3秒后翻页"
			$结束 $定义
			$定义 定时重读 $为 按钮
				宽度 = "140dp"
				文本 = "3秒后重读"
			$结束 $定义
			$定义 定时关闭 $为 按钮
				宽度 = "140dp"
				文本 = "3秒后关闭"
			$结束 $定义
		$结束 $定义
		$定义 失败操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 起始越界 $为 按钮
				宽度 = "140dp"
				文本 = "起始索引越界"
			$结束 $定义
			$定义 未开切换 $为 按钮
				宽度 = "140dp"
				文本 = "未打开时切换"
			$结束 $定义
			$定义 清空日志 $为 按钮
				宽度 = "140dp"
				文本 = "清空日志"
			$结束 $定义
		$结束 $定义
		$定义 图片地址 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = ""
			提示文本 = "输入可访问的 HTTP/HTTPS 图片网址"
		$结束 $定义
		$定义 网络浏览 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "浏览网络图片"
		$结束 $定义
		$定义 网络说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "网络图需可访问服务器；系统选图只使用返回 URI 的授权，不申请整个存储空间。失败界面可点“重新载入”。"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "等待操作。"
		$结束 $定义
		$定义 错误状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "最近错误："
		$结束 $定义
		$定义 日志 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "事件记录（最多保留最近一组 4 行）："
		$结束 $定义
		$定义 浏览器 $为 simple.library.wsd.imagebrowser.图片浏览器
		$结束 $定义
		$定义 选图器 $为 文件选择器
		$结束 $定义
		$定义 延时操作 $为 计时器
			启用 = 假
			间隔 = 3000
		$结束 $定义
	$结束 $定义
$结束 $属性
