''' 图片浏览器：本地浏览、系统选图、网络地址、错误反馈与销毁检查。
别名 浏览器类型 = simple.library.wsd.imagebrowser.图片浏览器

变量 图片列表 为 文本型()
变量 载入后关闭 为 逻辑型
变量 载入后销毁 为 逻辑型
变量 成功次数 为 整数型
变量 失败次数 为 整数型
变量 关闭次数 为 整数型

事件 主窗口.初始化()
	图片列表 = 分割文本("landscape.png,portrait.png,large.png", ",")
结束 事件

事件 三图浏览.被单击()
	浏览器.浏览图片(图片列表, 0)
结束 事件

事件 从第二张.被单击()
	浏览器.浏览图片(图片列表, 1)
结束 事件

事件 资源图片.被单击()
	浏览器.浏览图片("@drawable/browser_sample")
结束 事件

''' 将示例 PNG 字节写入私有文件，再用 file URI 浏览；无需存储权限。
事件 文件图片.被单击()
	创建目录("imagebrowser")
	如果 写出字节文件("imagebrowser/demo.png", Base64解码("")) 则
		变量 文件列表 为 文本型()
		文件列表 = 取文件列表("imagebrowser")
		如果 取数组成员数(文件列表) > 0 则 浏览器.浏览图片("file://" & 文件列表(0))
	结束 如果
结束 事件

事件 系统选图.被单击()
	文件选择器1.选择文件("image/*", 真)
结束 事件

事件 文件选择器1.文件选择完毕(地址 为 文本型())
	浏览器.浏览图片(地址, 0)
结束 事件

事件 网络图片.被单击()
	浏览器.浏览图片(图片地址.文本)
结束 事件

事件 坏图检查.被单击()
	变量 列表 为 文本型()
	列表 = 分割文本("broken.png,landscape.png", ",")
	浏览器.浏览图片(列表, 0)
结束 事件

事件 越界检查.被单击()
	浏览器.浏览图片(图片列表, 3)
	结果.文本 = "越界已反馈；正在浏览=" & 浏览器.正在浏览 & "，索引=" & 浏览器.当前索引
结束 事件

''' 连续替换列表，只允许最后一次浏览的载入结果到达。
事件 快速替换.被单击()
	浏览器.浏览图片(图片列表, 0)
	浏览器.浏览图片(图片列表, 1)
	浏览器.浏览图片(图片列表, 2)
结束 事件

''' 在成功事件里关闭，检查关闭事件与最终状态。
事件 回调关闭.被单击()
	载入后关闭 = 真
	浏览器.浏览图片("landscape.png")
结束 事件

''' 在成功事件里销毁，再创建新实例，检查旧回调是否污染新实例。
事件 销毁检查.被单击()
	载入后销毁 = 真
	浏览器.浏览图片("portrait.png")
结束 事件

事件 浏览器.图片改变(索引 为 整数型)
	结果.文本 = "当前索引=" & 索引 & "；等待图片载入。"
结束 事件

事件 浏览器.载入成功(索引 为 整数型)
	成功次数 = 成功次数 + 1
	结果.文本 = "载入成功，索引=" & 索引 & "；成功次数=" & 成功次数
	如果 载入后关闭 则
		载入后关闭 = 假
		浏览器.关闭()
		结果.文本 = "回调关闭完成；正在浏览=" & 浏览器.正在浏览 & "，索引=" & 浏览器.当前索引 & "，关闭次数=" & 关闭次数
	结束 如果
	如果 载入后销毁 则
		载入后销毁 = 假
		变量 旧组件 为 浏览器类型
		旧组件 = 浏览器
		''' 先更换字段引用，避免旧实例销毁时移除该字段的事件绑定。
		浏览器 = 创建 浏览器类型 位于 主窗口
		旧组件.销毁()
		结果.文本 = "旧组件已销毁，新组件正在浏览=" & 浏览器.正在浏览 & "，索引=" & 浏览器.当前索引
	结束 如果
结束 事件

事件 浏览器.载入失败(索引 为 整数型, 原因 为 文本型)
	失败次数 = 失败次数 + 1
	结果.文本 = "载入失败，索引=" & 索引 & "；" & 原因 & "；失败次数=" & 失败次数
结束 事件

事件 浏览器.浏览关闭(索引 为 整数型)
	关闭次数 = 关闭次数 + 1
	结果.文本 = "浏览已关闭，末页索引=" & 索引 & "；关闭次数=" & 关闭次数
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "图片浏览器示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 浏览器 $为 simple.library.wsd.imagebrowser.图片浏览器
		$结束 $定义
		$定义 文件选择器1 $为 文件选择器
		$结束 $定义
		$定义 页面滚动框 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 内容面板 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 说明 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "浏览静态图片，双击或双指缩放、左右翻页。示例自带横图、竖图和大图；系统选图使用授权 URI。"
				$结束 $定义
				$定义 三图浏览 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "浏览三张本地图片"
				$结束 $定义
				$定义 从第二张 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "从第二张开始"
				$结束 $定义
				$定义 资源图片 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "浏览资源图片"
				$结束 $定义
				$定义 文件图片 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "浏览私有文件"
				$结束 $定义
				$定义 系统选图 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "选择图片并浏览"
				$结束 $定义
				$定义 图片地址 $为 编辑框
					宽度 = 长度_匹配父级
					文本 = "http://127.0.0.1:18767/landscape.png"
				$结束 $定义
				$定义 网络图片 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "浏览输入的图片地址"
				$结束 $定义
				$定义 坏图检查 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "坏图后翻页恢复"
				$结束 $定义
				$定义 越界检查 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "索引越界检查"
				$结束 $定义
				$定义 快速替换 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "快速替换三次"
				$结束 $定义
				$定义 回调关闭 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "成功回调中关闭"
				$结束 $定义
				$定义 销毁检查 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "成功回调中销毁"
				$结束 $定义
				$定义 结果 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "等待操作。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
