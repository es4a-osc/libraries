''' 经典蓝牙 ESC/POS 小票：先配对和授权，再连接；不是 BLE。
''' 参考本库当前封装和群索下载页 https://www.qsprinter.com/download.html 的打印流程。
''' 打印指令已写出不等于纸张打印成功；须人工核对纸张、中文 GBK 和型号支持。
变量 打印忙 为 逻辑型
变量 待印文本 为 文本型
变量 成功次数 为 整数型
变量 失败次数 为 整数型
变量 发现次数 为 整数型

事件 主窗口.初始化()
	刷新状态()
结束 事件

过程 刷新状态()
	状态.文本 = "经典蓝牙存在=" & 设备蓝牙.是否存在() & "；已开启=" & 打印机.是否已开启蓝牙() & "；已连接=" & 打印机.是否已连接() & "；连接成功/失败=" & 成功次数 & "/" & 失败次数
结束 过程

过程 记录(内容 为 文本型)
	如果 取字符数(日志.文本) > 2500 则 日志.文本 = ""
	日志.文本 = 日志.文本 & "\n" & 内容
结束 过程

函数 可操作() 为 逻辑型
	可操作 = 假
	如果 设备蓝牙.是否存在() = 假 则
		记录("当前设备没有经典蓝牙，不能搜索或连接实体打印机。")
		退出 函数
	结束 如果
	如果 打印机.是否已开启蓝牙() = 假 则
		记录("请先授权并在系统中开启蓝牙，再刷新状态。")
		退出 函数
	结束 如果
	可操作 = 真
结束 函数

事件 授权按钮.被单击()
	记录("发起权限请求=" & 授权.请求权限("printer") & "；返回真不表示已经授权。")
结束 事件

事件 授权.请求结果(权限列表 为 文本型(), 授予结果 为 整数型(), 请求标记 为 文本型)
	变量 i 为 整数型
	循环 i = 0 至 取数组成员数(权限列表) - 1
		记录(权限列表(i) & "：授予结果=" & 授予结果(i))
	下个 i
	刷新状态()
结束 事件

事件 设置按钮.被单击()
	' 系统设置用于开启蓝牙和配对，不把打开设置当成连接成功。
	设备蓝牙.打开蓝牙设置()
结束 事件

事件 刷新按钮.被单击()
	刷新状态()
结束 事件

事件 配对按钮.被单击()
	如果 可操作() = 假 则 退出 事件
	变量 设备 为 文本型(,)
	变量 i 为 整数型
	设备 = 打印机.取已配对设备()
	记录("实际已配对设备数=" & 取数组下标(设备, 1))
	循环 i = 0 至 取数组下标(设备, 1) - 1
		记录(设备(i, 0) & " " & 设备(i, 1))
	下个 i
	' 把需要使用的设备 MAC 填入地址框，不自动连接发现的陌生设备。
结束 事件

事件 搜索按钮.被单击()
	如果 可操作() = 假 则 退出 事件
	如果 授权.是否授权("android.permission.ACCESS_FINE_LOCATION") = 假 则
		记录("请先授予定位权限；新系统还需要附近设备权限。")
		退出 事件
	结束 如果
	发现次数 = 0
	打印机.搜索设备()
	记录("已调用搜索，等待实际发现和搜索完毕事件。")
结束 事件

事件 停搜按钮.被单击()
	打印机.停止搜索()
结束 事件

事件 打印机.发现设备(名称 为 文本型, 地址 为 文本型, 是否已配对 为 逻辑型)
	发现次数 = 发现次数 + 1
	记录("发现=" & 名称 & " " & 地址 & "；已配对=" & 是否已配对)
结束 事件

事件 打印机.搜索完毕()
	记录("搜索完毕，实际发现事件=" & 发现次数 & "；发现不代表支持打印协议。")
结束 事件

事件 连接按钮.被单击()
	如果 打印忙 则 退出 事件
	记录("请求连接，等待连接成功或失败事件。")
	' 地址无效、缺少权限和不支持蓝牙均由组件的连接失败事件通知。
	打印机.连接设备(地址框.文本)
结束 事件

事件 断开按钮.被单击()
	如果 打印忙 则 退出 事件
	打印机.断开连接()
	刷新状态()
	记录("已断开打印连接；未关闭手机蓝牙。")
结束 事件

事件 打印机.连接成功()
	成功次数 = 成功次数 + 1
	刷新状态()
	记录("连接已建立，可发送小票；请人工核对纸张输出。")
结束 事件

事件 打印机.连接失败()
	失败次数 = 失败次数 + 1
	刷新状态()
	记录("连接失败：请核对 MAC、配对、电源、权限和 SPP 支持。")
结束 事件

事件 打印机.丢失连接()
	刷新状态()
	记录("打印连接意外丢失，未自动重发，避免重复打印。")
结束 事件

事件 打印按钮.被单击()
	如果 打印忙 则 退出 事件
	如果 打印机.是否已连接() = 假 则
		记录("尚未连接，未发送任何打印指令。")
		退出 事件
	结束 如果
	如果 取字符数(正文.文本) > 500 则
		记录("演示正文最多500个字符。")
		退出 事件
	结束 如果
	待印文本 = 正文.文本
	打印忙 = 真
	变量 参数 为 变体型(0)
	启动线程(本对象, "后台打印", 参数)
结束 事件

过程 后台打印()
	' 写入放在工作线程；不要将驱动写出当作设备打印完成。
	打印机.重置设置()
	打印机.对齐方式(2)
	打印机.粗体(真)
	打印机.文本("ES4A 演示小票\n")
	打印机.粗体(假)
	打印机.对齐方式(1)
	打印机.文本(待印文本 & "\n")
	打印机.条码("{B1234567890")
	打印机.换行()
	打印机.换行()
	打印机.打印当前内容()
	投递消息("写出", "小票指令已写出；请在实体打印机上核对文本及 Code128 条码。")
	位于 错误
		分支 否则
			投递消息("失败", "打印未完成；请检查连接，避免直接重复整张小票。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	打印忙 = 假
	记录(附加参数)
	刷新状态()
结束 事件

事件 退出按钮.被单击()
	如果 打印忙 则
		记录("请等待本次写入结束再退出。")
		退出 事件
	结束 如果
	打印机.停止搜索()
	打印机.断开连接()
	终止()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "经典蓝牙小票"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 打印机 $为 simple.library.wsd.bluetoothprinter.蓝牙打印机
		$结束 $定义
		$定义 设备蓝牙 $为 蓝牙通信器
		$结束 $定义
		$定义 授权 $为 权限请求
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "需实体经典蓝牙 SPP/ESC-POS 打印机，先在系统中配对。文本为 GBK，表情通常不受支持；纸宽、条码及字符集取决于型号。模拟器不能代替实际打印。"
		$结束 $定义
		$定义 准备行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 授权按钮 $为 按钮
				文本 = "请求权限"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 设置按钮 $为 按钮
				文本 = "系统蓝牙设置"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 刷新按钮 $为 按钮
				文本 = "刷新状态"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 设备行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 配对按钮 $为 按钮
				文本 = "列出配对设备"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 搜索按钮 $为 按钮
				文本 = "搜索设备"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 停搜按钮 $为 按钮
				文本 = "停止搜索"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 地址框 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			提示文本 = "打印机 MAC，例如 AA:BB:CC:DD:EE:FF"
		$结束 $定义
		$定义 连接行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 连接按钮 $为 按钮
				文本 = "连接指定 MAC"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 断开按钮 $为 按钮
				文本 = "断开连接"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 正文 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "90dp"
			文本 = "商品：Simple 示例\n数量：1    金额：12.00"
		$结束 $定义
		$定义 打印按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "发送一张演示小票"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "等待检查实际设备状态。"
		$结束 $定义
		$定义 日志 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "连接事件和发现的设备显示在这里。"
		$结束 $定义
		$定义 退出按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "退出示例"
		$结束 $定义
	$结束 $定义
$结束 $属性
