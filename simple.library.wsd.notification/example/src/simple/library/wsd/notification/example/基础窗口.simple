' 每个按钮直接演示一个用途；通知效果请在系统通知栏核对。
变量 来源 为 主窗口

事件 返回按钮.被单击()
	切换窗口(来源)
结束 事件

事件 基础窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 请求授权.被单击()
	变量 列表 为 文本型(1)
	列表(0) = "android.permission.POST_NOTIFICATIONS"
	权限.请求权限(列表, "通知授权")
结束 事件

事件 权限.请求结果(列表 为 文本型(), 结果 为 整数型(), 标记 为 文本型)
	输出.文本 = "系统通知开关=" & 管理器.是否允许通知() & "；无弹窗时可打开通知设置。"
结束 事件

事件 打开设置.被单击()
	管理器.打开通知设置()
结束 事件

事件 检查状态.被单击()
	变量 编号 为 整数型()
	变量 项 为 整数型
	变量 内容 为 文本型
	编号 = 管理器.取活动通知编号()
	内容 = "允许通知=" & 管理器.是否允许通知() & "；活动编号："
	循环 项 = 0 至 取数组成员数(编号) - 1
		内容 = 内容 & 编号(项) & " "
	下个
	输出.文本 = 内容
结束 事件

事件 发送通知.被单击()
	变量 通知 为 通知构建器
	通知 = 管理器.创建通知()
	通知.置小图标(R.drawable_notification_bell)
	通知.置标题("ES4A 普通通知")
	通知.置内容(正文.文本)
	通知.置自动取消(真)
	通知.置仅提醒一次(真)
	管理器.发送通知(101, 通知)
	输出.文本 = "已提交编号 101；下拉通知栏点击正文或滑动清除，回来看事件。"
结束 事件

事件 删除通知.被单击()
	管理器.删除通知(101)
	输出.文本 = "已删除编号 101；程序删除不触发清除事件。"
结束 事件

事件 清空通知.被单击()
	管理器.清空通知()
	输出.文本 = "已清空本应用通知。"
结束 事件

事件 管理器.通知被单击(编号 为 整数型)
	输出.文本 = "正文点击：" & 编号
结束 事件

事件 管理器.通知被清除(编号 为 整数型)
	输出.文本 = "用户清除：" & 编号
结束 事件

$属性
	$资源 $窗口
	$定义 基础窗口 $为 窗口
		标题 = "1. 授权与普通通知"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 返回按钮 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回主题目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "1. 授权与普通通知"
			字体大小 = 22
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "76dp"
			文本 = "Android 13+ 需系统通知授权；本例的目标版本可能由系统安排弹窗时机。发送只表示提交，开关和渠道决定是否展示。"
			字体大小 = 14
		$结束 $定义
		$定义 正文 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "58dp"
			文本 = "你好，Simple 😀"
			单行模式 = 假
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "0dp"
			权重 = 1
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 请求授权 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "请求通知权限"
				$结束 $定义
				$定义 打开设置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "打开系统通知设置"
				$结束 $定义
				$定义 检查状态 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "查询通知开关与活动编号"
				$结束 $定义
				$定义 发送通知 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "发送或更新编号 101"
				$结束 $定义
				$定义 删除通知 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "删除编号 101"
				$结束 $定义
				$定义 清空通知 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "清空本应用通知"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "选择一项操作，结果显示在这里。"
					字体大小 = 14
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 管理器 $为 simple.library.wsd.notification.通知管理器
		$结束 $定义
		$定义 权限 $为 权限请求
		$结束 $定义
	$结束 $定义
$结束 $属性
