''' 参考 Android 官方通知示例，使用当前封装的构建器、通知编号及三类事件。
''' https://developer.android.com/develop/ui/views/notifications/build-notification
''' 回调依赖本窗口存活；本例不是后台通知服务，发送返回不代表系统已经展示。
别名 构建器 = simple.library.wsd.notification.通知构建器
变量 下载通知 为 构建器
变量 进度 为 整数型
变量 点击次数 为 整数型
变量 按钮次数 为 整数型
变量 回复次数 为 整数型

事件 主窗口.初始化()
	下载通知 = 管理器.创建通知()
	下载通知.置标题("ES4A 下载进度")
	下载通知.置提示音(假)
	更新状态()
结束 事件

过程 更新状态()
	状态.文本 = "点击=" & 点击次数 & "；按钮=" & 按钮次数 & "；回复=" & 回复次数 & "；进度=" & 进度 & "%"
	授权状态.文本 = "POST_NOTIFICATIONS 授权查询=" & 权限.是否授权("android.permission.POST_NOTIFICATIONS") & "（Android 13+）"
结束 过程

事件 请求授权.被单击()
	变量 列表 为 文本型(1)
	列表(0) = "android.permission.POST_NOTIFICATIONS"
	权限.请求权限(列表, "通知授权")
	更新状态()
	输出.文本 = "已请求；若没有系统弹窗，可先发送一条或打开应用设置检查通知开关。"
结束 事件

事件 权限.请求结果(权限列表 为 文本型(), 授予结果 为 整数型(), 请求标记 为 文本型)
	如果 请求标记 = "通知授权" 则
		更新状态()
		如果 权限.是否授权("android.permission.POST_NOTIFICATIONS") 则
			输出.文本 = "通知权限已授予；请发送后下拉通知栏核对。"
		否则
			输出.文本 = "通知权限未授予或系统未弹窗；请到应用设置核对。"
		结束 如果
	结束 如果
结束 事件

事件 打开设置.被单击()
	权限.打开设置()
结束 事件

''' 编号 101 用于正文点击、普通按钮与内联回复；同号重发更新原通知。
事件 发送普通.被单击()
	变量 通知 为 构建器
	通知 = 管理器.创建通知()
	通知.置小图标(R.drawable_notification_bell)
	通知.置标题("ES4A 可回复通知")
	通知.置内容(正文.文本)
	通知.置长文本样式(正文.文本 & "；展开后可以点击查看按钮，或直接输入回复。")
	通知.置优先级(构建器.优先级_高)
	通知.置公开范围(构建器.公开范围_私密)
	通知.置提示音(真)
	通知.添加按钮("查看", "view")
	通知.添加回复("回复", "reply", "输入回复内容")
	管理器.发送通知(101, 通知)
	更新状态()
	输出.文本 = "已提交编号 101；下拉通知栏查看。重发更新同一条，实际显示与声音受系统和渠道控制。"
结束 事件

事件 常驻静音.被单击()
	变量 通知 为 构建器
	通知 = 管理器.创建通知()
	通知.置标题("ES4A 常驻静音")
	通知.置内容("标记为常驻；能否滑动清除由系统决定。")
	通知.置常驻(真)
	通知.置提示音(假)
	管理器.发送通知(103, 通知)
	更新状态()
	输出.文本 = "已提交编号 103，标记常驻并使用静音渠道；可用清空按钮移除。"
结束 事件

''' 复用构建器和编号 102；进度由用户点击推进，不模拟真实网络下载。
事件 更新进度.被单击()
	进度 = 进度 + 25
	如果 进度 > 100 则 进度 = 0
	下载通知.置内容("演示进度 " & 进度 & "%（没有下载文件）")
	下载通知.置进度(100, 进度)
	管理器.发送通知(102, 下载通知)
	更新状态()
	输出.文本 = "已更新编号 102；多次操作应更新同一条进度通知。"
结束 事件

事件 完成进度.被单击()
	进度 = 100
	下载通知.清除进度()
	下载通知.置内容("演示任务已完成（没有下载文件）")
	管理器.发送通知(102, 下载通知)
	更新状态()
	输出.文本 = "已清除编号 102 的进度条并更新正文。"
结束 事件

事件 多行样式.被单击()
	变量 行 为 文本型(3)
	变量 通知 为 构建器
	行(0) = "第一条：你好，Simple"
	行(1) = "第二条：中文与表情😀"
	行(2) = "第三条：展开查看全部内容"
	通知 = 管理器.创建通知()
	通知.置标题("ES4A 多行通知")
	通知.置内容("展开查看三条消息")
	通知.置多行样式(行)
	管理器.发送通知(104, 通知)
	更新状态()
	输出.文本 = "已提交多行样式，编号 104；在系统通知栏展开查看。"
结束 事件

事件 图片样式.被单击()
	变量 通知 为 构建器
	通知 = 管理器.创建通知()
	通知.置标题("ES4A 图片通知")
	通知.置内容("展开查看示例图标")
	通知.置大图片样式(R.drawable_icon)
	管理器.发送通知(105, 通知)
	更新状态()
	输出.文本 = "已提交图片样式，编号 105；图片来自工程 drawable 资源。"
结束 事件

事件 删除普通.被单击()
	管理器.删除通知(101)
	输出.文本 = "已请求删除编号 101，其它编号不受影响。"
结束 事件

事件 清空通知.被单击()
	管理器.清空通知()
	输出.文本 = "已请求清空本应用的所有通知。"
结束 事件

事件 管理器.通知被单击(编号 为 整数型)
	点击次数 = 点击次数 + 1
	更新状态()
	输出.文本 = "正文点击：通知编号=" & 编号
结束 事件

事件 管理器.按钮被单击(编号 为 整数型, 标记 为 文本型)
	按钮次数 = 按钮次数 + 1
	更新状态()
	输出.文本 = "操作按钮：通知编号=" & 编号 & "；标记=" & 标记
结束 事件

事件 管理器.收到回复(编号 为 整数型, 标记 为 文本型, 内容 为 文本型)
	变量 确认通知 为 构建器
	回复次数 = 回复次数 + 1
	更新状态()
	输出.文本 = "内联回复：通知编号=" & 编号 & "；标记=" & 标记 & "；内容=" & 内容
	''' 处理完回复后更新同一编号，收起系统回复输入框及发送进度；不重复附加回复按钮。
	确认通知 = 管理器.创建通知()
	确认通知.置标题("ES4A 回复已接收")
	确认通知.置内容(内容)
	确认通知.置提示音(假)
	管理器.发送通知(编号, 确认通知)
结束 事件

''' 离开示例时主动清理本应用通知，不遗留不可接收的回调入口。
事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		管理器.清空通知()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "通知使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "发送通知并接收操作"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "Android 13+ 需系统通知授权；弹窗时机也受应用目标版本影响。允许后发送，下拉通知栏实际查看并操作。"
		$结束 $定义
		$定义 权限区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 请求授权 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "请求通知权限"
			$结束 $定义
			$定义 打开设置 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "打开应用设置"
			$结束 $定义
		$结束 $定义
		$定义 正文 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "55dp"
			单行模式 = 假
			文本 = "你好，Simple 😀"
		$结束 $定义
		$定义 普通区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 发送普通 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "发送可回复通知"
			$结束 $定义
			$定义 常驻静音 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "常驻静音通知"
			$结束 $定义
		$结束 $定义
		$定义 进度区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 更新进度 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "更新进度 +25%"
			$结束 $定义
			$定义 完成进度 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "完成并移除进度条"
			$结束 $定义
		$结束 $定义
		$定义 样式区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 多行样式 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "发送多行样式"
			$结束 $定义
			$定义 图片样式 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "发送图片样式"
			$结束 $定义
		$结束 $定义
		$定义 清理区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除普通 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "删除普通通知"
			$结束 $定义
			$定义 清空通知 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "清空本应用通知"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 授权状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = ""
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "准备好后发送通知；回调结果显示在这里。"
		$结束 $定义
		$定义 限制 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "回复需 Android 7+；通知点击与操作回调依赖本窗口仍存活。只提交发送请求不代表已展示；常驻和提示音效果由系统控制。"
		$结束 $定义
		$定义 权限 $为 权限请求
		$结束 $定义
		$定义 管理器 $为 simple.library.wsd.notification.通知管理器
		$结束 $定义
	$结束 $定义
$结束 $属性
