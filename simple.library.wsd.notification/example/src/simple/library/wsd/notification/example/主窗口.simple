别名 通知构建器 = simple.library.wsd.notification.通知构建器
变量 页0 为 基础窗口

事件 入口0.被单击()
	如果 页0 = 空 则
		页0 = 创建 基础窗口
		页0.来源 = 主窗口
	结束 如果
	切换窗口(页0)
结束 事件
变量 页1 为 样式窗口

事件 入口1.被单击()
	如果 页1 = 空 则
		页1 = 创建 样式窗口
		页1.来源 = 主窗口
	结束 如果
	切换窗口(页1)
结束 事件
变量 页2 为 进度窗口

事件 入口2.被单击()
	如果 页2 = 空 则
		页2 = 创建 进度窗口
		页2.来源 = 主窗口
	结束 如果
	切换窗口(页2)
结束 事件
变量 页3 为 操作窗口

事件 入口3.被单击()
	如果 页3 = 空 则
		页3 = 创建 操作窗口
		页3.来源 = 主窗口
	结束 如果
	切换窗口(页3)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		管理器.清空通知()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "状态条通知示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "状态条通知示例"
			字体大小 = 22
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "76dp"
			文本 = "先确认系统通知授权，再进入主题发送通知并下拉通知栏操作。回调依赖组件和宿主 Activity 存活；本例不包含后台服务。"
			字体大小 = 14
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = "0dp"
			权重 = 1
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 入口0 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "01 授权、发送与清除"
				$结束 $定义
				$定义 入口1 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "02 展开样式与通知属性"
				$结束 $定义
				$定义 入口2 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "03 进度、分组与超时"
				$结束 $定义
				$定义 入口3 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "43dp"
					文本 = "04 操作按钮与内联回复"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 管理器 $为 simple.library.wsd.notification.通知管理器
		$结束 $定义
	$结束 $定义
$结束 $属性
