' 示例入口：类库别名在这里集中声明，按章节打开独立页面。
别名 FJ2操作 = simple.library.wsd.fastjson2.FJ2操作
别名 FJ2值 = simple.library.wsd.fastjson2.FJ2值
别名 FJ2读配置 = simple.library.wsd.fastjson2.FJ2读配置
别名 FJ2写配置 = simple.library.wsd.fastjson2.FJ2写配置
别名 FJ2写入器 = simple.library.wsd.fastjson2.FJ2写入器
别名 FJ2读取器 = simple.library.wsd.fastjson2.FJ2读取器
别名 FJ2符号表 = simple.library.wsd.fastjson2.FJ2符号表
别名 FJ2路径 = simple.library.wsd.fastjson2.FJ2路径

变量 文本页 为 文本窗口
变量 文本已创建 为 逻辑型
变量 对象数组页 为 对象数组窗口
变量 对象数组已创建 为 逻辑型
变量 二进制页 为 二进制窗口
变量 二进制已创建 为 逻辑型
变量 路径配置页 为 路径配置窗口
变量 路径配置已创建 为 逻辑型
变量 对象映射页 为 对象映射窗口
变量 对象映射已创建 为 逻辑型
变量 过滤页 为 过滤窗口
变量 过滤已创建 为 逻辑型
变量 运行库互转页 为 运行库互转窗口
变量 运行库互转已创建 为 逻辑型
变量 顺序页 为 顺序窗口
变量 顺序已创建 为 逻辑型

事件 入口1.被单击()
	如果 取反 文本已创建 则
		文本页 = 创建 文本窗口
		文本页.来源 = 主窗口
		文本已创建 = 真
	结束 如果
	切换窗口(文本页)
结束 事件

事件 入口2.被单击()
	如果 取反 对象数组已创建 则
		对象数组页 = 创建 对象数组窗口
		对象数组页.来源 = 主窗口
		对象数组已创建 = 真
	结束 如果
	切换窗口(对象数组页)
结束 事件

事件 入口3.被单击()
	如果 取反 二进制已创建 则
		二进制页 = 创建 二进制窗口
		二进制页.来源 = 主窗口
		二进制已创建 = 真
	结束 如果
	切换窗口(二进制页)
结束 事件

事件 入口4.被单击()
	如果 取反 路径配置已创建 则
		路径配置页 = 创建 路径配置窗口
		路径配置页.来源 = 主窗口
		路径配置已创建 = 真
	结束 如果
	切换窗口(路径配置页)
结束 事件

事件 入口5.被单击()
	如果 取反 对象映射已创建 则
		对象映射页 = 创建 对象映射窗口
		对象映射页.来源 = 主窗口
		对象映射已创建 = 真
	结束 如果
	切换窗口(对象映射页)
结束 事件

事件 入口6.被单击()
	如果 取反 过滤已创建 则
		过滤页 = 创建 过滤窗口
		过滤页.来源 = 主窗口
		过滤已创建 = 真
	结束 如果
	切换窗口(过滤页)
结束 事件

事件 入口7.被单击()
	如果 取反 运行库互转已创建 则
		运行库互转页 = 创建 运行库互转窗口
		运行库互转页.来源 = 主窗口
		运行库互转已创建 = 真
	结束 如果
	切换窗口(运行库互转页)
结束 事件

事件 入口8.被单击()
	如果 取反 顺序已创建 则
		顺序页 = 创建 顺序窗口
		顺序页.来源 = 主窗口
		顺序已创建 = 真
	结束 如果
	切换窗口(顺序页)
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "Fastjson2 入门示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "Fastjson2 入门示例"
			字体大小 = 24
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "从文本解析开始。每页对应一个源码文件，每个按钮直接展示一个 API 的用法。"
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "1. 文本解析"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "2. 对象与数组"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "3. JSONB"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "4. 路径与配置"
		$结束 $定义
		$定义 入口5 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "5. 对象映射"
		$结束 $定义
		$定义 入口6 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "6. 属性过滤"
		$结束 $定义
		$定义 入口7 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "7. 运行库互转"
		$结束 $定义
		$定义 入口8 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "8. 文本顺序读写"
		$结束 $定义
		$定义 使用条件 $为 标签
			宽度 = 长度_匹配父级
			文本 = "示例只处理少量本地数据，因此直接在按钮事件中调用。处理大文档时请放到后台。无需网络和存储权限。"
		$结束 $定义
	$结束 $定义
$结束 $属性
