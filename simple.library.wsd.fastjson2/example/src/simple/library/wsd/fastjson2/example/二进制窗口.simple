' 每个按钮事件独立演示一个操作；FJ2 类库别名集中声明在主窗口。
变量 来源 为 主窗口

事件 还原.被单击()
	变量 原文 为 FJ2值
	变量 结果 为 FJ2值
	变量 字节集 为 字节型()
	原文 = FJ2操作.解析文本("{\"name\":\"小明\",\"age\":20}")
	字节集 = 原文.到JSONB()
	结果 = FJ2操作.解析JSONB(字节集)
	输出.文本 = "JSONB 字节数：" & 取数组成员数(字节集) & "\n还原：" & 结果.到JSON文本()
结束 事件

事件 写数组.被单击()
	变量 配置 为 FJ2写配置
	变量 写入 为 FJ2写入器
	变量 结果 为 FJ2值
	变量 字节集 为 字节型()
	配置 = 创建 FJ2写配置
	写入 = FJ2写入器.创建JSONB(配置, 空)
	写入.开始数组(2)
	写入.写值(FJ2操作.创建文本("小明"))
	写入.写值(FJ2操作.创建文本("小红"))
	写入.结束数组()
	字节集 = 写入.取JSONB字节()
	写入.关闭()
	结果 = FJ2操作.解析JSONB(字节集)
	输出.文本 = 结果.到JSON文本()
结束 事件

事件 读数组.被单击()
	变量 配置 为 FJ2读配置
	变量 读取 为 FJ2读取器
	变量 数组值 为 FJ2值
	变量 当前项 为 FJ2值
	变量 名单 为 文本型
	数组值 = FJ2操作.解析文本("[\"小明\",\"小红\"]")
	配置 = 创建 FJ2读配置
	读取 = FJ2读取器.打开JSONB(数组值.到JSONB(), 配置, 空)
	读取.尝试数组开始()
	判断循环 取反 读取.尝试数组结束()
		当前项 = 读取.读取值()
		名单 = 名单 & 当前项.取文本() & "\n"
	结束 判断循环
	读取.要求结束()
	读取.关闭()
	输出.文本 = 名单
结束 事件

''' 符号表由编解码双方共享，用相同内容的表还原字段名称。
事件 符号编码.被单击()
	变量 符号 为 FJ2符号表
	变量 写配置 为 FJ2写配置
	变量 读配置 为 FJ2读配置
	变量 文档 为 FJ2值
	变量 还原值 为 FJ2值
	变量 数据 为 字节型()
	符号 = FJ2符号表.创建(分割文本("name|age", "|"))
	写配置 = 创建 FJ2写配置
	写配置.设置特性(FJ2写配置.特性_WriteNameAsSymbol, 真)
	读配置 = 创建 FJ2读配置
	文档 = FJ2操作.解析文本("{\"name\":\"小明\",\"age\":20}")
	数据 = 文档.到JSONB(写配置, 符号)
	还原值 = FJ2操作.解析JSONB(数据, 读配置, 符号)
	输出.文本 = "外部符号数：" & 符号.取数量() & "\n还原：" & 还原值.到JSON文本()
结束 事件

事件 符号查询.被单击()
	变量 符号 为 FJ2符号表
	变量 序号 为 整数型
	变量 哈希 为 长整数型
	符号 = FJ2符号表.创建(分割文本("name|age", "|"))
	序号 = 符号.取序号("name")
	哈希 = 符号.取名称哈希(序号)
	输出.文本 = "名称：" & 符号.按哈希取名称(哈希) & "\n序号：" & 符号.按哈希取序号(哈希) & "\n符号表哈希：" & 符号.取表哈希()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 二进制窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 二进制窗口 $为 窗口
		标题 = "3. JSONB"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "3. JSONB"
			字体大小 = 22
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "JSONB 是二进制数据，解码后才能显示。顺序写入 JSONB 数组时，先给出元素数量。"
			字体大小 = 14
		$结束 $定义
		$定义 还原 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "JSONB 编码与还原"
		$结束 $定义
		$定义 写数组 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "顺序写入数组"
		$结束 $定义
		$定义 读数组 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "逐项读取数组"
		$结束 $定义
		$定义 符号编码 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "使用外部符号表编码与还原"
		$结束 $定义
		$定义 符号查询 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "查询符号名称与哈希"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点击按钮，查看这个操作的结果。"
			字体大小 = 15
		$结束 $定义
	$结束 $定义
$结束 $属性
