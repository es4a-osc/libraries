' 每个按钮直接演示一个操作，所有图表调用在界面线程执行。
变量 来源 为 主窗口
变量 下个横坐标 为 双精度小数型

事件 更新窗口.初始化()
	图表.初始化图表("更新、视图与图片", 12, 颜色_白)
	下个横坐标 = 6
	图表.添加数值组("实时", 数组("0,1,2,3,4,5"), 数组("2,4,3,6,5,7"), &HFF3086C8, 0)
	图表.构建图表()
结束 事件

事件 追加.被单击()
	图表.追加项目(0, 下个横坐标, 数组("8"))
	下个横坐标 = 下个横坐标 + 1
	图表.刷新图表()
	输出.文本 = "项目数：" & 图表.项目数量
结束 事件

事件 替换.被单击()
	图表.更新数据组(0, 数组("0,2,4,6"), 数组("4,2,7,3"))
	下个横坐标 = 7
	图表.刷新图表()
	输出.文本 = "整组已替换，样式保留。"
结束 事件

事件 删除.被单击()
	图表.删除项目(0, 0)
	图表.刷新图表()
	输出.文本 = "项目数：" & 图表.项目数量
	位于 错误
		分支 否则
			输出.文本 = "至少保留一个项目，或删除整个数据组。"
	结束 错误
结束 事件

事件 放大.被单击()
	图表.放大()
	变量 范围 为 双精度小数型()
	范围 = 图表.取可见范围(0)
	输出.文本 = "可见横轴：" & 范围(0) & " 至 " & 范围(1)
结束 事件

事件 复位.被单击()
	图表.重置视图()
结束 事件

事件 图片.被单击()
	变量 图片 为 字节型()
	图片 = 图表.导出图片(0, 100)
	输出.文本 = "PNG 字节数：" & 取数组成员数(图片)
结束 事件

事件 坐标.被单击()
	变量 像素 为 双精度小数型()
	变量 数据 为 双精度小数型()
	像素 = 图表.数据坐标转像素(2, 4, 0)
	数据 = 图表.像素转数据坐标(像素(0), 像素(1), 0)
	输出.文本 = "数据 (2,4) → DIP (" & 像素(0) & "," & 像素(1) & ") → (" & 数据(0) & "," & 数据(1) & ")"
结束 事件

事件 轴文字.被单击()
	图表.添加轴文字(1, 5, "参考线")
	图表.刷新图表()
	输出.文本 = "左轴 5 处显示自定义文字。"
结束 事件

事件 内置按钮.被单击()
	变量 样式 为 ACE图表样式
	样式 = 创建 ACE图表样式
	样式.缩放按钮 = 真
	图表.设置图表样式(样式)
	图表.刷新图表()
	输出.文本 = "图中右下角显示内置缩放按钮。"
结束 事件

事件 图表.项目被选中(数据组 为 整数型, 项目 为 整数型, 横坐标 为 双精度小数型, 数值 为 双精度小数型)
	输出.文本 = "组：" & 数据组 & "，项：" & 项目 & "，X：" & 横坐标 & "，值：" & 数值
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 更新窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

函数 数组(文本 为 文本型) 为 双精度小数型()
	变量 项目 为 文本型()
	项目 = 分割文本(文本, ",")
	变量 数值 为 双精度小数型(取数组成员数(项目))
	变量 编号 为 整数型
	循环 编号 = 0 至 取数组成员数(项目) - 1
		数值(编号) = 到双精度小数(项目(编号))
	下个
	数组 = 数值
结束 函数

事件 图表.图表被拖动()
	输出.文本 = "手势拖动已改变可见范围。"
结束 事件

事件 图表.图表被缩放(放大 为 逻辑型, 倍率 为 单精度小数型)
	输出.文本 = "缩放事件：" & 放大 & "，倍率：" & 倍率
结束 事件

事件 范围.被单击()
	图表.设置轴范围(0, 0, 10)
	图表.设置轴范围(1, 0, 10)
	图表.刷新图表()
	变量 范围 为 双精度小数型()
	范围 = 图表.取可见范围(0)
	输出.文本 = "横轴：" & 范围(0) & " 至 " & 范围(1) & "；纵轴：" & 范围(2) & " 至 " & 范围(3)
结束 事件

事件 自动范围.被单击()
	图表.恢复自动范围(0)
	图表.恢复自动范围(1)
	图表.刷新图表()
	变量 范围 为 双精度小数型()
	范围 = 图表.取可见范围(0)
	输出.文本 = "自动横轴：" & 范围(0) & " 至 " & 范围(1)
结束 事件

事件 图表.视图被重置()
	输出.文本 = "视图已恢复初始范围。"
结束 事件

$属性
	$资源 $窗口
	$定义 更新窗口 $为 窗口
		标题 = "更新、视图与图片"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "返回目录"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "更新、视图与图片"
			字体大小 = 21
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "数值坐标支持逐项追加、删除和整组替换。刷新保留可见范围，构建恢复设定范围。"
			字体大小 = 13
		$结束 $定义
		$定义 图表 $为 simple.library.wsd.achartengine.ACE折线图
			宽度 = 长度_匹配父级
			高度 = "280dp"
		$结束 $定义
		$定义 操作行8 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 追加 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "追加一点"
				字体大小 = 13
			$结束 $定义
			$定义 替换 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "替换整组"
				字体大小 = 13
			$结束 $定义
			$定义 删除 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "删除首项"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作行9 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 放大 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "放大"
				字体大小 = 13
			$结束 $定义
			$定义 复位 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "恢复视图"
				字体大小 = 13
			$结束 $定义
			$定义 图片 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "导出PNG"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作行10 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 坐标 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "坐标换算"
				字体大小 = 13
			$结束 $定义
			$定义 轴文字 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "自定义轴文字"
				字体大小 = 13
			$结束 $定义
			$定义 内置按钮 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "内置缩放按钮"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作行11 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 范围 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "固定轴范围"
				字体大小 = 13
			$结束 $定义
			$定义 自动范围 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "恢复自动范围"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点选适用于饼图和坐标图；项目编号从 0 开始。"
			字体大小 = 14
		$结束 $定义
	$结束 $定义
$结束 $属性
