' 每个按钮直接演示一个操作，所有图表调用在界面线程执行。
变量 来源 为 主窗口

事件 圆环窗口.初始化()
	图表.初始化图表("圆环：多层分类", 12, 颜色_白)
	图表.添加圆环("本月", 分割文本("餐饮,交通,书籍", ","), 数组("15,25,10"))
	图表.添加圆环("上月", 分割文本("餐饮,交通,书籍", ","), 数组("20,15,15"))
	图表.构建图表()
结束 事件

事件 选择.被单击()
	变量 数值 为 双精度小数型()
	数值 = 图表.取数据组数值(0, 0)
	输出.文本 = "本月：" & 数值(0) & "、" & 数值(1) & "、" & 数值(2)
结束 事件

事件 更新.被单击()
	图表.更新圆环(1, 分割文本("餐饮,交通,书籍", ","), 数组("10,20,30"))
	图表.刷新图表()
	输出.文本 = "上月圆环已更新。"
结束 事件

事件 主动.被单击()
	图表.选择项目(1, 2, 真)
结束 事件

事件 图表.项目被选中(数据组 为 整数型, 项目 为 整数型, 横坐标 为 双精度小数型, 数值 为 双精度小数型)
	输出.文本 = "组：" & 数据组 & "，项：" & 项目 & "，X：" & 横坐标 & "，值：" & 数值
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 圆环窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

函数 数组(文本 为 文本型) 为 双精度小数型()
	变量 项目 为 文本型()
	项目 = 分割文本(文本, ",")
	变量 数值 为 双精度小数型(取数组成员数(项目))
	变量 编号 为 整数型
	循环 编号 = 0 至 取数组成员数(项目) - 1
		数值(编号) = 到双精度小数(项目(编号))
	下个
	数组 = 数值
结束 函数

事件 中心.被单击()
	变量 样式 为 ACE图表样式
	样式 = 创建 ACE图表样式
	样式.圆图中心横坐标 = 240
	样式.圆图中心纵坐标 = 130
	样式.圆图比例 = 0.9
	图表.设置图表样式(样式)
	图表.刷新图表()
	输出.文本 = "圆心设为 (240,130) DIP，比例设为 0.9。"
结束 事件

事件 放大.被单击()
	图表.放大()
结束 事件

事件 复位.被单击()
	图表.重置视图()
	输出.文本 = "已恢复配置的圆心和比例。"
结束 事件

$属性
	$资源 $窗口
	$定义 圆环窗口 $为 窗口
		标题 = "圆环：多层分类"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "返回目录"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "圆环：多层分类"
			字体大小 = 21
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "每次添加一层圆环，各层可以有不同项目数；同一扇区序号共用颜色，图例表示圆环层。"
			字体大小 = 13
		$结束 $定义
		$定义 图表 $为 simple.library.wsd.achartengine.ACE圆环图
			宽度 = 长度_匹配父级
			高度 = "280dp"
		$结束 $定义
		$定义 操作行8 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 选择 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "查询本月"
				字体大小 = 13
			$结束 $定义
			$定义 更新 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "更新上月"
				字体大小 = 13
			$结束 $定义
			$定义 主动 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "主动选择一项"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作行9 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 中心 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "调整圆心"
				字体大小 = 13
			$结束 $定义
			$定义 放大 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "放大圆环"
				字体大小 = 13
			$结束 $定义
			$定义 复位 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "恢复圆环"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点选适用于饼图和坐标图；项目编号从 0 开始。"
			字体大小 = 14
		$结束 $定义
	$结束 $定义
$结束 $属性
