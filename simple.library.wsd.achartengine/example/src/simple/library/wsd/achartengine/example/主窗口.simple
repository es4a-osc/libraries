' 统一声明类库别名，按图形和数据更新功能分窗。
别名 ACE图表样式 = simple.library.wsd.achartengine.ACE图表样式
别名 ACE数据组样式 = simple.library.wsd.achartengine.ACE数据组样式
别名 ACE轴样式 = simple.library.wsd.achartengine.ACE轴样式
别名 ACE仪表样式 = simple.library.wsd.achartengine.ACE仪表样式

事件 入口1.被单击()
	变量 页面 为 折线窗口
	页面 = 创建 折线窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口2.被单击()
	变量 页面 为 柱状窗口
	页面 = 创建 柱状窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口3.被单击()
	变量 页面 为 曲线窗口
	页面 = 创建 曲线窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口4.被单击()
	变量 页面 为 时间窗口
	页面 = 创建 时间窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口5.被单击()
	变量 页面 为 散点窗口
	页面 = 创建 散点窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口6.被单击()
	变量 页面 为 气泡窗口
	页面 = 创建 气泡窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口7.被单击()
	变量 页面 为 区间窗口
	页面 = 创建 区间窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口8.被单击()
	变量 页面 为 组合窗口
	页面 = 创建 组合窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口9.被单击()
	变量 页面 为 饼状窗口
	页面 = 创建 饼状窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口10.被单击()
	变量 页面 为 圆环窗口
	页面 = 创建 圆环窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口11.被单击()
	变量 页面 为 仪表窗口
	页面 = 创建 仪表窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口12.被单击()
	变量 页面 为 更新窗口
	页面 = 创建 更新窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "ACE图表入门示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "ACE图表入门示例"
			字体大小 = 24
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "十一类图形与数据更新。每页对应一个窗口源码，每个按钮直接演示一种用法。"
			字体大小 = 14
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "1. 折线：分类与左右轴"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "2. 柱状：多组与正负值"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "3. 平滑曲线：填充与虚线"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "4. 时间：毫秒时间戳"
		$结束 $定义
		$定义 入口5 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "5. 散点：不等间隔横坐标"
		$结束 $定义
		$定义 入口6 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "6. 气泡：位置与大小"
		$结束 $定义
		$定义 入口7 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "7. 区间柱：上下限"
		$结束 $定义
		$定义 入口8 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "8. 组合：图形与双轴"
		$结束 $定义
		$定义 入口9 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "9. 饼状：占比与更新"
		$结束 $定义
		$定义 入口10 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "10. 圆环：多层分类"
		$结束 $定义
		$定义 入口11 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "11. 仪表盘：量程与指针"
		$结束 $定义
		$定义 入口12 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "12. 更新、视图与图片"
		$结束 $定义
	$结束 $定义
$结束 $属性
