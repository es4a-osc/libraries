''' 参考上游 BudgetPieChart 的分类预算展示，用当前封装 API 维护三份独立数据。
''' https://github.com/ddanny/achartengine/blob/master/achartengine/demo/org/achartengine/chartdemo/demo/chart/BudgetPieChart.java
''' 初始化会清空原数据；所有图表调用均在按钮事件等界面线程内执行。
变量 当前 为 整数型
变量 项数 为 整数型(3)
变量 摘要 为 文本型(3)
变量 图名 为 文本型()
变量 深色 为 逻辑型

事件 主窗口.初始化()
	图名 = 分割文本("饼状图,柱状图,折线图", ",")
	恢复全部()
	显示图表(0)
结束 事件

''' 同一组初始值分别送入三个组件；之后只修改当前图表，切换不会清空其它图表。
过程 恢复全部()
	变量 原编号 为 整数型
	变量 编号 为 整数型
	原编号 = 当前
	循环 编号 = 0 至 2
		当前 = 编号
		初始化当前()
		加入项目("餐饮", "15")
		加入项目("交通", "25")
		加入项目("书籍", "10")
		构建当前()
	下个 编号
	当前 = 原编号
	更新说明()
	输出.文本 = "已恢复三份初始数据；可以切换图表或追加一个项目。"
结束 过程

过程 初始化当前()
	变量 背景 为 整数型
	背景 = 颜色_白
	如果 深色 则 背景 = &HFF202B36
	判断 当前
		分支 0
			饼图.初始化图表("分类占比", 14, 背景)
		分支 1
			柱图.初始化图表("项目数值", "类别", "数值", 14, 背景, &HFF3086C8)
		分支 2
			线图.初始化图表("按添加顺序连线", "类别", "数值", 14, 背景, &HFF269B68)
	结束 判断
	项数(当前) = 0
	摘要(当前) = ""
结束 过程

过程 加入项目(名称 为 文本型, 数值 为 文本型)
	判断 当前
		分支 0
			变量 颜色 为 整数型
			判断 项数(当前) % 4
				分支 0
					颜色 = &HFF3086C8
				分支 1
					颜色 = &HFF269B68
				分支 2
					颜色 = &HFFE9A13B
				分支 否则
					颜色 = &HFF9B59B6
			结束 判断
			饼图.添加数据(名称, 数值, "元", 颜色)
		分支 1
			柱图.添加数据(名称, 数值, "元")
		分支 2
			线图.添加数据(名称, 数值, "元")
	结束 判断
	' 只有添加成功才登记；摘要记录调用方已加入的数据，不是图表的查询接口。
	项数(当前) = 项数(当前) + 1
	如果 摘要(当前) <> "" 则 摘要(当前) = 摘要(当前) & "；"
	摘要(当前) = 摘要(当前) & 名称 & "=" & 数值
结束 过程

过程 构建当前()
	判断 当前
		分支 0
			饼图.构建图表()
		分支 1
			柱图.构建图表()
		分支 2
			线图.构建图表()
	结束 判断
结束 过程

过程 显示图表(编号 为 整数型)
	当前 = 编号
	饼图.可视 = 编号 = 0
	柱图.可视 = 编号 = 1
	线图.可视 = 编号 = 2
	更新说明()
	输出.文本 = "正在显示" & 图名(当前) & "；每种图表的数据独立保留。"
结束 过程

过程 更新说明()
	概况.文本 = 图名(当前) & "；已加入 " & 项数(当前) & " 项"
	数据说明.文本 = 摘要(当前)
	如果 项数(当前) = 0 则 数据说明.文本 = "无项目；可以添加一个数据或恢复全部。"
结束 过程

事件 看饼图.被单击()
	显示图表(0)
结束 事件

事件 看柱图.被单击()
	显示图表(1)
结束 事件

事件 看线图.被单击()
	显示图表(2)
结束 事件

事件 追加.被单击()
	如果 名称输入.文本 = "" 则
		输出.文本 = "请先填写项目名称。"
		退出 事件
	结束 如果
	' 六项只是此示例为小屏标签设置的数量限制，不是类库上限。
	如果 项数(当前) >= 6 则
		输出.文本 = "此示例最多展示六项，避免标签拥挤；可先清空当前图表。"
		退出 事件
	结束 如果
	变量 已加入 为 逻辑型
	加入项目(名称输入.文本, 数值输入.文本)
	已加入 = 真
	更新说明()
	构建当前()
	输出.文本 = "已追加并重新构建当前图表；其它图表的数据不变。"
	位于 错误
		分支 非法参数错误
			如果 已加入 则
				输出.文本 = "数据已加入，但当前无法绘制；饼图全为零时需再加入正数，或清空重来。"
			否则
				输出.文本 = "数值未加入：请输入有限数值文本；饼图不接受负数。"
			结束 如果
	结束 错误
结束 事件

事件 重建.被单击()
	构建当前()
	输出.文本 = "已按原数据重新构建，没有追加项目。"
	位于 错误
		分支 非法参数错误
			输出.文本 = "当前数据无法绘制；非空饼图至少需要一个正数。"
	结束 错误
结束 事件

事件 清空.被单击()
	初始化当前()
	构建当前()
	更新说明()
	输出.文本 = "初始化已清空当前图表，另外两份数据保留。"
结束 事件

事件 恢复.被单击()
	恢复全部()
结束 事件

''' 初始化接口同时设置样式和清空数据，因此切换配色时明确恢复初始项目。
事件 配色.被单击()
	深色 = 取反 深色
	恢复全部()
	如果 深色 则
		输出.文本 = "已切换深色图表并恢复初始数据，观察图中文字的对比度。"
	否则
		输出.文本 = "已切换浅色图表并恢复初始数据。"
	结束 如果
结束 事件

事件 正负.被单击()
	如果 当前 = 0 则
		输出.文本 = "饼图不能表示负数占比；请先切换柱图或折线图。"
		退出 事件
	结束 如果
	初始化当前()
	加入项目("周一", "-20")
	加入项目("周二", "0")
	加入项目("周三", "10")
	构建当前()
	更新说明()
	输出.文本 = "按添加顺序绘制 -20、0、10；横轴是项目序号，不是数值或日期轴。"
结束 事件

事件 单项.被单击()
	初始化当前()
	加入项目("单项", "20")
	构建当前()
	更新说明()
	输出.文本 = "只保留一项；饼图为整圆，折线图为一个数据点。"
结束 事件

事件 零值.被单击()
	初始化当前()
	加入项目("零值", "0")
	更新说明()
	构建当前()
	输出.文本 = "零值已加入；柱图和折线图保留零点。"
	位于 错误
		分支 非法参数错误
			输出.文本 = "饼图只有零值，无法计算占比；可追加正数，或清空当前图表。"
	结束 错误
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "AChartEngine 使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 23
			文本 = "三种单组数据图表"
			字体加粗 = 真
		$结束 $定义
		$定义 概况 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "饼状图；已加入 3 项"
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "正在准备初始数据。"
		$结束 $定义
		$定义 切换行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 看饼图 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "饼状图"
			$结束 $定义
			$定义 看柱图 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "柱状图"
			$结束 $定义
			$定义 看线图 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "折线图"
			$结束 $定义
		$结束 $定义
		$定义 图表区域 $为 面板
			宽度 = 长度_匹配父级
			高度 = "300dp"
			布局 = 布局_单帧
			$定义 饼图 $为 simple.library.wsd.achartengine.饼状图
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				可视 = 真
			$结束 $定义
			$定义 柱图 $为 simple.library.wsd.achartengine.柱状图
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				可视 = 假
			$结束 $定义
			$定义 线图 $为 simple.library.wsd.achartengine.折线图
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				可视 = 假
			$结束 $定义
		$结束 $定义
		$定义 数据说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "餐饮=15；交通=25；书籍=10"
		$结束 $定义
		$定义 输入行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 名称输入 $为 编辑框
				宽度 = 0
				权重 = 1
				单行模式 = 真
				提示文本 = "项目名称"
				文本 = "交通😀"
			$结束 $定义
			$定义 数值输入 $为 编辑框
				宽度 = 0
				权重 = 1
				单行模式 = 真
				提示文本 = "数值文本，例如 8.5"
				文本 = "8.5"
			$结束 $定义
		$结束 $定义
		$定义 追加行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 追加 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "追加到当前图表"
			$结束 $定义
			$定义 重建 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "重新构建（保留数据）"
			$结束 $定义
		$结束 $定义
		$定义 清理行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清空 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "清空当前"
			$结束 $定义
			$定义 恢复 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "恢复全部"
			$结束 $定义
		$结束 $定义
		$定义 数据行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 正负 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "正负数示例"
			$结束 $定义
			$定义 单项 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "单项示例"
			$结束 $定义
			$定义 零值 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "零值示例"
			$结束 $定义
		$结束 $定义
		$定义 配色行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 配色 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换配色并恢复初始数据"
			$结束 $定义
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "数值参数是文本，饼图只接受非负数且总和须大于零；柱图和折线图支持负数。追加后需要构建才会显示。"
		$结束 $定义
	$结束 $定义
$结束 $属性
