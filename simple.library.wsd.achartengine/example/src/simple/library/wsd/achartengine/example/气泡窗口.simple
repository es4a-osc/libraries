' 每个按钮直接演示一个操作，所有图表调用在界面线程执行。
变量 来源 为 主窗口

事件 气泡窗口.初始化()
	图表.初始化图表("气泡：位置与大小", 12, 颜色_白)
	图表.添加数值组("热度", 数组("0,1,3,5,8"), 数组("3,5,2,6,4"), 数组("1,3,0,5,4"), &HFF3086C8, 0)
	图表.构建图表()
结束 事件

事件 选择.被单击()
	图表.选择项目(0, 3, 真)
结束 事件

事件 更新.被单击()
	图表.更新数据组(0, 数组("0,1,3,5,8"), 数组("3,5,2,6,4,4,1,0,2,5"))
	图表.刷新图表()
	输出.文本 = "按整列拼接：前五项纵坐标，后五项大小。"
结束 事件

事件 数值.被单击()
	图表.显示数值 = 取反 图表.显示数值
结束 事件

事件 图表.项目被选中(数据组 为 整数型, 项目 为 整数型, 横坐标 为 双精度小数型, 数值 为 双精度小数型)
	输出.文本 = "组：" & 数据组 & "，项：" & 项目 & "，X：" & 横坐标 & "，值：" & 数值
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 气泡窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

函数 数组(文本 为 文本型) 为 双精度小数型()
	变量 项目 为 文本型()
	项目 = 分割文本(文本, ",")
	变量 数值 为 双精度小数型(取数组成员数(项目))
	变量 编号 为 整数型
	循环 编号 = 0 至 取数组成员数(项目) - 1
		数值(编号) = 到双精度小数(项目(编号))
	下个
	数组 = 数值
结束 函数

$属性
	$资源 $窗口
	$定义 气泡窗口 $为 窗口
		标题 = "气泡：位置与大小"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "返回目录"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "气泡：位置与大小"
			字体大小 = 21
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "纵坐标与大小分别传入。大小须非负，保留上游的最小气泡半径。"
			字体大小 = 13
		$结束 $定义
		$定义 图表 $为 simple.library.wsd.achartengine.ACE气泡图
			宽度 = 长度_匹配父级
			高度 = "280dp"
		$结束 $定义
		$定义 操作行8 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 选择 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "选择第四项"
				字体大小 = 13
			$结束 $定义
			$定义 更新 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "更新气泡大小"
				字体大小 = 13
			$结束 $定义
			$定义 数值 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "42dp"
				文本 = "数值开关"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点选适用于饼图和坐标图；项目编号从 0 开始。"
			字体大小 = 14
		$结束 $定义
	$结束 $定义
$结束 $属性
