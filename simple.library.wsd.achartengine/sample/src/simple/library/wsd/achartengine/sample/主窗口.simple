' 三种图表共用一组演示数据；操作图表必须在界面线程执行。
变量 项目数量 为 整数型

事件 主窗口.初始化()
	准备数据()
	显示图表(0)
	结果.文本 = "已绘制 3 个项目，可以切换三种图表。"
结束 事件

过程 初始化全部()
	饼图.初始化图表("分类占比", 14, 颜色_白)
	柱图.初始化图表("销售数量", "项目", "数量", 14, 颜色_白, &HFF3086C8)
	线图.初始化图表("数量趋势", "项目", "数量", 14, 颜色_白, &HFF269B68)
	项目数量 = 0
结束 过程

过程 添加项目(名称 为 文本型, 数据 为 文本型, 颜色 为 整数型)
	饼图.添加数据(名称, 数据, "件", 颜色)
	柱图.添加数据(名称, 数据, "件")
	线图.添加数据(名称, 数据, "件")
	项目数量 = 项目数量 + 1
结束 过程

过程 构建全部()
	饼图.构建图表()
	柱图.构建图表()
	线图.构建图表()
结束 过程

过程 准备数据()
	初始化全部()
	添加项目("甲", "15", &HFF3086C8)
	添加项目("乙", "25", &HFF269B68)
	添加项目("丙", "10", &HFFE9A13B)
	构建全部()
结束 过程

过程 显示图表(类型 为 整数型)
	饼图.可视 = 类型 = 0
	柱图.可视 = 类型 = 1
	线图.可视 = 类型 = 2
结束 过程

事件 显示饼图.被单击()
	显示图表(0)
结束 事件

事件 显示柱图.被单击()
	显示图表(1)
结束 事件

事件 显示线图.被单击()
	显示图表(2)
结束 事件

事件 追加.被单击()
	添加项目("新" & (项目数量 + 1), "20", &HFF9B59B6)
	构建全部()
	结果.文本 = "追加成功，请切换图表检查新项目。"
结束 事件

事件 重建.被单击()
	构建全部()
	构建全部()
	构建全部()
	结果.文本 = "已连续构建 3 次，请检查图形和刻度范围保持不变。"
结束 事件

事件 清空.被单击()
	初始化全部()
	构建全部()
	结果.文本 = "图表已清空，三个图表均无项目。"
结束 事件

事件 恢复.被单击()
	准备数据()
	结果.文本 = "已恢复 3 个项目。"
结束 事件

事件 边界.被单击()
	初始化全部()
	饼图.添加数据("单项", "1", "件", &HFF3086C8)
	柱图.添加数据("负数", "-20", "件")
	柱图.添加数据("零值", "0", "件")
	柱图.添加数据("正数", "10", "件")
	线图.添加数据("负数", "-20", "件")
	线图.添加数据("零值", "0", "件")
	线图.添加数据("正数", "10", "件")
	构建全部()
	显示图表(1)
	结果.文本 = "边界数据：饼图为单项；柱图和线图包含 -20、0、10。"
结束 事件

' 无效项目不会加入数据；错误处理后仍然可以构建已有数据。
函数 拒绝负数() 为 逻辑型
	饼图.添加数据("不应加入", "-1", "件", 颜色_黑)
	拒绝负数 = 假
	位于 错误
		分支 否则
			拒绝负数 = 真
	结束 错误
结束 函数

函数 拒绝文本() 为 逻辑型
	柱图.添加数据("不应加入", "abc", "件")
	拒绝文本 = 假
	位于 错误
		分支 否则
			拒绝文本 = 真
	结束 错误
结束 函数

事件 无效.被单击()
	变量 负数被拒绝 为 逻辑型
	变量 文本被拒绝 为 逻辑型
	负数被拒绝 = 拒绝负数()
	文本被拒绝 = 拒绝文本()
	断言真(负数被拒绝)
	断言真(文本被拒绝)
	构建全部()
	结果.文本 = "负数饼图和非数值文本均已拒绝，已有图表保持不变。"
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "AChartEngine图表库示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = 颜色_白
		$定义 说明 $为 标签
			文本 = "初始化 → 添加数据 → 构建图表；点击按钮切换图表。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 类型行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 显示饼图 $为 按钮
				文本 = "饼状图"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 显示柱图 $为 按钮
				文本 = "柱状图"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 显示线图 $为 按钮
				文本 = "折线图"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 数据行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 追加 $为 按钮
				文本 = "追加数据"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 重建 $为 按钮
				文本 = "重复构建"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 清理行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 清空 $为 按钮
				文本 = "清空图表"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 恢复 $为 按钮
				文本 = "恢复数据"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 检查行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 边界 $为 按钮
				文本 = "边界数据"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 无效 $为 按钮
				文本 = "无效数据"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 结果 $为 标签
			文本 = "等待绘制。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 饼图 $为 simple.library.wsd.achartengine.饼状图
			宽度 = 长度_匹配父级
			高度 = "320dp"
		$结束 $定义
		$定义 柱图 $为 simple.library.wsd.achartengine.柱状图
			宽度 = 长度_匹配父级
			高度 = "320dp"
			可视 = 假
		$结束 $定义
		$定义 线图 $为 simple.library.wsd.achartengine.折线图
			宽度 = 长度_匹配父级
			高度 = "320dp"
			可视 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
