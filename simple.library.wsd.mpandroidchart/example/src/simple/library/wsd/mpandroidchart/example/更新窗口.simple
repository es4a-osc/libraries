				文本 = "替换整组"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 删除 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "删除首项"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 行9 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 缩放 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "缩放两倍"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 复位 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "恢复全图"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 图片 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "导出PNG"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 行10 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 坐标 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "坐标换算"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 选择 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "显示数值标记"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 清空 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "清空数据"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "轻点图中数据可查看项目编号；编号从 0 开始。"
			字体大小 = 14
		$结束 $定义
	$结束 $定义
$结束 $属性
