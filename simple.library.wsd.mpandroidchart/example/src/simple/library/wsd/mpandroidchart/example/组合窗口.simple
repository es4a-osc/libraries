' 每个按钮直接演示一个操作，图表数据在初始化中准备。
变量 来源 为 主窗口

事件 组合窗口.初始化()
	图表.初始化图表("组合：五类数据同图", 12, 颜色_白)
	图表.动画时间 = 300
	图表.显示数值 = 假
	变量 顺序 为 整数型(5)
	顺序(0) = 0
	顺序(1) = 1
	顺序(2) = 3
	顺序(3) = 4
	顺序(4) = 2
	图表.设置绘制顺序(顺序)
	图表.设置项目名称(分割文本("周一,周二,周三,周四,周五", ","))
	图表.添加柱状组("柱", 数组("3,5,2,6,4"), &HFF3086C8, 0)
	图表.添加折线组("线", 数组("5,7,4,8,6"), &HFFE45D50, 0)
	图表.添加散点组("点", 数组("2,4,3,5,2"), &HFF9B59B6, 0)
	图表.添加气泡组("泡", 数组("7,9,6,10,8"), 数组("1,2,1,3,2"), &HFFE9A13B, 0)
	图表.添加蜡烛组("烛", 数组("3,5,4,6,5"), 数组("6,7,6,8,7"), 数组("2,3,2,4,3"), 数组("5,4,5,5,6"), &HFF269B68, 0)
	图表.构建图表()
结束 事件

事件 柱.被单击()
	图表.选择项目(0, 2, 真)
结束 事件

事件 线.被单击()
	图表.选择项目(1, 2, 真)
结束 事件

事件 烛.被单击()
	图表.选择项目(4, 2, 真)
结束 事件

事件 图表.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	输出.文本 = "数据组：" & 数据组 & "，项目：" & 项目 & "，数值：" & 数值
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 组合窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件


' 把简短的示例数据转成数组；业务代码也可以直接创建单精度数组。
函数 数组(文本 为 文本型) 为 单精度小数型()
	变量 项目 为 文本型()
	项目 = 分割文本(文本, ",")
	变量 数值 为 单精度小数型(取数组成员数(项目))
	变量 编号 为 整数型
	循环 编号 = 0 至 取数组成员数(项目) - 1
		数值(编号) = 到单精度小数(项目(编号))
	下个
	数组 = 数值
结束 函数

$属性
	$资源 $窗口
	$定义 组合窗口 $为 窗口
		标题 = "组合：五类数据同图"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "组合：五类数据同图"
			字体大小 = 21
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "组合图保留数据组添加顺序；事件编号与添加顺序一致，和内部绘制类型顺序无关。"
			字体大小 = 13
		$结束 $定义
		$定义 图表 $为 simple.library.wsd.mpandroidchart.MPAC组合图
			宽度 = 长度_匹配父级
			高度 = "280dp"
		$结束 $定义
		$定义 行8 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 柱 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "选择柱组"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 线 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "选择线组"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 烛 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "选择烛组"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "轻点图中数据可查看项目编号；编号从 0 开始。"
			字体大小 = 14
		$结束 $定义
	$结束 $定义
$结束 $属性
