' 每个按钮直接演示一个操作，图表数据在初始化中准备。
变量 来源 为 主窗口

事件 柱状窗口.初始化()
	图表.初始化图表("柱状：分组与正负堆叠", 12, 颜色_白)
	图表.动画时间 = 300
	准备堆叠()
	图表.构建图表()
结束 事件

过程 准备堆叠()
	图表.清空数据()
	图表.设置项目名称(分割文本("一月,二月,三月,四月", ","))
	图表.添加堆叠组("收支", 数组("3,5,4,6,-2,-3,-1,-2"), 2, &HFF3086C8, 0)
	变量 样式 为 MPAC数据组样式
	样式 = 创建 MPAC数据组样式
	变量 配色 为 整数型(2)
	配色(0) = &HFF3086C8
	配色(1) = &HFFE45D50
	样式.颜色集 = 配色
	样式.堆叠标签 = 分割文本("收入,支出", ",")
	图表.设置数据组样式(0, 样式)
结束 过程

事件 层.被单击()
	准备堆叠()
	图表.构建图表()
	图表.选择堆叠层(0, 1, 1, 真)
	变量 编号 为 整数型()
	编号 = 图表.取选中项目()
	输出.文本 = "已选数据组 " & 编号(0) & "，项目 " & 编号(1) & "，堆叠层 " & 编号(2)
结束 事件

事件 分组.被单击()
	图表.清空数据()
	图表.设置项目名称(分割文本("一月,二月,三月,四月", ","))
	图表.添加数据组("甲", 数组("3,5,4,6"), &HFF3086C8, 0)
	图表.添加数据组("乙", 数组("2,3,1,2"), &HFF269B68, 0)
	图表.设置柱布局(0.7, 0.05, 真)
	图表.构建图表()
	输出.文本 = "两组柱在每个分类内并排；横坐标仍对应原项目。"
结束 事件

事件 图例.被单击()
	变量 样式 为 MPAC图例样式
	样式 = 创建 MPAC图例样式
	样式.水平位置 = 1
	样式.图形形状 = 4
	图表.设置图例样式(样式)
	图表.刷新图表()
	输出.文本 = "图例居中显示，图例图形改为圆形。"
结束 事件

事件 图表.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	输出.文本 = "数据组：" & 数据组 & "，项目：" & 项目 & "，数值：" & 数值
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 柱状窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件


' 把简短的示例数据转成数组；业务代码也可以直接创建单精度数组。
函数 数组(文本 为 文本型) 为 单精度小数型()
	变量 项目 为 文本型()
	项目 = 分割文本(文本, ",")
	变量 数值 为 单精度小数型(取数组成员数(项目))
	变量 编号 为 整数型
	循环 编号 = 0 至 取数组成员数(项目) - 1
		数值(编号) = 到单精度小数(项目(编号))
	下个
	数组 = 数值
结束 函数

$属性
	$资源 $窗口
	$定义 柱状窗口 $为 窗口
		标题 = "柱状：分组与正负堆叠"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "柱状：分组与正负堆叠"
			字体大小 = 21
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "堆叠数组按整层拼接：先收入层，再支出层；可以选择具体的层。"
			字体大小 = 13
		$结束 $定义
		$定义 图表 $为 simple.library.wsd.mpandroidchart.MPAC柱状图
			宽度 = 长度_匹配父级
			高度 = "280dp"
		$结束 $定义
		$定义 行8 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 层 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "选择负数层"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 分组 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "改为并排柱"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 图例 $为 按钮
				宽度 = 长度_匹配父级
				高度 = "42dp"
				文本 = "自定义图例"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			文本 = "轻点图中数据可查看项目编号；编号从 0 开始。"
			字体大小 = 14
		$结束 $定义
	$结束 $定义
$结束 $属性
