''' 数据组、左右轴和组合图参考上游官方示例，并按当前分类索引接口组织数据。
''' https://github.com/PhilJay/MPAndroidChart/wiki/Setting-Data
''' 图表必须在界面线程操作；这里用短小固定数据展示九类图形。
变量 图表列表 为 simple.library.wsd.mpandroidchart.图表(9)
变量 坐标列表 为 simple.library.wsd.mpandroidchart.坐标图表(9)
变量 当前图表 为 simple.library.wsd.mpandroidchart.图表
变量 当前坐标 为 simple.library.wsd.mpandroidchart.坐标图表
变量 当前编号 为 整数型
变量 图名 为 文本型()

事件 主窗口.初始化()
	图名 = 分割文本("折线图,柱状图,横向柱状图,饼状图,散点图,气泡图,雷达图,蜡烛图,组合图", ",")
	图表列表(0) = 线图
	图表列表(1) = 柱图
	图表列表(2) = 横图
	图表列表(3) = 饼图
	图表列表(4) = 散图
	图表列表(5) = 泡图
	图表列表(6) = 雷图
	图表列表(7) = 烛图
	图表列表(8) = 组图
	坐标列表(0) = 线图
	坐标列表(1) = 柱图
	坐标列表(2) = 横图
	坐标列表(4) = 散图
	坐标列表(5) = 泡图
	坐标列表(7) = 烛图
	坐标列表(8) = 组图
	准备数据()
	显示图表(0)
结束 事件

''' 先初始化，再设置分类名称、添加等长数据组，最后统一构建；双轴折线两组分别绑定左右轴。
过程 准备数据()
	变量 编号 为 整数型
	变量 图表 为 simple.library.wsd.mpandroidchart.图表
	循环 编号 = 0 至 8
		图表 = 图表列表(编号)
		图表.初始化图表("MPAndroidChart", 12, 颜色_白)
		图表.动画时间 = 300
		图表.显示图例 = 真
		图表.显示数值 = 真
	下个
	变量 名称 为 文本型()
	名称 = 分割文本("周一,周二,周三,周四,周五", ",")
	线图.设置项目名称(名称)
	柱图.设置项目名称(名称)
	横图.设置项目名称(名称)
	散图.设置项目名称(名称)
	泡图.设置项目名称(名称)
	雷图.设置项目名称(名称)
	烛图.设置项目名称(名称)
	组图.设置项目名称(名称)
	线图.添加数据组("高温", 数组("26,27,25,29,28"), &HFFE45D50, 0)
	线图.添加数据组("低温", 数组("16,17,15,18,17"), &HFF3086C8, 1)
	线图.设置纵轴范围(0, 23, 31)
	线图.设置纵轴范围(1, 13, 21)
	柱图.添加数据组("甲", 数组("3,5,2,6,4"), &HFF3086C8, 0)
	柱图.添加数据组("乙", 数组("2,4,3,2,5"), &HFF269B68, 1)
	柱图.设置纵轴范围(1, 0, 10)
	横图.添加数据组("甲", 数组("3,5,2,6,4"), &HFF3086C8, 0)
	横图.添加数据组("乙", 数组("2,4,3,2,5"), &HFF269B68, 0)
	饼图.添加数据("甲", 15, &HFF3086C8)
	饼图.添加数据("乙", 25, &HFF269B68)
	饼图.添加数据("丙", 10, &HFFE9A13B)
	散图.添加数据组("采样", 数组("-2,3,0,6,4"), &HFF9B59B6, 0)
	泡图.添加数据组("热度", 数组("3,5,2,6,4"), 数组("1,3,2,5,4"), &HFF3086C8, 0)
	雷图.添加数据组("甲", 数组("3,5,2,6,4"), &HFF3086C8)
	雷图.添加数据组("乙", 数组("2,4,3,2,5"), &HFFE45D50)
	烛图.添加数据组("价格", 数组("3,5,4,6,5"), 数组("6,7,6,8,7"), 数组("2,3,2,4,3"), 数组("5,4,5,5,6"), &HFF269B68, 0)
	组图.添加柱状组("数量", 数组("3,5,2,6,4"), &HFF3086C8, 0)
	组图.添加折线组("趋势", 数组("4,6,3,7,5"), &HFFE45D50, 0)
	组图.添加散点组("采样", 数组("2,4,1,5,3"), &HFF9B59B6, 0)
	组图.添加气泡组("热度", 数组("7,6,8,5,7"), 数组("1,2,1,2,1"), &HFFE9A13B, 0)
	组图.添加蜡烛组("价格", 数组("3,5,4,6,5"), 数组("6,7,6,8,7"), 数组("2,3,2,4,3"), 数组("5,4,5,5,6"), &HFF269B68, 0)
	线图.平滑曲线 = 假
	组图.平滑曲线 = 假
	循环 编号 = 0 至 8
		图表 = 图表列表(编号)
		图表.构建图表()
	下个
结束 过程

''' 实际项目可直接传入单精度数组；这里把短文本转换为示例数值。
函数 数组(文本 为 文本型) 为 单精度小数型()
	变量 项目 为 文本型()
	项目 = 分割文本(文本, ",")
	变量 数值 为 单精度小数型(取数组成员数(项目))
	变量 编号 为 整数型
	循环 编号 = 0 至 取数组成员数(项目) - 1
		数值(编号) = 到单精度小数(项目(编号))
	下个
	数组 = 数值
结束 函数

过程 显示图表(编号 为 整数型)
	变量 索引 为 整数型
	变量 项 为 simple.library.wsd.mpandroidchart.图表
	循环 索引 = 0 至 8
		项 = 图表列表(索引)
		项.可视 = 索引 = 编号
	下个 索引
	当前编号 = 编号
	当前图表 = 图表列表(编号)
	当前坐标 = 坐标列表(编号)
	拖动开关.启用 = 当前坐标 <> 空
	缩放开关.启用 = 当前坐标 <> 空
	平滑开关.启用 = 编号 = 0 或 编号 = 8
	更新说明()
	输出.文本 = "点击图上数据查看组号、项目索引和实际数值；编号均从 0 开始。"
结束 过程

过程 更新说明()
	状态.文本 = (当前编号 + 1) & "/9 " & 图名(当前编号) & "；组=" & 当前图表.数据组数量 & "，项=" & 当前图表.项目数量
	开关状态.文本 = "图例=" & 当前图表.显示图例 & "；数值=" & 当前图表.显示数值
	如果 当前坐标 <> 空 则 开关状态.文本 = 开关状态.文本 & "；缩放=" & 当前坐标.可否缩放 & "；拖动=" & 当前坐标.可否拖动
	如果 当前编号 = 0 则 开关状态.文本 = 开关状态.文本 & "；平滑=" & 线图.平滑曲线
	如果 当前编号 = 8 则 开关状态.文本 = 开关状态.文本 & "；平滑=" & 组图.平滑曲线
结束 过程

事件 上一图.被单击()
	如果 当前编号 = 0 则
		显示图表(8)
	否则
		显示图表(当前编号 - 1)
	结束 如果
结束 事件

事件 下一图.被单击()
	如果 当前编号 = 8 则
		显示图表(0)
	否则
		显示图表(当前编号 + 1)
	结束 如果
结束 事件

事件 恢复数据.被单击()
	准备数据()
	显示图表(当前编号)
	输出.文本 = "已恢复九类图表的原始数据。"
结束 事件

事件 重建图形.被单击()
	当前图表.构建图表()
	更新说明()
	输出.文本 = "已按当前数据重新构建；未追加数据组。"
结束 事件

事件 清空当前.被单击()
	当前图表.清空数据()
	当前图表.构建图表()
	更新说明()
	输出.文本 = "已清空当前图表；可点恢复数据重新开始。"
结束 事件

事件 图例开关.被单击()
	当前图表.显示图例 = 取反 当前图表.显示图例
	当前图表.构建图表()
	更新说明()
结束 事件

事件 数值开关.被单击()
	当前图表.显示数值 = 取反 当前图表.显示数值
	当前图表.构建图表()
	更新说明()
结束 事件

事件 平滑开关.被单击()
	如果 当前编号 = 0 则
		线图.平滑曲线 = 取反 线图.平滑曲线
	否则
		组图.平滑曲线 = 取反 组图.平滑曲线
	结束 如果
	当前图表.构建图表()
	更新说明()
结束 事件

事件 缩放开关.被单击()
	如果 当前坐标 <> 空 则 当前坐标.可否缩放 = 取反 当前坐标.可否缩放
	更新说明()
结束 事件

事件 拖动开关.被单击()
	如果 当前坐标 <> 空 则 当前坐标.可否拖动 = 取反 当前坐标.可否拖动
	更新说明()
结束 事件

''' 非负限制由库校验；只有捕获实际错误后才显示已拒绝，并读取剩余扇区数。
事件 无效数据.被单击()
	显示图表(3)
	饼图.添加数据("错误的负数", -1, 颜色_黑)
	输出.文本 = "已返回，请检查饼图数据。"
	位于 错误
		分支 非法参数错误
			更新说明()
			输出.文本 = "已拒绝负数；现有扇区数=" & 饼图.项目数量 & "。可继续选择或恢复数据。"
	结束 错误
结束 事件

过程 显示选择(来源 为 文本型, 数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	输出.文本 = 来源 & "选中：组=" & 数据组 & "；项目=" & 项目 & "；数值=" & 数值
结束 过程

事件 线图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("折线图", 数据组, 项目, 数值)
结束 事件

事件 线图.选择被取消()
	输出.文本 = "折线图：选择已取消。"
结束 事件

事件 柱图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("柱状图", 数据组, 项目, 数值)
结束 事件

事件 柱图.选择被取消()
	输出.文本 = "柱状图：选择已取消。"
结束 事件

事件 横图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("横向柱状图", 数据组, 项目, 数值)
结束 事件

事件 横图.选择被取消()
	输出.文本 = "横向柱状图：选择已取消。"
结束 事件

事件 饼图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("饼状图", 数据组, 项目, 数值)
结束 事件

事件 饼图.选择被取消()
	输出.文本 = "饼状图：选择已取消。"
结束 事件

事件 散图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("散点图", 数据组, 项目, 数值)
结束 事件

事件 散图.选择被取消()
	输出.文本 = "散点图：选择已取消。"
结束 事件

事件 泡图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("气泡图", 数据组, 项目, 数值)
结束 事件

事件 泡图.选择被取消()
	输出.文本 = "气泡图：选择已取消。"
结束 事件

事件 雷图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("雷达图", 数据组, 项目, 数值)
结束 事件

事件 雷图.选择被取消()
	输出.文本 = "雷达图：选择已取消。"
结束 事件

事件 烛图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("蜡烛图", 数据组, 项目, 数值)
结束 事件

事件 烛图.选择被取消()
	输出.文本 = "蜡烛图：选择已取消。"
结束 事件

事件 组图.项目被选中(数据组 为 整数型, 项目 为 整数型, 数值 为 单精度小数型)
	显示选择("组合图", 数据组, 项目, 数值)
结束 事件

事件 组图.选择被取消()
	输出.文本 = "组合图：选择已取消。"
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "MPAndroidChart 使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "九类图表与交互"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "分类横轴按数组索引排列；饼图和雷达数值非负，蜡烛参数顺序为开、高、低、收。"
		$结束 $定义
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 上一图 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "上一种"
			$结束 $定义
			$定义 下一图 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "下一种"
			$结束 $定义
			$定义 恢复数据 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "恢复数据"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "正在准备图表。"
			字体加粗 = 真
		$结束 $定义
		$定义 线图 $为 simple.library.wsd.mpandroidchart.折线图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 真
		$结束 $定义
		$定义 柱图 $为 simple.library.wsd.mpandroidchart.柱状图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 横图 $为 simple.library.wsd.mpandroidchart.横向柱状图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 饼图 $为 simple.library.wsd.mpandroidchart.饼状图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 散图 $为 simple.library.wsd.mpandroidchart.散点图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 泡图 $为 simple.library.wsd.mpandroidchart.气泡图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 雷图 $为 simple.library.wsd.mpandroidchart.雷达图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 烛图 $为 simple.library.wsd.mpandroidchart.蜡烛图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 组图 $为 simple.library.wsd.mpandroidchart.组合图
			宽度 = 长度_匹配父级
			高度 = "280dp"
			可视 = 假
		$结束 $定义
		$定义 显示选项 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 图例开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "图例开关"
			$结束 $定义
			$定义 数值开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "数值开关"
			$结束 $定义
			$定义 平滑开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "平滑曲线"
			$结束 $定义
		$结束 $定义
		$定义 交互选项 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 缩放开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "缩放开关"
			$结束 $定义
			$定义 拖动开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "拖动开关"
			$结束 $定义
			$定义 重建图形 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "重新构建"
			$结束 $定义
		$结束 $定义
		$定义 数据选项 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清空当前 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清空当前"
			$结束 $定义
			$定义 无效数据 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "负数饼图演示"
			$结束 $定义
		$结束 $定义
		$定义 开关状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = ""
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = ""
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "坐标图可双击、双指缩放后拖动；饼图和雷达可旋转。蜡烛选择事件返回收盘值，气泡数值标注表示大小。"
		$结束 $定义
	$结束 $定义
$结束 $属性
