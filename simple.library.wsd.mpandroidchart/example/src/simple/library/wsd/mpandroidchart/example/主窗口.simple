' 集中声明类库别名，按图形和数据更新功能分窗。
别名 MPAC图表样式 = simple.library.wsd.mpandroidchart.MPAC图表样式
别名 MPAC图例样式 = simple.library.wsd.mpandroidchart.MPAC图例样式
别名 MPAC数据组样式 = simple.library.wsd.mpandroidchart.MPAC数据组样式
别名 MPAC轴样式 = simple.library.wsd.mpandroidchart.MPAC轴样式
别名 MPAC限制线 = simple.library.wsd.mpandroidchart.MPAC限制线
别名 MPAC饼图样式 = simple.library.wsd.mpandroidchart.MPAC饼图样式
别名 MPAC雷达样式 = simple.library.wsd.mpandroidchart.MPAC雷达样式

事件 入口1.被单击()
	变量 页面 为 折线窗口
	页面 = 创建 折线窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口2.被单击()
	变量 页面 为 柱状窗口
	页面 = 创建 柱状窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口3.被单击()
	变量 页面 为 横柱窗口
	页面 = 创建 横柱窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口4.被单击()
	变量 页面 为 饼状窗口
	页面 = 创建 饼状窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口5.被单击()
	变量 页面 为 散点窗口
	页面 = 创建 散点窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口6.被单击()
	变量 页面 为 气泡窗口
	页面 = 创建 气泡窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口7.被单击()
	变量 页面 为 雷达窗口
	页面 = 创建 雷达窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口8.被单击()
	变量 页面 为 蜡烛窗口
	页面 = 创建 蜡烛窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口9.被单击()
	变量 页面 为 组合窗口
	页面 = 创建 组合窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

事件 入口10.被单击()
	变量 页面 为 更新窗口
	页面 = 创建 更新窗口
	页面.来源 = 主窗口
	切换窗口(页面)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "MPAC图表入门示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "MPAC图表入门示例"
			字体大小 = 24
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "每页对应一个窗口源码，每个按钮直接展示一种用法。需要 Android 7.0 及以上。"
			字体大小 = 14
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "1. 折线：双轴、格式与限制线"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "2. 柱状：分组与正负堆叠"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "3. 横向柱：分类与负数"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "4. 饼状：圆孔与百分比"
		$结束 $定义
		$定义 入口5 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "5. 散点：任意数值横坐标"
		$结束 $定义
		$定义 入口6 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "6. 气泡：数值与大小"
		$结束 $定义
		$定义 入口7 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "7. 雷达：填充与网格"
		$结束 $定义
		$定义 入口8 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "8. 蜡烛：开高低收"
		$结束 $定义
		$定义 入口9 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "9. 组合：五类数据同图"
		$结束 $定义
		$定义 入口10 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "10. 数据更新、视图与图片"
		$结束 $定义
	$结束 $定义
$结束 $属性
