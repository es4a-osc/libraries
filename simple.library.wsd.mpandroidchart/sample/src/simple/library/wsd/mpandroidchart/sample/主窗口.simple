$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "MPAndroidChart图表库示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = 颜色_白
		$定义 操作行0 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 显示线图 $为 按钮
				文本 = "折线图"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 显示柱图 $为 按钮
				文本 = "柱状图"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 显示横图 $为 按钮
				文本 = "横向柱状图"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
