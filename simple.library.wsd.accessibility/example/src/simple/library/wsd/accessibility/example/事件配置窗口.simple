别名 无障碍事件 = simple.library.wsd.accessibility.无障碍事件
别名 无障碍常量 = simple.library.wsd.accessibility.无障碍常量
别名 无障碍服务信息 = simple.library.wsd.accessibility.无障碍服务信息
别名 无障碍节点 = simple.library.wsd.accessibility.无障碍节点

变量 来源 为 主窗口

变量 事件数量 为 整数型
变量 最近事件 为 无障碍事件
变量 按键次数 为 整数型
变量 最近键码 为 整数型
变量 最近动作 为 整数型

''' 回调事件只在当前回调有效；需要保留时先复制，并释放上一份副本。
事件 辅助.收到事件(数据 为 无障碍事件)
	事件数量 = 事件数量 + 1
	如果 数据.事件类型 = 无障碍常量.事件_单击 则
		如果 最近事件 <> 空 则 最近事件.释放()
		最近事件 = 数据.复制事件()
	结束 如果
结束 事件

事件 读事件.被单击()
	结果.文本 = "已收到事件数：" & 事件数量
	如果 最近事件 <> 空 则
		结果.文本 = 结果.文本 & "；最近单击来源：" & 最近事件.包名 & "；时间：" & 最近事件.时间
	结束 如果
	结果.文本 = 结果.文本 & "；按键回调次数：" & 按键次数 & "；最近键码/动作：" & 最近键码 & "/" & 最近动作
结束 事件

事件 辅助.收到按键(键码 为 整数型, 动作 为 整数型, 传址 消费 为 逻辑型)
	按键次数 = 按键次数 + 1
	最近键码 = 键码
	最近动作 = 动作
	' 仅观察，不拦截系统按键。
	消费 = 假
结束 事件

事件 读配置.被单击()
	变量 配置 为 无障碍服务信息
	配置 = 辅助.取服务信息()
	如果 配置 = 空 则
		状态.文本 = "服务未连接，无法读取配置。"
	否则
		结果.文本 = "服务：" & 配置.编号 & "；能力：" & 配置.能力 & "；事件掩码：" & 配置.事件类型 & "；通知间隔：" & 配置.通知间隔
		' 重新提交当前快照，演示动态配置，不改变监听范围。
		状态.文本 = "当前配置提交：" & 辅助.应用配置(配置)
	结束 如果
结束 事件

事件 切换监听.被单击()
	辅助.事件监听 = 取反 辅助.事件监听
	状态.文本 = "事件监听：" & 辅助.事件监听 & "；关闭监听仍可主动读取节点。"
结束 事件

事件 跨页.被单击()
	如果 辅助.已连接 且 辅助.打开设置() 则
		延时读取.启用 = 真
	结束 如果
结束 事件

事件 延时读取.计时()
	延时读取.启用 = 假
	变量 根 为 无障碍节点
	根 = 辅助.取根节点()
	如果 根 <> 空 则
		结果.文本 = "延时读取的活动窗口包名：" & 根.包名 & "；直接子节点：" & 根.子节点数
		根.释放()
	结束 如果
结束 事件

事件 辅助.连接改变(已连接 为 逻辑型)
	状态.文本 = "服务连接改变：" & 已连接
结束 事件

过程 释放事件副本()
	如果 最近事件 <> 空 则
		最近事件.释放()
		最近事件 = 空
	结束 如果
结束 过程

事件 事件配置窗口.切换完毕()
	辅助.事件监听 = 真
	状态.文本 = "本页事件监听已打开；服务已连接：" & 辅助.已连接
结束 事件

事件 事件配置窗口.即将切换()
	辅助.事件监听 = 假
	延时读取.启用 = 假
	释放事件副本()
结束 事件

事件 事件配置窗口.应用被销毁()
	释放事件副本()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 事件配置窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 事件配置窗口 $为 窗口
		标题 = "事件与配置"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "事件与配置"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作本页按钮或音量键后点“查看事件”；可暂停监听、读取并提交原配置，或延时读取系统设置页。"
		$结束 $定义
		$定义 事件操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 读事件 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "查看事件"
			$结束 $定义
			$定义 切换监听 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "切换事件监听"
			$结束 $定义
		$结束 $定义
		$定义 读配置 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "读取与提交配置"
		$结束 $定义
		$定义 跨页 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "打开设置，3 秒后读取窗口"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "请先在目录页启用服务并检查连接。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "进入本页开启监听，离开时暂停并释放事件副本；按键回调不消费按键。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 辅助 $为 simple.library.wsd.accessibility.无障碍服务
			事件监听 = 假
		$结束 $定义
		$定义 延时读取 $为 计时器
			间隔 = 3000
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
