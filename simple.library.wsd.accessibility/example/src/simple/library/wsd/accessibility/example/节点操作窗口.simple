别名 无障碍节点 = simple.library.wsd.accessibility.无障碍节点
别名 无障碍节点列表 = simple.library.wsd.accessibility.无障碍节点列表
别名 无障碍动作参数 = simple.library.wsd.accessibility.无障碍动作参数
别名 无障碍常量 = simple.library.wsd.accessibility.无障碍常量
别名 无障碍窗口列表 = simple.library.wsd.accessibility.无障碍窗口列表
别名 无障碍窗口 = simple.library.wsd.accessibility.无障碍窗口

变量 来源 为 主窗口

变量 实际点击 为 整数型

''' 列表和取出的项目分别持有节点；释放列表不影响已取出的项目。

函数 查找演示节点(文本 为 文本型) 为 无障碍节点
	变量 根 为 无障碍节点
	根 = 辅助.取根节点()
	如果 根 = 空 则
		状态.文本 = "没有活动根节点，请先检查服务连接。"
		退出 函数
	结束 如果
	变量 结果 为 无障碍节点列表
	结果 = 根.按文本查找(文本)
	根.释放()
	如果 结果.数量 = 1 则
		查找演示节点 = 结果.取项目(0)
	否则
		状态.文本 = "未找到唯一演示节点，请回到本页重试。"
	结束 如果
	结果.释放()
结束 函数

事件 演示目标.被单击()
	实际点击 = 实际点击 + 1
	反馈.文本 = "目标实际点击次数：" & 实际点击
结束 事件

事件 节点单击.被单击()
	变量 节点 为 无障碍节点
	节点 = 查找演示节点("目标：点我")
	如果 节点 <> 空 则
		状态.文本 = "节点接受点击：" & 节点.单击() & "；请核对实际点击次数。"
		节点.释放()
	结束 如果
结束 事件

事件 填写.被单击()
	变量 节点 为 无障碍节点
	节点 = 查找演示节点(演示输入.文本)
	如果 节点 <> 空 则
		状态.文本 = "设置文本被接受：" & 节点.设置文本("通过节点输入的新内容")
		节点.释放()
	结束 如果
结束 事件

事件 选择文字.被单击()
	变量 节点 为 无障碍节点
	节点 = 查找演示节点(演示输入.文本)
	如果 节点 <> 空 则
		变量 参数 为 无障碍动作参数
		参数 = 创建 无障碍动作参数
		参数.设置选择区(0, 2)
		状态.文本 = "选择前两个字符被接受：" & 节点.带参执行动作(无障碍常量.节点动作_选择文本, 参数)
		节点.释放()
	结束 如果
结束 事件

事件 读窗口.被单击()
	变量 列表 为 无障碍窗口列表
	列表 = 辅助.取窗口列表()
	结果.文本 = "可交互窗口数：" & 列表.数量
	如果 列表.数量 > 0 则
		变量 窗口信息 为 无障碍窗口
		窗口信息 = 列表.取项目(0)
		列表.释放()
		结果.文本 = 结果.文本 & "；首个窗口类型：" & 窗口信息.类型 & "；标题：" & 窗口信息.标题
		窗口信息.释放()
	否则
		列表.释放()
	结束 如果
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 节点操作窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 节点操作窗口 $为 窗口
		标题 = "节点与窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "节点与窗口"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "先点“节点单击”核对计数，再设置输入框文本、选择前两字，最后读取系统窗口。"
		$结束 $定义
		$定义 演示目标 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "目标：点我"
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "目标实际点击次数：0"
		$结束 $定义
		$定义 演示输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "待替换的示例文字"
		$结束 $定义
		$定义 节点动作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 节点单击 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "节点单击"
			$结束 $定义
			$定义 读窗口 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "读取窗口"
			$结束 $定义
		$结束 $定义
		$定义 文字动作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 填写 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "设置文本"
			$结束 $定义
			$定义 选择文字 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "选择前两字"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "请先在目录页启用服务并检查连接。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "节点、列表和窗口用完后分别释放；本页只主动查询，不订阅事件。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 辅助 $为 simple.library.wsd.accessibility.无障碍服务
			事件监听 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
