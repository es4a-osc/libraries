''' 主窗口只管理授权和主题导航；具体用法放在对应窗口中。

变量 节点页 为 节点操作窗口
变量 事件页 为 事件配置窗口
变量 手势页 为 手势窗口
变量 系统页 为 系统能力窗口
变量 通知页 为 通知监听窗口

事件 授权.被单击()
	如果 辅助.打开设置() 则
		状态.文本 = "请手动启用本应用服务，再返回检查连接。"
	否则
		状态.文本 = "系统没有提供无障碍设置页面。"
	结束 如果
结束 事件

事件 检查.被单击()
	状态.文本 = "已启用：" & 辅助.已启用 & "；已连接：" & 辅助.已连接
结束 事件

事件 停用.被单击()
	状态.文本 = "已提交禁用请求：" & 辅助.禁用服务() & "；重新使用需手动启用。"
结束 事件

事件 节点入口.被单击()
	如果 节点页 = 空 则
		节点页 = 创建 节点操作窗口
		节点页.来源 = 主窗口
	结束 如果
	切换窗口(节点页)
结束 事件

事件 事件入口.被单击()
	如果 事件页 = 空 则
		事件页 = 创建 事件配置窗口
		事件页.来源 = 主窗口
	结束 如果
	切换窗口(事件页)
结束 事件

事件 手势入口.被单击()
	如果 手势页 = 空 则
		手势页 = 创建 手势窗口
		手势页.来源 = 主窗口
	结束 如果
	切换窗口(手势页)
结束 事件

事件 系统入口.被单击()
	如果 系统页 = 空 则
		系统页 = 创建 系统能力窗口
		系统页.来源 = 主窗口
	结束 如果
	切换窗口(系统页)
结束 事件

事件 通知入口.被单击()
	如果 通知页 = 空 则
		通知页 = 创建 通知监听窗口
		通知页.来源 = 主窗口
	结束 如果
	切换窗口(通知页)
结束 事件

事件 主窗口.切换完毕()
	状态.文本 = "已启用：" & 辅助.已启用 & "；已连接：" & 辅助.已连接
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		终止()
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "无障碍服务示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "无障碍服务示例"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "先在系统设置中手动启用本应用的无障碍服务，返回检查连接，再选择一个主题。每页的界面与演示代码独立。"
		$结束 $定义
		$定义 授权操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 授权 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "打开无障碍设置"
			$结束 $定义
			$定义 检查 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "检查连接"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "服务尚未检查。"
		$结束 $定义
		$定义 节点入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "节点与窗口：查询、点击、文本动作"
		$结束 $定义
		$定义 事件入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "事件与配置：回调、快照、跨页读取"
		$结束 $定义
		$定义 手势入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "屏幕手势：坐标、派发与完成回调"
		$结束 $定义
		$定义 系统入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "系统能力：放大、软键盘与字幕"
		$结束 $定义
		$定义 通知入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "通知监听：接收、发送与内容操作"
		$结束 $定义
		$定义 停用 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "体验结束：禁用本应用服务"
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "按返回键从主题页回到目录，在目录页退出应用。退出应用不会撤销系统授权，用完请禁用服务。"
		$结束 $定义
		$定义 辅助 $为 simple.library.wsd.accessibility.无障碍服务
			事件监听 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
