''' 参考 Android 无障碍服务的读取节点与执行节点动作场景。
''' https://developer.android.com/guide/topics/ui/accessibility/service
''' 先在系统设置手动启用本应用服务；设置启用与服务实际连接分别判断。
变量 点击次数 为 整数型
变量 长按次数 为 整数型
变量 监听点击 为 整数型
变量 监听长按 为 整数型
变量 监听滚动 为 整数型
变量 最近窗口 为 文本型

事件 打开授权.被单击()
	如果 辅助.打开设置() 则
		状态.文本 = "请手动启用“跨程序辅助使用示例”，返回本页后检查连接。"
	否则
		状态.文本 = "无法打开系统无障碍设置。"
	结束 如果
结束 事件

''' 每次重新取得当前根节点，不保留跨窗口的旧节点引用。
事件 读取窗口.被单击()
	如果 辅助.是否已开启() = 假 则
		状态.文本 = "服务尚未在系统设置中启用。"
		退出 事件
	结束 如果
	记录活动窗口()
结束 事件

''' 当前编译器尚未完整处理通用“对象”转回具体 Java 类型的转换；
''' 节点或列表先存入“对象”变量，再传给要求具体类型的方法，可能导致 APK 加载时 VerifyError。
''' 本示例沿用既有测试的直接嵌套调用，保留节点和列表的具体类型；编译器问题另行修复。
过程 记录活动窗口()
	如果 辅助.取根控件() = 空 则
		状态.文本 = "服务已启用，但尚无活动根节点；请等待连接后重试。"
		退出 过程
	结束 如果
	窗口记录.文本 = "窗口类名：" & 辅助.取当前类名() & "；根的直接子节点数：" & 辅助.取子控件数(辅助.取根控件())
	状态.文本 = "已取得当前活动窗口根节点。"
结束 过程

''' 只返回唯一性判断，节点和列表保持在类库方法的具体类型返回值中。
''' 检查后立即重新查找再操作；界面仍可能变化，以动作返回值和实际界面结果为准。
函数 有唯一演示节点(文字 为 文本型) 为 逻辑型
	' 清除上一轮 JSON 中回显的目标文字，避免结果标签也被计入匹配节点。
	窗口记录.文本 = ""
	有唯一演示节点 = 辅助.取控件集合项目数(辅助.按文本查找控件(文字)) = 1
结束 函数

事件 触发目标.被单击()
	如果 有唯一演示节点("示例目标：点我") = 假 则
		状态.文本 = "未找到唯一演示按钮，请检查服务连接并回到本页。"
		退出 事件
	结束 如果
	如果 辅助.单击控件(辅助.取控件(0, 辅助.按文本查找控件("示例目标：点我"))) 则
		状态.文本 = "目标节点接受点击；请同时观察下方实际点击次数。"
	否则
		状态.文本 = "目标节点未接受点击，请重新读取当前界面。"
	结束 如果
结束 事件

事件 填写字段.被单击()
	如果 演示输入.文本 = "" 则
		状态.文本 = "请先在演示输入框填写一段唯一文字，再尝试按节点设置。"
		退出 事件
	结束 如果
	如果 有唯一演示节点(演示输入.文本) = 假 则
		状态.文本 = "未找到唯一输入节点，请检查服务或输入内容。"
		退出 事件
	结束 如果
	如果 辅助.置控件内容(辅助.取控件(0, 辅助.按文本查找控件(演示输入.文本)), "已通过节点填写") 则
		状态.文本 = "节点接受设置文本；请核对编辑框中的实际内容。"
	否则
		状态.文本 = "节点未接受设置文本，请检查其可编辑状态。"
	结束 如果
结束 事件

''' 只显示演示目标的节点 JSON，不批量收集其它应用的界面文本。
事件 查看节点.被单击()
	如果 有唯一演示节点("示例目标：点我") = 假 则
		窗口记录.文本 = "没有唯一的演示目标节点。"
	否则
		窗口记录.文本 = 辅助.取控件信息(辅助.取控件(0, 辅助.按文本查找控件("示例目标：点我")))
	结束 如果
结束 事件

''' 只在按钮请求时显示计数；内容变化回调里改界面可能造成反馈循环。
事件 查看事件.被单击()
	窗口记录.文本 = "监听点击：" & 监听点击 & "；长按：" & 监听长按 & "；滚动：" & 监听滚动 & "；最近窗口：" & 最近窗口
结束 事件

''' 延时取得系统设置页的根节点，只记录类名和子节点数，不执行设置页控件动作。
事件 跨页读取.被单击()
	如果 辅助.是否已开启() = 假 则
		状态.文本 = "请先启用服务，再体验跨窗口读取。"
		退出 事件
	结束 如果
	如果 辅助.打开设置() 则
		窗口记录.文本 = "三秒后读取当前系统设置页；完成后请按返回键回本示例。"
		延时读取.启用 = 真
	否则
		状态.文本 = "无法打开系统设置，未开始读取。"
	结束 如果
结束 事件

事件 延时读取.计时()
	延时读取.启用 = 假
	记录活动窗口()
结束 事件

事件 演示目标.被单击()
	点击次数 = 点击次数 + 1
	目标反馈.文本 = "目标实际点击：" & 点击次数 & "；长按：" & 长按次数
结束 事件

事件 演示目标.被长按()
	长按次数 = 长按次数 + 1
	目标反馈.文本 = "目标实际点击：" & 点击次数 & "；长按：" & 长按次数
结束 事件

事件 辅助.控件被单击()
	监听点击 = 监听点击 + 1
结束 事件

事件 辅助.控件被长按()
	监听长按 = 监听长按 + 1
结束 事件

事件 辅助.控件被滑动()
	监听滚动 = 监听滚动 + 1
结束 事件

事件 辅助.窗口被切换()
	最近窗口 = 辅助.取当前类名()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		延时读取.启用 = 假
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "跨程序辅助使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "无障碍节点操作"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 16
			文本 = "先在系统设置手动启用本应用服务，再返回检查连接。节点操作受目标界面支持情况限制。"
		$结束 $定义
		$定义 打开授权 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "打开无障碍设置"
		$结束 $定义
		$定义 读取窗口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "检查服务并读取活动窗口"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "服务尚未检查。"
		$结束 $定义
		$定义 演示输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "待填写的演示字段"
			提示文本 = "输入唯一文字后可以通过节点修改"
		$结束 $定义
		$定义 演示目标 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "示例目标：点我"
		$结束 $定义
		$定义 目标反馈 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "目标实际点击：0；长按：0"
		$结束 $定义
		$定义 触发目标 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "通过节点触发演示按钮"
		$结束 $定义
		$定义 填写字段 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "通过节点填写编辑框"
		$结束 $定义
		$定义 查看节点 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "查看目标节点 JSON"
		$结束 $定义
		$定义 查看事件 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "刷新监听事件计数"
		$结束 $定义
		$定义 跨页读取 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "延时读取系统设置页（只读）"
		$结束 $定义
		$定义 窗口记录 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "读取结果和事件计数显示在这里。"
		$结束 $定义
		$定义 收尾说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "体验结束后，可回系统无障碍设置关闭本应用服务；退出窗口不等于撤销系统授权。"
		$结束 $定义
		$定义 辅助 $为 simple.library.wsd.accessibility.跨程序辅助
		$结束 $定义
		$定义 延时读取 $为 计时器
			间隔 = 3000
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
