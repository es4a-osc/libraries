别名 无障碍动作 = simple.library.wsd.accessibility.无障碍动作
别名 无障碍常量 = simple.library.wsd.accessibility.无障碍常量
别名 无障碍服务信息 = simple.library.wsd.accessibility.无障碍服务信息
别名 无障碍放大控制器 = simple.library.wsd.accessibility.无障碍放大控制器
别名 无障碍软键盘控制器 = simple.library.wsd.accessibility.无障碍软键盘控制器
别名 无障碍字幕样式 = simple.library.wsd.accessibility.无障碍字幕样式

变量 来源 为 主窗口
变量 原配置 为 无障碍服务信息

事件 读控制器.被单击()
	如果 辅助.已连接 = 假 则
		状态.文本 = "请先连接服务。"
		退出 事件
	结束 如果
	变量 放大 为 无障碍放大控制器
	变量 键盘 为 无障碍软键盘控制器
	放大 = 辅助.取放大控制器()
	键盘 = 辅助.取软键盘控制器()
	结果.文本 = "放大比例：" & 放大.比例 & "；中心：" & 放大.中心X & "," & 放大.中心Y & "；软键盘模式：" & 键盘.显示模式
结束 事件

事件 读字幕.被单击()
	变量 样式 为 无障碍字幕样式
	样式 = 辅助.取字幕样式()
	结果.文本 = "字幕启用：" & 辅助.字幕已启用 & "；字体比例：" & 辅助.字幕字体比例 & "；语言：" & 辅助.字幕语言 & "；前景色：" & 样式.前景色 & "；边缘类型：" & 样式.边缘类型
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 系统能力窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 读系统动作.被单击()
	变量 动作列表 为 无障碍动作()
	变量 动作 为 无障碍动作
	动作列表 = 辅助.取系统动作()
	结果.文本 = "当前可用的系统动作："
	循环 每个 动作 从 动作列表
		结果.文本 = 结果.文本 & "\n" & 动作.编号 & "：" & 动作.标签
	下个
	位于 错误
		分支 否则
			状态.文本 = "系统动作查询需要 Android 11 及以上。"
	结束 错误
结束 事件

事件 读显示时长.被单击()
	结果.文本 = "原显示时长：3000 毫秒；建议：" & 辅助.取建议显示时长(3000, 无障碍常量.显示内容_文本) & " 毫秒。"
结束 事件

事件 读按钮支持.被单击()
	结果.文本 = "系统辅助按钮受支持：" & 辅助.辅助按钮受支持
	位于 错误
		分支 否则
			状态.文本 = "辅助按钮支持查询需要 Android 8.1 及以上。"
	结束 错误
结束 事件

事件 读时长配置.被单击()
	变量 配置 为 无障碍服务信息
	配置 = 辅助.取服务信息()
	如果 配置 = 空 则
		状态.文本 = "请先连接服务。"
		退出 事件
	结束 如果
	结果.文本 = "交互显示时长：" & 配置.交互显示时长 & "；非交互显示时长：" & 配置.非交互显示时长 & " 毫秒。"
	位于 错误
		分支 否则
			状态.文本 = "显示时长配置需要 Android 10 及以上。"
	结束 错误
结束 事件

事件 辅助.系统动作改变()
	状态.文本 = "可用系统动作已变化，可重新查询。"
结束 事件

事件 系统能力窗口.切换完毕()
	辅助.事件监听 = 真
	状态.文本 = "服务已连接：" & 辅助.已连接
结束 事件

事件 系统能力窗口.即将切换()
	辅助.事件监听 = 假
	还原显示配置()
结束 事件

事件 设置显示时长.被单击()
	变量 配置 为 无障碍服务信息
	配置 = 辅助.取服务信息()
	如果 配置 = 空 则
		状态.文本 = "请先连接服务。"
		退出 事件
	结束 如果
	如果 原配置 = 空 则 原配置 = 辅助.取服务信息()
	配置.设置交互显示时长(5000)
	配置.设置非交互显示时长(5000)
	状态.文本 = "提交 5 秒显示建议：" & 辅助.应用配置(配置)
	结果.文本 = "配置已提交，请点击“查询文本建议显示时长”读取系统更新后的建议。"
	位于 错误
		分支 否则
			状态.文本 = "设置显示时长需要 Android 10 及以上。"
	结束 错误
结束 事件

过程 还原显示配置()
	如果 原配置 <> 空 则
		如果 辅助.已连接 则 辅助.应用配置(原配置)
		原配置 = 空
	结束 如果
结束 过程

事件 恢复显示时长.被单击()
	还原显示配置()
	结果.文本 = "当前使用原显示配置，可重新查询文本建议显示时长。"
结束 事件
$属性
	$资源 $窗口
	$定义 系统能力窗口 $为 窗口
		标题 = "系统能力读取"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "系统能力读取"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "读取系统状态、可用全局动作及建议显示时长。系统动作查询需 Android 11，辅助按钮支持查询需 Android 8.1，显示时长配置需 Android 10。"
		$结束 $定义
		$定义 读控制器 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "读取放大与软键盘"
		$结束 $定义
		$定义 读字幕 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "读取字幕首选项"
		$结束 $定义
		$定义 读系统动作 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "查询可用系统动作"
		$结束 $定义
		$定义 读显示时长 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "查询文本建议显示时长"
		$结束 $定义
		$定义 读按钮支持 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "查询辅助按钮支持"
		$结束 $定义
		$定义 读时长配置 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "读取显示时长配置"
		$结束 $定义
		$定义 设置显示时长 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "将显示时长建议设为 5 秒"
		$结束 $定义
		$定义 恢复显示时长 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "恢复原显示配置"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "请先在目录页启用服务并检查连接。"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "操作结果显示在这里。"
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "动作编号供“执行全局动作”使用。辅助按钮支持状态不表示当前可用；指纹手势还需要硬件支持。"
		$结束 $定义
		$定义 辅助 $为 simple.library.wsd.accessibility.无障碍服务
			事件监听 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
