别名 无障碍节点 = simple.library.wsd.accessibility.无障碍节点
别名 无障碍节点列表 = simple.library.wsd.accessibility.无障碍节点列表
别名 无障碍边界 = simple.library.wsd.accessibility.无障碍边界
别名 无障碍手势路径 = simple.library.wsd.accessibility.无障碍手势路径
别名 无障碍手势 = simple.library.wsd.accessibility.无障碍手势
别名 无障碍笔画 = simple.library.wsd.accessibility.无障碍笔画

变量 来源 为 主窗口

变量 实际点击 为 整数型
变量 手势序号 为 整数型
变量 待完成编号 为 整数型

''' 从节点屏幕边界取得像素坐标，不以 DIP 或屏幕比例代替。

函数 查找演示节点(文本 为 文本型) 为 无障碍节点
	变量 根 为 无障碍节点
	根 = 辅助.取根节点()
	如果 根 = 空 则
		状态.文本 = "没有活动根节点，请先检查服务连接。"
		退出 函数
	结束 如果
	变量 结果 为 无障碍节点列表
	结果 = 根.按文本查找(文本)
	根.释放()
	如果 结果.数量 = 1 则
		查找演示节点 = 结果.取项目(0)
	否则
		状态.文本 = "未找到唯一演示节点，请回到本页重试。"
	结束 如果
	结果.释放()
结束 函数

事件 演示目标.被单击()
	实际点击 = 实际点击 + 1
	反馈.文本 = "目标实际点击次数：" & 实际点击
结束 事件

事件 手势单击.被单击()
	变量 节点 为 无障碍节点
	节点 = 查找演示节点("目标：点我")
	如果 节点 = 空 则 退出 事件
	变量 边界 为 无障碍边界
	边界 = 节点.取屏幕边界()
	如果 节点.可见 = 假 或 边界.中心X < 0 或 边界.中心Y < 0 则
		节点.释放()
		状态.文本 = "请先把演示目标滚动到屏幕内。"
		退出 事件
	结束 如果
	节点.释放()
	变量 路径 为 无障碍手势路径
	路径 = 创建 无障碍手势路径
	路径.设置起点(边界.中心X, 边界.中心Y)
	变量 手势 为 无障碍手势
	手势 = 创建 无障碍手势
	手势.添加笔画(无障碍笔画.创建(路径, 0, 100))
	手势序号 = 手势序号 + 1
	待完成编号 = 手势序号
	状态.文本 = "手势提交：" & 辅助.派发手势(手势, 待完成编号) & "；等待完成或取消回调。"
结束 事件

事件 辅助.手势完成(请求编号 为 整数型)
	如果 请求编号 <> 待完成编号 则 退出 事件
	状态.文本 = "手势已完成，请求编号：" & 请求编号 & "；请核对实际点击次数。"
结束 事件

事件 辅助.手势取消(请求编号 为 整数型)
	如果 请求编号 <> 待完成编号 则 退出 事件
	状态.文本 = "手势被取消，请求编号：" & 请求编号
结束 事件

事件 手势窗口.切换完毕()
	辅助.事件监听 = 真
	状态.文本 = "服务已连接：" & 辅助.已连接 & "；手势回调监听已打开。"
结束 事件

事件 手势窗口.即将切换()
	辅助.事件监听 = 假
	待完成编号 = 0
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 手势窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 手势窗口 $为 窗口
		标题 = "屏幕手势"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			字体加粗 = 真
			文本 = "屏幕手势"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "把目标保持在屏幕内，点“手势单击”，观察提交结果、完成或取消回调和目标实际点击次数。"
		$结束 $定义
		$定义 演示目标 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "目标：点我"
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "目标实际点击次数：0"
		$结束 $定义
		$定义 手势单击 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "手势单击"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "请先在目录页启用服务并检查连接。"
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "手势完成回调只表示系统完成派发，请同时核对目标的实际变化。"
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
		$结束 $定义
		$定义 辅助 $为 simple.library.wsd.accessibility.无障碍服务
			事件监听 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
