''' 基于当前 GIF 图片框源码与随库本地素材，演示异步载入、播放和资源清理。
''' 所有素材均在本工程中；组件不直接读取网址或文档 URI，失败会保留旧图和原播放状态。
变量 字节动图 为 字节型()
变量 私有文件 为 文本型
变量 完成次数 为 整数型
变量 失败次数 为 整数型
变量 点击次数 为 整数型

''' 确定生成的 8×8、4 帧小动画，用于演示字节和私有文件载入。
函数 演示字节() 为 字节型()
	演示字节 = Base64解码( _
		"R0lGODlhCAAIAPEAANw8PDKgWihk0v/XRiH/C05FVFNDQVBFMi4wAwEAAAAh+QQEGQAAACwAAAAACAAIAAACMQRBEARBEARB" & _
		"EARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEAUAIfkEBBkAAAAsAAAAAAgACAAAAjEMwzAMwzAMwzAM" & _
		"wzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAFACH5BAQZAAAALAAAAAAIAAgAAAIxFEVRFEVRFEVRFEVR" & _
		"FEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRBQAh+QQEGQAAACwAAAAACAAIAAACMRzHcRzHcRzHcRzHcRzH" & _
		"cRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcQUAOw==")
结束 函数

事件 主窗口.初始化()
	字节动图 = 演示字节()
	动图.图片 = "demo.gif"
结束 事件

事件 资产载入.被单击()
	动图.图片 = "demo.gif"
结束 事件

事件 资源载入.被单击()
	动图.图片 = "@raw/gif_demo"
结束 事件

事件 字节载入.被单击()
	动图.载入字节图片(字节动图)
结束 事件

''' 文件操作使用应用私有目录，取得真实绝对路径后交给 GIF 组件，不申请外部存储权限。
事件 文件载入.被单击()
	如果 创建目录("gif-example") 且 写出字节文件("gif-example/bytes.gif", 字节动图) 则
		变量 文件列表 为 文本型()
		变量 索引 为 整数型
		文件列表 = 取文件列表("gif-example")
		私有文件 = ""
		循环 索引 = 0 至 取数组成员数(文件列表) - 1
			如果 取文本右边(文件列表(索引), 9) = "bytes.gif" 则 私有文件 = 文件列表(索引)
		下个
		如果 私有文件 <> "" 则
			动图.图片 = 私有文件
		否则
			结果.文本 = "未找到刚写入的私有 GIF 文件，保留当前图片。"
		结束 如果
	结束 如果
	位于 错误
		分支 否则
			结果.文本 = "准备私有文件失败，保留当前图片。"
	结束 错误
结束 事件

事件 另一动画.被单击()
	动图.图片 = "alternate.gif"
结束 事件

事件 坏图载入.被单击()
	动图.图片 = "invalid.gif"
结束 事件

''' 连续请求只接受最后一份素材的回调；不把提交请求当成载入成功。
事件 快速切换.被单击()
	动图.图片 = "invalid.gif"
	动图.图片 = "demo.gif"
	动图.图片 = "alternate.gif"
结束 事件

事件 从头播放.被单击()
	动图.开始播放()
	结果.文本 = "已从头播放；关闭循环时可观察一次播放完成事件。"
结束 事件

事件 暂停.被单击()
	动图.暂停播放()
	结果.文本 = "暂停保留位置；观察位置数值应保持不变。"
结束 事件

事件 继续.被单击()
	动图.继续播放()
	结果.文本 = "从暂停位置继续；若单次播放已经结束，则从头继续。"
结束 事件

事件 停止.被单击()
	动图.停止播放()
	结果.文本 = "停止回到第一帧，位置为 0；图片仍然保留。"
结束 事件

事件 循环开关.被单击()
	动图.循环播放 = (动图.循环播放 = 假)
	如果 动图.循环播放 则
		结果.文本 = "循环已开启；切换循环不会自动启动已结束的动画。"
	否则
		结果.文本 = "循环已关闭；点击从头播放后仅播放一轮。"
	结束 如果
结束 事件

''' 自动播放仅影响下一次成功载入，不改变当前图片的播放状态。
事件 自动开关.被单击()
	动图.自动播放 = (动图.自动播放 = 假)
	结果.文本 = "已切换自动播放；重新载入图片后观察效果。"
结束 事件

事件 缩放方式.被单击()
	动图.显示方式 = (动图.显示方式 + 1) % 3
	结果.文本 = "显示方式：0 等比适应、1 拉伸填满、2 原始像素居中。"
结束 事件

事件 隐藏显示.被单击()
	动图.可视 = (动图.可视 = 假)
	结果.文本 = "隐藏时冻结位置；重新显示后只恢复原本处于播放状态的动画。"
结束 事件

事件 清空.被单击()
	动图.清空图片()
	结果.文本 = "已清空图片并取消待处理请求；宽、高、帧数和播放位置均为 0。"
结束 事件

事件 恢复默认.被单击()
	完成次数 = 0
	失败次数 = 0
	点击次数 = 0
	动图.可视 = 真
	动图.自动播放 = 真
	动图.循环播放 = 真
	动图.显示方式 = 0
	动图.图片 = "demo.gif"
结束 事件

事件 动图.载入成功(宽度 为 整数型, 高度 为 整数型, 帧数 为 整数型)
	结果.文本 = "载入成功：" & 宽度 & "×" & 高度 & "，" & 帧数 & " 帧。"
	更新状态()
结束 事件

事件 动图.载入失败(错误信息 为 文本型)
	失败次数 = 失败次数 + 1
	结果.文本 = "载入失败：" & 错误信息 & "；原图片和播放状态保留。"
	更新状态()
结束 事件

事件 动图.播放完毕()
	完成次数 = 完成次数 + 1
	结果.文本 = "单次播放完成，停留在最后一帧；完成事件共 " & 完成次数 & " 次。"
	更新状态()
结束 事件

事件 动图.被单击()
	点击次数 = 点击次数 + 1
	结果.文本 = "收到图片单击事件，共 " & 点击次数 & " 次。"
结束 事件

''' 读取真实组件属性展示状态，不替代载入成功、失败和播放完成事件。
过程 更新状态()
	变量 来源 为 文本型
	来源 = 动图.图片
	如果 来源 = "" 则
		如果 动图.帧数 = 0 则 来源 = "无图片" 否则 来源 = "字节集"
	结束 如果
	状态.文本 = "来源：" & 来源 & "；尺寸：" & 动图.图片宽度 & "×" & 动图.图片高度 & "；帧数：" & 动图.帧数 & "；时长：" & 动图.动画时长 & "ms"
	播放状态.文本 = "载入=" & 动图.正在载入 & "，播放=" & 动图.正在播放 & "，位置=" & 动图.播放位置 & "ms；自动=" & 动图.自动播放 & "，循环=" & 动图.循环播放 & "，显示=" & 动图.显示方式 & "；完成=" & 完成次数 & "，失败=" & 失败次数
结束 过程

事件 状态计时.计时()
	更新状态()
结束 事件

''' Activity 销毁时，GIF 组件自行释放图像和解码线程；主动退出时先停止本示例的状态刷新。
事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		状态计时.启用 = 假
		动图.清空图片()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "GIF图片框使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 24
			文本 = "GIF 载入与播放"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "本地动画演示：暂停保留位置，停止回到首帧；载入失败保留旧图。可观察状态与实际画面。"
		$结束 $定义
		$定义 动图 $为 simple.library.wsd.gif.GIF图片框
			宽度 = 长度_匹配父级
			高度 = "160dp"
			自动播放 = 真
			循环播放 = 真
			显示方式 = 0
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "等待载入。"
		$结束 $定义
		$定义 播放状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "等待播放状态。"
		$结束 $定义
		$定义 载入操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 资产载入 $为 按钮
				文本 = "资产"
				宽度 = "100dp"
			$结束 $定义
			$定义 资源载入 $为 按钮
				文本 = "资源"
				宽度 = "100dp"
			$结束 $定义
			$定义 字节载入 $为 按钮
				文本 = "字节"
				宽度 = "100dp"
			$结束 $定义
			$定义 文件载入 $为 按钮
				文本 = "私有文件"
				宽度 = "100dp"
			$结束 $定义
		$结束 $定义
		$定义 素材操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 另一动画 $为 按钮
				文本 = "另一动画"
				宽度 = "130dp"
			$结束 $定义
			$定义 坏图载入 $为 按钮
				文本 = "载入坏图"
				宽度 = "130dp"
			$结束 $定义
			$定义 快速切换 $为 按钮
				文本 = "快速切换"
				宽度 = "130dp"
			$结束 $定义
		$结束 $定义
		$定义 播放操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 从头播放 $为 按钮
				文本 = "从头播放"
				宽度 = "100dp"
			$结束 $定义
			$定义 暂停 $为 按钮
				文本 = "暂停"
				宽度 = "100dp"
			$结束 $定义
			$定义 继续 $为 按钮
				文本 = "继续"
				宽度 = "100dp"
			$结束 $定义
			$定义 停止 $为 按钮
				文本 = "停止"
				宽度 = "100dp"
			$结束 $定义
		$结束 $定义
		$定义 选项操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 循环开关 $为 按钮
				文本 = "循环开关"
				宽度 = "130dp"
			$结束 $定义
			$定义 自动开关 $为 按钮
				文本 = "自动播放开关"
				宽度 = "130dp"
			$结束 $定义
			$定义 缩放方式 $为 按钮
				文本 = "切换缩放"
				宽度 = "130dp"
			$结束 $定义
		$结束 $定义
		$定义 资源操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 隐藏显示 $为 按钮
				文本 = "隐藏 / 显示"
				宽度 = "130dp"
			$结束 $定义
			$定义 清空 $为 按钮
				文本 = "清空图片"
				宽度 = "130dp"
			$结束 $定义
			$定义 恢复默认 $为 按钮
				文本 = "恢复默认"
				宽度 = "130dp"
			$结束 $定义
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "等待载入回调。"
		$结束 $定义
		$定义 状态计时 $为 计时器
			启用 = 真
			间隔 = 200
		$结束 $定义
	$结束 $定义
$结束 $属性
