''' GIF 图片框：载入方式、播放控制、错误反馈和资源清理。
别名 GIF = simple.library.wsd.gif.GIF图片框

变量 字节动图 为 字节型()
变量 私有文件 为 文本型
变量 自检阶段 为 整数型
变量 检查数量 为 整数型
变量 等待次数 为 整数型
变量 暂停位置 为 整数型
变量 完成次数 为 整数型

''' 这是确定生成的 8×8、4 帧动画文件；示范字节接口，无需网络。
函数 演示字节() 为 字节型()
	演示字节 = Base64解码( _
		"R0lGODlhCAAIAPEAANw8PDKgWihk0v/XRiH/C05FVFNDQVBFMi4wAwEAAAAh+QQEGQAAACwAAAAACAAIAAACMQRBEARBEARB" & _
		"EARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEARBEAUAIfkEBBkAAAAsAAAAAAgACAAAAjEMwzAMwzAMwzAM" & _
		"wzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAMwzAFACH5BAQZAAAALAAAAAAIAAgAAAIxFEVRFEVRFEVRFEVR" & _
		"FEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRFEVRBQAh+QQEGQAAACwAAAAACAAIAAACMRzHcRzHcRzHcRzHcRzH" & _
		"cRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcRzHcQUAOw==")
结束 函数

''' 取得本应用写入文件的绝对路径，不硬编码 Android 数据目录。
函数 准备私有文件() 为 文本型
	创建目录("gif-example")
	断言真(写出字节文件("gif-example/demo.gif", 字节动图))
	变量 列表 为 文本型()
	变量 索引 为 整数型
	列表 = 取文件列表("gif-example")
	循环 索引 = 0 至 取数组成员数(列表) - 1
		如果 取文本右边(列表(索引), 8) = "demo.gif" 则 准备私有文件 = 列表(索引)
	下个
结束 函数

事件 主窗口.初始化()
	字节动图 = 演示字节()
	私有文件 = 准备私有文件()
	动图.图片 = "demo.gif"
结束 事件

''' 手动操作可以随时中止自检，不改变组件本身的控制规则。
过程 手动操作()
	自检阶段 = 0
	等待次数 = 0
结束 过程

事件 资产载入.被单击()
	手动操作()
	动图.图片 = "demo.gif"
结束 事件

事件 资源载入.被单击()
	手动操作()
	动图.图片 = "@raw/gif_demo"
结束 事件

事件 字节载入.被单击()
	手动操作()
	动图.载入字节图片(字节动图)
结束 事件

事件 文件载入.被单击()
	手动操作()
	动图.图片 = 私有文件
结束 事件

事件 切换动画.被单击()
	手动操作()
	如果 动图.图片 = "alternate.gif" 则
		动图.图片 = "demo.gif"
	否则
		动图.图片 = "alternate.gif"
	结束 如果
结束 事件

事件 坏图测试.被单击()
	手动操作()
	动图.图片 = "invalid.gif"
结束 事件

事件 从头播放.被单击()
	手动操作()
	动图.开始播放()
	结果.文本 = "已从第一帧开始播放。"
结束 事件

事件 暂停.被单击()
	手动操作()
	动图.暂停播放()
	结果.文本 = "已暂停，位置保留。"
结束 事件

事件 继续.被单击()
	手动操作()
	动图.继续播放()
	结果.文本 = "从当前暂停位置继续。"
结束 事件

事件 停止.被单击()
	手动操作()
	动图.停止播放()
	结果.文本 = "已停止并回到第一帧。"
结束 事件

事件 清空.被单击()
	手动操作()
	动图.清空图片()
	结果.文本 = "已取消载入、停止刷新并清除图片引用。"
结束 事件

事件 循环开关.被单击()
	手动操作()
	动图.循环播放 = (动图.循环播放 = 假)
	如果 动图.循环播放 则
		结果.文本 = "循环播放已启用。"
	否则
		结果.文本 = "循环播放已关闭；可点击从头播放，观察一次播放完成事件。"
	结束 如果
结束 事件

事件 缩放方式.被单击()
	手动操作()
	动图.显示方式 = (动图.显示方式 + 1) % 3
	结果.文本 = "显示方式：" & 动图.显示方式 & "（0 等比、1 拉伸、2 原始尺寸）。"
结束 事件

事件 隐藏显示.被单击()
	手动操作()
	动图.可视 = (动图.可视 = 假)
	结果.文本 = "不可见时冻结播放位置；再次显示只恢复原本处于播放状态的动画。"
结束 事件

事件 快速切换.被单击()
	手动操作()
	动图.图片 = "invalid.gif"
	动图.图片 = "demo.gif"
	动图.图片 = "alternate.gif"
	结果.文本 = "已连续请求三次，只接受最后一个 alternate.gif 的结果。"
结束 事件

''' 先更换字段引用，再销毁旧组件，保留按字段关联的事件处理。
过程 重建动图()
	变量 旧组件 为 GIF
	旧组件 = 动图
	动图 = 创建 GIF 位于 显示容器
	动图.宽度 = 长度_匹配父级
	动图.高度 = 长度_匹配父级
	旧组件.销毁()
结束 过程

事件 重建组件.被单击()
	手动操作()
	重建动图()
	动图.图片 = "demo.gif"
	结果.文本 = "已销毁旧实例并创建新实例。"
结束 事件

事件 动图.被单击()
	手动操作()
	结果.文本 = "收到图片单击事件。"
结束 事件

事件 动图.载入成功(宽度 为 整数型, 高度 为 整数型, 帧数 为 整数型)
	等待次数 = 0
	结果.文本 = "载入成功：" & 宽度 & "×" & 高度 & "，" & 帧数 & " 帧。"
	判断 自检阶段
		分支 1
			检查(宽度 = 160)
			检查(高度 = 100)
			检查(帧数 = 8)
			检查(动图.图片 = "demo.gif")
			检查(动图.正在载入 = 假)
			检查(动图.正在播放 = 假)
			动图.开始播放()
			检查(动图.正在播放)
			自检阶段 = 2
		分支 5
			检查(动图.图片 = 私有文件)
			检查(宽度 = 8)
			检查(帧数 = 4)
			自检阶段 = 6
			动图.图片 = "invalid.gif"
		分支 7
			检查(宽度 = 96)
			检查(高度 = 64)
			检查(帧数 = 4)
			检查(动图.图片 = "alternate.gif")
			检查(动图.最后错误 = "")
			动图.图片 = "demo.gif"
			动图.清空图片()
			检查(动图.图片宽度 = 0)
			检查(动图.正在载入 = 假)
			自检阶段 = 8
		分支 9
			检查(动图.图片 = "@raw/gif_demo")
			检查(宽度 = 160)
			检查(动图.正在播放)
			自检阶段 = 10
		分支 11
			检查(宽度 = 160)
			检查(动图.正在播放)
			自检阶段 = 0
			结果.文本 = "设备自检通过：" & 检查数量 & " 项。可继续操作上方测试。"
	结束 判断
	位于 错误
		分支 否则
			自检失败()
	结束 错误
结束 事件

事件 动图.载入失败(错误信息 为 文本型)
	等待次数 = 0
	结果.文本 = "载入失败：" & 错误信息 & "\n原图片保留，可继续播放或重新载入。"
	如果 自检阶段 = 6 则
		检查(动图.最后错误 <> "")
		检查(动图.图片宽度 = 8)
		检查(动图.图片 = 私有文件)
		自检阶段 = 7
		动图.图片 = "invalid.gif"
		动图.图片 = "demo.gif"
		动图.图片 = "alternate.gif"
	否则
		如果 自检阶段 <> 0 则 自检失败()
	结束 如果
	位于 错误
		分支 否则
			自检失败()
	结束 错误
结束 事件

事件 动图.播放完毕()
	完成次数 = 完成次数 + 1
	结果.文本 = "收到一次播放完成事件；动画停留在最后一帧。"
	如果 自检阶段 = 10 则
		检查(完成次数 = 1)
		检查(动图.正在播放 = 假)
		检查(动图.播放位置 = 动图.动画时长 - 1)
		自检阶段 = 11
		动图.循环播放 = 真
		动图.图片 = "demo.gif"
	结束 如果
	位于 错误
		分支 否则
			自检失败()
	结束 错误
结束 事件

''' 显示组件状态，不把“按钮点击成功”当作播放或载入成功。
事件 状态计时器.计时()
	变量 状态描述 为 文本型
	状态描述 = "已暂停或停止"
	如果 动图.正在播放 则 状态描述 = "播放中"
	如果 动图.正在载入 则 状态描述 = "载入中"
	状态.文本 = 状态描述 & "  " & 动图.图片宽度 & "×" & 动图.图片高度 & _
		" / " & 动图.帧数 & " 帧\n位置：" & 动图.播放位置 & " / " & 动图.动画时长 & " 毫秒"
	如果 自检阶段 = 0 则 退出 事件

	等待次数 = 等待次数 + 1
	如果 等待次数 > 50 则
		自检失败()
		退出 事件
	结束 如果
	判断 自检阶段
		分支 2
			动图.暂停播放()
			暂停位置 = 动图.播放位置
			检查(暂停位置 > 0)
			检查(动图.正在播放 = 假)
			自检阶段 = 3
		分支 3
			检查(动图.播放位置 = 暂停位置)
			动图.继续播放()
			检查(动图.正在播放)
			自检阶段 = 4
		分支 4
			检查(动图.播放位置 > 暂停位置)
			动图.停止播放()
			检查(动图.播放位置 = 0)
			检查(动图.正在播放 = 假)
			动图.显示方式 = GIF.缩放_拉伸填满
			检查(动图.显示方式 = GIF.缩放_拉伸填满)
			动图.显示方式 = GIF.缩放_原始居中
			检查(动图.显示方式 = GIF.缩放_原始居中)
			动图.显示方式 = GIF.缩放_等比适应
			自检阶段 = 5
			动图.图片 = 私有文件
		分支 8
			检查(动图.图片宽度 = 0)
			检查(动图.帧数 = 0)
			检查(动图.正在播放 = 假)
			检查(动图.正在载入 = 假)
			检查(动图.最后错误 = "")
			动图.自动播放 = 真
			动图.循环播放 = 假
			自检阶段 = 9
			动图.图片 = "@raw/gif_demo"
	结束 判断
	位于 错误
		分支 否则
			自检失败()
	结束 错误
结束 事件

过程 检查(条件 为 逻辑型)
	断言真(条件)
	检查数量 = 检查数量 + 1
结束 过程

过程 自检失败()
	结果.文本 = "自检未通过：阶段 " & 自检阶段 & "，已完成 " & 检查数量 & " 项。"
	自检阶段 = 0
结束 过程

事件 运行自检.被单击()
	重建动图()
	动图.可视 = 真
	动图.自动播放 = 假
	动图.循环播放 = 真
	检查数量 = 0
	等待次数 = 0
	完成次数 = 0
	自检阶段 = 1
	动图.图片 = "demo.gif"
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "GIF图片框测试"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 状态计时器 $为 计时器
			间隔 = 200
			启用 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "本地 GIF 测试：核对尺寸、帧数、播放状态及成功/失败事件；坏图后需能恢复。自检不替代动画及前后台生命周期观察。"
			字体大小 = 14
		$结束 $定义
		$定义 显示容器 $为 面板
			宽度 = 长度_匹配父级
			高度 = "200dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_垂直
			背景颜色 = &HFFF1F5F9
			$定义 动图 $为 simple.library.wsd.gif.GIF图片框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				自动播放 = 真
				循环播放 = 真
			$结束 $定义
		$结束 $定义
		$定义 载入工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 资产载入 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "资产动图"
			$结束 $定义
			$定义 资源载入 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "资源动图"
			$结束 $定义
			$定义 字节载入 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "字节动图"
			$结束 $定义
		$结束 $定义
		$定义 输入工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 文件载入 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "文件动图"
			$结束 $定义
			$定义 切换动画 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "切换动画"
			$结束 $定义
			$定义 坏图测试 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "坏图测试"
			$结束 $定义
		$结束 $定义
		$定义 播放工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 从头播放 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "从头播放"
			$结束 $定义
			$定义 暂停 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "暂停"
			$结束 $定义
			$定义 继续 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "继续"
			$结束 $定义
		$结束 $定义
		$定义 停止工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 停止 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "停止"
			$结束 $定义
			$定义 清空 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "清空"
			$结束 $定义
			$定义 循环开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "循环开关"
			$结束 $定义
		$结束 $定义
		$定义 显示工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 缩放方式 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "缩放方式"
			$结束 $定义
			$定义 隐藏显示 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "隐藏显示"
			$结束 $定义
			$定义 快速切换 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "快速切换"
			$结束 $定义
		$结束 $定义
		$定义 辅助工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 重建组件 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "重建组件"
			$结束 $定义
			$定义 运行自检 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "46dp"
				字体大小 = 13
				文本 = "运行自检"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "等待载入"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "请点击上方按钮，观察图像和下方状态。"
		$结束 $定义
	$结束 $定义
$结束 $属性
