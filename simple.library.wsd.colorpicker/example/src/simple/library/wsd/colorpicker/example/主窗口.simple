''' 参考当前颜色选择框与色环实现：显示不阻塞，结果通过确认和取消事件返回。
''' 预览只在确认事件中更新；初始颜色和最近一次确认的颜色分别维护。
变量 确认次数 为 整数型
变量 取消次数 为 整数型

函数 色值(颜色 为 整数型) 为 文本型
	色值 = "#" & 取文本右边("00000000" & 十六进制(颜色), 8)
结束 函数

事件 主窗口.初始化()
	预览.背景颜色 = 选色器.选中颜色
	更新状态()
结束 事件

过程 更新状态()
	状态.文本 = "正在显示=" & 选色器.正在显示 & "；确认=" & 确认次数 & "；取消=" & 取消次数
	颜色记录.文本 = "下次初始=" & 色值(选色器.初始颜色) & "；已确认=" & 色值(选色器.选中颜色)
结束 过程

过程 打开选择(初值 为 整数型)
	延时关闭.启用 = 假
	选色器.标题 = 标题输入.文本
	选色器.初始颜色 = 初值
	选色器.显示()
	更新状态()
结束 过程

''' 沿用上次确认的颜色是应用自己的选择，组件不会自动把已选颜色写回初始颜色。
事件 沿用颜色.被单击()
	打开选择(选色器.选中颜色)
结束 事件

事件 蓝色初值.被单击()
	打开选择(&HFF2196F3)
结束 事件

事件 半透明初值.被单击()
	打开选择(&H802196F3)
结束 事件

事件 透明初值.被单击()
	打开选择(&H002196F3)
结束 事件

''' 颜色草稿可变化，透明度始终沿用初始值；标题留空可隐藏标题。
事件 无标题.被单击()
	延时关闭.启用 = 假
	选色器.标题 = ""
	选色器.初始颜色 = 选色器.选中颜色
	选色器.显示()
	更新状态()
结束 事件

''' 后一次显示替换旧会话，旧框不派发取消事件。
事件 重复打开.被单击()
	打开选择(&HFF2196F3)
	选色器.标题 = "第二次显示：只保留一个对话框"
	选色器.初始颜色 = &HFF259B62
	选色器.显示()
	更新状态()
结束 事件

事件 定时关闭.被单击()
	打开选择(选色器.选中颜色)
	延时关闭.启用 = 真
	输出.文本 = "约 3 秒后调用关闭；提前确定或取消会撤销该计时。"
结束 事件

事件 延时关闭.计时()
	延时关闭.启用 = 假
	''' 连续关闭时，只有第一次结束当前会话并派发一次取消事件。
	选色器.关闭()
	选色器.关闭()
	更新状态()
结束 事件

事件 空闲关闭.被单击()
	延时关闭.启用 = 假
	选色器.关闭()
	更新状态()
	输出.文本 = "已调用关闭；未显示对话框时不产生取消事件。"
结束 事件

事件 选色器.颜色选择完毕(颜色 为 整数型)
	延时关闭.启用 = 假
	确认次数 = 确认次数 + 1
	预览.背景颜色 = 颜色
	更新状态()
	输出.文本 = "已确认 " & 色值(颜色) & "；事件参数直接用于预览背景。"
结束 事件

事件 选色器.取消选择()
	延时关闭.启用 = 假
	取消次数 = 取消次数 + 1
	更新状态()
	输出.文本 = "已取消；保留此前确认色 " & 色值(选色器.选中颜色) & "。"
结束 事件

事件 主窗口.程序被销毁()
	延时关闭.启用 = 假
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		延时关闭.启用 = 假
		选色器.关闭()
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "颜色选择使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "选择颜色，确认后应用"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "拖动色环调整色相，渐变条调整明暗；取消、返回或点击框外不提交。颜色是 ARGB 整数，透明度沿用初值。"
		$结束 $定义
		$定义 标题输入 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "选择预览背景颜色"
			提示文本 = "对话框标题（留空隐藏）"
		$结束 $定义
		$定义 预览 $为 面板
			宽度 = 长度_匹配父级
			高度 = "64dp"
		$结束 $定义
		$定义 常规区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 沿用颜色 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "沿用已确认颜色"
			$结束 $定义
			$定义 蓝色初值 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "蓝色初值"
			$结束 $定义
		$结束 $定义
		$定义 透明区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 半透明初值 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "半透明蓝色初值"
			$结束 $定义
			$定义 透明初值 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "完全透明蓝色初值"
			$结束 $定义
		$结束 $定义
		$定义 会话区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 重复打开 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "连续显示两次"
			$结束 $定义
			$定义 定时关闭 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "3秒后程序关闭"
			$结束 $定义
		$结束 $定义
		$定义 标题区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 无标题 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "无标题选择"
			$结束 $定义
			$定义 空闲关闭 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "空闲时调用关闭"
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 颜色记录 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "上方预览只在点“确定”后更新。"
		$结束 $定义
		$定义 边界 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "半透明预览与背景混合；完全透明时颜色存在但看不见。没有透明度滑块，首两位 AA 不随选色改变。"
		$结束 $定义
		$定义 选色器 $为 simple.library.wsd.colorpicker.颜色选择框
		$结束 $定义
		$定义 延时关闭 $为 计时器
			间隔 = 3000
			启用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
