''' 颜色选择框：确认才提交颜色，取消不改变上次结果。
别名 选色类型 = simple.library.wsd.colorpicker.颜色选择框

''' 记录事件次数，并保存取消前应保持的颜色。
变量 确认次数 为 整数型
变量 取消次数 为 整数型
变量 原颜色 为 整数型
变量 定时操作 为 整数型
变量 回调重开 为 逻辑型

''' 将颜色整数显示为完整的八位 ARGB 十六进制。
函数 色值(颜色 为 整数型) 为 文本型
	色值 = "#" & 取文本右边("00000000" & 十六进制(颜色), 8)
结束 函数

''' 初始界面与组件的已确认颜色保持一致。
事件 主窗口.初始化()
	预览.背景颜色 = 选色框.选中颜色
	结果.文本 = "当前颜色：" & 色值(选色框.选中颜色)
结束 事件

''' 每次手动操作取消前一次定时检查，避免旧计时操作关闭新对话框。
过程 准备操作()
	检查计时器.启用 = 假
	定时操作 = 0
	回调重开 = 假
	原颜色 = 选色框.选中颜色
结束 过程

''' 沿用上次确认结果；初始颜色不会由组件自动回写。
事件 常规选择.被单击()
	准备操作()
	选色框.标题 = "选择颜色"
	选色框.初始颜色 = 选色框.选中颜色
	选色框.显示()
结束 事件

''' 指定不透明初值，检查确认和取消的差别。
事件 蓝色初值.被单击()
	准备操作()
	选色框.标题 = "蓝色初值"
	选色框.初始颜色 = &HFF2196F3
	选色框.显示()
结束 事件

''' 修改色相或明暗后，半透明度仍应保留。
事件 透明初值.被单击()
	准备操作()
	选色框.标题 = "保留半透明度"
	选色框.初始颜色 = &H802196F3
	选色框.显示()
结束 事件

''' 后一次显示替换前一次，不产生旧框的取消事件。
事件 重复打开.被单击()
	准备操作()
	选色框.标题 = "第一次显示"
	选色框.初始颜色 = &HFF2196F3
	选色框.显示()
	选色框.标题 = "最后一次显示"
	选色框.初始颜色 = &HFF259B62
	选色框.显示()
结束 事件

''' 延迟关闭用于检查程序取消，不阻塞界面线程。
事件 程序关闭.被单击()
	准备操作()
	选色框.标题 = "一秒后程序关闭"
	选色框.显示()
	定时操作 = 1
	检查计时器.启用 = 真
结束 事件

''' 检查确认事件中再次显示对话框是否安全。
事件 确认后重开.被单击()
	准备操作()
	回调重开 = 真
	选色框.标题 = "确定后自动再开一次"
	选色框.显示()
结束 事件

''' 销毁旧实例后，检查新实例是否仍能接收选择事件。
事件 销毁检查.被单击()
	准备操作()
	选色框.标题 = "一秒后销毁旧实例"
	选色框.显示()
	定时操作 = 2
	检查计时器.启用 = 真
结束 事件

''' 计时器只执行一次，分别检查关闭和销毁两种路径。
事件 检查计时器.计时()
	检查计时器.启用 = 假

	如果 定时操作 = 1 则
		''' 连续关闭只应派发一次取消事件。
		选色框.关闭()
		选色框.关闭()
		断言真(选色框.正在显示 = 假)
		结果.文本 = "程序关闭完成；确认=" & 确认次数 & "，取消=" & 取消次数
	否则
		变量 旧组件 为 选色类型
		旧组件 = 选色框
		''' 先替换字段引用，再销毁旧实例，保留字段的事件绑定。
		选色框 = 创建 选色类型 位于 主窗口
		旧组件.销毁()

		断言真(选色框.正在显示 = 假)
		预览.背景颜色 = 选色框.选中颜色
		结果.文本 = "旧实例已销毁，新实例可再次选择；取消次数=" & 取消次数
	结束 如果

	定时操作 = 0
结束 事件

''' 事件到达时应已关闭对话框，返回值应与选中颜色一致。
事件 选色框.颜色选择完毕(颜色 为 整数型)
	断言真(颜色 = 选色框.选中颜色)
	断言真(选色框.正在显示 = 假)

	确认次数 = 确认次数 + 1
	预览.背景颜色 = 颜色
	结果.文本 = "确认：" & 色值(颜色) & "；确认=" & 确认次数 & "，取消=" & 取消次数

	''' 新对话框不应被旧会话的关闭回调清理。
	如果 回调重开 则
		回调重开 = 假
		原颜色 = 颜色
		选色框.标题 = "回调重新打开"
		选色框.初始颜色 = 颜色
		选色框.显示()
	结束 如果
结束 事件

''' 取消只更新提示和计数，不改变此前确认的颜色。
事件 选色框.取消选择()
	断言真(选色框.正在显示 = 假)
	断言真(原颜色 = 选色框.选中颜色)

	取消次数 = 取消次数 + 1
	结果.文本 = "取消，保持：" & 色值(选色框.选中颜色) & "；确认=" & 确认次数 & "，取消=" & 取消次数
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "颜色选择框"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 选色框 $为 simple.library.wsd.colorpicker.颜色选择框
		$结束 $定义
		$定义 检查计时器 $为 计时器
			间隔 = 1000
			启用 = 假
		$结束 $定义
		$定义 页面滚动框 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 内容面板 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 说明 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "色环选择色相，渐变条调节明暗；确定才应用到下方色块，取消保留原色。透明度沿用初始颜色。"
				$结束 $定义
				$定义 预览 $为 面板
					宽度 = 长度_匹配父级
					高度 = "64dp"
				$结束 $定义
				$定义 常规选择 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "选择颜色"
				$结束 $定义
				$定义 蓝色初值 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "蓝色初值"
				$结束 $定义
				$定义 透明初值 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "半透明初值"
				$结束 $定义
				$定义 重复打开 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "重复打开两次"
				$结束 $定义
				$定义 程序关闭 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "程序关闭检查"
				$结束 $定义
				$定义 确认后重开 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "确认回调中重新打开"
				$结束 $定义
				$定义 销毁检查 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "销毁并重建检查"
				$结束 $定义
				$定义 结果 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "等待选择。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
