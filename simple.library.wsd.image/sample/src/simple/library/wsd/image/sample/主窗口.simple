' 图片参数是 PNG、JPEG 等文件字节集；本例只使用应用私有目录。
别名 图像 = simple.library.wsd.image.图像操作

变量 成_原图 为 字节型()
变量 成_原图路径 为 文本型

事件 主窗口.初始化()
	' 自带图片由四个色块和左上白色标记组成，方便观察旋转和镜像。
	成_原图 = Base64解码("")
	创建目录("image-example")
	写出字节文件("image-example/source.png", 成_原图)

	' 从文件操作返回的真实绝对路径定位文件，不硬编码 Android 数据目录。
	变量 文件列表 为 文本型()
	变量 索引 为 整数型
	文件列表 = 取文件列表("image-example")
	循环 索引 = 0 至 取数组成员数(文件列表) - 1
		如果 取文本右边(文件列表(索引), 10) = "source.png" 则 成_原图路径 = 文件列表(索引)
	下个
	断言真(成_原图路径 <> "")

	操作选项.添加项目("旋转 90 度")
	操作选项.添加项目("水平倾斜 0.25")
	操作选项.添加项目("缩放为 60×40")
	操作选项.添加项目("左右镜像")
	操作选项.添加项目("上下镜像")
	操作选项.添加项目("圆角 16 像素")
	操作选项.添加项目("圆形（参数 100）")
	操作选项.添加项目("添加倒影")
	操作选项.添加项目("截取中间 60×40")
	操作选项.添加项目("分割 2×2，显示第一块")
	操作选项.添加项目("字节压缩，返回 PNG")
	操作选项.添加项目("文件采样压缩，写出 JPEG")
	操作选项.添加项目("请求更新系统相册")
	操作选项.添加项目("恢复原图")
	操作选项.现行选中项 = 0
	效果图.图片 = 成_原图路径
	结果.文本 = "原图：120×80 像素。请选择操作并点击处理，或运行全部自检。"
	位于 错误
		分支 否则
			结果.文本 = "初始化失败，请检查类库是否已构建和接入。"
	结束 错误
结束 事件

事件 执行处理.被单击()
	变量 输出 为 字节型()
	变量 格式 为 文本型
	格式 = "png"

	判断 操作选项.现行选中项
		分支 0
			输出 = 图像.旋转图片(成_原图, 90)
		分支 1
			输出 = 图像.倾斜图片(成_原图, 0.25, 0)
		分支 2
			输出 = 图像.缩放图片(成_原图, 60, 40)
		分支 3
			输出 = 图像.反转图片(成_原图, 0)
		分支 4
			输出 = 图像.反转图片(成_原图, 1)
		分支 5
			输出 = 图像.设置图片圆角(成_原图, 16)
		分支 6
			输出 = 图像.设置图片圆角(成_原图, 100)
		分支 7
			输出 = 图像.设置图片倒影(成_原图)
		分支 8
			输出 = 图像.取图片部分(成_原图, 30, 20, 60, 40)
		分支 9
			变量 分块 为 集合
			分块 = 图像.切割图片(成_原图, 2, 2)
			输出 = 分块.项目(0)
		分支 10
			输出 = 图像.压缩图片(成_原图)
		分支 11
			图像.压缩图片2(成_原图路径, 成_原图路径 & ".sample.jpg", 40)
			输出 = 读入字节文件(成_原图路径 & ".sample.jpg")
			格式 = "jpg"
		分支 12
			图像.更新系统相册(成_原图路径)
			结果.文本 = "已提交异步扫描请求。\n示例图片位于应用私有目录，不保证出现在系统相册；此方法不会把图片发布到公共目录。"
			退出 事件
		分支 否则
			输出 = 成_原图
	结束 判断

	显示图片(输出, 操作选项.取项目文本(操作选项.现行选中项), 格式)
	位于 错误
		分支 否则
			结果.文本 = "处理失败，请检查图片、参数和目标文件的访问条件。"
	结束 错误
结束 事件

' 逐项检查格式、尺寸、集合顺序和错误分支，不把文件写入公共目录。
事件 运行自检.被单击()
	断言真(图像.取图片宽度("source.png") = 120)
	断言真(图像.取图片高度("source.png") = 80)
	断言真(图像.取图片宽度(成_原图路径) = 120)
	断言真(图像.取图片高度(成_原图路径) = 80)
	校验尺寸(成_原图, 120, 80)
	校验尺寸(图像.旋转图片(成_原图, 90), 80, 120)
	校验尺寸(图像.倾斜图片(成_原图, 0.25, 0), 140, 80)
	校验尺寸(图像.缩放图片(成_原图, 60, 40), 60, 40)
	校验尺寸(图像.反转图片(成_原图, 0), 120, 80)
	校验尺寸(图像.反转图片(成_原图, 1), 120, 80)
	校验尺寸(图像.设置图片圆角(成_原图, 16), 120, 80)
	校验尺寸(图像.设置图片圆角(成_原图, 100), 80, 80)
	校验尺寸(图像.设置图片倒影(成_原图), 120, 120)
	校验尺寸(图像.取图片部分(成_原图, 30, 20, 60, 40), 60, 40)
	校验尺寸(图像.压缩图片(成_原图), 120, 80)

	变量 分块 为 集合
	变量 索引 为 整数型
	变量 单块 为 字节型()
	分块 = 图像.切割图片(成_原图, 2, 2)
	断言真(分块.计数 = 4)
	循环 索引 = 0 至 分块.计数 - 1
		单块 = 分块.项目(索引)
		校验尺寸(单块, 60, 40)
	下个
	分块 = 图像.切割图片(成_原图, 7, 3)
	断言真(分块.计数 = 21)
	单块 = 分块.项目(20)
	校验尺寸(单块, 17, 26)

	' 文件压缩输出 JPEG，扩展名与实际编码保持一致。
	图像.压缩图片2(成_原图路径, 成_原图路径 & ".sample.jpg", 40)
	变量 压缩结果 为 字节型()
	压缩结果 = 读入字节文件(成_原图路径 & ".sample.jpg")
	断言真(压缩结果(0) = -1)
	断言真(压缩结果(1) = -40)
	断言真(图像.取图片宽度2(压缩结果) > 0)
	断言真(图像.取图片高度2(压缩结果) > 0)
	断言真(图像.取图片宽度2(文本到字节("not an image")) = -1)
	断言真(拒绝非法尺寸())
	断言真(拒绝越界截取())

	显示图片(图像.设置图片倒影(成_原图), "全部自检通过", "png")
	结果.加入文本("\n已验证：尺寸读取、旋转、倾斜、缩放、镜像、圆角、圆形、倒影、截取、分割、PNG/JPEG 格式及无效参数。\n相册扫描为异步请求，需要在系统允许的位置另行观察结果。")
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请检查当前编译和安装的类库版本。"
	结束 错误
结束 事件

过程 校验尺寸(数据 为 字节型(), 宽度 为 整数型, 高度 为 整数型)
	断言真(图像.取图片宽度2(数据) = 宽度)
	断言真(图像.取图片高度2(数据) = 高度)
	断言真(数据(0) = -119)
	断言真(数据(1) = 80)
结束 过程

过程 显示图片(数据 为 字节型(), 操作名称 为 文本型, 格式 为 文本型)
	变量 路径 为 文本型
	路径 = 成_原图路径 & ".preview." & 格式
	断言真(写出字节文件(路径, 数据))
	效果图.图片 = 路径
	结果.文本 = 操作名称 & "\n尺寸：" & 图像.取图片宽度2(数据) & "×" & 图像.取图片高度2(数据) & " 像素\n文件大小：" & 取字节集长度(数据) & " 字节\n输出：" & 路径
结束 过程

函数 拒绝非法尺寸() 为 逻辑型
	图像.缩放图片(成_原图, 0, 40)
	拒绝非法尺寸 = 假
	位于 错误
		分支 否则
			拒绝非法尺寸 = 真
	结束 错误
结束 函数

函数 拒绝越界截取() 为 逻辑型
	图像.取图片部分(成_原图, 100, 0, 40, 20)
	拒绝越界截取 = 假
	位于 错误
		分支 否则
			拒绝越界截取 = 真
	结束 错误
结束 函数

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "图像操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			文本 = "四色色块与白色标记用于观察图像变换。输出仅保存到应用私有目录。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作选项 $为 下拉列表框
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 执行处理 $为 按钮
			文本 = "处理所选效果"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行自检 $为 按钮
			文本 = "运行全部自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 效果图 $为 图片框
			宽度 = 长度_匹配父级
			高度 = 160
			显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
			背景颜色 = 颜色_灰
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待初始化。"
			宽度 = 长度_匹配父级
			高度 = 220
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
