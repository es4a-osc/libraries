''' 结合当前图像操作 API 和 Android Bitmap / Matrix 文档，使用固定小图比较处理效果。
''' https://developer.android.com/reference/android/graphics/Bitmap
''' 所有变换从同一原图开始；输出只写入应用私有目录，不申请外部存储权限。
别名 图像 = simple.library.wsd.image.图像操作

变量 原始字节 为 字节型()
变量 当前字节 为 字节型()
变量 原始路径 为 文本型
变量 当前路径 为 文本型
变量 当前扩展名 为 文本型
变量 分块集 为 集合
变量 分块索引 为 整数型
变量 已准备 为 逻辑型

事件 主窗口.初始化()
	分块集 = 创建 集合
	' 与 assets/source.png 完全相同的固定 PNG 编码，便于直接取得变换所需的字节集。
	原始字节 = Base64解码("")
	如果 创建目录("image-example") 且 写出字节文件("image-example/source.png", 原始字节) 则
		变量 文件列表 为 文本型()
		变量 索引 为 整数型
		文件列表 = 取文件列表("image-example")
		循环 索引 = 0 至 取数组成员数(文件列表) - 1
			如果 取文本右边(文件列表(索引), 10) = "source.png" 则 原始路径 = 文件列表(索引)
		下个
		如果 原始路径 <> "" 则
			显示结果(原始字节, "原图", "png")
			如果 当前路径 <> "" 则
				已准备 = 真
				操作状态.文本 = "资产尺寸=" & 图像.取图片宽度("source.png") & "×" & 图像.取图片高度("source.png") & "；左上白色标记用于观察方向。"
			结束 如果
		结束 如果
	结束 如果
	位于 错误
		分支 否则
			操作状态.文本 = "初始化失败，未准备好可处理的私有图片。"
	结束 错误
结束 事件

''' 字节集必须是图片文件的编码内容；原始像素数组不能直接作为输入。
过程 处理图片(效果编号 为 整数型)
	如果 已准备 则
		变量 输出 为 字节型()
		变量 名称 为 文本型
		变量 后缀 为 文本型
		后缀 = "png"
		下一分块.启用 = 假
		判断 效果编号
			分支 0
				输出 = 图像.旋转图片(原始字节, 90)
				名称 = "顺时针旋转 90 度"
			分支 1
				输出 = 图像.倾斜图片(原始字节, 0.25, 0)
				名称 = "水平错切 0.25（系数，不是角度）"
			分支 2
				输出 = 图像.缩放图片(原始字节, 60, 40)
				名称 = "缩放为 60×40 像素"
			分支 3
				输出 = 图像.反转图片(原始字节, 0)
				名称 = "左右镜像"
			分支 4
				输出 = 图像.反转图片(原始字节, 1)
				名称 = "上下镜像"
			分支 5
				输出 = 图像.取图片部分(原始字节, 30, 20, 60, 40)
				名称 = "从像素 (30,20) 截取 60×40"
			分支 6
				输出 = 图像.设置图片圆角(原始字节, 16)
				名称 = "圆角半径 16 像素"
			分支 7
				输出 = 图像.设置图片圆角(原始字节, 100)
				名称 = "半径参数达到 100，生成居中圆形"
			分支 8
				输出 = 图像.设置图片倒影(原始字节)
				名称 = "添加下半图倒影及渐变"
			分支 9
				分块集 = 图像.切割图片(原始字节, 2, 2)
				分块索引 = 0
				输出 = 分块集.项目(分块索引)
				名称 = "分块 1 / " & 分块集.计数 & "，按行从左到右排列"
				下一分块.启用 = 真
			分支 10
				输出 = 图像.压缩图片(原始字节)
				名称 = "经 JPEG 画质处理，最终仍为 PNG；不保证更小"
			分支 11
				图像.压缩图片2(原始路径, 原始路径 & ".sample.jpg", 40)
				输出 = 读入字节文件(原始路径 & ".sample.jpg")
				后缀 = "jpg"
				名称 = "按目标高度 40 估算采样，实际尺寸见下方"
			分支 否则
				输出 = 原始字节
				名称 = "恢复原图"
		结束 判断
		显示结果(输出, 名称, 后缀)
	否则
		操作状态.文本 = "原图尚未准备好，请重新打开示例。"
	结束 如果
	位于 错误
		分支 否则
			操作状态.文本 = "处理失败，保留上一次可显示的结果。"
	结束 错误
结束 过程

''' 每次重新解码文件显示实际结果，并读取真实文件编码和像素尺寸。
过程 显示结果(数据 为 字节型(), 名称 为 文本型, 后缀 为 文本型)
	变量 路径 为 文本型
	路径 = 原始路径 & ".preview." & 后缀
	如果 写出字节文件(路径, 数据) 则
		当前字节 = 数据
		当前路径 = 路径
		当前扩展名 = 后缀
		结果图.图片 = 路径
		变量 格式 为 文本型
		格式 = "未知"
		如果 数据(0) = -119 且 数据(1) = 80 则 格式 = "PNG"
		如果 数据(0) = -1 且 数据(1) = -40 则 格式 = "JPEG"
		图片状态.文本 = 格式 & "；" & 图像.取图片宽度2(数据) & "×" & 图像.取图片高度2(数据) & " 像素；" & 取字节集长度(数据) & " 字节"
		操作状态.文本 = 名称
	否则
		操作状态.文本 = "预览文件写入失败，保留旧图。"
	结束 如果
结束 过程

事件 下一分块.被单击()
	如果 分块集.计数 > 0 则
		分块索引 = (分块索引 + 1) % 分块集.计数
		变量 数据 为 字节型()
		数据 = 分块集.项目(分块索引)
		显示结果(数据, "分块 " & (分块索引 + 1) & " / " & 分块集.计数 & "，按行从左到右排列", "png")
	结束 如果
结束 事件

事件 保存当前.被单击()
	如果 已准备 则
		变量 路径 为 文本型
		路径 = 原始路径 & ".saved." & 当前扩展名
		如果 写出字节文件(路径, 当前字节) 则
			操作状态.文本 = "已保存私有文件：" & 路径 & "；文件头尺寸=" & 图像.取图片宽度(路径) & "×" & 图像.取图片高度(路径)
		否则
			操作状态.文本 = "保存失败。"
		结束 如果
	结束 如果
结束 事件

事件 无效尺寸.被单击()
	变量 数据 为 字节型()
	数据 = 图像.缩放图片(原始字节, 0, 40)
	操作状态.文本 = "宽度 0 调用意外返回，请核对类库版本。"
	位于 错误
		分支 否则
			操作状态.文本 = "宽度 0 的缩放调用被拒绝；当前结果保留。"
	结束 错误
结束 事件

事件 越界裁剪.被单击()
	变量 数据 为 字节型()
	数据 = 图像.取图片部分(原始字节, 100, 0, 40, 20)
	操作状态.文本 = "越界裁剪意外返回，请核对类库版本。"
	位于 错误
		分支 否则
			操作状态.文本 = "超出原图范围的裁剪被拒绝；当前结果保留。"
	结束 错误
结束 事件

事件 扫描私有图.被单击()
	如果 已准备 则
		图像.更新系统相册(当前路径)
		操作状态.文本 = "已提交私有文件扫描请求；不会复制到公共相册，不保证在相册中显示。"
	结束 如果
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

事件 旋转.被单击()
	处理图片(0)
结束 事件

事件 倾斜.被单击()
	处理图片(1)
结束 事件

事件 缩小.被单击()
	处理图片(2)
结束 事件

事件 水平镜像.被单击()
	处理图片(3)
结束 事件

事件 垂直镜像.被单击()
	处理图片(4)
结束 事件

事件 裁剪.被单击()
	处理图片(5)
结束 事件

事件 圆角.被单击()
	处理图片(6)
结束 事件

事件 圆形.被单击()
	处理图片(7)
结束 事件

事件 倒影.被单击()
	处理图片(8)
结束 事件

事件 分割.被单击()
	处理图片(9)
结束 事件

事件 恢复.被单击()
	处理图片(12)
结束 事件

事件 画质处理.被单击()
	处理图片(10)
结束 事件

事件 采样.被单击()
	处理图片(11)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "图像操作使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "图像处理：原图与结果"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "左为固定原图，右为当前结果。每种效果从原图开始；坐标按图片像素计算。仅用小图演示，大图请放到后台处理。"
		$结束 $定义
		$定义 对照区域 $为 面板
			宽度 = 长度_匹配父级
			高度 = "140dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 原图 $为 图片框
				宽度 = "210dp"
				高度 = "140dp"
				图片 = "source.png"
				显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
				背景颜色 = 颜色_灰
			$结束 $定义
			$定义 结果图 $为 图片框
				宽度 = "210dp"
				高度 = "140dp"
				显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
				背景颜色 = 颜色_灰
			$结束 $定义
		$结束 $定义
		$定义 图片状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "准备中。"
		$结束 $定义
		$定义 几何变换 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 旋转 $为 按钮
				宽度 = "140dp"
				文本 = "旋转 90°"
			$结束 $定义
			$定义 倾斜 $为 按钮
				宽度 = "140dp"
				文本 = "倾斜 0.25"
			$结束 $定义
			$定义 缩小 $为 按钮
				宽度 = "140dp"
				文本 = "缩放 60×40"
			$结束 $定义
		$结束 $定义
		$定义 方向裁剪 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 水平镜像 $为 按钮
				宽度 = "140dp"
				文本 = "左右镜像"
			$结束 $定义
			$定义 垂直镜像 $为 按钮
				宽度 = "140dp"
				文本 = "上下镜像"
			$结束 $定义
			$定义 裁剪 $为 按钮
				宽度 = "140dp"
				文本 = "中间裁剪"
			$结束 $定义
		$结束 $定义
		$定义 遮罩效果 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 圆角 $为 按钮
				宽度 = "140dp"
				文本 = "圆角 16"
			$结束 $定义
			$定义 圆形 $为 按钮
				宽度 = "140dp"
				文本 = "圆形 100"
			$结束 $定义
			$定义 倒影 $为 按钮
				宽度 = "140dp"
				文本 = "添加倒影"
			$结束 $定义
		$结束 $定义
		$定义 分块操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 分割 $为 按钮
				宽度 = "140dp"
				文本 = "分割 2×2"
			$结束 $定义
			$定义 下一分块 $为 按钮
				宽度 = "140dp"
				文本 = "下一分块"
				启用 = 假
			$结束 $定义
			$定义 恢复 $为 按钮
				宽度 = "140dp"
				文本 = "恢复原图"
			$结束 $定义
		$结束 $定义
		$定义 文件输出 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 画质处理 $为 按钮
				宽度 = "140dp"
				文本 = "PNG 画质处理"
			$结束 $定义
			$定义 采样 $为 按钮
				宽度 = "140dp"
				文本 = "JPEG 采样"
			$结束 $定义
			$定义 保存当前 $为 按钮
				宽度 = "140dp"
				文本 = "保存当前"
			$结束 $定义
		$结束 $定义
		$定义 条件提示 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 无效尺寸 $为 按钮
				宽度 = "140dp"
				文本 = "无效尺寸"
			$结束 $定义
			$定义 越界裁剪 $为 按钮
				宽度 = "140dp"
				文本 = "越界裁剪"
			$结束 $定义
			$定义 扫描私有图 $为 按钮
				宽度 = "140dp"
				文本 = "扫描私有图"
			$结束 $定义
		$结束 $定义
		$定义 操作状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "正在初始化。"
		$结束 $定义
	$结束 $定义
$结束 $属性
