''' 页面滑动参考 Android ViewPager 官方示例；本封装直接添加可视组件，不使用 Fragment。
''' https://developer.android.com/develop/ui/views/animations/screen-slide
''' XML 中两个面板会自动成为页面；初始化时再创建并添加一个窗口页面。
变量 已就绪 为 逻辑型
变量 子页 为 详情页
变量 主页点击数 为 整数型
变量 选择次数 为 整数型
变量 滑动事件数 为 整数型
变量 状态轨迹 为 文本型
变量 轨迹长度 为 整数型

事件 主窗口.初始化()
	子页 = 创建 详情页
	页面框.添加页面(子页)
	已就绪 = 真
	更新状态()
结束 事件

过程 更新状态()
	状态.文本 = "页面数=" & 页面框.取页面数() & "；当前索引=" & 页面框.现行页面 & "；选择事件=" & 选择次数
	开关状态.文本 = "禁止触摸滑动=" & 页面框.禁止滑动 & "；程序切换特效=" & 页面框.切换特效
结束 过程

事件 上一页.被单击()
	如果 页面框.现行页面 > 0 则
		页面框.现行页面 = 页面框.现行页面 - 1
	否则
		输出.文本 = "已在第一页或没有页面。"
	结束 如果
	更新状态()
结束 事件

事件 下一页.被单击()
	如果 页面框.现行页面 + 1 < 页面框.取页面数() 则
		页面框.现行页面 = 页面框.现行页面 + 1
	否则
		输出.文本 = "已在最后一页或没有页面。"
	结束 如果
	更新状态()
结束 事件

事件 最后一页.被单击()
	如果 页面框.取页面数() > 0 则
		页面框.现行页面 = 页面框.取页面数() - 1
	否则
		输出.文本 = "当前没有页面，可点恢复三页。"
	结束 如果
	更新状态()
结束 事件

事件 主页按钮.被单击()
	主页点击数 = 主页点击数 + 1
	主页反馈.文本 = "主页按钮已点击 " & 主页点击数 & " 次；翻页后状态保留。"
结束 事件

事件 读取输入.被单击()
	表单反馈.文本 = "当前输入：" & 姓名.文本
结束 事件

事件 滑动开关.被单击()
	页面框.禁止滑动 = 取反 页面框.禁止滑动
	更新状态()
	输出.文本 = "禁用只影响触摸滑动；上一页、下一页等程序切换仍可使用。"
结束 事件

事件 特效开关.被单击()
	页面框.切换特效 = 取反 页面框.切换特效
	更新状态()
	输出.文本 = "下一次程序切页使用当前特效设置；此开关不禁用手势。"
结束 事件

事件 删除当前.被单击()
	如果 页面框.取页面数() > 0 则
		页面框.删除页面(页面框.现行页面)
		输出.文本 = "已删除当前页，后续索引会改变；页面内的组件对象未被销毁。"
	否则
		输出.文本 = "没有可删除的页面。"
	结束 如果
	更新状态()
结束 事件

事件 清空全部.被单击()
	页面框.清空页面()
	更新状态()
	输出.文本 = "已清空；空容器的当前索引为 -1。可重新添加已有页面。"
结束 事件

''' 同一视图不能重复添加；先清空再按原顺序加入，复用现有页面以保留输入和计数。
事件 恢复页面.被单击()
	页面框.清空页面()
	页面框.添加页面(主页)
	页面框.添加页面(表单页)
	页面框.添加页面(子页)
	页面框.禁止滑动 = 假
	页面框.切换特效 = 真
	页面框.现行页面 = 0
	更新状态()
	输出.文本 = "已恢复三页；复用原组件，输入内容及页内点击次数保留。"
结束 事件

事件 无效索引.被单击()
	页面框.现行页面 = 页面框.取页面数()
	位于 错误
		分支 索引超出界限错误
			更新状态()
			输出.文本 = "已拒绝越界索引；页面数量与当前选择保持原状。"
	结束 错误
结束 事件

事件 页面框.页面被选择(索引 为 整数型)
	如果 已就绪 则
		选择次数 = 选择次数 + 1
		输出.文本 = "页面被选择：索引=" & 索引
		更新状态()
	结束 如果
结束 事件

事件 页面框.页面被滑动(索引 为 整数型, 偏移 为 单精度小数型, 像素 为 整数型)
	如果 已就绪 则
		滑动事件数 = 滑动事件数 + 1
		滑动记录.文本 = "滑动事件=" & 滑动事件数 & "；位置=" & 索引 & "；偏移=" & 偏移 & "；像素=" & 像素
	结束 如果
结束 事件

事件 页面框.滑动状态改变(当前状态 为 整数型)
	如果 已就绪 则
		如果 轨迹长度 >= 12 则
			状态轨迹 = ""
			轨迹长度 = 0
		结束 如果
		轨迹长度 = 轨迹长度 + 1
		状态轨迹 = 状态轨迹 & 当前状态 & " "
		状态记录.文本 = "状态轨迹：" & 状态轨迹 & "（0 静止，1 拖动，2 自动滚动）"
	结束 如果
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "滑动页面使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "滑动页面与组件状态"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "索引从 0 开始。左右滑动或使用按钮切换；三页分别是主页面板、表单面板和动态添加的窗口。"
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = ""
			字体加粗 = 真
		$结束 $定义
		$定义 页面框 $为 simple.library.wsd.viewpager.滑动页面框
			宽度 = 长度_匹配父级
			高度 = "235dp"
			$定义 主页 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				背景颜色 = &HFFEAF4FF
				左填充 = "12dp"
				右填充 = "12dp"
				顶填充 = "12dp"
				$定义 主页标题 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 20
					文本 = "第一页 · 主页面板"
					字体加粗 = 真
				$结束 $定义
				$定义 主页说明 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "面板和内部组件直接声明在页面容器中；向左滑动到下一页。"
				$结束 $定义
				$定义 主页按钮 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "点击主页按钮"
				$结束 $定义
				$定义 主页反馈 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "尚未点击。"
				$结束 $定义
			$结束 $定义
			$定义 表单页 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				背景颜色 = &HFFFFF4E3
				左填充 = "12dp"
				右填充 = "12dp"
				顶填充 = "12dp"
				$定义 表单标题 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 20
					文本 = "第二页 · 表单面板"
					字体加粗 = 真
				$结束 $定义
				$定义 姓名 $为 编辑框
					宽度 = 长度_匹配父级
					单行模式 = 真
					文本 = "你好，Simple"
					提示文本 = "输入文字，翻页后再返回"
				$结束 $定义
				$定义 读取输入 $为 按钮
					宽度 = 长度_匹配父级
					文本 = "读取表单内容"
				$结束 $定义
				$定义 表单反馈 $为 标签
					宽度 = 长度_匹配父级
					字体大小 = 14
					文本 = "编辑内容不会因普通翻页而清空。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 导航 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 上一页 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "上一页"
			$结束 $定义
			$定义 下一页 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "下一页"
			$结束 $定义
			$定义 最后一页 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "最后一页"
			$结束 $定义
		$结束 $定义
		$定义 设置行 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 滑动开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "触摸滑动开关"
			$结束 $定义
			$定义 特效开关 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "程序切换特效"
			$结束 $定义
		$结束 $定义
		$定义 页面操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除当前 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "删除当前页"
			$结束 $定义
			$定义 清空全部 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清空全部"
			$结束 $定义
			$定义 恢复页面 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "恢复三页"
			$结束 $定义
		$结束 $定义
		$定义 边界操作 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 无效索引 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "无效索引演示"
			$结束 $定义
		$结束 $定义
		$定义 开关状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = ""
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "点击页内按钮，再翻页观察状态。"
		$结束 $定义
		$定义 滑动记录 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "等待滑动事件。"
		$结束 $定义
		$定义 状态记录 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "等待状态事件。"
		$结束 $定义
	$结束 $定义
$结束 $属性
