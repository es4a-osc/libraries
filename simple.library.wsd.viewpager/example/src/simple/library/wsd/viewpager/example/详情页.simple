''' 作为可视页面嵌入，不调用切换窗口；按钮事件只更新本页的组件。
变量 点击次数 为 整数型

事件 内页按钮.被单击()
	点击次数 = 点击次数 + 1
	内页反馈.文本 = "内嵌窗口按钮已点击 " & 点击次数 & " 次。"
结束 事件

$属性
	$资源 $窗口
	$定义 详情页 $为 窗口
		标题 = "内嵌详情"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = &HFFE9F7EF
		左填充 = "12dp"
		右填充 = "12dp"
		顶填充 = "12dp"
		$定义 页名 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 20
			文本 = "第三页 · 动态窗口页面"
			字体加粗 = 真
		$结束 $定义
		$定义 解释 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "通过“创建 详情页”取得窗口组件，再调用“添加页面”；页内事件由本单元处理。"
		$结束 $定义
		$定义 内页按钮 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "点击内嵌窗口按钮"
		$结束 $定义
		$定义 内页反馈 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "内嵌窗口的组件事件保持独立。"
		$结束 $定义
	$结束 $定义
$结束 $属性
