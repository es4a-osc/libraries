别名 CV日历工具 = simple.library.wsd.calendarview.CV日历工具
别名 CV日历日期 = simple.library.wsd.calendarview.CV日历日期
别名 CV日历配置 = simple.library.wsd.calendarview.CV日历配置
别名 CV日历标记 = simple.library.wsd.calendarview.CV日历标记

变量 来源 为 主窗口
变量 本月 为 CV日历日期

事件 标记窗口.初始化()
	变量 今天日期 为 CV日历日期
	变量 配置 为 CV日历配置
	今天日期 = CV日历工具.取今天()
	本月 = CV日历工具.创建日期(今天日期.年, 今天日期.月, 1)
	配置 = 创建 CV日历配置
	配置.选择模式 = 1
	配置.日项高度 = 44
	日历.应用配置(配置)
结束 事件

''' 每个日期可携带多个独立标记；附加标记返回新日期，不修改原日期。
事件 添加日程.被单击()
	变量 会议 为 CV日历标记
	变量 提醒 为 CV日历标记
	变量 标记 为 CV日历标记(2)
	变量 日期 为 CV日历日期(3)
	会议 = 创建 CV日历标记
	会议.文字 = "会"
	会议.颜色 = &HFF008577
	会议.附加数据 = "例行会议"
	提醒 = 会议.复制()
	提醒.文字 = "备"
	提醒.颜色 = &HFFE64A19
	提醒.附加数据 = "准备材料"
	标记(0) = 会议
	标记(1) = 提醒
	日期(0) = CV日历工具.附加标记(本月, 标记)
	日期(1) = CV日历工具.附加标记(CV日历工具.增加天数(本月, 4), 标记)
	日期(2) = CV日历工具.附加标记(CV日历工具.增加天数(本月, 14), 标记)
	日历.设置全部标记(日期)
	反馈.文本 = "已给本月 1、5、15 日各添加两个标记。点击日期可读取详情。"
结束 事件

事件 追加日程.被单击()
	变量 标记 为 CV日历标记(1)
	变量 日期 为 CV日历日期(1)
	变量 纪念日 为 CV日历标记
	纪念日 = 创建 CV日历标记
	纪念日.文字 = "记"
	纪念日.颜色 = &HFF1976D2
	纪念日.附加数据 = "纪念日"
	标记(0) = 纪念日
	日期(0) = CV日历工具.附加标记(CV日历工具.增加天数(本月, 19), 标记)
	日历.追加标记(日期)
	反馈.文本 = "已追加本月 20 日的纪念日，其他日期保留。"
结束 事件

事件 移除日程.被单击()
	日历.移除标记(本月)
	反馈.文本 = "已移除本月 1 日的标记。"
结束 事件

事件 清空日程.被单击()
	日历.清除标记()
	反馈.文本 = "已清除所有日期标记。"
结束 事件

事件 读取日程.被单击()
	变量 日期 为 CV日历日期()
	变量 项 为 CV日历日期
	日期 = 日历.取全部标记日期()
	反馈.文本 = "共有 " & 取数组成员数(日期) & " 个日期含标记。"
	循环 每个 项 从 日期
		反馈.文本 = 反馈.文本 & "\n" & 项.日期文本 & "：" & 项.标记文字
	下个 项
结束 事件

事件 日历.日期选中(日期 为 CV日历日期, 用户点击 为 逻辑型)
	变量 标记 为 CV日历标记()
	变量 项 为 CV日历标记
	标记 = 日期.取全部标记()
	反馈.文本 = 日期.日期文本 & "，含 " & 取数组成员数(标记) & " 个标记。"
	循环 每个 项 从 标记
		反馈.文本 = 反馈.文本 & "\n" & 项.文字 & "：" & 项.附加数据
	下个 项
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 标记窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 标记窗口 $为 窗口
		标题 = "日程与标记"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		左填充 = "8dp"
		右填充 = "8dp"
		滚动 = 真
		$定义 导航 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				高度 = "42dp"
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 读取日程 $为 按钮
				高度 = "42dp"
				文本 = "读取日程"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "标记保存在内存中；日期和标记对象均为独立快照。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
		$定义 新增 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 添加日程 $为 按钮
				高度 = "42dp"
				文本 = "设置三日日程"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 追加日程 $为 按钮
				高度 = "42dp"
				文本 = "追加 20 日"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 移除 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 移除日程 $为 按钮
				高度 = "42dp"
				文本 = "移除 1 日"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 清空日程 $为 按钮
				高度 = "42dp"
				文本 = "清空日程"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 日历 $为 simple.library.wsd.calendarview.CV日历框
			宽度 = 长度_匹配父级
			高度 = "320dp"
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			高度 = "150dp"
			文本 = "先添加日程，再点击日期读取详细标记。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
	$结束 $定义
$结束 $属性
