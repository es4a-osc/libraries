别名 日历工具 = simple.library.wsd.calendarview.日历工具
别名 日历日期 = simple.library.wsd.calendarview.日历日期
别名 日历配置 = simple.library.wsd.calendarview.日历配置
别名 日历标记 = simple.library.wsd.calendarview.日历标记
别名 日历绘图 = simple.library.wsd.calendarview.日历绘图

变量 来源 为 主窗口
变量 配置 为 日历配置
变量 视图次数 为 整数型
变量 周次数 为 整数型
变量 布局模式 为 整数型
变量 手势启用 为 逻辑型

事件 联动窗口.初始化()
	配置 = 创建 日历配置
	配置.日项高度 = 44
	配置.周栏高度 = 30
	配置.选择模式 = 1
	日历.应用配置(配置)
	变量 索引 为 整数型
	循环 索引 = 1 至 50
		日程.添加项目("日程 " & 索引 & " · 向上滑动列表，向下回到顶部")
	下个 索引
	手势启用 = 真
	更新状态()
结束 事件

事件 展开.被单击()
	变量 接受 为 逻辑型
	接受 = 联动布局.展开(240)
	反馈.文本 = "展开受理=" & 接受
结束 事件

事件 收缩.被单击()
	变量 接受 为 逻辑型
	接受 = 联动布局.收缩(240)
	反馈.文本 = "收缩受理=" & 接受
结束 事件

事件 切换可见.被单击()
	联动布局.显示日历(取反 联动布局.日历可见)
	更新状态()
结束 事件

事件 切换手势.被单击()
	手势启用 = 取反 手势启用
	联动布局.启用收缩手势(手势启用)
	反馈.文本 = "上下收缩手势=" & 手势启用
结束 事件

事件 切换模式.被单击()
	布局模式 = 布局模式 + 1
	如果 布局模式 = 3 则 布局模式 = 0
	联动布局.设置显示模式(布局模式)
	反馈.文本 = "布局模式=" & 布局模式 & "；0 周月、1 仅周、2 仅月。"
结束 事件

事件 读取状态.被单击()
	更新状态()
结束 事件

过程 更新状态()
	状态.文本 = "展开=" & 联动布局.已经展开 & "；可见=" & 联动布局.日历可见 & "；月视图=" & 日历.是月视图 & "；视图事件=" & 视图次数 & "；周事件=" & 周次数
结束 过程

事件 日历.视图改变(是否月视图 为 逻辑型)
	视图次数 = 视图次数 + 1
	反馈.文本 = "日历已经切换，月视图=" & 是否月视图
	更新状态()
结束 事件

事件 日历.周改变(日期 为 日历日期())
	周次数 = 周次数 + 1
	变量 首日 为 日历日期
	首日 = 日期(0)
	反馈.文本 = "当前周包含 " & 取数组成员数(日期) & " 个日期；首日=" & 首日.日期文本
	更新状态()
结束 事件

事件 日历.日期选中(日期 为 日历日期, 用户点击 为 逻辑型)
	反馈.文本 = "查看日程日期：" & 日期.日期文本
结束 事件

事件 日程.项目被单击(索引 为 整数型)
	反馈.文本 = "已点击日程 " & (索引 + 1)
结束 事件

过程 离开页面()
	切换窗口(来源)
结束 过程

事件 返回.被单击()
	离开页面()
结束 事件

事件 联动窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		离开页面()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 联动窗口 $为 窗口
		标题 = "联动窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "6dp"
		背景颜色 = -1
		$定义 返回行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 展开 $为 按钮
				文本 = "展开"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 收缩 $为 按钮
				文本 = "收缩"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 切换可见行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换可见 $为 按钮
				文本 = "显示 / 隐藏"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 切换手势 $为 按钮
				文本 = "收缩手势"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 切换模式 $为 按钮
				文本 = "显示模式"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 读取状态行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 读取状态 $为 按钮
				文本 = "读取状态"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "日历布局状态"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "日历框与列表是日历布局的两个直接子组件。上推可收缩，下拉到顶部可展开。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 联动布局 $为 simple.library.wsd.calendarview.日历布局
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			$定义 日历 $为 simple.library.wsd.calendarview.日历框
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
			$结束 $定义
			$定义 日程 $为 列表框
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
