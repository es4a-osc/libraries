				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 多选模式 $为 按钮
				文本 = "多选"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 日历 $为 simple.library.wsd.calendarview.日历框
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "正在载入日期"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
