			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 删除标记 $为 按钮
				文本 = "移除 1 日标记"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 清空标记 $为 按钮
				文本 = "清空标记"
