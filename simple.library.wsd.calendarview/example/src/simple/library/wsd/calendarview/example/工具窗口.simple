				字体大小 = 13
			$结束 $定义
			$定义 日期减少 $为 按钮
				文本 = "减一天"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 日差 $为 按钮
				文本 = "跨日运算"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
