				高度 = "42dp"
				文本 = "按公历读取"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
			$定义 农历输入 $为 按钮
				高度 = "42dp"
				文本 = "按农历转换"
				宽度 = 0
				权重 = 1
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		标题 = "工具窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "6dp"
		背景颜色 = -1
		$定义 周数补齐行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 周数工具 $为 按钮
				文本 = "周数与高度"
