		$定义 最小日期行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 最小日期 $为 按钮
				文本 = "1900-01-01"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 最大日期 $为 按钮
				文本 = "2099-12-31"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 范围说明 $为 标签
			文本 = "公历支持 1900 至 2099 年；农历输入按转换后的公历范围限制，允许边界对应的农历 1899 年。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 输出 $为 标签
			文本 = "日期详情"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "选择日期案例，查看公农历、节日和日差。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
	$结束 $定义
$结束 $属性
