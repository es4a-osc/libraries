别名 日历工具 = simple.library.wsd.calendarview.日历工具
别名 日历日期 = simple.library.wsd.calendarview.日历日期
别名 日历配置 = simple.library.wsd.calendarview.日历配置
别名 日历标记 = simple.library.wsd.calendarview.日历标记
别名 日历绘图 = simple.library.wsd.calendarview.日历绘图

变量 来源 为 主窗口
变量 当前日期 为 日历日期

事件 工具窗口.初始化()
	当前日期 = 日历工具.取今天()
	显示日期(当前日期)
结束 事件

过程 显示日期(日期 为 日历日期)
	当前日期 = 日期
	输出.文本 = "公历=" & 日期.年 & "-" & 日期.月 & "-" & 日期.日 & "；星期=" & 日期.星期 & "\n农历=" & 日期.农历年 & "-" & 日期.农历月 & "-" & 日期.农历日 & "；闰月=" & 日期.是农历闰月 & "\n显示文字=" & 日期.农历文字 & "\n公历节日=" & 日期.公历节日 & "；传统节日=" & 日期.传统节日 & "\n节气=" & 日期.节气 & "；干支年=" & 日历工具.取干支年(日期.农历年) & "\nUTC 零点=" & 日期.UTC时间戳
结束 过程

事件 今天.被单击()
	显示日期(日历工具.取今天())
结束 事件

事件 春节.被单击()
	显示日期(日历工具.创建日期(2024, 2, 10))
结束 事件

事件 闰月.被单击()
	显示日期(日历工具.农历转公历(2023, 2, 1, 真))
结束 事件

事件 农历还原.被单击()
	变量 农历日期 为 整数型()
	农历日期 = 日历工具.公历转农历(当前日期)
	显示日期(日历工具.农历转公历(农历日期(0), 农历日期(1), 农历日期(2), 农历日期(3) = 1))
	反馈.文本 = "公历 → 农历 → 公历往返完成。"
结束 事件

事件 日期增加.被单击()
	显示日期(日历工具.增加天数(当前日期, 1))
结束 事件

事件 日期减少.被单击()
	显示日期(日历工具.增加天数(当前日期, -1))
结束 事件

事件 日差.被单击()
	变量 起点 为 日历日期
	变量 终点 为 日历日期
	起点 = 日历工具.创建日期(2024, 3, 9)
	终点 = 日历工具.创建日期(2024, 3, 11)
	反馈.文本 = "3 月 9 日至 11 日，公历日差=" & 日历工具.相差天数(终点, 起点) & "；比较=" & 日历工具.比较日期(终点, 起点) & "；同月=" & 日历工具.是否同月(起点, 终点)
结束 事件

事件 年月信息.被单击()
	反馈.文本 = "2024 闰年=" & 日历工具.是否闰年(2024) & "；2023 闰年=" & 日历工具.是否闰年(2023) & "\n2024 年 2 月天数=" & 日历工具.取本月天数(2024, 2) & "；本月实际行数=" & 日历工具.取月份行数(当前日期.年, 当前日期.月, 2, 2)
结束 事件

事件 全年节气.被单击()
	变量 条目 为 文本型()
	变量 索引 为 整数型
	条目 = 日历工具.取全年节气(当前日期.年)
	反馈.文本 = "节气数=" & 取数组成员数(条目)
	循环 索引 = 0 至 取数组成员数(条目) - 1
		反馈.文本 = 反馈.文本 & "\n" & 条目(索引)
	下个 索引
结束 事件

事件 最小日期.被单击()
	显示日期(日历工具.创建日期(1900, 1, 1))
	位于 错误
		分支 否则
			反馈.文本 = "最小日期转换失败。"
	结束 错误
结束 事件

事件 最大日期.被单击()
	显示日期(日历工具.创建日期(2099, 12, 31))
结束 事件

事件 非法日期.被单击()
	变量 日期 为 日历日期
	日期 = 日历工具.创建日期(2023, 2, 29)
	反馈.文本 = "非法日期未被拒绝。"
	位于 错误
		分支 否则
			反馈.文本 = "已拒绝 2023-02-29，日期不会自动滚入下个月。"
	结束 错误
结束 事件

事件 不存在闰月.被单击()
	变量 日期 为 日历日期
	日期 = 日历工具.农历转公历(2024, 2, 1, 真)
	反馈.文本 = "不存在的闰月未被拒绝。"
	位于 错误
		分支 否则
			反馈.文本 = "已拒绝农历 2024 年闰二月，该闰月不存在。"
	结束 错误
结束 事件

过程 离开页面()
	切换窗口(来源)
结束 过程

事件 返回.被单击()
	离开页面()
结束 事件

事件 工具窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		离开页面()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 工具窗口 $为 窗口
		标题 = "工具窗口"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "6dp"
		背景颜色 = -1
		$定义 返回行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 返回 $为 按钮
				文本 = "返回目录"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 今天 $为 按钮
				文本 = "今天"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 春节行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 春节 $为 按钮
				文本 = "2024 春节"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 闰月 $为 按钮
				文本 = "2023 闰二月"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 农历还原 $为 按钮
				文本 = "农历还原"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 日期增加行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 日期增加 $为 按钮
				文本 = "加一天"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 日期减少 $为 按钮
				文本 = "减一天"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 日差 $为 按钮
				文本 = "跨日运算"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 年月信息行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 年月信息 $为 按钮
				文本 = "闰年与月天数"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 全年节气 $为 按钮
				文本 = "全年节气"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 最小日期行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 最小日期 $为 按钮
				文本 = "1900-01-01"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 最大日期 $为 按钮
				文本 = "2099-12-31"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 非法日期行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 非法日期 $为 按钮
				文本 = "拒绝非法日期"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 不存在闰月 $为 按钮
				文本 = "拒绝错误闰月"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 范围说明 $为 标签
			文本 = "公历支持 1900 至 2099 年；农历输入按转换后的公历范围限制，允许边界对应的农历 1899 年。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 输出 $为 标签
			文本 = "日期详情"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 反馈 $为 标签
			文本 = "选择日期案例，查看公农历、节日和日差。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
	$结束 $定义
$结束 $属性
