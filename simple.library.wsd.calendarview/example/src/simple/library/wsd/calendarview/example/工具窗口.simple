				权重 = 1
				高度 = "40dp"
				字体大小 = 12
			$结束 $定义
			$定义 农历天数 $为 按钮
				文本 = "农历月天数"
				宽度 = 0
				权重 = 1
				高度 = "40dp"
				字体大小 = 12
			$结束 $定义
		$结束 $定义
		$定义 春节行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 春节 $为 按钮
				文本 = "2024 春节"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
			$定义 闰月 $为 按钮
