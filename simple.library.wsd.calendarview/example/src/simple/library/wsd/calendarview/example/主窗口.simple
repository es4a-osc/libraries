''' 一个普通 Simple Activity，按窗口展示日期选择、收缩布局、绘制和日期工具。
变量 选择页 为 选择窗口
变量 选择已创建 为 逻辑型
变量 联动页 为 联动窗口
变量 联动已创建 为 逻辑型
变量 绘制页 为 绘制窗口
变量 绘制已创建 为 逻辑型
变量 工具页 为 工具窗口
变量 工具已创建 为 逻辑型

事件 选择入口.被单击()
	如果 取反 选择已创建 则
		选择页 = 创建 选择窗口
		选择页.来源 = 主窗口
		选择已创建 = 真
	结束 如果
	切换窗口(选择页)
结束 事件

事件 联动入口.被单击()
	如果 取反 联动已创建 则
		联动页 = 创建 联动窗口
		联动页.来源 = 主窗口
		联动已创建 = 真
	结束 如果
	切换窗口(联动页)
结束 事件

事件 绘制入口.被单击()
	如果 取反 绘制已创建 则
		绘制页 = 创建 绘制窗口
		绘制页.来源 = 主窗口
		绘制已创建 = 真
	结束 如果
	切换窗口(绘制页)
结束 事件

事件 工具入口.被单击()
	如果 取反 工具已创建 则
		工具页 = 创建 工具窗口
		工具页.来源 = 主窗口
		工具已创建 = 真
	结束 如果
	切换窗口(工具页)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "CV日历示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		左填充 = "8dp"
		右填充 = "8dp"
		顶填充 = "6dp"
		背景颜色 = -1
		$定义 标题 $为 标签
			文本 = "CV日历示例"
			宽度 = 长度_匹配父级
			字体大小 = 25
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 介绍 $为 标签
			文本 = "独立日历、周月收缩和可定制的 Canvas 绘制。示例数据保存在内存中。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 选择入口行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 选择入口 $为 按钮
				文本 = "01  选择与日期标记"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 选择说明 $为 标签
			文本 = "默认、单选、多选、范围，禁用日期和批量日程标记。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 联动入口行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 联动入口 $为 按钮
				文本 = "02  周月收缩联动"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 联动说明 $为 标签
			文本 = "日历布局承载日历框与列表，支持拖动和程序展开、收缩。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 绘制入口行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 绘制入口 $为 按钮
				文本 = "03  外观与自定义绘制"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 绘制说明 $为 标签
			文本 = "内置样式、字体、周起始及 Simple 同步绘制事件。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
		$定义 工具入口行 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 工具入口 $为 按钮
				文本 = "04  公农历与日期工具"
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 工具说明 $为 标签
			文本 = "公农历转换、干支、节气、闰年和严格日期校验。"
			宽度 = 长度_匹配父级
			字体大小 = 14
			顶填充 = "4dp"
			底填充 = "4dp"
			文本颜色 = -15261645
		$结束 $定义
	$结束 $定义
$结束 $属性
