''' 参考 CalendarView 3.7.1 官方日历、选择和绘制示例：
''' https://github.com/huanghaibin-dev/CalendarView
''' 按当前 Simple 组件与事件模型改写。

变量 选择页 为 选择窗口
变量 选择已创建 为 逻辑型
变量 标记页 为 标记窗口
变量 标记已创建 为 逻辑型
变量 联动页 为 联动窗口
变量 联动已创建 为 逻辑型
变量 绘制页 为 绘制窗口
变量 绘制已创建 为 逻辑型
变量 工具页 为 工具窗口
变量 工具已创建 为 逻辑型

事件 选择入口.被单击()
	如果 取反 选择已创建 则
		选择页 = 创建 选择窗口
		选择页.来源 = 主窗口
		选择已创建 = 真
	结束 如果
	切换窗口(选择页)
结束 事件

事件 标记入口.被单击()
	如果 取反 标记已创建 则
		标记页 = 创建 标记窗口
		标记页.来源 = 主窗口
		标记已创建 = 真
	结束 如果
	切换窗口(标记页)
结束 事件

事件 联动入口.被单击()
	如果 取反 联动已创建 则
		联动页 = 创建 联动窗口
		联动页.来源 = 主窗口
		联动已创建 = 真
	结束 如果
	切换窗口(联动页)
结束 事件

事件 绘制入口.被单击()
	如果 取反 绘制已创建 则
		绘制页 = 创建 绘制窗口
		绘制页.来源 = 主窗口
		绘制已创建 = 真
	结束 如果
	切换窗口(绘制页)
结束 事件

事件 工具入口.被单击()
	如果 取反 工具已创建 则
		工具页 = 创建 工具窗口
		工具页.来源 = 主窗口
		工具已创建 = 真
	结束 如果
	切换窗口(工具页)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 取消 为 逻辑型)
	如果 键码 = 键码_返回 则
		取消 = 真
		终止()
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "CV日历示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		背景颜色 = -1
		左填充 = "8dp"
		右填充 = "8dp"
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "CV日历示例"
			字体大小 = 14
			文本颜色 = -15261645
			字体大小 = 24
		$结束 $定义
		$定义 介绍 $为 标签
			宽度 = 长度_匹配父级
			高度 = "56dp"
			文本 = "选择日期、添加日程、收缩联动和自定义绘制。每个按钮直接演示对应操作。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
		$定义 选择入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "01  日期选择"
		$结束 $定义
		$定义 选择说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "单选、范围和多选；选择结果在日历下方显示。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
		$定义 标记入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "02  日程与日期标记"
		$结束 $定义
		$定义 标记说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "给日期添加一个或多个标记，读取和移除日程。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
		$定义 联动入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "03  周月收缩联动"
		$结束 $定义
		$定义 联动说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "日历与列表联动；可拖动，也可用按钮展开和收缩。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
		$定义 绘制入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "04  外观与自定义绘制"
		$结束 $定义
		$定义 绘制说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "配置样式、字体和星期文字，使用同步绘图事件。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
		$定义 工具入口 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "46dp"
			文本 = "05  公农历与日期工具"
		$结束 $定义
		$定义 工具说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "42dp"
			文本 = "输入日期进行公农历转换，计算日差、周数和节气。"
			字体大小 = 14
			文本颜色 = -15261645
		$结束 $定义
	$结束 $定义
$结束 $属性
