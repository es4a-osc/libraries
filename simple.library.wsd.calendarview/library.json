{
	"name": "CalendarView日历库",
	"description": "年月周日历、选择、标记、收缩联动与自定义绘制。",
	"version": "0.1.0",
	"authors": [
		{
			"name": "树先生",
			"email": "xhwsd@qq.com"
		}
	],
	"kind": "library",
	"categories": [
		{
			"name": "扩展可视组件",
			"definitions": [
				{
					"name": "日历框",
					"kind": "component",
					"type": "simple.library.wsd.calendarview.日历框",
					"inherits": [
						"simple.runtime.components.可视组件"
					],
					"description": "年月周日历及选择、标记、绘制；仅在主线程操作，绘制和拦截回调内不能修改日历。",
					"properties": [
						{
							"name": "当前选择",
							"description": "当前焦点日期快照；范围及多选模式的完整选择请读取相应日期数组，尚未选择时为空引用。",
							"type": "simple.library.wsd.calendarview.日历日期",
							"writable": false
						},
						{
							"name": "显示年",
							"description": "月视图当前显示的公历年。",
							"type": "整数型",
							"writable": false
						},
						{
							"name": "显示月",
							"description": "月视图当前显示的公历月。",
							"type": "整数型",
							"writable": false
						},
						{
							"name": "是月视图",
							"description": "当前是否显示月视图；周视图为假。",
							"type": "逻辑型",
							"writable": false
						},
						{
							"name": "年视图已打开",
							"description": "年份快速选择视图是否已打开。",
							"type": "逻辑型",
							"writable": false
						}
					],
					"functions": [
						{
							"name": "应用配置",
							"description": "复制并应用日历配置；不重建日历实例。选择模式改变时清理旧模式的选择，范围内的日期及标记保持独立。",
							"params": [
								{
									"name": "配置",
									"type": "simple.library.wsd.calendarview.日历配置",
									"description": "配置。"
								}
							]
						},
						{
							"name": "取得配置",
							"description": "取得当前配置副本，后续修改副本不改变现有日历。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历配置"
						},
						{
							"name": "设置日期范围",
							"description": "设置包含首尾的公历日期范围；日期必须真实有效且最小不晚于最大。",
							"params": [
								{
									"name": "最小日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "最小日期。"
								},
								{
									"name": "最大日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "最大日期。"
								}
							]
						},
						{
							"name": "取最小日期",
							"description": "读取允许浏览和选择的最小公历日期。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期"
						},
						{
							"name": "取最大日期",
							"description": "读取允许浏览和选择的最大公历日期。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期"
						},
						{
							"name": "跳转日期",
							"description": "跳转到指定日期；范围外或被拦截时返回假。默认自动选择模式不执行日期拦截。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "平滑滚动",
									"type": "逻辑型",
									"description": "平滑滚动。"
								},
								{
									"name": "触发选择事件",
									"type": "逻辑型",
									"description": "触发选择事件。"
								}
							],
							"return": "逻辑型"
						},
						{
							"name": "返回今天",
							"description": "跳转到今天；今天超出允许范围或被拦截时返回假。",
							"params": [
								{
									"name": "平滑滚动",
									"type": "逻辑型",
									"description": "平滑滚动。"
								},
								{
									"name": "触发选择事件",
									"type": "逻辑型",
									"description": "触发选择事件。"
								}
							],
							"return": "逻辑型"
						},
						{
							"name": "前一页",
							"description": "向前翻动当前月、周或年视图。",
							"params": [
								{
									"name": "平滑滚动",
									"type": "逻辑型",
									"description": "平滑滚动。"
								}
							]
						},
						{
							"name": "后一页",
							"description": "向后翻动当前月、周或年视图。",
							"params": [
								{
									"name": "平滑滚动",
									"type": "逻辑型",
									"description": "平滑滚动。"
								}
							]
						},
						{
							"name": "滚动到选择",
							"description": "滚动回当前选中日期。",
							"params": []
						},
						{
							"name": "打开年视图",
							"description": "打开指定年份的快速选月视图；年份须处于当前日期范围内。",
							"params": [
								{
									"name": "年份",
									"type": "整数型",
									"description": "年份。"
								}
							]
						},
						{
							"name": "关闭年视图",
							"description": "关闭年份快速选择视图。",
							"params": []
						},
						{
							"name": "取当前月日期",
							"description": "读取当前月视图中的日期快照，包括该显示方式的填充日期。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期()"
						},
						{
							"name": "取当前周日期",
							"description": "读取当前周视图的七个日期快照。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期()"
						},
						{
							"name": "取多选日期",
							"description": "按公历顺序读取全部多选日期。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期()"
						},
						{
							"name": "取范围日期",
							"description": "读取当前完整范围中未被拦截的日期；未完成范围选择时为空数组。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期()"
						},
						{
							"name": "取全部标记日期",
							"description": "按公历顺序读取全部标记日期及其独立标记副本。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期()"
						},
						{
							"name": "加入多选",
							"description": "批量加入多选，要求当前为多选模式；整批先校验范围、拦截及数量，失败不部分写入。",
							"params": [
								{
									"name": "日期数组",
									"type": "simple.library.wsd.calendarview.日历日期()",
									"description": "日期数组。"
								}
							]
						},
						{
							"name": "移除多选",
							"description": "移除指定多选日期，要求当前为多选模式。",
							"params": [
								{
									"name": "日期数组",
									"type": "simple.library.wsd.calendarview.日历日期()",
									"description": "日期数组。"
								}
							]
						},
						{
							"name": "清除单选",
							"description": "清除当前单选日期。",
							"params": []
						},
						{
							"name": "清除多选",
							"description": "清除全部多选日期。",
							"params": []
						},
						{
							"name": "清除范围",
							"description": "清除已选择的范围及起点。",
							"params": []
						},
						{
							"name": "设置范围选择",
							"description": "设置包含首尾的选择范围，要求范围选择模式；先校验边界、端点拦截及跨度，失败返回假。",
							"params": [
								{
									"name": "起点",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "起点。"
								},
								{
									"name": "终点",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "终点。"
								}
							],
							"return": "逻辑型"
						},
						{
							"name": "设置范围起点",
							"description": "设置范围选择起点并清除原终点，要求范围选择模式。",
							"params": [
								{
									"name": "起点",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "起点。"
								}
							],
							"return": "逻辑型"
						},
						{
							"name": "设置范围终点",
							"description": "为已有起点设置终点；须满足日期顺序、端点拦截和跨度限制。",
							"params": [
								{
									"name": "终点",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "终点。"
								}
							],
							"return": "逻辑型"
						},
						{
							"name": "设置全部标记",
							"description": "以携带标记的日期数组替换全部标记；使用日历工具附加标记构造输入。",
							"params": [
								{
									"name": "标记日期",
									"type": "simple.library.wsd.calendarview.日历日期()",
									"description": "标记日期。"
								}
							]
						},
						{
							"name": "追加标记",
							"description": "批量增加或替换指定日期的标记，其它日期保持不变。",
							"params": [
								{
									"name": "标记日期",
									"type": "simple.library.wsd.calendarview.日历日期()",
									"description": "标记日期。"
								}
							]
						},
						{
							"name": "移除标记",
							"description": "移除指定日期的全部标记。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								}
							]
						},
						{
							"name": "清除标记",
							"description": "移除全部日期标记。",
							"params": []
						},
						{
							"name": "设置禁用日期",
							"description": "替换禁用日期集合；单选、范围及多选模式生效，默认自动选择模式不拦截。",
							"params": [
								{
									"name": "日期数组",
									"type": "simple.library.wsd.calendarview.日历日期()",
									"description": "日期数组。"
								}
							]
						},
						{
							"name": "取禁用日期",
							"description": "按公历顺序读取禁用日期的副本数组。",
							"params": [],
							"return": "simple.library.wsd.calendarview.日历日期()"
						},
						{
							"name": "启用日期拦截",
							"description": "是否同步触发日期拦截事件；默认关闭。处理器只计算条件，不能在拦截回调中修改日历。",
							"params": [
								{
									"name": "启用",
									"type": "逻辑型",
									"description": "启用。"
								}
							]
						},
						{
							"name": "刷新今天",
							"description": "重新读取系统日期，更新今天的标识和相关视图。",
							"params": []
						},
						{
							"name": "请求重绘",
							"description": "重绘月、周、年视图及星期栏，不修改选择和标记。",
							"params": []
						},
						{
							"name": "载入绘制图片",
							"description": "预先载入供绘制事件使用的图片；支持资产、绝对路径及内容 URI，返回图片编号。",
							"params": [
								{
									"name": "图片路径",
									"type": "文本型",
									"description": "图片路径。"
								}
							],
							"return": "整数型"
						},
						{
							"name": "载入绘制图片字节",
							"description": "预先载入图片字节，压缩数据上限 16 MiB；图片采样到最长边 1024 像素。",
							"params": [
								{
									"name": "图片数据",
									"type": "字节型()",
									"description": "图片数据。"
								}
							],
							"return": "整数型"
						},
						{
							"name": "释放绘制图片",
							"description": "释放本日历预先载入的图片，重复释放无副作用。",
							"params": [
								{
									"name": "图片编号",
									"type": "整数型",
									"description": "图片编号。"
								}
							]
						}
					],
					"events": [
						{
							"name": "日期选中",
							"description": "单选或默认自动选择完成时触发；用户点击为假表示程序调用或自动切换。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "用户点击",
									"type": "逻辑型",
									"description": "用户点击。"
								}
							]
						},
						{
							"name": "日期越界",
							"description": "尝试选择超出当前允许范围的日期时触发。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								}
							]
						},
						{
							"name": "范围选择",
							"description": "选择范围的起点或终点时触发。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "是否终点",
									"type": "逻辑型",
									"description": "是否终点。"
								}
							]
						},
						{
							"name": "跨度越界",
							"description": "范围的包含首尾天数不符合限制时触发。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "小于最小跨度",
									"type": "逻辑型",
									"description": "小于最小跨度。"
								}
							]
						},
						{
							"name": "多选改变",
							"description": "用户或程序加入、移除多选后触发，携带操作后的数量与选择状态。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "当前数量",
									"type": "整数型",
									"description": "当前数量。"
								},
								{
									"name": "最大数量",
									"type": "整数型",
									"description": "最大数量。"
								},
								{
									"name": "当前已选中",
									"type": "逻辑型",
									"description": "当前已选中。"
								}
							]
						},
						{
							"name": "多选数量超限",
							"description": "尝试加入超过多选数量上限的日期时触发。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "最大数量",
									"type": "整数型",
									"description": "最大数量。"
								}
							]
						},
						{
							"name": "日期长按",
							"description": "长按有效日期时触发，是否同时选择由配置决定。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								}
							]
						},
						{
							"name": "长按越界",
							"description": "长按超出当前允许范围的日期时触发。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								}
							]
						},
						{
							"name": "日期拦截",
							"description": "启用日期拦截后同步查询是否禁用该日；该事件可能在绘制时频繁调用，只能计算条件。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "禁止",
									"type": "逻辑型",
									"description": "禁止。",
									"byRef": true
								}
							]
						},
						{
							"name": "日期被拦截",
							"description": "尝试选择被禁用的日期时触发。",
							"params": [
								{
									"name": "日期",
									"type": "simple.library.wsd.calendarview.日历日期",
									"description": "日期。"
								},
								{
									"name": "用户点击",
									"type": "逻辑型",
									"description": "用户点击。"
								}
							]
						},
						{
							"name": "年份改变",
							"description": "年份选择视图切换年份时触发。",
							"params": [
								{
									"name": "年份",
									"type": "整数型",
									"description": "年份。"
								}
							]
						},
						{
							"name": "月份改变",
							"description": "月视图切换月份时触发。",
							"params": [
								{
									"name": "年",
									"type": "整数型",
									"description": "年。"
								},
								{
									"name": "月",
									"type": "整数型",
									"description": "月。"
								}
							]
						},
						{
							"name": "周改变",
							"description": "周视图切换到其它周时触发。",
							"params": [
								{
									"name": "本周日期",
									"type": "simple.library.wsd.calendarview.日历日期()",
									"description": "本周日期。"
								}
							]
						},
						{
							"name": "视图改变",
							"description": "日历在月、周视图间转换时触发。",
							"params": [
								{
									"name": "是否月视图",
									"type": "逻辑型",
									"description": "是否月视图。"
								}
							]
						},
						{
							"name": "年视图改变",
							"description": "年份选择视图打开或关闭时触发。",
							"params": [
								{
									"name": "是否打开",
									"type": "逻辑型",
									"description": "是否打开。"
								}
							]
						},
						{
							"name": "边距被点击",
							"description": "点击日历内边距时触发，坐标单位 DIP；没有相邻日期时为空引用。",
							"params": [
								{
									"name": "横坐标",
									"type": "单精度小数型",
									"description": "横坐标。"
								},
								{
									"name": "纵坐标",
									"type": "单精度小数型",
									"description": "纵坐标。"
								},
								{
									"name": "是否月视图",
