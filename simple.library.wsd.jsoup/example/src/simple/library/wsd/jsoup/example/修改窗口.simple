变量 来源 为 主窗口

变量 文档 为 HTML文档
变量 初始文本 为 文本型

过程 载入(文本 为 文本型)
	初始文本 = 文本
	文档 = HTML解析器.解析文本(文本, "https://example.test/catalog/")
	预览.文本 = 文档.取所有文本()
结束 过程

事件 改书名.被单击()
	变量 书 为 HTML元素
	变量 副本 为 HTML元素
	书 = 文档.查询首个("li")
	副本 = 书.复制()
	书.置文本("新书名 <纯文本>")
	书.添加类名("recommended")
	书.置数据属性("price", "20")
	预览.文本 = 文档.取所有文本()
	输出.文本 = "原节点已改：" & 书.取HTML文本() & "\n独立副本：" & 副本.取HTML文本()
结束 事件

事件 添加书.被单击()
	变量 容器 为 HTML元素
	变量 新书 为 HTML元素
	容器 = 文档.查询首个("#books")
	新书 = 文档.创建元素("li")
	新书.置文本("节点创建的新书")
	新书.添加类名("book")
	新书.置数据属性("price", "28")
	容器.追加节点(新书)
	预览.文本 = 文档.取所有文本()
	输出.文本 = 新书.取HTML文本()
结束 事件

事件 移动末项.被单击()
	变量 书单 为 HTML元素列表
	变量 最后 为 HTML元素
	变量 容器 为 HTML元素
	书单 = 文档.查询元素("li")
	最后 = 书单.尾元素()
	容器 = 文档.查询首个("#books")
	容器.首部插入节点(最后)
	预览.文本 = 文档.取所有文本()
	输出.文本 = "末项已移动到首部：" & 容器.取内部HTML()
结束 事件

事件 批量属性.被单击()
	变量 书单 为 HTML元素列表
	书单 = 文档.查询元素("li")
	书单.置属性值("data-reviewed", "yes")
	书单.添加类名("reviewed")
	输出.文本 = 书单.取HTML文本()
结束 事件

事件 删除书.被单击()
	变量 书单 为 HTML元素列表
	书单 = 文档.查询元素("li[data-price='35']")
	书单.移除()
	预览.文本 = 文档.取所有文本()
	输出.文本 = "移除数量：" & 书单.取成员数() & "；旧列表保留成员引用。"
结束 事件

事件 重置.被单击()
	载入(初始文本)
	输出.文本 = "书单已重置。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 修改窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 修改窗口 $为 窗口
		标题 = "2. 修改与复制"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "32dp"
			文本 = "2. 修改与复制"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "72dp"
			文本 = "修改后更新上方正文预览。元素和查询列表共享节点，复制得到独立树。节点移动不会复制或联网。"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 改书名 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "改首本、类名和 data 属性"
				$结束 $定义
				$定义 添加书 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "创建节点并追加书籍"
				$结束 $定义
				$定义 移动末项 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "把末项移到首部"
				$结束 $定义
				$定义 批量属性 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "批量标记书单"
				$结束 $定义
				$定义 删除书 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "移除价格 35 的书"
				$结束 $定义
				$定义 重置 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "重置书单"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
