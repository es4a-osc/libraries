变量 来源 为 主窗口

过程 载入(文本 为 文本型)
	输出.文本 = "点击按钮查看结果。"
结束 过程

事件 XML解析.被单击()
	变量 配置 为 HTML解析配置
	变量 文档 为 HTML文档
	变量 节点 为 HTML元素
	配置 = HTML解析配置.创建XML配置()
	配置.记录源码位置 = 真
	文档 = HTML解析器.按配置解析(输入.文本, "", 配置)
	节点 = 文档.查询首个("Item")
	如果 节点 = 空 则
		输出.文本 = "没有 Item 元素，可检查输入。"
		退出 事件
	结束 如果
	预览.文本 = 文档.取HTML文本()
	输出.文本 = "标签：" & 节点.取标签名称() & "；ID=" & 节点.取属性值("ID") & "\n起始字符位置：" & 节点.取源码开始位置() & "\n保留大小写：" & 配置.保留标签大小写
结束 事件

事件 记录错误.被单击()
	变量 配置 为 HTML解析配置
	变量 文档 为 HTML文档
	变量 错误集 为 文本型()
	配置 = 创建 HTML解析配置
	配置.错误记录上限 = 5
	文档 = HTML解析器.按配置解析("<p><a><a>缺少结束标签</p>", "", 配置)
	错误集 = 文档.取解析错误()
	输出.文本 = "已记录 " & 取数组成员数(错误集) & " 项 HTML 修复信息：\n" & 错误集(0)
结束 事件

事件 紧凑输出.被单击()
	变量 文档 为 HTML文档
	变量 配置 为 HTML输出配置
	文档 = HTML解析器.解析文本("<p>中文 &amp; 空格</p><br>")
	配置 = 创建 HTML输出配置
	配置.美化排版 = 假
	配置.语法 = HTML输出配置.语法_XML
	配置.编码 = "US-ASCII"
	配置.实体模式 = HTML输出配置.实体_XHTML
	文档.置输出配置(配置)
	输出.文本 = 文档.取HTML文本()
结束 事件

事件 编码声明.被单击()
	变量 文档 为 HTML文档
	文档 = HTML解析器.解析文本("<p>中文</p>")
	文档.置文档编码("UTF-8")
	输出.文本 = 文档.取HTML文本()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 配置窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 配置窗口 $为 窗口
		标题 = "4. XML 与输出配置"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "32dp"
			文本 = "4. XML 与输出配置"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "72dp"
			文本 = "XML 配置默认保留大小写。源码位置是初次解析的 UTF-16 字符位置；DOM 修改后不重新计算。输出配置应用时复制。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "80dp"
			文本 = "<Root><Item ID=\"A\">中文</Item></Root>"
		$结束 $定义
		$定义 预览 $为 标签
			宽度 = 长度_匹配父级
			高度 = "70dp"
			文本 = ""
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 XML解析 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "按配置解析输入 XML"
				$结束 $定义
				$定义 记录错误 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "记录不完整 HTML 的修复信息"
				$结束 $定义
				$定义 紧凑输出 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "紧凑 XML 语法与 ASCII 实体"
				$结束 $定义
				$定义 编码声明 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "同步文档编码声明"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
