''' 查询与提取方式参考 jsoup 官方 Cookbook；仅使用当前封装接口。
''' https://jsoup.org/cookbook/extracting-data/selector-syntax
''' 完整演示 HTML 存在 assets/catalog.html，不联网或执行网页脚本。
别名 解析器 = simple.library.wsd.jsoup.HTML解析器
别名 文档类型 = simple.library.wsd.jsoup.HTML文档
别名 元素类型 = simple.library.wsd.jsoup.HTML元素
别名 列表类型 = simple.library.wsd.jsoup.HTML元素列表

变量 当前HTML 为 文本型
变量 工作HTML 为 文本型
变量 返回HTML 为 文本型
变量 工作选择器 为 文本型
变量 操作编号 为 整数型
变量 预设编号 为 整数型
变量 忙碌 为 逻辑型

事件 主窗口.初始化()
	开始处理(0)
结束 事件

事件 查询按钮.被单击()
	开始处理(1)
结束 事件
事件 提取书单.被单击()
	开始处理(2)
结束 事件
事件 解析链接.被单击()
	开始处理(3)
结束 事件
事件 修改首项.被单击()
	开始处理(4)
结束 事件
事件 添加书籍.被单击()
	开始处理(5)
结束 事件
事件 删除高价.被单击()
	开始处理(6)
结束 事件
事件 保存文件.被单击()
	开始处理(7)
结束 事件
事件 恢复资产.被单击()
	开始处理(0)
结束 事件
事件 空缺资产.被单击()
	开始处理(8)
结束 事件
事件 片段演示.被单击()
	开始处理(9)
结束 事件

事件 切换选择器.被单击()
	预设编号 = 预设编号 + 1
	判断 预设编号
		分支 1
			选择器.文本 = ".book[data-price='12'] .name"
		分支 2
			选择器.文本 = "#greeting"
		分支 3
			选择器.文本 = ".not-found"
		分支 4
			选择器.文本 = "["
		分支 否则
			选择器.文本 = ".book .name"
			预设编号 = 0
	结束 判断
	输出.文本 = "已切换 CSS 选择器，点查询查看匹配结果；也可直接编辑。"
结束 事件

''' 界面只传递文本；每次后台任务独立解析，不共享 HTML 元素或文档对象。
过程 开始处理(编号 为 整数型)
	如果 忙碌 则 退出 过程
	忙碌 = 真
	操作编号 = 编号
	工作HTML = 当前HTML
	返回HTML = 当前HTML
	工作选择器 = 选择器.文本
	置操作状态(假)
	输出.文本 = "正在后台解析本地 HTML..."
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			置操作状态(真)
			输出.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

过程 置操作状态(可用 为 逻辑型)
	查询按钮.启用 = 可用
	切换选择器.启用 = 可用
	选择器.启用 = 可用
	提取书单.启用 = 可用
	解析链接.启用 = 可用
	修改首项.启用 = 可用
	添加书籍.启用 = 可用
	删除高价.启用 = 可用
	保存文件.启用 = 可用
	恢复资产.启用 = 可用
	空缺资产.启用 = 可用
	片段演示.启用 = 可用
结束 过程

过程 后台处理()
	变量 文档 为 文档类型
	变量 临时文档 为 文档类型
	变量 列表 为 列表类型
	变量 项 为 元素类型
	变量 副本 为 元素类型
	变量 说明 为 文本型
	变量 索引 为 整数型
	如果 操作编号 = 0 则
		文档 = 解析器.解析资产("catalog.html", "UTF-8", "https://example.test/catalog/")
		说明 = "已从 assets/catalog.html 读取演示书单。"
	否则
		文档 = 解析器.解析文本(工作HTML, "https://example.test/catalog/")
		判断 操作编号
			分支 1
				列表 = 文档.查询元素(工作选择器)
				说明 = "选择器：" & 工作选择器 & "\n匹配 " & 列表.取成员数() & " 项；文本：" & 列表.取所有文本()
				项 = 列表.首元素()
				如果 项 = 空 则
					说明 = 说明 & "\n首元素为空，跳过读取。"
				否则
					说明 = 说明 & "\n首项 HTML：" & 项.取HTML文本()
				结束 如果
			分支 2
				列表 = 文档.查询元素("#books > li.book")
				说明 = "书单：" & 列表.取成员数() & " 本\n"
				循环 索引 = 0 至 列表.取成员数() - 1
					项 = 列表.取成员(索引)
					说明 = 说明 & (索引 + 1) & ". " & 项.取所有文本() & "；价格=" & 项.取属性值("data-price") & "\n"
				下个 索引
			分支 3
				列表 = 文档.查询元素("a[href]")
				说明 = "仅补全链接，不请求网页：\n"
				循环 索引 = 0 至 列表.取成员数() - 1
					项 = 列表.取成员(索引)
					说明 = 说明 & 项.取所有文本() & " → " & 项.取URL("href") & "\n"
				下个 索引
			分支 4
				项 = 文档.查询首个(".book .name")
				如果 项 = 空 则
					说明 = "当前没有书籍，可先恢复资产。"
				否则
					副本 = 项.复制()
					项.置文本("更新后的书名😀")
					项.置属性值("data-edited", "yes")
					说明 = "查询结果已修改原文档：" & 项.取所有文本() & "\n修改前的独立副本：" & 副本.取所有文本()
				结束 如果
			分支 5
				项 = 文档.取节点自ID("books")
				如果 项 <> 空 则
					项 = 项.创建子元素("li")
					项.置属性值("class", "book")
					项.置属性值("data-price", "45")
					项 = 项.创建子元素("a")
					项.置属性值("class", "name")
					项.置属性值("href", "books/new")
					项.置文本("新添书籍😀")
					说明 = "已创建 li 和 a 元素并插入当前文档。"
				结束 如果
			分支 6
				列表 = 文档.查询元素(".book[data-price='35'], .book[data-price='45']")
				说明 = "移除价格为 35 或 45 的书：" & 列表.取成员数() & " 项。"
				列表.移除()
			分支 7
				创建目录("html-example")
				如果 写出文本文件("html-example/catalog.html", 文档.取HTML文本()) 则
					临时文档 = 解析器.解析文件("html-example/catalog.html", "UTF-8", "https://example.test/catalog/")
					说明 = "已保存并重新解析私有文件：html-example/catalog.html\n标题=" & 临时文档.取标题() & "；正文=" & 临时文档.取所有文本()
				结束 如果
			分支 8
				临时文档 = 解析器.解析资产("missing-demo.html", "UTF-8", "")
			分支 9
				临时文档 = 解析器.解析片段("<p>不完整片段<b>加粗", "")
				项 = 临时文档.取主体元素()
				说明 = "HTML 解析会补全缺失的结束标签：\n" & 项.取内部HTML()
		结束 判断
	结束 如果
	返回HTML = 文档.取HTML文本()
	列表 = 文档.查询元素(".book")
	投递消息("完成", "标题：" & 文档.取标题() & "；书籍=" & 列表.取成员数() & "\n" & 说明)
	位于 错误
		分支 非法参数错误
			投递消息("失败", "CSS 选择器或参数无效；当前文档保留。")
		分支 文件读写错误
			投递消息("失败", "HTML 资产或文件无法读取；当前文档保留。")
		分支 否则
			投递消息("失败", "操作失败，当前文档保留；可查看运行日志。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	如果 消息标记 = "完成" 则 当前HTML = 返回HTML
	输出.文本 = 附加参数
	忙碌 = 假
	置操作状态(真)
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 取反 忙碌 则 终止()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "HTML 解析使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 22
			文本 = "从 HTML 提取和修改书单"
			字体加粗 = 真
		$结束 $定义
		$定义 提示 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "页面源文件在 assets/catalog.html。只解析本地数据，不执行 JavaScript，不下载链接内容。"
		$结束 $定义
		$定义 选择器 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = ".book .name"
		$结束 $定义
		$定义 查询区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 查询按钮 $为 按钮
				宽度 = "210dp"
				文本 = "查询 CSS"
			$结束 $定义
			$定义 切换选择器 $为 按钮
				宽度 = "210dp"
				文本 = "切换预设选择器"
			$结束 $定义
		$结束 $定义
		$定义 提取区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 提取书单 $为 按钮
				宽度 = "210dp"
				文本 = "提取书名与价格"
			$结束 $定义
			$定义 解析链接 $为 按钮
				宽度 = "210dp"
				文本 = "补全相对链接"
			$结束 $定义
		$结束 $定义
		$定义 编辑区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 修改首项 $为 按钮
				宽度 = "210dp"
				文本 = "修改首本书名"
			$结束 $定义
			$定义 添加书籍 $为 按钮
				宽度 = "210dp"
				文本 = "创建并追加书籍"
			$结束 $定义
		$结束 $定义
		$定义 保存区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除高价 $为 按钮
				宽度 = "210dp"
				文本 = "移除价格35或45"
			$结束 $定义
			$定义 保存文件 $为 按钮
				宽度 = "210dp"
				文本 = "保存并解析文件"
			$结束 $定义
		$结束 $定义
		$定义 辅助区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 片段演示 $为 按钮
				宽度 = "210dp"
				文本 = "补全不完整片段"
			$结束 $定义
			$定义 空缺资产 $为 按钮
				宽度 = "210dp"
				文本 = "读取不存在的资产"
			$结束 $定义
		$结束 $定义
		$定义 恢复区 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 恢复资产 $为 按钮
				宽度 = "210dp"
				文本 = "重新读取原资产"
			$结束 $定义
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "正在载入演示资产。"
		$结束 $定义
		$定义 边界说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "编辑只影响当前内存文档；保存位置是应用私有目录。查询索引从 0 开始，空结果先判断再读取。"
		$结束 $定义
	$结束 $定义
$结束 $属性
