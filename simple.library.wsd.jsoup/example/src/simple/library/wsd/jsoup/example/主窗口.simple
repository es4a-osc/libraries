别名 HTML解析器 = simple.library.wsd.jsoup.HTML解析器
别名 HTML文档 = simple.library.wsd.jsoup.HTML文档
别名 HTML元素 = simple.library.wsd.jsoup.HTML元素
别名 HTML元素列表 = simple.library.wsd.jsoup.HTML元素列表
别名 HTML节点 = simple.library.wsd.jsoup.HTML节点
别名 HTML输出配置 = simple.library.wsd.jsoup.HTML输出配置
别名 HTML解析配置 = simple.library.wsd.jsoup.HTML解析配置
别名 HTML安全名单 = simple.library.wsd.jsoup.HTML安全名单
别名 HTML节点访问器 = simple.library.wsd.jsoup.HTML节点访问器

变量 页面0 为 查询窗口
变量 已创建0 为 逻辑型
变量 页面1 为 修改窗口
变量 已创建1 为 逻辑型
变量 页面2 为 清洗窗口
变量 已创建2 为 逻辑型
变量 页面3 为 配置窗口
变量 已创建3 为 逻辑型
变量 页面4 为 节点窗口
变量 已创建4 为 逻辑型
变量 页面5 为 输入窗口
变量 已创建5 为 逻辑型

函数 取初始HTML() 为 文本型
	取初始HTML = "<title>Simple 书单</title><ul id=\"books\"><li class=\"book\" data-price=\"12\"><a href=\"books/1\">语言入门</a></li><li class=\"book\" data-price=\"35\"><a href=\"../android\">Android 实践</a></li></ul>"
结束 函数

事件 入口0.被单击()
	如果 取反 已创建0 则
		页面0 = 创建 查询窗口
		页面0.来源 = 主窗口
		页面0.载入(取初始HTML())
		已创建0 = 真
	结束 如果
	切换窗口(页面0)
结束 事件

事件 入口1.被单击()
	如果 取反 已创建1 则
		页面1 = 创建 修改窗口
		页面1.来源 = 主窗口
		页面1.载入(取初始HTML())
		已创建1 = 真
	结束 如果
	切换窗口(页面1)
结束 事件

事件 入口2.被单击()
	如果 取反 已创建2 则
		页面2 = 创建 清洗窗口
		页面2.来源 = 主窗口
		页面2.载入(取初始HTML())
		已创建2 = 真
	结束 如果
	切换窗口(页面2)
结束 事件

事件 入口3.被单击()
	如果 取反 已创建3 则
		页面3 = 创建 配置窗口
		页面3.来源 = 主窗口
		页面3.载入(取初始HTML())
		已创建3 = 真
	结束 如果
	切换窗口(页面3)
结束 事件

事件 入口4.被单击()
	如果 取反 已创建4 则
		页面4 = 创建 节点窗口
		页面4.来源 = 主窗口
		页面4.载入(取初始HTML())
		已创建4 = 真
	结束 如果
	切换窗口(页面4)
结束 事件

事件 入口5.被单击()
	如果 取反 已创建5 则
		页面5 = 创建 输入窗口
		页面5.来源 = 主窗口
		页面5.载入(取初始HTML())
		已创建5 = 真
	结束 如果
	切换窗口(页面5)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "HTML 解析示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		背景颜色 = -1
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "HTML 解析示例"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "从本地书单学习 jsoup。各页按钮直接调用 API；不执行 JavaScript，不自动访问链接。文件操作放在后台线程。"
		$结束 $定义
		$定义 入口0 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "1. 查询与提取"
		$结束 $定义
		$定义 说明0 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "CSS、XPath、列表筛选和相对链接"
		$结束 $定义
		$定义 入口1 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "2. 修改与复制"
		$结束 $定义
		$定义 说明1 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "元素、文本、属性和节点移动"
		$结束 $定义
		$定义 入口2 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "3. 正文清洗"
		$结束 $定义
		$定义 说明2 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "允许名单、链接协议、字符实体"
		$结束 $定义
		$定义 入口3 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "4. XML 与输出配置"
		$结束 $定义
		$定义 说明3 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "大小写、源码位置、错误和排版"
		$结束 $定义
		$定义 入口4 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "5. 节点与遍历"
		$结束 $定义
		$定义 说明4 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "文本、注释、访问回调与移除"
		$结束 $定义
		$定义 入口5 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "44dp"
			文本 = "6. 文件与表单"
		$结束 $定义
		$定义 说明5 $为 标签
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			文本 = "资产、私有文件、编码与表单字段"
		$结束 $定义
	$结束 $定义
$结束 $属性
