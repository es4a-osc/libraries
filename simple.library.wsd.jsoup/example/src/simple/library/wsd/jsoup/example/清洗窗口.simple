变量 来源 为 主窗口

过程 载入(文本 为 文本型)
	输出.文本 = "点击按钮查看结果。"
结束 过程

事件 清洗.被单击()
	变量 名单 为 HTML安全名单
	变量 配置 为 HTML输出配置
	名单 = HTML安全名单.创建带图片基本()
	配置 = 创建 HTML输出配置
	配置.美化排版 = 假
	输出.文本 = HTML解析器.清洗片段(输入.文本, "https://example.test/", 名单, 配置)
	位于 错误
		分支 非法参数错误
			输出.文本 = "清洗参数无效。"
	结束 错误
结束 事件

事件 自定义.被单击()
	变量 名单 为 HTML安全名单
	变量 配置 为 HTML输出配置
	名单 = HTML安全名单.创建基本()
	名单.添加标签("mark")
	名单.添加属性("mark", "class")
	名单.强制属性("mark", "data-safe", "yes")
	配置 = 创建 HTML输出配置
	配置.美化排版 = 假
	输出.文本 = HTML解析器.清洗片段("<mark class='hot' onclick='bad()'>重点</mark>", "", 名单, 配置)
结束 事件

事件 协议.被单击()
	变量 名单 为 HTML安全名单
	变量 配置 为 HTML输出配置
	名单 = HTML安全名单.创建基本()
	名单.移除协议("a", "href", "http")
	名单.保留相对链接 = 真
	配置 = 创建 HTML输出配置
	配置.美化排版 = 假
	输出.文本 = HTML解析器.清洗片段("<a href='guide'>相对链接</a><a href='http://example.test'>HTTP</a>", "https://example.test/", 名单, 配置)
结束 事件

事件 校验.被单击()
	变量 名单 为 HTML安全名单
	名单 = HTML安全名单.创建基本()
	输出.文本 = "符合名单：" & HTML解析器.片段是否安全(输入.文本, 名单) & "\n展示或保存时仍使用清洗后的输出。"
结束 事件

事件 实体.被单击()
	变量 配置 为 HTML输出配置
	配置 = 创建 HTML输出配置
	输出.文本 = "转义：" & HTML解析器.转义实体("<小明> & 朋友", 配置) & "\n解码：" & HTML解析器.解码实体("&lt;小明&gt; &amp; &#x1F600;", 假)
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 清洗窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(来源)
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 清洗窗口 $为 窗口
		标题 = "3. 正文清洗"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		背景颜色 = -1
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			高度 = "40dp"
			文本 = "返回目录"
		$结束 $定义
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			高度 = "32dp"
			文本 = "3. 正文清洗"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			高度 = "72dp"
			文本 = "清洗结果仅适用于 HTML 正文片段，不用于脚本、样式或 URL 字符串。名单检查即便为真，展示时仍使用清洗输出。"
		$结束 $定义
		$定义 输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "80dp"
			文本 = "<p onclick=\"bad()\">你好<script>bad()</script><a href=\"javascript:bad()\">点这里</a><img src=\"https://example.test/a.png\"></p>"
		$结束 $定义
		$定义 操作区 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 操作内容 $为 面板
				宽度 = 长度_匹配父级
				高度 = 长度_适应内容
				布局 = 布局_线性
				布局.方向 = 布局_方向_垂直
				$定义 清洗 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "按基本图片名单清洗输入"
				$结束 $定义
				$定义 自定义 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "自定义 mark 与强制属性"
				$结束 $定义
				$定义 协议 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "限制协议并保留相对链接"
				$结束 $定义
				$定义 校验 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "检查输入是否符合名单"
				$结束 $定义
				$定义 实体 $为 按钮
					宽度 = 长度_匹配父级
					高度 = "44dp"
					文本 = "转义与解码字符实体"
				$结束 $定义
				$定义 输出 $为 标签
					宽度 = 长度_匹配父级
					高度 = 长度_适应内容
					文本 = "点击按钮查看结果。"
				$结束 $定义
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
