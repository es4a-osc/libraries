''' 本例解析本地书籍 HTML；查询、修改及自检均在后台完成，不联网加载封面。
别名 解析器 = simple.library.wsd.jsoup.HTML解析器
别名 文档类型 = simple.library.wsd.jsoup.HTML文档
别名 元素类型 = simple.library.wsd.jsoup.HTML元素
别名 列表类型 = simple.library.wsd.jsoup.HTML元素列表

变量 忙碌 为 逻辑型
变量 操作 为 整数型
变量 查询文本 为 文本型
变量 检查数 为 整数型

事件 主窗口.初始化()
	结果.文本 = "本地 HTML 已就绪，选择操作或执行全部自检。"
结束 事件

事件 选择器解析.被单击()
	开始任务(1)
结束 事件

事件 普通遍历.被单击()
	开始任务(2)
结束 事件

事件 属性修改.被单击()
	开始任务(3)
结束 事件

事件 全部自检.被单击()
	开始任务(4)
结束 事件

事件 执行查询.被单击()
	开始任务(5)
结束 事件

''' 启动前读取界面参数；每次只执行一个任务。
过程 开始任务(种类 为 整数型)
	如果 忙碌 则 退出 过程
	操作 = 种类
	查询文本 = 选择器.文本
	忙碌 = 真
	检查数 = 0
	置按钮状态(假)
	结果.文本 = "正在后台处理本地 HTML..."
	启动线程(本对象, "后台处理")
	位于 错误
		分支 否则
			忙碌 = 假
			置按钮状态(真)
			结果.文本 = "无法启动后台任务。"
	结束 错误
结束 过程

过程 置按钮状态(启用 为 逻辑型)
	选择器解析.启用 = 启用
	普通遍历.启用 = 启用
	属性修改.启用 = 启用
	全部自检.启用 = 启用
	执行查询.启用 = 启用
结束 过程

''' 文档在后台任务内创建和使用，结果通过消息送回界面。
过程 后台处理()
	变量 内容 为 文本型
	判断 操作
		分支 1
			内容 = 提取书籍(真)
		分支 2
			内容 = 提取书籍(假)
		分支 3
			内容 = 修改图片属性()
		分支 4
			内容 = 执行自检()
		分支 否则
			内容 = 查询资产(查询文本)
	结束 判断
	投递消息("完成", 内容)

	位于 错误
		分支 非法参数错误
			投递消息("失败", "参数或 CSS 选择器无效，请检查输入后重试。")
		分支 文件读写错误
			投递消息("失败", "HTML 文件或资产无法读取。")
		分支 否则
			投递消息("失败", "处理失败，自检已通过 " & 检查数 & " 项；请查看运行日志。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙碌 = 假
	置按钮状态(真)
	结果.文本 = 附加参数
结束 事件

''' 以原示例中的两条查询路径分别提取书名、作者、简介。
函数 提取书籍(使用选择器 为 逻辑型) 为 文本型
	变量 文档 为 文档类型
	变量 书籍 为 列表类型
	变量 书 为 元素类型
	变量 信息 为 元素类型
	变量 节点 为 元素类型
	变量 匹配项 为 列表类型
	变量 索引 为 整数型
	变量 书名 为 文本型
	变量 作者 为 文本型
	变量 简介 为 文本型
	变量 内容 为 文本型
	文档 = 解析器.解析资产("books.html", "UTF-8", "https://example.test/")
	如果 使用选择器 则
		书籍 = 文档.查询元素("ul.all-img-list > li")
		内容 = "CSS 选择器解析："
	否则
		匹配项 = 文档.取元素自类名("all-img-list")
		信息 = 匹配项.首元素()
		书籍 = 信息.取节点自TAG("li")
		内容 = "普通遍历解析："
	结束 如果
	内容 = 内容 & 书籍.取成员数() & " 本\n"

	循环 索引 = 0 至 书籍.取成员数() - 1
		书 = 书籍.取成员(索引)
		如果 使用选择器 则
			匹配项 = 书.查询元素("div.book-mid-info > h4 > a")
			书名 = 匹配项.取所有文本()
			节点 = 书.查询首个("div.book-mid-info > p.author > a.name")
			作者 = 节点.取所有文本()
			匹配项 = 书.查询元素("div.book-mid-info > p.intro")
			简介 = 匹配项.取所有文本()
		否则
			匹配项 = 书.取元素自类名("book-mid-info")
			信息 = 匹配项.首元素()
			匹配项 = 信息.取节点自TAG("h4")
			节点 = 匹配项.首元素()
			匹配项 = 节点.取节点自TAG("a")
			书名 = 匹配项.取所有文本()
			匹配项 = 信息.取节点自TAG("p")
			节点 = 匹配项.取成员(0)
			匹配项 = 节点.取节点自TAG("a")
			节点 = 匹配项.首元素()
			作者 = 节点.取所有文本()
			匹配项 = 信息.取节点自TAG("p")
			节点 = 匹配项.取成员(1)
			简介 = 节点.取所有文本()
		结束 如果
		内容 = 内容 & (索引 + 1) & ". " & 书名 & " / " & 作者 & "\n" & 简介 & "\n\n"
	下个 索引
	提取书籍 = 内容
结束 函数

''' 属性变更只作用于内存文档，不改写原资产。
函数 修改图片属性() 为 文本型
	变量 文档 为 文档类型
	变量 图片 为 列表类型
	变量 项 为 元素类型
	变量 索引 为 整数型
	变量 内容 为 文本型
	文档 = 解析器.解析资产("books.html", "UTF-8", "https://example.test/")
	图片 = 文档.查询元素("img")
	图片.置属性值("data-checked", "yes")
	内容 = "图片属性读写：" & 图片.取成员数() & " 个\n"
	循环 索引 = 0 至 图片.取成员数() - 1
		项 = 图片.取成员(索引)
		项.置属性值("data-index", "" & 索引)
		断言真(项.取属性值("data-index") = "" & 索引)
		内容 = 内容 & 索引 & ": " & 项.取URL("src") & "\n"
	下个 索引
	修改图片属性 = 内容
结束 函数

函数 查询资产(查询 为 文本型) 为 文本型
	变量 文档 为 文档类型
	变量 匹配项 为 列表类型
	文档 = 解析器.解析资产("books.html", "UTF-8", "https://example.test/")
	匹配项 = 文档.查询元素(查询)
	查询资产 = "匹配 " & 匹配项.取成员数() & " 项\n" & 匹配项.取所有文本()
结束 函数

过程 检查(条件 为 逻辑型)
	断言真(条件)
	检查数 = 检查数 + 1
结束 过程

''' 验证真实公开 API，错误分支也必须能返回并继续解析。
函数 执行自检() 为 文本型
	变量 文档 为 文档类型
	变量 辅文档 为 文档类型
	变量 元素 为 元素类型
	变量 副本 为 元素类型
	变量 首项 为 元素类型
	变量 尾项 为 元素类型
	变量 框 为 元素类型
	变量 临时元素 为 元素类型
	变量 临时列表 为 列表类型
	变量 比较文本 为 文本型
	变量 项 为 列表类型
	变量 书籍 为 列表类型
	变量 遍历书籍 为 列表类型
	变量 原文 为 文本型
	变量 数组 为 文本型()
	变量 索引 为 整数型
	原文 = "<html><head><title> 中文标题 </title></head><body><section id='box'><p class='item' data-id='1'>甲 <b>乙</b></p><p class='item' data-id='2'>丙</p><a href='../page'>链接</a><img src='//cdn.example.test/p.png'></section></body></html>"
	文档 = 解析器.解析文本(原文, "https://example.test/catalog/")

	''' 文档结构、CSS 查询、空结果及链接补全。
	检查(文档.取标题() = "中文标题")
	检查(文档.取头元素() <> 空)
	检查(文档.取主体元素() <> 空)
	检查(文档.取文档URL() = "https://example.test/catalog/")
	项 = 文档.查询元素("p.item")
	检查(项.取成员数() = 2)
	首项 = 项.首元素()
	尾项 = 项.尾元素()
	检查(首项.取内容() = "甲")
	检查(首项.取所有文本() = "甲 乙")
	检查(尾项.取所有文本() = "丙")
	临时元素 = 首项.取父元素()
	检查(临时元素.取ID() = "box")
	临时元素 = 首项.取下一元素()
	检查(临时元素.取所有文本() = "丙")
	临时元素 = 尾项.取上一元素()
	检查(临时元素.取内容() = "甲")
	框 = 文档.取节点自ID("box")
	临时列表 = 框.取子元素()
	检查(临时列表.取成员数() = 4)
	检查(首项.是否匹配("p.item"))
	检查(首项.取基本URL() = "https://example.test/catalog/")
	检查(文档.查询首个("#missing") = 空)
	临时列表 = 文档.查询元素("#missing")
	检查(临时列表.首元素() = 空)
	检查(临时列表.取成员数() = 0)
	临时元素 = 文档.查询首个("a")
	检查(临时元素.取URL("href") = "https://example.test/page")
	临时元素 = 文档.查询首个("img")
	检查(临时元素.取URL("src") = "https://cdn.example.test/p.png")

	''' 属性数组保留成员顺序，区分空属性和不存在的属性。
	数组 = 项.取属性值列表("data-id")
	检查(数组(0) = "1")
	检查(数组(1) = "2")
	数组 = 项.取文本列表()
	检查(数组(0) = "甲 乙")
	检查(项.取属性值("data-id") = "1")
	项.置属性值("data-empty", "")
	检查(首项.是否有属性("data-empty"))
	首项.移除属性("data-empty")
	检查(首项.是否有属性("data-empty") = 假)
	数组 = 首项.取属性名列表()
	检查(取数组成员数(数组) = 2)

	''' 深复制、转义和文档树修改；查询列表不会自动移除成员。
	副本 = 首项.复制()
	副本.置文本("副本")
	检查(首项.取所有文本() = "甲 乙")
	检查(副本.取所有文本() = "副本")
	副本.置文本("<b>x</b>")
	检查(副本.取内部HTML() = "&lt;b&gt;x&lt;/b&gt;")
	元素 = 框.创建子元素("strong")
	元素.置ID("new")
	元素.置文本("新增")
	临时元素 = 文档.查询首个("#new")
	检查(临时元素.取所有文本() = "新增")
	元素.置标签名称("em")
	检查(元素.取标签名称() = "em")
	元素.置内部HTML("<i>内部</i>")
	临时元素 = 元素.取指定子元素(0)
	检查(临时元素.取标签名称() = "i")
	元素.追加HTML("<b>尾</b>")
	元素.插入HTML到首部("<b>首</b>")
	临时列表 = 元素.取子元素()
	检查(临时列表.取成员数() = 3)
	检查(元素.取所有文本() = "首内部尾")
	元素.移除()
	检查(文档.查询首个("#new") = 空)
	项.移除()
	临时列表 = 文档.查询元素("p.item")
	检查(临时列表.取成员数() = 0)
	检查(项.取成员数() = 2)
	文档.置标题("新标题")
	检查(文档.取标题() = "新标题")
	临时元素 = 文档.创建元素("span")
	检查(临时元素.取父元素() = 空)
	检查(文档.取HTML文本() <> "")
	检查(副本.取原始文本() <> "")

	''' 编码自动识别和普通文件读取使用独立的小文档。
	辅文档 = 解析器.解析文本("")
	检查(辅文档.取主体元素() <> 空)
	辅文档 = 解析器.解析片段("<p>片段</p>", "")
	临时元素 = 辅文档.取主体元素()
	检查(临时元素.取所有文本() = "片段")
	辅文档 = 解析器.解析字节集(文本到字节("<meta charset='GBK'><title>中文编码</title>", "GBK"), "", "")
	检查(辅文档.取标题() = "中文编码")
	检查(写出文本文件("jsoup-selfcheck.html", 原文))
	辅文档 = 解析器.解析文件("jsoup-selfcheck.html", "UTF-8", "")
	检查(辅文档.取标题() = "中文标题")
	检查(删除文件("jsoup-selfcheck.html"))

	''' 对原始书籍资产的每条记录比较两种查询路径。
	文档 = 解析器.解析资产("books.html", "UTF-8", "https://example.test/")
	书籍 = 文档.查询元素("ul.all-img-list > li")
	临时列表 = 文档.取元素自类名("all-img-list")
	临时元素 = 临时列表.首元素()
	遍历书籍 = 临时元素.取节点自TAG("li")
	检查(书籍.取成员数() = 20)
	检查(书籍.取成员数() = 遍历书籍.取成员数())
	循环 索引 = 0 至 书籍.取成员数() - 1
		临时元素 = 书籍.取成员(索引)
		临时列表 = 临时元素.查询元素("div.book-mid-info > h4 > a")
		比较文本 = 临时列表.取所有文本()
		临时元素 = 遍历书籍.取成员(索引)
		临时列表 = 临时元素.取元素自类名("book-mid-info")
		临时元素 = 临时列表.首元素()
		临时列表 = 临时元素.取节点自TAG("h4")
		临时元素 = 临时列表.首元素()
		临时列表 = 临时元素.取节点自TAG("a")
		检查(比较文本 = 临时列表.取所有文本())
	下个 索引
	检查(期望错误(1))
	检查(期望错误(2))
	检查(期望错误(3))
	检查(期望错误(4))
	检查(期望错误(5))
	检查(期望错误(6))
	临时列表 = 文档.查询元素("ul.all-img-list > li")
	检查(临时列表.取成员数() = 20)
	执行自检 = "全部自检通过：" & 检查数 & " 项。\n覆盖解析、编码、文件、查询、遍历、属性、修改、复制和错误恢复。\n书籍资产 20 本，两种提取路径一致。"
结束 函数

''' 每个分支只把预期异常算为通过，错误类型不符时继续向外报告。
函数 期望错误(编号 为 整数型) 为 逻辑型
	变量 文档 为 文档类型
	变量 临时列表 为 列表类型
	变量 临时元素 为 元素类型
	文档 = 解析器.解析文本("<p>正常</p>")
	判断 编号
		分支 1
			文档.查询元素("[")
		分支 2
			临时列表 = 文档.查询元素("p")
			临时列表.取成员(3)
		分支 3
			解析器.解析文件("jsoup-selfcheck-missing.html", "UTF-8", "")
		分支 4
			解析器.解析字节集(文本到字节("<p>正常</p>"), "no-such-charset", "")
		分支 5
			临时元素 = 文档.查询首个("p")
			临时元素.置属性值("", "值")
		分支 6
			文档.查询元素(" ")
	结束 判断
	位于 错误
		分支 非法参数错误
			期望错误 = 编号 = 1 或 编号 = 4 或 编号 = 5 或 编号 = 6
		分支 索引超出界限错误
			期望错误 = 编号 = 2
		分支 文件未存在错误
			期望错误 = 编号 = 3
	结束 错误
结束 函数

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "HTML解析器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "本地 HTML 解析：后台查询、遍历、属性修改与自检，不请求网络。"
		$结束 $定义
		$定义 选择器解析 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "选择器解析书籍"
		$结束 $定义
		$定义 普通遍历 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "普通遍历书籍"
		$结束 $定义
		$定义 属性修改 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "遍历图片并修改属性"
		$结束 $定义
		$定义 全部自检 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "执行全部自检"
		$结束 $定义
		$定义 选择器 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "ul.all-img-list > li"
		$结束 $定义
		$定义 执行查询 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "执行选择器"
		$结束 $定义
		$定义 结果滚动框 $为 垂直滚动框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			$定义 结果 $为 标签
				宽度 = 长度_匹配父级
				字体大小 = 14
				文本 = "等待解析。"
			$结束 $定义
		$结束 $定义
	$结束 $定义
$结束 $属性
