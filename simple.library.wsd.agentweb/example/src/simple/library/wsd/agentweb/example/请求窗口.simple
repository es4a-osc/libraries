变量 来源 为 主窗口
变量 已准备 为 逻辑型
变量 载入出错 为 逻辑型

事件 保存头.被单击()
	浏览器.置请求头(服务地址.文本, "X-ES4A-Source", "saved")
	浏览器.加载网址(服务地址.文本 & "headers")
结束 事件

事件 单次头.被单击()
	变量 名称 为 文本型(1)
	变量 值 为 文本型(1)
	名称(0) = "X-ES4A-Once"
	值(0) = "Simple"
	浏览器.加载带请求头(服务地址.文本 & "headers", 名称, 值)
结束 事件

事件 查看头.被单击()
	变量 源 为 文本型
	反馈.文本 = "X-ES4A-Source：" & 浏览器.取请求头(服务地址.文本, "x-es4a-source") & "；字段数：" & 取数组成员数(浏览器.取请求头名称(服务地址.文本))
	循环 每个 源 从 浏览器.取请求头来源()
		反馈.文本 = 反馈.文本 & "\n源：" & 源
	下个
结束 事件

事件 移除头.被单击()
	反馈.文本 = "移除 X-ES4A-Source：" & 浏览器.移除请求头(服务地址.文本, "x-es4a-source")
结束 事件

事件 清源.被单击()
	浏览器.清除请求头(服务地址.文本)
	反馈.文本 = "已清除当前协议、主机及端口对应的请求头。"
结束 事件

事件 清全部.被单击()
	浏览器.清除全部请求头()
	反馈.文本 = "已清除本浏览框的全部请求头。"
结束 事件

事件 表单.被单击()
	浏览器.提交表单(服务地址.文本 & "post", 文本到字节("name=Simple&city=" & URL编码("杭州")))
结束 事件

事件 停止等待.被单击()
	浏览器.停止载入()
	状态.文本 = "已停止等待网页响应。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 请求窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 浏览器.开始载入(网址 为 文本型)
	载入出错 = 假
	状态.文本 = "正在载入..."
结束 事件

事件 浏览器.载入完毕(网址 为 文本型)
	如果 载入出错 = 假 则 状态.文本 = "页面载入完成。"
结束 事件

事件 浏览器.载入失败(错误码 为 整数型, 说明 为 文本型, 网址 为 文本型)
	载入出错 = 真
	状态.文本 = "网页载入失败：" & 说明
结束 事件

事件 浏览器.HTTP错误(状态码 为 整数型, 网址 为 文本型)
	载入出错 = 真
	状态.文本 = "HTTP " & 状态码
结束 事件

$属性
	$资源 $窗口
	$定义 请求窗口 $为 窗口
		标题 = "请求头与表单"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "请求头与表单"
			字体大小 = 20
			字体加粗 = 真
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
			高度 = "40dp"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "地址需以 / 结尾。默认公共回显服务可能限流，可改为兼容地址。保存的头只用于同源主动 GET 加载，表单为 URL 编码 POST。"
			字体大小 = 12
		$结束 $定义
		$定义 服务地址 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "https://httpbingo.org/"
			高度 = "44dp"
			单行模式 = 真
			提示文本 = "回显服务地址"
			字体大小 = 14
		$结束 $定义
		$定义 操作栏8 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 保存头 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "设置并发送请求头"
				字体大小 = 13
			$结束 $定义
			$定义 单次头 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "本次附加请求头"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏9 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 查看头 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "读取保存的请求头"
				字体大小 = 13
			$结束 $定义
			$定义 移除头 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "移除一个请求头"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏10 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清源 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清除当前源请求头"
				字体大小 = 13
			$结束 $定义
			$定义 清全部 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清除全部请求头"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏11 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 表单 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "发送表单 POST"
				字体大小 = 13
			$结束 $定义
			$定义 停止等待 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "停止等待响应"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点击按钮开始。"
			高度 = "48dp"
			字体大小 = 12
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			文本 = "操作结果显示在这里。"
			高度 = "64dp"
			字体大小 = 12
		$结束 $定义
		$定义 浏览器 $为 simple.library.wsd.agentweb.AW浏览器
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
		$结束 $定义
	$结束 $定义
$结束 $属性
