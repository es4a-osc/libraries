变量 来源 为 主窗口
变量 已准备 为 逻辑型
变量 载入出错 为 逻辑型

变量 原UserAgent 为 文本型
变量 脚本启用 为 逻辑型

事件 设置窗口.切换完毕()
	如果 已准备 = 假 则
		已准备 = 真
		脚本启用 = 真
		原UserAgent = 浏览器.取UserAgent()
		浏览器.加载HTML("<h1>Cookie 与设置</h1><p>此内容由示例提供，不会访问外部网站。</p>", "https://example.com/")
	结束 如果
结束 事件

事件 浏览器.Cookie已写入(网址 为 文本型, 成功 为 逻辑型)
	反馈.文本 = "Cookie 写入：" & 成功 & "；" & 浏览器.取Cookie(网址)
结束 事件

事件 浏览器.Cookie已清除()
	反馈.文本 = "Cookie 已清除；当前值：" & 浏览器.取Cookie("https://example.com/")
结束 事件

事件 浏览器.脚本返回(标记 为 文本型, 结果 为 文本型)
	反馈.文本 = 标记 & "：" & 结果
结束 事件

事件 设置窗口.即将切换()
	浏览器.置UserAgent(原UserAgent)
	浏览器.置JavaScript(真)
	脚本启用 = 真
结束 事件

事件 写Cookie.被单击()
	浏览器.置Cookie("https://example.com/", "theme=blue; Path=/")
结束 事件

事件 读Cookie.被单击()
	反馈.文本 = 浏览器.取Cookie("https://example.com/")
结束 事件

事件 网页Cookie.被单击()
	浏览器.执行脚本("document.cookie", "网页 Cookie")
结束 事件

事件 清Cookie.被单击()
	浏览器.清除Cookie()
结束 事件

事件 设置UA.被单击()
	浏览器.置UserAgent(原UserAgent & " ES4A-demo")
	浏览器.执行脚本("navigator.userAgent", "User-Agent")
结束 事件

事件 切脚本.被单击()
	脚本启用 = 取反 脚本启用
	浏览器.置JavaScript(脚本启用)
	反馈.文本 = "JavaScript 启用：" & 脚本启用
结束 事件

事件 缓存.被单击()
	浏览器.置缓存模式(simple.library.wsd.agentweb.AW浏览器.缓存_默认)
	反馈.文本 = "已使用默认网页缓存模式。"
结束 事件

事件 清缓存.被单击()
	浏览器.清除缓存(真)
	反馈.文本 = "已清除本应用 WebView 资源缓存，Cookie 保留。"
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 设置窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 浏览器.开始载入(网址 为 文本型)
	载入出错 = 假
	状态.文本 = "正在载入..."
结束 事件

事件 浏览器.载入完毕(网址 为 文本型)
	如果 载入出错 = 假 则 状态.文本 = "页面载入完成。"
结束 事件

事件 浏览器.载入失败(错误码 为 整数型, 说明 为 文本型, 网址 为 文本型)
	载入出错 = 真
	状态.文本 = "网页载入失败：" & 说明
结束 事件

事件 浏览器.HTTP错误(状态码 为 整数型, 网址 为 文本型)
	载入出错 = 真
	状态.文本 = "HTTP " & 状态码
结束 事件

$属性
	$资源 $窗口
	$定义 设置窗口 $为 窗口
		标题 = "Cookie 与浏览设置"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "Cookie 与浏览设置"
			字体大小 = 20
			字体加粗 = 真
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
			高度 = "40dp"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "Cookie、资源缓存由应用内 WebView 共享；清除会影响本示例其它浏览框。UA 和 JavaScript 在离开本页时恢复。"
			字体大小 = 12
		$结束 $定义
		$定义 操作栏7 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 写Cookie $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "写入 Cookie"
				字体大小 = 13
			$结束 $定义
			$定义 读Cookie $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "读取 Cookie"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏8 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 网页Cookie $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "网页读取 Cookie"
				字体大小 = 13
			$结束 $定义
			$定义 清Cookie $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清除应用 Cookie"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏9 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 设置UA $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "设置自定义 UA"
				字体大小 = 13
			$结束 $定义
			$定义 切脚本 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "切换 JavaScript"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏10 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 缓存 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "恢复默认缓存"
				字体大小 = 13
			$结束 $定义
			$定义 清缓存 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清除资源缓存"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点击按钮开始。"
			高度 = "48dp"
			字体大小 = 12
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			文本 = "操作结果显示在这里。"
			高度 = "64dp"
			字体大小 = 12
		$结束 $定义
		$定义 浏览器 $为 simple.library.wsd.agentweb.AW浏览器
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
		$结束 $定义
	$结束 $定义
$结束 $属性
