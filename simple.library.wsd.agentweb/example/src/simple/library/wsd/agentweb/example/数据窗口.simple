变量 来源 为 主窗口
变量 已准备 为 逻辑型
变量 载入出错 为 逻辑型

事件 纯文本.被单击()
	浏览器.加载数据("中文 😀 100% #原样显示", "text/plain")
结束 事件

事件 HTML.被单击()
	浏览器.加载HTML("<h1>动态 HTML</h1><p>中文 😀</p><a href='browser_second.html'>打开资产第二页</a>", "file:///android_asset/")
结束 事件

事件 基准数据.被单击()
	浏览器.加载带基准数据("<h1>指定历史地址的页面</h1><a href='browser_second.html'>基于资产目录的相对链接</a>", "text/html", "file:///android_asset/", "https://example.com/local-demo")
结束 事件

事件 读地址.被单击()
	反馈.文本 = "标题：" & 浏览器.取标题() & "\n地址：" & 浏览器.取地址()
结束 事件

事件 停止.被单击()
	浏览器.停止载入()
	反馈.文本 = "已停止继续载入。"
结束 事件

事件 历史.被单击()
	浏览器.清除历史()
	反馈.文本 = "可后退：" & 浏览器.可否后退() & "；可前进：" & 浏览器.可否前进()
结束 事件

事件 返回.被单击()
	切换窗口(来源)
结束 事件

事件 数据窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		切换窗口(来源)
	结束 如果
结束 事件

事件 浏览器.开始载入(网址 为 文本型)
	载入出错 = 假
	状态.文本 = "正在载入..."
结束 事件

事件 浏览器.载入完毕(网址 为 文本型)
	如果 载入出错 = 假 则 状态.文本 = "页面载入完成。"
结束 事件

事件 浏览器.载入失败(错误码 为 整数型, 说明 为 文本型, 网址 为 文本型)
	载入出错 = 真
	状态.文本 = "网页载入失败：" & 说明
结束 事件

事件 浏览器.HTTP错误(状态码 为 整数型, 网址 为 文本型)
	载入出错 = 真
	状态.文本 = "HTTP " & 状态码
结束 事件

$属性
	$资源 $窗口
	$定义 数据窗口 $为 窗口
		标题 = "文本与 HTML 加载"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "文本与 HTML 加载"
			字体大小 = 20
			字体加粗 = 真
		$结束 $定义
		$定义 返回 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "返回目录"
			高度 = "40dp"
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "本页完全离线。原始文本可包含中文、百分号及井号；基准地址决定相对链接，历史地址只改变导航记录。"
			字体大小 = 12
		$结束 $定义
		$定义 操作栏7 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 纯文本 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "加载纯文本"
				字体大小 = 13
			$结束 $定义
			$定义 HTML $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "加载 HTML"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏8 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 基准数据 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "MIME、基准与历史"
				字体大小 = 13
			$结束 $定义
			$定义 读地址 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "读取地址与标题"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 操作栏9 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 停止 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "停止载入"
				字体大小 = 13
			$结束 $定义
			$定义 历史 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "44dp"
				文本 = "清除页面历史"
				字体大小 = 13
			$结束 $定义
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			文本 = "点击按钮开始。"
			高度 = "48dp"
			字体大小 = 12
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			文本 = "操作结果显示在这里。"
			高度 = "64dp"
			字体大小 = 12
		$结束 $定义
		$定义 浏览器 $为 simple.library.wsd.agentweb.AW浏览器
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
		$结束 $定义
	$结束 $定义
$结束 $属性
