变量 浏览页 为 浏览窗口
变量 数据页 为 数据窗口
变量 请求页 为 请求窗口
变量 设置页 为 设置窗口
变量 下载页 为 下载窗口

事件 浏览入口.被单击()
	如果 浏览页 = 空 则
		浏览页 = 创建 浏览窗口
		浏览页.来源 = 主窗口
	结束 如果
	切换窗口(浏览页)
结束 事件

事件 数据入口.被单击()
	如果 数据页 = 空 则
		数据页 = 创建 数据窗口
		数据页.来源 = 主窗口
	结束 如果
	切换窗口(数据页)
结束 事件

事件 请求入口.被单击()
	如果 请求页 = 空 则
		请求页 = 创建 请求窗口
		请求页.来源 = 主窗口
	结束 如果
	切换窗口(请求页)
结束 事件

事件 设置入口.被单击()
	如果 设置页 = 空 则
		设置页 = 创建 设置窗口
		设置页.来源 = 主窗口
	结束 如果
	切换窗口(设置页)
结束 事件

事件 下载入口.被单击()
	如果 下载页 = 空 则
		下载页 = 创建 下载窗口
		下载页.来源 = 主窗口
	结束 如果
	切换窗口(下载页)
结束 事件

事件 主窗口.按下某键(键码 为 整数型, 传址 消费 为 逻辑型)
	如果 键码 = 键码_返回 则
		消费 = 真
		终止()
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "AW 浏览器入门"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			文本 = "AW 浏览器入门"
			字体大小 = 20
			字体加粗 = 真
		$结束 $定义
		滚动 = 真
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "先看离线浏览，再按主题查看数据加载、请求头、Cookie 和下载。每个按钮对应直接调用；输出位于操作区之后。"
			字体大小 = 14
		$结束 $定义
		$定义 浏览入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "页面导航、网页消息与文件选择"
			高度 = "52dp"
		$结束 $定义
		$定义 数据入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "离线文本、HTML 与历史地址"
			高度 = "52dp"
		$结束 $定义
		$定义 请求入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "请求头与表单 POST"
			高度 = "52dp"
		$结束 $定义
		$定义 设置入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "Cookie 与浏览设置"
			高度 = "52dp"
		$结束 $定义
		$定义 下载入口 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "下载、进度与取消"
			高度 = "52dp"
		$结束 $定义
	$结束 $定义
$结束 $属性
