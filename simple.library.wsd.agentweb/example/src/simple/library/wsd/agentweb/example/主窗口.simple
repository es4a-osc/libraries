''' 参考 AgentWeb 官方 Sample 的页面导航、JavaScript 交互与文件选择场景。
''' https://github.com/Justson/AgentWeb
''' 按当前封装编写本地页面，主要操作无需网络；联网地址由使用者输入。
变量 已启动 为 逻辑型
变量 载入出错 为 逻辑型

事件 主窗口.切换完毕()
	如果 已启动 = 假 则
		已启动 = 真
		浏览器.置进度颜色(&HFF1976D2)
		浏览器.置缩放(真, 假)
		打开本地主页()
	结束 如果
结束 事件

''' 消息接口只提供给示例自有页面；切换到网络页面前主动移除。
过程 打开本地主页()
	浏览器.注册接口("ES4A")
	浏览器.加载网址("file:///android_asset/browser_home.html")
结束 过程

事件 本地主页.被单击()
	打开本地主页()
结束 事件

事件 打开地址.被单击()
	浏览器.移除接口("ES4A")
	浏览器.加载网址(地址.文本)
	位于 错误
		分支 否则
			网页状态.文本 = "地址无法打开，请输入完整的 HTTP、HTTPS 或本地资产地址。"
	结束 错误
结束 事件

事件 后退按钮.被单击()
	如果 浏览器.后退() = 假 则
		反馈.文本 = "当前没有上一页。"
	结束 如果
结束 事件

事件 前进按钮.被单击()
	如果 浏览器.前进() = 假 则
		反馈.文本 = "当前没有下一页。"
	结束 如果
结束 事件

事件 刷新按钮.被单击()
	浏览器.刷新()
结束 事件

''' 返回值通过脚本返回事件异步取得，不能把发起调用当作已经取得结果。
事件 读取标题.被单击()
	浏览器.执行脚本("document.title", "页面标题")
结束 事件

''' 直接提供自有 HTML 内容及资产基准路径，同样可以接收页面消息。
事件 动态页面.被单击()
	浏览器.注册接口("ES4A")
	浏览器.加载HTML("<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'><title>动态 HTML 页面</title></head><body><h1>动态 HTML 页面</h1><p>此页面由 Simple 的加载HTML方法直接提供。</p><button onclick=\"ES4A.postMessage('来自动态 HTML 的消息')\">发送动态页面消息</button></body></html>", "file:///android_asset/")
结束 事件

''' 非本地示例的页内导航也会移除接口，不向其它来源继续暴露本地消息入口。
事件 浏览器.即将跳转(网址 为 文本型, 传址 屏蔽 为 逻辑型)
	如果 网址 <> "file:///android_asset/browser_home.html" 则
		如果 网址 <> "file:///android_asset/browser_second.html" 则
			浏览器.移除接口("ES4A")
		结束 如果
	结束 如果
结束 事件

事件 浏览器.开始载入(网址 为 文本型)
	载入出错 = 假
	地址.文本 = 网址
	网页状态.文本 = "正在载入页面..."
结束 事件

事件 浏览器.载入完毕(网址 为 文本型)
	如果 载入出错 = 假 则
		网页状态.文本 = "页面载入结束：" & 浏览器.取标题()
	结束 如果
结束 事件

事件 浏览器.载入失败(错误码 为 整数型, 说明 为 文本型, 网址 为 文本型)
	载入出错 = 真
	网页状态.文本 = "载入失败（" & 错误码 & "）：" & 说明
结束 事件

事件 浏览器.HTTP错误(状态码 为 整数型, 网址 为 文本型)
	载入出错 = 真
	网页状态.文本 = "服务器返回 HTTP " & 状态码
结束 事件

事件 浏览器.脚本返回(标记 为 文本型, 结果 为 文本型)
	反馈.文本 = 标记 & "的脚本返回值：" & 结果
结束 事件

事件 浏览器.接口调用(名称 为 文本型, 消息 为 文本型)
	反馈.文本 = "网页消息：" & 消息
结束 事件

''' 文件选择结果是授予访问的 URI；取消时数量为零，不把 URI 当作磁盘路径。
事件 浏览器.文件选择完成(地址列表 为 文本型())
	反馈.文本 = "文件选择结束：" & 取数组成员数(地址列表) & " 个 URI；取消时为 0。"
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		如果 浏览器.后退() = 假 则
			终止()
		结束 如果
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "AgentWeb使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 假
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 20
			文本 = "网页与 Simple 交互"
			字体加粗 = 真
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "本地页面无需网络。可修改地址打开网页；联网前会移除演示消息接口。"
		$结束 $定义
		$定义 地址 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			单行模式 = 真
			提示文本 = "输入完整网址，例如 https://example.com"
		$结束 $定义
		$定义 导航栏 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 本地主页 $为 按钮
				宽度 = "80dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "本地主页"
			$结束 $定义
			$定义 打开地址 $为 按钮
				宽度 = "80dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "打开地址"
			$结束 $定义
			$定义 后退按钮 $为 按钮
				宽度 = "80dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "后退"
			$结束 $定义
			$定义 前进按钮 $为 按钮
				宽度 = "80dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "前进"
			$结束 $定义
		$结束 $定义
		$定义 功能栏 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 刷新按钮 $为 按钮
				宽度 = "80dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "刷新"
			$结束 $定义
			$定义 读取标题 $为 按钮
				宽度 = "80dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "读取标题"
			$结束 $定义
			$定义 动态页面 $为 按钮
				宽度 = "100dp"
				高度 = "48dp"
				字体大小 = 13
				文本 = "动态 HTML"
			$结束 $定义
		$结束 $定义
		$定义 网页状态 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "等待首次载入。"
		$结束 $定义
		$定义 反馈 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 12
			文本 = "网页消息、脚本返回和文件选择结果显示在这里。"
		$结束 $定义
		$定义 浏览器 $为 simple.library.wsd.agentweb.浏览器
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
