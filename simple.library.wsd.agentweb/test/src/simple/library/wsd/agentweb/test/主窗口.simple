' 浏览器的独立测试。联网项目使用地址栏指定的 HTTP 服务，不依赖其它扩展库。
变量 已启动 为 逻辑型
变量 下载编号 为 整数型
变量 错误状态 为 逻辑型
变量 失败地址 为 文本型

事件 主窗口.切换完毕()
	如果 已启动 = 假 则
		已启动 = 真
		浏览器.注册接口("ES4A")
		浏览器.置进度颜色(-15108398)
		浏览器.置缩放(真, 假)
		浏览器.置第三方Cookie(假)
		浏览器.加载网址("file:///android_asset/agentweb_test.html")
	否则
		断言真(浏览器.取消下载(地址.文本 & "/slow.bin") = 假)
		反馈("通过：切窗后无遗留下载；第一实例可继续操作。")
	结束 如果
结束 事件

事件 主窗口.按下某键(code 为 整数型, 传址 cancel 为 逻辑型)
	如果 code = 键码_返回 则 cancel = 浏览器.后退()
结束 事件

事件 主页.被单击()
	浏览器.加载网址("file:///android_asset/agentweb_test.html")
结束 事件

事件 联网.被单击()
	浏览器.加载网址(地址.文本 & "/agentweb_test.html")
结束 事件

事件 后退.被单击()
	反馈("后退结果：" & 浏览器.后退())
结束 事件

事件 前进.被单击()
	反馈("前进结果：" & 浏览器.前进())
结束 事件

事件 脚本.被单击()
	浏览器.执行脚本("document.getElementById('result').textContent='原生脚本成功';document.title+' / ticks='+document.getElementById('ticks').textContent", "TITLE")
结束 事件

事件 浏览器.即将跳转(url 为 文本型, 传址 block 为 逻辑型)
	如果 url = "https://blocked.example/" 则
		block = 真
		反馈("通过：导航被同步拦截。")
	结束 如果
结束 事件

事件 浏览器.开始载入(url 为 文本型)
	错误状态 = url = 失败地址
	输出信息("AGENTWEB-TEST", "开始：" & url)
结束 事件

事件 浏览器.载入完毕(url 为 文本型)
	如果 错误状态 = 假 则 反馈("已载入：" & 浏览器.取标题())
结束 事件

事件 浏览器.标题改变(title 为 文本型)
	输出信息("AGENTWEB-TEST", "标题：" & title)
结束 事件

事件 浏览器.进度改变(progress 为 整数型)
	输出信息("AGENTWEB-TEST", "进度：" & progress)
结束 事件

事件 浏览器.载入失败(code 为 整数型, message 为 文本型, url 为 文本型)
	错误状态 = 真
	失败地址 = url
	反馈("网络失败：" & code & " / " & message)
结束 事件

事件 浏览器.HTTP错误(status 为 整数型, url 为 文本型)
	错误状态 = 真
	失败地址 = url
	反馈("HTTP错误：" & status)
结束 事件

事件 浏览器.脚本返回(mark 为 文本型, result 为 文本型)
	反馈("脚本返回：" & mark & " / " & result)
结束 事件

事件 浏览器.接口调用(name 为 文本型, message 为 文本型)
	判断 message
		分支 "COOKIE"
			浏览器.置Cookie(地址.文本, "es4a=agentweb; Path=/")
		分支 "CLEAR_COOKIE"
			浏览器.清除Cookie()
		分支 "CACHE"
			浏览器.置缓存模式(2)
			浏览器.清除缓存(真)
			浏览器.置缓存模式(-1)
			浏览器.置UserAgent("ES4A-AgentWeb-Test")
			断言真(浏览器.取UserAgent() = "ES4A-AgentWeb-Test")
			浏览器.置UserAgent("")
			反馈("通过：缓存操作与 UserAgent 置取。")
		分支 "DOWNLOAD"
			启动下载("/download.txt")
		分支 "DOWNLOAD_ERROR"
			启动下载("/missing")
		分支 "SLOW"
			启动下载("/slow.bin")
		分支 "CANCEL"
			反馈("取消结果：" & 浏览器.取消下载(地址.文本 & "/slow.bin"))
		分支 "HTTP_ERROR"
			浏览器.加载网址(地址.文本 & "/missing")
		分支 "NETWORK_ERROR"
			浏览器.加载网址("http://127.0.0.1:1/unavailable")
		分支 "SWITCH"
			变量 下页 为 离开验证
			下页 = 创建 离开验证
			下页.来源 = 本对象
			切换窗口(下页)
		分支 "HTML"
			浏览器.加载HTML("<html><title>HTML检查</title><body>HTML载入成功</body></html>", "https://example.com/")
		分支 "INVALID"
			非法参数()
		分支 否则
			反馈("网页消息：" & name & " / " & message)
	结束 判断
结束 事件

过程 非法参数()
	浏览器.置缓存模式(999)
	反馈("失败：非法缓存模式未拒绝。")
	位于 错误
		分支 否则
			反馈("通过：非法缓存模式被拒绝。")
	结束 错误
结束 过程

过程 启动下载(path 为 文本型)
	下载编号 = 下载编号 + 1
	浏览器.下载文件(地址.文本 & path, "agentweb-download-" & 取现行时间戳() & "-" & 下载编号 & ".dat")
	反馈("下载已启动：" & path)
	位于 错误
		分支 否则
			反馈("下载未启动：检查重复任务、目标文件及服务器。")
	结束 错误
结束 过程

事件 浏览器.下载已请求(url 为 文本型, userAgent 为 文本型, disposition 为 文本型, mime 为 文本型, length 为 长整数型)
	反馈("网页请求下载：" & mime)
	启动下载("/download.txt")
结束 事件

事件 浏览器.下载进度(url 为 文本型, received 为 长整数型, total 为 长整数型)
	反馈("下载进度：" & received & "/" & total)
结束 事件

事件 浏览器.下载完成(url 为 文本型, path 为 文本型)
	如果 url = 地址.文本 & "/download.txt" 则
		断言真(取文件尺寸(path) = 26)
		变量 内容 为 文本型
		内容 = 读入文本文件(path)
		断言真(内容 = "ES4A-AGENTWEB-DOWNLOAD-OK" & 字符(10))
		反馈("通过：下载文件已读回，内容一致。")
		退出 事件
	结束 如果
	反馈("下载完成：" & path)
结束 事件

事件 浏览器.下载失败(url 为 文本型, message 为 文本型)
	反馈("下载失败：" & message)
结束 事件

事件 浏览器.下载已取消(url 为 文本型)
	反馈("下载已取消：" & url)
结束 事件

事件 浏览器.文件选择完成(uris 为 文本型())
	反馈("文件选择完成：" & 取数组成员数(uris))
结束 事件

事件 浏览器.Cookie已写入(url 为 文本型, success 为 逻辑型)
	反馈("Cookie写入：" & success & " / " & 浏览器.取Cookie(url))
结束 事件

事件 浏览器.Cookie已清除()
	断言真(浏览器.取Cookie(地址.文本) = "")
	反馈("通过：Cookie已清除。")
结束 事件

事件 浏览器.全屏改变(fullscreen 为 逻辑型)
	反馈("视频全屏：" & fullscreen)
结束 事件

过程 反馈(text 为 文本型)
	结果.文本 = text
	输出信息("AGENTWEB-TEST", text)
结束 过程

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "浏览器测试"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 地址 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "48dp"
			文本 = "http://127.0.0.1:18764"
		$结束 $定义
		$定义 工具栏 $为 面板
			宽度 = 长度_匹配父级
			高度 = "52dp"
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 主页 $为 按钮
				宽度 = "68dp"
				文本 = "主页"
			$结束 $定义
			$定义 联网 $为 按钮
				宽度 = "68dp"
				文本 = "联网"
			$结束 $定义
			$定义 后退 $为 按钮
				宽度 = "68dp"
				文本 = "后退"
			$结束 $定义
			$定义 前进 $为 按钮
				宽度 = "68dp"
				文本 = "前进"
			$结束 $定义
			$定义 脚本 $为 按钮
				宽度 = "68dp"
				文本 = "脚本"
			$结束 $定义
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			高度 = "60dp"
			文本 = "等待测试。联网前需启动地址栏指定服务。"
		$结束 $定义
		$定义 浏览器 $为 simple.library.wsd.agentweb.浏览器
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
