''' 下载器测试：文件下载、暂停、继续、取消和重启后的断点恢复。

变量 任务编号 为 整数型

''' 恢复上次保存的任务编号。
事件 主窗口.初始化()
	变量 已保存 为 文本型
	已保存 = 读取设置("downloader.lastTask")
	如果 已保存 <> "" 则 任务编号 = 到整数(已保存)
	如果 任务编号 > 0 则
		变量 信息 为 文本型()
		信息 = 下载器1.取任务信息(任务编号)
		网址.文本 = 信息(0)
		保存路径.文本 = 信息(1)
		显示状态()
	结束 如果
	位于 错误
		分支 否则
			任务编号 = 0
			结果.文本 = "等待下载。"
	结束 错误
结束 事件

''' 显示任务状态、文件位置和失败原因。
过程 显示状态()
	变量 信息 为 文本型()
	信息 = 下载器1.取任务信息(任务编号)
	结果.文本 = "任务：" & 任务编号 & "；状态：" & 信息(2) & "\n网址：" & 信息(0) & "\n文件：" & 信息(1) & "\n大小：" & 信息(4) & " / " & 信息(3) & " 字节\n错误：" & 信息(5)
结束 过程

''' 检查输入和当前任务，再创建新任务；已完成文件不会被覆盖。
事件 开始按钮.被单击()
	变量 地址 为 文本型
	变量 路径 为 文本型
	地址 = 网址.文本
	路径 = 保存路径.文本
	删首尾空(地址)
	删首尾空(路径)
	如果 (寻找文本(地址, "http://", 0) <> 0 且 寻找文本(地址, "https://", 0) <> 0) 或 路径 = "" 则
		结果.文本 = "请填写 HTTP/HTTPS 网址和保存文件路径。"
		退出 事件
	结束 如果
	' 本测试只管理一个当前任务，避免切换来源时遗失尚未完成的任务。
	如果 任务编号 > 0 则
		变量 当前信息 为 文本型()
		当前信息 = 下载器1.取任务信息(任务编号)
		如果 当前信息(2) <> "完成" 且 当前信息(2) <> "取消" 则
			结果.文本 = "当前任务状态为" & 当前信息(2) & "，请使用暂停、继续，或先取消当前任务再开始新任务。"
			退出 事件
		结束 如果
	结束 如果
	如果 文件是否存在(路径) 或 是否为目录(路径) 则
		结果.文本 = "目标文件已经存在，请填写新的文件名；本测试不会覆盖已有文件。"
		退出 事件
	结束 如果

	任务编号 = 下载器1.开始下载(地址, 路径)
	保存设置("downloader.lastTask", 任务编号)
	显示状态()
	位于 错误
		分支 否则
			结果.文本 = "无法开始：检查网址、路径和目标是否已经存在。"
	结束 错误
结束 事件

''' 暂停后保留临时文件及断点。
事件 暂停按钮.被单击()
	如果 任务编号 <= 0 则 退出 事件
	变量 信息 为 文本型()
	信息 = 下载器1.取任务信息(任务编号)
	如果 信息(2) <> "等待" 且 信息(2) <> "下载" 则
		显示状态()
		退出 事件
	结束 如果
	下载器1.暂停下载(任务编号)
	显示状态()
结束 事件

''' 应用重新启动后仍可继续上次任务。
事件 继续按钮.被单击()
	如果 任务编号 <= 0 则 退出 事件
	变量 信息 为 文本型()
	信息 = 下载器1.取任务信息(任务编号)
	如果 信息(2) <> "暂停" 且 信息(2) <> "失败" 则
		结果.文本 = "当前任务状态为" & 信息(2) & "，只有暂停或失败的任务可以继续。"
		退出 事件
	结束 如果
	下载器1.继续下载(任务编号)
	显示状态()
	位于 错误
		分支 否则
			结果.文本 = "任务已完成或取消，不能继续；请开始新任务。"
	结束 错误
结束 事件

''' 取消只清理临时文件，完成的目标文件保留。
事件 取消按钮.被单击()
	如果 任务编号 <= 0 则 退出 事件
	下载器1.取消下载(任务编号)
	显示状态()
结束 事件

''' 读取持久化的未完成网址集合。
事件 记录按钮.被单击()
	变量 记录 为 集合
	记录 = 下载器1.取未完成记录()
	结果.文本 = "未完成记录：" & 记录.计数
结束 事件

''' 主线程进度事件；长度未知时百分比为 -1。
事件 下载器1.进度改变(编号 为 整数型, 总大小 为 长整数型, 已下载 为 长整数型, 百分比 为 整数型)
	如果 编号 <> 任务编号 则 退出 事件
	结果.文本 = "任务：" & 编号 & "；下载中：" & 已下载 & " / " & 总大小 & " 字节；进度：" & 百分比 & "%"
结束 事件

''' 完成后读取实际状态及文件位置。
事件 下载器1.下载完毕(编号 为 整数型, 成功 为 逻辑型)
	如果 编号 <> 任务编号 则 退出 事件
	显示状态()
	如果 成功 则
		变量 信息 为 文本型()
		信息 = 下载器1.取任务信息(编号)
		断言真(信息(2) = "完成")
		断言真(文件是否存在(信息(1)))
		结果.文本 = 结果.文本 & "\n通过：成功事件、完成状态和目标文件一致；仍需与服务器文件核对内容。"
	否则
		结果.文本 = 结果.文本 & "\n下载失败：核对错误信息，不能计为通过。"
	结束 如果
	位于 错误
		分支 否则
			结果.文本 = "失败：成功事件与实际任务状态或文件不一致。"
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "下载器测试"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			文本 = "填入可控 HTTP/HTTPS 测试文件地址和新的私有路径。完成须核对字节数与文件内容；测试暂停、重启续传、取消和不可达地址。"
			宽度 = 长度_匹配父级
			单行模式 = 假
		$结束 $定义
		$定义 网址 $为 编辑框
			文本 = "https://www.example.com/"
			提示文本 = "HTTP/HTTPS 下载网址"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 保存路径 $为 编辑框
			文本 = "downloads/example.html"
			提示文本 = "应用私有相对路径，如 downloads/update.apk"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 开始按钮 $为 按钮
			文本 = "开始下载"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 暂停按钮 $为 按钮
			文本 = "暂停"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 继续按钮 $为 按钮
			文本 = "继续"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 取消按钮 $为 按钮
			文本 = "取消"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 记录按钮 $为 按钮
			文本 = "读取未完成记录"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 标签
			文本 = "等待下载。"
			宽度 = 长度_匹配父级
			单行模式 = 假
		$结束 $定义
		$定义 下载器1 $为 simple.library.wsd.downloader.下载器
		$结束 $定义
	$结束 $定义
$结束 $属性
