''' 默认下载公开 RFC 文本，可换成自己的 HTTP/HTTPS 文件。
''' https://www.rfc-editor.org/rfc/rfc9110.txt
''' 断点由库维护；Range / If-Range 行为参考 RFC 9110 第13、14节。
''' https://www.rfc-editor.org/rfc/rfc9110.html#name-range-requests
变量 当前任务 为 整数型
变量 文件序号 为 整数型
变量 进度次数 为 整数型
变量 成功次数 为 整数型
变量 失败次数 为 整数型
变量 核验中 为 逻辑型
变量 核验路径 为 文本型
变量 核验预期 为 文本型
变量 本任务预期 为 文本型

事件 主窗口.初始化()
	文件序号 = 到整数(读取设置("downloader.example.number"))
	如果 文件序号 < 1 则 文件序号 = 1
	文件名.文本 = "downloader-example/download-" & 文件序号 & ".bin"
	当前任务 = 到整数(读取设置("downloader.example.last"))
	如果 当前任务 > 0 则
		变量 信息 为 文本型()
		信息 = 下载.取任务信息(当前任务)
		网址.文本 = 信息(0)
		文件名.文本 = 信息(1)
		本任务预期 = 读取设置("downloader.example.md5")
		预期MD5.文本 = 本任务预期
		输出.文本 = "已恢复上次任务信息；暂停或失败的任务需手动点击继续。"
	结束 如果
	刷新状态()
	位于 错误
		分支 否则
			当前任务 = 0
			输出.文本 = "上次任务无法恢复，请填写地址和新的保存文件名。"
	结束 错误
结束 事件

事件 公开示例.被单击()
	网址.文本 = "https://www.rfc-editor.org/rfc/rfc9110.txt"
	预期MD5.文本 = ""
	输出.文本 = "已填公开 RFC 地址，需要可访问互联网；较大的自有文件便于体验暂停。"
结束 事件

事件 换文件名.被单击()
	文件序号 = 文件序号 + 1
	保存设置("downloader.example.number", 文件序号)
	文件名.文本 = "downloader-example/download-" & 文件序号 & ".bin"
	输出.文本 = "已选择新文件名；已有文件不会被下载器覆盖，当前任务仍可暂停或继续。"
结束 事件

事件 开始.被单击()
	如果 核验中 则 退出 事件
	如果 当前任务 > 0 则
		变量 旧信息 为 文本型()
		旧信息 = 下载.取任务信息(当前任务)
		如果 旧信息(2) <> "完成" 且 旧信息(2) <> "取消" 则
			输出.文本 = "当前任务尚未结束，请继续原任务，或先取消再开始新的任务。"
			退出 事件
		结束 如果
	结束 如果
	变量 地址 为 文本型
	变量 路径 为 文本型
	地址 = 网址.文本
	路径 = 文件名.文本
	删首尾空(地址)
	删首尾空(路径)
	当前任务 = 下载.开始下载(地址, 路径)
	本任务预期 = 预期MD5.文本
	保存设置("downloader.example.last", 当前任务)
	保存设置("downloader.example.md5", 本任务预期)
	进度次数 = 0
	成功次数 = 0
	失败次数 = 0
	进度说明.文本 = "等待下载器的进度回调。"
	文件说明.文本 = "目标文件尚未核验。"
	输出.文本 = "已创建任务；完成与否以回调及实际文件为准。"
	刷新状态()
	位于 错误
		分支 否则
			输出.文本 = "无法开始：检查 HTTP/HTTPS 地址、可写路径及目标文件是否已经存在。"
	结束 错误
结束 事件

事件 暂停.被单击()
	如果 当前任务 <= 0 则 退出 事件
	下载.暂停下载(当前任务)
	刷新状态()
	输出.文本 = "已请求暂停；暂停保留断点，不触发完成事件。"
	位于 错误
		分支 否则
			输出.文本 = "无法暂停，请刷新任务状态后再试。"
	结束 错误
结束 事件

事件 继续.被单击()
	如果 当前任务 <= 0 则 退出 事件
	下载.继续下载(当前任务)
	刷新状态()
	输出.文本 = "已继续原任务；服务器不支持续传或缺少文件标识时会重新下载。"
	位于 错误
		分支 否则
			输出.文本 = "继续被拒绝：已完成或取消的任务不能继续，请换新文件名开始。"
	结束 错误
结束 事件

事件 取消.被单击()
	如果 当前任务 <= 0 则 退出 事件
	下载.取消下载(当前任务)
	刷新状态()
	输出.文本 = "已调用取消；未完成任务清理临时文件，已完成的文件会保留。"
	位于 错误
		分支 否则
			输出.文本 = "取消未成功，请检查任务状态与文件访问条件。"
	结束 错误
结束 事件

事件 刷新.被单击()
	刷新状态()
结束 事件

过程 刷新状态()
	如果 当前任务 <= 0 则
		任务说明.文本 = "尚无当前任务。"
		退出 过程
	结束 如果
	变量 信息 为 文本型()
	信息 = 下载.取任务信息(当前任务)
	任务说明.文本 = "任务 " & 当前任务 & "；状态：" & 信息(2) & "\n" & 信息(4) & " / " & 信息(3) & " 字节\n文件：" & 信息(1)
	如果 信息(5) <> "" 则 任务说明.文本 = 任务说明.文本 & "\n错误：" & 信息(5)
	事件说明.文本 = "本次界面：进度回调 " & 进度次数 & "；成功 " & 成功次数 & "；失败 " & 失败次数
结束 过程

事件 下载.进度改变(编号 为 整数型, 总大小 为 长整数型, 已下载 为 长整数型, 百分比 为 整数型)
	如果 编号 <> 当前任务 则 退出 事件
	进度次数 = 进度次数 + 1
	如果 百分比 < 0 则
		进度说明.文本 = "最近进度回调：已下载 " & 已下载 & " 字节；服务器未提供总大小，进度未知。"
	否则
		进度说明.文本 = "最近进度回调：已下载 " & 已下载 & " / " & 总大小 & " 字节；" & 百分比 & "%"
	结束 如果
	刷新状态()
结束 事件

事件 下载.下载完毕(编号 为 整数型, 成功 为 逻辑型)
	如果 编号 <> 当前任务 则 退出 事件
	如果 成功 则
		成功次数 = 成功次数 + 1
		输出.文本 = "收到成功回调；点击核验，检查实际目标文件和内容摘要。"
	否则
		失败次数 = 失败次数 + 1
		输出.文本 = "收到失败回调；错误见任务状态，可继续重试或取消。"
	结束 如果
	刷新状态()
结束 事件

事件 未完成.被单击()
	变量 记录 为 集合
	变量 索引 为 整数型
	记录 = 下载.取未完成记录()
	记录说明.文本 = "上次查询：未完成记录 " & 记录.计数 & " 条（不含完成、取消）："
	循环 索引 = 0 至 记录.计数 - 1
		如果 索引 >= 6 则 退出 循环
		记录说明.文本 = 记录说明.文本 & "\n" & 记录.项目(索引)
	下个 索引
结束 事件

''' 任务状态与最终文件独立核对；小文件在后台计算 MD5，预期摘要应由文件来源提供。
事件 核验.被单击()
	如果 核验中 或 当前任务 <= 0 则 退出 事件
	变量 信息 为 文本型()
	信息 = 下载.取任务信息(当前任务)
	如果 信息(2) <> "完成" 则
		文件说明.文本 = "当前任务未完成，尚无可核验的最终文件。"
		退出 事件
	结束 如果
	核验路径 = 信息(1)
	核验预期 = 本任务预期
	删首尾空(核验预期)
	到大写(核验预期)
	核验中 = 真
	开始.启用 = 假
	核验.启用 = 假
	文件说明.文本 = "正在后台读取实际文件..."
	启动线程(本对象, "核验文件")
	位于 错误
		分支 否则
			核验中 = 假
			开始.启用 = 真
			核验.启用 = 真
			文件说明.文本 = "无法启动文件核验。"
	结束 错误
结束 事件

过程 核验文件()
	如果 取反 文件是否存在(核验路径) 则
		投递消息("核验", "未找到目标文件，不能确认下载结果。")
		退出 过程
	结束 如果
	变量 尺寸 为 长整数型
	变量 说明 为 文本型
	尺寸 = 取文件尺寸(核验路径)
	说明 = "实际文件：" & 尺寸 & " 字节。"
	如果 尺寸 <= 4194304 则
		变量 摘要 为 文本型
		摘要 = 取MD5值(读入字节文件(核验路径))
		说明 = 说明 & "\nMD5：" & 摘要
		如果 核验预期 <> "" 则
			如果 摘要 = 核验预期 则
				说明 = 说明 & "\n与本任务的预期 MD5 一致。"
			否则
				说明 = 说明 & "\n与预期 MD5 不一致，请检查来源或文件内容。"
			结束 如果
		否则
			说明 = 说明 & "\n未提供预期 MD5；摘要未与来源文件比对。"
		结束 如果
	否则
		说明 = 说明 & "\n超过4MiB，本示例不一次读入内存；请另用流式工具核对内容。"
	结束 如果
	投递消息("核验", 说明)
	位于 错误
		分支 否则
			投递消息("核验", "文件读取失败，请检查保存路径的访问条件。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	如果 消息标记 <> "核验" 则 退出 事件
	核验中 = 假
	开始.启用 = 真
	核验.启用 = 真
	文件说明.文本 = 附加参数
结束 事件

事件 退出按钮.被单击()
	关闭示例()
结束 事件

过程 关闭示例()
	如果 核验中 则 退出 过程
	如果 当前任务 > 0 则 下载.暂停下载(当前任务)
	终止()
结束 过程

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		关闭示例()
	结束 如果
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "文件下载使用示例"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 标题 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 23
			文本 = "下载、暂停与继续"
			字体加粗 = 真
		$结束 $定义
		$定义 输出 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "填写地址和新的文件名，再开始；文件保存在应用私有目录。"
		$结束 $定义
		$定义 网址 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "https://www.rfc-editor.org/rfc/rfc9110.txt"
			提示文本 = "HTTP/HTTPS 文件地址"
		$结束 $定义
		$定义 文件名 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = "downloader-example/download-1.bin"
			提示文本 = "应用私有相对路径或可写绝对路径"
		$结束 $定义
		$定义 预期MD5 $为 编辑框
			宽度 = 长度_匹配父级
			单行模式 = 真
			文本 = ""
			提示文本 = "来源文件的预期 MD5（可空，开始任务时保存）"
		$结束 $定义
		$定义 输入操作 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 公开示例 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "填入公开 RFC 示例"
			$结束 $定义
			$定义 换文件名 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "换一个保存文件名"
			$结束 $定义
		$结束 $定义
		$定义 启动行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 开始 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "开始新任务"
			$结束 $定义
			$定义 刷新 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "刷新任务状态"
			$结束 $定义
		$结束 $定义
		$定义 控制行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 暂停 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "暂停"
			$结束 $定义
			$定义 继续 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "继续"
			$结束 $定义
			$定义 取消 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "取消"
			$结束 $定义
		$结束 $定义
		$定义 任务说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "尚无当前任务。"
		$结束 $定义
		$定义 进度说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 15
			文本 = "等待进度回调。"
		$结束 $定义
		$定义 事件说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "本次界面：进度回调 0；成功 0；失败 0"
		$结束 $定义
		$定义 检查行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 核验 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "核验已完成文件"
			$结束 $定义
			$定义 未完成 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "查看未完成记录"
			$结束 $定义
		$结束 $定义
		$定义 文件说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = "目标文件尚未核验。"
		$结束 $定义
		$定义 记录说明 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "未完成记录尚未读取。"
		$结束 $定义
		$定义 退出行 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 退出按钮 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "退出并保留断点"
			$结束 $定义
		$结束 $定义
		$定义 条件 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 13
			文本 = "进程退出后不持续下载；重开示例再继续。续传依赖服务器支持及文件标识，可能从头重下。暂停和取消不触发完成事件；现有目标文件不会被覆盖。"
		$结束 $定义
		$定义 下载 $为 simple.library.wsd.downloader.下载器
		$结束 $定义
	$结束 $定义
$结束 $属性
